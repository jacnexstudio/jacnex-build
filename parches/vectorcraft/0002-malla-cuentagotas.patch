+    /// Jacnex: pick the points `v` lists (`[{id, index}…]`, as [`Self::options`] gives them): the
+    /// points picked before another tool was chosen (the Eyedropper) come back picked.
+    pub fn set_picked(&mut self, v: &Value) {
+        let Some(list) = v.as_array() else { return };
+        if self.drag.is_some() {
+            return;
+        }
+        let key = |p: &Value| Some((NodeId(p.get("id")?.as_u64()?), usize::try_from(p.get("index")?.as_u64()?).ok()?));
+        self.picked = list.iter().filter_map(key).collect();
+        self.focus = self.picked.first().copied().filter(|_| self.picked.len() == 1);
+        self.click = None;
+    }
