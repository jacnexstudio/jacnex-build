+
+/// Jacnex: the gradient mesh points picked with Direct Selection or the Mesh tool take the colour
+/// the Eyedropper picks up, and only they do (the mesh is drawn from its points' colours); with
+/// the Eyedropper chosen a fill colour recolours them too, and back with that tool they are still
+/// picked. The Selection tool lets them go.
+#[test]
+fn jacnex_the_eyedropper_recolours_picked_mesh_points() {
+    let mut s = session();
+    rect(&mut s, 400.0);
+    s.execute("paint.setFill", &json!({"color": "#202040"})).unwrap();
+    let m = rect(&mut s, 10.0);
+    s.execute("paint.setFill", &json!({"color": "#ff0000"})).unwrap();
+    s.execute("object.mesh.create", &json!({"rows": 2, "cols": 2})).unwrap();
+    s.execute("select.set", &json!({"ids": [m.0]})).unwrap();
+    let v = ViewInfo::default();
+    let colors = |s: &Session| match node(s, m).kind {
+        NodeKind::Mesh(g) => g.points.iter().map(|p| p.color.to_hex()).collect::<Vec<_>>(),
+        k => panic!("not a mesh: {k:?}"),
+    };
+    let only_point_4 = |c: &[String], hex: &str, what: &str| {
+        assert_eq!(c[4], hex, "{what}: {c:?}");
+        assert!(c.iter().enumerate().all(|(i, x)| i == 4 || x == "#ff0000"), "{what}: the other points stay: {c:?}");
+    };
+    for tool in ["directSelection", "mesh"] {
+        s.select_tool(tool, v).unwrap();
+        let NodeKind::Mesh(g) = node(&s, m).kind else { panic!("not a mesh") };
+        let q = g.points[4].p;
+        for kind in [PointerKind::Down, PointerKind::Up] {
+            s.pointer(&PointerEvent::new(kind, q.x, q.y), v).unwrap();
+        }
+        let undo = undo_len(&s);
+        click(&mut s, 425.0, 35.0, Mods::default());
+        only_point_4(&colors(&s), "#202040", tool);
+        assert_eq!(undo_len(&s), undo + 1, "{tool}: one undo step");
+        s.execute("paint.setFill", &json!({"color": "#00ff00"})).unwrap();
+        only_point_4(&colors(&s), "#00ff00", &format!("{tool}: fill colour"));
+        s.select_tool(tool, v).unwrap();
+        assert_eq!(s.tool_options()["meshPoints"], json!([{"id": m.0, "index": 4}]), "{tool}: still picked");
+        s.execute("edit.undo", &json!({})).unwrap();
+        s.execute("edit.undo", &json!({})).unwrap();
+        assert!(colors(&s).iter().all(|c| c == "#ff0000"), "{tool}: undone");
+    }
+    s.select_tool("selection", v).unwrap();
+    click(&mut s, 425.0, 35.0, Mods::default());
+    assert!(colors(&s).iter().all(|c| c == "#ff0000"), "no point picked: {:?}", colors(&s));
+}
