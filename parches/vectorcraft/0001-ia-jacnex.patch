+//! Jacnex: la IA integrada de Vectornex (Objeto › IA de Jacnex…).
+//!
+//! Se describe un logo, un ícono, una ilustración o una mascota; un modelo de imagen lo dibuja
+//! **plano** (colores sólidos, sin degradados ni sombras, sobre fondo blanco) y Vectornex lo
+//! convierte en **trazados editables agrupados por color** con su propio Calco de imagen, en este
+//! equipo: primero en modo «Flat Logo» (bordes precisos, colores exactos) y, si la imagen no es
+//! plana, en «Auto Color». El fondo blanco se ignora. También vectoriza gratis, sin IA, la imagen
+//! que esté seleccionada.
+//!
+//! La red y el trazado van en hilos aparte: la interfaz nunca se congela. El servidor es
+//! app.jacnex.store (`/v1/jacnex/*`), con la llave de la sesión iniciada en Jacnex Studio. Los
+//! créditos se descuentan en el servidor, que los devuelve si una generación falla.
+
+use std::sync::mpsc::{Receiver, Sender, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::{Color32, RichText};
+use serde_json::{Value, json};
+use vectorcraft_engine::cmd::{TraceRun, Traced};
+
+use crate::VectorcraftApp;
+
+/// El modelo por defecto: el más usado.
+pub const MODELO: &str = "nano-banana-2";
+/// Los modelos de imagen, de más a menos usados: así se listan (los que no están aquí, al final).
+const POPULARIDAD: &[&str] = &["nano-banana-2", "nano-banana-pro", "gpt-image-2", "nano-banana", "seedream-5-flash", "flux-2-pro"];
+/// Los modelos de imagen conocidos, para mostrarlos antes de que responda el servidor (que manda
+/// sus precios): (id, nombre, proporciones, descripción).
+const MODELOS_BASE: &[(&str, &str, &str, &str)] = &[
+    ("nano-banana-2", "Google Nano Banana 2", GEMINI, "Rápido y muy bueno para el día a día."),
+    ("nano-banana-pro", "Google Nano Banana Pro", GEMINI, "La mejor calidad de Google: formas limpias y detalle nítido."),
+    ("gpt-image-2", "OpenAI GPT Image 2", "1:1 4:3 3:4 3:2 2:3 16:9 9:16", "Sigue tus indicaciones al pie de la letra, incluido el texto del logo."),
+    ("nano-banana", "Google Nano Banana", GEMINI, "El más económico de Google. Bueno para probar ideas."),
+    ("seedream-5-flash", "ByteDance Seedream 5.0 Flash", "1:1 4:3 3:4 3:2 2:3 16:9 9:16 21:9", "Imágenes 2K a muy buen precio."),
+    ("flux-2-pro", "Black Forest Labs FLUX.2 Pro", "1:1 4:3 3:4 3:2 2:3 16:9 9:16", "Estilos artísticos con mucho control."),
+];
+const GEMINI: &str = "1:1 4:5 3:4 2:3 9:16 4:3 3:2 16:9 21:9";
+/// El lado más largo que se acepta de una imagen recibida.
+const MAX_LADO: u32 = 8192;
+const MB: u64 = 1024 * 1024;
+/// Lo más que puede pesar una imagen recibida.
+const MAX_BYTES: u64 = 40 * MB;
+/// El comando que traza y convierte en trazados.
+const TRAZAR: &str = "imageTrace.makeAndExpand";
+/// Lo que dice el Calco de imagen cuando una imagen no es plana para «Flat Logo».
+const NO_PLANA: &str = "flat-colour logo";
+
+/// Qué se crea: cambia las instrucciones al modelo.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Estilo {
+    #[default]
+    Logo,
+    Icono,
+    Ilustracion,
+    Mascota,
+}
+
+impl Estilo {
+    pub const TODOS: [Estilo; 4] = [Estilo::Logo, Estilo::Icono, Estilo::Ilustracion, Estilo::Mascota];
+
+    pub fn nombre(self) -> &'static str {
+        match self {
+            Estilo::Logo => "Logo",
+            Estilo::Icono => "Ícono",
+            Estilo::Ilustracion => "Ilustración",
+            Estilo::Mascota => "Mascota",
+        }
+    }
+
+    fn explicacion(self) -> &'static str {
+        match self {
+            Estilo::Logo => "Un logo simple de pocos colores, listo para tu marca.",
+            Estilo::Icono => "Un ícono de líneas y formas limpias, para web o apps.",
+            Estilo::Ilustracion => "Una escena o un objeto en estilo plano, con más colores.",
+            Estilo::Mascota => "Un personaje amigable para tu marca, en estilo plano.",
+        }
+    }
+
+    fn pista(self) -> &'static str {
+        match self {
+            Estilo::Logo => "Ej.: un colibrí verde para una tienda de jugos",
+            Estilo::Icono => "Ej.: un carrito de compras",
+            Estilo::Ilustracion => "Ej.: una taza de café con granos alrededor",
+            Estilo::Mascota => "Ej.: una llama sonriente con chullo",
+        }
+    }
+
+    fn ideas(self) -> &'static [&'static str] {
+        match self {
+            Estilo::Logo => &["una hoja con una gota de agua", "un león geométrico", "una montaña con el sol"],
+            Estilo::Icono => &["una casa", "un sobre de correo", "una campana"],
+            Estilo::Ilustracion => &["una planta en maceta", "una ciudad al atardecer", "frutas tropicales"],
+            Estilo::Mascota => &["un gato astronauta", "un robot amable", "un perro chef"],
+        }
+    }
+
+    /// Las instrucciones al modelo: lo pedido, en estilo plano sobre blanco, para que el Calco de
+    /// imagen lo convierta en trazados limpios.
+    fn instrucciones(self, pedido: &str) -> String {
+        let pedido = pedido.trim();
+        let plano = "Flat 2D vector style: solid flat colors only, no gradients, no shadows, no glow, no texture, no noise, \
+                     no 3D, crisp clean edges, well separated shapes. Centered on a plain pure white background (#FFFFFF), \
+                     with generous empty margins. No mockup, no frame, no watermark.";
+        match self {
+            Estilo::Logo => format!(
+                "A minimalist flat vector logo: {pedido}. Simple bold geometric shapes, a limited palette of 2 to 4 colors. \
+                 No text unless the description asks for it. {plano}"
+            ),
+            Estilo::Icono => format!("A flat vector icon: {pedido}. Simple, bold, readable at small sizes, 1 to 3 colors. No text. {plano}"),
+            Estilo::Ilustracion => format!("A flat vector illustration: {pedido}. Clean simple shapes, a limited palette of up to 8 colors. {plano}"),
+            Estilo::Mascota => format!(
+                "A friendly flat vector mascot character: {pedido}. Cute, simple shapes, thick clean outlines, up to 6 colors. No text. {plano}"
+            ),
+        }
+    }
+}
+
+/// La proporción de la imagen.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum Proporcion {
+    #[default]
+    Cuadrada,
+    Horizontal,
+    Vertical,
+    Ancha,
+}
+
+impl Proporcion {
+    pub const TODAS: [Proporcion; 4] = [Proporcion::Cuadrada, Proporcion::Horizontal, Proporcion::Vertical, Proporcion::Ancha];
+
+    fn aspecto(self) -> (u32, u32) {
+        match self {
+            Proporcion::Cuadrada => (1, 1),
+            Proporcion::Horizontal => (4, 3),
+            Proporcion::Vertical => (3, 4),
+            Proporcion::Ancha => (16, 9),
+        }
+    }
+
+    /// El tamaño en píxeles que se pide (lado largo de unos 1 024).
+    fn tamano(self) -> (u32, u32) {
+        match self {
+            Proporcion::Cuadrada => (1024, 1024),
+            Proporcion::Horizontal => (1152, 864),
+            Proporcion::Vertical => (864, 1152),
+            Proporcion::Ancha => (1344, 756),
+        }
+    }
+
+    fn nombre(self) -> String {
+        let (a, b) = self.aspecto();
+        format!("{a}:{b}")
+    }
+}
+
+/// Un modelo o herramienta del servidor, con sus créditos por opción.
+#[derive(Clone, Debug)]
+struct ModeloInfo {
+    id: String,
+    nombre: String,
+    descripcion: String,
+    herramienta: bool,
+    aspectos: Vec<(u32, u32)>,
+    /// Créditos por opción: `1k`/`2k`/`4k` o `unica`.
+    creditos: Vec<(String, i64)>,
+}
+
+impl ModeloInfo {
+    fn costo(&self, clave: &str) -> Option<i64> {
+        let por = |k: &str| self.creditos.iter().find(|(c, _)| c == k).map(|(_, v)| *v);
+        por(clave).or_else(|| por("unica")).or_else(|| (clave == "1k").then(|| self.creditos.first().map(|c| c.1)).flatten())
+    }
+
+    fn tiene_resoluciones(&self) -> bool {
+        self.creditos.iter().any(|(c, _)| c == "1k")
+    }
+}
+
+/// `"16:9"` → (16, 9).
+fn aspecto(s: &str) -> Option<(u32, u32)> {
+    let (a, b) = s.split_once(':')?;
+    let (a, b) = (a.trim().parse::<u32>().ok()?, b.trim().parse::<u32>().ok()?);
+    (a > 0 && b > 0).then_some((a, b))
+}
+
+fn modelos_base() -> Vec<ModeloInfo> {
+    MODELOS_BASE
+        .iter()
+        .map(|(id, nombre, aspectos, desc)| ModeloInfo {
+            id: (*id).into(),
+            nombre: (*nombre).into(),
+            descripcion: (*desc).into(),
+            herramienta: false,
+            aspectos: aspectos.split_whitespace().filter_map(aspecto).collect(),
+            creditos: Vec::new(),
+        })
+        .collect()
+}
+
+/// La cuenta y el catálogo, según el servidor.
+#[derive(Clone, Debug)]
+struct Info {
+    nombre: String,
+    creditos: i64,
+    modelos: Vec<ModeloInfo>,
+}
+
+/// Lo que el hilo de red le cuenta a la interfaz.
+enum Evento {
+    Etapa(&'static str),
+    Cobrado { saldo: Option<i64> },
+    /// La imagen recibida, en PNG, y su tamaño.
+    Listo(Vec<u8>, u32, u32),
+    Error(String),
+}
+
+/// Una generación en curso.
+struct Trabajo {
+    rx: Receiver<Evento>,
+    etapa: &'static str,
+    inicio: Instant,
+    /// El documento al que va ([`vectorcraft_engine::DocState::uid`]); ninguno: uno nuevo.
+    doc: Option<u64>,
+}
+
+/// Lo que devuelve el hilo del trazado: la corrida, lo trazado y si la imagen era plana.
+type Trazado = Result<(TraceRun, Traced, bool), String>;
+
+/// Un trazado en curso.
+struct Trazo {
+    rx: Receiver<Trazado>,
+    doc: u64,
+    inicio: Instant,
+    /// Viene de una generación (no de «Vectorizar la imagen seleccionada»).
+    de_ia: bool,
+}
+
+/// El estado de la IA en la app.
+#[derive(Default)]
+pub struct Estado {
+    /// La ventana «IA de Jacnex» está abierta.
+    pub abierta: bool,
+    /// Lo que se quiere crear (prompt).
+    pub prompt: String,
+    pub estilo: Estilo,
+    /// El id del modelo de imagen elegido (vacío = [`MODELO`]).
+    pub modelo: String,
+    pub proporcion: Proporcion,
+    info: Option<Info>,
+    info_error: Option<String>,
+    info_rx: Option<Receiver<Result<Info, String>>>,
+    trabajo: Option<Trabajo>,
+    trazo: Option<Trazo>,
+    /// El último aviso: (salió bien, texto).
+    aviso: Option<(bool, String)>,
+    /// Hay una sesión de Jacnex Studio (se vuelve a mirar al abrir la ventana o actualizar).
+    con_sesion: bool,
+    /// Un servidor de pruebas en esta máquina, en lugar de la cuenta de Jacnex Studio
+    /// ([`usar_servidor_local`]).
+    local: Option<(String, String)>,
+}
+
+impl Estado {
+    /// Los modelos de imagen, de más a menos usados: los del servidor, o los conocidos mientras
+    /// no responde.
+    fn modelos(&self) -> Vec<ModeloInfo> {
+        let mut lista: Vec<ModeloInfo> = match &self.info {
+            Some(i) if i.modelos.iter().any(|m| !m.herramienta) => i.modelos.iter().filter(|m| !m.herramienta).cloned().collect(),
+            _ => modelos_base(),
+        };
+        lista.sort_by_key(|m| POPULARIDAD.iter().position(|p| *p == m.id).unwrap_or(POPULARIDAD.len()));
+        lista
+    }
+
+    fn modelo_actual(&self) -> ModeloInfo {
+        let lista = self.modelos();
+        let id = if self.modelo.is_empty() { MODELO } else { self.modelo.as_str() };
+        lista.iter().find(|m| m.id == id).or_else(|| lista.iter().find(|m| m.id == MODELO)).or(lista.first()).cloned().unwrap_or_else(|| ModeloInfo {
+            id: MODELO.into(),
+            nombre: "Google Nano Banana 2".into(),
+            descripcion: String::new(),
+            herramienta: false,
+            aspectos: Vec::new(),
+            creditos: Vec::new(),
+        })
+    }
+
+    /// Los créditos de una generación con el modelo y la proporción elegidos, según el servidor.
+    fn costo(&self) -> Option<i64> {
+        self.info.as_ref()?;
+        self.modelo_actual().costo("1k")
+    }
+
+    fn ocupado(&self) -> bool {
+        self.trabajo.is_some() || self.trazo.is_some()
+    }
+}
+
+/// Usa un Forgenex de pruebas en esta máquina (`http://127.0.0.1:…` o `http://localhost:…`) con
+/// la llave `llave`, en lugar de la sesión de Jacnex Studio. Otras direcciones se rechazan.
+pub fn usar_servidor_local(app: &mut VectorcraftApp, servidor: &str, llave: &str) -> bool {
+    let ok = es_local(servidor) && llave.starts_with("jk_");
+    if ok {
+        app.jacnex_ia.local = Some((servidor.trim_end_matches('/').to_string(), llave.to_string()));
+    }
+    ok
+}
+
+// --- Cuenta y servidor -----------------------------------------------------------------------
+
+struct Conexion {
+    servidor: String,
+    llave: String,
+}
+
+/// El servidor: app.jacnex.store. `JACNEX_IA_SERVIDOR` solo puede apuntar a esta misma máquina
+/// (pruebas con un Forgenex local); cualquier otro valor se ignora.
+fn servidor() -> String {
+    match std::env::var("JACNEX_IA_SERVIDOR") {
+        Ok(s) if es_local(&s) => s.trim_end_matches('/').to_string(),
+        _ => "https://app.jacnex.store".to_string(),
+    }
+}
+
+fn es_local(url: &str) -> bool {
+    url.starts_with("http://127.0.0.1:") || url.starts_with("http://localhost:")
+}
+
+/// La llave de la sesión de Jacnex Studio (`%LOCALAPPDATA%\Jacnex Studio\cuenta.json`). Con un
+/// servidor local de pruebas vale `JACNEX_IA_LLAVE`.
+fn conexion(e: &Estado) -> Option<Conexion> {
+    if let Some((servidor, llave)) = &e.local {
+        return Some(Conexion { servidor: servidor.clone(), llave: llave.clone() });
+    }
+    let servidor = servidor();
+    if es_local(&servidor)
+        && let Ok(llave) = std::env::var("JACNEX_IA_LLAVE")
+    {
+        return llave.starts_with("jk_").then_some(Conexion { servidor, llave });
+    }
+    let base = std::env::var_os("LOCALAPPDATA")
+        .map(std::path::PathBuf::from)
+        .or_else(|| std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".local").join("share")))?;
+    let texto = std::fs::read_to_string(base.join("Jacnex Studio").join("cuenta.json")).ok()?;
+    let v: Value = serde_json::from_str(&texto).ok()?;
+    let llave = v.get("llave")?.as_str()?.to_string();
+    llave.starts_with("jk_").then_some(Conexion { servidor, llave })
+}
+
+/// El catálogo de `/v1/jacnex/estado`.
+fn leer_info(v: &Value) -> Info {
+    let modelos = v
+        .get("modelos")
+        .and_then(|m| m.as_array())
+        .map(|lista| {
+            lista
+                .iter()
+                .filter_map(|m| {
+                    let s = |k: &str| m.get(k).and_then(|x| x.as_str()).unwrap_or("").to_string();
+                    let id = s("id");
+                    if id.is_empty() {
+                        return None;
+                    }
+                    let proveedor = s("proveedor");
+                    let nombre = s("nombre");
+                    let herramienta = s("tipo") == "herramienta";
+                    let nombre = if herramienta || proveedor.is_empty() { nombre } else { format!("{proveedor} {nombre}") };
+                    let creditos = m
+                        .get("creditos")
+                        .and_then(|c| c.as_object())
+                        .map(|c| c.iter().filter_map(|(k, v)| Some((k.clone(), v.as_i64()?))).collect())
+                        .unwrap_or_default();
+                    let aspectos = m
+                        .get("aspectos")
+                        .and_then(|a| a.as_array())
+                        .map(|a| a.iter().filter_map(|x| x.as_str().and_then(aspecto)).collect())
+                        .unwrap_or_default();
+                    Some(ModeloInfo { id, nombre, descripcion: s("descripcion"), herramienta, aspectos, creditos })
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    Info {
+        nombre: v.get("nombre").and_then(|x| x.as_str()).unwrap_or("").to_string(),
+        creditos: v.get("creditos").and_then(|x| x.as_i64()).unwrap_or(0),
+        modelos,
+    }
+}
+
+/// Un pedido a `/v1/jacnex/generar` (de texto a imagen: sin imágenes).
+struct Envio {
+    modelo: String,
+    prompt: String,
+    tamano: (u32, u32),
+    aspecto: Option<(u32, u32)>,
+    resolucion: Option<&'static str>,
+}
+
+/// La imagen recibida (PNG, JPEG, WebP…) como PNG, con su tamaño.
+fn a_png(bytes: &[u8]) -> Result<(Vec<u8>, u32, u32), String> {
+    let img = image::load_from_memory(bytes).map_err(|e| format!("La imagen recibida no se pudo leer: {e}"))?;
+    let (w, h) = (img.width(), img.height());
+    if w == 0 || h == 0 || w > MAX_LADO || h > MAX_LADO {
+        return Err("La imagen recibida tiene un tamaño no válido.".into());
+    }
+    let mut png = Vec::new();
+    img.to_rgba8().write_to(&mut std::io::Cursor::new(&mut png), image::ImageFormat::Png).map_err(|e| format!("No se pudo preparar la imagen: {e}"))?;
+    Ok((png, w, h))
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod red {
+    use super::{Conexion, Envio, Evento, Info, es_local};
+    use std::sync::mpsc::Sender;
+    use std::time::{Duration, Instant};
+
+    const LIMITE_JSON: u64 = 1024 * 1024;
+
+    fn agente(segundos: u64, https: bool) -> ureq::Agent {
+        ureq::Agent::config_builder()
+            .tls_config(ureq::tls::TlsConfig::builder().root_certs(ureq::tls::RootCerts::PlatformVerifier).build())
+            .https_only(https)
+            .timeout_global(Some(Duration::from_secs(segundos)))
+            .http_status_as_error(false)
+            .user_agent("Vectornex")
+            .build()
+            .new_agent()
+    }
+
+    fn agente_para(c: &Conexion, segundos: u64) -> ureq::Agent {
+        agente(segundos, !es_local(&c.servidor))
+    }
+
+    /// El cuerpo JSON de una respuesta; los errores del servidor (`{error:{message}}`) como texto.
+    fn json(r: Result<ureq::http::Response<ureq::Body>, ureq::Error>) -> Result<serde_json::Value, String> {
+        let mut r = r.map_err(|e| format!("No se pudo conectar con Jacnex: {e}"))?;
+        let estado = r.status().as_u16();
+        let texto = r.body_mut().with_config().limit(LIMITE_JSON).read_to_string().map_err(|e| format!("Respuesta incompleta: {e}"))?;
+        let v: serde_json::Value = serde_json::from_str(&texto).unwrap_or(serde_json::Value::Null);
+        if (200..300).contains(&estado) {
+            return Ok(v);
+        }
+        let msg = v.pointer("/error/message").and_then(|m| m.as_str()).map(str::to_string);
+        Err(match (estado, msg) {
+            (401, _) => "Tu sesión de Jacnex venció. Vuelve a iniciar sesión en Jacnex Studio.".into(),
+            (_, Some(m)) => m,
+            (404, None) => "El servidor de Jacnex aún no tiene esta función. Inténtalo más tarde.".into(),
+            _ => format!("El servidor respondió {estado}."),
+        })
+    }
+
+    pub fn info(c: &Conexion) -> Result<Info, String> {
+        let url = format!("{}/v1/jacnex/estado", c.servidor);
+        let v = json(agente_para(c, 20).get(&url).header("Authorization", &format!("Bearer {}", c.llave)).call())?;
+        Ok(super::leer_info(&v))
+    }
+
+    /// Un cuerpo multipart/form-data de campos de texto.
+    fn multipart(campos: &[(&str, String)]) -> (String, Vec<u8>) {
+        let semilla = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos());
+        let limite = format!("----vectornex{semilla:x}");
+        let mut b = Vec::new();
+        for (k, v) in campos {
+            b.extend_from_slice(format!("--{limite}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n").as_bytes());
+        }
+        b.extend_from_slice(format!("--{limite}--\r\n").as_bytes());
+        (format!("multipart/form-data; boundary={limite}"), b)
+    }
+
+    /// Crea el trabajo de `e`, espera su resultado y lo descarga (hasta `limite` bytes).
+    pub fn generar(c: &Conexion, e: Envio, limite: u64, tx: &Sender<Evento>) -> Result<Vec<u8>, String> {
+        let auth = format!("Bearer {}", c.llave);
+        let _ = tx.send(Evento::Etapa("Enviando tu idea…"));
+        let (w, h) = e.tamano;
+        let mut campos = vec![("model", e.modelo), ("prompt", e.prompt), ("n", "1".to_string()), ("size", format!("{w}x{h}"))];
+        if let Some((a, b)) = e.aspecto {
+            campos.push(("aspect", format!("{a}:{b}")));
+        }
+        if let Some(r) = e.resolucion {
+            campos.push(("resolution", r.to_string()));
+        }
+        let (tipo, cuerpo) = multipart(&campos);
+        let url = format!("{}/v1/jacnex/generar", c.servidor);
+        let v = json(agente_para(c, 180).post(&url).header("Authorization", &auth).header("Content-Type", &tipo).send(&cuerpo[..]))?;
+        let id = v
+            .get("id")
+            .and_then(|x| x.as_str())
+            .or_else(|| v.pointer("/ids/0").and_then(|x| x.as_str()))
+            .map(str::to_string)
+            .ok_or_else(|| "El servidor no devolvió el trabajo.".to_string())?;
+        let _ = tx.send(Evento::Cobrado { saldo: v.get("saldo").and_then(|x| x.as_i64()) });
+        let _ = tx.send(Evento::Etapa("La IA está dibujando…"));
+        let inicio = Instant::now();
+        let resultado = loop {
+            std::thread::sleep(Duration::from_millis(1500));
+            if inicio.elapsed() > Duration::from_secs(420) {
+                return Err("La IA tardó demasiado. Si no llega, tus créditos se devuelven solos.".into());
+            }
+            let consulta = format!("{}/v1/jacnex/trabajo/{id}", c.servidor);
+            let v = match json(agente_para(c, 30).get(&consulta).header("Authorization", &auth).call()) {
+                Ok(v) => v,
+                // Un corte de red momentáneo no pierde el trabajo: se vuelve a consultar.
+                Err(m) if m.starts_with("No se pudo conectar") => continue,
+                Err(m) => return Err(m),
+            };
+            match v.get("estado").and_then(|x| x.as_str()) {
+                Some("listo") => match v.pointer("/resultados/0").and_then(|x| x.as_str()) {
+                    Some(u) => break u.to_string(),
+                    None => return Err("La IA no devolvió ninguna imagen. Tus créditos fueron devueltos.".into()),
+                },
+                Some("fallido") => {
+                    let m = v.get("error").and_then(|x| x.as_str()).unwrap_or("La IA no pudo completar la imagen.");
+                    return Err(format!("{m} Tus créditos fueron devueltos."));
+                }
+                _ => {}
+            }
+        };
+        let _ = tx.send(Evento::Etapa("Descargando la imagen…"));
+        descargar(c, &resultado, &auth, limite)
+    }
+
+    fn descargar(c: &Conexion, url: &str, auth: &str, limite: u64) -> Result<Vec<u8>, String> {
+        let local = es_local(url) && es_local(&c.servidor);
+        if !local && !url.starts_with("https://") {
+            return Err("La dirección del resultado no es segura.".into());
+        }
+        // La llave solo viaja a Jacnex: los resultados alojados en otro sitio se piden sin ella.
+        let mut pedido = agente(300, !local).get(url);
+        if url.starts_with(&format!("{}/", c.servidor)) {
+            pedido = pedido.header("Authorization", auth);
+        }
+        let mut r = pedido.call().map_err(|e| format!("No se pudo descargar el resultado: {e}"))?;
+        if !r.status().is_success() {
+            return Err(format!("No se pudo descargar el resultado ({}).", r.status().as_u16()));
+        }
+        r.body_mut().with_config().limit(limite).read_to_vec().map_err(|e| format!("Descarga incompleta: {e}"))
+    }
+}
