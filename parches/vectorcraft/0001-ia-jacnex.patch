+/// Pide la imagen al servidor (en un hilo); al llegar se coloca y se vectoriza ([`actualizar`]).
+pub fn generar(app: &mut VectorcraftApp) {
+    let e = &mut app.jacnex_ia;
+    if e.local.is_none() && !e.con_sesion {
+        e.con_sesion = conexion(e).is_some();
+    }
+    if let Some(f) = falta(e) {
+        e.aviso = Some((false, f.into()));
+        return;
+    }
+    let Some(c) = conexion(e) else {
+        e.aviso = Some((false, "Inicia sesión en Jacnex Studio para usar la IA.".into()));
+        return;
+    };
+    let m = e.modelo_actual();
+    let p = e.proporcion;
+    let a = p.aspecto();
+    let envio = Envio {
+        modelo: m.id.clone(),
+        prompt: e.estilo.instrucciones(&e.prompt),
+        tamano: p.tamano(),
+        aspecto: (m.aspectos.is_empty() || m.aspectos.contains(&a)).then_some(a),
+        resolucion: m.tiene_resoluciones().then_some("1k"),
+    };
+    let doc = app.session.active().map(|d| d.uid);
+    let e = &mut app.jacnex_ia;
+    e.aviso = None;
+    let rx = en_hilo(move |tx| {
+        let r = red::generar(&c, envio, MAX_BYTES, &tx).and_then(|bytes| a_png(&bytes));
+        let _ = tx.send(match r {
+            Ok((png, w, h)) => Evento::Listo(png, w, h),
+            Err(m) => Evento::Error(m),
+        });
+    });
+    e.trabajo = Some(Trabajo { rx, etapa: "Preparando…", inicio: Instant::now(), doc });
+}
+
+/// Coloca la imagen `png` (`w`×`h` px) en el documento de la generación (o en uno nuevo), a un
+/// 80 % de su mesa de trabajo activa → el id del objeto colocado.
+fn colocar(app: &mut VectorcraftApp, doc: Option<u64>, png: &[u8], w: u32, h: u32) -> Result<u64, String> {
+    let destino = doc.and_then(|uid| app.session.documents().iter().position(|d| d.uid == uid));
+    match destino {
+        Some(i) => {
+            app.session.set_active(i);
+        }
+        None => {
+            // Un documento nuevo del tamaño de la imagen (lado largo de 800 pt).
+            let k = 800.0 / f64::from(w.max(h).max(1));
+            let (dw, dh) = ((f64::from(w) * k).round(), (f64::from(h) * k).round());
+            app.run("file.new", json!({"name": "IA de Jacnex", "width": dw, "height": dh}))?;
+        }
+    }
+    let d = app.session.active().ok_or("No hay un documento donde colocar la imagen.")?;
+    let mesa = d.active_artboard.and_then(|id| d.doc.artboards.iter().find(|a| a.id == id)).or(d.doc.artboards.first()).map(|a| a.rect);
+    let (x, y, mw, mh) = match mesa {
+        Some(r) => (r.x0, r.y0, r.width(), r.height()),
+        None => (0.0, 0.0, f64::from(w), f64::from(h)),
+    };
+    let f = if destino.is_some() { 0.8 } else { 1.0 };
+    let (cw, ch) = (mw * f, mh * f);
+    let rect = [x + (mw - cw) / 2.0, y + (mh - ch) / 2.0, cw, ch];
+    let v = app.run("file.place", json!({"name": "ia-jacnex.png", "dataBase64": vectorcraft_format::base64_encode(png), "rect": rect}))?;
+    v.pointer("/ids/0").and_then(Value::as_u64).ok_or_else(|| "La imagen no se pudo colocar.".to_string())
+}
+
+/// Los parámetros del trazado de `id` (o de lo seleccionado) con `preset`: por colores, sin el
+/// fondo blanco.
+fn parametros(id: Option<u64>, preset: &str) -> Value {
+    let mut p = json!({"preset": preset, "byColor": true, "params": {"ignoreWhite": true}});
+    if let (Some(id), Some(o)) = (id, p.as_object_mut()) {
+        o.insert("id".into(), json!(id));
+    }
+    p
+}
+
+fn es_no_plana(e: &str) -> bool {
+    e.contains(NO_PLANA)
+}
+
+fn listo(plana: bool, de_ia: bool) -> String {
+    let base = if de_ia { "Listo: tu diseño ya es vector editable, agrupado por color." } else { "Listo: la imagen ya es vector editable, agrupado por color." };
+    if plana { format!("{base} Ctrl+Z lo deshace.") } else { format!("{base} Tenía degradados: se trazó con más colores.") }
+}
+
+/// Vectoriza el objeto `id` (o la imagen seleccionada): «Flat Logo» y, si no es plana,
+/// «Auto Color». En un hilo aparte donde se puede; si no, al momento.
+fn vectorizar(app: &mut VectorcraftApp, id: Option<u64>, de_ia: bool) -> Result<(), String> {
+    let (plano, color) = (parametros(id, "Flat Logo"), parametros(id, "Auto Color"));
+    if !crate::trace_runs::available(app) {
+        let (r, plana) = match app.run(TRAZAR, plano) {
+            Err(e) if es_no_plana(&e) => (app.run(TRAZAR, color), false),
+            r => (r, true),
+        };
+        r?;
+        app.jacnex_ia.aviso = Some((true, listo(plana, de_ia)));
+        return Ok(());
+    }
+    let a = TraceRun::prepare(&app.session, TRAZAR, &plano).map_err(|e| e.to_string())?;
+    let b = TraceRun::prepare(&app.session, TRAZAR, &color).map_err(|e| e.to_string())?;
+    let doc = app.session.doc().map_err(|e| e.to_string())?.uid;
+    let rx = en_hilo(move |tx| {
+        let seguir = |_: u64, _: u64| true;
+        let r = match vectorcraft_engine::guard::catch_panic(|| a.run(&seguir)) {
+            Ok(Ok(t)) => Ok((a, t, true)),
+            Ok(Err(e)) if es_no_plana(&e.to_string()) => match vectorcraft_engine::guard::catch_panic(|| b.run(&seguir)) {
+                Ok(Ok(t)) => Ok((b, t, false)),
+                Ok(Err(e)) => Err(e.to_string()),
+                Err(m) => Err(format!("error interno: {m}")),
+            },
+            Ok(Err(e)) => Err(e.to_string()),
+            Err(m) => Err(format!("error interno: {m}")),
+        };
+        let _ = tx.send(r);
+    });
+    app.jacnex_ia.trazo = Some(Trazo { rx, doc, inicio: Instant::now(), de_ia });
+    Ok(())
+}
+
+/// «Vectorizar la imagen seleccionada»: sin IA ni créditos.
+pub fn vectorizar_seleccion(app: &mut VectorcraftApp) {
+    if app.jacnex_ia.ocupado() {
+        return;
+    }
+    app.jacnex_ia.aviso = None;
+    if let Err(e) = vectorizar(app, None, false) {
+        app.jacnex_ia.aviso = Some((false, mensaje_trazo(&e)));
+    }
+}
+
+fn mensaje_trazo(e: &str) -> String {
+    if e.contains("select an image") || e.contains("nothing selected") {
+        "Primero selecciona una imagen colocada (Archivo › Colocar…).".into()
+    } else {
+        format!("No se pudo vectorizar: {e}")
+    }
+}
+
+/// Hay una imagen seleccionada que se puede vectorizar.
+fn hay_imagen(app: &VectorcraftApp) -> bool {
+    TraceRun::prepare(&app.session, TRAZAR, &parametros(None, "Auto Color")).is_ok()
+}
+
+/// Atiende la red y el trazado (cada cuadro, con la ventana abierta o no).
+pub fn actualizar(app: &mut VectorcraftApp, ctx: &egui::Context) {
+    if let Some(rx) = app.jacnex_ia.info_rx.as_ref() {
+        match rx.try_recv() {
+            Ok(r) => {
+                app.jacnex_ia.info_rx = None;
+                match r {
+                    Ok(i) => {
+                        app.jacnex_ia.info = Some(i);
+                        app.jacnex_ia.info_error = None;
+                    }
+                    Err(e) => app.jacnex_ia.info_error = Some(e),
+                }
+            }
+            Err(TryRecvError::Empty) => ctx.request_repaint_after(Duration::from_millis(250)),
+            Err(TryRecvError::Disconnected) => app.jacnex_ia.info_rx = None,
+        }
+    }
+    actualizar_trabajo(app, ctx);
+    actualizar_trazo(app, ctx);
+}
+
+fn actualizar_trabajo(app: &mut VectorcraftApp, ctx: &egui::Context) {
+    // Como el Calco de imagen: no mientras un diálogo o una edición con el puntero están abiertos.
+    let esperar = app.ui.dialog.is_some() || app.session.in_interaction() || (app.session.tool_busy() && app.session.pointer_held());
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return };
+    let mut fin: Option<Result<(Vec<u8>, u32, u32), String>> = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Evento::Etapa(s)) => t.etapa = s,
+            Ok(Evento::Cobrado { saldo }) => {
+                if let (Some(i), Some(s)) = (app.jacnex_ia.info.as_mut(), saldo) {
+                    i.creditos = s;
+                }
+            }
+            Ok(Evento::Listo(png, w, h)) => fin = Some(Ok((png, w, h))),
+            Ok(Evento::Error(e)) => fin = Some(Err(e)),
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin.get_or_insert_with(|| Err("La generación se interrumpió.".into()));
+                break;
+            }
+        }
+        if fin.is_some() {
+            break;
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    };
+    if fin.is_ok() && esperar {
+        // Vuelve a intentarlo en el próximo cuadro, con el resultado guardado.
+        let (tx, rx) = std::sync::mpsc::channel();
+        if let Ok((png, w, h)) = fin {
+            let _ = tx.send(Evento::Listo(png, w, h));
+        }
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    }
+    let doc = t.doc;
+    app.jacnex_ia.trabajo = None;
+    let r = fin.and_then(|(png, w, h)| colocar(app, doc, &png, w, h)).and_then(|id| vectorizar(app, Some(id), true).map_err(|e| mensaje_trazo(&e)));
+    if let Err(m) = r {
+        app.jacnex_ia.aviso = Some((false, m));
+    }
+    pedir_info(&mut app.jacnex_ia);
+    ctx.request_repaint();
+}
+
+fn actualizar_trazo(app: &mut VectorcraftApp, ctx: &egui::Context) {
+    let Some(t) = app.jacnex_ia.trazo.as_ref() else { return };
+    if app.ui.dialog.is_some() || app.session.in_interaction() || (app.session.tool_busy() && app.session.pointer_held()) {
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    }
+    let r = match t.rx.try_recv() {
+        Ok(r) => r,
+        Err(TryRecvError::Empty) => {
+            ctx.request_repaint_after(Duration::from_millis(150));
+            return;
+        }
+        Err(TryRecvError::Disconnected) => Err("el trazado se detuvo".into()),
+    };
+    let (doc, de_ia) = (t.doc, t.de_ia);
+    app.jacnex_ia.trazo = None;
+    let aviso = match r {
+        Ok((run, traced, plana)) => match app.session.documents().iter().position(|st| st.uid == doc) {
+            None => (false, "El documento se cerró antes de terminar de vectorizar.".to_string()),
+            Some(i) => {
+                app.session.set_active(i);
+                if run.current(&app.session) {
+                    traced.hand_in(&mut app.session);
+                    match app.run(run.command(), run.params().clone()) {
+                        Ok(_) => (true, listo(plana, de_ia)),
+                        Err(e) => (false, mensaje_trazo(&e)),
+                    }
+                } else {
+                    (false, "La imagen cambió mientras se vectorizaba: vuelve a intentarlo.".to_string())
+                }
+            }
+        },
+        Err(e) => (false, mensaje_trazo(&e)),
+    };
+    app.jacnex_ia.aviso = Some(aviso);
+    ctx.request_repaint();
+}
+
+/// Abre o cierra la ventana «IA de Jacnex» (Objeto › IA de Jacnex…).
+pub fn alternar(app: &mut VectorcraftApp) {
+    let e = &mut app.jacnex_ia;
+    e.abierta = !e.abierta;
+    if e.abierta {
+        pedir_info(e);
+    }
+}
