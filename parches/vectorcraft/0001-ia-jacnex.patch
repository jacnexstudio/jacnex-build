+// --- Generar, colocar y vectorizar ------------------------------------------------------------
+
+/// Por qué no se puede generar ahora (o nada).
+fn falta(e: &Estado) -> Option<&'static str> {
+    if e.ocupado() {
+        Some("Espera a que termine lo que está en curso.")
+    } else if !e.con_sesion && e.local.is_none() {
+        Some("Inicia sesión en Jacnex Studio para usar la IA.")
+    } else if e.prompt.trim().is_empty() {
+        Some("Describe lo que quieres crear.")
+    } else if let (Some(i), Some(c)) = (&e.info, e.costo())
+        && i.creditos < c
+    {
+        Some("No tienes créditos suficientes: recarga en jacnex.store.")
+    } else {
+        None
+    }
+}
+
+/// Está generando o vectorizando.
+pub fn ocupado(app: &VectorcraftApp) -> bool {
+    app.jacnex_ia.ocupado()
+}
+
+/// El último aviso: (salió bien, texto).
+pub fn aviso(app: &VectorcraftApp) -> Option<(bool, String)> {
+    app.jacnex_ia.aviso.clone()
+}
