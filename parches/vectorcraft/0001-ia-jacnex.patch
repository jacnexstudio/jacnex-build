+/// Lo que la ventana pide hacer al cerrarse el cuadro.
+#[derive(Default)]
+struct Pedidos {
+    cerrar: bool,
+    generar: bool,
+    vectorizar: bool,
+}
+
+/// La ventana «IA de Jacnex» (y lo que la IA tenga en curso, aunque esté cerrada).
+pub fn ventana(app: &mut VectorcraftApp, ctx: &egui::Context) {
+    actualizar(app, ctx);
+    if !app.jacnex_ia.abierta {
+        return;
+    }
+    let mut pide = Pedidos::default();
+    let imagen_lista = !app.jacnex_ia.ocupado() && hay_imagen(app);
+    let alto = ctx.content_rect().height();
+    egui::Window::new("IA de Jacnex")
+        .id(egui::Id::unique("jacnex-ia-ventana"))
+        .title_bar(false)
+        .resizable(false)
+        .default_width(ANCHO)
+        .show(ctx, |ui| {
+            ui.set_width(ANCHO);
+            let t = crate::theme::Tokens::get(ui.ctx());
+            let e = &mut app.jacnex_ia;
+            let sesion = e.con_sesion || e.local.is_some();
+            ui.horizontal(|ui| {
+                ui.add(imagen("sparkles", 16.0, ACENTO_CLARO));
+                ui.label(RichText::new("IA de Jacnex").strong().size(14.0).color(t.text));
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    if crate::widgets::icon_button(ui, "x", "Cerrar", false, 22.0).clicked() {
+                        pide.cerrar = true;
+                    }
+                    if sesion && crate::widgets::icon_button(ui, "rotate-cw", "Actualizar saldo", false, 22.0).clicked() {
+                        pedir_info(e);
+                    }
+                    if let Some(i) = &e.info {
+                        let r = pastilla(ui, &creditos(i.creditos));
+                        if !i.nombre.is_empty() {
+                            r.on_hover_text(format!("Cuenta: {}", i.nombre));
+                        }
+                    }
+                });
+            });
+            if !sesion {
+                ui.label(RichText::new("Inicia sesión en Jacnex Studio para usar la IA.").small().color(t.text_dim));
+            }
+            if let Some(err) = &e.info_error {
+                ui.label(RichText::new(err.as_str()).small().color(ROJO));
+            }
+            ui.add_space(4.0);
+            ui.separator();
+            egui::ScrollArea::vertical().max_height(alto * 0.6).auto_shrink([false, true]).show(ui, |ui| cuerpo(ui, e));
+            ui.separator();
+            ui.add_space(4.0);
+            pie(ui, e, imagen_lista, &mut pide);
+        });
+    if pide.cerrar {
+        app.jacnex_ia.abierta = false;
+    }
+    if pide.generar {
+        generar(app);
+    }
+    if pide.vectorizar {
+        vectorizar_seleccion(app);
+    }
+}
+
+fn cuerpo(ui: &mut egui::Ui, e: &mut Estado) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.add_space(6.0);
+    titulo(ui, "Qué quieres crear");
+    let nombres: Vec<String> = Estilo::TODOS.iter().map(|s| s.nombre().to_string()).collect();
+    let elegido = Estilo::TODOS.iter().position(|s| *s == e.estilo).unwrap_or(0);
+    if let Some(i) = segmentos(ui, &nombres, elegido)
+        && let Some(s) = Estilo::TODOS.get(i)
+    {
+        e.estilo = *s;
+    }
+    ui.label(RichText::new(e.estilo.explicacion()).small().color(t.text_dim));
+    ui.add_space(8.0);
+    titulo(ui, "Descríbelo");
+    ui.add(egui::TextEdit::multiline(&mut e.prompt).hint_text(e.estilo.pista()).desired_rows(3).desired_width(f32::INFINITY));
+    ui.horizontal_wrapped(|ui| {
+        ui.spacing_mut().item_spacing = egui::vec2(4.0, 4.0);
+        for idea in e.estilo.ideas() {
+            if ui.small_button(format!("+ {idea}")).clicked() {
+                e.prompt = (*idea).to_string();
+            }
+        }
+    });
+    ui.add_space(8.0);
+    titulo(ui, "Ajustes");
+    let modelos = e.modelos();
+    let actual = e.modelo_actual();
+    fila(ui, "Modelo", |ui| {
+        egui::ComboBox::from_id_salt("jacnex-ia-modelo").selected_text(actual.nombre.as_str()).width(ui.available_width()).show_ui(ui, |ui| {
+            for m in &modelos {
+                let costo = m.costo("1k").map(|c| format!(" · {}", creditos(c))).unwrap_or_default();
+                if ui.selectable_label(m.id == actual.id, format!("{}{costo}", m.nombre)).on_hover_text(m.descripcion.as_str()).clicked() {
+                    e.modelo = m.id.clone();
+                }
+            }
+        });
+    });
+    if !actual.descripcion.is_empty() {
+        ui.label(RichText::new(actual.descripcion.as_str()).small().color(t.text_dim));
+    }
+    fila(ui, "Proporción", |ui| {
+        let nombres: Vec<String> = Proporcion::TODAS.iter().map(|p| p.nombre()).collect();
+        let elegida = Proporcion::TODAS.iter().position(|p| *p == e.proporcion).unwrap_or(0);
+        if let Some(i) = segmentos(ui, &nombres, elegida)
+            && let Some(p) = Proporcion::TODAS.get(i)
+        {
+            e.proporcion = *p;
+        }
+    });
+    ui.add_space(6.0);
+    ui.label(
+        RichText::new("La IA dibuja tu idea en colores planos y Vectornex la convierte en trazados editables, agrupados por color.")
+            .small()
+            .color(t.text_dim),
+    );
+    ui.add_space(4.0);
+}
+
+fn pie(ui: &mut egui::Ui, e: &mut Estado, imagen_lista: bool, pide: &mut Pedidos) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let ancho = ui.available_width();
+    if let Some(tr) = &e.trabajo {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{}  {} s", tr.etapa, tr.inicio.elapsed().as_secs())).strong());
+        });
+        ui.label(RichText::new("Suele tardar 10–40 s. Puedes seguir trabajando.").small().color(t.text_dim));
+    } else if let Some(tz) = &e.trazo {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("Convirtiendo en vector…  {} s", tz.inicio.elapsed().as_secs())).strong());
+        });
+    } else {
+        let costo = e.costo();
+        if let Some(c) = costo {
+            ui.horizontal(|ui| {
+                ui.label(RichText::new(creditos(c)).small().strong().color(ACENTO_CLARO));
+                if let Some(i) = &e.info {
+                    ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                        if i.creditos >= c {
+                            ui.label(RichText::new(format!("Te quedan {}", miles(i.creditos - c))).small().color(t.text_dim));
+                        } else {
+                            ui.label(RichText::new(format!("Te faltan {}", miles(c - i.creditos))).small().color(ROJO));
+                        }
+                    });
+                }
+            });
+            ui.add_space(2.0);
+        }
+        let texto = match costo {
+            Some(c) => format!("Crear vector · {}", creditos(c)),
+            None => "Crear vector".to_string(),
+        };
+        let f = falta(e);
+        if boton_acento(ui, "sparkles", &texto, egui::vec2(ancho, 36.0), f.is_none()).clicked() {
+            pide.generar = true;
+        }
+        if let Some(f) = f {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    if let Some((ok, m)) = &e.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(6.0);
+    ui.horizontal(|ui| {
+        let b = egui::Button::new((imagen("image", 14.0, t.text), "Vectorizar la imagen seleccionada")).frame(false);
+        if ui.add_enabled(imagen_lista, b).on_hover_text("Sin IA ni créditos: convierte en vector una imagen colocada.").clicked() {
+            pide.vectorizar = true;
+        }
+    });
+    ui.add_space(2.0);
+}
