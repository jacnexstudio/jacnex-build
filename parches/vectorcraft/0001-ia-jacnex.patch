+const ACENTO: Color32 = Color32::from_rgb(124, 92, 255);
+const ACENTO_CLARO: Color32 = Color32::from_rgb(205, 191, 255);
+const ROJO: Color32 = Color32::from_rgb(230, 120, 90);
+const VERDE: Color32 = Color32::from_rgb(110, 200, 140);
+const ANCHO: f32 = 330.0;
+/// El ancho de las etiquetas de Ajustes.
+const ETIQUETA: f32 = 86.0;
+
+/// `1236` → `1 236`.
+fn miles(n: i64) -> String {
+    let s = n.unsigned_abs().to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i).is_multiple_of(3) {
+            out.push(' ');
+        }
+        out.push(c);
+    }
+    if n < 0 { format!("-{out}") } else { out }
+}
+
+fn creditos(c: i64) -> String {
+    if c == 1 { "1 crédito".into() } else { format!("{} créditos", miles(c)) }
+}
+
+fn imagen(icono: &str, tam: f32, tinte: Color32) -> egui::Image<'static> {
+    egui::Image::new(crate::icons::source(icono)).tint(tinte).fit_to_exact_size(egui::vec2(tam, tam))
+}
