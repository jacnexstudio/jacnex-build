+/// El botón principal, de color: ícono y texto centrados.
+fn boton_acento(ui: &mut egui::Ui, icono: &str, texto: &str, tam: egui::Vec2, activo: bool) -> egui::Response {
+    let b = egui::Button::new((egui::Atom::grow(), imagen(icono, 15.0, Color32::WHITE), RichText::new(texto).strong().color(Color32::WHITE), egui::Atom::grow()))
+        .fill(ACENTO)
+        .corner_radius(8.0)
+        .min_size(tam);
+    ui.add_enabled(activo, b)
+}
+
+/// El título de una sección, en versalitas tenues.
+fn titulo(ui: &mut egui::Ui, texto: &str) -> egui::Response {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.label(RichText::new(texto.to_uppercase()).size(10.5).strong().color(t.text_dim))
+}
+
+/// Los créditos de la cuenta, en una píldora.
+fn pastilla(ui: &mut egui::Ui, texto: &str) -> egui::Response {
+    let galley = ui.painter().layout_no_wrap(texto.to_string(), egui::FontId::proportional(12.0), ACENTO_CLARO);
+    let (rect, resp) = ui.allocate_exact_size(galley.size() + egui::vec2(18.0, 8.0), egui::Sense::hover());
+    let p = ui.painter();
+    p.rect_filled(rect, rect.height() / 2.0, ACENTO.gamma_multiply(0.22));
+    p.rect_stroke(rect, rect.height() / 2.0, egui::Stroke::new(1.0, ACENTO.gamma_multiply(0.55)), egui::StrokeKind::Inside);
+    p.galley(rect.center() - galley.size() / 2.0, galley, ACENTO_CLARO);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Label, true, texto));
+    resp
+}
+
+/// Opciones del mismo ancho, una elegida. Devuelve la que se pulsó.
+fn segmentos(ui: &mut egui::Ui, opciones: &[String], elegida: usize) -> Option<usize> {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let mut pulsada = None;
+    egui::Frame::NONE.fill(t.input).stroke(egui::Stroke::new(1.0, t.input_border)).corner_radius(7.0).inner_margin(2).show(ui, |ui| {
+        ui.spacing_mut().item_spacing.x = 2.0;
+        let n = opciones.len().max(1) as f32;
+        let w = ((ui.available_width() - 2.0 * (n - 1.0)) / n).max(20.0);
+        ui.horizontal(|ui| {
+            for (i, o) in opciones.iter().enumerate() {
+                let on = i == elegida;
+                let texto = RichText::new(o.as_str()).color(if on { Color32::WHITE } else { t.text_dim });
+                let fondo = if on { ACENTO.gamma_multiply(0.55) } else { Color32::TRANSPARENT };
+                let b = egui::Button::new(texto).fill(fondo).frame_when_inactive(on).min_size(egui::vec2(w, 22.0)).corner_radius(5.0);
+                if ui.add(b).clicked() {
+                    pulsada = Some(i);
+                }
+            }
+        });
+    });
+    pulsada
+}
+
+/// Una fila de Ajustes: etiqueta a la izquierda, control a la derecha.
+fn fila<R>(ui: &mut egui::Ui, etiqueta: &str, control: impl FnOnce(&mut egui::Ui) -> R) -> R {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.horizontal(|ui| {
+        ui.allocate_ui_with_layout(egui::vec2(ETIQUETA, 24.0), egui::Layout::left_to_right(egui::Align::Center), |ui| {
+            ui.set_min_width(ETIQUETA);
+            ui.label(RichText::new(etiqueta).color(t.text_dim));
+        });
+        control(ui)
+    })
+    .inner
+}
