+    /// Un /v1/jacnex falso: estado, generar, trabajo (listo a la segunda consulta) y el logo.
+    fn servidor_falso() -> (String, std::sync::Arc<std::sync::Mutex<Vec<String>>>) {
+        use std::io::{BufRead, BufReader, Read, Write};
+        let l = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let base = format!("http://127.0.0.1:{}", l.local_addr().unwrap().port());
+        let recibido = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let (r2, base2) = (recibido.clone(), base.clone());
+        std::thread::spawn(move || {
+            let mut consultas = 0;
+            for s in l.incoming() {
+                let Ok(mut s) = s else { continue };
+                let mut lector = BufReader::new(s.try_clone().unwrap());
+                let mut linea = String::new();
+                if lector.read_line(&mut linea).is_err() {
+                    continue;
+                }
+                let mut largo = 0usize;
+                loop {
+                    let mut h = String::new();
+                    if lector.read_line(&mut h).unwrap_or(0) == 0 || h.trim_end().is_empty() {
+                        break;
+                    }
+                    if let Some(v) = h.to_ascii_lowercase().strip_prefix("content-length:") {
+                        largo = v.trim().parse().unwrap();
+                    }
+                }
+                let mut cuerpo = vec![0; largo];
+                let _ = lector.read_exact(&mut cuerpo);
+                let ruta = linea.split_whitespace().nth(1).unwrap_or("").to_string();
+                let (tipo, datos) = if ruta == "/r/logo.png" {
+                    ("image/png", logo())
+                } else if ruta == "/v1/jacnex/estado" {
+                    let v = json!({"nombre": "Prueba", "creditos": 100, "modelos": [
+                        {"id": "nano-banana-2", "nombre": "Nano Banana 2", "proveedor": "Google", "tipo": "imagen", "aspectos": ["1:1", "4:3", "3:4", "16:9"], "creditos": {"1k": 12}}
+                    ]});
+                    ("application/json", v.to_string().into_bytes())
+                } else if ruta == "/v1/jacnex/generar" {
+                    r2.lock().unwrap().push(String::from_utf8_lossy(&cuerpo).into_owned());
+                    ("application/json", json!({"id": "t1", "creditos": 12, "saldo": 88}).to_string().into_bytes())
+                } else {
+                    consultas += 1;
+                    let v = if consultas < 2 { json!({"estado": "procesando"}) } else { json!({"estado": "listo", "resultados": [format!("{base2}/r/logo.png")]}) };
+                    ("application/json", v.to_string().into_bytes())
+                };
+                let _ = write!(s, "HTTP/1.1 200 OK\r\nContent-Type: {tipo}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", datos.len());
+                let _ = s.write_all(&datos);
+            }
+        });
+        (base, recibido)
+    }
+
+    #[test]
+    fn generating_places_the_image_and_vectorizes_it() {
+        let (base, recibido) = servidor_falso();
+        let mut app = app();
+        assert!(usar_servidor_local(&mut app, &base, "jk_prueba"));
+        alternar(&mut app);
+        app.jacnex_ia.prompt = "un círculo rojo y un cuadrado azul".into();
+        let ctx = egui::Context::default();
+        let inicio = Instant::now();
+        while app.jacnex_ia.info.is_none() {
+            assert!(inicio.elapsed() < Duration::from_secs(20), "el catálogo no llegó");
+            actualizar(&mut app, &ctx);
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        generar(&mut app);
+        assert!(ocupado(&app), "{:?}", app.jacnex_ia.aviso);
+        while ocupado(&app) {
+            assert!(inicio.elapsed() < Duration::from_secs(60), "el resultado no llegó");
+            actualizar(&mut app, &ctx);
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        let aviso = app.jacnex_ia.aviso.clone().unwrap();
+        assert!(aviso.0, "{aviso:?}");
+        assert_eq!(app.session.documents().len(), 1, "un documento nuevo para el diseño");
+        assert!(sin_imagenes(&app));
+        assert_eq!(rellenos(&app), (1, 1, 2));
+        let pedido = recibido.lock().unwrap().join("\n");
+        assert!(pedido.contains("nano-banana-2") && pedido.contains("flat vector logo") && pedido.contains("1024x1024"), "{pedido}");
+        // Tras cobrar muestra el saldo que dio el servidor y luego lo vuelve a pedir.
+        while app.jacnex_ia.info_rx.is_some() {
+            assert!(inicio.elapsed() < Duration::from_secs(60), "el saldo no llegó");
+            actualizar(&mut app, &ctx);
+            std::thread::sleep(Duration::from_millis(20));
+        }
+        assert_eq!(app.jacnex_ia.info.as_ref().map(|i| i.creditos), Some(100), "el saldo se vuelve a pedir");
+    }
+
+    #[test]
+    fn the_window_shows_the_steps() {
+        let mut app = app();
+        alternar(&mut app);
+        let texto = crate::tests_labels::painted_text(&mut app, |app, ui| ventana(app, ui.ctx()));
+        for t in ["IA DE JACNEX", "QUÉ QUIERES CREAR", "Logo", "Mascota", "Google Nano Banana 2", "Crear vector", "Vectorizar la imagen seleccionada"] {
+            assert!(texto.to_uppercase().contains(&t.to_uppercase()), "{t}: {texto}");
+        }
+    }
+}
