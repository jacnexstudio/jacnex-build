+    /// Un PNG `w`×`h` con `px(x, y)`.
+    fn png(w: u32, h: u32, px: impl Fn(u32, u32) -> [u8; 4]) -> Vec<u8> {
+        let img = image::RgbaImage::from_fn(w, h, |x, y| image::Rgba(px(x, y)));
+        let mut out = Vec::new();
+        img.write_to(&mut std::io::Cursor::new(&mut out), image::ImageFormat::Png).unwrap();
+        out
+    }
+
+    /// Un logo plano: un círculo rojo y un cuadrado azul sobre blanco.
+    fn logo() -> Vec<u8> {
+        png(200, 200, |x, y| {
+            let (dx, dy) = (x as i32 - 70, y as i32 - 100);
+            if dx * dx + dy * dy < 40 * 40 {
+                [220, 30, 40, 255]
+            } else if (120..170).contains(&x) && (75..125).contains(&y) {
+                [30, 60, 220, 255]
+            } else {
+                [255, 255, 255, 255]
+            }
+        })
+    }
+
+    /// Los colores de relleno de los trazados del documento activo: cuántos se parecen al rojo y al
+    /// azul del logo, y cuántos hay en total.
+    fn rellenos(app: &VectorcraftApp) -> (usize, usize, usize) {
+        let mut todos: Vec<[u8; 4]> = Vec::new();
+        app.session.active().unwrap().doc.walk(|n| {
+            if let vectorcraft_color::Paint::Solid { color, .. } = n.appearance.fill_paint() {
+                let c = color.to_rgba8(1.0);
+                if !todos.contains(&c) {
+                    todos.push(c);
+                }
+            }
+        });
+        let cerca = |a: [u8; 4], b: [u8; 3]| (0..3).all(|i| (i32::from(a[i]) - i32::from(b[i])).abs() < 24);
+        let rojos = todos.iter().filter(|c| cerca(**c, [220, 30, 40])).count();
+        let azules = todos.iter().filter(|c| cerca(**c, [30, 60, 220])).count();
+        (rojos, azules, todos.len())
+    }
+
+    fn sin_imagenes(app: &VectorcraftApp) -> bool {
+        let d = app.session.active().unwrap();
+        !format!("{:?}", d.doc).contains("Image(")
