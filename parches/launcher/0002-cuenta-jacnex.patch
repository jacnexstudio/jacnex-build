+/// A window restored far below its minimum size goes back to its normal size, centred. Windows
+/// can save the geometry of a minimized window (160×64), and the launcher then opened as a strip
+/// with the logo and the header's buttons only. Never while minimized, maximized or full screen;
+/// at most once a second, so a system that refuses the size isn't asked every frame.
+pub fn ventana_minima(ctx: &egui::Context, raw: &egui::RawInput) {
+    const MINIMO: egui::Vec2 = egui::vec2(720.0, 500.0);
+    const NORMAL: egui::Vec2 = egui::vec2(1120.0, 760.0);
+    let Some(vista) = raw.viewports.get(&egui::ViewportId::ROOT) else { return };
+    if vista.minimized == Some(true) || vista.maximized == Some(true) || vista.fullscreen == Some(true) {
+        return;
+    }
+    let Some(dentro) = vista.inner_rect else { return };
+    if dentro.width() >= MINIMO.x * 0.9 && dentro.height() >= MINIMO.y * 0.9 {
+        return;
+    }
+    let ahora = raw.time.unwrap_or_default();
+    let id = egui::Id::unique("jx-ventana-minima");
+    if ctx.data(|d| d.get_temp::<f64>(id)).is_some_and(|t| ahora - t < 1.0) {
+        return;
+    }
+    ctx.data_mut(|d| d.insert_temp(id, ahora));
+    let tamano = match vista.monitor_size {
+        Some(pantalla) => NORMAL.min(pantalla * 0.9).max(MINIMO.min(pantalla)),
+        None => NORMAL,
+    };
+    log::info!("the window was {:?}, below its minimum size; restoring it to {tamano:?}", dentro.size());
+    ctx.send_viewport_cmd_to(egui::ViewportId::ROOT, egui::ViewportCommand::InnerSize(tamano));
+    if let Some(pantalla) = vista.monitor_size {
+        let esquina = ((pantalla - tamano) * 0.5).max(egui::Vec2::ZERO);
+        ctx.send_viewport_cmd_to(egui::ViewportId::ROOT, egui::ViewportCommand::OuterPosition(esquina.to_pos2()));
+    }
+}
