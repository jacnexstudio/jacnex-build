+/// The keyboard on its way to egui (the shell's `raw_input_hook`, which also runs while the window
+/// is minimized). On the sign-in screen there are no shortcuts, so typing the email can only write
+/// text: "@" is AltGr+Q, Ctrl+Alt+Q or Alt+64 on Latin American keyboards, and Windows minimized
+/// the borderless window on it.
+/// - Keys pressed with Ctrl, Alt or the command key reach no shortcut. The text they type (the
+///   "@") still arrives, and so do copy, cut and paste, which are events of their own.
+/// - The window has no minimize button for the system while signing in (the header's own still
+///   works), and the patched winit then lets no shortcut, system menu or taskbar minimize it.
+/// - A window minimized anyway right after a key (in the same burst of input, or up to two seconds
+///   later) with no click in between comes straight back. On any text field too.
+pub fn teclado(ctx: &egui::Context, raw: &mut egui::RawInput, inicio_de_sesion: bool) {
+    const MARGEN: f64 = 2.0;
+    let id_boton = egui::Id::unique("jx-sin-boton-minimizar");
+    let id_tecla = egui::Id::unique("jx-ultima-tecla-en-campo");
+
+    if ctx.data(|d| d.get_temp::<bool>(id_boton)).unwrap_or(false) != inicio_de_sesion {
+        ctx.data_mut(|d| d.insert_temp(id_boton, inicio_de_sesion));
+        ctx.send_viewport_cmd_to(
+            egui::ViewportId::ROOT,
+            egui::ViewportCommand::EnableButtons { close: true, minimized: !inicio_de_sesion, maximize: true },
+        );
+    }
+
+    let ahora = raw.time.unwrap_or_default();
+    let minimizada = raw.viewports.get(&raw.viewport_id).and_then(|v| v.minimized) == Some(true);
+    let clic = raw.events.iter().any(|e| matches!(e, egui::Event::PointerButton { pressed: true, .. }));
+    let tecla = raw.events.iter().any(|e| matches!(e, egui::Event::Key { pressed: true, .. } | egui::Event::Text(_)));
+    let en_campo = ctx.memory(|m| m.focused()).is_some_and(|f| egui::TextEdit::load_state(ctx, f).is_some());
+    let vigila = inicio_de_sesion || en_campo;
+
+    if inicio_de_sesion {
+        raw.events.retain(|e| !matches!(e, egui::Event::Key { modifiers, .. } if modifiers.ctrl || modifiers.alt || modifiers.command || modifiers.mac_cmd));
+    }
+
+    if clic {
+        // The minimize button, or anything else clicked: a minimize after that is the user's.
+        ctx.data_mut(|d| d.remove::<f64>(id_tecla));
+        return;
+    }
+    if tecla && vigila && !minimizada {
+        ctx.data_mut(|d| d.insert_temp(id_tecla, ahora));
+        // A frame soon after, to catch a minimize those keys caused.
+        ctx.request_repaint_after(std::time::Duration::from_millis(200));
+    }
+    let reciente = ctx.data(|d| d.get_temp::<f64>(id_tecla)).is_some_and(|t| ahora - t < MARGEN);
+    if minimizada && ((tecla && vigila) || reciente) {
+        ctx.data_mut(|d| d.remove::<f64>(id_tecla));
+        log::info!("the window minimized while typing in a field; restoring it");
+        ctx.send_viewport_cmd_to(egui::ViewportId::ROOT, egui::ViewportCommand::Minimized(false));
+        ctx.send_viewport_cmd_to(egui::ViewportId::ROOT, egui::ViewportCommand::Focus);
+    }
+}
diff --git a/crates/ui-egui/src/jacnex/acceso.rs b/crates/ui-egui/src/jacnex/acceso.rs
new file mode 100644
index 0000000..ace5d16
--- /dev/null
+++ b/crates/ui-egui/src/jacnex/acceso.rs
@@ -0,0 +1,395 @@
+//! The Jacnex account (Forgenex's: the same credits and plan). Until someone signs in the window
+//! shows only the sign-in screen, with an email and password form and a button that signs in on
+//! the web; afterwards the header carries the account's menu. The desktop does the network calls
+//! and keeps the session (`Host::cuenta`); the web build has no account and never shows this.
+
+use std::time::Duration;
+
+use egui::{Align, Align2, Color32, CornerRadius, FontId, Layout, Margin, Rect, RichText, Sense, Stroke, StrokeKind, Ui, pos2, vec2};
+use jacnex_studio_core::cuenta::{Cuenta, EstadoCuenta, OrdenCuenta, Usuario, miles};
+
+use super::{
+    AZUL, AZUL_CLARO, AZUL_OSCURO, CARD_RADIUS, FORGENEX_URL, HEADER_H, PAGE_PAD, PLANES_URL, banda_en, botones_ventana, color_tarjeta, fondo_pagina,
+    icono_blanco, mezcla, pintar_banda,
+};
+use crate::app::{Dialog, LauncherUi, TitleBar};
+use crate::theme::{self, Tokens};
+use crate::widgets;
+
+const ANCHO_CAJA: f32 = 404.0;
+const RELLENO_CAJA: i8 = 30;
+const BOTON_H: f32 = 44.0;
+/// How often the credits and the plan are read again while the launcher is open.
+const REFRESCO_S: f64 = 180.0;
+/// After asking for the account, how long to keep redrawing so the answer shows up.
+const ESPERA_RESPUESTA_S: f64 = 20.0;
+
+const ID_CORREO: &str = "jx-cuenta-correo";
+const ID_CLAVE: &str = "jx-cuenta-clave";
+const ID_AVISO: &str = "jx-cuenta-aviso";
+const ID_ABIERTO: &str = "jx-cuenta-abierto";
+const ID_LEIDA: &str = "jx-cuenta-leida";
+const ID_FOCO: &str = "jx-cuenta-foco";
+
+fn id(nombre: &str) -> egui::Id {
+    egui::Id::unique(nombre)
+}
+
+impl LauncherUi {
+    /// The whole window while nobody is signed in: the header with the logo, the band, and the
+    /// sign-in card on it.
+    pub(super) fn jx_acceso(&mut self, ui: &mut Ui, cuenta: &mut dyn Cuenta, estado: &EstadoCuenta, bar: TitleBar) {
+        let t = Tokens::get(ui.ctx());
+        let ctx = ui.ctx().clone();
+        // The answers come from another thread: look again until there is a session.
+        ctx.request_repaint_after(Duration::from_millis(250));
+        egui::Panel::top("jx-cabecera")
+            .frame(egui::Frame::new().fill(AZUL))
+            .show_separator_line(false)
+            .exact_size(HEADER_H)
+            .resizable(false)
+            .show(ui, |ui| self.jx_cabecera_acceso(ui, bar));
+        egui::CentralPanel::default().frame(egui::Frame::new().fill(fondo_pagina(&t))).show(ui, |ui| {
+            let area = ui.max_rect();
+            let banda = banda_en(&ctx, area.top() - HEADER_H);
+            pintar_banda(ui.painter(), Rect::from_min_max(area.min, pos2(area.right(), banda.bottom())), banda);
+            egui::ScrollArea::vertical().id_salt("jx-acceso").auto_shrink([false, false]).show(ui, |ui| {
+                let ancho = ANCHO_CAJA.min(ui.available_width() - 32.0).max(280.0);
+                ui.add_space(34.0);
+                ui.vertical_centered(|ui| caja(ui, &t, ancho, cuenta, estado));
+                ui.add_space(32.0);
+            });
+        });
+    }
+
+    /// The header before signing in: the logo, settings and the window buttons.
+    fn jx_cabecera_acceso(&mut self, ui: &mut Ui, bar: TitleBar) {
+        let ctx = ui.ctx().clone();
+        let full = ui.max_rect();
+        pintar_banda(ui.painter(), full, banda_en(&ctx, full.top()));
+        if bar != TitleBar::Native {
+            widgets::title_bar_drag(ui);
+        }
+        ui.horizontal_centered(|ui| {
+            ui.spacing_mut().item_spacing.x = 6.0;
+            if bar == TitleBar::MacOs {
+                ui.add_space(72.0);
+            }
+            ui.add_space(PAGE_PAD - 6.0);
+            let alto = 24.0;
+            let (logo, _) = ui.allocate_exact_size(vec2(alto * crate::icons::JACNEX_LOGO_ASPECT, alto), Sense::hover());
+            egui::Image::new(crate::icons::jacnex_logo(true)).alt_text("Jacnex Studio").paint_at(ui, logo);
+            ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
+                if bar == TitleBar::Custom {
+                    botones_ventana(ui, HEADER_H);
+                    ui.add_space(4.0);
+                } else {
+                    ui.add_space(PAGE_PAD - 6.0);
+                }
+                if icono_blanco(ui, "⚙", "Configuración", false).clicked() {
+                    self.dialog = Some(Dialog::Settings);
+                }
+            });
+        });
+    }
+}
+
+/// The sign-in card.
+fn caja(ui: &mut Ui, t: &Tokens, ancho: f32, cuenta: &mut dyn Cuenta, estado: &EstadoCuenta) {
+    let sombra = egui::epaint::Shadow {
+        offset: [0, 14],
+        blur: 40,
+        spread: 0,
+        color: Color32::from_rgba_unmultiplied(5, 20, 70, if t.dark { 90 } else { 46 }),
+    };
+    egui::Frame::new()
+        .fill(color_tarjeta(t))
+        .corner_radius(CornerRadius::same(CARD_RADIUS))
+        .stroke(if t.dark { Stroke::new(1.0, t.line) } else { Stroke::NONE })
+        .shadow(sombra)
+        .inner_margin(Margin::same(RELLENO_CAJA))
+        .show(ui, |ui| {
+            let dentro = ancho - 2.0 * f32::from(RELLENO_CAJA);
+            ui.set_width(dentro);
+            ui.with_layout(Layout::top_down(Align::Min), |ui| {
+                ui.spacing_mut().item_spacing.y = 0.0;
+                match estado {
+                    EstadoCuenta::EsperandoNavegador { url, codigo } => esperando(ui, t, cuenta, url, codigo),
+                    EstadoCuenta::Entrando => formulario(ui, t, cuenta, None, true),
+                    EstadoCuenta::SinSesion { error } => formulario(ui, t, cuenta, error.as_deref(), false),
+                    // Drawn for one frame at most: the window switches to the launcher.
+                    EstadoCuenta::Conectada(_) => {
+                        ui.add(egui::Spinner::new().size(22.0).color(t.accent));
+                    }
+                }
+            });
+        });
+}
+
+fn titulo(ui: &mut Ui, t: &Tokens, texto: &str, detalle: &str) {
+    ui.label(RichText::new(texto).font(FontId::new(24.0, theme::display())).color(t.ink_strong));
+    ui.add_space(8.0);
+    ui.add(egui::Label::new(RichText::new(detalle).font(FontId::new(13.5, theme::medium())).color(t.muted)).wrap());
+    ui.add_space(22.0);
+}
+
+/// Email and password, or the browser.
+fn formulario(ui: &mut Ui, t: &Tokens, cuenta: &mut dyn Cuenta, error: Option<&str>, entrando: bool) {
+    let ctx = ui.ctx().clone();
+    let mut correo: String = ctx.data(|d| d.get_temp(id(ID_CORREO))).unwrap_or_default();
+    let mut clave: String = ctx.data(|d| d.get_temp(id(ID_CLAVE))).unwrap_or_default();
+    let mut aviso: Option<String> = ctx.data(|d| d.get_temp(id(ID_AVISO)));
+
+    titulo(ui, t, "Inicia sesión", "Entra con tu cuenta Jacnex: la misma de Forgenex, con tus créditos y tu plan.");
+
+    etiqueta(ui, t, "Correo");
+    let r_correo = campo(ui, t, id(ID_CORREO).with("campo"), &mut correo, false, "tu@correo.com", !entrando);
+    ui.add_space(14.0);
+    etiqueta(ui, t, "Contraseña");
+    let id_campo_clave = id(ID_CLAVE).with("campo");
+    let r_clave = campo(ui, t, id_campo_clave, &mut clave, true, "Tu contraseña", !entrando);
+    let enter = |r: &egui::Response| r.lost_focus() && ctx.input(|i| i.key_pressed(egui::Key::Enter));
+    let mut enviar = enter(&r_clave);
+    if enter(&r_correo) {
+        if clave.is_empty() {
+            ctx.memory_mut(|m| m.request_focus(id_campo_clave));
+        } else {
+            enviar = true;
+        }
+    }
+    if r_correo.changed() || r_clave.changed() {
+        aviso = None;
+    }
+
+    if let Some(texto) = aviso.as_deref().or(error) {
+        ui.add_space(12.0);
+        ui.add(egui::Label::new(RichText::new(texto).font(FontId::new(13.0, theme::semibold())).color(t.bad)).wrap());
+    }
+    ui.add_space(20.0);
+
+    if entrando {
+        let (rect, _) = ui.allocate_exact_size(vec2(ui.available_width(), BOTON_H), Sense::hover());
+        ui.painter().rect_filled(rect, CornerRadius::same(10), theme::tint(t.ink_strong, 0.06));
+        let fuente = FontId::new(14.0, theme::bold());
+        let ancho = ui.painter().layout_no_wrap("Entrando…".into(), fuente.clone(), t.ink).size().x;
+        let giro = Rect::from_center_size(pos2(rect.center().x - ancho / 2.0 - 8.0, rect.center().y), vec2(18.0, 18.0));
+        egui::Spinner::new().size(16.0).color(t.accent).paint_at(ui, giro);
+        ui.painter().text(pos2(rect.center().x + 12.0, rect.center().y), Align2::CENTER_CENTER, "Entrando…", fuente, t.ink);
+    } else if boton(ui, t, "Iniciar sesión", true).clicked() {
+        enviar = true;
+    }
+
+    if enviar && !entrando {
+        let limpio = correo.trim().to_string();
+        if limpio.is_empty() || !limpio.contains('@') {
+            aviso = Some("Escribe el correo de tu cuenta.".into());
+        } else if clave.is_empty() {
+            aviso = Some("Escribe tu contraseña.".into());
+        } else {
+            aviso = None;
+            // The password goes once to the account and is not kept.
+            cuenta.enviar(OrdenCuenta::Entrar { correo: limpio, clave: std::mem::take(&mut clave) });
+        }
+    }
+
+    ui.add_space(16.0);
+    separador_o(ui, t);
+    ui.add_space(16.0);
+    let navegador = ui.add_enabled_ui(!entrando, |ui| boton(ui, t, "Entrar con el navegador", false)).inner;
+    if navegador.on_hover_text("Se abre app.jacnex.store: inicia sesión allí y vuelves conectado").clicked() {
+        aviso = None;
+        cuenta.enviar(OrdenCuenta::ConNavegador { registro: false });
+    }
+    ui.add_space(20.0);
+    ui.horizontal_wrapped(|ui| {
+        ui.spacing_mut().item_spacing.x = 4.0;
+        ui.label(RichText::new("¿No tienes cuenta?").font(FontId::new(13.5, theme::medium())).color(t.muted));
+        if ui.add_enabled_ui(!entrando, |ui| enlace(ui, t, "Créala gratis")).inner.clicked() {
+            aviso = None;
+            cuenta.enviar(OrdenCuenta::ConNavegador { registro: true });
+        }
+    });
+
+    ctx.data_mut(|d| {
+        d.insert_temp(id(ID_CORREO), correo);
+        d.insert_temp(id(ID_CLAVE), clave);
+        if let Some(a) = aviso {
+            d.insert_temp(id(ID_AVISO), a);
+        } else {
+            d.remove::<String>(id(ID_AVISO));
+        }
+    });
+}
+
+/// Signing in on the web: the code to check there, and a way back.
+fn esperando(ui: &mut Ui, t: &Tokens, cuenta: &mut dyn Cuenta, url: &str, codigo: &str) {
+    let ctx = ui.ctx().clone();
+    // The browser opens once for each code.
+    let abierto: Option<String> = ctx.data(|d| d.get_temp(id(ID_ABIERTO)));
+    if abierto.as_deref() != Some(codigo) {
+        ctx.open_url(egui::OpenUrl::new_tab(url));
+        ctx.data_mut(|d| d.insert_temp(id(ID_ABIERTO), codigo.to_string()));
+    }
+
+    titulo(ui, t, "Sigue en tu navegador", "Abrimos app.jacnex.store en tu navegador. Inicia sesión allí y confirma que aparece este código:");
+
+    let (rect, _) = ui.allocate_exact_size(vec2(ui.available_width(), 72.0), Sense::hover());
+    ui.painter().rect(
+        rect,
+        CornerRadius::same(12),
+        theme::tint(t.accent, if t.dark { 0.16 } else { 0.07 }),
+        Stroke::new(1.0, theme::tint(t.accent, 0.35)),
+        StrokeKind::Inside,
+    );
+    let galley = widgets::caps(ui, codigo, 28.0, theme::mono_bold(), 4.0, t.ink_strong);
+    ui.painter().galley(rect.center() - galley.size() / 2.0, galley, t.ink_strong);
+    ui.add_space(16.0);
+
+    ui.horizontal(|ui| {
+        ui.spacing_mut().item_spacing.x = 10.0;
+        ui.add(egui::Spinner::new().size(16.0).color(t.accent));
+        ui.label(RichText::new("Esperando la confirmación…").font(FontId::new(13.5, theme::medium())).color(t.muted));
+    });
+    ui.add_space(22.0);
+    if boton(ui, t, "Abrir el navegador otra vez", false).clicked() {
+        ctx.open_url(egui::OpenUrl::new_tab(url));
+    }
+    ui.add_space(16.0);
+    ui.vertical_centered(|ui| {
+        if enlace(ui, t, "Cancelar").clicked() {
+            cuenta.enviar(OrdenCuenta::Cancelar);
+        }
+    });
+}
+
+fn etiqueta(ui: &mut Ui, t: &Tokens, texto: &str) {
+    ui.label(RichText::new(texto).font(FontId::new(12.5, theme::semibold())).color(t.ink));
+    ui.add_space(6.0);
+}
+
+fn campo(ui: &mut Ui, t: &Tokens, id: egui::Id, texto: &mut String, clave: bool, pista: &str, activo: bool) -> egui::Response {
+    let edit = egui::TextEdit::singleline(texto)
+        .id(id)
+        .password(clave)
+        .desired_width(f32::INFINITY)
+        .margin(Margin::symmetric(12, 11))
+        .char_limit(256)
+        .font(FontId::new(14.5, theme::medium()))
+        .text_color(t.ink_strong)
+        .hint_text(RichText::new(pista).color(t.faint));
+    ui.add_enabled(activo, edit)
+}
+
+/// A button as wide as the card: brand blue, or outlined.
+fn boton(ui: &mut Ui, t: &Tokens, texto: &str, primario: bool) -> egui::Response {
+    let sense = if ui.is_enabled() { Sense::click() } else { Sense::hover() };
+    let (rect, resp) = ui.allocate_exact_size(vec2(ui.available_width(), BOTON_H), sense);
+    let hover = ui.ctx().animate_bool_with_time(resp.id.with("hover"), resp.hovered() && ui.is_enabled(), 0.12);
+    let fuente = FontId::new(14.0, theme::bold());
+    let p = ui.painter();
+    let tinta = if primario {
+        p.rect_filled(rect, CornerRadius::same(10), mezcla(t.accent, AZUL_OSCURO, 0.35 * hover));
+        Color32::WHITE
+    } else {
+        p.rect(rect, CornerRadius::same(10), theme::tint(t.ink_strong, 0.05 * hover), Stroke::new(1.0, t.line_strong), StrokeKind::Inside);
+        t.ink_strong
+    };
+    let tinta = if ui.is_enabled() { tinta } else { tinta.gamma_multiply(0.5) };
+    p.text(rect.center(), Align2::CENTER_CENTER, texto, fuente, tinta);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, ui.is_enabled(), texto));
+    resp.on_hover_cursor(egui::CursorIcon::PointingHand)
+}
+
+fn enlace(ui: &mut Ui, t: &Tokens, texto: &str) -> egui::Response {
+    let resp = ui.add(egui::Label::new(RichText::new(texto).font(FontId::new(13.5, theme::bold())).color(t.accent_ink)).sense(Sense::click()));
+    resp.on_hover_cursor(egui::CursorIcon::PointingHand)
+}
+
+/// A hairline with an "o" in the middle.
+fn separador_o(ui: &mut Ui, t: &Tokens) {
+    let (rect, _) = ui.allocate_exact_size(vec2(ui.available_width(), 16.0), Sense::hover());
+    let p = ui.painter();
+    let c = rect.center();
+    let trazo = Stroke::new(1.0, t.line);
+    p.hline(rect.left()..=c.x - 18.0, c.y, trazo);
+    p.hline(c.x + 18.0..=rect.right(), c.y, trazo);
+    p.text(c, Align2::CENTER_CENTER, "o", FontId::new(13.0, theme::medium()), t.faint);
+}
+
+/// Reads the credits and the plan again every few minutes, and when the window comes back to the
+/// front (after buying a plan on the web, say).
+pub(super) fn refrescar(ctx: &egui::Context, cuenta: &mut dyn Cuenta) {
+    let (ahora, enfocada) = ctx.input(|i| (i.time, i.focused));
+    let ultima: Option<f64> = ctx.data(|d| d.get_temp(id(ID_LEIDA)));
+    let antes_enfocada: bool = ctx.data(|d| d.get_temp(id(ID_FOCO))).unwrap_or(enfocada);
+    let pedir = match ultima {
+        // The desktop already asked when it started.
+        None => false,
+        Some(u) => ahora - u >= REFRESCO_S || (enfocada && !antes_enfocada && ahora - u >= 15.0),
+    };
+    if pedir {
+        cuenta.enviar(OrdenCuenta::Actualizar);
+    }
+    let leida = if pedir || ultima.is_none() { ahora } else { ultima.unwrap_or(ahora) };
+    ctx.data_mut(|d| {
+        d.insert_temp(id(ID_LEIDA), leida);
+        d.insert_temp(id(ID_FOCO), enfocada);
+    });
+    if ahora - leida < ESPERA_RESPUESTA_S {
+        ctx.request_repaint_after(Duration::from_millis(500));
+    } else {
+        ctx.request_repaint_after(Duration::from_secs_f64(REFRESCO_S));
+    }
+}
+
+/// The account's round button in the header, and its menu.
+pub(super) fn boton_cuenta(ui: &mut Ui, u: &Usuario) -> Option<OrdenCuenta> {
+    let t = Tokens::get(ui.ctx());
+    let (rect, resp) = ui.allocate_exact_size(vec2(34.0, 34.0), Sense::click());
+    let hover = ui.ctx().animate_bool_with_time(resp.id.with("hover"), resp.hovered(), 0.12);
+    let p = ui.painter();
+    p.circle_filled(rect.center(), 16.0, mezcla(Color32::WHITE, AZUL_CLARO, 0.18 * hover));
+    p.text(rect.center(), Align2::CENTER_CENTER, u.inicial(), FontId::new(15.0, theme::bold()), AZUL);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, true, "Tu cuenta"));
+    let resp = resp.on_hover_cursor(egui::CursorIcon::PointingHand);
+    let mut orden = None;
+    egui::Popup::menu(&resp).align(egui::RectAlign::BOTTOM_END).gap(8.0).width(264.0).show(|ui| {
+        ui.spacing_mut().item_spacing.y = 4.0;
+        egui::Frame::new().inner_margin(Margin { left: 4, right: 4, top: 4, bottom: 4 }).show(ui, |ui| {
+            ui.add(egui::Label::new(RichText::new(&u.nombre).font(FontId::new(15.0, theme::semibold())).color(t.ink_strong)).truncate());
+            ui.add(egui::Label::new(RichText::new(&u.correo).font(FontId::new(12.5, theme::medium())).color(t.muted)).truncate());
+            ui.add_space(6.0);
+            let plan = u.plan.as_deref().map_or_else(|| "Plan gratis".to_string(), |p| format!("Plan {p}"));
+            ui.label(RichText::new(format!("{plan} · {}", creditos(u.creditos))).font(FontId::new(13.0, theme::semibold())).color(t.accent_ink));
+        });
+        ui.separator();
+        if ui.button("Abrir Forgenex").clicked() {
+            ui.ctx().open_url(egui::OpenUrl::new_tab(FORGENEX_URL));
+        }
+        if ui.button("Ver planes y créditos").clicked() {
+            ui.ctx().open_url(egui::OpenUrl::new_tab(PLANES_URL));
+        }
+        ui.separator();
+        if ui.button("Cerrar sesión").clicked() {
+            orden = Some(OrdenCuenta::Salir);
+        }
+    });
+    orden
+}
+
+/// `1,500 créditos`, `1 crédito`.
+pub(super) fn creditos(n: i64) -> String {
+    if n == 1 { "1 crédito".to_string() } else { format!("{} créditos", miles(n)) }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::creditos;
+
+    #[test]
+    fn creditos_en_singular_y_plural() {
+        assert_eq!(creditos(1), "1 crédito");
+        assert_eq!(creditos(0), "0 créditos");
+        assert_eq!(creditos(3200), "3,200 créditos");
+    }
+}
