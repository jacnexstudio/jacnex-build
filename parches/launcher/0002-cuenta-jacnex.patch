diff --git a/crates/native/src/jacnex_cuenta.rs b/crates/native/src/jacnex_cuenta.rs
new file mode 100644
index 0000000..3dc3123
--- /dev/null
+++ b/crates/native/src/jacnex_cuenta.rs
@@ -0,0 +1,472 @@
+//! La cuenta Jacnex en el escritorio (agregado por Jacnex): iniciar sesión en app.jacnex.store con
+//! correo y contraseña o por el navegador, guardar la sesión en el equipo y leer los créditos.
+//!
+//! La sesión es una llave de API de Forgenex con el nombre del equipo ("Jacnex Studio · PC"),
+//! guardada en `<datos del launcher>/cuenta.json`. Cerrar sesión la borra aquí y en el servidor;
+//! también se puede borrar desde la web (Conectar apps). Las llamadas a la red van en hilos: la
+//! interfaz nunca espera.
+
+use std::io::Read;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::mpsc::{Receiver, Sender, channel};
+use std::time::{Duration, Instant};
+
+use jacnex_studio_core::cuenta::{Cuenta, EstadoCuenta, OrdenCuenta, SERVIDOR, Usuario};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+
+use crate::paths::Paths;
+
+const USER_AGENT: &str = concat!("Jacnex-Launcher/", env!("CARGO_PKG_VERSION"));
+const MAX_RESPUESTA: u64 = 64 * 1024;
+const SIN_RED: &str = "No se pudo conectar con Jacnex. Revisa tu conexión a internet e inténtalo de nuevo.";
+const SESION_CERRADA: &str = "Tu sesión se cerró. Vuelve a iniciar sesión.";
+
+/// Lo que se guarda en el equipo.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+struct Sesion {
+    llave: String,
+    usuario: Usuario,
+}
+
+/// Lo que los hilos le cuentan a la cuenta.
+enum Resultado {
+    Conectada(Sesion),
+    Fallo(String),
+    Esperando { url: String, codigo: String },
+    Refrescada(Usuario),
+    Cerrada,
+}
+
+/// La cuenta del escritorio.
+pub struct ServicioCuenta {
+    estado: EstadoCuenta,
+    sesion: Option<Sesion>,
+    archivo: PathBuf,
+    base: String,
+    agente: ureq::Agent,
+    /// Sube con cada acción de la persona: lo que llega de una acción anterior se descarta y la
+    /// espera del navegador se detiene.
+    turno: Arc<AtomicU64>,
+    tx: Sender<(u64, Resultado)>,
+    rx: Receiver<(u64, Resultado)>,
+}
+
+impl ServicioCuenta {
+    pub fn nuevo(paths: &Paths) -> Self {
+        let archivo = paths.data.join("cuenta.json");
+        let sesion = leer_sesion(&archivo);
+        let (tx, rx) = channel();
+        let mut cuenta = Self {
+            estado: sesion.as_ref().map_or(EstadoCuenta::SinSesion { error: None }, |s| EstadoCuenta::Conectada(s.usuario.clone())),
+            sesion,
+            archivo,
+            base: base(),
+            agente: agente(),
+            turno: Arc::new(AtomicU64::new(0)),
+            tx,
+            rx,
+        };
+        // Con una sesión guardada se entra de una vez (también sin internet) y se revisa en segundo plano.
+        if cuenta.sesion.is_some() {
+            cuenta.enviar(OrdenCuenta::Actualizar);
+        }
+        cuenta
+    }
+
+    fn nuevo_turno(&self) -> u64 {
+        self.turno.fetch_add(1, Ordering::SeqCst).wrapping_add(1)
+    }
+
+    fn en_hilo(&mut self, trabajo: impl FnOnce(&Contexto) -> Option<Resultado> + Send + 'static) {
+        let turno = self.turno.load(Ordering::SeqCst);
+        let contexto = Contexto { base: self.base.clone(), agente: self.agente.clone(), turno, actual: Arc::clone(&self.turno) };
+        let tx = self.tx.clone();
+        let lanzado = std::thread::Builder::new().name("jacnex-cuenta".into()).spawn(move || {
+            if let Some(resultado) = trabajo(&contexto) {
+                let _ = tx.send((turno, resultado));
+            }
+        });
+        if let Err(e) = lanzado {
+            log::warn!("couldn't start the account thread ({e})");
+            if !matches!(self.estado, EstadoCuenta::Conectada(_)) {
+                self.estado = EstadoCuenta::SinSesion { error: Some(SIN_RED.into()) };
+            }
+        }
+    }
+
+    fn guardar(&mut self, sesion: Sesion) {
+        match serde_json::to_vec_pretty(&sesion) {
+            Ok(bytes) => {
+                if let Err(e) = crate::paths::write_atomic(&self.archivo, &bytes) {
+                    log::warn!("couldn't save the Jacnex session ({e})");
+                }
+            }
+            Err(e) => log::warn!("couldn't save the Jacnex session ({e})"),
+        }
+        self.estado = EstadoCuenta::Conectada(sesion.usuario.clone());
+        self.sesion = Some(sesion);
+    }
+
+    fn olvidar(&mut self, error: Option<String>) {
+        self.sesion = None;
+        if self.archivo.exists()
+            && let Err(e) = std::fs::remove_file(&self.archivo)
+        {
+            log::warn!("couldn't delete the Jacnex session ({e})");
+        }
+        self.estado = EstadoCuenta::SinSesion { error };
+    }
+
+    fn recibir(&mut self) {
+        while let Ok((turno, resultado)) = self.rx.try_recv() {
+            if turno != self.turno.load(Ordering::SeqCst) {
+                continue;
+            }
+            match resultado {
+                Resultado::Conectada(sesion) => self.guardar(sesion),
+                Resultado::Fallo(error) => self.estado = EstadoCuenta::SinSesion { error: Some(error) },
+                Resultado::Esperando { url, codigo } => self.estado = EstadoCuenta::EsperandoNavegador { url, codigo },
+                Resultado::Refrescada(usuario) => {
+                    if let Some(sesion) = self.sesion.clone() {
+                        self.guardar(Sesion { llave: sesion.llave, usuario });
+                    }
+                }
+                Resultado::Cerrada => {
+                    if self.sesion.is_some() {
+                        self.olvidar(Some(SESION_CERRADA.into()));
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl Cuenta for ServicioCuenta {
+    fn estado(&mut self) -> EstadoCuenta {
+        self.recibir();
+        self.estado.clone()
+    }
+
+    fn enviar(&mut self, orden: OrdenCuenta) {
+        self.recibir();
+        match orden {
+            OrdenCuenta::Entrar { correo, clave } => {
+                let correo = correo.trim().to_string();
+                if correo.is_empty() || clave.is_empty() {
+                    self.estado = EstadoCuenta::SinSesion { error: Some("Escribe tu correo y tu contraseña.".into()) };
+                    return;
+                }
+                self.nuevo_turno();
+                self.estado = EstadoCuenta::Entrando;
+                self.en_hilo(move |c| Some(entrar(c, &correo, &clave)));
+            }
+            OrdenCuenta::ConNavegador { registro } => {
+                self.nuevo_turno();
+                self.estado = EstadoCuenta::Entrando;
+                let tx = self.tx.clone();
+                self.en_hilo(move |c| Some(con_navegador(c, registro, &tx)));
+            }
+            OrdenCuenta::Cancelar => {
+                self.nuevo_turno();
+                if !matches!(self.estado, EstadoCuenta::Conectada(_)) {
+                    self.estado = EstadoCuenta::SinSesion { error: None };
+                }
+            }
+            OrdenCuenta::Actualizar => {
+                let Some(llave) = self.sesion.as_ref().map(|s| s.llave.clone()) else { return };
+                self.en_hilo(move |c| refrescar(c, &llave));
+            }
+            OrdenCuenta::Salir => {
+                self.nuevo_turno();
+                if let Some(llave) = self.sesion.as_ref().map(|s| s.llave.clone()) {
+                    // Sin esperar: la llave se olvida aquí aunque el servidor no conteste.
+                    self.en_hilo(move |c| {
+                        let _ = pedir(c, "/api/launcher/salir", Some(&llave), Some(json!({})));
+                        None
+                    });
+                }
+                self.olvidar(None);
+            }
+        }
+    }
+}
+
+/// Lo que un hilo necesita.
+struct Contexto {
+    base: String,
+    agente: ureq::Agent,
+    turno: u64,
+    actual: Arc<AtomicU64>,
+}
+
+impl Contexto {
+    fn vigente(&self) -> bool {
+        self.actual.load(Ordering::SeqCst) == self.turno
+    }
+}
+
+fn base() -> String {
+    // Solo en compilaciones de desarrollo, y solo hacia este mismo equipo: una versión publicada
+    // nunca manda la contraseña a otro servidor por una variable de entorno.
+    #[cfg(debug_assertions)]
+    if let Ok(url) = std::env::var("JACNEX_CUENTA_URL")
+        && crate::http::is_loopback(&url)
+    {
+        return url.trim_end_matches('/').to_string();
+    }
+    SERVIDOR.to_string()
+}
+
+fn agente() -> ureq::Agent {
+    let tls = ureq::tls::TlsConfig::builder().root_certs(ureq::tls::RootCerts::PlatformVerifier).build();
+    ureq::Agent::config_builder()
+        .tls_config(tls)
+        .proxy(crate::proxy::pick())
+        .timeout_connect(Some(Duration::from_secs(10)))
+        .timeout_global(Some(Duration::from_secs(20)))
+        .http_status_as_error(false)
+        .user_agent(USER_AGENT)
+        .build()
+        .new_agent()
+}
+
+fn leer_sesion(archivo: &std::path::Path) -> Option<Sesion> {
+    let texto = std::fs::read_to_string(archivo).ok()?;
+    let sesion: Sesion = serde_json::from_str(&texto).ok()?;
+    (sesion.llave.starts_with("jk_") && !sesion.usuario.correo.is_empty()).then_some(sesion)
+}
+
+/// El nombre del equipo, para que la persona reconozca la sesión en la web.
+fn equipo() -> String {
+    ["COMPUTERNAME", "HOSTNAME"]
+        .iter()
+        .find_map(|v| std::env::var(v).ok().map(|n| n.trim().to_string()).filter(|n| !n.is_empty()))
+        .unwrap_or_else(|| "PC".into())
+}
+
+/// Una llamada al servidor: `(estado HTTP, cuerpo JSON)`. POST cuando hay `cuerpo`.
+fn pedir(c: &Contexto, ruta: &str, llave: Option<&str>, cuerpo: Option<Value>) -> Result<(u16, Value), String> {
+    let url = format!("{}{ruta}", c.base);
+    let autorizacion = llave.map(|l| format!("Bearer {l}"));
+    let respuesta = match cuerpo {
+        Some(cuerpo) => {
+            let mut pedido = c.agente.post(&url).header("Content-Type", "application/json").header("Accept", "application/json");
+            if let Some(a) = &autorizacion {
+                pedido = pedido.header("Authorization", a);
+            }
+            pedido.send(cuerpo.to_string())
+        }
+        None => {
+            let mut pedido = c.agente.get(&url).header("Accept", "application/json");
+            if let Some(a) = &autorizacion {
+                pedido = pedido.header("Authorization", a);
+            }
+            pedido.call()
+        }
+    };
+    let mut respuesta = respuesta.map_err(|e| {
+        log::warn!("Jacnex account request failed ({e})");
+        SIN_RED.to_string()
+    })?;
+    let estado = respuesta.status().as_u16();
+    let mut texto = String::new();
+    respuesta.body_mut().with_config().reader().take(MAX_RESPUESTA).read_to_string(&mut texto).map_err(|_| SIN_RED.to_string())?;
+    Ok((estado, serde_json::from_str(&texto).unwrap_or(Value::Null)))
+}
+
+/// El mensaje de error del servidor, o uno general.
+fn error_de(estado: u16, cuerpo: &Value) -> String {
+    cuerpo
+        .get("error")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .filter(|e| !e.is_empty())
+        .map(|e| e.chars().take(300).collect())
+        .unwrap_or_else(|| format!("Algo salió mal (código {estado}). Inténtalo de nuevo en unos minutos."))
+}
+
+/// `{ llave, usuario }` de entrar y canjear.
+fn sesion_de(cuerpo: &Value) -> Option<Sesion> {
+    let llave = cuerpo.get("llave")?.as_str()?.to_string();
+    let usuario = Usuario::desde_json(cuerpo.get("usuario")?)?;
+    llave.starts_with("jk_").then_some(Sesion { llave, usuario })
+}
+
+fn entrar(c: &Contexto, correo: &str, clave: &str) -> Resultado {
+    let cuerpo = json!({ "correo": correo, "clave": clave, "equipo": equipo() });
+    match pedir(c, "/api/launcher/entrar", None, Some(cuerpo)) {
+        Ok((200, cuerpo)) => sesion_de(&cuerpo).map_or_else(|| Resultado::Fallo(error_de(200, &Value::Null)), Resultado::Conectada),
+        Ok((estado, cuerpo)) => Resultado::Fallo(error_de(estado, &cuerpo)),
+        Err(e) => Resultado::Fallo(e),
+    }
+}
+
+/// Pide un código, avisa la dirección para abrir y espera a que la persona lo apruebe en la web.
+fn con_navegador(c: &Contexto, registro: bool, tx: &Sender<(u64, Resultado)>) -> Resultado {
+    let respuesta = match pedir(c, "/api/launcher/codigo", None, Some(json!({ "equipo": equipo() }))) {
+        Ok((200, cuerpo)) => cuerpo,
+        Ok((estado, cuerpo)) => return Resultado::Fallo(error_de(estado, &cuerpo)),
+        Err(e) => return Resultado::Fallo(e),
+    };
+    let texto = |clave: &str| respuesta.get(clave).and_then(Value::as_str).map(str::to_string);
+    let (Some(codigo), Some(codigo_usuario), Some(mut url)) = (texto("codigo"), texto("codigoUsuario"), texto("url")) else {
+        return Resultado::Fallo(error_de(200, &Value::Null));
+    };
+    // Solo se abre una página del mismo servidor.
+    if !url.starts_with(&format!("{}/", c.base)) {
+        return Resultado::Fallo(error_de(200, &Value::Null));
+    }
+    if registro {
+        url.push_str("&nuevo=1");
+    }
+    let intervalo = Duration::from_secs(respuesta.get("intervalo").and_then(Value::as_u64).unwrap_or(3).clamp(2, 10));
+    let vence = Duration::from_secs(respuesta.get("venceEn").and_then(Value::as_u64).unwrap_or(600).clamp(60, 1800));
+    let _ = tx.send((c.turno, Resultado::Esperando { url, codigo: codigo_usuario }));
+    let fin = Instant::now() + vence;
+    while Instant::now() < fin {
+        let siguiente = Instant::now() + intervalo;
+        while Instant::now() < siguiente {
+            if !c.vigente() {
+                return Resultado::Fallo(String::new());
+            }
+            std::thread::sleep(Duration::from_millis(200));
+        }
+        match pedir(c, "/api/launcher/token", None, Some(json!({ "codigo": codigo }))) {
+            Ok((200, cuerpo)) => {
+                return sesion_de(&cuerpo).map_or_else(|| Resultado::Fallo(error_de(200, &Value::Null)), Resultado::Conectada);
+            }
+            Ok((410, _)) => break,
+            Ok((202, _)) | Err(_) => {}
+            Ok((estado, cuerpo)) => return Resultado::Fallo(error_de(estado, &cuerpo)),
+        }
+    }
+    Resultado::Fallo("El código venció antes de que lo confirmaras. Vuelve a intentarlo.".into())
+}
+
+fn refrescar(c: &Contexto, llave: &str) -> Option<Resultado> {
+    match pedir(c, "/api/launcher/yo", Some(llave), None) {
+        Ok((200, cuerpo)) => Usuario::desde_json(&cuerpo).map(Resultado::Refrescada),
+        Ok((401, _)) => Some(Resultado::Cerrada),
+        // Sin internet o el servidor con problemas: se sigue con lo guardado.
+        _ => None,
+    }
+}
