+    /// Waits until the state is no longer `de_paso` (or 20 seconds).
+    fn esperar(cuenta: &mut ServicioCuenta, de_paso: impl Fn(&EstadoCuenta) -> bool) -> EstadoCuenta {
+        let fin = std::time::Instant::now() + Duration::from_secs(20);
+        loop {
+            let e = cuenta.estado();
+            if !de_paso(&e) || std::time::Instant::now() > fin {
+                return e;
+            }
+            std::thread::sleep(Duration::from_millis(100));
+        }
+    }
