diff --git a/crates/core/src/cuenta.rs b/crates/core/src/cuenta.rs
new file mode 100644
index 0000000..44cfd6b
--- /dev/null
+++ b/crates/core/src/cuenta.rs
@@ -0,0 +1,121 @@
+//! La cuenta Jacnex del launcher (agregado por Jacnex): la misma cuenta, créditos y plan de
+//! Forgenex (app.jacnex.store). Aquí solo hay datos y lógica; el escritorio hace las llamadas a la
+//! red y guarda la sesión, y la interfaz pide iniciar sesión antes de mostrar el launcher.
+
+use serde::{Deserialize, Serialize};
+
+/// Donde vive la cuenta.
+pub const SERVIDOR: &str = "https://app.jacnex.store";
+
+/// Lo que el launcher muestra de la persona.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Usuario {
+    pub nombre: String,
+    pub correo: String,
+    pub creditos: i64,
+    /// El nombre del plan pagado (`Creador`), si tiene uno.
+    pub plan: Option<String>,
+}
+
+impl Usuario {
+    /// Lee la respuesta de `/api/launcher/yo` (o el campo `usuario` de entrar y canjear).
+    pub fn desde_json(v: &serde_json::Value) -> Option<Self> {
+        let correo = v.get("correo")?.as_str()?.trim().to_string();
+        if correo.is_empty() {
+            return None;
+        }
+        let nombre = v.get("nombre").and_then(|n| n.as_str()).map(str::trim).filter(|n| !n.is_empty()).unwrap_or(&correo).to_string();
+        let creditos = v.get("creditos").and_then(serde_json::Value::as_i64).unwrap_or(0);
+        let plan = v.get("plan").and_then(|p| p.get("nombre")).and_then(|n| n.as_str()).map(str::to_string);
+        Some(Self { nombre, correo, creditos, plan })
+    }
+
+    /// La inicial para el círculo de la cabecera.
+    pub fn inicial(&self) -> String {
+        self.nombre.chars().find(|c| c.is_alphanumeric()).map_or_else(|| "?".to_string(), |c| c.to_uppercase().collect())
+    }
+}
+
+/// `1500` → `1,500`, como en la web (es-PE).
+pub fn miles(n: i64) -> String {
+    let digitos = n.unsigned_abs().to_string();
+    let mut fuera = String::new();
+    for (i, c) in digitos.chars().enumerate() {
+        if i > 0 && (digitos.len() - i).is_multiple_of(3) {
+            fuera.push(',');
+        }
+        fuera.push(c);
+    }
+    if n < 0 { format!("-{fuera}") } else { fuera }
+}
+
+/// En qué punto está la sesión.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum EstadoCuenta {
+    /// Hay que iniciar sesión; `error` explica por qué falló el último intento.
+    SinSesion {
+        error: Option<String>,
+    },
+    /// Se mandó el correo y la contraseña; esperando la respuesta.
+    Entrando,
+    /// Se abrió el navegador: la persona inicia sesión allí y aprueba `codigo`.
+    EsperandoNavegador {
+        url: String,
+        codigo: String,
+    },
+    Conectada(Usuario),
+}
+
+/// Lo que la interfaz le pide a la cuenta.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum OrdenCuenta {
+    Entrar {
+        correo: String,
+        clave: String,
+    },
+    /// Entrar (o crear la cuenta, `registro`) en la web y volver conectado.
+    ConNavegador {
+        registro: bool,
+    },
+    /// Dejar de esperar al navegador.
+    Cancelar,
+    /// Volver a leer los créditos y el plan.
+    Actualizar,
+    Salir,
+}
+
+/// La cuenta, vista desde la interfaz. Nunca bloquea: las respuestas llegan en `estado`.
+pub trait Cuenta {
+    /// El estado de ahora (lee lo que haya llegado desde la última vez).
+    fn estado(&mut self) -> EstadoCuenta;
+    fn enviar(&mut self, orden: OrdenCuenta);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn lee_la_cuenta_de_forgenex() {
+        let v = serde_json::json!({"nombre": "Ana", "correo": "ana@x.pe", "creditos": 3200, "plan": {"id": "creador", "nombre": "Creador"}});
+        assert_eq!(
+            Usuario::desde_json(&v),
+            Some(Usuario { nombre: "Ana".into(), correo: "ana@x.pe".into(), creditos: 3200, plan: Some("Creador".into()) })
+        );
+        let sin_plan = serde_json::json!({"nombre": " ", "correo": "lu@x.pe", "creditos": 30, "plan": null});
+        let u = Usuario::desde_json(&sin_plan);
+        assert_eq!(u.as_ref().map(|u| (u.nombre.as_str(), u.plan.is_none())), Some(("lu@x.pe", true)));
+        assert_eq!(Usuario::desde_json(&serde_json::json!({"error": "x"})), None);
+    }
+
+    #[test]
+    fn numeros_e_iniciales() {
+        assert_eq!(miles(0), "0");
+        assert_eq!(miles(950), "950");
+        assert_eq!(miles(1500), "1,500");
+        assert_eq!(miles(17000), "17,000");
+        assert_eq!(miles(1234567), "1,234,567");
+        let u = Usuario { nombre: "ébano".into(), ..Usuario::default() };
+        assert_eq!(u.inicial(), "É");
+    }
+}
