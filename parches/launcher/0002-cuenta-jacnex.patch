+    #[test]
+    #[ignore = "needs a local Forgenex in JACNEX_CUENTA_URL"]
+    fn de_punta_a_punta() {
+        let url = std::env::var("JACNEX_CUENTA_URL").unwrap();
+        assert!(crate::http::is_loopback(&url), "only a local server");
+        let web = ureq::Agent::new_with_config(ureq::Agent::config_builder().http_status_as_error(false).build());
+        let correo = format!("e2e{}@prueba.pe", std::process::id());
+        let clave = "una-clave-larga";
+        let r = web
+            .post(&format!("{url}/api/cuenta/registro"))
+            .header("content-type", "application/json")
+            .send(json!({"nombre": "Prueba", "correo": correo, "clave": clave}).to_string())
+            .unwrap();
+        assert_eq!(r.status().as_u16(), 201);
+        let galleta = r.headers().get("set-cookie").and_then(|v| v.to_str().ok()).and_then(|v| v.split(';').next()).unwrap().to_string();
+
+        let carpeta = tempfile::tempdir().unwrap();
+        let paths = Paths::under(carpeta.path());
+        let mut cuenta = ServicioCuenta::nuevo(&paths);
+        cuenta.enviar(OrdenCuenta::Entrar { correo: correo.clone(), clave: "mal-escrita".into() });
+        assert!(matches!(esperar(&mut cuenta, |e| *e == EstadoCuenta::Entrando), EstadoCuenta::SinSesion { error: Some(_) }));
+        cuenta.enviar(OrdenCuenta::Entrar { correo: correo.clone(), clave: clave.into() });
+        let EstadoCuenta::Conectada(u) = esperar(&mut cuenta, |e| *e == EstadoCuenta::Entrando) else { panic!("no entró") };
+        assert_eq!((u.correo.as_str(), u.creditos > 0), (correo.as_str(), true));
+
+        // The session survives a restart and is refreshed from the server.
+        let mut otra = ServicioCuenta::nuevo(&paths);
+        assert!(matches!(otra.estado(), EstadoCuenta::Conectada(_)));
+        otra.enviar(OrdenCuenta::Salir);
+        assert_eq!(otra.estado(), EstadoCuenta::SinSesion { error: None });
+        assert_eq!(leer_sesion(&paths.data.join("cuenta.json")), None);
+        // The first copy still holds the revoked key: refreshing signs it out.
+        std::thread::sleep(Duration::from_millis(500));
+        cuenta.enviar(OrdenCuenta::Actualizar);
+        assert!(matches!(esperar(&mut cuenta, |e| matches!(e, EstadoCuenta::Conectada(_))), EstadoCuenta::SinSesion { error: Some(_) }));
+
+        // In the browser: the page approves the code with the web session.
+        cuenta.enviar(OrdenCuenta::ConNavegador { registro: false });
+        let EstadoCuenta::EsperandoNavegador { url: abrir, codigo } =
+            esperar(&mut cuenta, |e| matches!(e, EstadoCuenta::SinSesion { .. } | EstadoCuenta::Entrando))
+        else {
+            panic!("no pidió código: {:?}", cuenta.estado())
+        };
+        assert!(abrir.starts_with(&format!("{url}/conectar?c=")));
+        let r = web
+            .post(&format!("{url}/api/launcher/aprobar"))
+            .header("cookie", &galleta)
+            .header("content-type", "application/json")
+            .send(json!({"codigo": codigo}).to_string())
+            .unwrap();
+        assert_eq!(r.status().as_u16(), 200);
+        assert!(matches!(esperar(&mut cuenta, |e| matches!(e, EstadoCuenta::EsperandoNavegador { .. })), EstadoCuenta::Conectada(_)));
+
+        // Cancelling stops waiting.
+        cuenta.enviar(OrdenCuenta::Salir);
+        cuenta.enviar(OrdenCuenta::ConNavegador { registro: true });
+        let e = esperar(&mut cuenta, |e| matches!(e, EstadoCuenta::SinSesion { .. } | EstadoCuenta::Entrando));
+        assert!(matches!(&e, EstadoCuenta::EsperandoNavegador { url, .. } if url.ends_with("&nuevo=1")), "{e:?}");
+        cuenta.enviar(OrdenCuenta::Cancelar);
+        assert_eq!(cuenta.estado(), EstadoCuenta::SinSesion { error: None });
+    }
