diff --git a/crates/ui-egui/tests/jx_minimizar.rs b/crates/ui-egui/tests/jx_minimizar.rs
new file mode 100644
index 0000000..2637b5c
--- /dev/null
+++ b/crates/ui-egui/tests/jx_minimizar.rs
@@ -0,0 +1,111 @@
+//! Jacnex: the sign-in screen has no keyboard shortcuts, so typing the email ("@" is AltGr+Q,
+//! Ctrl+Alt+Q or Alt+64 on Latin American keyboards) only writes text and never minimizes the
+//! window; a window that minimizes anyway while typing comes back by itself.
+
+use egui::{Event, Key, Modifiers, RawInput, ViewportCommand, ViewportId};
+use jacnex_studio_ui_egui::teclado_jacnex;
+
+const ALT_GR: Modifiers = Modifiers { alt: true, ctrl: true, shift: false, mac_cmd: false, command: true };
+
+fn tecla(key: Key, modifiers: Modifiers) -> Event {
+    Event::Key { key, physical_key: None, pressed: true, repeat: false, modifiers }
+}
+
+fn entrada(t: f64, minimizada: bool, events: Vec<Event>) -> RawInput {
+    let mut raw = RawInput { time: Some(t), events, ..Default::default() };
+    raw.viewports.entry(ViewportId::ROOT).or_default().minimized = Some(minimizada);
+    raw
+}
+
+/// Runs the hook and then a frame, and returns what egui got and the window commands sent.
+fn paso(ctx: &egui::Context, mut raw: RawInput, inicio_de_sesion: bool) -> (Vec<Event>, Vec<ViewportCommand>) {
+    teclado_jacnex(ctx, &mut raw, inicio_de_sesion);
+    let eventos = raw.events.clone();
+    let mut salida = ctx.run_ui(raw, |ui| {
+        ui.label("Correo");
+    });
+    // No renderer here: the font texture is not uploaded anywhere.
+    salida.textures_delta.clear();
+    let pedidos = salida.viewport_output.values().flat_map(|v| v.commands.iter().cloned()).collect();
+    (eventos, pedidos)
+}
+
+const SIN_MINIMIZAR: ViewportCommand = ViewportCommand::EnableButtons { close: true, minimized: false, maximize: true };
+const CON_MINIMIZAR: ViewportCommand = ViewportCommand::EnableButtons { close: true, minimized: true, maximize: true };
+
+#[test]
+fn signing_in_has_no_shortcuts_but_the_at_sign_and_paste_arrive() {
+    let ctx = egui::Context::default();
+    let eventos = vec![
+        tecla(Key::Q, ALT_GR),
+        Event::Text("@".into()),
+        tecla(Key::Num6, Modifiers::ALT),
+        tecla(Key::Plus, Modifiers::COMMAND),
+        Event::Paste("hola@correo.com".into()),
+        tecla(Key::A, Modifiers::NONE),
+        tecla(Key::Tab, Modifiers::SHIFT),
+    ];
+    let (llegan, _) = paso(&ctx, entrada(1.0, false, eventos), true);
+    assert_eq!(
+        llegan,
+        vec![Event::Text("@".into()), Event::Paste("hola@correo.com".into()), tecla(Key::A, Modifiers::NONE), tecla(Key::Tab, Modifiers::SHIFT)]
+    );
+    // Once signed in, shortcuts work again.
+    let (llegan, _) = paso(&ctx, entrada(2.0, false, vec![tecla(Key::Plus, Modifiers::COMMAND)]), false);
+    assert_eq!(llegan, vec![tecla(Key::Plus, Modifiers::COMMAND)]);
+}
+
+#[test]
+fn the_system_minimize_button_is_off_only_while_signing_in() {
+    let ctx = egui::Context::default();
+    let (_, pedidos) = paso(&ctx, entrada(1.0, false, vec![]), true);
+    assert!(pedidos.contains(&SIN_MINIMIZAR), "{pedidos:?}");
+    // Sent once, not every frame.
+    let (_, pedidos) = paso(&ctx, entrada(1.1, false, vec![]), true);
+    assert!(!pedidos.contains(&SIN_MINIMIZAR), "{pedidos:?}");
+    let (_, pedidos) = paso(&ctx, entrada(1.2, false, vec![]), false);
+    assert!(pedidos.contains(&CON_MINIMIZAR), "{pedidos:?}");
+    // Never signing in, it is never touched.
+    let otro = egui::Context::default();
+    let (_, pedidos) = paso(&otro, entrada(1.0, false, vec![]), false);
+    assert!(!pedidos.iter().any(|p| matches!(p, ViewportCommand::EnableButtons { .. })), "{pedidos:?}");
+}
+
+#[test]
+fn a_minimize_in_the_same_burst_as_the_at_sign_is_undone() {
+    // Windows minimized the window before egui drew a frame with the key: the first input egui
+    // sees already says minimized.
+    let ctx = egui::Context::default();
+    paso(&ctx, entrada(1.0, false, vec![]), true);
+    let (_, pedidos) = paso(&ctx, entrada(1.1, true, vec![tecla(Key::Q, ALT_GR), Event::Text("@".into())]), true);
+    assert!(pedidos.contains(&ViewportCommand::Minimized(false)), "{pedidos:?}");
+    assert!(pedidos.contains(&ViewportCommand::Focus), "{pedidos:?}");
+}
+
+#[test]
+fn a_minimize_just_after_typing_is_undone() {
+    let ctx = egui::Context::default();
+    paso(&ctx, entrada(1.0, false, vec![Event::Text("@".into())]), true);
+    let (_, pedidos) = paso(&ctx, entrada(1.5, true, vec![]), true);
+    assert!(pedidos.contains(&ViewportCommand::Minimized(false)), "{pedidos:?}");
+}
+
+#[test]
+fn a_minimize_after_a_click_without_typing_or_much_later_stays() {
+    let clic = Event::PointerButton { pos: egui::pos2(10.0, 10.0), button: egui::PointerButton::Primary, pressed: true, modifiers: Modifiers::NONE };
+    // Never typed.
+    let ctx = egui::Context::default();
+    let (_, pedidos) = paso(&ctx, entrada(1.0, true, vec![]), true);
+    assert!(!pedidos.contains(&ViewportCommand::Minimized(false)), "{pedidos:?}");
+    // Typed, then clicked (the header's minimize button, say).
+    let ctx = egui::Context::default();
+    paso(&ctx, entrada(1.0, false, vec![Event::Text("a".into())]), true);
+    paso(&ctx, entrada(1.2, false, vec![clic]), true);
+    let (_, pedidos) = paso(&ctx, entrada(1.3, true, vec![]), true);
+    assert!(!pedidos.contains(&ViewportCommand::Minimized(false)), "{pedidos:?}");
+    // Typed long ago.
+    let ctx = egui::Context::default();
+    paso(&ctx, entrada(1.0, false, vec![Event::Text("a".into())]), true);
+    let (_, pedidos) = paso(&ctx, entrada(9.0, true, vec![]), true);
+    assert!(!pedidos.contains(&ViewportCommand::Minimized(false)), "{pedidos:?}");
+}
