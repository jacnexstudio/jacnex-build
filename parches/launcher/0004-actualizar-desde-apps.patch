diff --git a/crates/ui-egui/src/jacnex/pedido.rs b/crates/ui-egui/src/jacnex/pedido.rs
new file mode 100644
index 0000000..cf1463a
--- /dev/null
+++ b/crates/ui-egui/src/jacnex/pedido.rs
@@ -0,0 +1,66 @@
+//! An app asked to be updated from its own update notice: its "Update" button starts Jacnex
+//! Studio with `--actualizar <app>` and closes the app. The desktop shell follows the request
+//! (`apps/jacnex-studio/src/jacnex_pedido.rs`) with what is here: how the app stands, and the same
+//! install and open actions as the app's own buttons.
+
+use jacnex_studio_core::status::AppStatus;
+
+use crate::app::LauncherUi;
+
+/// How an app that asked to be updated stands in the launcher.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum JxActualizacion {
+    /// Not known yet: the catalog or the release check hasn't answered, or nobody is signed in
+    /// (installing needs an account; the window shows the sign-in screen).
+    Esperando,
+    /// A newer version is out. `ubicacion` is the installed copy, to see whether it is still open.
+    Pendiente { ubicacion: String },
+    /// Downloading or installing.
+    Instalando,
+    /// The installed copy is the latest.
+    AlDia,
+}
+
+impl LauncherUi {
+    /// How `id` stands, for an update the app asked for.
+    pub fn jx_actualizacion(&self, id: &str) -> JxActualizacion {
+        let Some(e) = self.entry(id) else { return JxActualizacion::Esperando };
+        if e.job.is_some() {
+            return JxActualizacion::Instalando;
+        }
+        if self.sin_sesion || self.checking {
+            return JxActualizacion::Esperando;
+        }
+        match (e.status(self.platform, self.caps.manage_apps), &e.installed) {
+            (AppStatus::UpdateAvailable, Some(copia)) => JxActualizacion::Pendiente { ubicacion: copia.location.clone() },
+            (estado, _) if estado.is_installed() => JxActualizacion::AlDia,
+            _ => JxActualizacion::Esperando,
+        }
+    }
+
+    /// Where `id`'s installed copy is, to see whether it is open.
+    pub fn jx_ubicacion(&self, id: &str) -> Option<String> {
+        self.entry(id)?.installed.as_ref().map(|copia| copia.location.clone())
+    }
+
+    /// Shows `id`'s page in the window, on Apps. `false` while the catalog doesn't have it yet.
+    pub fn jx_mostrar_app(&self, ctx: &egui::Context, id: &str) -> bool {
+        if self.entry(id).is_none() {
+            return false;
+        }
+        self.jx_elegir(ctx, id);
+        ctx.data_mut(|d| d.insert_temp(egui::Id::unique(super::EN_APPS), true));
+        true
+    }
+
+    /// Updates `id`, like its Update button.
+    pub fn jx_actualizar_app(&mut self, ctx: &egui::Context, id: &str) {
+        let _ = self.jx_mostrar_app(ctx, id);
+        self.install_app(id);
+    }
+
+    /// Opens `id`, like its Open button.
+    pub fn jx_abrir_app(&mut self, id: &str) {
+        self.launch_app(id);
+    }
+}
