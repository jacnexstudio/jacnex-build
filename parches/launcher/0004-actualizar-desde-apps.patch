@@ -0,0 +1,224 @@
+//! Jacnex: an app's update notice asks Jacnex Studio to update it. The app's "Update" button starts
+//! the launcher with `--actualizar <app>` and closes itself; the launcher waits for the app to be
+//! closed, updates it like its own Update button, and opens it again.
+//!
+//! The request is handed over in a small file in the launcher's data folder, so it reaches the
+//! launcher that is already running too: a second start only tells the first one to show itself
+//! (`single_instance`), and the first one picks the file up then.
+
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU8, Ordering};
+use std::time::{Duration, Instant};
+
+use jacnex_studio_ui_egui::{JxActualizacion, LauncherUi};
+
+/// The flag an app's update notice starts the launcher with, followed by the app's id.
+pub const BANDERA: &str = "--actualizar";
+const ARCHIVO: &str = "actualizar-app.txt";
+
+/// How long a request is followed before the launcher gives up on it (an app that never closes,
+/// a release check that never answers, nobody signing in).
+const PLAZO: Duration = Duration::from_secs(15 * 60);
+/// How long an app the launcher already has as up to date waits for a fresh release check.
+const PLAZO_AL_DIA: Duration = Duration::from_secs(60);
+/// An update the launcher started but that is still pending this long after its last sign of work
+/// went wrong; the launcher's own error says why.
+const PLAZO_TRABAJO: Duration = Duration::from_secs(20);
+/// How often the launcher looks whether the app is still open.
+const CADA: Duration = Duration::from_millis(1500);
+
+const SIN_MIRAR: u8 = 0;
+const MIRANDO: u8 = 1;
+const ABIERTA: u8 = 2;
+const CERRADA: u8 = 3;
+
+/// An app id as the catalog has them: lower-case letters, digits and dashes. Anything else on the
+/// command line is ignored.
+pub fn id_valido(id: &str) -> bool {
+    !id.is_empty() && id.len() <= 40 && id.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+}
+
+/// The app `args` ask to update, if any.
+pub fn pedido_de(args: &[String]) -> Option<String> {
+    let at = args.iter().position(|a| a == BANDERA)?;
+    let id = args.get(at + 1)?;
+    id_valido(id).then(|| id.clone())
+}
+
+fn archivo() -> Option<PathBuf> {
+    jacnex_studio_native::paths::Paths::new().ok().map(|p| p.data.join(ARCHIVO))
+}
+
+/// Leaves the request for the launcher that will run (this one, or the one already running).
+pub fn dejar(id: &str) {
+    let Some(path) = archivo() else { return };
+    if let Err(e) = jacnex_studio_native::paths::write_atomic(&path, id.as_bytes()) {
+        log::warn!("couldn't hand over the update request for {id}: {e}");
+    }
+}
+
+/// Takes the request left by `dejar`, if there is one.
+pub fn tomar() -> Option<String> {
+    tomar_de(&archivo()?)
+}
+
+fn tomar_de(path: &Path) -> Option<String> {
+    // A request is a few bytes; anything bigger isn't one.
+    let pequeno = std::fs::metadata(path).ok()?.len() <= 64;
+    let leido = if pequeno { std::fs::read_to_string(path).ok() } else { None };
+    if let Err(e) = std::fs::remove_file(path) {
+        log::warn!("couldn't remove {}: {e}", path.display());
+    }
+    let id = leido?.trim().to_string();
+    id_valido(&id).then_some(id)
+}
+
+/// An update an app asked for, followed tick by tick.
+pub struct Pedido {
+    id: String,
+    desde: Instant,
+    /// The last release check when the request came in: a different one is a fresh answer.
+    busqueda_previa: Option<i64>,
+    /// When the update last showed any sign of work: asked for, downloading or installing.
+    trabajo: Option<Instant>,
+    /// Whether the app is still open, as the last look found (`SIN_MIRAR` … `CERRADA`).
+    abierta: Arc<AtomicU8>,
+    ultima_mirada: Option<Instant>,
+    /// The app's page is on screen.
+    mostrada: bool,
+}
+
+impl Pedido {
+    pub fn nuevo(id: String, ui: &mut LauncherUi, ctx: &egui::Context) -> Self {
+        log::info!("{id} asked to be updated from its update notice");
+        ui.check_now();
+        let mostrada = ui.jx_mostrar_app(ctx, &id);
+        Self {
+            id,
+            desde: Instant::now(),
+            busqueda_previa: ui.settings.last_check,
+            trabajo: None,
+            abierta: Arc::new(AtomicU8::new(SIN_MIRAR)),
+            ultima_mirada: None,
+            mostrada,
+        }
+    }
+
+    /// One step. `false` once the request is done with.
+    pub fn seguir(&mut self, ui: &mut LauncherUi, ctx: &egui::Context) -> bool {
+        let ahora = Instant::now();
+        if ahora.duration_since(self.desde) > PLAZO {
+            log::warn!("gave up updating {} as its update notice asked", self.id);
+            return false;
+        }
+        // Looks again soon, with or without a window.
+        ctx.request_repaint_after(Duration::from_millis(500));
+        if !self.mostrada {
+            self.mostrada = ui.jx_mostrar_app(ctx, &self.id);
+        }
+        match ui.jx_actualizacion(&self.id) {
+            JxActualizacion::Esperando => true,
+            JxActualizacion::Instalando => {
+                self.trabajo = Some(ahora);
+                true
+            }
+            JxActualizacion::Pendiente { ubicacion } => {
+                if let Some(t) = self.trabajo {
+                    if ahora.duration_since(t) > PLAZO_TRABAJO {
+                        log::warn!("the update {} asked for didn't go through", self.id);
+                        return false;
+                    }
+                    return true;
+                }
+                if self.cerrada(&ubicacion, ctx) {
+                    ui.jx_actualizar_app(ctx, &self.id);
+                    self.trabajo = Some(ahora);
+                }
+                true
+            }
+            JxActualizacion::AlDia => {
+                if self.trabajo.is_some() {
+                    log::info!("{} updated as its update notice asked; opening it again", self.id);
+                    ui.jx_abrir_app(&self.id);
+                    return false;
+                }
+                let fresca = ui.settings.last_check != self.busqueda_previa;
+                if !fresca && ahora.duration_since(self.desde) < PLAZO_AL_DIA {
+                    return true;
+                }
+                // Already the latest: the app closed for nothing, so it opens again once it is shut.
+                let Some(ubicacion) = ui.jx_ubicacion(&self.id) else { return false };
+                if self.cerrada(&ubicacion, ctx) {
+                    log::info!("{} is already up to date; opening it again", self.id);
+                    ui.jx_abrir_app(&self.id);
+                    return false;
+                }
+                true
+            }
+        }
+    }
+
+    /// Whether the app at `ubicacion` was found closed. Looking takes a moment (a process list),
+    /// so it happens off the UI thread and the answer comes on a later tick.
+    fn cerrada(&mut self, ubicacion: &str, ctx: &egui::Context) -> bool {
+        let estado = self.abierta.load(Ordering::Acquire);
+        if estado == CERRADA {
+            return true;
+        }
+        let toca = self.ultima_mirada.is_none_or(|t| t.elapsed() >= CADA);
+        if estado != MIRANDO && toca {
+            self.ultima_mirada = Some(Instant::now());
+            self.abierta.store(MIRANDO, Ordering::Release);
+            let (abierta, ubicacion, ctx) = (self.abierta.clone(), PathBuf::from(ubicacion), ctx.clone());
+            let mirar = move || {
+                let corre = jacnex_studio_native::process::is_running(&ubicacion);
+                abierta.store(if corre { ABIERTA } else { CERRADA }, Ordering::Release);
+                ctx.request_repaint();
+            };
+            if let Err(e) = std::thread::Builder::new().name("jacnex-pedido".into()).spawn(mirar) {
+                log::warn!("couldn't look whether the app is open: {e}");
+                self.abierta.store(SIN_MIRAR, Ordering::Release);
+            }
+        }
+        false
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn solo_ids_de_catalogo() {
+        assert!(id_valido("filmcraft"));
+        assert!(id_valido("ia-film2"));
+        assert!(!id_valido(""));
+        assert!(!id_valido("Filmcraft"));
+        assert!(!id_valido("../x"));
+        assert!(!id_valido("film craft"));
+        assert!(!id_valido(&"a".repeat(41)));
+    }
+
+    #[test]
+    fn lee_la_bandera() {
+        let args = |v: &[&str]| v.iter().map(|s| s.to_string()).collect::<Vec<_>>();
+        assert_eq!(pedido_de(&args(&["--actualizar", "filmcraft"])), Some("filmcraft".into()));
+        assert_eq!(pedido_de(&args(&["--hidden", "--actualizar", "photocraft"])), Some("photocraft".into()));
+        assert_eq!(pedido_de(&args(&["--actualizar"])), None);
+        assert_eq!(pedido_de(&args(&["--actualizar", "C:\\x.exe"])), None);
+        assert_eq!(pedido_de(&args(&[])), None);
+    }
+
+    #[test]
+    fn el_archivo_se_toma_una_vez() {
+        let path = std::env::temp_dir().join(format!("jacnex-pedido-prueba-{}.txt", std::process::id()));
+        assert!(std::fs::write(&path, "filmcraft\n").is_ok());
+        assert_eq!(tomar_de(&path), Some("filmcraft".into()));
+        assert!(!path.exists());
+        assert_eq!(tomar_de(&path), None);
+        assert!(std::fs::write(&path, "no válido").is_ok());
+        assert_eq!(tomar_de(&path), None);
+        assert!(!path.exists());
+    }
+}
