+//! Jacnex: los modelos de IA que se bajan junto con una app (hoy, los de Filmnex: voz, vertical y
+//! búsqueda), para que la app nunca pida una descarga.
+//!
+//! Solo datos: de dónde se baja cada archivo, su SHA-256 y su tamaño. La descarga está en el
+//! backend (`jacnex_modelos` de `jacnex-studio-native`) y la tarjeta de la app suma [`total`].
+//! Cada modelo queda en `<datos de Jacnex Studio>/modelos/<carpeta>/`, que es donde la app lo
+//! busca.
+
+/// Un archivo de un modelo.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Archivo {
+    /// La ruta dentro de la carpeta del modelo (y al final de la URL); `/` separa subcarpetas.
+    pub nombre: &'static str,
+    pub sha256: &'static str,
+    pub tamano: u64,
+}
+
+/// Un modelo: una carpeta con sus archivos.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Modelo {
+    /// La carpeta (el id que usa la app para encontrarlo).
+    pub carpeta: &'static str,
+    /// La URL a la que se suma el nombre de cada archivo (una versión fija, nunca «main»).
+    pub base: &'static str,
+    pub licencia: &'static str,
+    pub archivos: &'static [Archivo],
+}
+
+impl Modelo {
+    pub fn url(&self, a: &Archivo) -> String {
+        format!("{}/{}", self.base.trim_end_matches('/'), a.nombre)
+    }
+
+    pub fn tamano(&self) -> u64 {
+        self.archivos.iter().map(|a| a.tamano).fold(0, u64::saturating_add)
+    }
+}
+
+/// Filmnex: la voz (transcripción, subtítulos, silencios, muletillas).
+const WHISPER: Modelo = Modelo {
+    carpeta: "whisper-large-v3-turbo",
+    base: "https://huggingface.co/openai/whisper-large-v3-turbo/resolve/41f01f3fe87f28c78e2fbf8b568835947dd65ed9",
+    licencia: "MIT",
+    archivos: &[
+        Archivo { nombre: "config.json", sha256: "c5b526b3e3cd64cd8940dabb45e8ba726629e22d8ed389c29b552f9140daf04a", tamano: 1256 },
+        Archivo { nombre: "generation_config.json", sha256: "cce11bfe3aaa6ae9e072ea2637caaec8795e68d9b67e655a5af16ee509681a4c", tamano: 3772 },
+        Archivo { nombre: "tokenizer.json", sha256: "297b13372ac43916285644fb9687add3cc62ee2a1adb60da3dc25cc94c1871fd", tamano: 2_710_337 },
+        Archivo { nombre: "model.safetensors", sha256: "542566a422ae4f3fd23f1ba11add198fca01bbf82e66e6a2857b3f608b1eb9d1", tamano: 1_617_824_864 },
+    ],
+};
+
+/// Filmnex, «Vertical»: caras (YuNet, convertido por Jacnex a safetensors; se sirve desde
+/// descargas.jacnex.store con su licencia).
+const YUNET: Modelo = Modelo {
+    carpeta: "reframe-yunet-2023mar",
+    base: "https://descargas.jacnex.store/modelos/reframe-yunet-2023mar/1",
+    licencia: "MIT",
+    archivos: &[
+        Archivo { nombre: "LICENSE", sha256: "c83b8120c50ccbd4c4f96edf53141bdd566ebb8f8e9227e415326aa1b1aba958", tamano: 1085 },
+        Archivo { nombre: "model.safetensors", sha256: "4bcc9e0c781c96f5b4d778bdb1914dce400373bffc11032cb6e0674939c1555f", tamano: 220_720 },
+    ],
+};
+
+/// Filmnex, «Vertical»: personas cuando no se ve una cara (RT-DETRv2 r18vd, tal cual).
+const RTDETR: Modelo = Modelo {
+    carpeta: "reframe-rtdetrv2-r18vd",
+    base: "https://huggingface.co/PekingU/rtdetr_v2_r18vd/resolve/5650961749fa93567c0d46fc7f43ea4f9e914107",
+    licencia: "Apache-2.0",
+    archivos: &[
+        Archivo { nombre: "config.json", sha256: "ed051ec77cb41c5d9d5e3af21a979b1e890599dfd68434d7636ff82ded4c1527", tamano: 5437 },
+        Archivo { nombre: "model.safetensors", sha256: "d18309d0d7ea57048138885c4c6ecfcb1e24506fc6153b94ad484f8ab62c7115", tamano: 80_904_640 },
+    ],
+};
+
+/// Filmnex, «Vertical»: quién habla (Light-ASD, convertido por Jacnex a safetensors; se sirve desde
+/// descargas.jacnex.store con su licencia).
+const LIGHTASD: Modelo = Modelo {
+    carpeta: "reframe-lightasd-ava",
+    base: "https://descargas.jacnex.store/modelos/reframe-lightasd-ava/1",
+    licencia: "MIT",
+    archivos: &[
+        Archivo { nombre: "LICENSE", sha256: "3c5b187c06d6c0fdcfe02ad73f51470eaa35045cc2e60749d805332d98441eb1", tamano: 1068 },
+        Archivo { nombre: "model.safetensors", sha256: "412c4a668b48100b31f953d7750595a7979c0a0a9a5b1590a90a7cc2f9ef0bc6", tamano: 4_082_848 },
+    ],
+};
+
+/// Filmnex, «Doblaje»: separa la voz de la música (Kim Vocal 2, Mel-Band RoFormer), convertido a safetensors.
+const SEPARAR: Modelo = Modelo {
+    carpeta: "separar-kim-vocal-2",
+    base: "https://descargas.jacnex.store/modelos/separar-kim-vocal-2/1",
+    licencia: "MIT",
+    archivos: &[
+        Archivo { nombre: "LICENSE", sha256: "a1b687a39a37fa357c329644365359c953ac6fe57761287476bb431aedd2af79", tamano: 1593 },
+        Archivo { nombre: "config.json", sha256: "c6c5d00b65c6d7100fb29b0704226904af7a1cd8788c14ea256a354af3dc7032", tamano: 513 },
+        Archivo { nombre: "model.safetensors", sha256: "ec0194fc63229e15794b33a0e22d4591cce72d2b3d04d8c764d1a61010b9ec39", tamano: 457_260_680 },
+    ],
+};
+
+/// Filmnex, «Buscar»: el sentido de lo que se dice (Qwen3-Embedding-0.6B).
+const QWEN: Modelo = Modelo {
+    carpeta: "qwen3-embedding-0.6b",
+    base: "https://huggingface.co/Qwen/Qwen3-Embedding-0.6B/resolve/97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3",
+    licencia: "Apache-2.0",
+    archivos: &[
+        Archivo { nombre: "config.json", sha256: "b5bf1f51fc45be473a54718cef92448d90a1be001bf9b9a44b8c7f10a19feaa9", tamano: 727 },
+        Archivo { nombre: "tokenizer.json", sha256: "def76fb086971c7867b829c23a26261e38d9d74e02139253b38aeb9df8b4b50a", tamano: 11_423_705 },
+        Archivo { nombre: "model.safetensors", sha256: "0437e45c94563b09e13cb7a64478fc406947a93cb34a7e05870fc8dcd48e23fd", tamano: 1_191_586_416 },
+    ],
+};
+
+/// Filmnex, «Buscar»: lo que se ve (SigLIP 2 base).
+const SIGLIP: Modelo = Modelo {
+    carpeta: "siglip2-base-patch16-256",
+    base: "https://huggingface.co/google/siglip2-base-patch16-256/resolve/3f9f96cb90da5dbc758b01813f2f6f1aee24c1ab",
+    licencia: "Apache-2.0",
+    archivos: &[
+        Archivo { nombre: "config.json", sha256: "7b5aedcb8893e31376e129c1ffd7a5392f1a806dbc793ce53eda220c2ec59edf", tamano: 276 },
+        Archivo { nombre: "tokenizer.json", sha256: "cb9140fae3ac5122c972d37adf83e1248471a38147ad76f8215c8872c6fd8322", tamano: 34_363_039 },
+        Archivo { nombre: "model.safetensors", sha256: "6125cacc01fa93bdc98a0c5101cefcd69b2ed1f8ab4f38d86f4ad5984f5dc863", tamano: 1_500_985_224 },
+    ],
+};
+
+const FILMNEX: &[Modelo] = &[WHISPER, YUNET, RTDETR, LIGHTASD, SEPARAR, QWEN, SIGLIP];
+
+/// Los modelos que se bajan con la app `app_id`.
+pub fn de(app_id: &str) -> &'static [Modelo] {
+    match app_id {
+        "filmcraft" => FILMNEX,
+        _ => &[],
+    }
+}
+
+/// Lo que pesan todos los modelos de `app_id`.
+pub fn total(app_id: &str) -> u64 {
+    de(app_id).iter().map(Modelo::tamano).fold(0, u64::saturating_add)
+}
+
+/// Un nombre seguro: partes no vacías, sin `.`/`..`, sin `\`, `:` ni rutas absolutas.
+pub fn nombre_valido(nombre: &str) -> bool {
+    !nombre.is_empty()
+        && nombre.len() <= 200
+        && !nombre.contains(['\\', ':'])
+        && nombre.split('/').all(|p| !p.is_empty() && p != "." && p != ".." && p.chars().all(|c| c.is_ascii_alphanumeric() || "._-".contains(c)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn every_model_is_pinned_checked_and_safe() {
+        let mut carpetas = Vec::new();
+        for m in FILMNEX {
+            assert!(m.base.starts_with("https://"), "{}", m.carpeta);
+            assert!(!m.base.contains("/main") && !m.base.contains("/master"), "{} must be pinned", m.carpeta);
+            assert!(nombre_valido(m.carpeta) && !m.carpeta.contains('/'), "{}", m.carpeta);
+            assert!(!carpetas.contains(&m.carpeta), "{} twice", m.carpeta);
+            carpetas.push(m.carpeta);
+            assert!(!m.licencia.is_empty());
+            assert!(!m.archivos.is_empty());
+            for a in m.archivos {
+                assert!(nombre_valido(a.nombre), "{}", a.nombre);
+                assert!(a.sha256.len() == 64 && a.sha256.chars().all(|c| c.is_ascii_hexdigit()), "{}", a.nombre);
+                assert!(a.tamano > 0);
+            }
+        }
+    }
+
+    #[test]
+    fn only_filmnex_brings_models() {
+        assert_eq!(de("photocraft"), &[] as &[Modelo]);
+        assert_eq!(WHISPER.tamano(), 1_620_540_229);
+        let carpetas: Vec<_> = de("filmcraft").iter().map(|m| m.carpeta).collect();
+        assert_eq!(
+            carpetas,
+            [
+                "whisper-large-v3-turbo",
+                "reframe-yunet-2023mar",
+                "reframe-rtdetrv2-r18vd",
+                "reframe-lightasd-ava",
+                "separar-kim-vocal-2",
+                "qwen3-embedding-0.6b",
+                "siglip2-base-patch16-256"
+            ]
+        );
+        // unos 4,9 GB en total
+        assert_eq!(total("filmcraft"), 4_901_378_200);
+        assert_eq!(
+            WHISPER.url(&WHISPER.archivos[0]),
+            "https://huggingface.co/openai/whisper-large-v3-turbo/resolve/41f01f3fe87f28c78e2fbf8b568835947dd65ed9/config.json"
+        );
+    }
+
+    #[test]
+    fn unsafe_names_are_refused() {
+        for malo in ["", "../x", "a/../b", "/abs", "c:x", "a\\b", "a//b", ".", "a/./b", "ñ.bin"] {
+            assert!(!nombre_valido(malo), "{malo}");
+        }
+        assert!(nombre_valido("onnx/model.safetensors"));
+    }
+}
