diff --git a/crates/native/src/jacnex_modelos.rs b/crates/native/src/jacnex_modelos.rs
new file mode 100644
index 0000000..fb04af8
--- /dev/null
+++ b/crates/native/src/jacnex_modelos.rs
@@ -0,0 +1,214 @@
+//! Jacnex: los modelos de IA de una app (hoy, los de Filmnex: voz, vertical, búsqueda) se
+//! descargan junto con ella, antes de instalarla o actualizarla, para que la app nunca pida una
+//! descarga. La lista (URL fija, SHA-256 y tamaño de cada archivo) está en
+//! `jacnex_studio_core::jacnex_modelos`.
+//!
+//! Quedan en `<datos de Jacnex Studio>/modelos/<carpeta>/` (en Windows,
+//! `%LOCALAPPDATA%\Jacnex Studio\modelos\…`), fuera de la carpeta de la app: una actualización
+//! no los vuelve a bajar. Cada archivo se comprueba con su SHA-256; si la conexión se corta, la
+//! descarga sigue desde donde quedó.
+
+use std::path::{Path, PathBuf};
+
+use jacnex_studio_core::CraftApp;
+use jacnex_studio_core::jacnex_modelos::{self as datos, nombre_valido};
+use jacnex_studio_core::protocol::JobPhase;
+
+use crate::http::{Http, Stop, Transfer};
+use crate::paths::Paths;
+
+/// Un archivo por bajar.
+#[derive(Clone, Debug)]
+pub struct Archivo {
+    pub url: String,
+    /// La ruta dentro de la carpeta de modelos (`<carpeta>/<nombre>`), con `/`.
+    pub ruta: String,
+    pub sha256: String,
+    pub tamano: u64,
+}
+
+/// Los archivos de los modelos de `app_id`, con nombres seguros.
+pub fn archivos(app_id: &str) -> Vec<Archivo> {
+    datos::de(app_id)
+        .iter()
+        .filter(|m| nombre_valido(m.carpeta) && !m.carpeta.contains('/'))
+        .flat_map(|m| {
+            m.archivos.iter().filter(|a| nombre_valido(a.nombre)).map(move |a| Archivo {
+                url: m.url(a),
+                ruta: format!("{}/{}", m.carpeta, a.nombre),
+                sha256: a.sha256.into(),
+                tamano: a.tamano,
+            })
+        })
+        .collect()
+}
+
+/// La carpeta de todos los modelos.
+pub fn carpeta(paths: &Paths) -> PathBuf {
+    paths.data.join("modelos")
+}
+
+fn ruta(dir: &Path, a: &Archivo) -> PathBuf {
+    a.ruta.split('/').fold(dir.to_path_buf(), |p, parte| p.join(parte))
+}
+
+/// El archivo ya está completo (el tamaño basta aquí: la app comprueba el SHA-256 al cargarlo, y
+/// cada descarga se comprobó al terminar).
+fn listo(dir: &Path, a: &Archivo) -> bool {
+    std::fs::metadata(ruta(dir, a)).is_ok_and(|m| m.is_file() && m.len() == a.tamano)
+}
+
+/// Bytes que faltan bajar.
+pub fn faltan(dir: &Path, lista: &[Archivo]) -> u64 {
+    lista.iter().filter(|a| !listo(dir, a)).map(|a| a.tamano).fold(0, u64::saturating_add)
+}
+
+/// Antes de instalar o actualizar `app`: baja lo que falte de sus modelos. Una pausa o una
+/// cancelación terminan el trabajo como cualquier descarga (y nada se instala).
+pub fn preparar(app: &CraftApp, http: &Http, paths: &Paths, stop: &Stop, phase: &mut dyn FnMut(JobPhase)) -> Result<(), String> {
+    let lista = archivos(app.id);
+    if lista.is_empty() {
+        return Ok(());
+    }
+    bajar(&carpeta(paths), &lista, http, stop, phase)
+}
+
+/// Baja a `dir` los archivos de `lista` que falten, con el progreso de todos juntos.
+pub fn bajar(dir: &Path, lista: &[Archivo], http: &Http, stop: &Stop, phase: &mut dyn FnMut(JobPhase)) -> Result<(), String> {
+    let total = faltan(dir, lista);
+    if total == 0 {
+        return Ok(());
+    }
+    log::info!("descargando los modelos de IA ({total} bytes)");
+    let mut hecho = 0u64;
+    for a in lista {
+        if listo(dir, a) {
+            continue;
+        }
+        let destino = ruta(dir, a);
+        if let Some(padre) = destino.parent() {
+            std::fs::create_dir_all(padre).map_err(|e| format!("the AI models couldn't be saved: {e}"))?;
+        }
+        let base = hecho;
+        http.download(&a.url, &destino, a.tamano, &a.sha256, stop, &mut |t| match t {
+            Transfer::Bytes { done, .. } => phase(JobPhase::Downloading { done: base.saturating_add(done).min(total), total }),
+            Transfer::Reconnecting { done, .. } => phase(JobPhase::Reconnecting { done: base.saturating_add(done).min(total), total }),
+        })
+        .map_err(|e| {
+            if e == jacnex_studio_core::protocol::CANCELLED || e == jacnex_studio_core::protocol::PAUSED {
+                e
+            } else {
+                format!("the AI models couldn't be downloaded: {e}")
+            }
+        })?;
+        hecho = hecho.saturating_add(a.tamano);
+    }
+    (phase)(JobPhase::Verifying);
+    Ok(())
+}
+
+/// Al quitar `app`: borra sus modelos (solo sus archivos, por nombre, y las carpetas que queden
+/// vacías).
+pub fn borrar(app: &CraftApp, paths: &Paths) {
+    let dir = carpeta(paths);
+    for a in archivos(app.id) {
+        let archivo = ruta(&dir, &a);
+        let _ = std::fs::remove_file(&archivo);
+        // las carpetas de este archivo, de adentro hacia afuera, hasta la de modelos
+        let mut p = archivo.parent().map(Path::to_path_buf);
+        while let Some(c) = p {
+            if c == dir || !c.starts_with(&dir) || std::fs::remove_dir(&c).is_err() {
+                break;
+            }
+            p = c.parent().map(Path::to_path_buf);
+        }
+    }
+    let _ = std::fs::remove_dir(&dir);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::http::tests::{Reply, body, serve};
+
+    fn de_prueba(ruta: &str, veces: usize) -> (Archivo, Vec<u8>) {
+        let (cuerpo, sha) = body();
+        let (url, _) = serve(cuerpo.clone(), vec![Reply::Full; veces]);
+        (Archivo { url, ruta: ruta.into(), sha256: sha, tamano: cuerpo.len() as u64 }, cuerpo)
+    }
+
+    #[test]
+    fn the_models_are_pinned_and_live_outside_the_app_folder() {
+        let lista = archivos("filmcraft");
+        assert!(lista.iter().any(|a| a.ruta == "whisper-large-v3-turbo/model.safetensors"));
+        assert!(lista.iter().all(|a| a.url.starts_with("https://") && a.sha256.len() == 64));
+        assert_eq!(faltan(Path::new("no-existe"), &lista), datos::total("filmcraft"));
+        let paths = Paths::under(Path::new("raiz"));
+        assert_eq!(carpeta(&paths), Path::new("raiz").join("data").join("modelos"));
+    }
+
+    #[test]
+    fn only_filmnex_downloads_models() {
+        let dir = tempfile::tempdir().unwrap();
+        let paths = Paths::under(dir.path());
+        let app = CraftApp::by_id("photocraft").unwrap();
+        let mut fases = Vec::new();
+        preparar(app, &Http::new().unwrap(), &paths, &Stop::default(), &mut |p| fases.push(p)).unwrap();
+        assert!(fases.is_empty());
+        assert!(!carpeta(&paths).exists());
+    }
+
+    #[test]
+    fn missing_files_are_downloaded_checked_and_kept() {
+        let dir = tempfile::tempdir().unwrap();
+        let modelos = dir.path().join("modelos");
+        let (a, cuerpo_a) = de_prueba("voz/config.json", 1);
+        let (b, cuerpo_b) = de_prueba("vision/sub/model.safetensors", 1);
+        let lista = vec![a, b];
+        let http = Http::new().unwrap();
+        let mut fases = Vec::new();
+        bajar(&modelos, &lista, &http, &Stop::default(), &mut |p| fases.push(p)).unwrap();
+        assert_eq!(std::fs::read(modelos.join("voz").join("config.json")).unwrap(), cuerpo_a);
+        assert_eq!(std::fs::read(modelos.join("vision").join("sub").join("model.safetensors")).unwrap(), cuerpo_b);
+        let total = (cuerpo_a.len() + cuerpo_b.len()) as u64;
+        assert!(fases.contains(&JobPhase::Downloading { done: total, total }), "{fases:?}");
+        assert_eq!(fases.last(), Some(&JobPhase::Verifying));
+        assert_eq!(faltan(&modelos, &lista), 0);
+        // la segunda vez no se baja nada
+        let mut otra = Vec::new();
+        bajar(&modelos, &lista, &http, &Stop::default(), &mut |p| otra.push(p)).unwrap();
+        assert!(otra.is_empty());
+    }
+
+    #[test]
+    fn a_file_with_the_wrong_checksum_is_refused() {
+        let dir = tempfile::tempdir().unwrap();
+        // la descarga se reintenta una vez desde cero antes de rechazarla
+        let (mut a, _) = de_prueba("voz/config.json", 2);
+        a.sha256 = "0".repeat(64);
+        let r = bajar(dir.path(), &[a], &Http::new().unwrap(), &Stop::default(), &mut |_| {});
+        assert!(r.is_err_and(|e| e.contains("AI models")));
+        assert!(!dir.path().join("voz").join("config.json").exists());
+    }
+
+    #[test]
+    fn removing_filmnex_deletes_only_its_model_files() {
+        let dir = tempfile::tempdir().unwrap();
+        let paths = Paths::under(dir.path());
+        let modelos = carpeta(&paths);
+        let voz = modelos.join("whisper-large-v3-turbo");
+        std::fs::create_dir_all(&voz).unwrap();
+        std::fs::write(voz.join("config.json"), b"{}").unwrap();
+        borrar(CraftApp::by_id("photocraft").unwrap(), &paths);
+        assert!(voz.join("config.json").exists());
+        let otro = modelos.join("otro.bin");
+        std::fs::write(&otro, b"x").unwrap();
+        borrar(CraftApp::by_id("filmcraft").unwrap(), &paths);
+        assert!(!voz.exists());
+        assert!(otro.exists(), "a file the launcher didn't put there stays");
+        std::fs::remove_file(&otro).unwrap();
+        std::fs::create_dir_all(&voz).unwrap();
+        borrar(CraftApp::by_id("filmcraft").unwrap(), &paths);
+        assert!(!modelos.exists(), "empty folders go too");
+    }
+}
