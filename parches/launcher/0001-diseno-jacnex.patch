+
+fn ficha(id: &str) -> Option<&'static Ficha> {
+    FICHAS.iter().find(|f| f.id == id)
+}
+
+/// `a` with `b` mixed in at `amount` (0–1): tinted surfaces.
+fn mezcla(a: Color32, b: Color32, amount: f32) -> Color32 {
+    let m = |x: u8, y: u8| (f32::from(x) + (f32::from(y) - f32::from(x)) * amount).round() as u8;
+    Color32::from_rgb(m(a.r(), b.r()), m(a.g(), b.g()), m(a.b(), b.b()))
+}
+
+fn ease_out(x: f32) -> f32 {
+    1.0 - (1.0 - x.clamp(0.0, 1.0)).powi(3)
+}
+
+/// The shelf's short status line for an app, and its colour.
+fn estado_breve(t: &Tokens, entry: &AppEntry, status: &AppStatus) -> (String, Color32) {
+    if entry.paused.is_some() && entry.job.is_none() {
+        return ("En pausa".into(), t.warn);
+    }
+    match status {
+        AppStatus::UpdateAvailable => ("Actualización disponible".into(), t.accent_ink),
+        AppStatus::UpToDate | AppStatus::Installed => ("Instalada".into(), t.muted),
+        AppStatus::Available => ("Disponible".into(), t.muted),
+        AppStatus::NoRelease => ("Próximamente".into(), t.faint),
+        AppStatus::Checking => ("Comprobando…".into(), t.faint),
+        AppStatus::Unavailable => ("No disponible".into(), t.faint),
+    }
+}
+
+fn fraccion(job: Option<JobPhase>) -> Option<f32> {
+    match job? {
+        JobPhase::Downloading { done, total } | JobPhase::Reconnecting { done, total } if total > 0 => Some(done as f32 / total as f32),
+        _ => None,
+    }
+}
+
+impl LauncherUi {
+    /// The whole window under the title bar.
+    pub(crate) fn jacnex_layout(&mut self, ui: &mut Ui, host: &mut dyn Host) {
+        let t = Tokens::get(ui.ctx());
+        egui::Panel::top("jx-cabecera")
+            .frame(egui::Frame::new().fill(t.bg))
+            .exact_size(HEADER_H)
+            .resizable(false)
+            .show(ui, |ui| self.jx_cabecera(ui, host.title_bar()));
+        egui::Panel::left("jx-repisa")
+            .frame(egui::Frame::new().fill(t.sunken))
+            .exact_size(SHELF_W)
+            .resizable(false)
+            .show(ui, |ui| self.jx_repisa(ui));
+        egui::CentralPanel::default().frame(egui::Frame::new().fill(t.bg)).show(ui, |ui| self.jx_escenario(ui));
+    }
+
+    /// The app on the stage: the one chosen, else the first installed, else the first one.
+    fn jx_elegida(&self, ctx: &egui::Context) -> Option<String> {
+        let elegida: Option<String> = ctx.data(|d| d.get_temp(egui::Id::new("jx-elegida")));
+        let visible = |id: &str| self.entries.iter().any(|e| e.app.id == id && !self.settings.hidden.contains(e.app.id));
+        if let Some(id) = elegida.filter(|id| visible(id)) {
+            return Some(id);
+        }
+        let platform = self.platform;
+        let manage = self.caps.manage_apps;
+        let visibles = self.entries.iter().filter(|e| !self.settings.hidden.contains(e.app.id));
+        let mut todas = visibles.clone();
+        visibles.into_iter().find(|e| e.status(platform, manage).is_installed()).or_else(|| todas.next()).map(|e| e.app.id.to_string())
+    }
+
+    fn jx_elegir(&self, ctx: &egui::Context, id: &str) {
+        ctx.data_mut(|d| {
+            d.insert_temp(egui::Id::new("jx-elegida"), id.to_string());
+            d.insert_temp(egui::Id::new("jx-elegida-desde"), ctx.input(|i| i.time));
+        });
+    }
+
+    // ---- header ------------------------------------------------------------------------------
+
+    fn jx_cabecera(&mut self, ui: &mut Ui, bar: TitleBar) {
+        let t = Tokens::get(ui.ctx());
+        let full = ui.max_rect();
+        if bar != TitleBar::Native {
+            widgets::title_bar_drag(ui);
+        }
+        ui.painter().hline(full.x_range(), full.bottom() - 0.5, t.hairline());
+        ui.horizontal_centered(|ui| {
+            ui.spacing_mut().item_spacing.x = 8.0;
+            if bar == TitleBar::MacOs {
+                ui.add_space(72.0);
+            }
+            ui.add_space(20.0);
+            let alto = 26.0;
+            let (logo, _) = ui.allocate_exact_size(vec2(alto * crate::icons::JACNEX_LOGO_ASPECT, alto), Sense::hover());
+            egui::Image::new(crate::icons::jacnex_logo(t.dark)).alt_text("Jacnex Studio").paint_at(ui, logo);
+            ui.with_layout(Layout::right_to_left(Align::Center), |ui| {
+                if bar == TitleBar::Custom {
+                    widgets::window_buttons(ui, HEADER_H);
+                    ui.add_space(4.0);
+                } else {
+                    ui.add_space(16.0);
+                }
+                if widgets::nav_icon(ui, "⚙", "Configuración", 38.0, false).clicked() {
+                    self.dialog = Some(Dialog::Settings);
+                }
+                if widgets::nav_icon(ui, "⟳", if self.checking { "Buscando actualizaciones…" } else { "Buscar actualizaciones" }, 38.0, self.checking)
+                    .clicked()
+                {
+                    self.check_now();
+                }
+                ui.add_space(6.0);
+                if widgets::button(ui, "Forgenex · IA", Kind::Secondary, 0.0).on_hover_text("Imágenes y videos con IA, con tus créditos").clicked() {
+                    ui.ctx().open_url(egui::OpenUrl::new_tab("https://jacnex.com/app"));
+                }
+                let pendientes = self.jx_pendientes();
+                if !pendientes.is_empty() {
+                    let texto = if pendientes.len() == 1 { "Actualizar 1 app".to_string() } else { format!("Actualizar {} apps", pendientes.len()) };
+                    if widgets::button(ui, &texto, Kind::Primary, 0.0).clicked() {
+                        for id in pendientes {
+                            self.install_app(&id);
+                        }
+                    }
+                }
+            });
+        });
+    }
+
+    /// Apps with an update ready and nothing running.
+    fn jx_pendientes(&self) -> Vec<String> {
+        self.entries
+            .iter()
+            .filter(|e| {
+                !self.settings.hidden.contains(e.app.id)
+                    && e.job.is_none()
+                    && e.status(self.platform, self.caps.manage_apps) == AppStatus::UpdateAvailable
+            })
+            .map(|e| e.app.id.to_string())
+            .collect()
+    }
+
+    // ---- shelf -------------------------------------------------------------------------------
+
+    fn jx_repisa(&mut self, ui: &mut Ui) {
+        let t = Tokens::get(ui.ctx());
+        let ctx = ui.ctx().clone();
+        let full = ui.max_rect();
+        ui.painter().vline(full.right() - 0.5, full.y_range(), t.hairline());
+        let elegida = self.jx_elegida(&ctx);
+        let platform = self.platform;
+        let manage = self.caps.manage_apps;
+        let visibles: Vec<AppEntry> = self.entries.iter().filter(|e| !self.settings.hidden.contains(e.app.id)).cloned().collect();
+        let (mias, resto): (Vec<&AppEntry>, Vec<&AppEntry>) =
+            visibles.iter().partition(|e| e.status(platform, manage).is_installed() || e.job.is_some_and(|_| e.installed.is_some()));
+        let mut elegir: Option<String> = None;
+        egui::ScrollArea::vertical().auto_shrink(false).show(ui, |ui| {
+            ui.add_space(16.0);
+            for (titulo, lista) in [("MIS APPS", &mias), ("MÁS EN TU PLAN", &resto)] {
+                if lista.is_empty() {
+                    continue;
+                }
+                ui.horizontal(|ui| {
+                    ui.add_space(22.0);
+                    ui.label(RichText::new(titulo).font(FontId::new(11.0, theme::bold())).color(t.faint).extra_letter_spacing(0.8));
+                });
+                ui.add_space(6.0);
+                for e in lista {
+                    if self.jx_fila(ui, e, elegida.as_deref() == Some(e.app.id)).clicked() {
+                        elegir = Some(e.app.id.to_string());
+                    }
+                }
+                ui.add_space(18.0);
+            }
+        });
+        if let Some(id) = elegir {
+            self.jx_elegir(&ctx, &id);
+        }
+    }
+
+    fn jx_fila(&self, ui: &mut Ui, e: &AppEntry, actual: bool) -> egui::Response {
+        let t = Tokens::get(ui.ctx());
+        let ancho = ui.available_width();
+        let (fila, resp) = ui.allocate_exact_size(vec2(ancho, SHELF_ROW_H), Sense::click());
+        let caja = Rect::from_min_max(fila.min + vec2(10.0, 2.0), fila.max - vec2(10.0, 2.0));
+        let hover = ui.ctx().animate_bool_with_time(resp.id.with("hover"), resp.hovered() && !actual, 0.12);
+        let p = ui.painter();
+        if actual {
+            p.rect(caja, theme::RADIUS_LARGE, t.bg, Stroke::new(1.0, t.line), StrokeKind::Inside);
+            let marca = Rect::from_min_max(egui::pos2(fila.left(), caja.top() + 12.0), egui::pos2(fila.left() + 3.0, caja.bottom() - 12.0));
+            p.rect_filled(marca, CornerRadius { nw: 0, sw: 0, ne: 2, se: 2 }, t.accent);
+        } else if hover > 0.0 {
+            p.rect_filled(caja, theme::RADIUS_LARGE, theme::tint(t.ink_strong, 0.05 * hover));
+        }
+        let status = e.status(self.platform, self.caps.manage_apps);
+        let icono = Rect::from_min_size(egui::pos2(caja.left() + 10.0, caja.center().y - 15.0), vec2(30.0, 30.0));
+        let en_color = status != AppStatus::NoRelease;
+        if let Some(img) = crate::icons::app_image(ui.ctx(), e.app.id, en_color) {
+            img.paint_at(ui, icono.expand(hover));
+        }
+        let x = icono.right() + 12.0;
+        let nombre = FontId::new(13.5, if actual { theme::bold() } else { theme::semibold() });
+        p.text(egui::pos2(x, caja.center().y - 8.0), Align2::LEFT_CENTER, e.app.name, nombre, t.ink_strong);
+        let y2 = caja.center().y + 10.0;
+        if e.job.is_some() {
+            let pista = Rect::from_min_size(egui::pos2(x, y2 - 2.0), vec2(caja.right() - x - 14.0, 4.0));
+            p.rect_filled(pista, CornerRadius::same(2), t.line);
+            let f = fraccion(e.job).unwrap_or_else(|| (ui.input(|i| i.time) as f32 * 0.7).fract());
+            p.rect_filled(Rect::from_min_size(pista.min, vec2(pista.width() * f, 4.0)), CornerRadius::same(2), t.accent);
+            ui.ctx().request_repaint();
+        } else {
+            let (texto, color) = estado_breve(&t, e, &status);
+            p.text(egui::pos2(x, y2), Align2::LEFT_CENTER, texto, FontId::new(11.5, theme::medium()), color);
+        }
+        resp.on_hover_cursor(egui::CursorIcon::PointingHand)
+    }
+
+    // ---- stage -------------------------------------------------------------------------------
+
+    fn jx_escenario(&mut self, ui: &mut Ui) {
+        let t = Tokens::get(ui.ctx());
+        let ctx = ui.ctx().clone();
+        let Some(id) = self.jx_elegida(&ctx) else { return };
+        let Some(entry) = self.entry(&id).cloned() else { return };
+        let status = entry.status(self.platform, self.caps.manage_apps);
+        let ficha = ficha(&id);
+        let color = theme::rgb(entry.app.color);
+
+        // Fade the stage in when another app is chosen.
+        let desde: f64 = ctx.data(|d| d.get_temp(egui::Id::new("jx-elegida-desde"))).unwrap_or(0.0);
+        let avance = if self.reduce_motion { 1.0 } else { ease_out(((ctx.input(|i| i.time) - desde) as f32) / STAGE_FADE) };
+        if avance < 1.0 {
+            ctx.request_repaint();
+        }
+
+        egui::ScrollArea::vertical().auto_shrink(false).show(ui, |ui| {
+            ui.multiply_opacity(0.35 + 0.65 * avance);
+            let ancho = ui.available_width();
+            // The tinted stage.
+            let (zona, _) = ui.allocate_exact_size(vec2(ancho, STAGE_H), Sense::hover());
+            let fondo = mezcla(t.bg, color, if t.dark { 0.07 } else { 0.065 });
+            ui.painter().rect_filled(zona, CornerRadius::ZERO, fondo);
+            ui.painter().hline(zona.x_range(), zona.bottom() - 0.5, t.hairline());
+            let dentro = zona.shrink2(vec2(STAGE_PAD_X, 34.0)).translate(vec2(0.0, 8.0 * (1.0 - avance)));
+            let con_tarjeta = dentro.width() > CARD_W + 380.0;
+            let texto_rect = if con_tarjeta { dentro.with_max_x(dentro.right() - CARD_W - 32.0) } else { dentro };
+            ui.scope_builder(UiBuilder::new().max_rect(texto_rect).layout(Layout::top_down(Align::Min)), |ui| {
+                self.jx_titulo(ui, &entry, &status, ficha);
+            });
+            if con_tarjeta && let Some(f) = ficha {
+                let tarjeta = Rect::from_min_size(egui::pos2(dentro.right() - CARD_W, dentro.center().y - 102.0), vec2(CARD_W, 204.0));
+                self.jx_tarjeta(ui, tarjeta, f, color);
+            }
+            // Below the stage: about and the facts of this release.
+            ui.add_space(26.0);
+            egui::Frame::new().inner_margin(Margin::symmetric(STAGE_PAD_X as i8, 0)).show(ui, |ui| {
+                let dos = ui.available_width() > 640.0;
+                if dos {
+                    // Columns lay out justified; the text reads left-aligned.
+                    ui.columns(2, |cols| {
+                        cols[0].with_layout(Layout::top_down(Align::Min), |ui| self.jx_acerca(ui, &entry, ficha));
+                        cols[1].with_layout(Layout::top_down(Align::Min), |ui| self.jx_datos(ui, &entry, &status));
+                    });
+                } else {
+                    self.jx_acerca(ui, &entry, ficha);
+                    ui.add_space(20.0);
+                    self.jx_datos(ui, &entry, &status);
+                }
+            });
+            ui.add_space(32.0);
+        });
+    }
+
+    fn jx_titulo(&mut self, ui: &mut Ui, entry: &AppEntry, status: &AppStatus, ficha: Option<&Ficha>) {
+        let t = Tokens::get(ui.ctx());
+        let (icono, _) = ui.allocate_exact_size(vec2(64.0, 64.0), Sense::hover());
+        if let Some(img) = crate::icons::app_image(ui.ctx(), entry.app.id, *status != AppStatus::NoRelease) {
+            img.paint_at(ui, icono);
+        }
+        ui.add_space(14.0);
+        if let Some(f) = ficha {
+            ui.label(RichText::new(f.categoria).font(FontId::new(11.5, theme::bold())).color(t.accent_ink).extra_letter_spacing(1.0));
+            ui.add_space(4.0);
+        }
+        ui.label(RichText::new(entry.app.name).font(FontId::new(42.0, theme::display())).color(t.ink_strong).extra_letter_spacing(-1.2));
+        ui.add_space(4.0);
+        let lema = ficha.map(|f| f.lema.to_string()).unwrap_or_else(|| crate::i18n::tr_ctx(crate::i18n::current(), entry.app.id, entry.app.tagline).to_string());
+        ui.label(RichText::new(lema).font(FontId::new(15.0, egui::FontFamily::Proportional)).color(t.ink));
+        ui.add_space(18.0);
+        ui.horizontal(|ui| {
+            ui.spacing_mut().item_spacing.x = 10.0;
+            self.jx_accion(ui, entry, status);
+        });
+    }
+
+    /// The big main button with its menu; the launcher's own controls for everything else
+    /// (progress, pause, resume, retry, unavailable).
+    fn jx_accion(&mut self, ui: &mut Ui, entry: &AppEntry, status: &AppStatus) {
+        let t = Tokens::get(ui.ctx());
+        let id = entry.app.id.to_string();
+        let sencillo = entry.job.is_none() && !(entry.paused.is_some() && self.caps.manage_apps);
+        let (texto, instalar) = match self.primary_action(entry, status) {
+            Primary::Open if sencillo => ("Abrir".to_string(), false),
+            Primary::Install if sencillo => ("Instalar".to_string(), true),
+            Primary::Update(v) if sencillo => (format!("Actualizar a {v}"), true),
+            _ => {
+                self.actions_in(ui, entry, status, 380.0, true);
+                return;
+            }
+        };
+        if gran_boton(ui, &texto, &t).clicked() {
+            if instalar {
+                self.install_app(&id);
+            } else {
+                self.launch_app(&id);
+            }
+        }
+        self.menu(ui, entry, status, true);
+        let detalle = match status {
+            AppStatus::UpdateAvailable => format!("Instalada {} · {} disponible", entry.installed_label().unwrap_or_default(), entry.latest_label().unwrap_or_default()),
+            AppStatus::UpToDate => format!("Versión {} · Actualizada", entry.installed_label().unwrap_or_default()),
+            AppStatus::Installed => format!("Versión {}", entry.installed_label().unwrap_or_default()),
+            AppStatus::Available => {
+                let tamano = self.jx_tamano(entry).map(|b| format!(" · {}", widgets::human_bytes(b))).unwrap_or_default();
+                format!("Versión {}{tamano}", entry.latest_label().unwrap_or_default())
+            }
+            _ => String::new(),
+        };
+        if !detalle.is_empty() {
+            ui.add_space(4.0);
+            ui.label(RichText::new(detalle).font(FontId::new(12.5, theme::medium())).color(t.muted));
+        }
+    }
+
+    fn jx_tamano(&self, entry: &AppEntry) -> Option<u64> {
+        let (r, p) = (entry.release()?, self.platform?);
+        let stems: Vec<&str> = entry.app.stems().collect();
+        pick_asset(r, &stems, p, p.download_kinds()).map(|(a, _)| a.size)
+    }
+
+    fn jx_tarjeta(&self, ui: &mut Ui, rect: Rect, f: &Ficha, color: Color32) {
+        let t = Tokens::get(ui.ctx());
+        let p = ui.painter();
+        if !t.dark {
+            let sombra = egui::epaint::Shadow { offset: [0, 8], blur: 24, spread: 0, color: Color32::from_rgba_unmultiplied(10, 31, 63, 16) };
+            p.add(sombra.as_shape(rect, CornerRadius::same(12)));
+        }
+        p.rect(rect, CornerRadius::same(12), t.bg, Stroke::new(1.0, t.line), StrokeKind::Inside);
+        let x = rect.left() + 20.0;
+        p.text(egui::pos2(x, rect.top() + 24.0), Align2::LEFT_CENTER, "LO QUE PUEDES HACER", FontId::new(11.0, theme::bold()), t.faint);
+        let suave = mezcla(t.bg, color, if t.dark { 0.3 } else { 0.13 });
+        let tinta = if t.dark { Color32::WHITE } else { color };
+        for (i, texto) in f.funciones.iter().enumerate() {
+            let y = rect.top() + 56.0 + i as f32 * 38.0;
+            if i > 0 {
+                p.hline(x..=rect.right() - 20.0, y - 19.0, t.hairline());
+            }
+            let marca = Rect::from_center_size(egui::pos2(x + 13.0, y), vec2(26.0, 26.0));
+            p.rect_filled(marca, CornerRadius::same(7), suave);
+            let c = marca.center();
+            p.line(vec![c + vec2(-5.0, 0.5), c + vec2(-1.5, 4.0), c + vec2(5.5, -3.5)], Stroke::new(2.2, tinta));
+            p.text(egui::pos2(x + 38.0, y), Align2::LEFT_CENTER, *texto, FontId::new(13.5, theme::semibold()), t.ink_strong);
+        }
+    }
+
+    fn jx_acerca(&self, ui: &mut Ui, entry: &AppEntry, ficha: Option<&Ficha>) {
+        let t = Tokens::get(ui.ctx());
+        ui.label(RichText::new(format!("Acerca de {}", entry.app.name)).font(FontId::new(15.0, theme::display())).color(t.ink_strong));
+        ui.add_space(8.0);
+        let texto = ficha.map(|f| f.acerca).unwrap_or(entry.app.tagline);
+        ui.label(RichText::new(texto).font(FontId::new(13.5, egui::FontFamily::Proportional)).color(t.ink));
+        if let Some(f) = ficha {
+            ui.add_space(10.0);
+            ui.label(
+                RichText::new(format!("Basado en {}, de código abierto (MIT o Apache-2.0).", f.base))
+                    .font(FontId::new(12.0, egui::FontFamily::Proportional))
+                    .color(t.muted),
+            );
+        }
+    }
+
+    fn jx_datos(&mut self, ui: &mut Ui, entry: &AppEntry, status: &AppStatus) {
+        let t = Tokens::get(ui.ctx());
+        ui.label(RichText::new("Detalles").font(FontId::new(15.0, theme::display())).color(t.ink_strong));
+        ui.add_space(8.0);
+        let fecha = entry.release().and_then(|r| r.published_at).map(crate::views::date_text);
+        let filas: [(&str, Option<String>); 4] = [
+            ("Versión instalada", entry.installed.as_ref().and(entry.installed_label())),
+            ("Última versión", entry.latest_label()),
+            ("Publicada", fecha),
+            ("Tamaño de descarga", self.jx_tamano(entry).map(widgets::human_bytes)),
+        ];
+        for (i, (nombre, valor)) in filas.iter().enumerate() {
+            let (fila, _) = ui.allocate_exact_size(vec2(ui.available_width(), 32.0), Sense::hover());
+            let p = ui.painter();
+            if i > 0 {
+                p.hline(fila.x_range(), fila.top(), t.hairline());
+            }
+            p.text(egui::pos2(fila.left(), fila.center().y), Align2::LEFT_CENTER, *nombre, FontId::new(13.0, egui::FontFamily::Proportional), t.muted);
+            p.text(
+                egui::pos2(fila.right(), fila.center().y),
+                Align2::RIGHT_CENTER,
+                valor.clone().unwrap_or_else(|| "—".into()),
+                FontId::new(13.0, theme::semibold()),
+                t.ink_strong,
+            );
+        }
+        if entry.release().is_some() {
+            ui.add_space(12.0);
+            if widgets::button(ui, "Ver novedades de la versión", Kind::Secondary, 0.0).clicked() {
+                self.dialog = Some(Dialog::Notes(entry.app.id.to_string()));
+            }
+        }
+        if *status == AppStatus::NoRelease {
+            ui.add_space(12.0);
+            ui.label(RichText::new("Esta app todavía no tiene una versión publicada. Aparecerá aquí en cuanto esté lista.").color(t.muted));
+        }
+    }
+}
+
+/// The stage's big main button, in the brand blue.
+fn gran_boton(ui: &mut Ui, texto: &str, t: &Tokens) -> egui::Response {
+    let galley = ui.painter().layout_no_wrap(texto.to_string(), FontId::new(15.0, theme::display()), t.invert_fg);
+    let size = vec2((galley.size().x + 52.0).max(168.0), BIG_BUTTON_H);
+    let (rect, resp) = ui.allocate_exact_size(size, Sense::click());
+    let hover = ui.ctx().animate_bool_with_time(resp.id.with("hover"), resp.hovered(), 0.12);
+    let pulsado = resp.is_pointer_button_down_on();
+    let fondo = t.invert_bg.gamma_multiply(1.0 - 0.1 * hover - if pulsado { 0.08 } else { 0.0 });
+    let rect_dibujo = if pulsado { rect.shrink(1.0) } else { rect };
+    ui.painter().rect_filled(rect_dibujo, CornerRadius::same(8), fondo);
+    ui.painter().galley(rect.center() - galley.size() / 2.0, galley, t.invert_fg);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::WidgetType::Button, true, texto));
+    resp.on_hover_cursor(egui::CursorIcon::PointingHand)
+}
