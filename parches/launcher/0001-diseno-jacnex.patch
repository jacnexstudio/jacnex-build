diff --git a/crates/ui-egui/tests/jacnex_capturas.rs b/crates/ui-egui/tests/jacnex_capturas.rs
new file mode 100644
index 0000000..5a028d0
--- /dev/null
+++ b/crates/ui-egui/tests/jacnex_capturas.rs
@@ -0,0 +1,128 @@
+//! Captures of Jacnex Studio's window, drawn off screen: no real backend, nothing on the desktop.
+//! Run with JACNEX_STUDIO_SNAPSHOTS=<folder> to save them; without it the test only draws.
+
+use jacnex_studio_core::protocol::{Backend, Capabilities, Command, Event, JobPhase, LatestRelease, Origin, Source};
+use jacnex_studio_core::release::{Asset, Release};
+use jacnex_studio_core::status::InstallSource;
+use jacnex_studio_core::{Arch, Installed, Os, Platform, SUITE, version};
+use jacnex_studio_ui_egui::{Host, LauncherUi, Settings};
+use egui_kittest::Harness;
+
+const NOW: i64 = 1_792_700_000;
+
+struct Fake {
+    events: Vec<Event>,
+}
+
+impl Backend for Fake {
+    fn send(&mut self, _command: Command) {}
+    fn poll(&mut self) -> Vec<Event> {
+        std::mem::take(&mut self.events)
+    }
+    fn capabilities(&self) -> Capabilities {
+        Capabilities { manage_apps: true, reveal_label: "Show in Explorer", self_update: true }
+    }
+    fn platform(&self) -> Option<Platform> {
+        Some(Platform { os: Os::Windows, arch: Arch::X64 })
+    }
+    fn now(&self) -> i64 {
+        NOW
+    }
+}
+
+struct NoHost;
+impl Host for NoHost {}
+
+fn release(id: &str, v: &str, at: i64, mb: u64) -> Release {
+    let name = format!("{id}-{v}-windows-x64.msi");
+    Release {
+        tag: format!("v{v}"),
+        version: version::parse(v),
+        name: format!("v{v}"),
+        published_at: Some(at),
+        html_url: format!("https://github.com/jacnexstudio/{id}/releases/tag/v{v}"),
+        notes: "## Novedades\n* Mejoras de rendimiento".into(),
+        prerelease: false,
+        assets: vec![Asset { name: name.clone(), size: mb << 20, url: format!("https://github.com/jacnexstudio/{id}/releases/download/v{v}/{name}"), sha256: None }],
+    }
+}
+
+fn events(downloading: bool) -> Vec<Event> {
+    let mut ev = Vec::new();
+    let published = [
+        ("photocraft", "0.12.1", 46),
+        ("lightcraft", "0.11.0", 90),
+        ("vectorcraft", "0.14.0", 104),
+        ("filmcraft", "0.10.0", 57),
+        ("effectcraft", "0.14.0", 51),
+        ("designcraft", "0.11.0", 64),
+        ("pdfcraft", "0.11.0", 72),
+    ];
+    for app in &SUITE {
+        let latest = match published.iter().find(|(id, _, _)| *id == app.id) {
+            Some((id, v, mb)) => LatestRelease::Found(release(id, v, NOW - 86_400 * 2, *mb)),
+            None => LatestRelease::None,
+        };
+        ev.push(Event::Latest { app: app.id.into(), latest, from: Origin::GitHub });
+    }
+    let installed = [("photocraft", "0.12.0"), ("lightcraft", "0.11.0"), ("vectorcraft", "0.14.0"), ("pdfcraft", "0.11.0")];
+    for app in &SUITE {
+        let inst = installed.iter().find(|(id, _)| *id == app.id).map(|(_, v)| Installed {
+            version: version::parse(v),
+            source: InstallSource::Msi,
+            location: format!("C:\\Program Files\\{}", app.name),
+            package: None,
+        });
+        ev.push(Event::Detected { app: app.id.into(), installed: inst });
+    }
+    if downloading {
+        ev.push(Event::Progress { app: "filmcraft".into(), phase: JobPhase::Downloading { done: 21 << 20, total: 57 << 20 } });
+    }
+    ev.push(Event::CheckFinished { at: NOW - 120, source: Source::GitHubApi, rate_limited_until: None });
+    ev
+}
+
+fn capturar(nombre: &str, theme: egui::Theme, elegir: Option<&'static str>, downloading: bool) {
+    jacnex_studio_ui_egui::i18n::set_test_lang(jacnex_studio_ui_egui::i18n::Lang::ES);
+    let mut backend: Option<Box<dyn Backend>> = Some(Box::new(Fake { events: events(downloading) }));
+    let mut harness = Harness::builder().with_size(egui::vec2(1180.0, 720.0)).with_theme(theme).build_ui_state(
+        move |ui, launcher: &mut Option<LauncherUi>| {
+            if launcher.is_none()
+                && let Some(b) = backend.take()
+            {
+                let mut s = Settings { notify: false, ..Settings::default() };
+                s.language = "es".into();
+                s.theme = if theme == egui::Theme::Dark {
+                    jacnex_studio_ui_egui::theme::ThemeChoice::Dark
+                } else {
+                    jacnex_studio_ui_egui::theme::ThemeChoice::Light
+                };
+                *launcher = Some(LauncherUi::new(ui.ctx(), b, s));
+                if let Some(id) = elegir {
+                    ui.ctx().data_mut(|d| d.insert_temp(egui::Id::new("jx-elegida"), id.to_string()));
+                }
+            }
+            if let Some(l) = launcher.as_mut() {
+                l.logic(&ui.ctx().clone(), &mut NoHost);
+                l.ui(ui, &mut NoHost);
+            }
+        },
+        None,
+    );
+    for _ in 0..12 {
+        harness.step();
+    }
+    harness.run_steps(30);
+    if let Some(dir) = std::env::var_os("JACNEX_STUDIO_SNAPSHOTS") {
+        let img = harness.render().expect("render");
+        img.save(std::path::Path::new(&dir).join(format!("{nombre}.png"))).expect("save");
+    }
+}
+
+#[test]
+fn capturas_del_launcher() {
+    capturar("claro-photonex", egui::Theme::Light, Some("photocraft"), false);
+    capturar("claro-filmnex-descargando", egui::Theme::Light, Some("filmcraft"), true);
+    capturar("oscuro-lightnex", egui::Theme::Dark, Some("lightcraft"), false);
+    capturar("claro-protonex", egui::Theme::Light, Some("figcraft"), false);
+}
