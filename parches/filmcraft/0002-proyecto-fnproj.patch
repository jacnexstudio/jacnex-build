diff --git a/apps/filmcraft/src/windows_file_types.rs b/apps/filmcraft/src/windows_file_types.rs
new file mode 100644
index 0000000..7773d58
--- /dev/null
+++ b/apps/filmcraft/src/windows_file_types.rs
@@ -0,0 +1,99 @@
+//! Jacnex — Windows: a double click on a project (`.fnproj`, and `.fcproj` from before) opens it in
+//! Filmnex. Jacnex Studio installs the app per user without an installer, so the app registers the
+//! project types itself, for the current user only (`HKCU\Software\Classes`, no administrator
+//! rights), on a thread of its own at each start, writing only what is missing or out of date (the
+//! program's path, after an update moved it). Only the copy Jacnex Studio installed registers:
+//! a development build or a copy run from elsewhere would point the types at a file that goes away.
+
+use std::path::Path;
+
+use winreg::RegKey;
+use winreg::enums::HKEY_CURRENT_USER;
+
+/// The project type's identifier (Windows' "ProgID").
+const PROG_ID: &str = "Jacnex.Filmnex.Proyecto";
+
+/// Register the project types on a thread of its own when this is the installed app. A failure is
+/// only logged: opening projects from the app works without it.
+pub fn register_in_background() {
+    let Ok(exe) = std::env::current_exe() else { return };
+    if !installed_by_jacnex_studio(&exe) {
+        return;
+    }
+    let spawned = std::thread::Builder::new().name("file-types".into()).spawn(move || {
+        let classes = RegKey::predef(HKEY_CURRENT_USER).create_subkey(r"Software\Classes").map(|(key, _)| key);
+        match classes.and_then(|classes| register(&classes, &exe)) {
+            Ok(true) => log::info!("project files (.{}) open with {}", filmcraft_engine::project_ext::PROJECT_EXT, exe.display()),
+            Ok(false) => {}
+            Err(e) => log::warn!("can't register the project files with Windows: {e}"),
+        }
+    });
+    if let Err(e) = spawned {
+        log::warn!("can't register the project files with Windows: {e}");
+    }
+}
+
+/// Whether `exe` is the copy Jacnex Studio installed (`…\Jacnex Studio\apps\…`).
+fn installed_by_jacnex_studio(exe: &Path) -> bool {
+    let parts: Vec<String> = exe.components().map(|c| c.as_os_str().to_string_lossy().to_lowercase()).collect();
+    parts.windows(2).any(|w| matches!(w, [a, b] if a == "jacnex studio" && b == "apps"))
+}
+
+/// Write the project types under `classes` (a `Software\Classes` key) for the program `exe`.
+/// `true` when something was written.
+fn register(classes: &RegKey, exe: &Path) -> std::io::Result<bool> {
+    let exe = exe.to_string_lossy();
+    let mut changed = false;
+    changed |= set(classes, PROG_ID, "", "Proyecto de Filmnex")?;
+    changed |= set(classes, &format!(r"{PROG_ID}\DefaultIcon"), "", &format!("\"{exe}\",0"))?;
+    changed |= set(classes, &format!(r"{PROG_ID}\shell\open\command"), "", &format!("\"{exe}\" \"%1\""))?;
+    for ext in filmcraft_engine::project_ext::PROJECT_EXTS {
+        changed |= set(classes, &format!(".{ext}"), "", PROG_ID)?;
+        changed |= set(classes, &format!(r".{ext}\OpenWithProgids"), PROG_ID, "")?;
+    }
+    Ok(changed)
+}
+
+/// Set the string `name` (`""`: the key's default value) of `key` under `root` to `value`, unless it
+/// already is. `true` when it was written.
+fn set(root: &RegKey, key: &str, name: &str, value: &str) -> std::io::Result<bool> {
+    let (key, _) = root.create_subkey(key)?;
+    if key.get_value::<String, _>(name).is_ok_and(|v| v == value) {
+        return Ok(false);
+    }
+    key.set_value(name, &value)?;
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_the_copy_jacnex_studio_installed_registers() {
+        assert!(installed_by_jacnex_studio(Path::new(r"C:\Users\a\AppData\Local\Jacnex Studio\apps\filmcraft\filmcraft.exe")));
+        assert!(installed_by_jacnex_studio(Path::new(r"C:\Users\a\AppData\Local\JACNEX STUDIO\Apps\filmcraft\filmcraft.exe")));
+        assert!(!installed_by_jacnex_studio(Path::new(r"C:\src\target\release\filmcraft.exe")));
+        assert!(!installed_by_jacnex_studio(Path::new(r"C:\Jacnex Studio\filmcraft.exe")));
+    }
+
+    /// Both extensions open with the program, and a second start writes nothing.
+    #[test]
+    fn the_project_types_open_with_the_program() {
+        let scratch = format!(r"Software\JacnexPruebaTipos-{}", std::process::id());
+        let hkcu = RegKey::predef(HKEY_CURRENT_USER);
+        let (classes, _) = hkcu.create_subkey(&scratch).unwrap();
+        let exe = Path::new(r"C:\Jacnex Studio\apps\filmcraft\filmcraft.exe");
+        let first = register(&classes, exe);
+        let second = register(&classes, exe);
+        let command: Result<String, _> = classes.open_subkey(format!(r"{PROG_ID}\shell\open\command")).and_then(|k| k.get_value(""));
+        let types: Vec<Result<String, _>> = [".fnproj", ".fcproj"].iter().map(|e| classes.open_subkey(e).and_then(|k| k.get_value(""))).collect();
+        let _ = hkcu.delete_subkey_all(&scratch);
+        assert!(first.unwrap());
+        assert!(!second.unwrap(), "nothing to write the second time");
+        assert_eq!(command.unwrap(), r#""C:\Jacnex Studio\apps\filmcraft\filmcraft.exe" "%1""#);
+        for t in types {
+            assert_eq!(t.unwrap(), PROG_ID);
+        }
+    }
+}
