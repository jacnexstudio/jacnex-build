diff --git a/crates/format/src/lib.rs b/crates/format/src/lib.rs
index 289b165..e18bddf 100644
--- a/crates/format/src/lib.rs
+++ b/crates/format/src/lib.rs
@@ -69,6 +69,33 @@ pub const MIGRATIONS: &[Migration] = &[
 /// The schema version this build writes (and the newest it reads).
 pub const SCHEMA_VERSION: u32 = MIGRATIONS.len() as u32 + 1;
 
+/// Jacnex: the extension Filmnex saves projects with (`.fnproj`).
+pub const PROJECT_EXT: &str = "fnproj";
+/// Jacnex: the extension of projects saved before `.fnproj` (`.fcproj`). They still open, and
+/// Save keeps writing an open one to its own file.
+pub const OLD_PROJECT_EXT: &str = "fcproj";
+/// Jacnex: the project extensions Filmnex opens, the one it saves first.
+pub const PROJECT_EXTS: [&str; 2] = [PROJECT_EXT, OLD_PROJECT_EXT];
+
+/// Jacnex: whether `ext` (without the dot, any case) is a project's extension.
+pub fn is_project_ext(ext: &str) -> bool {
+    PROJECT_EXTS.iter().any(|e| e.eq_ignore_ascii_case(ext))
+}
+
+/// Jacnex: whether the file at `path` is a project (by its extension, any case).
+pub fn is_project_path(path: &str) -> bool {
+    std::path::Path::new(path).extension().and_then(|e| e.to_str()).is_some_and(is_project_ext)
+}
+
+/// Jacnex: `name` without its project extension (`.fnproj` or `.fcproj`, any case), and that
+/// extension (`None` when it has neither).
+pub fn split_project_ext(name: &str) -> (&str, Option<&str>) {
+    match name.rsplit_once('.') {
+        Some((stem, ext)) if is_project_ext(ext) => (stem, Some(ext)),
+        _ => (name, None),
+    }
+}
+
 /// Oldest schema this build can still upgrade.
 pub const OLDEST_SCHEMA: u32 = 1;
 
