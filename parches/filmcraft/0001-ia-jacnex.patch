+// --- Con IA -------------------------------------------------------------------------------------
+
+/// El texto con tiempos que se manda a la IA: una línea «[12.4] lo que se dice» cada unas 25 palabras, 8 segundos
+/// o fin de frase, hasta `tope` letras.
+fn texto_con_tiempos(t: &Transcript, tope: usize) -> String {
+    let mut salida = String::new();
+    let mut letras = 0usize;
+    let mut linea = String::new();
+    let (mut desde, mut n) = (0.0f64, 0usize);
+    let cerrar = |linea: &mut String, desde: f64, salida: &mut String, letras: &mut usize| -> bool {
+        if linea.is_empty() {
+            return true;
+        }
+        let l = format!("[{desde:.1}] {linea}\n");
+        let n = l.chars().count();
+        linea.clear();
+        if *letras + n > tope {
+            return false;
+        }
+        *letras += n;
+        salida.push_str(&l);
+        true
+    };
+    for w in t.words.iter().take(MAX_PALABRAS) {
+        let (ini, fin) = (w.start.seconds(), w.end.seconds());
+        let palabra = w.text.trim();
+        if palabra.is_empty() || !ini.is_finite() || !fin.is_finite() {
+            continue;
+        }
+        if linea.is_empty() {
+            desde = ini.max(0.0);
+            n = 0;
+        } else {
+            linea.push(' ');
+        }
+        linea.push_str(palabra);
+        n += 1;
+        if (n >= 25 || fin - desde >= 8.0 || palabra.ends_with(['.', '?', '!'])) && !cerrar(&mut linea, desde, &mut salida, &mut letras) {
+            return salida;
+        }
+    }
+    cerrar(&mut linea, desde, &mut salida, &mut letras);
+    salida
+}
+
+/// Reúne el texto y las hojas de un archivo (hilo aparte) y calcula lo que costaría.
+fn preparar(app: &mut FilmcraftApp) {
+    if let Some(f) = falta(app) {
+        app.jacnex_ia.buscar.aviso = Some((false, f.into()));
+        return;
+    }
+    let (Some(item), Some(q)) = (archivo_ia(app), app.jacnex_ia.busqueda_nube().cloned()) else { return };
+    let Some(it) = app.session.project.item(item) else { return };
+    let ItemKind::Media(m) = &it.kind else { return };
+    let nombre: String = it.name.chars().take(80).collect();
+    let segundos = m.duration().seconds();
+    if !segundos.is_finite() || segundos <= 0.0 {
+        app.jacnex_ia.buscar.aviso = Some((false, "Ese archivo no tiene duración.".into()));
+        return;
+    }
+    if segundos > q.max_segundos {
+        app.jacnex_ia.buscar.aviso = Some((false, format!("Ese archivo dura más de lo que acepta la búsqueda con IA ({:.0} min).", q.max_segundos / 60.0)));
+        return;
+    }
+    let con_imagen = m.info.has_video();
+    let transcripcion = app.session.project.transcripts.get(&item).cloned();
+    let Some(fuente) = app.session.source(item) else {
+        app.jacnex_ia.buscar.aviso = Some((false, "No se pudo abrir el archivo.".into()));
+        return;
+    };
+    if transcripcion.is_none() && !con_imagen {
+        app.jacnex_ia.buscar.aviso = Some((false, "Ese archivo no tiene imagen ni transcripción: transcríbelo antes en Editar › Por texto.".into()));
+        return;
+    }
+    let sin_texto = transcripcion.is_none();
+    empezar(app, true, "Preparando el material…", move |_, parar| {
+        let contexto = transcripcion.as_ref().map_or_else(String::new, |t| texto_con_tiempos(t, q.max_caracteres));
+        let mut hojas = Vec::new();
+        if con_imagen {
+            match search_sheets::contact_sheets(&fuente, segundos, q.max_hojas.min(search_sheets::MAX_SHEETS), &mut || !parar.load(Ordering::Relaxed)) {
+                Ok(h) => {
+                    hojas = h.into_iter().enumerate().map(|(i, s)| (format!("hoja-{}.jpg", i + 1), s.jpeg)).collect();
+                }
+                Err(e) => return Mensaje::Hecho(Err(motivo(&e.to_string()))),
+            }
+        }
+        if hojas.iter().map(|(_, b)| b.len()).sum::<usize>() > q.max_megas.saturating_mul(1024 * 1024) {
+            return Mensaje::Hecho(Err("Las imágenes pesan demasiado para enviarlas.".into()));
+        }
+        if contexto.is_empty() && hojas.is_empty() {
+            return Mensaje::Hecho(Err("No hay nada que enviar: el archivo no tiene voz transcrita ni imagen.".into()));
+        }
+        let letras = contexto.chars().count();
+        let _ = sin_texto;
+        Mensaje::Preparado(Material { item, nombre, segundos, contexto, letras, hojas })
+    });
+}
+
+/// Lee la respuesta de la IA: hasta 10 momentos dentro del archivo.
+fn leer_momentos(v: &Value, item: ItemId, segundos: f64) -> Vec<Hit> {
+    let Some(lista) = v.get("momentos").and_then(Value::as_array) else { return Vec::new() };
+    let mut out = Vec::new();
+    for (i, m) in lista.iter().take(MAX_MOMENTOS).enumerate() {
+        let (Some(ini), Some(fin)) = (m.get("inicio").and_then(Value::as_f64), m.get("fin").and_then(Value::as_f64)) else { continue };
+        if !ini.is_finite() || !fin.is_finite() || ini < 0.0 || ini > segundos {
+            continue;
+        }
+        let fin = fin.max(ini).min(segundos);
+        let imagen = m.get("fuente").and_then(Value::as_str) == Some("imagen");
+        let motivo: String = m.get("motivo").and_then(Value::as_str).unwrap_or("").chars().take(MAX_MOTIVO).collect();
+        #[allow(clippy::cast_possible_truncation)]
+        out.push(Hit {
+            id: item.0,
+            start: ini as f32,
+            end: fin as f32,
+            score: 1.0 - i as f32 * 0.05,
+            words: !imagen,
+            meaning: false,
+            image: imagen,
+            quote: motivo,
+            best: ini as f32,
+        });
+    }
+    out
+}
+
+fn enviar(app: &mut FilmcraftApp) {
+    let Some(m) = app.jacnex_ia.buscar.material.take() else { return };
+    app.jacnex_ia.mirar_sesion();
+    let Some(conexion) = crate::jacnex_ia::conexion(&app.jacnex_ia) else {
+        app.jacnex_ia.buscar.aviso = Some((false, "Inicia sesión en Jacnex Studio para buscar con IA.".into()));
+        return;
+    };
+    let consulta: String = app.jacnex_ia.buscar.consulta.trim().chars().take(MAX_CONSULTA).collect();
+    let Some(fuente) = app.session.source(m.item) else { return };
+    let ve = fuente.info().video.is_some();
+    empezar(app, true, "Buscando con IA…", move |tx, parar| {
+        let _ = tx.send(Mensaje::Progreso(SearchProgress::Loading));
+        let r = crate::jacnex_ia::buscar_en_la_nube(&conexion, &consulta, &m.contexto, m.segundos, &m.hojas, &mut |_| !parar.load(Ordering::Relaxed));
+        let v = match r {
+            Ok(v) => v,
+            Err(e) => return Mensaje::Hecho(Err(motivo(&e))),
+        };
+        let hits = leer_momentos(&v, m.item, m.segundos);
+        let sources: Sources = vec![(m.item, fuente, ve)];
+        let filas = hits
+            .into_iter()
+            .enumerate()
+            .map(|(i, hit)| {
+                let miniatura = if i < MAX_MINIATURAS { search::thumbnail(&sources, &hit, ANCHO_MINIATURA) } else { None };
+                let razon = if hit.quote.trim().is_empty() { (if hit.image { "imagen" } else { "lo que se dice" }).to_string() } else { hit.quote.clone() };
+                Fila { hit, nombre: m.nombre.clone(), razon, miniatura }
+            })
+            .collect();
+        Mensaje::Hecho(Ok(Salida {
+            filas,
+            modelos: None,
+            transcripciones: None,
+            notas: Vec::new(),
+            consulta,
+            cobrado: v.get("creditos").and_then(Value::as_i64),
+        }))
+    });
+}
+
+/// Recibe el avance y, al terminar, muestra los resultados.
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.buscar.trabajo.as_mut() else { return };
+    let mut fin = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Mensaje::Progreso(p)) => t.progreso = Some(p),
+            Ok(m) => {
+                fin = Some(m);
+                break;
+            }
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin = Some(Mensaje::Hecho(Err("la búsqueda se interrumpió".into())));
+                break;
+            }
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(100));
+        return;
+    };
+    if esperar && matches!(&fin, Mensaje::Hecho(Ok(s)) if s.transcripciones.is_some()) {
+        // con un diálogo abierto no se toca el proyecto: se vuelve a intentar luego
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(fin);
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    let (ia, parado) = (t.ia, t.parar.load(Ordering::Relaxed));
+    app.jacnex_ia.buscar.trabajo = None;
+    ctx.request_repaint();
+    match fin {
+        Mensaje::Progreso(_) => {}
+        Mensaje::Preparado(m) => app.jacnex_ia.buscar.material = Some(m),
+        Mensaje::Hecho(Err(e)) => {
+            let e = if parado && !e.starts_with("Búsqueda detenida") { "Búsqueda detenida.".to_string() } else { e };
+            app.jacnex_ia.buscar.aviso = Some((false, e));
+        }
+        Mensaje::Hecho(Ok(s)) => terminar(app, ctx, s, ia),
+    }
+}
+
+fn terminar(app: &mut FilmcraftApp, ctx: &egui::Context, s: Salida, ia: bool) {
+    let mut notas = s.notas;
+    if let Some(r) = s.transcripciones
+        && let Err(e) = speech_job::apply_transcripts(&mut app.session, r)
+    {
+        notas.push(format!("no se pudo guardar la transcripción: {e}"));
+    }
+    if ia {
+        // lo cobrado (o devuelto) se ve en el saldo
+        app.jacnex_ia.refrescar();
+    }
+    let b = &mut app.jacnex_ia.buscar;
+    if let Some(m) = s.modelos {
+        b.modelos = m;
+    }
+    b.resultados = s
+        .filas
+        .into_iter()
+        .enumerate()
+        .map(|(i, f)| {
+            let textura = f.miniatura.and_then(|m| {
+                (m.width > 0 && m.rgba.len() == m.width.saturating_mul(m.height).saturating_mul(4)).then(|| {
+                    ctx.load_texture(
+                        format!("jacnex-buscar-{i}"),
+                        egui::ColorImage::from_rgba_unmultiplied([m.width, m.height], &m.rgba),
+                        egui::TextureOptions::LINEAR,
+                    )
+                })
+            });
+            Resultado { hit: f.hit, nombre: f.nombre, razon: f.razon, textura }
+        })
+        .collect();
+    b.de = s.consulta.clone();
+    let n = b.resultados.len();
+    let mut texto =
+        if n == 0 { format!("No se encontró nada para «{}».", s.consulta.chars().take(60).collect::<String>()) } else { format!("{}.", plural(n)) };
+    if let Some(c) = s.cobrado {
+        texto.push_str(&format!(" Se cobró {}.", creditos(c)));
+    }
+    if !notas.is_empty() {
+        texto.push_str(&format!(" Aviso: {}.", notas.join("; ")));
+    }
+    b.aviso = Some((n > 0 || ia, texto));
+}
+
+// --- Ver y agregar ------------------------------------------------------------------------------
+
+/// Abre el resultado `i` en el visor de origen con su tramo marcado y, si se pide, lo agrega a la secuencia.
+fn ir(app: &mut FilmcraftApp, i: usize, agregar: bool) {
+    let Some(r) = app.jacnex_ia.buscar.resultados.get(i) else { return };
+    let (a, z) = search::hit_range(&r.hit);
+    let z = if z.0 <= a.0 { filmcraft_time::Tick(a.0.saturating_add(filmcraft_time::Tick::from_seconds_f64(1.0).0)) } else { z };
+    let item = r.hit.id;
+    let paso = |app: &mut FilmcraftApp| -> Result<(), String> {
+        let s = &mut app.session;
+        s.execute("source.open", json!({"item": item})).map_err(|e| e.to_string())?;
+        s.execute("project.setMarks", json!({"item": item, "in": a.0, "out": z.0})).map_err(|e| e.to_string())?;
+        s.execute("source.setPlayhead", json!({"time": a.0})).map_err(|e| e.to_string())?;
+        Ok(())
+    };
+    if let Err(e) = paso(app) {
+        app.jacnex_ia.buscar.aviso = Some((false, format!("No se pudo abrir el clip: {e}")));
+        return;
+    }
+    app.show_panel(crate::dock::PanelKind::Source);
+    if agregar {
+        match app.session.execute("source.insert", json!({})) {
+            Ok(_) => app.jacnex_ia.buscar.aviso = Some((true, "Listo: el tramo está en la secuencia.".into())),
+            Err(e) => app.jacnex_ia.buscar.aviso = Some((false, format!("No se pudo agregar a la secuencia: {e}"))),
+        }
+    }
+}
