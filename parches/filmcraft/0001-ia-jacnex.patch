diff --git a/crates/engine/src/short_edit.rs b/crates/engine/src/short_edit.rs
new file mode 100644
index 0000000..46fbedf
--- /dev/null
+++ b/crates/engine/src/short_edit.rs
@@ -0,0 +1,438 @@
+//! Jacnex: «Versión corta», lo que no es de la interfaz. Con la transcripción de la secuencia se
+//! arma el texto con tiempos que lee la IA ([`sentences`], [`transcript_text`]); la respuesta de la
+//! IA se trata como entrada hostil ([`parse_reply`]: se acota, se ordena, se pega a las frases y se
+//! exige la duración pedida); y [`apply`] crea una secuencia NUEVA «<nombre> (corta)» con solo esos
+//! tramos, en un solo paso de deshacer. La original no se toca.
+
+use std::sync::Arc;
+
+use filmcraft_edit::transcript::{SeqWord, merge_ranges, ripple_delete_ranges};
+use filmcraft_edit::{EditCtx, razor, remove_orphan_transitions, shift_track_from};
+use filmcraft_project::{ItemId, ItemKind, Sequence, TrackId};
+use filmcraft_time::{FrameRate, Tick, TimeRange};
+use serde_json::{Value, json};
+
+use crate::{EngineError, Result, Session};
+
+/// La versión corta puede durar desde esta parte de lo pedido…
+pub const MIN_RATIO: f64 = 0.5;
+/// …hasta esta parte (más [`EXTRA`] segundos). Son los mismos límites que valida el servidor.
+pub const MAX_RATIO: f64 = 1.15;
+pub const EXTRA: f64 = 1.0;
+/// Tramos que se aceptan como mucho.
+pub const MAX_RANGES: usize = 30;
+/// Tramos de la respuesta que se revisan como mucho.
+const REVIEW: usize = 60;
+/// Un tramo más corto que esto (en segundos) se descarta, salvo que sea el único.
+const MIN_RANGE: f64 = 1.0;
+/// Margen (s) con el que el inicio y el fin que da la IA se pegan a una frase.
+const SLACK: f64 = 0.2;
+/// Palabras de la transcripción que se leen como mucho.
+const MAX_WORDS: usize = 400_000;
+/// Una frase se corta por una pausa de esta duración (s), por tener estas palabras o esta duración.
+const PAUSE: f64 = 0.7;
+const MAX_SENTENCE_WORDS: usize = 30;
+const MAX_SENTENCE_SECS: f64 = 15.0;
+/// Lo más largo del título, en letras.
+const MAX_TITLE: usize = 80;
+/// Lo más largo que puede durar el gancho, en segundos.
+pub const MAX_HOOK: f64 = 12.0;
+/// Con menos palabras que estas no hay de qué sacar una versión corta.
+pub const MIN_WORDS: usize = 10;
+
+/// Una frase de la transcripción, en tiempo de la secuencia.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Sentence {
+    pub start: Tick,
+    pub end: Tick,
+    pub text: String,
+}
+
+impl Sentence {
+    fn secs(&self) -> (f64, f64) {
+        (self.start.seconds(), self.end.seconds())
+    }
+}
+
+fn ends_sentence(text: &str) -> bool {
+    let t = text.trim_end().trim_end_matches(['"', '\'', '»', ')']);
+    t.ends_with(['.', '?', '!']) && !t.ends_with("...")
+}
+
+/// Las frases de `words` (ya en orden de tiempo): se cierran con un punto, una pausa larga o al
+/// pasar de 30 palabras o 15 s.
+pub fn sentences(words: &[SeqWord]) -> Vec<Sentence> {
+    let mut out: Vec<Sentence> = Vec::new();
+    // (inicio, fin, texto, palabras)
+    let mut cur: Option<(Tick, Tick, String, usize)> = None;
+    for w in words.iter().take(MAX_WORDS) {
+        let text = w.text.trim();
+        if text.is_empty() || w.end < w.start {
+            continue;
+        }
+        let split_before = cur
+            .as_ref()
+            .is_some_and(|(s, e, _, n)| (w.start - *e).seconds() >= PAUSE || *n >= MAX_SENTENCE_WORDS || (w.end - *s).seconds() >= MAX_SENTENCE_SECS);
+        if split_before && let Some((s, e, t, _)) = cur.take() {
+            out.push(Sentence { start: s, end: e, text: t });
+        }
+        match cur.as_mut() {
+            Some((_, e, t, n)) => {
+                t.push(' ');
+                t.push_str(text);
+                *e = (*e).max(w.end);
+                *n += 1;
+            }
+            None => cur = Some((w.start, w.end, text.to_string(), 1)),
+        }
+        if ends_sentence(text)
+            && let Some((s, e, t, _)) = cur.take()
+        {
+            out.push(Sentence { start: s, end: e, text: t });
+        }
+    }
+    if let Some((s, e, t, _)) = cur {
+        out.push(Sentence { start: s, end: e, text: t });
+    }
+    out
+}
+
+/// Segundos de voz que hay en `sentences` (lo que dura cada frase, sin las pausas).
+pub fn speech_seconds(sentences: &[Sentence]) -> f64 {
+    sentences.iter().map(|s| (s.end - s.start).seconds().max(0.0)).sum()
+}
+
+/// Si hay voz de sobra para armar una versión de `target` segundos: al menos [`MIN_WORDS`] palabras
+/// y voz para la parte más corta que se acepta ([`MIN_RATIO`]).
+pub fn enough_speech(sentences: &[Sentence], target: f64) -> bool {
+    let words: usize = sentences.iter().map(|s| s.text.split_whitespace().count()).sum();
+    words >= MIN_WORDS && speech_seconds(sentences) >= target * MIN_RATIO
+}
+
+/// El texto que lee la IA: una línea por frase, «[segundos] frase».
+pub fn transcript_text(sentences: &[Sentence]) -> String {
+    let mut out = String::new();
+    for s in sentences {
+        out.push_str(&format!("[{:.1}] {}\n", s.start.seconds().max(0.0), s.text));
+    }
+    out
+}
+
+/// Lo que se hará: los tramos que se conservan (en tiempo de la secuencia, sin solaparse y en orden)
+/// y, si lo hay, el gancho que va primero.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Plan {
+    /// La secuencia de la que sale y lo que duraba cuando se leyó (si cambia, no se aplica).
+    pub seq: ItemId,
+    pub seq_duration: Tick,
+    pub title: String,
+    /// Los tramos, en orden y sin solaparse (sin el gancho).
+    pub ranges: Vec<TimeRange>,
+    /// El gancho: un tramo aparte que va AL PRINCIPIO de la versión corta y no se repite en `ranges`.
+    pub hook: Option<TimeRange>,
+}
+
+/// La respuesta de la IA ya validada.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Parsed {
+    pub title: String,
+    pub ranges: Vec<TimeRange>,
+    pub hook: Option<TimeRange>,
+}
+
+impl Plan {
+    /// Lo que durará la versión corta, en segundos (con el gancho).
+    pub fn seconds(&self) -> f64 {
+        self.ranges.iter().chain(self.hook.iter()).map(|r| r.duration.seconds()).sum()
+    }
+}
+
+/// Lo menos y lo más que puede durar una versión de `target` segundos.
+pub fn limits(target: f64) -> (f64, f64) {
+    (target * MIN_RATIO, target * MAX_RATIO + EXTRA)
+}
+
+fn clean_title(v: &Value) -> String {
+    v.get("titulo").and_then(Value::as_str).unwrap_or("").chars().filter(|c| !c.is_control()).take(MAX_TITLE).collect::<String>().trim().to_string()
+}
+
+/// Lee la respuesta del servidor (`{titulo, tramos:[{inicio, fin}]}`) como entrada hostil: descarta
+/// lo que no sea un número dentro de la secuencia, ordena, pega cada tramo a las frases (el inicio
+/// a donde empieza la frase y el fin a donde termina), junta lo que se solapa y recorta desde el
+/// final hasta que cabe en lo pedido. Devuelve el título y los tramos en cuadros exactos.
+pub fn parse_reply(
+    v: &Value,
+    sentences: &[Sentence],
+    seq_duration: Tick,
+    rate: FrameRate,
+    target: f64,
+) -> std::result::Result<(String, Vec<TimeRange>), String> {
+    parse_reply_hook(v, sentences, seq_duration, rate, target, false).map(|p| (p.title, p.ranges))
+}
+
+/// Segundos que cubren las frases `r.0..=r.1`.
+fn span(sentences: &[Sentence], r: (usize, usize)) -> f64 {
+    (sentences[r.1].secs().1 - sentences[r.0].secs().0).max(0.0)
+}
+
+/// Las frases (primera, última) que cubre un tramo de la IA, o nada si no es un tramo válido.
+fn pick(sentences: &[Sentence], a: f64, b: f64, total_secs: f64) -> Option<(usize, usize)> {
+    if !a.is_finite() || !b.is_finite() || a < 0.0 || b <= a || a >= total_secs {
+        return None;
+    }
+    let b = b.min(total_secs);
+    let first = sentences.iter().position(|s| s.secs().1 > a + SLACK)?;
+    let last = sentences.iter().rposition(|s| s.secs().0 < b - SLACK)?;
+    (first <= last).then_some((first, last))
+}
+
+/// Un tramo de frases como rango de cuadros exactos dentro de la secuencia.
+fn to_range(sentences: &[Sentence], r: (usize, usize), seq_duration: Tick, rate: FrameRate) -> Option<TimeRange> {
+    let start = rate.snap(sentences[r.0].start.max(Tick::ZERO));
+    let e = sentences[r.1].end.min(seq_duration);
+    let mut end = rate.snap(e);
+    if end < e {
+        end += rate.frame_duration();
+    }
+    let end = end.min(seq_duration);
+    (end > start).then(|| TimeRange::from_bounds(start, end))
+}
+
+/// Lo que queda de `r` sin la parte de `cut` (hasta dos trozos).
+fn subtract(r: TimeRange, cut: TimeRange) -> Vec<TimeRange> {
+    if cut.end() <= r.start || cut.start >= r.end() {
+        return vec![r];
+    }
+    let mut out = Vec::new();
+    if cut.start > r.start {
+        out.push(TimeRange::from_bounds(r.start, cut.start));
+    }
+    if cut.end() < r.end() {
+        out.push(TimeRange::from_bounds(cut.end(), r.end()));
+    }
+    out
+}
+
+/// Como [`parse_reply`], y con `with_hook` lee también el `gancho` de la IA: UN tramo corto (de 1 s
+/// a [`MAX_HOOK`]) que va al principio y no se repite en los demás. Si el gancho no sirve se
+/// ignora (queda todo en orden cronológico). El gancho cuenta en la duración de la versión.
+pub fn parse_reply_hook(
+    v: &Value,
+    sentences: &[Sentence],
+    seq_duration: Tick,
+    rate: FrameRate,
+    target: f64,
+    with_hook: bool,
+) -> std::result::Result<Parsed, String> {
+    const BAD: &str = "La IA respondió algo que no se entiende; prueba de nuevo.";
+    if !target.is_finite() || target < 1.0 {
+        return Err("La duración pedida no es válida.".into());
+    }
+    if sentences.is_empty() {
+        return Err("No hay texto transcrito en la secuencia.".into());
+    }
+    let list = v.get("tramos").and_then(Value::as_array).ok_or(BAD)?;
+    let total_secs = seq_duration.seconds();
+    // índices de frases: (primera, última)
+    let mut hook_idx: Option<(usize, usize)> = None;
+    if with_hook
+        && let Some(g) = v.get("gancho")
+        && let (Some(a), Some(b)) = (g.get("inicio").and_then(Value::as_f64), g.get("fin").and_then(Value::as_f64))
+        && let Some((f, mut l)) = pick(sentences, a, b, total_secs)
+    {
+        // el gancho es corto: se quitan frases del final hasta que cabe
+        while l > f && span(sentences, (f, l)) > MAX_HOOK {
+            l -= 1;
+        }
+        let s = span(sentences, (f, l));
+        if (MIN_RANGE..=MAX_HOOK).contains(&s) {
+            hook_idx = Some((f, l));
+        }
+    }
+    let mut picks: Vec<(usize, usize)> = Vec::new();
+    for m in list.iter().take(REVIEW) {
+        let (Some(a), Some(b)) = (m.get("inicio").and_then(Value::as_f64), m.get("fin").and_then(Value::as_f64)) else { continue };
+        let Some((f, l)) = pick(sentences, a, b, total_secs) else { continue };
+        // lo del gancho no se repite: se le quita a cada tramo (puede partirlo en dos)
+        match hook_idx {
+            Some((hf, hl)) if f <= hl && l >= hf => {
+                if f < hf {
+                    picks.push((f, hf - 1));
+                }
+                if l > hl {
+                    picks.push((hl + 1, l));
+                }
+            }
+            _ => picks.push((f, l)),
+        }
+    }
+    picks.sort_unstable();
+    let mut merged: Vec<(usize, usize)> = Vec::new();
+    for p in picks {
+        match merged.last_mut() {
+            Some(l) if p.0 <= l.1 + 1 => l.1 = l.1.max(p.1),
+            _ => merged.push(p),
+        }
+    }
+    let span = |r: &(usize, usize)| span(sentences, *r);
+    if merged.len() + usize::from(hook_idx.is_some()) > 1 {
+        merged.retain(|r| span(r) >= MIN_RANGE);
+    }
+    merged.truncate(MAX_RANGES);
+    let (min, max) = limits(target);
+    let mut total: f64 = merged.iter().map(span).sum::<f64>() + hook_idx.map_or(0.0, |h| span(&h));
+    // lo que sobra se quita desde el final (el principio es el gancho)
+    while total > max {
+        let Some(last) = merged.last().copied() else { break };
+        if merged.len() > 1 && total - span(&last) >= min {
+            total -= span(&last);
+            merged.pop();
+        } else if last.1 > last.0 {
+            let shorter = (last.0, last.1 - 1);
+            total -= span(&last) - span(&shorter);
+            if let Some(l) = merged.last_mut() {
+                *l = shorter;
+            }
+        } else if merged.len() > 1 {
+            total -= span(&last);
+            merged.pop();
+        } else {
+            break;
+        }
+    }
+    let hook = hook_idx.and_then(|h| to_range(sentences, h, seq_duration, rate));
+    let mut ranges: Vec<TimeRange> = merged.into_iter().filter_map(|r| to_range(sentences, r, seq_duration, rate)).collect();
+    if let Some(h) = hook {
+        // al pegar a los cuadros, un tramo puede rozar el gancho por un cuadro: se le quita
+        ranges = ranges.into_iter().flat_map(|r| subtract(r, h)).collect();
+    }
+    let ranges = merge_ranges(ranges);
+    let secs: f64 = ranges.iter().chain(hook.iter()).map(|r| r.duration.seconds()).sum();
+    if ranges.is_empty() && hook.is_none() {
+        return Err(BAD.into());
+    }
+    if secs > max {
+        return Err("La IA propuso una versión más larga de lo pedido. Prueba otra duración o cambia la indicación.".into());
+    }
+    if secs < min {
+        return Err("La IA propuso una versión mucho más corta de lo pedido. Prueba otra duración o cambia la indicación.".into());
+    }
+    Ok(Parsed { title: clean_title(v), ranges, hook })
+}
+
+/// Lo que se quita: todo lo de `0..total` que no está en `keep` (ordenado y sin solapes).
+fn complement(keep: &[TimeRange], total: Tick) -> Vec<TimeRange> {
+    let mut out = Vec::new();
+    let mut at = Tick::ZERO;
+    for r in keep {
+        if r.start > at {
+            out.push(TimeRange::from_bounds(at, r.start));
+        }
+        at = at.max(r.end());
+    }
+    if total > at {
+        out.push(TimeRange::from_bounds(at, total));
+    }
+    out
+}
+
+/// Pone el gancho `h` al principio de todas las pistas: abre un hueco del largo del gancho, lo
+/// pasa ahí y deja su sitio de antes vacío (lo cierra después el borrado de lo que sobra). Todas
+/// las pistas deben estar sin bloquear.
+fn bring_hook_first(q: &mut Sequence, h: TimeRange, ctx: &mut EditCtx) {
+    let len = h.duration;
+    razor(q, &[], h.start, ctx);
+    razor(q, &[], h.end(), ctx);
+    for tr in q.all_tracks_mut() {
+        shift_track_from(tr, Tick::ZERO, len);
+    }
+    let (a, b) = (h.start + len, h.end() + len);
+    for tr in q.all_tracks_mut() {
+        for it in tr.items.iter_mut().filter(|i| i.start >= a && i.end() <= b) {
+            it.start -= a;
+        }
+        for t in tr.transitions.iter_mut().filter(|t| t.start >= a && t.start + t.duration <= b) {
+            t.start -= a;
+        }
+        tr.sort();
+        remove_orphan_transitions(tr);
+    }
+    for ct in q.caption_tracks.iter_mut().filter(|c| !c.locked && c.sync_lock) {
+        for c in &mut ct.captions {
+            c.start += len;
+            if c.start >= a && c.end() <= b {
+                c.start -= a;
+            }
+        }
+        ct.captions.sort_by_key(|c| c.start);
+    }
+}
+
+/// Crea la secuencia «<nombre> (corta)» con solo los tramos de `plan` y la abre, como un solo paso
+/// de deshacer. Todas las pistas se cortan por igual (imagen y sonido siguen juntos) aunque estén
+/// bloqueadas; la secuencia original no se toca.
+pub fn apply(s: &mut Session, plan: &Plan) -> Result<Value> {
+    let (src, dur) = (plan.seq, plan.seq_duration);
+    let keep = merge_ranges(plan.ranges.clone());
+    let hook = plan.hook.filter(|h| h.duration > Tick::ZERO);
+    if keep.is_empty() && hook.is_none() {
+        return Err(EngineError::Other("no hay tramos que conservar".into()));
+    }
+    if hook.is_some_and(|h| keep.iter().any(|r| r.overlaps(&h))) {
+        return Err(EngineError::Other("el gancho se repite en los tramos".into()));
+    }
+    let media = s.media.clone();
+    let to_keep = keep.clone();
+    let id = s.edit("Versión corta", move |p, st| {
+        const GONE: &str = "la secuencia ya no está en el proyecto";
+        let item = p.item(src).ok_or_else(|| EngineError::Other(GONE.into()))?;
+        let (name, label) = (item.name.clone(), item.label);
+        let ItemKind::Sequence(q) = &item.kind else { return Err(EngineError::Other(GONE.into())) };
+        let mut q = (**q).clone();
+        if q.duration() != dur {
+            return Err(EngineError::Other("la secuencia cambió mientras la IA trabajaba; vuelve a intentarlo".into()));
+        }
+        let snapshot = Arc::new(p.clone());
+        let snap = snapshot.clone();
+        let durations = move |id: ItemId| crate::media_duration(&snapshot, &media, id);
+        let starts = move |id: ItemId| crate::media_start(&snap, id);
+        let min = q.settings.frame_rate.frame_duration();
+        let locked: Vec<TrackId> = q.all_tracks().filter(|t| t.locked).map(|t| t.id).collect();
+        for t in q.all_tracks_mut() {
+            t.locked = false;
+        }
+        let mut next = p.next_id;
+        {
+            let mut ctx = EditCtx { next_id: &mut next, media_duration: &durations, media_start: &starts, min_duration: min };
+            match hook {
+                // el gancho pasa al principio y todo lo demás se corre lo que dura
+                Some(h) => {
+                    bring_hook_first(&mut q, h, &mut ctx);
+                    let shifted = to_keep.iter().map(|r| TimeRange::from_bounds(r.start + h.duration, r.end() + h.duration));
+                    let all: Vec<TimeRange> = std::iter::once(TimeRange::from_bounds(Tick::ZERO, h.duration)).chain(shifted).collect();
+                    ripple_delete_ranges(&mut q, complement(&all, dur + h.duration), &mut ctx);
+                }
+                None => {
+                    ripple_delete_ranges(&mut q, complement(&to_keep, dur), &mut ctx);
+                }
+            }
+        }
+        for t in q.all_tracks_mut() {
+            t.locked = locked.contains(&t.id);
+        }
+        p.next_id = next;
+        q.check().map_err(EngineError::Other)?;
+        let id = p.add_item(&format!("{name} (corta)"), label, ItemKind::Sequence(Arc::new(q)), None);
+        st.active_sequence = Some(id);
+        if !st.open_sequences.contains(&id) {
+            st.open_sequences.push(id);
+        }
+        Ok(id)
+    })?;
+    let seconds = s.project.item(id).and_then(|i| if let ItemKind::Sequence(q) = &i.kind { Some(q.duration().seconds()) } else { None }).unwrap_or(0.0);
+    Ok(json!({"sequence": id.0, "seconds": seconds, "ranges": keep.len() + usize::from(hook.is_some()), "title": plan.title, "hook": hook.is_some()}))
+}
