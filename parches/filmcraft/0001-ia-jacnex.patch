+// --- Hilos --------------------------------------------------------------------------------------
+
+/// Corre `f` en un hilo con `catch_unwind`: lo que dice `f` llega por `tx`; si se rompe, llega un error.
+fn en_hilo(tx: Sender<Mensaje>, f: impl FnOnce(&Sender<Mensaje>) -> Mensaje + Send + 'static) -> Result<(), String> {
+    std::thread::Builder::new()
+        .name("jacnex-buscar".into())
+        .spawn(move || {
+            let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| f(&tx)));
+            let _ = tx.send(r.unwrap_or_else(|_| Mensaje::Hecho(Err("error interno al buscar (ver el registro de fallos)".into()))));
+        })
+        .map(|_| ())
+        .map_err(|e| format!("No se pudo empezar a buscar: {e}"))
+}
+
+/// Un error del motor, en palabras del usuario.
+fn motivo(e: &str) -> String {
+    if e.contains(search::CANCELLED) || e.contains(crate::jacnex_nemotron::DETENIDO) || e.contains(speech_job::CANCELLED) {
+        "Búsqueda detenida.".into()
+    } else if e.contains("no media to search") {
+        "El proyecto no tiene material para buscar.".into()
+    } else {
+        format!("No se pudo buscar: {e}")
+    }
+}
+
+fn empezar(app: &mut FilmcraftApp, ia: bool, etapa: &'static str, f: impl FnOnce(&Sender<Mensaje>, &AtomicBool) -> Mensaje + Send + 'static) {
+    let parar = Arc::new(AtomicBool::new(false));
+    let (tx, rx) = std::sync::mpsc::channel();
+    let p2 = parar.clone();
+    match en_hilo(tx, move |tx| f(tx, &p2)) {
+        Ok(()) => {
+            app.jacnex_ia.buscar.trabajo = Some(Trabajo { rx, parar, progreso: None, etapa, inicio: Instant::now(), ia });
+            app.jacnex_ia.buscar.aviso = None;
+        }
+        Err(e) => app.jacnex_ia.buscar.aviso = Some((false, e)),
+    }
+}
+
+/// Atiende lo que pidió la ventana.
+pub fn atender(app: &mut FilmcraftApp) {
+    let Some(p) = app.jacnex_ia.buscar.pendiente.take() else { return };
+    match p {
+        Pedido::Buscar => buscar_local(app),
+        Pedido::Preparar => preparar(app),
+        Pedido::Enviar => enviar(app),
+        Pedido::Descartar => app.jacnex_ia.buscar.material = None,
+        Pedido::Detener => {
+            if let Some(t) = &app.jacnex_ia.buscar.trabajo {
+                t.parar.store(true, Ordering::Relaxed);
+            }
+        }
+        Pedido::Ver(i) => ir(app, i, false),
+        Pedido::Agregar(i) => ir(app, i, true),
+    }
+}
+
+/// Lo que se hace en el hilo de la búsqueda en esta computadora.
+fn correr_local(job: IndexJob, consulta: String, tx: &Sender<Mensaje>, parar: &AtomicBool) -> Result<Salida, String> {
+    let sources: Sources = job.sources();
+    let mut ultimo = Instant::now().checked_sub(Duration::from_secs(1)).unwrap_or_else(Instant::now);
+    let res = job
+        .run(&mut |p| {
+            if ultimo.elapsed() >= Duration::from_millis(50) {
+                ultimo = Instant::now();
+                let _ = tx.send(Mensaje::Progreso(p));
+            }
+            !parar.load(Ordering::Relaxed)
+        })
+        .map_err(|e| motivo(&e.to_string()))?;
+    let mut hits = res.searcher.query(&consulta, &res.media);
+    hits.truncate(MAX_RESULTADOS);
+    let mut filas = Vec::with_capacity(hits.len());
+    for (i, hit) in hits.into_iter().enumerate() {
+        if parar.load(Ordering::Relaxed) {
+            return Err(motivo(search::CANCELLED));
+        }
+        let nombre = res.media.iter().find(|m| m.item.0 == hit.id).map_or_else(String::new, |m| m.name.chars().take(80).collect());
+        let miniatura = if i < MAX_MINIATURAS { search::thumbnail(&sources, &hit, ANCHO_MINIATURA) } else { None };
+        filas.push(Fila { razon: razon(&hit), hit, nombre, miniatura });
+    }
+    Ok(Salida { filas, modelos: Some(res.searcher.models()), transcripciones: res.transcripts, notas: res.notes, consulta, cobrado: None })
+}
+
+fn buscar_local(app: &mut FilmcraftApp) {
+    buscar_con(app, search::cache_dir(), filmcraft_engine::transcript::jacnex_models_dir());
+}
+
+/// Busca en esta computadora guardando lo mirado en `cache` y con los modelos de `modelos`.
+fn buscar_con(app: &mut FilmcraftApp, cache: Option<std::path::PathBuf>, modelos: Option<std::path::PathBuf>) {
+    if let Some(f) = falta(app) {
+        app.jacnex_ia.buscar.aviso = Some((false, f.into()));
+        return;
+    }
+    let consulta: String = app.jacnex_ia.buscar.consulta.trim().chars().take(MAX_CONSULTA).collect();
+    let opciones = IndexOptions {
+        transcriber: None,
+        transcribe: crate::jacnex_edicion::hay_voz(app),
+        language: "es".into(),
+        whisper_model: crate::jacnex_edicion::WHISPER.into(),
+        cache,
+        models_dir: modelos,
+        models: app.jacnex_ia.buscar.modelos.clone(),
+    };
+    let job = match search::index_job(&app.session, opciones) {
+        Ok(j) => j,
+        Err(e) => {
+            app.jacnex_ia.buscar.aviso = Some((false, motivo(&e.to_string())));
+            return;
+        }
+    };
+    empezar(app, false, "Preparando…", move |tx, parar| Mensaje::Hecho(correr_local(job, consulta, tx, parar)));
+}
