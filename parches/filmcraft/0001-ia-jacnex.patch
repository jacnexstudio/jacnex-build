+//! Runs only when the models are installed in the Jacnex Studio models folder.
+#![cfg(feature = "models")]
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use filmcraft_search::index::dot;
+use filmcraft_search::models::{MeaningModel, Picture, PictureModel, PictureText};
+use std::path::PathBuf;
+use std::time::Instant;
+
+fn dir(id: &str) -> Option<PathBuf> {
+    let p = PathBuf::from(std::env::var_os("LOCALAPPDATA")?).join("Jacnex Studio").join("modelos").join(id);
+    p.join("model.safetensors").exists().then_some(p)
+}
+
+#[test]
+fn meaning_calibration() {
+    let Some(d) = dir("qwen3-embedding-0.6b") else { return };
+    let t = Instant::now();
+    let m = MeaningModel::load(&d).unwrap();
+    eprintln!("load meaning {:?}", t.elapsed());
+    let q = m.embed("cuando habla del precio", true).unwrap();
+    for s in [
+        "El costo de este producto es de cincuenta soles, es muy barato.",
+        "Cuánto cuesta y qué descuento tiene la oferta.",
+        "Ayer fuimos a la playa y nos bañamos en el mar.",
+        "El motor del carro hace un ruido extraño al arrancar.",
+        "Hola a todos, bienvenidos a mi canal.",
+    ] {
+        let t = Instant::now();
+        let v = m.embed(s, false).unwrap();
+        eprintln!("{:.3} {:?} {s}", dot(&q, &v), t.elapsed());
+    }
+}
+
+#[test]
+fn picture_calibration() {
+    let id = std::env::var("PIC_MODEL").unwrap_or("siglip2-base-patch16-256".into());
+    let Some(d) = dir(&id) else { return };
+    let t = Instant::now();
+    let pm = PictureModel::load(&d).unwrap();
+    let tx = PictureText::load(&d).unwrap();
+    eprintln!("load picture {:?}", t.elapsed());
+    let (w, h) = (1920usize, 1080usize);
+    // sky above sand: blue top, tan bottom
+    let mut rgba = vec![255u8; w * h * 4];
+    for y in 0..h {
+        for x in 0..w {
+            let o = (y * w + x) * 4;
+            let c = if y < h / 2 { [90, 160, 230] } else { [220, 200, 150] };
+            rgba[o..o + 3].copy_from_slice(&c);
+        }
+    }
+    let t = Instant::now();
+    let v = pm.embed(&[Picture { rgba: &rgba, width: w, height: h }]).unwrap();
+    eprintln!("1 frame (cold) {:?}", t.elapsed());
+    let t = Instant::now();
+    for _ in 0..3 {
+        pm.embed(&[Picture { rgba: &rgba, width: w, height: h }]).unwrap();
+    }
+    eprintln!("3 frames, one by one {:?}", t.elapsed());
+    let t = Instant::now();
+    let three = [Picture { rgba: &rgba, width: w, height: h }, Picture { rgba: &rgba, width: w, height: h }, Picture { rgba: &rgba, width: w, height: h }];
+    pm.embed(&three).unwrap();
+    eprintln!("3 frames, batch {:?}", t.elapsed());
+    let (s, b) = tx.logit();
+    for q in ["la playa", "a beach with sand and blue sky", "un perro", "a person talking to the camera", "un producto en una mesa"] {
+        let e = tx.embed(q).unwrap();
+        let c = dot(&e, &v[0]);
+        eprintln!("{:.3} p={:.3} {q}", c, 1.0 / (1.0 + (-(s * c + b)).exp()));
+    }
+}
