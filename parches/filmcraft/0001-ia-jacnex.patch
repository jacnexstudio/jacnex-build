+// --- Hilos -------------------------------------------------------------------------------------
+
+/// Atiende lo que pidió la ventana.
+pub fn atender(app: &mut FilmcraftApp) {
+    let Some(p) = app.jacnex_ia.doblaje.pendiente.take() else { return };
+    match p {
+        Pedido::Doblar => empezar(app),
+        Pedido::Detener => {
+            if let Some(t) = &app.jacnex_ia.doblaje.trabajo {
+                t.parar.store(true, Ordering::Relaxed);
+            }
+        }
+        Pedido::Transcribir => {
+            let e = &mut app.jacnex_ia;
+            e.doblaje.aviso = None;
+            e.edicion.aviso = None;
+            // Whisper solo conoce algunos idiomas: con otro, que lo detecte
+            let origen = e.doblaje_nube().map_or(AUTO, |n| e.doblaje.origen_en(n)).to_string();
+            e.edicion.idioma = if crate::jacnex_edicion::IDIOMAS.iter().any(|(c, _)| *c == origen) { origen } else { "auto".into() };
+            crate::jacnex_edicion::ejecutar(app, crate::jacnex_edicion::Despues::Nada, false);
+        }
+    }
+}
+
+/// Un error en palabras del usuario.
+fn motivo(e: &str) -> String {
+    if e.contains(crate::jacnex_nemotron::DETENIDO) { "Doblaje detenido. Se cobró solo lo que ya se había usado.".into() } else { e.to_string() }
+}
+
+/// Lo que el servidor dice de cada frase: (id, ruta de la voz). Solo se toman ids que se enviaron.
+pub fn leer_manifiesto(m: &Value, enviadas: &[u32]) -> Vec<(u32, String)> {
+    let mut vistos: Vec<u32> = Vec::new();
+    let mut out = Vec::new();
+    if m.get("version").and_then(Value::as_u64) != Some(1) {
+        return out;
+    }
+    for f in m.get("frases").and_then(Value::as_array).into_iter().flatten().take(dub::MAX_PHRASES * 2) {
+        let Some(id) = f.get("id").and_then(Value::as_u64).and_then(|i| u32::try_from(i).ok()) else { continue };
+        let Some(ruta) = f.get("archivo").and_then(Value::as_str).filter(|r| doblaje_red::ruta_valida(r)) else { continue };
+        if enviadas.contains(&id) && !vistos.contains(&id) && out.len() < dub::MAX_PHRASES {
+            vistos.push(id);
+            out.push((id, ruta.to_string()));
+        }
+    }
+    out
+}
+
+fn empezar(app: &mut FilmcraftApp) {
+    app.jacnex_ia.mirar_sesion();
+    if let Some(f) = falta(app) {
+        app.jacnex_ia.doblaje.aviso = Some((false, f.into()));
+        return;
+    }
+    let (Some(conexion), Some(n)) = (crate::jacnex_ia::conexion(&app.jacnex_ia), app.jacnex_ia.doblaje_nube().cloned()) else {
+        app.jacnex_ia.doblaje.aviso = Some((false, "Inicia sesión en Jacnex Studio para doblar.".into()));
+        return;
+    };
+    let Some(secuencia) = app.session.state.active_sequence else { return };
+    let tr = tramo(app);
+    if tr.frases.is_empty() {
+        app.jacnex_ia.doblaje.aviso = Some((false, "No hay voz transcrita para doblar.".into()));
+        return;
+    }
+    if tr.frases.len() > n.max_frases || tr.letras > n.max_letras || tr.segundos > n.max_segundos.min(dub::MAX_SEPARATE_SECONDS) {
+        app.jacnex_ia.doblaje.aviso = Some((false, "Es demasiado para un solo doblaje: selecciona un tramo más corto.".into()));
+        return;
+    }
+    let d = &app.jacnex_ia.doblaje;
+    let pedido = doblaje_red::Pedido {
+        frases: json!(tr.frases.iter().map(|f| json!({"id": f.id, "inicio": f.inicio, "fin": f.fin, "texto": f.texto})).collect::<Vec<_>>()).to_string(),
+        destino: d.destino_en(&n).to_string(),
+        origen: d.origen_en(&n).to_string(),
+        voz: d.voz_en(&n).to_string(),
+    };
+    let sep = d.sep();
+    let captura = match dub::capture(&app.session, secuencia, &tr.clips, tr.inicio, tr.segundos) {
+        Ok(c) => c,
+        Err(e) => {
+            app.jacnex_ia.doblaje.aviso = Some((false, format!("No se pudo preparar el audio original: {e}")));
+            return;
+        }
+    };
+    let parar = Arc::new(AtomicBool::new(false));
+    let (tx, rx) = std::sync::mpsc::channel();
+    let p2 = parar.clone();
+    let hilo = std::thread::Builder::new().name("jacnex-doblaje".into()).spawn(move || {
+        let tx2 = tx.clone();
+        let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || correr(&conexion, &pedido, tr, secuencia, (captura, sep), &tx2, &p2)));
+        let fin = r.unwrap_or_else(|_| Err("error interno al doblar (ver el registro de fallos)".into()));
+        let _ = tx.send(Mensaje::Hecho(fin));
+    });
+    let d = &mut app.jacnex_ia.doblaje;
+    match hilo {
+        Ok(_) => {
+            d.aviso = None;
+            d.trabajo = Some(Trabajo { rx, parar, etapa: Etapa::Enviando, inicio: Instant::now() });
+        }
+        Err(e) => d.aviso = Some((false, format!("No se pudo empezar a doblar: {e}"))),
+    }
+}
+
+const DETENIDO: &str = "Doblaje detenido. No se cobró nada.";
+
+/// Separa la voz original de la música y los efectos (en el equipo, sin créditos) y devuelve el fondo.
+/// Se hace ANTES de pedir nada al servidor: si se detiene o falla, no se cobra.
+fn separar(
+    captura: &dub::Capture,
+    sep: &dyn dub::Separator,
+    segundos: f64,
+    parar: &AtomicBool,
+    enviar: &dyn Fn(Etapa),
+) -> Result<(Vec<f32>, u32, u16), String> {
+    enviar(Etapa::Separando(0));
+    let pct = |p: f32| Etapa::Separando((p.clamp(0.0, 1.0) * 100.0) as u8);
+    let Some(mezcla) = captura.render(parar, &mut |p| enviar(pct(p * 0.2))) else {
+        return Err(DETENIDO.into());
+    };
+    let mut avance = |p: f32| enviar(pct(0.2 + p.clamp(0.0, 1.0) * 0.8));
+    let r = sep.separate(&mezcla, captura.rate, 2, parar, &mut avance);
+    drop(mezcla);
+    if parar.load(Ordering::Relaxed) {
+        return Err(DETENIDO.into());
+    }
+    let r = r.map_err(|e| format!("No se pudo separar la voz de la música: {e}. No se cobró nada."))?;
+    let dub::Stems { sample_rate, channels, voice, background } = r;
+    drop(voice);
+    let valido = (1..=2).contains(&channels)
+        && (8_000..=192_000).contains(&sample_rate)
+        && !background.is_empty()
+        && background.len() % usize::from(channels) == 0
+        && background.iter().all(|v| v.is_finite());
+    let dur = background.len() as f64 / (f64::from(sample_rate) * f64::from(channels.max(1)));
+    if !valido || (dur - segundos).abs() > 1.0 + segundos * 0.05 {
+        return Err("La separación de la voz dio un resultado que no sirve. No se cobró nada.".into());
+    }
+    Ok((background, sample_rate, channels))
+}
+
+/// Lo que se hace en el hilo: pedir el doblaje, bajar las voces y armar el audio.
+fn correr(
+    c: &crate::jacnex_ia::Conexion,
+    pedido: &doblaje_red::Pedido,
+    tr: Tramo,
+    secuencia: ItemId,
+    (captura, sep): (dub::Capture, &dyn dub::Separator),
+    tx: &Sender<Mensaje>,
+    parar: &AtomicBool,
+) -> Result<Salida, String> {
+    let enviar = |e: Etapa| {
+        let _ = tx.send(Mensaje::Etapa(e));
+    };
+    let fondo = separar(&captura, sep, tr.segundos, parar, &enviar)?;
+    drop(captura);
+    let hecho = doblaje_red::doblar(
+        c,
+        pedido,
+        &mut |a: Avance| {
+            enviar(match a.etapa.as_str() {
+                "voces" => Etapa::Voces { hechas: a.hechas, total: a.total },
+                "traduciendo" => Etapa::Traduciendo,
+                _ => Etapa::Enviando,
+            });
+        },
+        &mut || !parar.load(Ordering::Relaxed),
+    )
+    .map_err(|e| motivo(&e))?;
+    let ids: Vec<u32> = tr.frases.iter().map(|f| f.id).collect();
+    let voces = leer_manifiesto(&hecho.manifiesto, &ids);
+    if voces.is_empty() {
+        return Err("El doblaje llegó sin voces. Revisa tu saldo en Jacnex Studio.".into());
+    }
+    let total = voces.len();
+    let mut frases: Vec<Phrase> = Vec::new();
+    for (i, (id, ruta)) in voces.iter().enumerate() {
+        enviar(Etapa::Bajando { hechas: i, total });
+        let Some(f) = tr.frases.iter().find(|f| f.id == *id) else { continue };
+        // una voz que no llega o no se lee deja esa frase en silencio; el resto se coloca
+        let pcm = doblaje_red::bajar_voz(c, ruta).and_then(|b| dub::decode_voice(&format!("voz-{id}.mp3"), b).map_err(|e| e.to_string()));
+        if let Ok(pcm) = pcm {
+            frases.push(Phrase { start: f.inicio, end: f.fin, pcm });
+        }
+    }
+    if frases.is_empty() {
+        return Err("No se pudo leer ninguna de las voces del doblaje.".into());
+    }
+    enviar(Etapa::Armando);
+    let (muestras, ajuste) = dub::mix(&frases, tr.segundos);
+    Ok(Salida {
+        muestras,
+        creditos: hecho.creditos,
+        colocadas: ajuste.placed,
+        faltan: total.saturating_sub(frases.len()),
+        ajuste,
+        inicio: tr.inicio,
+        clips: tr.clips,
+        secuencia,
+        fondo: Some(fondo),
+        destino: pedido.destino.clone(),
+    })
+}
+
+/// Recibe el avance y, al terminar, crea la pista del doblaje.
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.doblaje.trabajo.as_mut() else { return };
+    let mut fin = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Mensaje::Etapa(e)) => t.etapa = e,
+            Ok(Mensaje::Hecho(r)) => {
+                fin = Some(r);
+                break;
+            }
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin = Some(Err("el doblaje se interrumpió".into()));
+                break;
+            }
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    };
+    if esperar {
+        // con un diálogo abierto no se toca el proyecto: se vuelve a intentar luego
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(Mensaje::Hecho(fin));
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    app.jacnex_ia.doblaje.trabajo = None;
+    // lo cobrado (o devuelto) se ve en el saldo
+    app.jacnex_ia.refrescar();
+    ctx.request_repaint();
+    app.jacnex_ia.doblaje.aviso = Some(match fin {
+        Ok(s) => poner(app, s),
+        Err(e) => (false, e),
+    });
+}
+
+fn plural(n: usize, uno: &str, varios: &str) -> String {
+    if n == 1 { format!("1 {uno}") } else { format!("{n} {varios}") }
+}
+
+/// Pone el doblaje en la secuencia para la que se pidió (aunque ya no sea la activa), con la música y
+/// los efectos en otra pista y el original en silencio: un solo paso de deshacer. Dice qué pasó.
+fn poner(app: &mut FilmcraftApp, s: Salida) -> (bool, String) {
+    let cobro = format!("Se cobró {}.", creditos(s.creditos));
+    let activa = app.session.state.active_sequence == Some(s.secuencia);
+    let fondo = s.fondo.as_ref().map(|(m, r, c)| dub::Background { samples: m, rate: *r, channels: *c });
+    let pedido = dub::Dub { at: s.inicio, samples: &s.muestras, background: fondo, sources: &s.clips, original: Original::Mute };
+    match dub::place(&mut app.session, s.secuencia, &pedido) {
+        Ok(p) => {
+            let idioma = IDIOMAS.iter().find(|(c, _)| *c == s.destino).map_or(s.destino.as_str(), |(_, n)| *n).to_lowercase();
+            let mut m = match p {
+                dub::Placed::Track(a) => {
+                    let mut m = format!("Listo: doblaje al {idioma} en la pista A{}", a.track + 1);
+                    if let Some(f) = a.background_track {
+                        m.push_str(&format!("; la música y los efectos en la A{}", f + 1));
+                    }
+                    m.push_str(". El audio original quedó en silencio.");
+                    if !activa {
+                        m.push_str(" Está en la secuencia donde lo pediste, que ya no es la abierta.");
+                    }
+                    m.push_str(" Ctrl+Z lo deshace todo.");
+                    m
+                }
+                dub::Placed::Bin(_) => {
+                    format!("La secuencia donde lo pediste ya no existe: el doblaje al {idioma} está en el panel Proyecto para que lo coloques.")
+                }
+            };
+            if s.faltan > 0 {
+                m.push_str(&format!(" {} sin voz.", plural(s.faltan, "frase quedó", "frases quedaron")));
+            }
+            if s.ajuste.sped_up > 0 {
+                m.push_str(&format!(" {} se aceleraron un poco para caber.", plural(s.ajuste.sped_up, "frase", "frases")));
+            }
+            if s.ajuste.trimmed > 0 {
+                m.push_str(&format!(" {} se cortaron al final.", plural(s.ajuste.trimmed, "frase", "frases")));
+            }
+            let _ = s.colocadas;
+            m.push(' ');
+            m.push_str(&cobro);
+            (true, m)
+        }
+        Err(e) => (false, format!("No se pudo crear la pista del doblaje: {e}. {cobro}")),
+    }
+}
+
+#[cfg(test)]
+#[path = "jacnex_doblaje_tests.rs"]
+mod tests;
diff --git a/crates/ui-egui/src/jacnex_doblaje_red.rs b/crates/ui-egui/src/jacnex_doblaje_red.rs
new file mode 100644
index 0000000..1d995f1
--- /dev/null
+++ b/crates/ui-egui/src/jacnex_doblaje_red.rs
@@ -0,0 +1,172 @@
+//! Jacnex: la red del doblaje (IA de Jacnex › Audio › Doblaje).
+//!
+//! Es un submódulo de `jacnex_ia` (usa su conexión y sus ayudas de red). Manda las frases con su
+//! tiempo al servidor, que las traduce y las lee con una voz natural; mientras tanto informa la
+//! etapa. «Detener» pide al servidor que pare (cobra solo lo ya usado) y espera a que lo confirme.
+//! Después se bajan las voces, una por frase. Todo lo que llega del servidor es dudoso.
+
+use serde_json::Value;
+
+use super::Conexion;
+
+/// Lo que se pide.
+#[derive(Clone, Debug)]
+pub struct Pedido {
+    /// El JSON `[{id, inicio, fin, texto}]`.
+    pub frases: String,
+    /// El idioma al que se dobla (`es`, `en`…).
+    pub destino: String,
+    /// El idioma que se habla (`auto` = que lo detecte el servidor).
+    pub origen: String,
+    /// La voz (vacío = la primera del servidor).
+    pub voz: String,
+}
+
+/// Lo que informa el servidor mientras trabaja.
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct Avance {
+    /// `traduciendo`, `voces`, `listo` o vacío.
+    pub etapa: String,
+    pub hechas: u32,
+    pub total: u32,
+}
+
+/// El doblaje listo en el servidor.
+#[derive(Clone, Debug)]
+pub struct Doblado {
+    /// `{version, idioma, voz, frases: [{id, inicio, fin, texto, archivo, velocidad}]}`.
+    pub manifiesto: Value,
+    /// Lo que se cobró, en créditos.
+    pub creditos: i64,
+}
+
+/// Lo más que pesa el manifiesto.
+const MAX_MANIFIESTO: u64 = 2 * 1024 * 1024;
+/// Cuánto se espera a que el servidor confirme que paró.
+#[cfg(not(target_arch = "wasm32"))]
+const ESPERA_PARAR: std::time::Duration = std::time::Duration::from_secs(90);
+
+fn id_valido(v: &Value) -> Option<String> {
+    v.get("id")
+        .and_then(Value::as_str)
+        .or_else(|| v.pointer("/ids/0").and_then(Value::as_str))
+        .filter(|id| !id.is_empty() && id.len() <= 128 && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'))
+        .map(str::to_string)
+}
+
+/// La ruta de una voz que el servidor anuncia: solo `/archivos/…` con letras, números y `-_.`.
+pub fn ruta_valida(ruta: &str) -> bool {
+    ruta.len() <= 200
+        && ruta.starts_with("/archivos/")
+        && !ruta.contains("..")
+        && !ruta.contains("//")
+        && ruta.chars().all(|c| c.is_ascii_alphanumeric() || matches!(c, '-' | '_' | '.' | '/'))
+}
+
+fn avance_de(v: &Value) -> Avance {
+    let n = |k: &str| v.pointer(&format!("/progreso/{k}")).and_then(Value::as_u64).map_or(0, |x| u32::try_from(x.min(100_000)).unwrap_or(0));
+    Avance { etapa: v.pointer("/progreso/etapa").and_then(Value::as_str).unwrap_or("").chars().take(20).collect(), hechas: n("hechas"), total: n("total") }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+mod nativo {
+    use std::time::{Duration, Instant};
+
+    use super::{Avance, Conexion, Doblado, ESPERA_PARAR, MAX_MANIFIESTO, Pedido, Value, avance_de, id_valido, ruta_valida};
+    use crate::jacnex_ia::red::{ESPERA, agente_para, descargar, json, multipart};
+
+    /// Manda el doblaje, espera a que esté listo (informando el avance) y devuelve su manifiesto.
+    /// `seguir` se consulta a menudo: si responde false se pide parar y se espera la confirmación.
+    pub fn doblar(c: &Conexion, p: &Pedido, avance: &mut dyn FnMut(Avance), seguir: &mut dyn FnMut() -> bool) -> Result<Doblado, String> {
+        let auth = format!("Bearer {}", c.llave);
+        let mut campos = vec![
+            ("model", "doblaje-ia".to_string()),
+            ("n", "1".to_string()),
+            ("segments", p.frases.clone()),
+            ("language", p.destino.chars().take(8).collect()),
+        ];
+        if p.origen != "auto" && !p.origen.is_empty() {
+            campos.push(("source", p.origen.chars().take(8).collect()));
+        }
+        if !p.voz.is_empty() {
+            campos.push(("voice", p.voz.chars().take(64).collect()));
+        }
+        let (tipo, cuerpo) = multipart(&campos, &[]);
+        let url = format!("{}/v1/jacnex/generar", c.servidor);
+        let v = json(agente_para(c, 120).post(&url).header("Authorization", &auth).header("Content-Type", &tipo).send(&cuerpo[..]))?;
+        let id = id_valido(&v).ok_or_else(|| "El servidor no devolvió el trabajo.".to_string())?;
+        let inicio = Instant::now();
+        let mut parada: Option<Instant> = None;
+        let mut fallos = 0u32;
+        loop {
+            // En pasos cortos para que «Detener» responda enseguida.
+            for _ in 0..4 {
+                std::thread::sleep(Duration::from_millis(250));
+                if parada.is_none() && !seguir() {
+                    let url = format!("{}/v1/jacnex/trabajo/{id}/cancelar", c.servidor);
+                    let _ = json(agente_para(c, 30).post(&url).header("Authorization", &auth).send_empty());
+                    parada = Some(Instant::now());
+                }
+            }
+            if parada.is_none() && inicio.elapsed() > ESPERA {
+                return Err("El doblaje tardó demasiado. Si no llega, tus créditos se devuelven solos.".into());
+            }
+            if parada.is_some_and(|t| t.elapsed() > ESPERA_PARAR) {
+                return Err(crate::jacnex_nemotron::DETENIDO.into());
+            }
+            let consulta = format!("{}/v1/jacnex/trabajo/{id}", c.servidor);
+            let v = match json(agente_para(c, 30).get(&consulta).header("Authorization", &auth).call()) {
+                Ok(v) => v,
+                Err(m) if m.starts_with("No se pudo conectar") && fallos < 1000 => {
+                    fallos += 1;
+                    continue;
+                }
+                Err(m) => return Err(m),
+            };
+            match v.get("estado").and_then(Value::as_str) {
+                Some("listo") => {
+                    let url = v
+                        .pointer("/resultados/0")
+                        .and_then(Value::as_str)
+                        .filter(|u| !u.is_empty())
+                        .ok_or("El doblaje llegó vacío. Tus créditos fueron devueltos.")?;
+                    let bytes = descargar(c, url, &auth, MAX_MANIFIESTO)?;
+                    let manifiesto: Value = serde_json::from_slice(&bytes).map_err(|_| "El doblaje llegó dañado.".to_string())?;
+                    #[allow(clippy::cast_possible_truncation)]
+                    let creditos = v.get("creditos").and_then(Value::as_f64).filter(|x| x.is_finite()).map_or(0, |x| x.ceil().clamp(0.0, 1e9) as i64);
+                    return Ok(Doblado { manifiesto, creditos });
+                }
+                Some("fallido") => {
+                    if parada.is_some() {
+                        return Err(crate::jacnex_nemotron::DETENIDO.into());
+                    }
+                    let m = v.get("error").and_then(Value::as_str).unwrap_or("No se pudo doblar.");
+                    return Err(format!("{m} Tus créditos fueron devueltos."));
+                }
+                _ => avance(avance_de(&v)),
+            }
+        }
+    }
+
+    /// Baja la voz de una frase (la ruta `/archivos/…` que dio el servidor).
+    pub fn bajar_voz(c: &Conexion, ruta: &str) -> Result<Vec<u8>, String> {
+        if !ruta_valida(ruta) {
+            return Err("El servidor dio una dirección de voz no válida.".into());
+        }
+        let auth = format!("Bearer {}", c.llave);
+        descargar(c, &format!("{}{ruta}", c.servidor), &auth, filmcraft_engine::dub::MAX_MP3_BYTES as u64)
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub use nativo::{bajar_voz, doblar};
+
+#[cfg(target_arch = "wasm32")]
+pub fn doblar(_: &Conexion, _: &Pedido, _: &mut dyn FnMut(Avance), _: &mut dyn FnMut() -> bool) -> Result<Doblado, String> {
+    Err("La IA está disponible en la app de escritorio.".into())
+}
+
+#[cfg(target_arch = "wasm32")]
+pub fn bajar_voz(_: &Conexion, _: &str) -> Result<Vec<u8>, String> {
+    Err("La IA está disponible en la app de escritorio.".into())
+}
