@@ -0,0 +1,113 @@
+//! Jacnex: "Pasar a vertical", the result. [`apply`] makes a NEW sequence (the original stays as
+//! it is) with the same edit at 1080 px wide in the chosen shape, and writes Motion Position (a
+//! key per camera move, held across cuts) and Scale on every clip the job analysed.
+
+use std::sync::Arc;
+
+use filmcraft_geom::Vec2;
+use filmcraft_project::{Interpolation, ItemKind, Keyframe, ParamValue, Sequence, find_effect};
+use filmcraft_reframe::plan::Aspect;
+use filmcraft_time::Tick;
+use serde_json::{Value, json};
+
+use crate::reframe_job::{ClipPlan, ReframeResult};
+use crate::{EngineError, Result, Session};
+
+/// Width of the new sequence; the height follows the shape.
+pub const OUT_WIDTH: u32 = 1080;
+
+/// The size of the new sequence for `a`.
+pub fn out_size(a: Aspect) -> (u32, u32) {
+    (OUT_WIDTH, (u64::from(OUT_WIDTH) * u64::from(a.h.max(1)) / u64::from(a.w.max(1))).clamp(2, 8192) as u32)
+}
+
+/// Writes the camera of `plan` into its clip of `q`.
+fn place(q: &mut Sequence, plan: &ClipPlan, aspect: Aspect) -> bool {
+    let (out_w, out_h) = out_size(aspect);
+    let (sw, sh) = (f64::from(plan.size.0.max(1)), f64::from(plan.size.1.max(1)));
+    let (_, ch) = aspect.crop(sw as f32, sh as f32);
+    let (ow, oh) = (f64::from(out_w), f64::from(out_h));
+    // pixels of the output per pixel of the source
+    let k = oh / (f64::from(ch) * sh);
+    let Some((_, it)) = q.find_item_mut(plan.clip) else { return false };
+    let base = if it.scale_to_frame { (ow / sw).min(oh / sh) } else { 1.0 };
+    let pos = |cx: f32, cy: f32| Vec2 { x: ow / 2.0 - k * (f64::from(cx) * sw - sw / 2.0), y: oh / 2.0 - k * (f64::from(cy) * sh - sh / 2.0) };
+    let (start, dur) = (it.start, it.duration);
+    let mut keys: Vec<(Tick, Interpolation, Vec2)> = Vec::new();
+    for (si, shot) in plan.shots.iter().enumerate() {
+        let last_shot = si + 1 == plan.shots.len();
+        for (ki, key) in shot.keys.iter().enumerate() {
+            let t = Tick::from_seconds_f64(key.t.max(0.0)).min(dur - Tick(1)).max(Tick::ZERO);
+            let last = ki + 1 == shot.keys.len();
+            // the last key of a shot holds until the first key of the next one: a cut, not a pan
+            let interp = if last && !last_shot { Interpolation::Hold } else { Interpolation::Linear };
+            keys.push((it.effect_time_at(start + t), interp, pos(key.cx, key.cy)));
+        }
+    }
+    keys.sort_by_key(|k| k.0);
+    keys.dedup_by_key(|k| k.0);
+    if it.effect("motion").is_none() {
+        it.effects.extend(find_effect("motion").map(|d| d.instance()));
+    }
+    let Some(m) = it.effect_mut("motion") else { return false };
+    m.enabled = true;
+    let Some(first) = keys.first().map(|k| k.2) else { return false };
+    if let Some(p) = m.param_mut("position") {
+        p.value = ParamValue::Vec2(first);
+        p.keyframes = if keys.len() > 1 {
+            keys.iter()
+                .map(|(t, i, v)| {
+                    let mut kf = Keyframe::new(*t, ParamValue::Vec2(*v));
+                    kf.interp = *i;
+                    kf
+                })
+                .collect()
+        } else {
+            Vec::new()
+        };
+    }
+    for (id, v) in [("scale", 100.0 * k / base), ("scale_width", 100.0 * k / base), ("rotation", 0.0)] {
+        if let Some(p) = m.param_mut(id) {
+            p.value = ParamValue::Float(v.clamp(0.0, 10_000.0));
+            p.keyframes.clear();
+        }
+    }
+    if let Some(p) = m.param_mut("anchor") {
+        p.value = ParamValue::Vec2(Vec2 { x: f64::NAN, y: f64::NAN });
+        p.keyframes.clear();
+    }
+    true
+}
+
+/// Makes the vertical sequence and opens it, as one undo step. Returns what was done.
+pub fn apply(s: &mut Session, r: ReframeResult) -> Result<Value> {
+    let (w, h) = out_size(r.aspect);
+    let src_id = r.seq;
+    let aspect = r.aspect;
+    let plans = r.plans;
+    let id = s.edit("Pasar a vertical", move |pr, st| {
+        let item = pr.item(src_id).ok_or_else(|| EngineError::Other("la secuencia ya no está en el proyecto".into()))?;
+        let (name, label) = (item.name.clone(), item.label);
+        let ItemKind::Sequence(q) = &item.kind else { return Err(EngineError::Other("la secuencia ya no está en el proyecto".into())) };
+        let mut q = (**q).clone();
+        q.settings.width = w;
+        q.settings.height = h;
+        q.settings.preset = format!("{w}x{h} {}", q.settings.frame_rate.label());
+        q.settings.validate().map_err(EngineError::Other)?;
+        let done = plans.iter().filter(|p| place(&mut q, p, aspect)).count();
+        if done == 0 {
+            return Err(EngineError::Other("no se pudo reencuadrar ningún clip".into()));
+        }
+        let id = pr.add_item(&format!("{name} ({}:{})", aspect.w, aspect.h), label, ItemKind::Sequence(Arc::new(q)), None);
+        st.active_sequence = Some(id);
+        if !st.open_sequences.contains(&id) {
+            st.open_sequences.push(id);
+        }
+        Ok(id)
+    })?;
+    Ok(json!({"sequence": id.0, "width": w, "height": h}))
+}
+
+#[cfg(test)]
+#[path = "reframe_apply_tests.rs"]
+mod tests;
