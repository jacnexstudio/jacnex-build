+
+    #[test]
+    fn mismatched_or_hostile_vectors_are_ignored() {
+        let mut v = VisualIndex::new("m", 2, 1.0, 5.0);
+        v.push(0.0, vec![1.0, 0.0]);
+        let qv = QueryVectors { image: Some(vec![1.0, 0.0, 0.0]), image_scale: 10.0, image_bias: 0.0, ..Default::default() };
+        assert!(search("x", &qv, &[MediaRef { id: 1, speech: None, visual: Some(&v) }]).is_empty());
+        let qv = QueryVectors { image: Some(vec![f32::NAN, 0.0]), image_scale: f32::INFINITY, image_bias: f32::NAN, ..Default::default() };
+        assert!(search("x", &qv, &[MediaRef { id: 1, speech: None, visual: Some(&v) }]).is_empty());
+    }
+}
