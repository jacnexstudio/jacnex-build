+/// Un modelo de video del servidor, con sus créditos por duración.
+#[derive(Clone, Debug)]
+struct ModeloInfo {
+    id: String,
+    nombre: String,
+    descripcion: String,
+    aspectos: Vec<String>,
+    duraciones: Vec<u32>,
+    /// Admite una imagen final (para las transiciones).
+    imagen_final: bool,
+    /// El sonido se elige; si no, el modelo lo genera siempre (y ya está en el precio).
+    sonido_opcional: bool,
+    /// Créditos por duración (s), sin sonido o con el sonido que el modelo genera siempre.
+    creditos: Vec<(u32, i64)>,
+    /// Créditos por duración con sonido, si el sonido es opcional.
+    con_sonido: Vec<(u32, i64)>,
+}
+
+impl ModeloInfo {
+    fn costo(&self, duracion: u32, sonido: bool) -> Option<i64> {
+        let lista = if sonido && self.sonido_opcional && !self.con_sonido.is_empty() { &self.con_sonido } else { &self.creditos };
+        lista.iter().find(|(d, _)| *d == duracion).map(|(_, c)| *c)
+    }
+}
+
+fn modelos_base() -> Vec<ModeloInfo> {
+    MODELOS_BASE
+        .iter()
+        .map(|(id, nombre, aspectos, duraciones, sonido, desc)| ModeloInfo {
+            id: (*id).into(),
+            nombre: (*nombre).into(),
+            descripcion: (*desc).into(),
+            aspectos: aspectos.split_whitespace().map(str::to_string).collect(),
+            duraciones: duraciones.split_whitespace().filter_map(|d| d.parse().ok()).collect(),
+            imagen_final: true,
+            sonido_opcional: *sonido,
+            creditos: Vec::new(),
+            con_sonido: Vec::new(),
+        })
+        .collect()
+}
