--- /dev/null
+++ b/crates/ui-egui/src/jacnex_corta.rs
@@ -0,0 +1,475 @@
+//! Jacnex: «Versión corta» (IA de Jacnex › Editar › Versión corta).
+//!
+//! De un video largo (una entrevista, un podcast, una charla) hace una versión de 15, 30, 60 o
+//! 90 s con lo mejor, empezando por un gancho y cortando siempre al final de una frase.
+//!
+//! Pasos:
+//! 1. Se transcribe lo que falte, con el motor que se elija en Ajustes ([`crate::jacnex_edicion`]).
+//! 2. Se arma el texto con tiempos de la secuencia y se muestra lo que cuesta como máximo. Nada
+//!    se envía sin que se pulse «Enviar».
+//! 3. Gemini, en el servidor de Jacnex, elige los tramos. La respuesta se vuelve a validar aquí
+//!    ([`filmcraft_engine::short_edit::parse_reply`]): se acota, se pega a las frases y se exige la
+//!    duración pedida.
+//! 4. Se crea una secuencia NUEVA «<nombre> (corta)» en un solo paso de deshacer; la original no se
+//!    toca. Se cobra lo que gastó la IA, nunca más de lo mostrado.
+//!
+//! La IA solo lee el texto (no ve la imagen): sirve para material con voz. El trabajo va en un hilo
+//! aparte: la ventana no se congela y «Detener» responde enseguida.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{Receiver, Sender, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::RichText;
+use filmcraft_engine::short_edit::{self, Plan, Sentence};
+use filmcraft_project::ItemId;
+use filmcraft_time::{FrameRate, Tick};
+use serde_json::Value;
+
+use crate::FilmcraftApp;
+use crate::jacnex_edicion::{Despues, Edicion};
+use crate::jacnex_ia::{ACENTO, ACENTO_CLARO, BusquedaNube, ROJO, VERDE, boton_acento, creditos, segmentos};
+
+/// Las duraciones que se ofrecen, en segundos.
+pub const OBJETIVOS: &[u32] = &[15, 30, 60, 90];
+/// La duración que se usa si no se eligió una válida.
+pub const OBJETIVO: u32 = 30;
+/// Lo más largo de la indicación, en letras (el servidor acepta 400).
+pub const MAX_INDICACION: usize = 300;
+/// La secuencia debe durar al menos esta parte más que la versión pedida (el servidor exige lo mismo).
+const HOLGURA: f64 = 1.2;
+const MB: u64 = 1024 * 1024;
+/// Lo que se dice cuando casi no hay voz.
+pub const SIN_VOZ: &str = "Este video casi no tiene voz: la versión corta se arma con lo que se dice.";
+
+/// Lo que la ventana pide hacer (se atiende después de dibujarla).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Pedido {
+    /// Transcribir lo que falte y calcular el costo (con la descarga del modelo de voz aceptada o no).
+    Preparar(bool),
+    /// Enviar lo preparado a la IA.
+    Enviar,
+    /// Dejar lo preparado.
+    Descartar,
+    /// Detener el trabajo en curso.
+    Detener,
+}
+
+/// Lo que se manda a la IA, ya calculado.
+struct Material {
+    seq: ItemId,
+    seq_duration: Tick,
+    rate: FrameRate,
+    frases: Vec<Sentence>,
+    texto: String,
+    letras: usize,
+    segundos: f64,
+    objetivo: u32,
+    gancho: bool,
+}
+
+struct Salida {
+    plan: Plan,
+    /// Créditos cobrados, si el servidor lo dijo.
+    cobrado: Option<i64>,
+}
+
+enum Mensaje {
+    Hecho(Result<Salida, String>),
+}
+
+struct Trabajo {
+    rx: Receiver<Mensaje>,
+    parar: Arc<AtomicBool>,
+    inicio: Instant,
+}
+
+/// Los ajustes de «Versión corta» y su trabajo en curso.
+#[derive(Default)]
+pub struct Corta {
+    /// La duración que se pide, en segundos (0 = [`OBJETIVO`]).
+    pub objetivo: u32,
+    /// Qué priorizar (opcional).
+    pub indicacion: String,
+    /// No empezar con un gancho (por defecto sí se empieza con uno).
+    pub sin_gancho: bool,
+    pendiente: Option<Pedido>,
+    trabajo: Option<Trabajo>,
+    material: Option<Material>,
+    /// El último aviso: (salió bien, texto).
+    pub aviso: Option<(bool, String)>,
+}
+
+impl Corta {
+    pub fn objetivo_actual(&self) -> u32 {
+        if OBJETIVOS.contains(&self.objetivo) { self.objetivo } else { OBJETIVO }
+    }
+
+    /// Se pide que la versión corta empiece con un gancho.
+    pub fn con_gancho(&self) -> bool {
+        !self.sin_gancho
+    }
+
+    /// Hay un envío a la IA en curso.
+    pub fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    /// Hay algo preparado que espera el «Enviar».
+    pub fn preparada(&self) -> bool {
+        self.material.is_some()
+    }
+
+    /// La indicación, recortada y sin saltos de línea de más.
+    pub fn indicacion_limpia(&self) -> String {
+        self.indicacion.split_whitespace().collect::<Vec<_>>().join(" ").chars().take(MAX_INDICACION).collect()
+    }
+}
+
+/// Lo que cuesta como máximo (se reserva y lo que sobra se devuelve) y lo normal, en créditos, para
+/// un texto de `letras` letras. La IA solo lee texto: no hay hojas de imágenes.
+pub(crate) fn precio(q: &BusquedaNube, letras: usize) -> (i64, f64) {
+    (q.reserva(letras, 0), q.esperado(letras, 0))
+}
+
+/// «2,4 créditos» (un decimal si hace falta).
+fn decimal(c: f64) -> String {
+    if !c.is_finite() {
+        return "?".into();
+    }
+    let x = (c * 10.0).round() / 10.0;
+    if (x - x.round()).abs() < 1e-9 { format!("{x:.0} créditos") } else { format!("{x:.1} créditos").replace('.', ",") }
+}
+
+/// Lo que la ventana necesita saber del proyecto y de la cuenta (se calcula antes de dibujarla).
+pub(crate) struct Datos {
+    nube: Option<BusquedaNube>,
+    saldo: Option<i64>,
+    falta: Option<&'static str>,
+    /// Lo que costaría transcribir con Nemotron lo que falta.
+    transcribir: Option<i64>,
+}
+
+pub(crate) fn datos(app: &FilmcraftApp) -> Datos {
+    Datos { nube: app.jacnex_ia.corta_nube().cloned(), saldo: app.jacnex_ia.saldo(), falta: falta(app), transcribir: crate::jacnex_edicion::costo_nube(app) }
+}
+
+/// Por qué no se puede preparar la versión corta ahora (o nada).
+pub fn falta(app: &FilmcraftApp) -> Option<&'static str> {
+    let e = &app.jacnex_ia;
+    if e.corta.ocupado() {
+        return Some("Espera a que termine la versión corta.");
+    }
+    if let Some(f) = crate::jacnex_edicion::falta(app, Despues::Corta) {
+        return Some(f);
+    }
+    if !e.hay_sesion() {
+        return Some("Inicia sesión en Jacnex Studio para usar la IA.");
+    }
+    let Some(q) = e.corta_nube() else { return Some("El servidor aún no ofrece la versión corta.") };
+    let segundos = app.session.active_sequence().map_or(0.0, |s| s.duration().seconds());
+    if segundos > q.max_segundos {
+        return Some("La secuencia es demasiado larga para la IA: prueba con una parte.");
+    }
+    if segundos < f64::from(e.corta.objetivo_actual()) * HOLGURA {
+        return Some("La secuencia dura poco para esa versión: elige una más corta.");
+    }
+    None
+}
+
+// --- Dibujo -------------------------------------------------------------------------------------
+
+/// Los ajustes: la duración, la indicación y lo de la transcripción.
+pub fn ajustes(ui: &mut egui::Ui, c: &mut Corta, ocupado: bool, t: &crate::theme::Tokens) {
+    ui.add_enabled_ui(!ocupado, |ui| {
+        ui.label(RichText::new("Duración de la versión corta").color(t.text_dim));
+        let nombres: Vec<String> = OBJETIVOS.iter().map(|s| format!("{s} s")).collect();
+        let elegida = OBJETIVOS.iter().position(|s| *s == c.objetivo_actual()).unwrap_or(1);
+        if let Some(i) = segmentos(ui, &nombres, elegida, t)
+            && let Some(s) = OBJETIVOS.get(i)
+        {
+            c.objetivo = *s;
+            c.material = None;
+        }
+        ui.add_space(6.0);
+        let mut gancho = c.con_gancho();
+        if ui
+            .checkbox(&mut gancho, "Empezar con un gancho")
+            .on_hover_text("La IA elige una frase fuerte (de 2 a 8 s) y la pone al principio; el resto sigue en orden.")
+            .changed()
+        {
+            c.sin_gancho = !gancho;
+            c.material = None;
+        }
+        ui.add_space(6.0);
+        ui.label(RichText::new("Indicaciones (opcional)").color(t.text_dim));
+        let antes = c.indicacion.len();
+        ui.add(
+            egui::TextEdit::multiline(&mut c.indicacion)
+                .hint_text("Ej.: lo que dice sobre el precio, con un tono alegre")
+                .desired_rows(2)
+                .char_limit(MAX_INDICACION)
+                .desired_width(f32::INFINITY),
+        );
+        if c.indicacion.len() != antes {
+            c.material = None;
+        }
+    });
+    ui.add_space(6.0);
+}
+
+/// El pie: avance, pregunta por la descarga, costo con «Enviar» o el botón de preparar.
+pub(crate) fn pie(ui: &mut egui::Ui, c: &mut Corta, ed: &mut Edicion, d: &Datos, t: &crate::theme::Tokens) {
+    let ancho = ui.available_width();
+    if let Some((texto, avance)) = ed.progreso() {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{texto}  {} s", ed.segundos())).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_height(6.0).fill(ACENTO));
+        }
+        if ui.small_button("Detener").clicked() {
+            ed.detener();
+        }
+    } else if let Some((bytes, Despues::Corta)) = ed.pide_descarga {
+        let mb = bytes.div_ceil(MB).max(1);
+        ui.label(RichText::new(format!("La primera vez se descarga el modelo de voz (unos {mb} MB).")).strong());
+        ui.add_space(4.0);
+        ui.horizontal(|ui| {
+            if boton_acento(ui, &format!("Descargar {mb} MB y seguir"), egui::vec2(ancho - 90.0, 32.0), true).clicked() {
+                c.pendiente = Some(Pedido::Preparar(true));
+            }
+            if ui.add(egui::Button::new("Cancelar").min_size(egui::vec2(82.0, 32.0))).clicked() {
+                ed.pide_descarga = None;
+            }
+        });
+    } else if let Some(tr) = &c.trabajo {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("La IA está eligiendo los mejores momentos…  {} s", tr.inicio.elapsed().as_secs())).strong());
+        });
+        ui.horizontal(|ui| {
+            ui.label(RichText::new("Suele tardar de unos segundos a un par de minutos.").small().color(t.text_dim));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.small_button("Detener").clicked() {
+                    c.pendiente = Some(Pedido::Detener);
+                }
+            });
+        });
+    } else if let (Some(m), Some(q)) = (&c.material, &d.nube) {
+        let (tope, normal) = precio(q, m.letras);
+        ui.label(RichText::new(format!("Versión de {} s a partir de {} s de video", m.objetivo, m.segundos.round())).strong());
+        ui.label(RichText::new(format!("Cuesta como máximo {} (lo normal: unos {}).", creditos(tope), decimal(normal))).small().strong().color(ACENTO_CLARO));
+        if let Some(s) = d.saldo {
+            let (texto, color) = if s >= tope {
+                (format!("Te quedan {} después.", creditos(s - tope)), t.text_dim)
+            } else {
+                (format!("Te faltan {}.", creditos(tope - s)), ROJO)
+            };
+            ui.label(RichText::new(texto).small().color(color));
+        }
+        ui.add_space(2.0);
+        ui.horizontal(|ui| {
+            let alcanza = d.saldo.is_none_or(|s| s >= tope);
+            if boton_acento(ui, &format!("Enviar · hasta {}", creditos(tope)), egui::vec2(ancho - 90.0, 34.0), alcanza).clicked() {
+                c.pendiente = Some(Pedido::Enviar);
+            }
+            if ui.add(egui::Button::new("Cancelar").min_size(egui::vec2(82.0, 34.0))).clicked() {
+                c.pendiente = Some(Pedido::Descartar);
+            }
+        });
+    } else {
+        if ed.en_nube()
+            && let Some(n) = d.transcribir
+        {
+            ui.label(RichText::new(format!("Transcribir cuesta {}.", creditos(n))).small().strong().color(ACENTO_CLARO));
+        }
+        ui.label(RichText::new("Antes de enviar verás cuánto cuesta la versión corta.").small().color(t.text_dim));
+        ui.add_space(2.0);
+        if boton_acento(ui, "Preparar la versión corta", egui::vec2(ancho, 36.0), d.falta.is_none()).clicked() {
+            c.pendiente = Some(Pedido::Preparar(false));
+        }
+        if let Some(f) = d.falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    for (ok, m) in [c.aviso.as_ref(), ed.aviso.as_ref()].into_iter().flatten() {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
+
+// --- Trabajo ------------------------------------------------------------------------------------
+
+/// Atiende lo que pidió la ventana.
+pub fn atender(app: &mut FilmcraftApp) {
+    let Some(p) = app.jacnex_ia.corta.pendiente.take() else { return };
+    match p {
+        Pedido::Preparar(acepta) => pedir(app, acepta),
+        Pedido::Enviar => enviar(app),
+        Pedido::Descartar => app.jacnex_ia.corta.material = None,
+        Pedido::Detener => {
+            if let Some(t) = &app.jacnex_ia.corta.trabajo {
+                t.parar.store(true, Ordering::Relaxed);
+            }
+        }
+    }
+}
+
+/// Transcribe lo que falte y, con la transcripción lista, [`preparar_luego`].
+fn pedir(app: &mut FilmcraftApp, acepta: bool) {
+    app.jacnex_ia.mirar_sesion();
+    if let Some(f) = falta(app) {
+        app.jacnex_ia.corta.aviso = Some((false, f.into()));
+        return;
+    }
+    app.jacnex_ia.corta.aviso = None;
+    app.jacnex_ia.corta.material = None;
+    crate::jacnex_edicion::ejecutar(app, Despues::Corta, acepta);
+}
+
+/// Con la secuencia ya transcrita: arma el texto con tiempos y deja listo el costo.
+pub(crate) fn preparar_luego(app: &mut FilmcraftApp) {
+    let aviso = |app: &mut FilmcraftApp, m: &str| app.jacnex_ia.corta.aviso = Some((false, m.to_string()));
+    let (Some(id), Some(q)) = (app.session.state.active_sequence, app.jacnex_ia.corta_nube().cloned()) else {
+        return aviso(app, "Abre una secuencia con voz.");
+    };
+    let Some(seq) = app.session.active_sequence() else { return aviso(app, "Abre una secuencia con voz.") };
+    let (seq_duration, rate) = (seq.duration(), seq.settings.frame_rate);
+    let segundos = seq_duration.seconds();
+    let objetivo = app.jacnex_ia.corta.objetivo_actual();
+    if segundos > q.max_segundos {
+        return aviso(app, "La secuencia es demasiado larga para la IA: prueba con una parte.");
+    }
+    if segundos < f64::from(objetivo) * HOLGURA {
+        return aviso(app, "La secuencia dura poco para esa versión: elige una más corta.");
+    }
+    let frases = short_edit::sentences(&filmcraft_engine::transcript::sequence_words(&app.session));
+    // sin voz suficiente no se envía nada (y no se cobra): la IA solo lee lo que se dice
+    if !short_edit::enough_speech(&frases, f64::from(objetivo)) {
+        return aviso(app, SIN_VOZ);
+    }
+    let texto = short_edit::transcript_text(&frases);
+    let letras = texto.chars().count();
+    if letras > q.max_caracteres {
+        return aviso(app, "Hay demasiado texto para la IA de una vez: prueba con una parte de la secuencia.");
+    }
+    app.jacnex_ia.corta.aviso = None;
+    app.jacnex_ia.corta.material =
+        Some(Material { seq: id, seq_duration, rate, frases, texto, letras, segundos, objetivo, gancho: app.jacnex_ia.corta.con_gancho() });
+}
+
+/// Corre `f` en un hilo con `catch_unwind`: si se rompe, llega un error.
+fn en_hilo(tx: Sender<Mensaje>, f: impl FnOnce() -> Mensaje + Send + 'static) -> Result<(), String> {
+    std::thread::Builder::new()
+        .name("jacnex-corta".into())
+        .spawn(move || {
+            let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(f));
+            let _ = tx.send(r.unwrap_or_else(|_| Mensaje::Hecho(Err("error interno al armar la versión corta (ver el registro de fallos)".into()))));
+        })
+        .map(|_| ())
+        .map_err(|e| format!("No se pudo empezar: {e}"))
+}
+
+/// Un error de la red o del servidor, en palabras del usuario.
+fn motivo(e: &str) -> String {
+    if e.contains(crate::jacnex_nemotron::DETENIDO) {
+        "Detenido. Si la IA ya había empezado, se cobra solo lo que gastó.".into()
+    } else {
+        format!("No se pudo armar la versión corta: {e}")
+    }
+}
+
+/// Manda el texto a la IA (hilo aparte) y valida lo que responde.
+fn enviar(app: &mut FilmcraftApp) {
+    let Some(m) = app.jacnex_ia.corta.material.take() else { return };
+    // la secuencia no debe haber cambiado desde que se preparó
+    let igual = app.session.state.active_sequence == Some(m.seq) && app.session.active_sequence().is_some_and(|s| s.duration() == m.seq_duration);
+    if !igual {
+        app.jacnex_ia.corta.aviso = Some((false, "La secuencia cambió: prepara la versión corta otra vez.".into()));
+        return;
+    }
+    app.jacnex_ia.mirar_sesion();
+    let Some(conexion) = crate::jacnex_ia::conexion(&app.jacnex_ia) else {
+        app.jacnex_ia.corta.aviso = Some((false, "Inicia sesión en Jacnex Studio para usar la IA.".into()));
+        return;
+    };
+    let indicacion = app.jacnex_ia.corta.indicacion_limpia();
+    let parar = Arc::new(AtomicBool::new(false));
+    let p2 = parar.clone();
+    let (tx, rx) = std::sync::mpsc::channel();
+    let hilo = en_hilo(tx, move || {
+        let r = crate::jacnex_ia::corta_en_la_nube(&conexion, &indicacion, &m.texto, m.segundos, m.objetivo, m.gancho, &mut |_| !p2.load(Ordering::Relaxed));
+        let v = match r {
+            Ok(v) => v,
+            Err(e) => return Mensaje::Hecho(Err(motivo(&e))),
+        };
+        let cobrado = v.get("creditos").and_then(Value::as_i64).filter(|c| *c >= 0);
+        match short_edit::parse_reply_hook(&v, &m.frases, m.seq_duration, m.rate, f64::from(m.objetivo), m.gancho) {
+            Ok(p) => {
+                Mensaje::Hecho(Ok(Salida { plan: Plan { seq: m.seq, seq_duration: m.seq_duration, title: p.title, ranges: p.ranges, hook: p.hook }, cobrado }))
+            }
+            Err(e) => {
+                let cobro = cobrado.map_or_else(String::new, |c| format!(" Se cobró {} (lo que gastó la IA).", creditos(c)));
+                Mensaje::Hecho(Err(format!("{e}{cobro}")))
+            }
+        }
+    });
+    match hilo {
+        Ok(()) => {
+            app.jacnex_ia.corta.trabajo = Some(Trabajo { rx, parar, inicio: Instant::now() });
+            app.jacnex_ia.corta.aviso = None;
+        }
+        Err(e) => app.jacnex_ia.corta.aviso = Some((false, e)),
+    }
+}
+
+/// Recibe lo que respondió la IA y, con un diálogo cerrado, crea la secuencia.
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.corta.trabajo.as_mut() else { return };
+    let fin = match t.rx.try_recv() {
+        Ok(Mensaje::Hecho(r)) => r,
+        Err(TryRecvError::Empty) => {
+            ctx.request_repaint_after(Duration::from_millis(200));
+            return;
+        }
+        Err(TryRecvError::Disconnected) => Err("el trabajo se interrumpió".into()),
+    };
+    if esperar && fin.is_ok() {
+        // con un diálogo abierto no se toca el proyecto: se vuelve a intentar luego
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(Mensaje::Hecho(fin));
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    app.jacnex_ia.corta.trabajo = None;
+    // lo cobrado (y lo devuelto) se ve en el saldo
+    app.jacnex_ia.refrescar();
+    ctx.request_repaint();
+    app.jacnex_ia.corta.aviso = Some(match fin {
+        Ok(s) => terminar(app, &s),
+        Err(e) => (false, e),
+    });
+}
+
+/// Crea la secuencia con los tramos y cuenta cómo quedó.
+fn terminar(app: &mut FilmcraftApp, s: &Salida) -> (bool, String) {
+    let cobro = s.cobrado.map_or_else(String::new, |c| format!(" Se cobró {}.", creditos(c)));
+    match short_edit::apply(&mut app.session, &s.plan) {
+        Ok(v) => {
+            let seg = v.get("seconds").and_then(Value::as_f64).unwrap_or_else(|| s.plan.seconds());
+            let titulo = if s.plan.title.is_empty() { String::new() } else { format!(" «{}»", s.plan.title) };
+            (true, format!("Listo{titulo}: secuencia nueva «(corta)» de {seg:.0} s con {} tramos. Ctrl+Z la deshace.{cobro}", s.plan.ranges.len()))
+        }
+        Err(e) => (false, format!("No se pudo crear la secuencia: {e}.{cobro}")),
+    }
+}
+
