+const RESOLUCION: &str = "2K";
+/// Los idiomas de la voz rápida: (código, nombre). El primero es el de por defecto.
+const IDIOMAS: &[(&str, &str)] =
+    &[("es", "Español"), ("en", "Inglés"), ("pt", "Portugués"), ("fr", "Francés"), ("it", "Italiano"), ("de", "Alemán"), ("auto", "Detectar")];
+/// Las velocidades de la voz.
+const VELOCIDADES: &[f32] = &[0.8, 0.9, 1.0, 1.1, 1.2];
+/// Las duraciones de la música instrumental, en segundos.
+const DURACIONES_MUSICA: &[u32] = &[15, 30, 60, 120, 180];
