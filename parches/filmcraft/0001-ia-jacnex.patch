+/// Los ajustes de las herramientas de «Editar».
+pub(crate) fn ajustes_edicion(ui: &mut egui::Ui, ed: &mut crate::jacnex_edicion::Edicion, d: crate::jacnex_edicion::Despues, t: &crate::theme::Tokens) {
+    use crate::jacnex_edicion::{COLORES, Despues, ESTILOS, IDIOMAS, MOTORES, PAUSAS, POSICIONES};
+    fila(ui, "Transcripción", t, |ui| {
+        if !ed.ocupado()
+            && let Some(c) = desplegable(ui, "jacnex-ed-motor", MOTORES, ed.motor_actual())
+        {
+            ed.motor = c.into();
+            ed.pide_descarga = None;
+        }
+    });
+    match d {
+        Despues::Subtitulos => {
+            fila(ui, "Estilo", t, |ui| {
+                if let Some(c) = desplegable(ui, "jacnex-ed-estilo", ESTILOS, ed.estilo_actual()) {
+                    ed.estilo = c.into();
+                }
+            });
+            fila(ui, "Posición", t, |ui| {
+                let nombres: Vec<String> = POSICIONES.iter().map(|(_, n)| (*n).to_string()).collect();
+                let actual = ed.posicion_actual();
+                let elegida = POSICIONES.iter().position(|(c, _)| *c == actual).unwrap_or(0);
+                if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                    && let Some((c, _)) = POSICIONES.get(i)
+                {
+                    ed.posicion = (*c).to_string();
+                }
+            });
+            if ed.estilo_actual() != "classic" {
+                fila(ui, "Color", t, |ui| {
+                    let nombres: Vec<String> = COLORES.iter().map(|(_, n)| (*n).to_string()).collect();
+                    let actual = ed.color_actual();
+                    let elegida = COLORES.iter().position(|(c, _)| *c == actual).unwrap_or(0);
+                    if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                        && let Some((c, _)) = COLORES.get(i)
+                    {
+                        ed.color = (*c).to_string();
+                    }
+                });
+            }
+        }
+        Despues::Silencios => {
+            fila(ui, "Pausas de", t, |ui| {
+                let nombres: Vec<String> = PAUSAS.iter().map(|p| format!("+{p:.1} s")).collect();
+                let actual = ed.pausa_actual();
+                let elegida = PAUSAS.iter().position(|p| (*p - actual).abs() < 0.01).unwrap_or(1);
+                if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                    && let Some(p) = PAUSAS.get(i)
+                {
+                    ed.pausa = *p;
+                }
+            });
+        }
+        Despues::Muletillas | Despues::PorTexto | Despues::Nada | Despues::Corta => {}
+    }
+    fila(ui, "Idioma", t, |ui| {
+        if let Some(c) = desplegable(ui, "jacnex-ed-idioma", IDIOMAS, ed.idioma_actual()) {
+            ed.idioma = c.into();
+        }
+    });
+}
