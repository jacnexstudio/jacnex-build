+/// El modelo y los campos propios del modo actual para `/v1/jacnex/generar`.
+fn modelo_y_campos(app: &FilmcraftApp) -> Result<(String, Vec<(&'static str, String)>), String> {
+    let e = &app.jacnex_ia;
+    if e.modo.es_video() {
+        let m = e.modelo_actual();
+        let campos = vec![
+            ("aspect", aspecto_para(&m, &e.aspecto, tamano_secuencia(app))),
+            ("duration", e.duracion_actual(&m).to_string()),
+            ("sound", e.sonido_actual(&m).to_string()),
+        ];
+        return Ok((m.id, campos));
+    }
+    let h = e.herramienta_actual().ok_or("Esta función aún no está disponible.")?;
+    let mut campos = Vec::new();
+    match e.modo {
+        Modo::Voz => {
+            if let Some(v) = e.voz_actual(&h) {
+                campos.push(("voice", v.id));
+            }
+            campos.push(("speed", format!("{:.1}", e.velocidad_actual())));
+            if h.idioma {
+                campos.push(("language", e.idioma_actual().to_string()));
+            }
+        }
+        Modo::Musica => {
+            campos.push(("instrumental", (!e.con_letra).to_string()));
+            if !e.con_letra {
+                campos.push(("duration", e.duracion_musica_actual(&h).to_string()));
+            }
+        }
+        Modo::Efecto => campos.push(("loop", e.bucle.to_string())),
+        Modo::Mejorar => campos.push(("resolution", e.resolucion_actual().to_string())),
+        Modo::Vertical => {
+            campos.push(("aspect", e.vertical.forma_nube().to_string()));
+            campos.push(("resolution", e.vertical.resolucion_nube().to_string()));
+        }
+        _ => {}
+    }
+    Ok((h.id, campos))
+}
