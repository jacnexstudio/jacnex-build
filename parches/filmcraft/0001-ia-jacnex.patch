+++ b/crates/engine/src/reframe_gate.rs
@@ -0,0 +1,233 @@
+//! Jacnex: "Pasar a vertical", who is speaking. The speaker network scores short windows of the
+//! clip ([`Win`]); this turns those scores into stretches with one speaker each ([`Seg`]).
+//!
+//! The reframe is offline, so the decision looks ahead: a face becomes the speaker only after it
+//! has clearly won for [`SWITCH`] seconds, but the change is dated where its winning run began,
+//! and the camera cuts there. The speaker is kept through pauses of up to [`HOLD`] seconds.
+
+/// A face is the speaker when its score reaches `SURE` and beats every other face by `MARGIN`.
+pub(super) const SURE: f32 = 0.45;
+pub(super) const MARGIN: f32 = 0.3;
+/// Seconds a new speaker must keep winning before the change is believed.
+pub(super) const SWITCH: f64 = 0.8;
+/// Seconds the speaker is kept without winning.
+pub(super) const HOLD: f64 = 1.5;
+/// Seconds between two decisions.
+const GRID: f64 = 0.2;
+/// Longest gap in the scores that still counts as one stretch.
+const GAP: f64 = 0.65;
+/// Frames of the video the scores of a window are averaged over, each way.
+const SMOOTH: usize = 6;
+const FPS: f64 = 25.0;
+/// Most decisions for one clip.
+const MAX_GRID: usize = 200_000;
+
+/// The raw scores of one window: per face track, the probability of speaking in every frame.
+#[derive(Clone, Debug)]
+pub(super) struct Win {
+    pub at: f64,
+    pub frames: usize,
+    pub probs: Vec<(u32, Vec<f32>)>,
+}
+
+/// A stretch of one group of scores with one speaker (`None`: nobody clear).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub(super) struct Seg {
+    pub t0: f64,
+    pub t1: f64,
+    pub who: Option<u32>,
+    /// First of its group: nothing changed at `t0`, so there is no cut there.
+    pub first: bool,
+}
+
+/// The scores of every face at `t`, from the window that sees `t` best (a short one wins a tie).
+pub(super) fn scores(wins: &[Win], t: f64) -> Option<Vec<(u32, f32)>> {
+    let mut best: Option<(&Win, f64, f64)> = None;
+    for w in wins.iter().filter(|w| w.frames > 0) {
+        let span = w.frames as f64 / FPS;
+        let rel = t - w.at;
+        if !(-0.6..=span + 0.6).contains(&rel) {
+            continue;
+        }
+        let merit = rel.min(span - rel).min(0.4);
+        let better = match best {
+            None => true,
+            Some((_, m, s)) => merit > m + 1e-9 || ((merit - m).abs() <= 1e-9 && span < s),
+        };
+        if better {
+            best = Some((w, merit, span));
+        }
+    }
+    let (w, ..) = best?;
+    let k = ((t - w.at) * FPS).round().clamp(0.0, (w.frames - 1) as f64) as usize;
+    let (lo, hi) = (k.saturating_sub(SMOOTH), (k + SMOOTH + 1).min(w.frames));
+    Some(w.probs.iter().filter_map(|(id, p)| p.get(lo..hi).filter(|s| !s.is_empty()).map(|s| (*id, s.iter().sum::<f32>() / s.len() as f32))).collect())
+}
+
+fn winner(s: &[(u32, f32)]) -> Option<u32> {
+    let mut v = s.to_vec();
+    v.sort_by(|a, b| b.1.total_cmp(&a.1));
+    let (best, rest) = v.split_first()?;
+    let second = rest.first().map_or(0.0, |x| x.1);
+    (best.1 >= SURE && best.1 - second >= MARGIN).then_some(best.0)
+}
+
+/// Whether some instant of the window has a face that passes the gate.
+pub(super) fn clear(w: &Win) -> bool {
+    (0..w.frames).any(|k| {
+        let (lo, hi) = (k.saturating_sub(SMOOTH), (k + SMOOTH + 1).min(w.frames));
+        let s: Vec<(u32, f32)> =
+            w.probs.iter().filter_map(|(id, p)| p.get(lo..hi).filter(|x| !x.is_empty()).map(|x| (*id, x.iter().sum::<f32>() / x.len() as f32))).collect();
+        winner(&s).is_some()
+    })
+}
+
+/// The stretches with their speakers. `cuts` are the first instants of the shots after the first.
+pub(super) fn decide(wins: &[Win], cuts: &[f64], dur: f64) -> Vec<Seg> {
+    let n = ((dur / GRID).ceil() as usize).min(MAX_GRID);
+    let mut out = Vec::new();
+    let mut points: Vec<(f64, Option<u32>)> = Vec::new();
+    let mut group_shot = 0usize;
+    for k in 0..=n {
+        let t = k as f64 * GRID;
+        let Some(s) = scores(wins, t) else { continue };
+        let shot = cuts.partition_point(|c| *c <= t);
+        if points.last().is_some_and(|p| shot != group_shot || t - p.0 > GAP) {
+            run_group(&points, &mut out);
+            points.clear();
+        }
+        group_shot = shot;
+        points.push((t, winner(&s)));
+    }
+    run_group(&points, &mut out);
+    out
+}
+
+/// One group of decisions, in time order, into stretches.
+fn run_group(points: &[(f64, Option<u32>)], out: &mut Vec<Seg>) {
+    let (Some(first), Some(last)) = (points.first(), points.last()) else { return };
+    let end = last.0 + GRID;
+    let mut events: Vec<(f64, Option<u32>)> = vec![(first.0, None)];
+    let mut cur: Option<u32> = None;
+    let mut last_win = f64::NEG_INFINITY;
+    let mut cand: Option<(u32, f64)> = None;
+    for &(t, w) in points {
+        match w {
+            Some(x) if Some(x) == cur => {
+                last_win = t;
+                cand = None;
+            }
+            Some(x) => {
+                let since = match cand {
+                    Some((id, s)) if id == x => s,
+                    _ => t,
+                };
+                cand = Some((x, since));
+                if t - since >= SWITCH {
+                    // dated where the winning run began, not where the wait ended
+                    events.push((since, Some(x)));
+                    cur = Some(x);
+                    last_win = t;
+                    cand = None;
+                }
+            }
+            None => {
+                cand = None;
+                if cur.is_some() && t - last_win > HOLD {
+                    events.push((last_win + HOLD, None));
+                    cur = None;
+                }
+            }
+        }
+    }
+    let mut first_seg = true;
+    for (i, (t0, who)) in events.iter().enumerate() {
+        let t1 = events.get(i + 1).map_or(end, |e| e.0);
+        if t1 - t0 < 1e-6 {
+            continue;
+        }
+        out.push(Seg { t0: *t0, t1, who: *who, first: first_seg });
+        first_seg = false;
+    }
+}
+
+/// The stretch holding `t`.
+pub(super) fn seg_at(segs: &[Seg], t: f64) -> Option<&Seg> {
+    let i = segs.partition_point(|s| s.t0 <= t).checked_sub(1)?;
+    segs.get(i).filter(|s| t < s.t1)
+}
+
+/// Where the speaker changes to somebody (`only_people`) or to anyone: the camera cuts there.
+pub(super) fn turns(segs: &[Seg], only_people: bool) -> Vec<f64> {
+    segs.iter().filter(|s| !s.first && (!only_people || s.who.is_some())).map(|s| s.t0).collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// A window whose face 1 scores `hi` and face 2 `lo` before `turn`, swapped after it.
+    fn win(at: f64, frames: usize, turn: f64, hi: f32, lo: f32) -> Win {
+        let p = |first: bool| -> Vec<f32> { (0..frames).map(|k| if (at + k as f64 / FPS < turn) == first { hi } else { lo }).collect() };
+        Win { at, frames, probs: vec![(1, p(true)), (2, p(false))] }
+    }
+
+    fn series(turn: f64, step: f64, len: usize) -> Vec<Win> {
+        (0..len).map(|i| win(i as f64 * step, 50, turn, 0.7, 0.1)).collect()
+    }
+
+    #[test]
+    fn a_change_is_dated_where_it_began() {
+        let segs = decide(&series(5.0, 2.0, 7), &[], 14.0);
+        let who: Vec<_> = segs.iter().map(|s| s.who).collect();
+        assert_eq!(who, vec![Some(1), Some(2)], "{segs:?}");
+        let t = turns(&segs, true);
+        assert_eq!(t.len(), 1);
+        assert!((t[0] - 5.0).abs() < 0.45, "turn at {}", t[0]);
+    }
+
+    #[test]
+    fn nobody_clear_means_nobody() {
+        let wins: Vec<Win> = (0..4).map(|i| win(i as f64 * 3.0, 50, 100.0, 0.6, 0.5)).collect();
+        let segs = decide(&wins, &[], 11.0);
+        assert!(segs.iter().all(|s| s.who.is_none()), "{segs:?}");
+        assert!(turns(&segs, false).is_empty());
+    }
+
+    #[test]
+    fn a_short_blip_does_not_change_the_speaker() {
+        let mut wins = series(100.0, 3.0, 5);
+        // 0.4 s where face 2 shouts louder than face 1
+        for i in 20..30 {
+            wins[2].probs[1].1[i] = 0.9;
+            wins[2].probs[0].1[i] = 0.05;
+        }
+        let segs = decide(&wins, &[], 14.0);
+        assert!(segs.iter().all(|s| s.who != Some(2)), "{segs:?}");
+    }
+
+    #[test]
+    fn a_pause_is_held_but_a_long_silence_ends_the_speaker() {
+        let wins = vec![win(0.0, 50, 100.0, 0.7, 0.1), win(2.0, 50, 100.0, 0.1, 0.1), win(4.0, 50, 100.0, 0.1, 0.1), win(6.0, 50, 100.0, 0.1, 0.1)];
+        let segs = decide(&wins, &[], 8.0);
+        assert_eq!(segs.iter().map(|s| s.who).collect::<Vec<_>>(), vec![Some(1), None], "{segs:?}");
+        let held = segs[0].t1 - segs[0].t0;
+        assert!((2.0..4.5).contains(&held), "held {held}");
+    }
+
+    #[test]
+    fn groups_end_at_a_scene_cut() {
+        let wins = series(100.0, 3.0, 5);
+        let segs = decide(&wins, &[6.0], 14.0);
+        assert_eq!(segs.iter().filter(|s| s.first).count(), 2, "{segs:?}");
+        assert!(turns(&segs, false).iter().all(|t| (*t - 6.0).abs() > 0.1));
+    }
+
+    #[test]
+    fn a_short_window_beats_a_long_one() {
+        let wins = vec![win(0.0, 50, 100.0, 0.7, 0.1), Win { at: 1.0, frames: 25, probs: vec![(1, vec![0.1; 25]), (2, vec![0.9; 25])] }];
+        let s = scores(&wins, 1.5).unwrap();
+        assert!(s.iter().any(|(id, v)| *id == 2 && *v > 0.8), "{s:?}");
+        assert!(seg_at(&decide(&wins, &[], 3.0), 0.5).is_some());
+    }
+}
diff --git a/crates/engine/src/reframe_job.rs b/crates/engine/src/reframe_job.rs
new file mode 100644
index 0000000..d44d6a3
--- /dev/null
+++ b/crates/engine/src/reframe_job.rs
@@ -0,0 +1,792 @@
+//! Jacnex: "Pasar a vertical" (auto-reframe), the analysis. [`reframe_job`] collects the video
+//! clips of the active sequence on the UI thread (cheap: no decoding); a worker thread runs
+//! [`ReframeJob::run`], which samples each clip a few times a second, finds faces (YuNet), people
+//! and objects (RT-DETRv2) and, where several faces share a shot, who is talking (Light-ASD over
+//! face crops and the audio), then plans the camera ([`filmcraft_reframe::plan`]). The UI thread
+//! commits the plan with [`crate::reframe_apply::apply`] as one undo step.
+//!
+//! The networks are read from the folder Jacnex Studio fills (`jacnex_models_dir()/<model-id>/`);
+//! nothing is downloaded here.
+
+use std::path::PathBuf;
+
+use filmcraft_media::{FrameRequest, SharedSource};
+use filmcraft_project::{ClipId, ItemId, TrackItem, TrackKind};
+use filmcraft_reframe::plan::{self, Aspect, Key, Sample, Subject};
+use filmcraft_reframe::track::{Det, Kind, link};
+use filmcraft_reframe::{Image, Rect};
+use filmcraft_render::scene::{SceneOptions, detect_cuts, difference, signature};
+use filmcraft_time::Tick;
+
+use crate::{EngineError, Result, Session};
+
+/// What to tell the user when a network file is not on this computer.
+pub const FALTA_MODELO: &str = "Actualiza Filmnex desde Jacnex Studio para usar esta función.";
+/// Why a job stopped early.
+pub const CANCELLED: &str = "reframe stopped";
+
+/// Seconds between two sampled frames (they give the scene cuts).
+const STEP: f64 = 0.4;
+/// Faces are looked for on every this-many samples (and on the first one of every shot).
+const FACE_EVERY: usize = 2;
+/// Where there is no face, people are looked for at most this often (and on the first sample of every shot): the slow network.
+const PEOPLE_GAP: f64 = 1.0;
+/// Clips analysed in one job, and samples in all (a 2 h clip is 18 000).
+const MAX_CLIPS: usize = 500;
+const MAX_SAMPLES: usize = 60_000;
+/// Longest side the detectors see.
+const DETECT_SIDE: usize = 960;
+/// Cuts one clip may have.
+const MAX_CUTS: usize = 4000;
+/// Frames per second the speaker detector wants, and the most it is run on in one job.
+const ASD_FPS: f64 = 25.0;
+const MAX_ASD_FRAMES: usize = 25 * 1500;
+/// Seconds between the starts of two speaker windows (each is `nets::ASD_CHUNK_SECONDS` long).
+const ASD_EVERY: f64 = 3.0;
+/// Speaker changes whose moment is looked at again, and the short windows used for each: they
+/// are `REFINE_LEN` seconds long, `REFINE_STEP` apart, and start from `REFINE_BACK` before it.
+/// Windows of a shot scored before giving up on it when none has a clear speaker.
+const EARLY_OUT: usize = 3;
+const MAX_REFINE: usize = 10;
+const REFINE_LEN: f64 = 1.0;
+const REFINE_STEP: f64 = 0.5;
+const REFINE_BACK: f64 = 1.25;
+const REFINE_WINDOWS: usize = 4;
+
+/// What a running job is doing.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum ReframeProgress {
+    Loading,
+    /// Looking at clip `clip` (0-based) of `of`; `fraction` of it is done.
+    Analysing {
+        clip: usize,
+        of: usize,
+        fraction: f32,
+    },
+    /// Working out who speaks in clip `clip` of `of`.
+    Speakers {
+        clip: usize,
+        of: usize,
+        fraction: f32,
+    },
+    Planning,
+}
+
+struct Work {
+    clip: ClipId,
+    name: String,
+    item: TrackItem,
+    src: SharedSource,
+    /// The clip's source picture size.
+    size: (u32, u32),
+    /// Plays forward at normal speed (the audio can be matched to the pictures).
+    plain: bool,
+}
+
+/// A reframe collected on the UI thread.
+pub struct ReframeJob {
+    pub seq: ItemId,
+    aspect: Aspect,
+    clips: Vec<Work>,
+    skipped: usize,
+}
+
+/// The camera of one shot: keys in seconds from the start of the clip.
+#[derive(Clone, Debug)]
+pub struct ShotPlan {
+    pub start: f64,
+    pub end: f64,
+    pub keys: Vec<Key>,
+}
+
+/// The plan of one clip.
+#[derive(Clone, Debug)]
+pub struct ClipPlan {
+    pub clip: ClipId,
+    pub name: String,
+    pub size: (u32, u32),
+    pub shots: Vec<ShotPlan>,
+    /// Samples that had a face, a person, something else, nothing.
+    pub found: [usize; 4],
+    /// Samples where the speaker detector chose.
+    pub speaker_samples: usize,
+}
+
+/// What a job made.
+#[derive(Clone, Debug)]
+pub struct ReframeResult {
+    pub seq: ItemId,
+    pub aspect: Aspect,
+    pub plans: Vec<ClipPlan>,
+    /// Clips that could not be analysed (centred instead).
+    pub skipped: usize,
+}
+
+/// Where the networks are.
+pub fn models_dir() -> Option<PathBuf> {
+    crate::transcript::jacnex_models_dir()
+}
+
+/// Whether this build has the networks and they are on this computer.
+pub fn available() -> bool {
+    models_dir().is_some_and(|d| nets::present(&d))
+}
+
+/// Why the tool cannot run now (None: it can).
+pub fn missing() -> Option<&'static str> {
+    if !cfg!(feature = "whisper") || !available() { Some(FALTA_MODELO) } else { None }
+}
+
+fn is_plain(it: &TrackItem) -> bool {
+    if it.reverse || it.frame_hold.is_some() {
+        return false;
+    }
+    let d = it.duration.seconds() / 2.0;
+    let m = (it.source_time_at(it.start + Tick::from_seconds_f64(d)) - it.source_time_at(it.start)).seconds();
+    d > 0.0 && (m / d - 1.0).abs() < 0.01
+}
+
+/// Collects the enabled video clips of the active sequence (those that show a media file).
+pub fn reframe_job(s: &Session, aspect: Aspect) -> Result<ReframeJob> {
+    let seq = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+    let mut clips = Vec::new();
+    let skipped = 0;
+    let mut samples = 0usize;
+    for t in q.video_tracks.iter().filter(|t| t.kind == TrackKind::Video) {
+        for it in t.items.iter().filter(|i| i.enabled) {
+            let Some(src) = s.source(it.item) else { continue };
+            let Some(v) = src.info().video.clone() else { continue };
+            let n = (it.duration.seconds() / STEP).ceil().max(1.0) as usize;
+            samples = samples.saturating_add(n);
+            if clips.len() >= MAX_CLIPS || samples > MAX_SAMPLES {
+                return Err(EngineError::Other("la secuencia es demasiado larga para analizarla de una vez; usa menos clips".into()));
+            }
+            clips.push(Work { clip: it.id, name: it.name.clone(), item: it.clone(), src, size: (v.width.max(1), v.height.max(1)), plain: is_plain(it) });
+        }
+    }
+    if clips.is_empty() {
+        return Err(EngineError::Other("la secuencia no tiene clips de video".into()));
+    }
+    Ok(ReframeJob { seq, aspect, clips, skipped })
+}
+
+impl ReframeJob {
+    /// Seconds of video to analyse.
+    pub fn seconds(&self) -> f64 {
+        self.clips.iter().map(|w| w.item.duration.seconds()).sum()
+    }
+
+    /// Runs the job (on any thread). `progress` returns false to stop.
+    pub fn run(self, progress: &mut dyn FnMut(ReframeProgress) -> bool) -> Result<ReframeResult> {
+        let dir = models_dir().ok_or_else(|| EngineError::Other(FALTA_MODELO.into()))?;
+        // a clip that is already as narrow as the target needs no look at it (no models are loaded)
+        let needs = |w: &Work| {
+            let (cw, ch) = self.aspect.crop(w.size.0 as f32, w.size.1 as f32);
+            cw < 0.999 || ch < 0.999
+        };
+        let nets = if self.clips.iter().any(needs) {
+            if !progress(ReframeProgress::Loading) {
+                return Err(EngineError::Other(CANCELLED.into()));
+            }
+            Some(nets::load(&dir).map_err(EngineError::Other)?)
+        } else {
+            None
+        };
+        let of = self.clips.len();
+        let mut plans = Vec::with_capacity(of);
+        let mut skipped = self.skipped;
+        let mut asd_budget = MAX_ASD_FRAMES;
+        for (k, w) in self.clips.iter().enumerate() {
+            let Some(nets) = nets.as_ref().filter(|_| needs(w)) else {
+                plans.push(centred(w, self.aspect));
+                continue;
+            };
+            let mut cx = Cx { prog: progress, clip: k, of };
+            match analyse(w, nets, &mut cx, &mut asd_budget) {
+                Ok(a) => plans.push(plan_clip(w, a, self.aspect)),
+                Err(e) if e.to_string().contains(CANCELLED) => return Err(e),
+                Err(_) => {
+                    skipped += 1;
+                    plans.push(centred(w, self.aspect));
+                }
+            }
+        }
+        if !progress(ReframeProgress::Planning) {
+            return Err(EngineError::Other(CANCELLED.into()));
+        }
+        Ok(ReframeResult { seq: self.seq, aspect: self.aspect, plans, skipped })
+    }
+}
+
+struct Cx<'a> {
+    prog: &'a mut dyn FnMut(ReframeProgress) -> bool,
+    clip: usize,
+    of: usize,
+}
+
+impl Cx<'_> {
+    fn analysing(&mut self, fraction: f32) -> Result<()> {
+        self.send(ReframeProgress::Analysing { clip: self.clip, of: self.of, fraction })
+    }
+    fn speakers(&mut self, fraction: f32) -> Result<()> {
+        self.send(ReframeProgress::Speakers { clip: self.clip, of: self.of, fraction })
+    }
+    fn send(&mut self, p: ReframeProgress) -> Result<()> {
+        if (self.prog)(p) { Ok(()) } else { Err(EngineError::Other(CANCELLED.into())) }
+    }
+}
+
+/// What the analysis of one clip found.
+struct Analysis {
+    dur: f64,
+    /// Seconds from the clip start of every sample.
+    times: Vec<f64>,
+    dets: Vec<Vec<Det>>,
+    ids: Vec<Vec<u32>>,
+    /// First instants of the shots after the first.
+    cuts: Vec<f64>,
+    /// Per sample and detection: probability of speaking (0.5 unknown).
+    speaking: Vec<Vec<f32>>,
+    /// Who speaks when (stretches of the crowded shots).
+    segs: Vec<gate::Seg>,
+    /// Instants where the speaker changes: the camera cuts there.
+    turns: Vec<f64>,
+}
+
+/// One decoded frame of a clip at `t` seconds from its start.
+fn grab(w: &Work, t: f64, scale: f32) -> Result<(Vec<u8>, usize, usize)> {
+    let tl = w.item.start + Tick::from_seconds_f64(t.clamp(0.0, (w.item.duration.seconds() - 0.001).max(0.0)));
+    let f = w
+        .src
+        .video_frame(FrameRequest { time: w.item.source_time_at(tl), scale })
+        .map_err(|e| EngineError::Other(format!("{}: no se pudo leer un cuadro: {e}", w.name)))?;
+    Ok((f.to_rgba8(), f.width as usize, f.height as usize))
+}
+
+fn detect_scale(size: (u32, u32)) -> f32 {
+    (DETECT_SIDE as f32 / size.0.max(size.1) as f32).min(1.0)
+}
+
+fn par_error(e: par::ParError) -> EngineError {
+    match e {
+        par::ParError::Stopped => EngineError::Other(CANCELLED.into()),
+        par::ParError::Failed(m) => EngineError::Other(m),
+    }
+}
+
+fn analyse(w: &Work, nets: &nets::Nets, cx: &mut Cx, asd_budget: &mut usize) -> Result<Analysis> {
+    let dur = w.item.duration.seconds();
+    let n = ((dur / STEP).ceil() as usize).clamp(1, MAX_SAMPLES);
+    let scale = detect_scale(w.size);
+    let workers = par::workers();
+    let stamps: Vec<f64> = (0..n).map(|i| (i as f64 * STEP).min((dur - 0.001).max(0.0))).collect();
+    // first pass: a cheap look at every sample, for the cuts
+    let sigs = par::par_map(
+        n,
+        workers,
+        &|i| {
+            let (rgba, fw, fh) = grab(w, stamps[i], scale).map_err(|e| e.to_string())?;
+            Ok(signature(&rgba, fw, fh))
+        },
+        &mut |d| cx.analysing(0.2 * d as f32 / n as f32).is_ok(),
+    )
+    .map_err(par_error)?;
+    let diffs: Vec<f32> = std::iter::once(0.0).chain(sigs.windows(2).map(|p| difference(&p[0], &p[1]))).collect();
+    let mut cuts = Vec::new();
+    let mut first = vec![false; n];
+    first[0] = true;
+    for i in detect_cuts(&diffs, &SceneOptions { sensitivity: 50.0, min_shot_frames: 1 }).into_iter().take(MAX_CUTS) {
+        cuts.push(refine_cut(w, scale, (stamps[i - 1], stamps[i]), (&sigs[i - 1], &sigs[i]))?);
+        first[i] = true;
+    }
+    // second pass: the networks, on fewer samples. Faces are quick; the people network is the
+    // slow one, so it runs only where there is no face and not more often than `PEOPLE_GAP`.
+    let wanted: Vec<usize> = (0..n).filter(|i| first[*i] || i % FACE_EVERY == 0).collect();
+    let look = |i: usize, people: bool| -> std::result::Result<Vec<Det>, String> {
+        let (rgba, fw, fh) = grab(w, stamps[i], scale).map_err(|e| e.to_string())?;
+        let img = Image::new(&rgba, fw, fh).map_err(|e| e.to_string())?;
+        if people { nets.people(&img) } else { nets.faces(&img) }
+    };
+    let mut faces = par::par_map(wanted.len(), workers, &|k| look(wanted[k], false), &mut |d| cx.analysing(0.2 + 0.4 * d as f32 / wanted.len() as f32).is_ok())
+        .map_err(par_error)?;
+    let mut last_people = f64::NEG_INFINITY;
+    let mut slow: Vec<usize> = Vec::new();
+    for (k, f) in faces.iter().enumerate() {
+        let i = wanted[k];
+        if f.is_empty() && (first[i] || stamps[i] - last_people >= PEOPLE_GAP) {
+            slow.push(k);
+            last_people = stamps[i];
+        }
+    }
+    let people =
+        par::par_map(slow.len(), workers, &|j| look(wanted[slow[j]], true), &mut |d| cx.analysing(0.6 + 0.4 * d as f32 / slow.len().max(1) as f32).is_ok())
+            .map_err(par_error)?;
+    for (j, p) in slow.iter().zip(people) {
+        faces[*j] = p;
+    }
+    let mut times = Vec::new();
+    let mut dets = Vec::new();
+    let mut asked = slow.iter().copied().peekable();
+    for (k, d) in faces.into_iter().enumerate() {
+        let looked = asked.next_if_eq(&k).is_some();
+        // a sample with no face whose people were not asked for carries no information
+        if d.is_empty() && !looked {
+            continue;
+        }
+        times.push(stamps[wanted[k]]);
+        dets.push(d);
+    }
+    let ids = link(&dets);
+    let mut a = Analysis { dur, times, speaking: dets.iter().map(|d| vec![0.5; d.len()]).collect(), dets, ids, cuts, segs: Vec::new(), turns: Vec::new() };
+    if w.plain {
+        let scale = detect_scale(w.size);
+        let feed = Feed { frame: &|t| grab(w, t, scale), audio: &|at, n| read_mono(w, at, n) };
+        speakers(&feed, nets, &mut a, cx, asd_budget)?;
+    }
+    Ok(a)
+}
+
+/// Bisects the interval between two samples for the first frame of the new shot.
+fn refine_cut(w: &Work, scale: f32, span: (f64, f64), sigs: (&filmcraft_render::scene::Signature, &filmcraft_render::scene::Signature)) -> Result<f64> {
+    let (mut lo, mut hi) = span;
+    for _ in 0..6 {
+        let mid = 0.5 * (lo + hi);
+        let (rgba, fw, fh) = grab(w, mid, scale)?;
+        let sm = signature(&rgba, fw, fh);
+        if difference(&sm, sigs.0) < difference(&sm, sigs.1) {
+            lo = mid;
+        } else {
+            hi = mid;
+        }
+    }
+    Ok(hi)
+}
+
+/// Where the track `id` is at `t`, from its detections (None when it is not there around `t`).
+fn rect_at(a: &Analysis, id: u32, t: f64) -> Option<Rect> {
+    let mut before: Option<(f64, Rect)> = None;
+    let mut after: Option<(f64, Rect)> = None;
+    for (i, ids) in a.ids.iter().enumerate() {
+        let Some(j) = ids.iter().position(|x| *x == id) else { continue };
+        let r = a.dets[i][j].rect;
+        if a.times[i] <= t {
+            before = Some((a.times[i], r));
+        } else {
+            after = Some((a.times[i], r));
+            break;
+        }
+    }
+    match (before, after) {
+        (Some((t0, r0)), Some((t1, r1))) if t1 - t0 <= 3.0 => {
+            let f = ((t - t0) / (t1 - t0).max(1e-9)) as f32;
+            let m = |x: f32, y: f32| x + (y - x) * f;
+            Some(Rect::new(m(r0.x0, r1.x0), m(r0.y0, r1.y0), m(r0.x1, r1.x1), m(r0.y1, r1.y1)))
+        }
+        (Some((t0, r)), None) | (None, Some((t0, r))) if (t0 - t).abs() <= 2.0 => Some(r),
+        _ => None,
+    }
+}
+
+/// Windows (first and last sample index) where two or more faces share a shot.
+fn crowded_windows(a: &Analysis) -> Vec<(usize, usize)> {
+    let shot_of = |t: f64| a.cuts.iter().filter(|c| **c <= t).count();
+    let mut out: Vec<(usize, usize)> = Vec::new();
+    for i in 0..a.times.len() {
+        let faces = a.dets[i].iter().filter(|d| d.kind == Kind::Face).count();
+        if faces < 2 {
+            continue;
+        }
+        match out.last_mut() {
+            Some(l) if i - l.1 <= 3 && shot_of(a.times[l.1]) == shot_of(a.times[i]) => l.1 = i,
+            _ => out.push((i, i)),
+        }
+    }
+    out
+}
+
+/// Where the speaker pass gets its pictures and sound (the clip itself, or a test's own mix).
+struct Feed<'a> {
+    /// The frame at `t` seconds.
+    frame: &'a (dyn Fn(f64) -> Result<(Vec<u8>, usize, usize)> + Sync),
+    /// `n` mono samples at the MFCC sample rate from `t` seconds.
+    audio: &'a (dyn Fn(f64, usize) -> Vec<f32> + Sync),
+}
+
+/// Who speaks: scores the crowded stretches, decides, looks again around every change of speaker
+/// to find the moment, and writes the verdict into the samples. Returns the windows scored.
+fn speakers(w: &Feed, nets: &nets::Nets, a: &mut Analysis, cx: &mut Cx, budget: &mut usize) -> Result<Vec<gate::Win>> {
+    let mut wins = score_windows(w, nets, a, cx, budget)?;
+    let segs = gate::decide(&wins, &a.cuts, a.dur);
+    for t in gate::turns(&segs, true).into_iter().take(MAX_REFINE) {
+        let (s0, s1) = shot_span(a, t);
+        for k in 0..REFINE_WINDOWS {
+            let at = (t - REFINE_BACK + k as f64 * REFINE_STEP).max(s0);
+            let frames = (((s1 - at).min(REFINE_LEN)) * ASD_FPS).floor().max(0.0) as usize;
+            if frames < 12 || frames > *budget {
+                continue;
+            }
+            *budget -= frames;
+            wins.extend(speak_chunk(w, nets, a, (at, frames), cx)?);
+        }
+    }
+    apply_verdict(a, gate::decide(&wins, &a.cuts, a.dur));
+    Ok(wins)
+}
+
+/// The first and last instant of the shot holding `t`.
+fn shot_span(a: &Analysis, t: f64) -> (f64, f64) {
+    let i = a.cuts.partition_point(|c| *c <= t);
+    (if i == 0 { 0.0 } else { a.cuts[i - 1] }, a.cuts.get(i).copied().unwrap_or(a.dur))
+}
+
+/// Keeps the stretches and gives every face of a sample inside one its value: 0.95 for the
+/// speaker, 0.2 for the others, 0.5 (unknown) while nobody is clear. Samples outside the
+/// stretches stay as they were.
+fn apply_verdict(a: &mut Analysis, segs: Vec<gate::Seg>) {
+    for i in 0..a.times.len() {
+        let Some(seg) = gate::seg_at(&segs, a.times[i]) else { continue };
+        for j in 0..a.dets[i].len() {
+            if a.dets[i][j].kind != Kind::Face {
+                continue;
+            }
+            a.speaking[i][j] = match seg.who {
+                Some(c) if c == a.ids[i][j] => 0.95,
+                Some(_) => 0.2,
+                None => 0.5,
+            };
+        }
+    }
+    a.turns = gate::turns(&segs, false).into_iter().filter(|t| a.cuts.iter().all(|c| (c - t).abs() > 0.2)).collect();
+    a.segs = segs;
+}
+
+/// Scores the crowded stretches: a window every `ASD_EVERY` seconds.
+fn score_windows(w: &Feed, nets: &nets::Nets, a: &mut Analysis, cx: &mut Cx, budget: &mut usize) -> Result<Vec<gate::Win>> {
+    let wins = crowded_windows(a);
+    let total: usize = wins.len().max(1);
+    let mut out = Vec::new();
+    // per shot: windows scored and whether any had a clear speaker (no one after the first few
+    // means the footage will not give one, so the rest of the shot is not scored)
+    let mut seen: std::collections::HashMap<usize, (usize, bool)> = std::collections::HashMap::new();
+    for (wi, (i0, i1)) in wins.into_iter().enumerate() {
+        cx.speakers(wi as f32 / total as f32)?;
+        let t0 = (a.times[i0] - 0.2).max(0.0);
+        let t1 = (a.times[i1] + 0.2).min(a.dur);
+        // a short window every few seconds is enough to know who is talking
+        let mut at = t0;
+        while at < t1 - 0.2 {
+            let len = (t1 - at).min(nets::ASD_CHUNK_SECONDS);
+            let frames = (len * ASD_FPS).floor() as usize;
+            if frames < 8 || frames > *budget {
+                break;
+            }
+            let shot = a.cuts.partition_point(|c| *c <= at);
+            if seen.get(&shot).is_some_and(|(n, ok)| *n >= EARLY_OUT && !*ok) {
+                break;
+            }
+            *budget -= frames;
+            let win = speak_chunk(w, nets, a, (at, frames), cx)?;
+            let e = seen.entry(shot).or_insert((0, false));
+            e.0 += 1;
+            e.1 |= win.as_ref().is_some_and(gate::clear);
+            out.extend(win);
+            at += ASD_EVERY;
+        }
+    }
+    Ok(out)
+}
+
+/// Median of the `kernel` values around each index (edges use what exists).
+fn median_filter(v: &[f32], kernel: usize) -> Vec<f32> {
+    let h = kernel / 2;
+    (0..v.len())
+        .map(|i| {
+            let mut w: Vec<f32> = v[i.saturating_sub(h)..(i + h + 1).min(v.len())].to_vec();
+            w.sort_by(f32::total_cmp);
+            w.get(w.len() / 2).copied().unwrap_or(v[i])
+        })
+        .collect()
+}
+
+/// The way the original smooths a face track: a median over 13 frames of the box centre and size.
+fn smooth_rects(rs: &[Option<Rect>]) -> Vec<Option<Rect>> {
+    let idx: Vec<usize> = (0..rs.len()).filter(|i| rs[*i].is_some()).collect();
+    let pick = |f: &dyn Fn(&Rect) -> f32| -> Vec<f32> { idx.iter().filter_map(|i| rs[*i].as_ref().map(f)).collect() };
+    let (cx, cy) = (median_filter(&pick(&|r| r.cx()), 13), median_filter(&pick(&|r| r.cy()), 13));
+    let (w, h) = (median_filter(&pick(&|r| r.w()), 13), median_filter(&pick(&|r| r.h()), 13));
+    let mut out = rs.to_vec();
+    for (k, i) in idx.iter().enumerate() {
+        out[*i] = Some(Rect::new(cx[k] - w[k] / 2.0, cy[k] - h[k] / 2.0, cx[k] + w[k] / 2.0, cy[k] + h[k] / 2.0));
+    }
+    out
+}
+
+fn speak_chunk(w: &Feed, nets: &nets::Nets, a: &Analysis, (at, frames): (f64, usize), cx: &mut Cx) -> Result<Option<gate::Win>> {
+    let mut ids: Vec<u32> = Vec::new();
+    for (i, t) in a.times.iter().enumerate() {
+        if *t >= at - 0.4 && *t <= at + frames as f64 / ASD_FPS + 0.4 {
+            ids.extend(a.ids[i].iter().zip(&a.dets[i]).filter(|(_, d)| d.kind == Kind::Face).map(|(id, _)| *id));
+        }
+    }
+    ids.sort_unstable();
+    ids.dedup();
+    ids.truncate(8);
+    if ids.len() < 2 {
+        return Ok(None);
+    }
+    let mut crops: Vec<Vec<f32>> = ids.iter().map(|_| Vec::with_capacity(frames * nets::CROP * nets::CROP)).collect();
+    let rects: Vec<Vec<Option<Rect>>> =
+        ids.iter().map(|id| smooth_rects(&(0..frames).map(|k| rect_at(a, *id, at + k as f64 / ASD_FPS)).collect::<Vec<_>>())).collect();
+    for k in 0..frames {
+        if k % 25 == 0 {
+            cx.speakers(0.0)?;
+        }
+        let t = at + k as f64 / ASD_FPS;
+        let (rgba, fw, fh) = (w.frame)(t)?;
+        let img = Image::new(&rgba, fw, fh).map_err(|e| EngineError::Other(e.to_string()))?;
+        for (c, rs) in crops.iter_mut().zip(&rects) {
+            match rs[k] {
+                Some(r) => c.extend(nets::face_crop(&img, &r)),
+                None => c.extend(std::iter::repeat_n(0.0, nets::CROP * nets::CROP)),
+            }
+        }
+    }
+    let audio = mfcc_rows(&(w.audio)(at, audio_len(frames)), frames);
+    // the faces are independent: score them side by side
+    let scored = par::par_map(
+        ids.len(),
+        par::workers().min(ids.len()),
+        &|j| nets.speak(&crops[j], &audio, frames).map(|l| l.iter().map(|v| 1.0 / (1.0 + (-v).exp())).collect::<Vec<f32>>()),
+        &mut |_| cx.speakers(0.0).is_ok(),
+    )
+    .map_err(par_error)?;
+    Ok(Some(gate::Win { at, frames, probs: ids.iter().copied().zip(scored).collect() }))
+}
+
+/// MFCC rows (4 per video frame) for `frames` frames of the clip from `at` seconds.
+fn audio_len(frames: usize) -> usize {
+    (frames as f64 / ASD_FPS * filmcraft_reframe::mfcc::SAMPLE_RATE as f64) as usize + 800
+}
+
+/// `n` mono samples of the clip from `at` seconds (silence where it cannot be read).
+fn read_mono(w: &Work, at: f64, n: usize) -> Vec<f32> {
+    let sr = filmcraft_reframe::mfcc::SAMPLE_RATE;
+    let media = w.item.source_time_at(w.item.start + Tick::from_seconds_f64(at)).seconds().max(0.0);
+    match w.src.audio((media * sr as f64) as i64, n, sr as u32) {
+        Ok(b) => filmcraft_speech::downmix(&b.channels),
+        Err(_) => vec![0.0; n],
+    }
+}
+
+fn mfcc_rows(mono: &[f32], frames: usize) -> Vec<f32> {
+    let mut m = filmcraft_reframe::mfcc::mfcc(mono);
+    let want = 4 * frames * filmcraft_reframe::mfcc::NUM_CEP;
+    if m.len() < want {
+        let last: Vec<f32> = m.iter().rev().take(filmcraft_reframe::mfcc::NUM_CEP).rev().copied().collect();
+        let last = if last.len() == filmcraft_reframe::mfcc::NUM_CEP { last } else { vec![0.0; filmcraft_reframe::mfcc::NUM_CEP] };
+        while m.len() < want {
+            m.extend_from_slice(&last);
+        }
+    }
+    m.truncate(want);
+    m
+}
+
+fn centred(w: &Work, aspect: Aspect) -> ClipPlan {
+    let _ = aspect;
+    let end = w.item.duration.seconds();
+    let k = Key { t: 0.0, cx: 0.5, cy: 0.5 };
+    ClipPlan {
+        clip: w.clip,
+        name: w.name.clone(),
+        size: w.size,
+        shots: vec![ShotPlan { start: 0.0, end, keys: vec![k] }],
+        found: [0, 0, 0, 1],
+        speaker_samples: 0,
+    }
+}
+
+fn plan_clip(w: &Work, a: Analysis, aspect: Aspect) -> ClipPlan {
+    let crop = aspect.crop(w.size.0 as f32, w.size.1 as f32);
+    let mut found = [0usize; 4];
+    let mut speaker_samples = 0;
+    let samples: Vec<Sample> = (0..a.times.len())
+        .map(|i| {
+            let subjects: Vec<Subject> =
+                a.dets[i].iter().enumerate().map(|(j, d)| Subject { id: a.ids[i][j], rect: d.rect, kind: d.kind, speaking: a.speaking[i][j] }).collect();
+            let best = a.dets[i].iter().map(|d| d.kind).min();
+            found[best.map_or(3, |k| k as usize)] += 1;
+            speaker_samples += usize::from(subjects.iter().any(|s| s.speaking > 0.7) && subjects.len() > 1);
+            Sample { t: a.times[i], subjects }
+        })
+        .collect();
+    // the camera cuts at the scene cuts and where the speaker changes (a hard re-target, not a pan)
+    let mut inner: Vec<f64> = a.cuts.iter().chain(a.turns.iter()).copied().collect();
+    inner.sort_by(f64::total_cmp);
+    let mut bounds = vec![0.0];
+    bounds.extend(inner);
+    bounds.push(a.dur);
+    let opts = plan::Options { tolerance: 0.004, ..plan::Options::default() };
+    let shots = bounds
+        .windows(2)
+        .filter(|b| b[1] > b[0])
+        .map(|b| {
+            // where nobody is clearly speaking the subject chosen at the start stays until it leaves
+            let over: Vec<&gate::Seg> = a.segs.iter().filter(|g| g.t0 < b[1] && g.t1 > b[0]).collect();
+            let fixed = !over.is_empty() && over.iter().all(|g| g.who.is_none());
+            let o = plan::Options { hold: if fixed { f64::INFINITY } else { opts.hold }, ..opts };
+            ShotPlan { start: b[0], end: b[1], keys: plan::plan_shot(&samples, (b[0], b[1]), crop, &o) }
+        })
+        .collect();
+    ClipPlan { clip: w.clip, name: w.name.clone(), size: w.size, shots, found, speaker_samples }
+}
