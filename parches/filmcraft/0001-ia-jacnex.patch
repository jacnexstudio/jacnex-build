+#[path = "jacnex_vertical_tests.rs"]
+mod tests;
diff --git a/crates/ui-egui/src/jacnex_vertical_tests.rs b/crates/ui-egui/src/jacnex_vertical_tests.rs
new file mode 100644
index 0000000..773ad45
--- /dev/null
+++ b/crates/ui-egui/src/jacnex_vertical_tests.rs
@@ -0,0 +1,43 @@
+//! Jacnex: Pasar a vertical, los ajustes y el aviso cuando falta algo.
+
+use filmcraft_engine::Session;
+
+use super::*;
+
+#[test]
+fn defaults_and_shapes() {
+    let mut v = Vertical::default();
+    assert_eq!(v.aspecto_id(), "9:16");
+    assert_eq!(v.forma(), Aspect::VERTICAL);
+    assert_eq!(v.forma_nube(), "9:16");
+    assert!(!v.en_nube());
+    v.aspecto = "4:5".into();
+    assert_eq!(v.forma(), Aspect::PORTRAIT);
+    assert_eq!(v.forma_nube(), "3:4", "kie.ai has no 4:5");
+    v.aspecto = "1:1".into();
+    assert_eq!(v.forma(), Aspect::SQUARE);
+    v.aspecto = "inventada".into();
+    assert_eq!(v.aspecto_id(), "9:16");
+    v.motor = "nube".into();
+    assert!(v.en_nube());
+    assert_eq!(v.resolucion_nube(), "720p");
+    v.alta = true;
+    assert_eq!(v.resolucion_nube(), "1080p");
+}
+
+#[test]
+fn without_a_sequence_or_models_it_says_why_and_starts_nothing() {
+    let mut app = FilmcraftApp::new(Session::default());
+    let f = falta_local(&app).expect("something is missing");
+    assert!(f == reframe_job::FALTA_MODELO || f == "Abre una secuencia con video.", "{f}");
+    ejecutar(&mut app);
+    let (ok, m) = app.jacnex_ia.vertical.aviso.clone().expect("a notice");
+    assert!(!ok && !m.is_empty());
+    assert!(!app.jacnex_ia.vertical.ocupado());
+    assert!(app.jacnex_ia.vertical.progreso().is_none());
+}
+
+#[test]
+fn the_missing_model_message_has_no_download_offer() {
+    assert_eq!(reframe_job::FALTA_MODELO, "Actualiza Filmnex desde Jacnex Studio para usar esta función.");
+}
