+/// Lo que se envía según el modo, y dónde va lo recibido.
+struct Preparado {
+    imagenes: Vec<Imagen>,
+    video: Option<(PathBuf, &'static str)>,
+    destino: Destino,
+}
+
+fn preparar(app: &FilmcraftApp) -> Result<Preparado, String> {
+    let solo = |destino| Preparado { imagenes: Vec::new(), video: None, destino };
+    match app.jacnex_ia.modo {
+        Modo::Texto => Ok(solo(Destino::Cabezal)),
+        Modo::Foto => {
+            let img = match &app.jacnex_ia.foto {
+                Some(ruta) => leer_foto(ruta)?,
+                None => {
+                    let sec = secuencia(app).ok_or("Elige una imagen o abre una secuencia.")?;
+                    ("cuadro.jpg".to_string(), "image/jpeg", cuadro(app, sec, app.session.playhead())?)
+                }
+            };
+            Ok(Preparado { imagenes: vec![img], video: None, destino: Destino::Cabezal })
+        }
+        Modo::Transicion => {
+            let c = corte_cercano(app).ok_or("Pon el cabezal cerca de un corte entre dos clips.")?;
+            let inicio = cuadro(app, c.secuencia, c.antes)?;
+            let fin = cuadro(app, c.secuencia, c.en)?;
+            Ok(Preparado {
+                imagenes: vec![("inicio.jpg".to_string(), "image/jpeg", inicio), ("final.jpg".to_string(), "image/jpeg", fin)],
+                video: None,
+                destino: Destino::Corte { secuencia: c.secuencia, pista: c.pista, en: c.en },
+            })
+        }
+        Modo::Voz | Modo::Musica | Modo::Efecto => Ok(solo(Destino::Audio { en: app.session.playhead() })),
+        Modo::Mejorar => {
+            let c = clip_a_mejorar(app, app.jacnex_ia.herramienta_actual().as_ref())?;
+            Ok(Preparado {
+                imagenes: Vec::new(),
+                video: Some((c.ruta, c.tipo)),
+                destino: Destino::Reemplazo { secuencia: c.secuencia, clip: c.clip, item: c.item },
+            })
+        }
+        // Jacnex: el clip reencuadrado llega como un clip nuevo en el cabezal (el original queda)
+        Modo::Vertical => {
+            let c = clip_a_mejorar(app, app.jacnex_ia.herramienta_actual().as_ref())?;
+            Ok(Preparado { imagenes: Vec::new(), video: Some((c.ruta, c.tipo)), destino: Destino::Cabezal })
+        }
+        Modo::Subtitulos | Modo::Silencios | Modo::Muletillas | Modo::PorTexto | Modo::Corta | Modo::Buscar | Modo::Doblaje => {
+            Err("Esta herramienta no usa la IA en línea.".into())
+        }
+    }
+}
