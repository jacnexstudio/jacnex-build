+#[test]
+fn place_imports_into_the_bin_when_the_sequence_was_deleted() {
+    let (mut s, clip, start) = session();
+    let made_for = s.state.active_sequence.unwrap();
+    s.execute("file.newSequence", json!({})).unwrap();
+    s.execute("project.delete", json!({"items": [made_for.0]})).unwrap();
+    if s.project.sequence(made_for).is_some() {
+        // the host did not let it go in this state: remove it directly (as a stale id can occur)
+        Arc::make_mut(&mut s.project).items.remove(&made_for);
+    }
+    assert!(s.project.sequence(made_for).is_none());
+    let items = s.project.items.len();
+    let undo = s.history.undo.len();
+    let r =
+        dub::place(&mut s, made_for, &dub::Dub { at: start, samples: &tone(2.0, 0.4), background: None, sources: &[clip], original: Original::Mute }).unwrap();
+    let dub::Placed::Bin(found) = r else { panic!("expected the bin, got {r:?}") };
+    assert_eq!(found.len(), 1);
+    assert_eq!(s.project.items.len(), items + 1);
+    assert!(s.project.items.contains_key(&found[0]));
+    assert_eq!(s.history.undo.len(), undo + 1, "one undo step");
+    s.undo().unwrap();
+    assert_eq!(s.project.items.len(), items);
+    assert!(
+        dub::place(&mut s, made_for, &dub::Dub { at: start, samples: &[], background: None, sources: &[], original: Original::Mute }).is_err(),
+        "bad audio is refused either way"
+    );
+}
