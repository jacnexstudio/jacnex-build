+//! Jacnex: search inside the footage ("Buscar en el material").
+//!
+//! - [`text`]: word search over transcripts (accents and case ignored, near-spellings, stop
+//!   words) and the transcript cut into sentence-sized [`text::Chunk`]s.
+//! - [`index`]: the per-media indexes ([`index::SpeechIndex`], [`index::VisualIndex`]) and their
+//!   on-disk cache, keyed by the file's identity (path, size, modification time). Cache files are
+//!   treated as hostile input.
+//! - [`rank`]: one query over many media: exact words, meaning (text embeddings) and image
+//!   (image-text embeddings) merged into ranked, time-ranged [`rank::Hit`]s.
+//! - [`catalog`]: the model folders the search looks for. Models are never downloaded here: the
+//!   Jacnex Studio launcher puts them next to Filmnex.
+//! - [`models`] (feature `models`): SigLIP 2 (images and text in one space) and Qwen3-Embedding
+//!   (meaning of what is said) on candle, pure Rust, on the CPU.
+
+#![cfg_attr(not(test), deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable))]
+
+pub mod catalog;
+pub mod index;
+#[cfg(feature = "models")]
+pub mod models;
+pub mod rank;
+pub mod text;
+
+/// Why a search step failed.
+#[derive(Debug, Clone, PartialEq, thiserror::Error)]
+pub enum SearchError {
+    #[error("stopped")]
+    Cancelled,
+    #[error("model: {0}")]
+    Model(String),
+    #[error("{0}")]
+    Io(String),
+    #[error("bad index file: {0}")]
+    BadIndex(String),
+}
+
+impl From<std::io::Error> for SearchError {
+    fn from(e: std::io::Error) -> Self {
+        SearchError::Io(e.to_string())
+    }
+}
+
+pub type Result<T> = std::result::Result<T, SearchError>;
+
+/// The version of the cache files: bump it when what is stored (or how it is computed) changes.
+pub const INDEX_VERSION: u32 = 1;
