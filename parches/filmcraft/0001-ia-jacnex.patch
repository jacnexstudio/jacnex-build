@@ -0,0 +1,463 @@
+//! The neural models, on candle (pure Rust, CPU): SigLIP 2 for pictures and short texts, and
+//! Qwen3-Embedding for the meaning of what is said.
+//!
+//! The weights are read tensor by tensor from the model folder (never memory-mapped, never
+//! executed): the header of a `.safetensors` file is checked against the file's size before any
+//! byte is read, and only the tensors a tower needs are loaded. Tokenizers are the pure-Rust
+//! `tokenizers` crate reading `tokenizer.json`.
+
+use std::collections::HashMap;
+use std::io::{Read, Seek, SeekFrom};
+use std::path::Path;
+
+use candle_core::{DType, Device, Module, Tensor};
+use candle_nn::VarBuilder;
+use candle_transformers::models::{qwen3, siglip};
+use serde::Deserialize;
+use tokenizers::Tokenizer;
+
+use crate::index::normalize;
+use crate::{Result, SearchError};
+
+fn err<E: std::fmt::Display>(what: &'static str) -> impl FnOnce(E) -> SearchError {
+    move |e| SearchError::Model(format!("{what}: {e}"))
+}
+
+/// Largest `.safetensors` header read (bytes).
+const MAX_ST_HEADER: u64 = 64 * 1024 * 1024;
+/// Largest tensor read (bytes).
+const MAX_TENSOR_BYTES: u64 = 3 * 1024 * 1024 * 1024;
+/// Largest `config.json` read (bytes).
+const MAX_CONFIG: u64 = 1024 * 1024;
+
+#[derive(Deserialize)]
+struct StEntry {
+    dtype: String,
+    shape: Vec<usize>,
+    data_offsets: [u64; 2],
+}
+
+/// Reads the tensors of `path` that `pick` renames (None: skip), as f32 on the CPU.
+fn load_tensors(path: &Path, pick: &dyn Fn(&str) -> Option<String>) -> Result<HashMap<String, Tensor>> {
+    let mut f = std::fs::File::open(path).map_err(err("open weights"))?;
+    let len = f.metadata().map_err(err("weights size"))?.len();
+    let mut n = [0u8; 8];
+    f.read_exact(&mut n).map_err(err("weights header"))?;
+    let hlen = u64::from_le_bytes(n);
+    if hlen == 0 || hlen > MAX_ST_HEADER || hlen.saturating_add(8) > len {
+        return Err(SearchError::Model("bad weights header".into()));
+    }
+    let mut head = vec![0u8; hlen as usize];
+    f.read_exact(&mut head).map_err(err("weights header"))?;
+    let table: HashMap<String, serde_json::Value> = serde_json::from_slice(&head).map_err(err("weights header"))?;
+    let base = 8 + hlen;
+    let mut out = HashMap::new();
+    for (name, v) in table {
+        if name == "__metadata__" {
+            continue;
+        }
+        let Some(new) = pick(&name) else { continue };
+        let e: StEntry = serde_json::from_value(v).map_err(err("weights entry"))?;
+        let (dt, size) = match e.dtype.as_str() {
+            "F32" => (DType::F32, 4u64),
+            "F16" => (DType::F16, 2),
+            "BF16" => (DType::BF16, 2),
+            other => return Err(SearchError::Model(format!("weights of type {other} are not supported"))),
+        };
+        let count = e.shape.iter().try_fold(1u64, |a, d| a.checked_mul(*d as u64)).ok_or_else(|| SearchError::Model("bad tensor shape".into()))?;
+        let bytes = count.checked_mul(size).ok_or_else(|| SearchError::Model("bad tensor shape".into()))?;
+        let [a, b] = e.data_offsets;
+        if b < a || b - a != bytes || bytes > MAX_TENSOR_BYTES || base.checked_add(b).is_none_or(|end| end > len) {
+            return Err(SearchError::Model("tensor outside the file".into()));
+        }
+        f.seek(SeekFrom::Start(base + a)).map_err(err("seek weights"))?;
+        let mut buf = vec![0u8; bytes as usize];
+        f.read_exact(&mut buf).map_err(err("read weights"))?;
+        let t = Tensor::from_raw_buffer(&buf, dt, &e.shape, &Device::Cpu).map_err(err("tensor"))?;
+        let t = if dt == DType::F32 { t } else { t.to_dtype(DType::F32).map_err(err("tensor"))? };
+        out.insert(new, t);
+    }
+    Ok(out)
+}
+
+fn read_config(dir: &Path) -> Result<String> {
+    let mut s = String::new();
+    std::fs::File::open(dir.join("config.json")).map_err(err("config"))?.take(MAX_CONFIG).read_to_string(&mut s).map_err(err("config"))?;
+    Ok(s)
+}
+
+fn tokenizer(dir: &Path) -> Result<Tokenizer> {
+    let p = dir.join("tokenizer.json");
+    if std::fs::metadata(&p).map_err(err("tokenizer"))?.len() > 128 * 1024 * 1024 {
+        return Err(SearchError::Model("tokenizer too large".into()));
+    }
+    Tokenizer::from_file(p).map_err(|e| SearchError::Model(format!("tokenizer: {e}")))
+}
+
+fn to_vec(t: &Tensor) -> Result<Vec<f32>> {
+    t.flatten_all().and_then(|t| t.to_vec1::<f32>()).map_err(err("result"))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Pictures
+
+/// One picture to embed: RGBA8, row by row.
+pub struct Picture<'a> {
+    pub rgba: &'a [u8],
+    pub width: usize,
+    pub height: usize,
+}
+
+/// The widest side a picture may have.
+const MAX_SIDE: usize = 16384;
+
+/// For each of `out` samples, the input samples it averages and their weights (triangle filter,
+/// widened when shrinking: what an image library calls antialiased bilinear).
+fn coefficients(input: usize, out: usize) -> Vec<(usize, Vec<f32>)> {
+    #[allow(clippy::cast_precision_loss)]
+    let scale = input as f32 / out as f32;
+    let support = scale.max(1.0);
+    (0..out)
+        .map(|o| {
+            #[allow(clippy::cast_precision_loss)]
+            let center = (o as f32 + 0.5) * scale;
+            let lo = ((center - support).floor().max(0.0)) as usize;
+            let hi = (((center + support).ceil()) as usize).min(input);
+            let mut w: Vec<f32> = (lo..hi)
+                .map(|i| {
+                    #[allow(clippy::cast_precision_loss)]
+                    let x = ((i as f32 + 0.5) - center) / support;
+                    (1.0 - x.abs()).max(0.0)
+                })
+                .collect();
+            let s: f32 = w.iter().sum();
+            if s > 0.0 {
+                w.iter_mut().for_each(|x| *x /= s);
+            } else if let Some(x) = w.first_mut() {
+                *x = 1.0;
+            }
+            (lo, w)
+        })
+        .collect()
+}
+
+/// `p` squashed to `side`×`side`, as channel-first numbers from -1 to 1 (what SigLIP takes).
+pub fn preprocess(p: &Picture, side: usize) -> Result<Vec<f32>> {
+    let bad = || SearchError::Model("bad picture".into());
+    if p.width == 0 || p.height == 0 || p.width > MAX_SIDE || p.height > MAX_SIDE || side == 0 || side > 2048 {
+        return Err(bad());
+    }
+    if p.rgba.len() != p.width.checked_mul(p.height).and_then(|n| n.checked_mul(4)).ok_or_else(bad)? {
+        return Err(bad());
+    }
+    let cx = coefficients(p.width, side);
+    let cy = coefficients(p.height, side);
+    // horizontal: height rows of `side` pixels, 3 channels
+    let mut mid = vec![0f32; p.height * side * 3];
+    for y in 0..p.height {
+        let row = p.rgba.get(y * p.width * 4..(y + 1) * p.width * 4).ok_or_else(bad)?;
+        for (x, (lo, ws)) in cx.iter().enumerate() {
+            let mut acc = [0f32; 3];
+            for (k, w) in ws.iter().enumerate() {
+                let px = row.get((lo + k) * 4..(lo + k) * 4 + 3).ok_or_else(bad)?;
+                for (c, a) in acc.iter_mut().enumerate() {
+                    *a += w * f32::from(px.get(c).copied().unwrap_or(0));
+                }
+            }
+            let o = (y * side + x) * 3;
+            mid.get_mut(o..o + 3).ok_or_else(bad)?.copy_from_slice(&acc);
+        }
+    }
+    let plane = side * side;
+    let mut out = vec![0f32; 3 * plane];
+    for (y, (lo, ws)) in cy.iter().enumerate() {
+        for x in 0..side {
+            let mut acc = [0f32; 3];
+            for (k, w) in ws.iter().enumerate() {
+                let o = ((lo + k) * side + x) * 3;
+                let px = mid.get(o..o + 3).ok_or_else(bad)?;
+                for (c, a) in acc.iter_mut().enumerate() {
+                    *a += w * px.get(c).copied().unwrap_or(0.0);
+                }
+            }
+            for (c, a) in acc.iter().enumerate() {
+                // (v / 255 - 0.5) / 0.5
+                if let Some(d) = out.get_mut(c * plane + y * side + x) {
+                    *d = (a / 255.0 - 0.5) / 0.5;
+                }
+            }
+        }
+    }
+    Ok(out)
+}
+
+fn siglip_config(dir: &Path) -> Result<siglip::Config> {
+    let c: siglip::Config = serde_json::from_str(&read_config(dir)?).map_err(err("config"))?;
+    let (v, t) = (&c.vision_config, &c.text_config);
+    let ok = v.image_size > 0
+        && v.image_size <= 1024
+        && v.patch_size > 0
+        && v.hidden_size > 0
+        && v.hidden_size <= 4096
+        && v.num_hidden_layers <= 64
+        && v.num_attention_heads > 0
+        && v.hidden_size % v.num_attention_heads == 0
+        && t.hidden_size > 0
+        && t.hidden_size <= 4096
+        && t.num_hidden_layers <= 64
+        && t.num_attention_heads > 0
+        && t.hidden_size % t.num_attention_heads == 0
+        && t.max_position_embeddings > 0
+        && t.max_position_embeddings <= 256
+        && t.vocab_size <= 1_000_000;
+    if ok { Ok(c) } else { Err(SearchError::Model("unsupported model configuration".into())) }
+}
+
+fn scalar(tensors: &HashMap<String, Tensor>, name: &str) -> Result<f32> {
+    let t = tensors.get(name).ok_or_else(|| SearchError::Model(format!("weights without {name}")))?;
+    to_vec(t)?.first().copied().filter(|x| x.is_finite()).ok_or_else(|| SearchError::Model(format!("bad {name}")))
+}
+
+/// SigLIP 2's picture tower: pictures in, vectors of length 1 out.
+pub struct PictureModel {
+    vision: siglip::VisionModel,
+    side: usize,
+    dim: usize,
+}
+
+impl PictureModel {
+    /// Loads the picture tower from the model folder `dir`.
+    pub fn load(dir: &Path) -> Result<PictureModel> {
+        let cfg = siglip_config(dir)?;
+        let tensors = load_tensors(&dir.join("model.safetensors"), &|n| n.strip_prefix("vision_model.").map(|_| n.to_string()))?;
+        let vb = VarBuilder::from_tensors(tensors, DType::F32, &Device::Cpu);
+        let vision = siglip::VisionModel::new(&cfg.vision_config, true, vb.pp("vision_model")).map_err(err("picture model"))?;
+        Ok(PictureModel { vision, side: cfg.vision_config.image_size, dim: cfg.vision_config.hidden_size })
+    }
+
+    pub fn dim(&self) -> usize {
+        self.dim
+    }
+
+    pub fn side(&self) -> usize {
+        self.side
+    }
+
+    /// The vectors (length 1) of `pictures`.
+    pub fn embed(&self, pictures: &[Picture]) -> Result<Vec<Vec<f32>>> {
+        if pictures.is_empty() {
+            return Ok(Vec::new());
+        }
+        let mut data = Vec::with_capacity(pictures.len() * 3 * self.side * self.side);
+        for p in pictures {
+            data.extend(preprocess(p, self.side)?);
+        }
+        let x = Tensor::from_vec(data, (pictures.len(), 3, self.side, self.side), &Device::Cpu).map_err(err("input"))?;
+        let y = self.vision.forward(&x).map_err(err("picture model"))?;
+        let flat = to_vec(&y)?;
+        let d = flat.len() / pictures.len();
+        if d != self.dim {
+            return Err(SearchError::Model("unexpected output size".into()));
+        }
+        Ok(flat
+            .chunks_exact(d)
+            .map(|c| {
+                let mut v = c.to_vec();
+                normalize(&mut v);
+                v
+            })
+            .collect())
+    }
+}
+
+/// Longest text SigLIP takes, in tokens.
+const SIGLIP_TOKENS: usize = 64;
+
+/// SigLIP 2's text tower: a short text in, a vector of length 1 in the pictures' space out.
+pub struct PictureText {
+    text: siglip::TextModel,
+    tok: Tokenizer,
+    scale: f32,
+    bias: f32,
+}
+
+impl PictureText {
+    pub fn load(dir: &Path) -> Result<PictureText> {
+        let cfg = siglip_config(dir)?;
+        let tensors = load_tensors(&dir.join("model.safetensors"), &|n| {
+            (n.starts_with("text_model.") || n == "logit_scale" || n == "logit_bias").then(|| n.to_string())
+        })?;
+        let scale = scalar(&tensors, "logit_scale")?.exp();
+        let bias = scalar(&tensors, "logit_bias")?;
+        let vb = VarBuilder::from_tensors(tensors, DType::F32, &Device::Cpu);
+        let text = siglip::TextModel::new(&cfg.text_config, vb.pp("text_model")).map_err(err("text model"))?;
+        Ok(PictureText { text, tok: tokenizer(dir)?, scale, bias })
+    }
+
+    /// The model's scale and bias for the cosine (`sigmoid(scale * cos + bias)`).
+    pub fn logit(&self) -> (f32, f32) {
+        (self.scale, self.bias)
+    }
+
+    pub fn embed(&self, text: &str) -> Result<Vec<f32>> {
+        let enc = self.tok.encode(text.to_lowercase(), true).map_err(|e| SearchError::Model(format!("tokenizer: {e}")))?;
+        let mut ids: Vec<u32> = enc.get_ids().iter().copied().filter(|i| *i != 0).collect();
+        if ids.len() > SIGLIP_TOKENS {
+            ids.truncate(SIGLIP_TOKENS - 1);
+            ids.push(1);
+        }
+        ids.resize(SIGLIP_TOKENS, 0);
+        let x = Tensor::from_vec(ids, (1, SIGLIP_TOKENS), &Device::Cpu).map_err(err("input"))?;
+        let y = self.text.forward(&x).map_err(err("text model"))?;
+        let mut v = to_vec(&y)?;
+        normalize(&mut v);
+        Ok(v)
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Meaning
+
+/// Longest text the meaning model reads, in tokens.
+const MEANING_TOKENS: usize = 192;
+/// What the model is told to do with a question (it is trained with this).
+const INSTRUCTION: &str = "Given a search query, retrieve the passage of a video transcript that answers it";
+
+/// Qwen3-Embedding: a sentence in, a vector of length 1 out.
+pub struct MeaningModel {
+    model: qwen3::Model,
+    tok: Tokenizer,
+    dim: usize,
+}
+
+impl MeaningModel {
+    pub fn load(dir: &Path) -> Result<MeaningModel> {
+        let cfg: qwen3::Config = serde_json::from_str(&read_config(dir)?).map_err(err("config"))?;
+        let ok = cfg.hidden_size > 0
+            && cfg.hidden_size <= 8192
+            && cfg.num_hidden_layers > 0
+            && cfg.num_hidden_layers <= 96
+            && cfg.head_dim > 0
+            && cfg.head_dim <= 512
+            && cfg.num_attention_heads > 0
+            && cfg.num_key_value_heads > 0
+            && cfg.num_attention_heads.is_multiple_of(cfg.num_key_value_heads)
+            && cfg.max_position_embeddings > 0
+            && cfg.max_position_embeddings <= 262_144
+            && cfg.vocab_size > 0
+            && cfg.vocab_size <= 1_000_000;
+        if !ok {
+            return Err(SearchError::Model("unsupported model configuration".into()));
+        }
+        // the embedding checkpoint has no "model." prefix; the candle model asks for one
+        let tensors =
+            load_tensors(&dir.join("model.safetensors"), &|n| (!n.starts_with("lm_head")).then(|| format!("model.{}", n.trim_start_matches("model."))))?;
+        let vb = VarBuilder::from_tensors(tensors, DType::F32, &Device::Cpu);
+        let model = qwen3::Model::new(&cfg, vb).map_err(err("meaning model"))?;
+        Ok(MeaningModel { model, tok: tokenizer(dir)?, dim: cfg.hidden_size })
+    }
+
+    pub fn dim(&self) -> usize {
+        self.dim
+    }
+
+    /// The vector of `text` (a passage), or of a question when `query`.
+    pub fn embed(&self, text: &str, query: bool) -> Result<Vec<f32>> {
+        let text = if query { format!("Instruct: {INSTRUCTION}\nQuery:{text}") } else { text.to_string() };
+        let enc = self.tok.encode(text, true).map_err(|e| SearchError::Model(format!("tokenizer: {e}")))?;
+        let mut ids: Vec<u32> = enc.get_ids().to_vec();
+        if ids.is_empty() {
+            return Err(SearchError::Model("empty text".into()));
+        }
+        if ids.len() > MEANING_TOKENS {
+            let eos = ids.last().copied().unwrap_or(0);
+            ids.truncate(MEANING_TOKENS - 1);
+            ids.push(eos);
+        }
+        let n = ids.len();
+        let x = Tensor::from_vec(ids, (1, n), &Device::Cpu).map_err(err("input"))?;
+        // a fresh copy: the model keeps attention state between calls
+        let mut m = self.model.clone();
+        let h = m.forward(&x, 0).map_err(err("meaning model"))?;
+        let last = h.narrow(1, n - 1, 1).map_err(err("result"))?;
+        let mut v = to_vec(&last)?;
+        normalize(&mut v);
+        Ok(v)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn preprocess_squashes_and_scales_to_minus_one_one() {
+        let (w, h) = (8usize, 4usize);
+        let mut rgba = vec![255u8; w * h * 4];
+        for px in rgba.as_chunks_mut::<4>().0 {
+            px[0] = 0;
+        }
+        let v = preprocess(&Picture { rgba: &rgba, width: w, height: h }, 4).unwrap();
+        assert_eq!(v.len(), 3 * 16);
+        assert!(v[..16].iter().all(|x| (*x + 1.0).abs() < 1e-5));
+        assert!(v[16..].iter().all(|x| (*x - 1.0).abs() < 1e-5));
+    }
+
+    #[test]
+    fn preprocess_refuses_bad_pictures() {
+        assert!(preprocess(&Picture { rgba: &[0; 8], width: 2, height: 2 }, 4).is_err());
+        assert!(preprocess(&Picture { rgba: &[], width: 0, height: 0 }, 4).is_err());
+        assert!(preprocess(&Picture { rgba: &[0; 16], width: 2, height: 2 }, 0).is_err());
+        assert!(preprocess(&Picture { rgba: &[0; 16], width: usize::MAX, height: 2 }, 4).is_err());
+    }
+
+    #[test]
+    fn weights_files_are_checked_before_they_are_read() {
+        let d = tempfile::tempdir().unwrap();
+        let p = d.path().join("m.safetensors");
+        let all = |_: &str| Some("x".to_string());
+        std::fs::write(&p, b"").unwrap();
+        assert!(load_tensors(&p, &all).is_err());
+        // header longer than the file
+        std::fs::write(&p, 1000u64.to_le_bytes()).unwrap();
+        assert!(load_tensors(&p, &all).is_err());
+        // a tensor that claims more bytes than the file has
+        let head = br#"{"a":{"dtype":"F32","shape":[1000000],"data_offsets":[0,4000000]}}"#;
+        let mut f = (head.len() as u64).to_le_bytes().to_vec();
+        f.extend_from_slice(head);
+        f.extend_from_slice(&[0u8; 16]);
+        std::fs::write(&p, &f).unwrap();
+        assert!(load_tensors(&p, &all).is_err());
+        // a shape that overflows
+        let head = br#"{"a":{"dtype":"F32","shape":[4294967296,4294967296,4294967296],"data_offsets":[0,4]}}"#;
+        let mut f = (head.len() as u64).to_le_bytes().to_vec();
+        f.extend_from_slice(head);
+        f.extend_from_slice(&[0u8; 16]);
+        std::fs::write(&p, &f).unwrap();
+        assert!(load_tensors(&p, &all).is_err());
+        // a good one
+        let head = br#"{"a":{"dtype":"F32","shape":[2],"data_offsets":[0,8]}}"#;
+        let mut f = (head.len() as u64).to_le_bytes().to_vec();
+        f.extend_from_slice(head);
+        f.extend_from_slice(&1f32.to_le_bytes());
+        f.extend_from_slice(&2f32.to_le_bytes());
+        std::fs::write(&p, &f).unwrap();
+        let t = load_tensors(&p, &all).unwrap();
+        assert_eq!(t["x"].to_vec1::<f32>().unwrap(), vec![1.0, 2.0]);
+        // an unsupported type
+        let head = br#"{"a":{"dtype":"I64","shape":[1],"data_offsets":[0,8]}}"#;
+        let mut f = (head.len() as u64).to_le_bytes().to_vec();
+        f.extend_from_slice(head);
+        f.extend_from_slice(&[0u8; 8]);
+        std::fs::write(&p, &f).unwrap();
+        assert!(load_tensors(&p, &all).is_err());
+    }
+
+    #[test]
+    fn a_missing_model_folder_is_an_error_not_a_panic() {
+        let d = tempfile::tempdir().unwrap();
+        assert!(PictureModel::load(d.path()).is_err());
+        assert!(PictureText::load(d.path()).is_err());
+        assert!(MeaningModel::load(d.path()).is_err());
+    }
+}
