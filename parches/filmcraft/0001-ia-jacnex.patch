+use std::io::{BufRead, BufReader, Read, Write};
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use filmcraft_engine::Session;
+use serde_json::json;
+
+use super::*;
+use crate::FilmcraftApp;
+use crate::jacnex_edicion::{Despues, ejecutar};
+
+/// Lo que dice cada parte: (palabra, inicio s, fin s, hablante), en el tiempo de la parte.
+fn resultado() -> Value {
+    json!({"text": "Hola, a todos.", "duration": 60.0, "words": [
+        {"word": "Hola", "start": 0.5, "end": 0.9, "speaker": "speaker_0"},
+        {"word": "a", "start": 1.0, "end": 1.1, "speaker": "speaker_1"},
+        {"word": "todos", "start": 1.2, "end": 1.6, "speaker": "speaker_0"},
+        {"word": "", "start": 2.0, "end": 2.1},
+        {"word": "malo", "start": -1.0, "end": 0.1},
+        {"word": "al revés", "start": 3.0, "end": 2.0},
+        {"word": "sin tiempo"}
+    ]})
+}
+
+/// Un /v1/jacnex falso que transcribe: guarda cada cuerpo recibido en `/v1/jacnex/generar`.
+fn servidor() -> (String, Arc<Mutex<Vec<Vec<u8>>>>) {
+    let l = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+    let base = format!("http://127.0.0.1:{}", l.local_addr().unwrap().port());
+    let recibido = Arc::new(Mutex::new(Vec::new()));
+    let (r2, base2) = (recibido.clone(), base.clone());
+    std::thread::spawn(move || {
+        for s in l.incoming() {
+            let Ok(mut s) = s else { continue };
+            let mut lector = BufReader::new(s.try_clone().unwrap());
+            let mut linea = String::new();
+            if lector.read_line(&mut linea).is_err() {
+                continue;
+            }
+            let mut largo = 0usize;
+            loop {
+                let mut h = String::new();
+                if lector.read_line(&mut h).unwrap_or(0) == 0 || h.trim_end().is_empty() {
+                    break;
+                }
+                if let Some(v) = h.to_ascii_lowercase().strip_prefix("content-length:") {
+                    largo = v.trim().parse().unwrap();
+                }
+            }
+            let mut cuerpo = vec![0; largo];
+            let _ = lector.read_exact(&mut cuerpo);
+            let ruta = linea.split_whitespace().nth(1).unwrap_or("").to_string();
+            let datos = if ruta == "/v1/jacnex/generar" {
+                let mut r = r2.lock().unwrap();
+                r.push(cuerpo);
+                json!({"id": format!("t{}", r.len()), "creditos": 1, "saldo": 99})
+            } else if let Some(id) = ruta.strip_prefix("/v1/jacnex/trabajo/") {
+                json!({"estado": "listo", "resultados": [format!("{base2}/r/{id}.json")]})
+            } else if ruta == "/v1/jacnex/estado" {
+                json!({"nombre": "Prueba", "creditos": 100, "transcripciones": [
+                    {"id": MODELO, "nombre": "Nemotron 3.5 Transcribe", "creditosPorMinuto": 0.3, "maxSegundos": 1500, "maxMegas": 50}]})
+            } else {
+                resultado()
+            };
+            let datos = datos.to_string().into_bytes();
+            let _ = write!(s, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", datos.len());
+            let _ = s.write_all(&datos);
+        }
+    });
+    (base, recibido)
+}
+
+fn conexion(base: &str) -> Conexion {
+    let mut app = FilmcraftApp::new(Session::default());
+    assert!(crate::jacnex_ia::usar_servidor_local(&mut app, base, "jk_prueba"));
+    crate::jacnex_ia::conexion(&app.jacnex_ia).unwrap()
+}
+
+fn contiene(cuerpo: &[u8], texto: &str) -> bool {
+    cuerpo.windows(texto.len()).any(|w| w == texto.as_bytes())
+}
+
+#[test]
+fn the_wav_is_16_bit_mono_16k_with_clamped_samples() {
+    let w = wav(&[0.0, 1.0, -2.0, f32::NAN, 0.5]);
+    assert_eq!(w.len(), 44 + 10);
+    assert_eq!(&w[0..4], b"RIFF");
+    assert_eq!(&w[8..16], b"WAVEfmt ");
+    assert_eq!(u32::from_le_bytes(w[24..28].try_into().unwrap()), 16_000);
+    assert_eq!(u32::from_le_bytes(w[28..32].try_into().unwrap()), 32_000, "byte rate");
+    assert_eq!(u16::from_le_bytes(w[32..34].try_into().unwrap()), 2, "block align");
+    assert_eq!(u32::from_le_bytes(w[40..44].try_into().unwrap()), 10);
+    let m: Vec<i16> = w[44..].chunks(2).map(|c| i16::from_le_bytes([c[0], c[1]])).collect();
+    assert_eq!(m, [0, 32767, -32767, 0, 16384]);
+}
+
+#[test]
+fn the_price_matches_the_server_one_credit_minimum_per_part() {
+    let p = Plan::de(None);
+    assert_eq!(p, Plan { parte: 20 * 60, por_minuto: 30 });
+    assert_eq!(p.creditos(0.0), 0);
+    assert_eq!(p.creditos(f64::NAN), 0);
+    assert_eq!(p.creditos(5.0), 1);
+    assert_eq!(p.creditos(90.0), 1);
+    assert_eq!(p.creditos(600.0), 3);
+    assert_eq!(p.creditos(1200.0), 6);
+    // 25 minutos = una parte de 20 (6) y otra de 5 (2)
+    assert_eq!(p.creditos(1500.0), 8);
+    // 2 horas: 6 partes de 20 minutos
+    assert_eq!(p.creditos(7200.0), 36);
+    let m = |s: u32, mb: u64| MotorNube { id: MODELO.into(), nombre: String::new(), por_minuto: 30, max_segundos: s, max_megas: mb };
+    assert_eq!(Plan::de(Some(&m(1500, 50))).parte, 1200);
+    assert_eq!(Plan::de(Some(&m(600, 50))).parte, 600);
+    assert_eq!(Plan::de(Some(&m(1500, 10))).parte, 327, "10 MB of 16-bit 16 kHz mono");
+    assert_eq!(Plan::de(Some(&m(1500, 1))).parte, 60, "never less than a minute");
+}
+
+#[test]
+fn words_take_the_punctuation_of_the_text_and_skip_bad_entries() {
+    let mut hablantes = Vec::new();
+    let mut palabras = Vec::new();
+    leer(&resultado(), 60.0, 61.2, &mut hablantes, &mut palabras);
+    let textos: Vec<&str> = palabras.iter().map(|w| w.text.as_str()).collect();
+    assert_eq!(textos, ["Hola,", "a", "todos."]);
+    assert_eq!(palabras[0].start, seconds_tick(60.5));
+    assert_eq!(palabras[0].end, seconds_tick(60.9));
+    // no pasa del final de la parte
+    assert_eq!(palabras[2].start, seconds_tick(61.2));
+    assert_eq!(palabras[2].end, seconds_tick(61.2));
+    assert_eq!(palabras.iter().map(|w| w.speaker).collect::<Vec<_>>(), [Some(0), Some(1), Some(0)]);
+    assert_eq!(hablantes, ["speaker_0", "speaker_1"]);
+    // sin «words» o con basura: nada
+    leer(&json!({"words": "x"}), 0.0, 10.0, &mut hablantes, &mut palabras);
+    leer(&json!([1, 2]), 0.0, 10.0, &mut hablantes, &mut palabras);
+    assert_eq!(palabras.len(), 3);
+}
+
+#[test]
+fn the_language_is_guessed_from_common_words() {
+    let w = |t: &str| t.split(' ').map(|p| Word::new(p, filmcraft_time::Tick(0), filmcraft_time::Tick(1))).collect::<Vec<_>>();
+    assert_eq!(idioma(&w("hola que tal es una prueba para el canal")), "es");
+    assert_eq!(idioma(&w("this is the test and it works for you")), "en");
+    assert_eq!(idioma(&w("você não está com isso também")), "pt");
+    assert_eq!(idioma(&[]), "es");
+}
+
+#[test]
+fn long_audio_goes_in_parts_and_word_times_follow_each_part() {
+    let (base, recibido) = servidor();
+    let t = Nemotron { conexion: conexion(&base), plan: Plan { parte: 60, por_minuto: 30 } };
+    let audio = vec![0.01f32; 90 * 16_000];
+    let opts = Options { language: None, diarize: true, max_speakers: 6 };
+    let mut avance = Vec::new();
+    let tr = t.transcribe(&audio, &opts, &mut |f, _| {
+        avance.push(f);
+        true
+    });
+    let tr = tr.unwrap();
+    let cuerpos = recibido.lock().unwrap();
+    assert_eq!(cuerpos.len(), 2, "60 s + 30 s");
+    for (c, segundos) in cuerpos.iter().zip([60usize, 30]) {
+        assert!(contiene(c, "name=\"model\"\r\n\r\nnemotron-transcribe\r\n"));
+        assert!(contiene(c, "name=\"audio\"; filename=\"audio.wav\"\r\nContent-Type: audio/wav\r\n"));
+        let wav_largo = 44 + segundos * 16_000 * 2;
+        assert!(c.len() > wav_largo && c.len() < wav_largo + 1024, "{} bytes", c.len());
+    }
+    assert_eq!(tr.source, FUENTE);
+    assert_eq!(tr.language, "es", "guessed: Nemotron does not say");
+    let tiempos: Vec<_> = tr.words.iter().map(|w| (w.text.as_str(), w.start)).collect();
+    assert_eq!(
+        tiempos,
+        [
+            ("Hola,", seconds_tick(0.5)),
+            ("a", seconds_tick(1.0)),
+            ("todos.", seconds_tick(1.2)),
+            ("Hola,", seconds_tick(60.5)),
+            ("a", seconds_tick(61.0)),
+            ("todos.", seconds_tick(61.2))
+        ]
+    );
+    assert_eq!(tr.speakers.len(), 2);
+    assert!(avance.windows(2).all(|w| w[0] <= w[1]) && avance.iter().all(|f| (0.0..1.0).contains(f)), "{avance:?}");
+}
+
+#[test]
+fn without_speaker_labels_every_word_is_speaker_one_and_the_language_is_kept() {
+    let (base, _) = servidor();
+    let t = Nemotron { conexion: conexion(&base), plan: Plan::de(None) };
+    let opts = Options { language: Some("pt".into()), diarize: false, max_speakers: 6 };
+    let tr = t.transcribe(&vec![0.0f32; 16_000 * 3], &opts, &mut |_, _| true).unwrap();
+    assert_eq!(tr.language, "pt");
+    assert_eq!(tr.speakers.len(), 1);
+    assert!(tr.words.iter().all(|w| w.speaker == Some(0)));
+}
+
+#[test]
+fn stopping_while_waiting_cancels_without_sending_the_next_part() {
+    let (base, recibido) = servidor();
+    let t = Nemotron { conexion: conexion(&base), plan: Plan { parte: 60, por_minuto: 30 } };
+    let mut llamadas = 0;
+    let r = t.transcribe(&vec![0.0f32; 16_000 * 90], &Options::default(), &mut |_, _| {
+        llamadas += 1;
+        llamadas < 3
+    });
+    assert_eq!(r.unwrap_err(), SpeechError::Cancelled);
+    assert_eq!(recibido.lock().unwrap().len(), 1);
+}
+
+#[test]
+fn the_edit_tools_transcribe_with_nemotron_when_chosen() {
+    let (base, recibido) = servidor();
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let mut app = FilmcraftApp::new(s);
+    app.jacnex_ia.edicion.motor = "nemotron".into();
+    assert_eq!(crate::jacnex_edicion::falta(&app, Despues::Nada), Some("Inicia sesión en Jacnex Studio para usar Nemotron."));
+    assert!(crate::jacnex_ia::usar_servidor_local(&mut app, &base, "jk_prueba"));
+    assert_eq!(crate::jacnex_edicion::falta(&app, Despues::Nada), None);
+    let costo = crate::jacnex_edicion::costo_nube(&app).unwrap();
+    assert!(costo >= 1, "{costo}");
+    ejecutar(&mut app, Despues::Nada, false);
+    assert!(app.jacnex_ia.edicion.pide_descarga.is_none(), "nothing to download");
+    let ctx = egui::Context::default();
+    for _ in 0..3000 {
+        if !app.jacnex_ia.edicion.ocupado() {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+        crate::jacnex_edicion::actualizar(&mut app, &ctx);
+    }
+    let (ok, m) = app.jacnex_ia.edicion.aviso.clone().unwrap();
+    assert!(ok, "{m}");
+    assert!(!recibido.lock().unwrap().is_empty());
+    assert!(app.session.project.transcripts.values().any(|t| t.source == FUENTE && !t.words.is_empty()));
+    assert_eq!(crate::jacnex_edicion::costo_nube(&app), None, "nothing left to transcribe");
+}
