+//! Jacnex: Versión corta: frases, lectura de la respuesta de la IA y la secuencia nueva.
+
+use filmcraft_edit::transcript::SeqWord;
+use filmcraft_project::{ClipId, ItemId, ItemKind, Transcript, Word};
+use filmcraft_time::{FrameRate, Tick};
+use serde_json::{Value, json};
+
+use super::*;
+use crate::Session;
+use crate::transcript::sequence_words;
+
+const RATE: FrameRate = FrameRate::FPS_23_976;
+
+fn t(s: f64) -> Tick {
+    Tick::from_seconds_f64(s)
+}
+
+fn word(text: &str, a: f64, b: f64) -> SeqWord {
+    SeqWord { text: text.into(), start: t(a), end: t(b), clip: ClipId(1), item: ItemId(1), index: 0, track: 0, speaker: None, confidence: 1.0 }
+}
+
+/// Frases de 4 s cada 5 s: [0,4], [5,9], [10,14]…
+fn frases(n: usize) -> Vec<Sentence> {
+    (0..n).map(|i| Sentence { start: t(i as f64 * 5.0), end: t(i as f64 * 5.0 + 4.0), text: format!("Frase {i}.") }).collect()
+}
+
+fn tramos(v: &[(f64, f64)]) -> Value {
+    json!({"titulo": "Mi título", "tramos": v.iter().map(|(a, b)| json!({"inicio": a, "fin": b, "motivo": "x"})).collect::<Vec<_>>()})
+}
+
+fn secs(r: &[filmcraft_time::TimeRange]) -> Vec<(f64, f64)> {
+    r.iter().map(|x| (x.start.seconds().round(), x.end().seconds().round())).collect()
+}
+
+// --- Frases ----------------------------------------------------------------------------------
+
+#[test]
+fn sentences_close_on_a_full_stop_a_pause_or_a_long_run() {
+    let w = vec![
+        word("Hola", 0.0, 0.3),
+        word("a", 0.35, 0.5),
+        word("todos.", 0.55, 1.0),
+        word("Hoy", 1.1, 1.4),
+        word("vamos", 1.45, 1.8),
+        // pausa de 1 s: otra frase aunque no haya punto
+        word("Primero", 2.8, 3.2),
+        word("pasos...", 3.25, 3.6),
+        word("seguimos", 3.65, 4.0),
+        word("   ", 4.0, 4.1),
+        word("", 4.1, 4.2),
+        word("¿listo?", 4.3, 4.6),
+    ];
+    let s = sentences(&w);
+    let textos: Vec<&str> = s.iter().map(|x| x.text.as_str()).collect();
+    assert_eq!(textos, ["Hola a todos.", "Hoy vamos", "Primero pasos... seguimos ¿listo?"]);
+    assert_eq!((s[0].start, s[0].end), (t(0.0), t(1.0)));
+    assert_eq!(s[2].end, t(4.6));
+    // sin puntos ni pausas: se corta a las 30 palabras
+    let largo: Vec<SeqWord> = (0..65).map(|i| word("va", i as f64 * 0.1, i as f64 * 0.1 + 0.08)).collect();
+    let s = sentences(&largo);
+    assert_eq!(s.len(), 3);
+    assert!(s.iter().all(|x| x.text.split(' ').count() <= 30));
+    assert!(sentences(&[]).is_empty());
+}
+
+#[test]
+fn the_text_for_the_ai_has_one_timed_line_per_sentence() {
+    let txt = transcript_text(&frases(2));
+    assert_eq!(txt, "[0.0] Frase 0.\n[5.0] Frase 1.\n");
+}
+
+// --- La respuesta de la IA -------------------------------------------------------------------
+
+#[test]
+fn ranges_snap_to_whole_sentences_on_frames() {
+    let f = frases(6); // 0-4, 5-9, 10-14, 15-19, 20-24, 25-29
+    // el modelo da tiempos a media frase: se pegan al principio y al final de la frase
+    let (titulo, r) = parse_reply(&tramos(&[(5.8, 12.0), (20.1, 23.9)]), &f, t(30.0), RATE, 15.0).unwrap();
+    assert_eq!(titulo, "Mi título");
+    assert_eq!(secs(&r), [(5.0, 14.0), (20.0, 24.0)]);
+    for x in &r {
+        assert_eq!(RATE.snap(x.start), x.start, "el inicio cae en un cuadro");
+        assert_eq!(RATE.snap(x.end()), x.end(), "el fin cae en un cuadro");
+    }
+    // un inicio justo al final de una frase pasa a la siguiente
+    let (_, r) = parse_reply(&tramos(&[(8.9, 19.0)]), &f, t(30.0), RATE, 10.0).unwrap();
+    assert_eq!(secs(&r), [(10.0, 19.0)]);
+}
+
+#[test]
+fn overlaps_and_disorder_are_merged() {
+    let f = frases(6);
+    let (_, r) = parse_reply(&tramos(&[(20.0, 24.0), (0.0, 9.0), (5.0, 14.0)]), &f, t(30.0), RATE, 20.0).unwrap();
+    assert_eq!(secs(&r), [(0.0, 14.0), (20.0, 24.0)]);
+}
+
+#[test]
+fn a_reply_that_is_too_long_is_trimmed_from_the_end() {
+    let f = frases(12); // hasta 59 s
+    // piden 15 s (máximo 18,25): la IA mandó 5 tramos de 4 s
+    let r = tramos(&[(0.0, 4.0), (10.0, 14.0), (20.0, 24.0), (30.0, 34.0), (40.0, 44.0)]);
+    let (_, r) = parse_reply(&r, &f, t(60.0), RATE, 15.0).unwrap();
+    assert_eq!(secs(&r), [(0.0, 4.0), (10.0, 14.0), (20.0, 24.0), (30.0, 34.0)], "el gancho se queda; lo último sale");
+    // un solo tramo larguísimo se acorta frase por frase
+    let (_, r) = parse_reply(&tramos(&[(0.0, 59.0)]), &f, t(60.0), RATE, 15.0).unwrap();
+    let total: f64 = r.iter().map(|x| x.duration.seconds()).sum();
+    assert!((7.5..=18.25).contains(&total), "{total}");
+    assert_eq!(r[0].start, Tick::ZERO);
+}
+
+#[test]
+fn too_short_or_empty_replies_are_refused() {
+    let f = frases(12);
+    let e = parse_reply(&tramos(&[(0.0, 4.0)]), &f, t(60.0), RATE, 60.0).unwrap_err();
+    assert!(e.contains("más corta"), "{e}");
+    assert!(parse_reply(&tramos(&[]), &f, t(60.0), RATE, 30.0).is_err());
+    // todo cae fuera del video
+    assert!(parse_reply(&tramos(&[(90.0, 100.0), (-5.0, -1.0)]), &f, t(60.0), RATE, 30.0).is_err());
+}
+
+#[test]
+fn malformed_replies_are_refused_without_panicking() {
+    let f = frases(6);
+    let malas = [
+        json!(null),
+        json!("texto"),
+        json!([]),
+        json!({}),
+        json!({"tramos": "no"}),
+        json!({"tramos": [null, 1, "a", [], {"inicio": "0", "fin": "9"}, {"inicio": 1}, {"fin": 9}]}),
+        json!({"tramos": [{"inicio": 9, "fin": 5}, {"inicio": 5, "fin": 5}]}),
+        json!({"tramos": [{"inicio": 1e308, "fin": 1.7e308}]}),
+    ];
+    for m in malas {
+        assert!(parse_reply(&m, &f, t(30.0), RATE, 15.0).is_err(), "{m}");
+    }
+    // sin texto transcrito o con una duración absurda
+    assert!(parse_reply(&tramos(&[(0.0, 9.0)]), &[], t(30.0), RATE, 15.0).is_err());
+    for objetivo in [0.0, -3.0, f64::NAN, f64::INFINITY] {
+        assert!(parse_reply(&tramos(&[(0.0, 9.0)]), &f, t(30.0), RATE, objetivo).is_err());
+    }
+    // muchísimos tramos: se revisan unos pocos y no se desborda nada
+    let muchos: Vec<(f64, f64)> = (0..500).map(|i| (f64::from(i) * 0.01, f64::from(i) * 0.01 + 20.0)).collect();
+    let (_, r) = parse_reply(&tramos(&muchos), &f, t(30.0), RATE, 25.0).unwrap();
+    assert!(r.len() <= MAX_RANGES);
+    // el título se limpia
+    let v = json!({"titulo": format!("a\u{7}b{}", "x".repeat(200)), "tramos": [{"inicio": 0, "fin": 9}]});
+    let (titulo, _) = parse_reply(&v, &f, t(30.0), RATE, 8.0).unwrap();
+    assert!(titulo.chars().count() <= 80 && !titulo.contains('\u{7}'), "{titulo}");
+}
