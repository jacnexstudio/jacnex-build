+//! Jacnex: Doblaje, frases, precio, manifiesto del servidor y avisos.
+
+use filmcraft_engine::Session;
+use filmcraft_project::{ClipId, ItemId};
+use serde_json::json;
+
+use super::*;
+
+fn palabra(text: &str, a: f64, b: f64, quien: Option<&str>) -> SeqWord {
+    SeqWord {
+        text: text.into(),
+        start: Tick::from_seconds_f64(a),
+        end: Tick::from_seconds_f64(b),
+        clip: ClipId(1),
+        item: ItemId(1),
+        index: 0,
+        track: 0,
+        speaker: quien.map(str::to_string),
+        confidence: 1.0,
+    }
+}
+
+fn catalogo() -> Value {
+    json!({"id":"doblaje-ia","nombre":"Doblaje","creditosPorMil":6,"maxSegmentos":120,"maxLetras":12000,"maxLetrasSegmento":600,
+        "maxSegundos":1800,"expansion":1.3,"creditosTraduccion":2,"idiomas":["es","en","pt","fr","it","de"],
+        "voces":[{"id":"v1","nombre":"Ana","genero":"f","estilo":"cálida"},{"id":"v2","nombre":"Leo"}]})
+}
+
+#[test]
+fn groups_words_by_sentence_pause_and_speaker() {
+    let w = vec![
+        palabra("mundo.", 0.6, 1.0, None),
+        palabra("Hola", 0.2, 0.5, None),
+        palabra("otra", 1.1, 1.4, None),
+        palabra("frase", 1.5, 1.9, None),
+        palabra("sin", 5.0, 5.3, None),
+        palabra("pausa", 5.4, 5.8, Some("b")),
+        palabra("", 6.0, 6.1, None),
+    ];
+    let f = agrupar(&w, Tick::from_seconds_f64(0.0));
+    let t: Vec<&str> = f.iter().map(|x| x.texto.as_str()).collect();
+    assert_eq!(t, ["Hola mundo.", "otra frase", "sin", "pausa"]);
+    assert!(f.iter().all(|x| x.fin > x.inicio && x.inicio >= 0.0));
+    assert_eq!(f.iter().map(|x| x.id).collect::<Vec<_>>(), [0, 1, 2, 3]);
+    // times are relative to the start of the range
+    let g = agrupar(&w, Tick::from_seconds_f64(0.2));
+    assert!(g[0].inicio.abs() < 1e-6);
+    assert!(agrupar(&[], Tick::from_seconds_f64(0.0)).is_empty());
+    // a long run of words is cut
+    let largo: Vec<SeqWord> = (0..200).map(|i| palabra("la", f64::from(i) * 0.3, f64::from(i) * 0.3 + 0.25, None)).collect();
+    assert!(agrupar(&largo, Tick::from_seconds_f64(0.0)).iter().all(|x| x.fin - x.inicio <= MAX_FRASE_SEGUNDOS + 0.5));
+}
+
+#[test]
+fn reads_the_catalogue_and_prices_like_the_server() {
+    let n = leer(&catalogo()).expect("catalogue");
+    assert_eq!((n.max_frases, n.max_letras, n.creditos_traduccion), (120, 12000, 2));
+    assert_eq!(n.idiomas.len(), 6);
+    assert_eq!(n.idiomas[1], ("en".to_string(), "Inglés".to_string()));
+    assert_eq!(n.voces, [("v1".to_string(), "Ana · cálida".to_string()), ("v2".to_string(), "Leo".to_string())]);
+    // 3 phrases of 43 letters: max(3, ceil(129 * 1.3 * 6 / 1000) = 2) + 2
+    assert_eq!(n.reserva(129, 3), 5);
+    assert_eq!(n.reserva(10_000, 50), 78 + 2);
+    assert_eq!(n.reserva(0, 0), 3);
+    for malo in [json!({}), json!({"id":""}), json!({"id":"x","creditosPorMil":-1}), json!({"id":"x","creditosPorMil":"6"}), json!(7), json!(null)] {
+        assert!(leer(&malo).is_none(), "{malo}");
+    }
+    let mut raro = catalogo();
+    raro["idiomas"] = json!(["es", "../x", 5, "english-very-long", "fr"]);
+    raro["voces"] = json!([{"id": ""}, 3, {"id": "ok"}]);
+    let n = leer(&raro).expect("hostile lists are filtered");
