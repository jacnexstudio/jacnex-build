+/// Una imagen que se envía: (nombre del archivo, tipo MIME, bytes).
+type Imagen = (String, &'static str, Vec<u8>);
+
+/// Un pedido a `/v1/jacnex/generar`.
+struct Envio {
+    modelo: String,
+    prompt: String,
+    /// Los campos propios del modo (`aspect`, `voice`, `resolution`…).
+    campos: Vec<(&'static str, String)>,
+    /// La de inicio y, en una transición, la final.
+    imagenes: Vec<Imagen>,
+    /// El clip que se mejora (campo `video`): su archivo y su tipo MIME. Se lee en el hilo de red.
+    video: Option<(PathBuf, &'static str)>,
+    /// Lo que se ve mientras se crea y se descarga ([`Modo::etapas`]).
+    etapas: (&'static str, &'static str),
+    /// La carpeta donde se guarda lo recibido.
+    carpeta: PathBuf,
+}
+
+/// Lo más que se descargan de un mismo pedido (la música trae 2 versiones).
+const MAX_RESULTADOS: usize = 4;
+
+/// La extensión de un archivo recibido, por sus primeros bytes (o `None` si no es un video, un
+/// audio ni una imagen que Filmnex importe).
+fn extension(bytes: &[u8]) -> Option<&'static str> {
+    if bytes.get(4..8) == Some(b"ftyp") {
+        // Un MP4 de solo audio (M4A) se importa igual que un MP4.
+        if bytes.get(8..11) == Some(b"M4A") { Some("m4a") } else { Some("mp4") }
+    } else if bytes.starts_with(&[0x1A, 0x45, 0xDF, 0xA3]) {
+        Some("webm")
+    } else if bytes.starts_with(b"\x89PNG\r\n\x1a\n") {
+        Some("png")
+    } else if bytes.starts_with(&[0xFF, 0xD8, 0xFF]) {
+        Some("jpg")
+    } else if bytes.starts_with(b"ID3") || bytes.first() == Some(&0xFF) && bytes.get(1).is_some_and(|b| b & 0xE6 == 0xE2) {
+        // ID3 o un cuadro MPEG de audio (sincronía de 11 bits; capa III).
+        Some("mp3")
+    } else if bytes.starts_with(b"RIFF") && bytes.get(8..12) == Some(b"WAVE") {
+        Some("wav")
+    } else {
+        None
+    }
+}
+
+/// Guarda `bytes` en `carpeta` con un nombre libre («Jacnex IA 001.mp4»…).
+fn guardar(carpeta: &Path, bytes: &[u8]) -> Result<PathBuf, String> {
+    let ext = extension(bytes).ok_or_else(|| "Lo recibido no es un video ni un audio. Tus créditos fueron devueltos si falló la generación.".to_string())?;
+    std::fs::create_dir_all(carpeta).map_err(|e| format!("No se pudo crear la carpeta {}: {e}", carpeta.display()))?;
+    let ruta = (1..=9999)
+        .map(|n| carpeta.join(format!("Jacnex IA {n:03}.{ext}")))
+        .find(|p| !p.exists())
+        .ok_or_else(|| format!("La carpeta {} ya tiene demasiados archivos.", carpeta.display()))?;
+    std::fs::write(&ruta, bytes).map_err(|e| format!("No se pudo guardar el archivo en {}: {e}", ruta.display()))?;
+    Ok(ruta)
+}
