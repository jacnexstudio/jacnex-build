--- /dev/null
+++ b/crates/separate/src/model.rs
@@ -0,0 +1,486 @@
+//! The Mel-Band RoFormer network (Kim Vocal 2) on candle, CPU, f32.
+//!
+//! Layout of the network, as in the reference implementation (`bs_roformer` `MelBandRoformer`):
+//! STFT (2048 / hop 441) -> 60 overlapping mel bands, each normalised and projected to 384 features ->
+//! 6 times (a transformer along time for every band, then a transformer along the bands for every frame;
+//! rotary positions, gated attention) -> one MLP per band that gives a complex mask -> masks of the bins that
+//! several bands share are averaged -> mask times the spectrum -> inverse STFT.
+//!
+//! Matrices are stored as f16 in the file and widened to f32 when loaded. Every sequence group goes through
+//! a whole block before the next, so the temporaries stay small (the 801-frame attention is never held for
+//! all 60 bands at once).
+
+use std::collections::HashMap;
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use candle_core::{D, DType, Device, Tensor};
+
+use crate::pipeline::ChunkModel;
+use crate::stft::{Spec, Stft};
+use crate::{Result, SeparateError};
+
+/// File names in the model folder.
+pub const WEIGHTS_FILE: &str = "model.safetensors";
+pub const CONFIG_FILE: &str = "config.json";
+
+const DIM: usize = 384;
+const HEADS: usize = 8;
+const DIM_HEAD: usize = 64;
+const INNER: usize = HEADS * DIM_HEAD;
+const FF: usize = DIM * 4;
+const DEPTH: usize = 6;
+const BANDS: usize = 60;
+const N_FFT: usize = 2048;
+const HOP: usize = 441;
+const BINS: usize = N_FFT / 2 + 1;
+const RATE: u32 = 44100;
+const MASK_HIDDEN: usize = DIM * 4;
+/// Floats one attention-score block may take (4 bytes each).
+const SCORE_BUDGET: usize = 8 << 20;
+/// Tokens one feed-forward block may take.
+const TOKEN_BUDGET: usize = 4096;
+/// Groups worked on at once. The matrix products already use every core; this is for the rest (activations,
+/// rotary, softmax), which candle runs on one thread each.
+const MAX_WORKERS: usize = 6;
+/// Largest model file read (the real one is about 460 MB).
+const MAX_FILE: u64 = 2 << 30;
+
+type CResult<T> = std::result::Result<T, candle_core::Error>;
+
+fn net(e: candle_core::Error) -> SeparateError {
+    SeparateError::Net(e.to_string())
+}
+
+/// `f(0..n)` on a few threads, results in order. Stops early on the first error or when `stop` is set.
+fn par_map<T: Send, F: Fn(usize) -> Result<T> + Sync>(n: usize, stop: &AtomicBool, f: F) -> Result<Vec<T>> {
+    let workers = std::thread::available_parallelism().map_or(1, std::num::NonZeroUsize::get).clamp(1, MAX_WORKERS).min(n.max(1));
+    let (next, failed) = (AtomicUsize::new(0), AtomicBool::new(false));
+    let work = || -> Vec<(usize, Result<T>)> {
+        let mut done = Vec::new();
+        while !failed.load(Ordering::Relaxed) {
+            let i = next.fetch_add(1, Ordering::Relaxed);
+            if i >= n {
+                break;
+            }
+            let r = if stop.load(Ordering::Relaxed) {
+                Err(SeparateError::Stopped)
+            } else {
+                catch_unwind(AssertUnwindSafe(|| f(i))).unwrap_or_else(|_| Err(SeparateError::Net("a worker panicked".into())))
+            };
+            if r.is_err() {
+                failed.store(true, Ordering::Relaxed);
+            }
+            done.push((i, r));
+        }
+        done
+    };
+    let mut all: Vec<(usize, Result<T>)> = Vec::with_capacity(n);
+    if workers <= 1 {
+        all.extend(work());
+    } else {
+        std::thread::scope(|sc| {
+            let handles: Vec<_> = (0..workers).map(|_| sc.spawn(work)).collect();
+            for h in handles {
+                match h.join() {
+                    Ok(v) => all.extend(v),
+                    Err(_) => all.push((n, Err(SeparateError::Net("a worker panicked".into())))),
+                }
+            }
+        });
+    }
+    all.sort_by_key(|(i, _)| *i);
+    let mut out = Vec::with_capacity(n);
+    for (_, r) in all {
+        out.push(r?);
+    }
+    if out.len() != n {
+        return Err(SeparateError::Net("the work did not finish".into()));
+    }
+    Ok(out)
+}
+
+struct Lin {
+    /// `(in, out)`, so `x @ w` needs no transpose.
+    w: Tensor,
+    b: Option<Tensor>,
+}
+
+impl Lin {
+    fn fwd(&self, x: &Tensor) -> CResult<Tensor> {
+        let dims = x.dims().to_vec();
+        let last = *dims.last().ok_or_else(|| candle_core::Error::Msg("scalar input".into()))?;
+        let rows: usize = dims[..dims.len() - 1].iter().product();
+        let mut y = x.contiguous()?.reshape((rows, last))?.matmul(&self.w)?;
+        if let Some(b) = &self.b {
+            y = y.broadcast_add(b)?;
+        }
+        let out = self.w.dim(1)?;
+        let mut shape = dims[..dims.len() - 1].to_vec();
+        shape.push(out);
+        y.reshape(shape)
+    }
+}
+
+/// `F.normalize(x) * sqrt(dim) * gamma`.
+struct Norm {
+    /// `gamma * sqrt(dim)`, shape `(dim,)`.
+    g: Tensor,
+}
+
+impl Norm {
+    fn fwd(&self, x: &Tensor) -> CResult<Tensor> {
+        let n = x.sqr()?.sum_keepdim(D::Minus1)?.clamp(1e-24f32, f32::MAX)?.sqrt()?;
+        x.broadcast_div(&n)?.broadcast_mul(&self.g)
+    }
+}
+
+struct Attn {
+    norm: Norm,
+    qkv: Lin,
+    gates: Lin,
+    out: Lin,
+    /// The rotary frequencies (32 of them).
+    freqs: Vec<f32>,
+}
+
+struct Block {
+    attn: Attn,
+    ff_norm: Norm,
+    ff1: Lin,
+    ff2: Lin,
+}
+
+struct Transformer {
+    block: Block,
+    norm: Norm,
+}
+
+struct Mask {
+    l1: Lin,
+    l2: Lin,
+    l3: Lin,
+}
+
+/// What the network can show of its insides (for checking it against the reference).
+#[derive(Default)]
+pub struct Taps {
+    /// After the band split: `(frames, bands, dim)`.
+    pub bands: Vec<f32>,
+    /// After the first axial layer, same shape.
+    pub layer0: Vec<f32>,
+}
+
+pub struct MelBandRoformer {
+    dev: Device,
+    stft: Stft,
+    chunk: usize,
+    /// Bins of each band.
+    band_bins: Vec<Vec<usize>>,
+    /// Bands that cover each bin.
+    bands_per_bin: Vec<f32>,
+    split_norm: Vec<Norm>,
+    split_lin: Vec<Lin>,
+    layers: Vec<(Transformer, Transformer)>,
+    masks: Vec<Mask>,
+}
+
+fn tensors_of(path: &Path) -> Result<HashMap<String, Tensor>> {
+    let meta = std::fs::metadata(path).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    if meta.len() > MAX_FILE {
+        return Err(SeparateError::Model(format!("{} is too big", path.display())));
+    }
+    let bytes = std::fs::read(path).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    candle_core::safetensors::load_buffer(&bytes, &Device::Cpu).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))
+}
+
+struct Weights(HashMap<String, Tensor>);
+
+impl Weights {
+    /// A tensor of exactly this shape, as f32.
+    fn get(&self, name: &str, shape: &[usize]) -> Result<Tensor> {
+        let t = self.0.get(name).ok_or_else(|| SeparateError::Model(format!("the weights have no `{name}`")))?;
+        if t.dims() != shape {
+            return Err(SeparateError::Model(format!("`{name}` is {:?}, expected {shape:?}", t.dims())));
+        }
+        t.to_dtype(DType::F32).map_err(net)
+    }
+
+    fn norm(&self, name: &str, dim: usize) -> Result<Norm> {
+        let g = self.get(name, &[dim])?;
+        Ok(Norm { g: (g * (dim as f64).sqrt()).map_err(net)? })
+    }
+
+    /// `prefix.weight` of shape `(out, in)` (and `prefix.bias`), stored transposed.
+    fn lin(&self, prefix: &str, inp: usize, out: usize, bias: bool) -> Result<Lin> {
+        let w = self.get(&format!("{prefix}.weight"), &[out, inp])?;
+        let b = if bias { Some(self.get(&format!("{prefix}.bias"), &[out])?) } else { None };
+        Ok(Lin { w: w.t().and_then(|t| t.contiguous()).map_err(net)?, b })
+    }
+
+    fn attn(&self, p: &str) -> Result<Attn> {
+        let norm = self.norm(&format!("{p}.norm.gamma"), DIM)?;
+        // q and k get their dimensions reordered inside each head (evens, then odds), so the rotary
+        // rotation pairs `i` with `i + 32` instead of `2i` with `2i + 1`; the dot products do not change
+        let w = self.get(&format!("{p}.to_qkv.weight"), &[3 * INNER, DIM])?;
+        let perm: Vec<u32> = (0..3 * INNER)
+            .map(|r| {
+                let (part, within) = (r / INNER, r % INNER);
+                let (head, d) = (within / DIM_HEAD, within % DIM_HEAD);
+                let d = if part < 2 { if d < DIM_HEAD / 2 { 2 * d } else { 2 * (d - DIM_HEAD / 2) + 1 } } else { d };
+                (part * INNER + head * DIM_HEAD + d) as u32
+            })
+            .collect();
+        let idx = Tensor::from_vec(perm, 3 * INNER, &Device::Cpu).map_err(net)?;
+        let w = w.index_select(&idx, 0).and_then(|t| t.t()).and_then(|t| t.contiguous()).map_err(net)?;
+        let freqs = self.get(&format!("{p}.rotary_embed.freqs"), &[DIM_HEAD / 2])?.to_vec1::<f32>().map_err(net)?;
+        Ok(Attn {
+            norm,
+            qkv: Lin { w, b: None },
+            gates: self.lin(&format!("{p}.to_gates"), DIM, HEADS, true)?,
+            out: self.lin(&format!("{p}.to_out.0"), INNER, DIM, false)?,
+            freqs,
+        })
+    }
+
+    fn transformer(&self, p: &str) -> Result<Transformer> {
+        let b = format!("{p}.layers.0");
+        Ok(Transformer {
+            block: Block {
+                attn: self.attn(&format!("{b}.0"))?,
+                ff_norm: self.norm(&format!("{b}.1.net.0.gamma"), DIM)?,
+                ff1: self.lin(&format!("{b}.1.net.1"), DIM, FF, true)?,
+                ff2: self.lin(&format!("{b}.1.net.4"), FF, DIM, true)?,
+            },
+            norm: self.norm(&format!("{p}.norm.gamma"), DIM)?,
+        })
+    }
+}
+
+fn read_config(path: &Path) -> Result<()> {
+    let text = std::fs::read_to_string(path).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    let v: serde_json::Value = serde_json::from_str(&text).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    let num = |k: &str| v.get(k).and_then(serde_json::Value::as_u64);
+    let want = [
+        ("dim", DIM),
+        ("depth", DEPTH),
+        ("heads", HEADS),
+        ("dim_head", DIM_HEAD),
+        ("num_bands", BANDS),
+        ("n_fft", N_FFT),
+        ("hop_length", HOP),
+        ("sample_rate", RATE as usize),
+        ("num_stems", 1),
+        ("channels", 2),
+    ];
+    for (k, n) in want {
+        if num(k) != Some(n as u64) {
+            return Err(SeparateError::Model(format!("{}: `{k}` is not {n}; this is another network", path.display())));
+        }
+    }
+    if v.get("model_type").and_then(serde_json::Value::as_str) != Some("mel_band_roformer") {
+        return Err(SeparateError::Model(format!("{}: not a mel_band_roformer", path.display())));
+    }
+    Ok(())
+}
+
+fn chunk_of(path: &Path) -> Result<usize> {
+    let text = std::fs::read_to_string(path).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    let v: serde_json::Value = serde_json::from_str(&text).map_err(|e| SeparateError::Model(format!("{}: {e}", path.display())))?;
+    let n = v.get("chunk_size").and_then(serde_json::Value::as_u64).unwrap_or(0) as usize;
+    if n < HOP * 100 || n > RATE as usize * 60 || !n.is_multiple_of(HOP) {
+        return Err(SeparateError::Model(format!("{}: chunk_size {n} is not usable", path.display())));
+    }
+    Ok(n)
+}
+
+impl MelBandRoformer {
+    /// Loads the network from a folder with `model.safetensors` and `config.json`.
+    pub fn load(dir: &Path) -> Result<Self> {
+        read_config(&dir.join(CONFIG_FILE))?;
+        let chunk = chunk_of(&dir.join(CONFIG_FILE))?;
+        let w = Weights(tensors_of(&dir.join(WEIGHTS_FILE))?);
+        let table = w.get("freqs_per_band", &[BANDS, BINS])?.to_vec2::<f32>().map_err(net)?;
+        let band_bins: Vec<Vec<usize>> = table.iter().map(|row| row.iter().enumerate().filter(|(_, v)| **v > 0.5).map(|(i, _)| i).collect()).collect();
+        let mut bands_per_bin = vec![0.0f32; BINS];
+        for b in &band_bins {
+            for &i in b {
+                bands_per_bin[i] += 1.0;
+            }
+        }
+        if band_bins.iter().any(Vec::is_empty) || bands_per_bin.iter().any(|c| *c < 1.0) {
+            return Err(SeparateError::Model("the bands do not cover every frequency".into()));
+        }
+        let (mut split_norm, mut split_lin, mut masks) = (Vec::new(), Vec::new(), Vec::new());
+        for (b, bins) in band_bins.iter().enumerate() {
+            let d_in = bins.len() * 4;
+            split_norm.push(w.norm(&format!("band_split.to_features.{b}.0.gamma"), d_in)?);
+            split_lin.push(w.lin(&format!("band_split.to_features.{b}.1"), d_in, DIM, true)?);
+            let m = format!("mask_estimators.0.to_freqs.{b}.0");
+            masks.push(Mask {
+                l1: w.lin(&format!("{m}.0"), DIM, MASK_HIDDEN, true)?,
+                l2: w.lin(&format!("{m}.2"), MASK_HIDDEN, MASK_HIDDEN, true)?,
+                l3: w.lin(&format!("{m}.4"), MASK_HIDDEN, d_in * 2, true)?,
+            });
+        }
+        let mut layers = Vec::new();
+        for l in 0..DEPTH {
+            layers.push((w.transformer(&format!("layers.{l}.0"))?, w.transformer(&format!("layers.{l}.1"))?));
+        }
+        Ok(Self { dev: Device::Cpu, stft: Stft::new(N_FFT, HOP)?, chunk, band_bins, bands_per_bin, split_norm, split_lin, layers, masks })
+    }
+
+    /// Sequences of `(n, dim)` through one transformer, a group at a time. `x` is `(sequences, n, dim)`.
+    fn transformer(&self, t: &Transformer, x: &Tensor, stop: &AtomicBool) -> Result<Tensor> {
+        let (seqs, n, _) = x.dims3().map_err(net)?;
+        let group = (TOKEN_BUDGET / n.max(1)).min(SCORE_BUDGET / (HEADS * n * n).max(1)).max(1);
+        let (cos, sin) = rotary(&t.block.attn.freqs, n, &self.dev).map_err(net)?;
+        let parts = seqs.div_ceil(group);
+        let outs = par_map(parts, stop, |k| {
+            let at = k * group;
+            let part = x.narrow(0, at, group.min(seqs - at)).map_err(net)?;
+            block(&t.block, &part, &cos, &sin).and_then(|y| t.norm.fwd(&y)).map_err(net)
+        })?;
+        Tensor::cat(&outs, 0).map_err(net)
+    }
+
+    /// One stereo chunk in, the voice out; `taps` collects intermediate results when given.
+    fn forward(&self, left: &[f32], right: &[f32], stop: &AtomicBool, mut taps: Option<&mut Taps>) -> Result<(Vec<f32>, Vec<f32>)> {
+        if left.len() != self.chunk || right.len() != self.chunk {
+            return Err(SeparateError::Input(format!("a chunk is {} samples, got {} and {}", self.chunk, left.len(), right.len())));
+        }
+        let specs = [self.stft.forward(left), self.stft.forward(right)];
+        let frames = specs[0].frames;
+        // bands
+        let feats = par_map(BANDS, stop, |b| {
+            let bins = &self.band_bins[b];
+            let mut data = Vec::with_capacity(frames * bins.len() * 4);
+            for t in 0..frames {
+                for &f in bins {
+                    for s in &specs {
+                        data.push(s.re[t * BINS + f]);
+                        data.push(s.im[t * BINS + f]);
+                    }
+                }
+            }
+            let x = Tensor::from_vec(data, (frames, bins.len() * 4), &self.dev).map_err(net)?;
+            self.split_norm[b].fwd(&x).and_then(|x| self.split_lin[b].fwd(&x)).map_err(net)
+        })?;
+        let mut x = Tensor::stack(&feats, 1).map_err(net)?; // (frames, bands, dim)
+        drop(feats);
+        if let Some(t) = taps.as_deref_mut() {
+            t.bands = x.flatten_all().and_then(|t| t.to_vec1::<f32>()).map_err(net)?;
+        }
+        for (i, (time, freq)) in self.layers.iter().enumerate() {
+            let along_time = x.transpose(0, 1).and_then(|t| t.contiguous()).map_err(net)?; // (bands, frames, dim)
+            let y = self.transformer(time, &along_time, stop)?;
+            x = y.transpose(0, 1).and_then(|t| t.contiguous()).map_err(net)?;
+            x = self.transformer(freq, &x, stop)?;
+            if let (0, Some(t)) = (i, taps.as_deref_mut()) {
+                t.layer0 = x.flatten_all().and_then(|t| t.to_vec1::<f32>()).map_err(net)?;
+            }
+        }
+        // masks, summed where bands share a bin
+        let mut sum = [vec![0.0f32; frames * BINS * 2], vec![0.0f32; frames * BINS * 2]];
+        let per_band = par_map(BANDS, stop, |b| {
+            let (m, d) = (&self.masks[b], self.band_bins[b].len() * 4);
+            let xb = x.narrow(1, b, 1).and_then(|t| t.squeeze(1)).map_err(net)?;
+            let h = m.l1.fwd(&xb).and_then(|t| t.tanh()).and_then(|t| m.l2.fwd(&t)).and_then(|t| t.tanh()).and_then(|t| m.l3.fwd(&t)).map_err(net)?;
+            // GLU: first half times sigmoid of the second
+            let a = h.narrow(1, 0, d).map_err(net)?;
+            let g = h.narrow(1, d, d).and_then(|t| candle_nn::ops::sigmoid(&t)).map_err(net)?;
+            (a * g).and_then(|t| t.flatten_all()).and_then(|t| t.to_vec1::<f32>()).map_err(net)
+        })?;
+        for (bins, v) in self.band_bins.iter().zip(&per_band) {
+            let d = bins.len() * 4;
+            for t in 0..frames {
+                for (j, &f) in bins.iter().enumerate() {
+                    for (s, acc) in sum.iter_mut().enumerate() {
+                        let o = t * d + j * 4 + s * 2;
+                        let at = (t * BINS + f) * 2;
+                        acc[at] += v[o];
+                        acc[at + 1] += v[o + 1];
+                    }
+                }
+            }
+        }
+        let mut out = Vec::with_capacity(2);
+        for (s, spec) in specs.iter().enumerate() {
+            let mut voice = Spec { frames, bins: BINS, re: vec![0.0; frames * BINS], im: vec![0.0; frames * BINS] };
+            for t in 0..frames {
+                for f in 0..BINS {
+                    let n = self.bands_per_bin[f].max(1e-8);
+                    let at = t * BINS + f;
+                    let (mr, mi) = (sum[s][at * 2] / n, sum[s][at * 2 + 1] / n);
+                    voice.re[at] = spec.re[at] * mr - spec.im[at] * mi;
+                    voice.im[at] = spec.re[at] * mi + spec.im[at] * mr;
+                }
+            }
+            out.push(self.stft.inverse(&voice));
+        }
+        let r = out.pop().unwrap_or_default();
+        let l = out.pop().unwrap_or_default();
+        Ok((l, r))
+    }
+
+    /// The network's insides for one chunk, for the oracle tests.
+    pub fn forward_taps(&self, left: &[f32], right: &[f32]) -> Result<(Vec<f32>, Vec<f32>, Taps)> {
+        let mut taps = Taps::default();
+        let (l, r) = self.forward(left, right, &AtomicBool::new(false), Some(&mut taps))?;
+        Ok((l, r, taps))
+    }
+}
+
+/// Cosines and sines of the rotary angles, `(n, 64)`: the 32 angles twice (the halves the weights were
+/// reordered for).
+fn rotary(freqs: &[f32], n: usize, dev: &Device) -> CResult<(Tensor, Tensor)> {
+    let (mut c, mut s) = (Vec::with_capacity(n * DIM_HEAD), Vec::with_capacity(n * DIM_HEAD));
+    for p in 0..n {
+        let angles: Vec<f32> = freqs.iter().map(|f| p as f32 * f).collect();
+        for _ in 0..2 {
+            c.extend(angles.iter().map(|a| a.cos()));
+            s.extend(angles.iter().map(|a| a.sin()));
+        }
+    }
+    Ok((Tensor::from_vec(c, (1, 1, n, DIM_HEAD), dev)?, Tensor::from_vec(s, (1, 1, n, DIM_HEAD), dev)?))
+}
+
+fn rotate(x: &Tensor, cos: &Tensor, sin: &Tensor) -> CResult<Tensor> {
+    let h = DIM_HEAD / 2;
+    let (a, b) = (x.narrow(D::Minus1, 0, h)?, x.narrow(D::Minus1, h, h)?);
+    let half = Tensor::cat(&[&b.neg()?, &a], D::Minus1)?;
+    x.broadcast_mul(cos)? + half.broadcast_mul(sin)?
+}
+
+/// Attention and feed-forward of one group of sequences, `(g, n, dim)`.
+fn block(b: &Block, x: &Tensor, cos: &Tensor, sin: &Tensor) -> CResult<Tensor> {
+    let (g, n, _) = x.dims3()?;
+    let a = &b.attn;
+    let h = a.norm.fwd(x)?;
+    let qkv = a.qkv.fwd(&h)?.reshape((g, n, 3, HEADS, DIM_HEAD))?.permute((2, 0, 3, 1, 4))?.contiguous()?;
+    let q = rotate(&qkv.narrow(0, 0, 1)?.squeeze(0)?, cos, sin)?;
+    let k = rotate(&qkv.narrow(0, 1, 1)?.squeeze(0)?, cos, sin)?;
+    let v = qkv.narrow(0, 2, 1)?.squeeze(0)?;
+    let scores = (q.matmul(&k.transpose(2, 3)?.contiguous()?)? * (1.0 / (DIM_HEAD as f64).sqrt()))?;
+    let o = candle_nn::ops::softmax_last_dim(&scores)?.matmul(&v)?; // (g, heads, n, dim_head)
+    let gate = candle_nn::ops::sigmoid(&a.gates.fwd(&h)?)?.permute((0, 2, 1))?.unsqueeze(3)?; // (g, heads, n, 1)
+    let o = o.broadcast_mul(&gate)?.transpose(1, 2)?.contiguous()?.reshape((g, n, INNER))?;
+    let x = (a.out.fwd(&o)? + x)?;
+    let f = b.ff2.fwd(&b.ff1.fwd(&b.ff_norm.fwd(&x)?)?.gelu_erf()?)?;
+    f + x
+}
+
+impl ChunkModel for MelBandRoformer {
+    fn rate(&self) -> u32 {
+        RATE
+    }
+
+    fn chunk(&self) -> usize {
+        self.chunk
+    }
+
+    fn run(&self, left: &[f32], right: &[f32], stop: &AtomicBool) -> Result<(Vec<f32>, Vec<f32>)> {
+        catch_unwind(AssertUnwindSafe(|| self.forward(left, right, stop, None))).unwrap_or_else(|_| Err(SeparateError::Net("the network panicked".into())))
+    }
+}
