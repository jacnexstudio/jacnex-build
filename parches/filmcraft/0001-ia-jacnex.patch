+/// «Este clip cuesta…», según lo que se crea.
+fn cuesta(modo: Modo) -> &'static str {
+    match modo {
+        Modo::Texto | Modo::Foto | Modo::Transicion => "Este clip cuesta",
+        Modo::Voz => "Esta voz cuesta",
+        Modo::Musica => "Las 2 versiones cuestan",
+        Modo::Efecto => "Este efecto cuesta",
+        Modo::Mejorar => "Mejorarlo cuesta",
+        Modo::Vertical => "Reencuadrarlo cuesta",
+        Modo::Corta => "La versión corta cuesta",
+        Modo::Subtitulos | Modo::Silencios | Modo::Muletillas | Modo::PorTexto | Modo::Buscar | Modo::Doblaje => "",
+    }
+}
