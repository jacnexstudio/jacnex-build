+    /// Una película H.264 de 12 cuadros (`w`×`h`, 24 fps) de una escena de la demo.
+    fn pelicula(ruta: &Path, w: u32, h: u32) {
+        use filmcraft_media::MediaSource;
+        use filmcraft_media::generators::GeneratorSource;
+        use filmcraft_media::{DemoScene, Generator};
+        use filmcraft_project::{ItemKind, Label, MediaClip, Project, SequenceSettings, TrackKind};
+        use filmcraft_time::{FrameRate, TimeRange};
+        let rate = FrameRate::FPS_24;
+        let dur = rate.tick_of(12);
+        let src = GeneratorSource::new(Generator::Demo(DemoScene::Dunes), w, h, rate, dur);
+        let clip = MediaClip {
+            media: MediaRef::Generator(Generator::Demo(DemoScene::Dunes)),
+            info: src.info().clone(),
+            interpret: Default::default(),
+            mark_in: None,
+            mark_out: None,
+            markers: vec![],
+            offline: false,
+            proxy: None,
+            identity: None,
+        };
+        let mut p = Project::new("fixture");
+        let item = p.add_item("scene", Label::Iris, ItemKind::Media(Box::new(clip)), None);
+        let seq = p.new_sequence("s", SequenceSettings { width: w, height: h, frame_rate: rate, ..Default::default() }, 1, 1, None);
+        let mut v = p.make_track_item(item, TrackKind::Video, Tick::ZERO, TimeRange::new(Tick::ZERO, dur), rate).unwrap();
+        for e in &mut v.effects {
+            filmcraft_project::resolve_auto_points(e, (w, h), (w, h));
+        }
+        p.sequence_mut(seq).unwrap().video_tracks[0].items.push(v);
+        let ajustes = filmcraft_export::ExportSettings {
+            format: filmcraft_export::Format::H264,
+            path: ruta.to_string_lossy().into_owned(),
+            bitrate_kbps: 2000,
+            ..Default::default()
+        };
+        let fuente: filmcraft_media::SharedSource = std::sync::Arc::new(src);
+        let proveedor = move |id: ItemId| (id == item).then(|| fuente.clone());
+        filmcraft_export::export(&std::sync::Arc::new(p), seq, &ajustes, &proveedor, &Default::default()).unwrap();
+    }
