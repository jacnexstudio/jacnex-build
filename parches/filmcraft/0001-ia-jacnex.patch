+fn nothing_to_hear_says_so() {
+    let mut s = Session::default();
+    s.execute("file.newProject", json!({})).ok();
+    let app = FilmcraftApp::new(s);
+    assert_eq!(falta(&app, Despues::Subtitulos), Some("Abre una secuencia con voz."));
