diff --git a/crates/reframe/src/lib.rs b/crates/reframe/src/lib.rs
new file mode 100644
index 0000000..4476ab9
--- /dev/null
+++ b/crates/reframe/src/lib.rs
@@ -0,0 +1,274 @@
+//! Auto-reframe for Filmnex (Sequence > "Pasar a vertical"): find who and what to keep in a
+//! vertical crop and move a virtual camera over it the way an operator would.
+//!
+//! - `yunet`, `rtdetr`, `lightasd` (feature `candle`): the detection networks, in pure Rust on
+//!   candle (CPU). Faces (YuNet), people and objects (RT-DETRv2), and who is speaking (Light-ASD
+//!   over face crops and the MFCC of the audio). Model files are looked for in a folder the
+//!   caller names; nothing is ever downloaded here.
+//! - [`mfcc`]: the audio features Light-ASD expects.
+//! - [`track`]: links detections of consecutive samples into tracks.
+//! - [`plan`]: the virtual camera: picks the subject of every moment, keeps it in a dead zone,
+//!   re-targets at cuts and smooths the path into a few keyframes.
+//!
+//! All coordinates in this crate are fractions of the frame (0..1, y down) unless a name says
+//! pixels. Every function treats its input as untrusted: sizes are checked, loops are bounded
+//! and nothing panics.
+
+#![cfg_attr(not(test), deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable))]
+
+#[cfg(feature = "candle")]
+pub mod lightasd;
+pub mod mfcc;
+#[cfg(feature = "candle")]
+mod nn;
+pub mod plan;
+#[cfg(feature = "candle")]
+pub mod rtdetr;
+pub mod track;
+#[cfg(feature = "candle")]
+pub mod yunet;
+
+/// The largest image side the detectors accept (a 16K frame is already absurd).
+pub const MAX_SIDE: usize = 16_384;
+
+/// Why a model or an image could not be used.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum ReframeError {
+    /// A model file is missing or unreadable.
+    Model(String),
+    /// The image is empty, truncated or too big.
+    Image(String),
+    /// The network failed.
+    Net(String),
+}
+
+impl std::fmt::Display for ReframeError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            ReframeError::Model(m) => write!(f, "model: {m}"),
+            ReframeError::Image(m) => write!(f, "image: {m}"),
+            ReframeError::Net(m) => write!(f, "network: {m}"),
+        }
+    }
+}
+
+impl std::error::Error for ReframeError {}
+
+pub type Result<T> = std::result::Result<T, ReframeError>;
+
+/// A rectangle in fractions of the frame.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Rect {
+    pub x0: f32,
+    pub y0: f32,
+    pub x1: f32,
+    pub y1: f32,
+}
+
+impl Rect {
+    pub fn new(x0: f32, y0: f32, x1: f32, y1: f32) -> Self {
+        Self { x0: x0.min(x1), y0: y0.min(y1), x1: x0.max(x1), y1: y0.max(y1) }
+    }
+    pub fn w(&self) -> f32 {
+        self.x1 - self.x0
+    }
+    pub fn h(&self) -> f32 {
+        self.y1 - self.y0
+    }
+    pub fn cx(&self) -> f32 {
+        0.5 * (self.x0 + self.x1)
+    }
+    pub fn cy(&self) -> f32 {
+        0.5 * (self.y0 + self.y1)
+    }
+    pub fn area(&self) -> f32 {
+        self.w().max(0.0) * self.h().max(0.0)
+    }
+    /// Intersection over union (0 when either is empty).
+    pub fn iou(&self, o: &Rect) -> f32 {
+        let iw = (self.x1.min(o.x1) - self.x0.max(o.x0)).max(0.0);
+        let ih = (self.y1.min(o.y1) - self.y0.max(o.y0)).max(0.0);
+        let inter = iw * ih;
+        let u = self.area() + o.area() - inter;
+        if u > 1e-9 { inter / u } else { 0.0 }
+    }
+    /// The part of `self` that is inside `o`, as a fraction of `self`'s area.
+    pub fn inside(&self, o: &Rect) -> f32 {
+        let iw = (self.x1.min(o.x1) - self.x0.max(o.x0)).max(0.0);
+        let ih = (self.y1.min(o.y1) - self.y0.max(o.y0)).max(0.0);
+        if self.area() > 1e-9 { iw * ih / self.area() } else { 0.0 }
+    }
+}
+
+/// A face found by `yunet`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Face {
+    pub rect: Rect,
+    pub score: f32,
+    /// Right eye, left eye, nose, right and left mouth corner (as the model orders them).
+    pub landmarks: [(f32, f32); 5],
+}
+
+/// An object found by `rtdetr`.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Obj {
+    pub rect: Rect,
+    pub score: f32,
+    /// The COCO class id (0 = person).
+    pub class: u16,
+}
+
+/// The COCO id of a person.
+pub const PERSON: u16 = 0;
+
+/// A borrowed RGBA8 picture.
+#[derive(Clone, Copy, Debug)]
+pub struct Image<'a> {
+    pub rgba: &'a [u8],
+    pub w: usize,
+    pub h: usize,
+}
+
+impl<'a> Image<'a> {
+    /// Checks the size and the buffer length.
+    pub fn new(rgba: &'a [u8], w: usize, h: usize) -> Result<Self> {
+        if w == 0 || h == 0 || w > MAX_SIDE || h > MAX_SIDE {
+            return Err(ReframeError::Image(format!("unsupported size {w}x{h}")));
+        }
+        let need = w.checked_mul(h).and_then(|n| n.checked_mul(4)).ok_or_else(|| ReframeError::Image("size overflow".into()))?;
+        if rgba.len() < need {
+            return Err(ReframeError::Image("truncated picture".into()));
+        }
+        Ok(Self { rgba, w, h })
+    }
+
+    /// Bilinear resize to `nw` x `nh`, as planar channels of f32 in 0..255 in `order` (channel
+    /// indices into RGBA, e.g. `[2, 1, 0]` for BGR).
+    pub fn resize_planar(&self, nw: usize, nh: usize, order: [usize; 3]) -> Vec<f32> {
+        let (nw, nh) = (nw.max(1), nh.max(1));
+        let mut out = vec![0f32; 3 * nw * nh];
+        let sx = self.w as f32 / nw as f32;
+        let sy = self.h as f32 / nh as f32;
+        for y in 0..nh {
+            let fy = ((y as f32 + 0.5) * sy - 0.5).clamp(0.0, (self.h - 1) as f32);
+            let y0 = fy.floor() as usize;
+            let y1 = (y0 + 1).min(self.h - 1);
+            let wy = fy - y0 as f32;
+            for x in 0..nw {
+                let fx = ((x as f32 + 0.5) * sx - 0.5).clamp(0.0, (self.w - 1) as f32);
+                let x0 = fx.floor() as usize;
+                let x1 = (x0 + 1).min(self.w - 1);
+                let wx = fx - x0 as f32;
+                for (c, &ch) in order.iter().enumerate() {
+                    let p = |xx: usize, yy: usize| self.rgba.get((yy * self.w + xx) * 4 + ch).copied().unwrap_or(0) as f32;
+                    let top = p(x0, y0) * (1.0 - wx) + p(x1, y0) * wx;
+                    let bot = p(x0, y1) * (1.0 - wx) + p(x1, y1) * wx;
+                    if let Some(o) = out.get_mut(c * nw * nh + y * nw + x) {
+                        *o = top * (1.0 - wy) + bot * wy;
+                    }
+                }
+            }
+        }
+        out
+    }
+
+    /// Like [`Image::resize_planar`] but with a triangle filter whose width follows the scale
+    /// (the same family as PIL's bilinear resize), so shrinking a 1080p frame does not alias.
+    pub fn resize_planar_aa(&self, nw: usize, nh: usize, order: [usize; 3]) -> Vec<f32> {
+        let (nw, nh) = (nw.clamp(1, MAX_SIDE), nh.clamp(1, MAX_SIDE));
+        // taps for one axis: (first source index, weights) per output index
+        let taps = |n_in: usize, n_out: usize| -> Vec<(usize, Vec<f32>)> {
+            let scale = n_in as f32 / n_out as f32;
+            let support = scale.max(1.0);
+            (0..n_out)
+                .map(|i| {
+                    let c = (i as f32 + 0.5) * scale;
+                    let lo = ((c - support).floor().max(0.0)) as usize;
+                    let hi = (((c + support).ceil()) as usize).min(n_in);
+                    let mut w: Vec<f32> = (lo..hi).map(|j| (1.0 - ((j as f32 + 0.5 - c) / support).abs()).max(0.0)).collect();
+                    let sum: f32 = w.iter().sum();
+                    if sum > 0.0 {
+                        w.iter_mut().for_each(|v| *v /= sum);
+                    } else {
+                        w = vec![1.0];
+                    }
+                    (lo.min(n_in - 1), w)
+                })
+                .collect()
+        };
+        let tx = taps(self.w, nw);
+        let ty = taps(self.h, nh);
+        // horizontal pass: rows of the source -> (h, nw, 3)
+        let mut mid = vec![0f32; self.h * nw * 3];
+        for y in 0..self.h {
+            for (x, (lo, w)) in tx.iter().enumerate() {
+                for (c, &ch) in order.iter().enumerate() {
+                    let mut acc = 0.0;
+                    for (k, wt) in w.iter().enumerate() {
+                        let sx = (lo + k).min(self.w - 1);
+                        acc += wt * self.rgba.get((y * self.w + sx) * 4 + ch).copied().unwrap_or(0) as f32;
+                    }
+                    mid[(y * nw + x) * 3 + c] = acc;
+                }
+            }
+        }
+        let mut out = vec![0f32; 3 * nw * nh];
+        for (y, (lo, w)) in ty.iter().enumerate() {
+            for x in 0..nw {
+                for c in 0..3 {
+                    let mut acc = 0.0;
+                    for (k, wt) in w.iter().enumerate() {
+                        let sy = (lo + k).min(self.h - 1);
+                        acc += wt * mid[(sy * nw + x) * 3 + c];
+                    }
+                    out[c * nw * nh + y * nw + x] = acc;
+                }
+            }
+        }
+        out
+    }
+}
+
+/// Greedy non-maximum suppression: keeps the best of every group overlapping above `iou`.
+pub fn nms<T: Clone>(items: &mut Vec<T>, rect: impl Fn(&T) -> Rect, score: impl Fn(&T) -> f32, iou: f32, max: usize) {
+    items.sort_by(|a, b| score(b).partial_cmp(&score(a)).unwrap_or(std::cmp::Ordering::Equal));
+    let mut kept: Vec<T> = Vec::new();
+    for it in items.iter() {
+        if kept.len() >= max {
+            break;
+        }
+        let r = rect(it);
+        if kept.iter().all(|k| rect(k).iou(&r) <= iou) {
+            kept.push(it.clone());
+        }
+    }
+    *items = kept;
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn iou_of_overlapping_rects() {
+        let a = Rect::new(0.0, 0.0, 0.5, 0.5);
+        let b = Rect::new(0.25, 0.0, 0.75, 0.5);
+        assert!((a.iou(&b) - 1.0 / 3.0).abs() < 1e-6);
+        assert_eq!(a.iou(&Rect::new(0.6, 0.6, 0.7, 0.7)), 0.0);
+    }
+
+    #[test]
+    fn image_checks_its_buffer() {
+        assert!(Image::new(&[0; 15], 2, 2).is_err());
+        assert!(Image::new(&[0; 16], 0, 2).is_err());
+        assert!(Image::new(&[0; 16], 2, 2).is_ok());
+    }
+
+    #[test]
+    fn nms_keeps_the_best_of_overlapping_boxes() {
+        let mut v = vec![(Rect::new(0.0, 0.0, 0.5, 0.5), 0.6), (Rect::new(0.01, 0.0, 0.5, 0.5), 0.9), (Rect::new(0.6, 0.6, 0.9, 0.9), 0.5)];
+        nms(&mut v, |x| x.0, |x| x.1, 0.3, 10);
+        assert_eq!(v.len(), 2);
+        assert!((v[0].1 - 0.9).abs() < 1e-6);
+    }
+}
