@@ -0,0 +1,315 @@
+//! One query over many media: exact words, meaning and image, merged into ranked time ranges.
+//!
+//! Each kind of match gives a score from 0 to 1:
+//! - **words**: the share of the query's words found in a chunk (near spellings count a little
+//!   less), more when they come in order;
+//! - **meaning**: the cosine between the query and a chunk, from [`MEANING_LOW`] (0) to
+//!   [`MEANING_HIGH`] (1);
+//! - **image**: SigLIP's own probability that the picture matches the text.
+//!
+//! Matches of one kind next to each other (a few seconds) are one range; a range found by words
+//! or meaning and one found by image that overlap are one result that says both.
+
+use crate::index::{SpeechIndex, VisualIndex, dot};
+use crate::text::{self, Query, Word};
+
+/// A cosine at or below this is not related (0 score).
+pub const MEANING_LOW: f32 = 0.25;
+/// A cosine at or above this is as related as it gets (1).
+pub const MEANING_HIGH: f32 = 0.55;
+/// The least a meaning match must score to count.
+pub const MEANING_MIN: f32 = 0.45;
+/// The least a word match must score to count.
+pub const WORDS_MIN: f32 = 0.45;
+/// The least an image match must score to count.
+pub const IMAGE_MIN: f32 = 0.08;
+/// Matches of one kind this close (seconds) are joined.
+pub const JOIN_GAP: f32 = 2.0;
+/// Most results.
+pub const MAX_HITS: usize = 60;
+/// Results scoring under this share of the best one are left out.
+pub const RELATIVE_MIN: f32 = 0.35;
+/// Words kept around a matched word in a quote.
+const QUOTE_WORDS: usize = 14;
+/// Longest quote, in characters.
+const QUOTE_CHARS: usize = 220;
+
+/// One media file to look in.
+#[derive(Clone, Copy)]
+pub struct MediaRef<'a> {
+    /// Whatever the caller uses to name the file (the project item id).
+    pub id: u64,
+    pub speech: Option<&'a SpeechIndex>,
+    pub visual: Option<&'a VisualIndex>,
+}
+
+/// The query as the models read it.
+#[derive(Clone, Debug, Default)]
+pub struct QueryVectors {
+    /// Meaning of the query (length 1), when the meaning model is there.
+    pub meaning: Option<Vec<f32>>,
+    /// Image-space embedding of the query (length 1), when the picture model is there.
+    pub image: Option<Vec<f32>>,
+    pub image_scale: f32,
+    pub image_bias: f32,
+}
+
+/// A result: a range of one media file and why it matched.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Hit {
+    pub id: u64,
+    pub start: f32,
+    pub end: f32,
+    /// 0..1.
+    pub score: f32,
+    /// Found by what is said (words).
+    pub words: bool,
+    /// Found by what the words mean.
+    pub meaning: bool,
+    /// Found by what is seen.
+    pub image: bool,
+    /// What is said there (empty for an image-only result).
+    pub quote: String,
+    /// The media time of the best moment (for the thumbnail).
+    pub best: f32,
+}
+
+fn sigmoid(x: f32) -> f32 {
+    1.0 / (1.0 + (-x).exp())
+}
+
+/// The image score of cosine `cos` for a model with logit scale and bias.
+pub fn image_score(cos: f32, scale: f32, bias: f32) -> f32 {
+    let p = sigmoid(scale * cos + bias);
+    if p.is_finite() { p } else { 0.0 }
+}
+
+/// The meaning score of cosine `cos`.
+pub fn meaning_score(cos: f32) -> f32 {
+    ((cos - MEANING_LOW) / (MEANING_HIGH - MEANING_LOW)).clamp(0.0, 1.0)
+}
+
+fn cut(s: &str, max: usize) -> String {
+    if s.chars().count() <= max { s.to_string() } else { format!("{}…", s.chars().take(max).collect::<String>().trim_end()) }
+}
+
+/// Joins `hits` of one media that are within [`JOIN_GAP`] of each other.
+fn join(mut hits: Vec<Hit>) -> Vec<Hit> {
+    hits.sort_by(|a, b| a.start.total_cmp(&b.start));
+    let mut out: Vec<Hit> = Vec::new();
+    for h in hits {
+        match out.last_mut() {
+            Some(l) if h.start <= l.end + JOIN_GAP => {
+                if h.score > l.score {
+                    l.best = h.best;
+                    if !h.quote.is_empty() {
+                        l.quote = h.quote.clone();
+                    }
+                } else if l.quote.is_empty() {
+                    l.quote = h.quote.clone();
+                }
+                l.end = l.end.max(h.end);
+                l.score = 1.0 - (1.0 - l.score) * (1.0 - h.score * 0.5);
+                l.words |= h.words;
+                l.meaning |= h.meaning;
+                l.image |= h.image;
+            }
+            _ => out.push(h),
+        }
+    }
+    out
+}
+
+fn speech_hits(id: u64, s: &SpeechIndex, q: &Query, qv: &QueryVectors) -> Vec<Hit> {
+    let folded: Vec<String> = s.words.iter().map(|w| text::fold(&w.text).split_whitespace().collect::<Vec<_>>().join("")).collect();
+    let mut out = Vec::new();
+    for (ci, c) in s.chunks.iter().enumerate() {
+        let (a, b) = (c.first as usize, c.end_word as usize);
+        let Some(cw) = folded.get(a..b) else { continue };
+        let lex = text::find_terms(q, cw).filter(|h| h.score >= WORDS_MIN);
+        let mean = qv.meaning.as_deref().zip(s.vector(ci)).map(|(qm, cv)| meaning_score(dot(qm, cv))).filter(|m| *m >= MEANING_MIN);
+        if lex.is_none() && mean.is_none() {
+            continue;
+        }
+        let l = lex.map_or(0.0, |h| h.score);
+        let m = mean.unwrap_or(0.0);
+        let score = 1.0 - (1.0 - l) * (1.0 - m);
+        let words: &[Word] = s.words.get(a..b).unwrap_or(&[]);
+        let (start, end, quote, best) = match (lex, mean) {
+            (Some(h), None) => {
+                let (fw, lw) = (words.get(h.first), words.get(h.last));
+                let st = fw.map_or(c.start, |w| w.start);
+                let en = lw.map_or(c.end, |w| w.end);
+                ((st - 0.4).max(0.0), en + 0.4, text::quote(words, h.first, h.last, QUOTE_WORDS), st)
+            }
+            (Some(h), Some(_)) => {
+                let st = words.get(h.first).map_or(c.start, |w| w.start);
+                (c.start, c.end, text::quote(words, h.first, h.last, QUOTE_WORDS), st)
+            }
+            _ => (c.start, c.end, cut(&c.text, QUOTE_CHARS), c.start),
+        };
+        out.push(Hit { id, start, end, score, words: lex.is_some(), meaning: mean.is_some(), image: false, quote: cut(&quote, QUOTE_CHARS), best });
+    }
+    out
+}
+
+fn image_hits(id: u64, v: &VisualIndex, qv: &QueryVectors) -> Vec<Hit> {
+    let Some(qi) = qv.image.as_deref() else { return Vec::new() };
+    if v.dim == 0 || qi.len() != v.dim {
+        return Vec::new();
+    }
+    let gap = v.interval * 1.6;
+    let mut out: Vec<Hit> = Vec::new();
+    let mut last_t = f32::NEG_INFINITY;
+    for (i, t) in v.times.iter().enumerate() {
+        let Some(vec) = v.vector(i) else { break };
+        let s = image_score(dot(qi, vec), qv.image_scale, qv.image_bias);
+        if s < IMAGE_MIN {
+            continue;
+        }
+        let end = (*t + v.interval).min(v.duration.max(*t));
+        match out.last_mut() {
+            Some(l) if *t - last_t <= gap => {
+                l.end = end;
+                if s > l.score {
+                    l.score = s;
+                    l.best = *t;
+                }
+            }
+            _ => out.push(Hit { id, start: *t, end, score: s, words: false, meaning: false, image: true, quote: String::new(), best: *t }),
+        }
+        last_t = *t;
+    }
+    out
+}
+
+/// Searches `media` for `query`. `qv` holds the query as the models read it (empty parts are
+/// skipped: without them only the words are searched).
+pub fn search(query: &str, qv: &QueryVectors, media: &[MediaRef]) -> Vec<Hit> {
+    let q = Query::parse(query);
+    let mut all: Vec<Hit> = Vec::new();
+    for m in media {
+        let mut hits = Vec::new();
+        if let Some(s) = m.speech {
+            hits.extend(join(speech_hits(m.id, s, &q, qv)));
+        }
+        let speech_n = hits.len();
+        if let Some(v) = m.visual {
+            hits.extend(image_hits(m.id, v, qv));
+        }
+        // a range by words and one by image that overlap are one result
+        let (spoken, seen) = hits.split_at(speech_n);
+        let mut taken = vec![false; seen.len()];
+        for sp in spoken {
+            let mut h = sp.clone();
+            for (k, im) in seen.iter().enumerate() {
+                if im.start <= h.end + 1.0 && im.end >= h.start - 1.0 {
+                    taken[k] = true;
+                    h.image = true;
+                    h.score = 1.0 - (1.0 - h.score) * (1.0 - im.score * 0.6);
+                    h.start = h.start.min(im.start);
+                    h.end = h.end.max(im.end);
+                }
+            }
+            all.push(h);
+        }
+        for (k, im) in seen.iter().enumerate() {
+            if !taken.get(k).copied().unwrap_or(false) {
+                all.push(im.clone());
+            }
+        }
+    }
+    all.retain(|h| h.score.is_finite() && h.start.is_finite() && h.end.is_finite());
+    all.sort_by(|a, b| b.score.total_cmp(&a.score).then(a.id.cmp(&b.id)).then(a.start.total_cmp(&b.start)));
+    let top = all.first().map_or(0.0, |h| h.score);
+    all.retain(|h| h.score >= top * RELATIVE_MIN);
+    all.truncate(MAX_HITS);
+    all
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::index::normalize;
+
+    fn speech(texts: &[(&str, f32)]) -> SpeechIndex {
