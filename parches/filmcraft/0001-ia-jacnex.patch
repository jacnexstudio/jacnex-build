+//! Checks the network against the PyTorch reference and runs the whole pipeline on the real weights.
+//!
+//! Needs the weights, so it is off unless these are set:
+//! - `JACNEX_SEPARATE_MODEL`: the folder with `model.safetensors` and `config.json` (`separar-kim-vocal-2`)
+//! - `JACNEX_SEPARATE_REF`: the folder `referencia.py` wrote (`entrada.f32`, `voz.f32`, `banda.f32`, `capa0.f32`)
+#![cfg(feature = "candle")]
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::path::PathBuf;
+use std::sync::atomic::AtomicBool;
+
+use filmcraft_separate::ChunkModel;
+use filmcraft_separate::model::MelBandRoformer;
+
+fn dirs() -> Option<(PathBuf, PathBuf)> {
+    let m = std::env::var_os("JACNEX_SEPARATE_MODEL")?;
+    let r = std::env::var_os("JACNEX_SEPARATE_REF")?;
+    Some((PathBuf::from(m), PathBuf::from(r)))
+}
+
+fn floats(path: PathBuf) -> Vec<f32> {
+    std::fs::read(path).unwrap().as_chunks::<4>().0.iter().map(|b| f32::from_le_bytes(*b)).collect()
+}
+
+/// Largest difference as a share of the reference's own spread.
+fn rel(a: &[f32], b: &[f32]) -> f32 {
+    assert_eq!(a.len(), b.len());
+    let scale = b.iter().fold(0.0f32, |m, v| m.max(v.abs())).max(1e-9);
+    a.iter().zip(b).map(|(x, y)| (x - y).abs()).fold(0.0f32, f32::max) / scale
+}
+
+#[test]
+fn the_network_matches_the_pytorch_reference() {
+    let Some((model, refs)) = dirs() else {
+        eprintln!("skipped: JACNEX_SEPARATE_MODEL / JACNEX_SEPARATE_REF not set");
+        return;
+    };
+    let net = MelBandRoformer::load(&model).unwrap();
+    let input = floats(refs.join("entrada.f32"));
+    let n = net.chunk();
+    assert_eq!(input.len(), 2 * n);
+    let t0 = std::time::Instant::now();
+    let (l, r, taps) = net.forward_taps(&input[..n], &input[n..]).unwrap();
+    eprintln!("one chunk: {:?}", t0.elapsed());
+    let (want_bands, want_l0, want_voice) = (floats(refs.join("banda.f32")), floats(refs.join("capa0.f32")), floats(refs.join("voz.f32")));
+    let (e_b, e_0) = (rel(&taps.bands, &want_bands), rel(&taps.layer0, &want_l0));
+    let mut voice = l;
+    voice.extend(r);
+    let e_v = rel(&voice, &want_voice);
+    eprintln!("band split {e_b:e}, layer 0 {e_0:e}, voice {e_v:e}");
+    // f16 weights and f32 maths: a few thousandths of the reference's own range at most
+    assert!(e_b < 2e-2, "band split {e_b}");
+    assert!(e_0 < 2e-2, "layer 0 {e_0}");
+    assert!(e_v < 5e-2, "voice {e_v}");
+}
+
+#[test]
+fn a_whole_clip_goes_through_the_real_network_and_stops_on_request() {
+    let Some((model, refs)) = dirs() else {
+        eprintln!("skipped: JACNEX_SEPARATE_MODEL / JACNEX_SEPARATE_REF not set");
+        return;
+    };
+    let net = MelBandRoformer::load(&model).unwrap();
+    let input = floats(refs.join("entrada.f32"));
+    let n = net.chunk();
+    // 48 kHz, interleaved, a bit longer than a chunk at the network's rate
+    let frames = 48_000 * 9;
+    let mut clip = Vec::with_capacity(frames * 2);
+    for i in 0..frames {
+        let j = i * 44_100 / 48_000 % n;
+        clip.push(input[j]);
+        clip.push(input[n + j]);
+    }
+    let stop = AtomicBool::new(false);
+    let s = filmcraft_separate::separate(&net, &clip, 48_000, 2, &stop, &mut |_| {}).unwrap();
+    assert_eq!((s.voice.len(), s.background.len()), (clip.len(), clip.len()));
+    assert!(s.voice.iter().chain(&s.background).all(|v| v.is_finite()));
+    assert!(clip.iter().zip(s.voice.iter().zip(&s.background)).all(|(c, (v, b))| (c - (v + b)).abs() < 1e-5));
+    let stop = AtomicBool::new(true);
+    assert!(matches!(filmcraft_separate::separate(&net, &clip, 48_000, 2, &stop, &mut |_| {}), Err(filmcraft_separate::SeparateError::Stopped)));
+}
+
+#[test]
+fn a_missing_or_wrong_model_folder_is_an_error() {
+    let dir = tempfile::tempdir().unwrap();
+    assert!(MelBandRoformer::load(dir.path()).is_err());
+    std::fs::write(dir.path().join("config.json"), r#"{"model_type":"mel_band_roformer","dim":512}"#).unwrap();
+    std::fs::write(dir.path().join("model.safetensors"), b"not a model").unwrap();
+    assert!(MelBandRoformer::load(dir.path()).is_err());
+}
+
+/// Speed and memory on a minute of audio. Slow (minutes), so it also needs `JACNEX_SEPARATE_LONG=1`.
+#[test]
+fn a_minute_of_audio_takes_bounded_time_and_memory() {
+    let Some((model, refs)) = dirs() else {
+        return;
+    };
+    if std::env::var_os("JACNEX_SEPARATE_LONG").is_none() {
+        eprintln!("skipped: JACNEX_SEPARATE_LONG not set");
+        return;
+    }
+    let net = MelBandRoformer::load(&model).unwrap();
+    let input = floats(refs.join("entrada.f32"));
+    let n = net.chunk();
+    let frames = 44_100 * 60;
+    let mut clip = Vec::with_capacity(frames * 2);
+    for i in 0..frames {
+        clip.push(input[i % n]);
+        clip.push(input[n + i % n]);
+    }
+    let t0 = std::time::Instant::now();
+    let mut last = 0.0;
+    let s = filmcraft_separate::separate(&net, &clip, 44_100, 2, &AtomicBool::new(false), &mut |p| last = p).unwrap();
+    let took = t0.elapsed();
+    eprintln!("60 s of audio: {took:?} ({:.2}x real time), progress ended at {last}", took.as_secs_f64() / 60.0);
+    assert_eq!(s.voice.len(), clip.len());
+}
