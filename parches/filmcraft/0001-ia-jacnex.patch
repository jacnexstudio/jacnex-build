+    assert!(leer_momentos(&json!({"momentos": "no"}), ItemId(1), 10.0).is_empty());
+    assert!(leer_momentos(&json!(null), ItemId(1), 10.0).is_empty());
+    let muchos = json!({"momentos": (0..100).map(|i| json!({"inicio": i, "fin": i + 1})).collect::<Vec<_>>()});
+    assert_eq!(leer_momentos(&muchos, ItemId(1), 1000.0).len(), MAX_MOMENTOS);
+}
+
+#[test]
+fn the_reason_is_the_quoted_words_or_image() {
+    let base = Hit { id: 1, start: 61.0, end: 70.5, score: 0.5, words: true, meaning: false, image: false, quote: " el precio es bajo ".into(), best: 62.0 };
+    assert_eq!(razon(&base), "«el precio es bajo»");
+    assert_eq!(razon(&Hit { image: true, ..base.clone() }), "«el precio es bajo» · imagen");
+    assert_eq!(razon(&Hit { words: false, image: true, quote: String::new(), ..base.clone() }), "imagen");
+    assert!(razon(&Hit { quote: "a".repeat(500), ..base.clone() }).chars().count() < 100);
+    assert_eq!(rango(&base), "1:01 – 1:10");
+    assert_eq!(tiempo(f32::NAN), "0:00");
+    assert_eq!(tiempo(3725.0), "1:02:05");
+}
+
+#[test]
+fn searching_the_project_lists_moments_and_opens_them() {
+    let mut app = app(&[("hola", 0.1, 0.4), ("el", 0.5, 0.6), ("precio", 0.7, 1.2), ("final", 1.3, 1.6)]);
+    let ctx = egui::Context::default();
+    app.jacnex_ia.buscar.consulta = "precio".into();
+    let cache = carpeta("cache");
+    buscar_con(&mut app, Some(cache.clone()), None);
+    assert!(app.jacnex_ia.buscar.ocupado());
+    esperar(&mut app, &ctx);
+    let b = &app.jacnex_ia.buscar;
+    assert!(b.aviso.as_ref().is_some_and(|(ok, _)| *ok), "{:?}", b.aviso);
+    assert!(!b.resultados.is_empty(), "{:?}", b.aviso);
+    assert!(b.resultados.iter().any(|r| r.razon.contains("precio")), "{:?}", b.resultados.iter().map(|r| r.razon.clone()).collect::<Vec<_>>());
+    // the transcripts made on the way went into the project
+    assert!(!app.session.project.transcripts.is_empty());
+    // "Ver" opens the clip in the source monitor with the range marked
+    let hit = app.jacnex_ia.buscar.resultados[0].hit.clone();
+    ir(&mut app, 0, false);
+    assert_eq!(app.session.state.source_item, Some(ItemId(hit.id)));
+    let it = app.session.project.item(ItemId(hit.id)).unwrap();
+    let m = it.as_media().unwrap();
+    assert!(m.mark_in.is_some() && m.mark_out.is_some_and(|o| o > m.mark_in.unwrap()), "{:?} {:?}", m.mark_in, m.mark_out);
+    let _ = std::fs::remove_dir_all(cache);
+}
+
+#[test]
+fn nothing_found_says_so_and_an_empty_query_does_not_search() {
