+    q.check().unwrap();
+    assert_eq!(s.history.undo.len(), undo + 1, "one undo step");
+    s.undo().unwrap();
+    assert_eq!(s.project.sequence(made_for).unwrap().audio_tracks.len(), tracks);
+    assert_eq!(s.project.sequence(made_for).unwrap().find_item(clip).unwrap().1.gain_db, 0.0);
+}
