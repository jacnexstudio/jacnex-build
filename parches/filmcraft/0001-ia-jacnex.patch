new file mode 100644
index 0000000..0c3a0b9
--- /dev/null
+++ b/crates/engine/src/reframe_apply_tests.rs
@@ -0,0 +1,73 @@
+//! Jacnex: Pasar a vertical: the new sequence and the camera written into its clips.
+
+use filmcraft_project::{ItemKind, ParamValue};
+use filmcraft_reframe::plan::{Aspect, Key};
+use serde_json::json;
+
+use super::*;
+use crate::Session;
+use crate::reframe_job::ShotPlan;
+
+fn demo() -> (Session, filmcraft_project::ClipId, (u32, u32)) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let item = s.project.items.values().find(|i| i.has_video() && i.as_media().is_some()).map(|i| i.id).unwrap();
+    s.execute("file.newSequence", json!({"name": "Landscape", "video": 1, "audio": 1, "width": 1920, "height": 1080})).unwrap();
+    s.execute("timeline.place", json!({"item": item.0, "time": 0})).unwrap();
+    let it = s.active_sequence().unwrap().video_tracks[0].items[0].clone();
+    let v = s.source(it.item).unwrap().info().video.clone().unwrap();
+    (s, it.id, (v.width, v.height))
+}
+
+fn result(s: &Session, clip: filmcraft_project::ClipId, size: (u32, u32), aspect: Aspect) -> ReframeResult {
+    let seq = s.state.active_sequence.unwrap();
+    let dur = s.active_sequence().unwrap().find_item(clip).unwrap().1.duration.seconds();
+    let shots = vec![
+        ShotPlan { start: 0.0, end: dur / 2.0, keys: vec![Key { t: 0.0, cx: 0.3, cy: 0.5 }, Key { t: dur / 2.0 - 0.1, cx: 0.4, cy: 0.5 }] },
+        ShotPlan { start: dur / 2.0, end: dur, keys: vec![Key { t: dur / 2.0, cx: 0.8, cy: 0.5 }] },
+    ];
+    ReframeResult { seq, aspect, plans: vec![ClipPlan { clip, name: "c".into(), size, shots, found: [1, 0, 0, 0], speaker_samples: 0 }], skipped: 0 }
+}
+
+#[test]
+fn makes_a_new_vertical_sequence_and_leaves_the_original() {
+    let (mut s, clip, size) = demo();
+    let orig = s.state.active_sequence.unwrap();
+    let steps = s.history.undo.len();
+    let r = result(&s, clip, size, Aspect::VERTICAL);
+    let v = apply(&mut s, r).unwrap();
+    assert_eq!((v["width"].as_u64(), v["height"].as_u64()), (Some(1080), Some(1920)));
+    assert_eq!(s.history.undo.len(), steps + 1, "one undo step");
+    let new = s.state.active_sequence.unwrap();
+    assert_ne!(new, orig);
+    let (q0, q1) = match (&s.project.item(orig).unwrap().kind, &s.project.item(new).unwrap().kind) {
+        (ItemKind::Sequence(a), ItemKind::Sequence(b)) => (a.clone(), b.clone()),
+        _ => panic!("sequences"),
+    };
+    assert_eq!((q0.settings.width, q0.settings.height), (1920, 1080), "the original is untouched");
+    assert_eq!((q1.settings.width, q1.settings.height), (1080, 1920));
+    let it = q1.find_item(clip).unwrap().1;
+    let m = it.effect("motion").unwrap();
+    let pos = m.param("position").unwrap();
+    assert_eq!(pos.keyframes.len(), 3);
+    assert_eq!(pos.keyframes[1].interp, filmcraft_project::Interpolation::Hold, "a cut holds");
+    // the camera at 30 % of the width puts that point at the middle of the vertical frame
+    let sc = m.f64_at("scale", filmcraft_time::Tick::ZERO) / 100.0;
+    let base = if it.scale_to_frame { (1080.0 / f64::from(size.0)).min(1920.0 / f64::from(size.1)) } else { 1.0 };
+    let k = sc * base;
+    let ParamValue::Vec2(p0) = pos.keyframes[0].value.clone() else { panic!("vec2") };
+    let sx = 0.3 * f64::from(size.0);
+    assert!((p0.x + k * (sx - f64::from(size.0) / 2.0) - 540.0).abs() < 0.5);
+    // the crop covers the full height
+    assert!((k * f64::from(size.1) - 1920.0).abs() < 0.5);
+    s.undo();
+    assert!(s.project.item(new).is_none(), "undo removes the new sequence");
+    assert!(s.project.item(orig).is_some());
+}
+
+#[test]
+fn square_and_four_by_five_sizes() {
+    assert_eq!(out_size(Aspect::SQUARE), (1080, 1080));
+    assert_eq!(out_size(Aspect::PORTRAIT), (1080, 1350));
+    assert_eq!(out_size(Aspect::VERTICAL), (1080, 1920));
+}
