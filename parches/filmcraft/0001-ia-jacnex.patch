+//! Jacnex: Doblaje (IA de Jacnex › Audio › Doblaje).
+//!
+//! Dobla lo que se dice en el clip seleccionado (o en toda la secuencia) a otro idioma, con la misma
+//! duración y los mismos tiempos:
+//! 1. Se toma la transcripción y se agrupa en frases (cambio de voz, pausa o punto).
+//! 2. El servidor de Jacnex las traduce (con el largo que cabe en el tiempo de cada una) y las lee con
+//!    una voz natural, una por frase ([`crate::jacnex_ia::doblaje_red`]). Antes de enviar se muestra
+//!    lo que costaría como máximo; se cobra lo que cuesta de verdad y el resto se devuelve.
+//! 3. Aquí se bajan las voces, se ponen cada una en el momento de su frase
+//!    ([`filmcraft_engine::dub::mix`]) y se crea una pista de audio NUEVA alineada con el clip; el audio
+//!    original baja de volumen o se silencia, pero no se borra ([`filmcraft_engine::dub::apply`]).
+//!    Todo es un solo paso de deshacer.
+//!
+//! No clona la voz de quien habla (se elige una voz del catálogo) y no hay sincronía de labios.
+//! El trabajo va en un hilo aparte con «Detener».
+
+use std::cell::RefCell;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{Receiver, Sender, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::RichText;
+use filmcraft_edit::transcript::SeqWord;
+use filmcraft_engine::dub::{self, Fit, Original, Phrase};
+use filmcraft_project::{ClipId, ItemId};
+use filmcraft_time::Tick;
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+use crate::jacnex_ia::doblaje_red::{self, Avance};
+use crate::jacnex_ia::{ACENTO, ACENTO_CLARO, Estado, ROJO, VERDE, boton_acento, creditos, titulo};
+
+/// Los idiomas que se ofrecen si el servidor no dice otros: (código, nombre).
+pub const IDIOMAS: &[(&str, &str)] = &[("es", "Español"), ("en", "Inglés"), ("pt", "Portugués"), ("fr", "Francés"), ("it", "Italiano"), ("de", "Alemán")];
+/// Una pausa así de larga separa dos frases (segundos).
+const PAUSA: f64 = 0.6;
+/// Una frase no pasa de esta duración (segundos) ni de estas letras.
+const MAX_FRASE_SEGUNDOS: f64 = 12.0;
+const MAX_FRASE_LETRAS: usize = 500;
+/// Lo que se acepta del catálogo del servidor.
+const MAX_IDIOMAS: usize = 16;
+const MAX_VOCES: usize = 64;
+
+/// El doblaje del servidor: sus límites y cómo calcula lo que reserva.
+#[derive(Clone, Debug, PartialEq)]
+pub struct DoblajeNube {
+    pub id: String,
+    pub nombre: String,
+    /// Créditos por cada 1 000 letras de voz.
+    pub por_mil: f64,
+    /// Cuánto más largo puede salir el texto traducido.
+    pub expansion: f64,
+    pub creditos_traduccion: i64,
+    pub max_frases: usize,
+    pub max_letras: usize,
+    pub max_segundos: f64,
+    /// (código, nombre).
+    pub idiomas: Vec<(String, String)>,
+    /// (id, «Nombre · estilo»).
+    pub voces: Vec<(String, String)>,
+}
+
+impl DoblajeNube {
+    /// Lo más que se cobra por doblar `frases` con `letras` (el servidor reserva esto y devuelve lo que sobre).
+    pub fn reserva(&self, letras: usize, frases: usize) -> i64 {
+        #[allow(clippy::cast_precision_loss)]
+        let ampliadas = (letras as f64 * self.expansion).ceil();
+        #[allow(clippy::cast_possible_truncation)]
+        let voz = ((ampliadas * self.por_mil / 1000.0).ceil().clamp(1.0, 1e9)) as i64;
+        let frases = i64::try_from(frases).unwrap_or(i64::MAX);
+        voz.max(frases).saturating_add(self.creditos_traduccion)
+    }
+}
+
+/// Una entrada de `doblajes` (sin id o con números fuera de rango se ignora).
+pub fn leer(m: &Value) -> Option<DoblajeNube> {
+    let n = |k: &str| m.get(k).and_then(Value::as_f64).filter(|x| x.is_finite() && *x >= 0.0);
+    let id = m.get("id").and_then(Value::as_str).filter(|i| !i.is_empty() && i.len() <= 64)?.to_string();
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    let entero = |k: &str, tope: f64| n(k).map(|x| x.min(tope) as usize);
+    let nombre_idioma = |c: &str| IDIOMAS.iter().find(|(i, _)| *i == c).map_or_else(|| c.to_string(), |(_, n)| (*n).to_string());
+    let idiomas: Vec<(String, String)> = m
+        .get("idiomas")
+        .and_then(Value::as_array)
+        .map(|a| {
+            a.iter()
+                .filter_map(Value::as_str)
+                .filter(|c| (2..=8).contains(&c.len()) && c.chars().all(|x| x.is_ascii_alphabetic()))
+                .take(MAX_IDIOMAS)
+                .map(|c| (c.to_string(), nombre_idioma(c)))
+                .collect()
+        })
+        .unwrap_or_default();
+    let voces: Vec<(String, String)> = m
+        .get("voces")
+        .and_then(Value::as_array)
+        .map(|a| {
+            a.iter()
+                .filter_map(|v| {
+                    let s = |k: &str| v.get(k).and_then(Value::as_str).unwrap_or("").chars().take(40).collect::<String>();
+                    let id = v.get("id").and_then(Value::as_str).filter(|i| !i.is_empty() && i.len() <= 64)?.to_string();
+                    let (nombre, estilo) = (s("nombre"), s("estilo"));
+                    let texto = if estilo.is_empty() { nombre } else { format!("{nombre} · {estilo}") };
+                    Some((id, texto))
+                })
+                .take(MAX_VOCES)
+                .collect()
+        })
+        .unwrap_or_default();
+    #[allow(clippy::cast_possible_truncation)]
+    Some(DoblajeNube {
+        nombre: m.get("nombre").and_then(Value::as_str).unwrap_or("Doblaje").chars().take(80).collect(),
+        por_mil: n("creditosPorMil").filter(|x| *x > 0.0)?.min(10_000.0),
+        expansion: n("expansion").filter(|x| *x >= 1.0)?.min(4.0),
+        creditos_traduccion: n("creditosTraduccion")?.min(1000.0) as i64,
+        max_frases: entero("maxSegmentos", 1000.0).filter(|x| *x > 0)?,
+        max_letras: entero("maxLetras", 200_000.0).filter(|x| *x > 0)?,
+        max_segundos: n("maxSegundos").filter(|x| *x > 0.0)?.min(dub::MAX_TOTAL_SECONDS),
+        idiomas,
+        voces,
+        id,
+    })
+}
+
+/// Una frase para doblar.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Frase {
+    pub id: u32,
+    /// Segundos desde el principio del tramo.
+    pub inicio: f64,
+    pub fin: f64,
+    pub texto: String,
+}
+
+/// Agrupa las palabras en frases: se corta al cambiar quien habla, en una pausa de [`PAUSA`] s, tras un
+/// punto (o `?`, `!`) y cuando la frase ya es larga. Los tiempos son desde `origen`.
+pub fn agrupar(palabras: &[SeqWord], origen: Tick) -> Vec<Frase> {
+    let mut orden: Vec<&SeqWord> = palabras.iter().filter(|w| !w.text.trim().is_empty()).collect();
+    orden.sort_by_key(|w| (w.start, w.end));
+    let seg = |t: Tick| (t - origen).seconds().max(0.0);
+    let mut frases: Vec<Frase> = Vec::new();
+    let mut quien: Option<&Option<String>> = None;
+    let mut cortar = true;
+    for w in orden {
+        let (a, b) = (seg(w.start), seg(w.end));
+        let nueva = match frases.last() {
+            None => true,
+            Some(f) => {
+                cortar
+                    || quien != Some(&w.speaker)
+                    || a - f.fin >= PAUSA
+                    || f.fin - f.inicio >= MAX_FRASE_SEGUNDOS
+                    || f.texto.chars().count() >= MAX_FRASE_LETRAS
+            }
+        };
+        let texto = w.text.trim();
+        if nueva {
+            let id = u32::try_from(frases.len()).unwrap_or(u32::MAX);
+            frases.push(Frase { id, inicio: a, fin: b.max(a + 0.05), texto: texto.to_string() });
+        } else if let Some(f) = frases.last_mut() {
+            f.texto.push(' ');
+            f.texto.push_str(texto);
+            f.fin = f.fin.max(b).max(a + 0.05);
+        }
+        quien = Some(&w.speaker);
+        cortar = texto.ends_with(['.', '?', '!', '…']);
+    }
+    frases
+}
+
+/// Lo que se va a doblar, calculado del proyecto.
+#[derive(Clone, Debug, Default)]
+struct Tramo {
+    frases: Vec<Frase>,
+    letras: usize,
+    clips: Vec<ClipId>,
+    inicio: Tick,
+    segundos: f64,
+}
+
+fn tramo(app: &FilmcraftApp) -> Tramo {
+    let alcance = dub::dub_scope(&app.session);
+    let frases = agrupar(&alcance.words, alcance.start);
+    let letras = frases.iter().map(|f| f.texto.chars().count()).fold(0usize, usize::saturating_add);
+    Tramo { frases, letras, clips: alcance.clips, inicio: alcance.start, segundos: alcance.seconds }
+}
+
+/// Lo que se hizo la última vez que se calculó el tramo (para no hacerlo en cada cuadro).
+struct Memoria {
+    revision: u64,
+    seleccion: Vec<ClipId>,
+    tramo: Tramo,
+}
+
+/// Quién habla: el idioma de origen se detecta solo.
+const AUTO: &str = "auto";
+
+/// Los ajustes de «Doblaje» y el trabajo en curso.
+#[derive(Default)]
+pub struct Doblaje {
+    /// El idioma al que se dobla (vacío = el primero que ofrece el servidor).
+    pub destino: String,
+    /// El idioma que se habla (vacío = automático).
+    pub origen: String,
+    /// La voz (vacío = la primera).
+    pub voz: String,
+    /// Solo para pruebas: otro separador de voz.
+    separador: Option<&'static dyn dub::Separator>,
+    pendiente: Option<Pedido>,
+    trabajo: Option<Trabajo>,
+    memoria: RefCell<Option<Memoria>>,
+    /// El último aviso: (salió bien, texto).
+    pub aviso: Option<(bool, String)>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Pedido {
+    Doblar,
+    Detener,
+    /// Transcribir primero (con el motor elegido en «Editar»).
+    Transcribir,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Etapa {
+    Enviando,
+    Traduciendo,
+    Voces {
+        hechas: u32,
+        total: u32,
+    },
+    Bajando {
+        hechas: usize,
+        total: usize,
+    },
+    Armando,
+    /// Separando la voz de la música (porcentaje).
+    Separando(u8),
+}
+
+struct Salida {
+    muestras: Vec<f32>,
+    creditos: i64,
+    colocadas: usize,
+    faltan: usize,
+    ajuste: Fit,
+    inicio: Tick,
+    clips: Vec<ClipId>,
+    secuencia: ItemId,
+    /// La música y los efectos (intercalado, frecuencia, canales).
+    fondo: Option<(Vec<f32>, u32, u16)>,
+    destino: String,
+}
+
+enum Mensaje {
+    Etapa(Etapa),
+    Hecho(Result<Salida, String>),
+}
+
+struct Trabajo {
+    rx: Receiver<Mensaje>,
+    parar: Arc<AtomicBool>,
+    etapa: Etapa,
+    inicio: Instant,
+}
+
+impl Doblaje {
+    pub fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    fn destino_en<'a>(&'a self, n: &'a DoblajeNube) -> &'a str {
+        n.idiomas.iter().map(|(c, _)| c.as_str()).find(|c| *c == self.destino).or_else(|| n.idiomas.first().map(|(c, _)| c.as_str())).unwrap_or("en")
+    }
+
+    fn origen_en<'a>(&'a self, n: &DoblajeNube) -> &'a str {
+        if n.idiomas.iter().any(|(c, _)| *c == self.origen) { self.origen.as_str() } else { AUTO }
+    }
+
+    fn voz_en<'a>(&'a self, n: &'a DoblajeNube) -> &'a str {
+        n.voces.iter().map(|(i, _)| i.as_str()).find(|i| *i == self.voz).or_else(|| n.voces.first().map(|(i, _)| i.as_str())).unwrap_or("")
+    }
+
+    fn sep(&self) -> &'static dyn dub::Separator {
+        self.separador.unwrap_or_else(dub::separator)
+    }
+}
+
+// --- Lo que la ventana necesita ----------------------------------------------------------------
+
+/// Lo que «Doblaje» muestra del proyecto y de la cuenta.
+pub struct Datos {
+    nube: Option<DoblajeNube>,
+    sesion: bool,
+    saldo: Option<i64>,
+    frases: usize,
+    letras: usize,
+    segundos: f64,
+    /// Hay clips con audio sin transcribir (se puede transcribir primero).
+    sin_transcribir: bool,
+    falta: Option<&'static str>,
+}
+
+/// Se calcula antes de dibujar la ventana.
+pub fn datos(app: &FilmcraftApp) -> Datos {
+    let e = &app.jacnex_ia;
+    let (frases, letras, segundos) = {
+        let mut m = e.doblaje.memoria.borrow_mut();
+        let vieja = m.as_ref().is_none_or(|x| x.revision != app.session.revision || x.seleccion != app.session.state.selection);
+        if vieja {
+            *m = Some(Memoria { revision: app.session.revision, seleccion: app.session.state.selection.clone(), tramo: tramo(app) });
+        }
+        m.as_ref().map_or((0, 0, 0.0), |x| (x.tramo.frases.len(), x.tramo.letras, x.tramo.segundos))
+    };
+    Datos {
+        nube: e.doblaje_nube().cloned(),
+        sesion: e.hay_sesion(),
+        saldo: e.saldo(),
+        frases,
+        letras,
+        segundos,
+        sin_transcribir: !filmcraft_engine::speech_job::untranscribed_sequence_items(&app.session).is_empty(),
+        falta: falta(app),
+    }
+}
+
+const SIN_SEPARADOR: &str = "Actualiza Filmnex desde Jacnex Studio para usar esta función.";
+
+/// Por qué no se puede doblar ahora (o nada).
+pub fn falta(app: &FilmcraftApp) -> Option<&'static str> {
+    let e = &app.jacnex_ia;
+    if e.doblaje.ocupado() {
+        return Some("Espera a que termine el doblaje.");
+    }
+    if e.edicion.ocupado() {
+        return Some("Espera a que termine la transcripción.");
+    }
+    if app.session.active_sequence().is_none() {
+        return Some("Abre una secuencia con voz.");
+    }
+    if !e.doblaje.sep().available() {
+        return Some(SIN_SEPARADOR);
+    }
+    if !e.hay_sesion() {
+        return Some("Inicia sesión en Jacnex Studio para doblar.");
+    }
+    if e.doblaje_nube().is_none() {
+        return Some("El servidor aún no ofrece el doblaje.");
+    }
+    None
+}
+
+// --- Dibujo ------------------------------------------------------------------------------------
+
+fn minutos(s: f64) -> String {
+    let s = if s.is_finite() { s.max(0.0).round() } else { 0.0 };
+    format!("{}:{:02}", (s / 60.0).floor(), s % 60.0)
+}
+
+fn combo(ui: &mut egui::Ui, id: &str, actual: &str, opciones: &[(String, String)], elegido: &mut String) {
+    let texto = opciones.iter().find(|(c, _)| c == actual).map_or(actual, |(_, n)| n.as_str());
+    craft_ui::ComboBox::from_id_salt(id).selected_text(texto).width(ui.available_width()).show_ui(ui, |ui| {
+        for (c, n) in opciones {
+            if ui.selectable_label(c == actual, n).clicked() {
+                elegido.clone_from(c);
+            }
+        }
+    });
+}
+
+pub fn cuerpo(ui: &mut egui::Ui, d: &mut Doblaje, datos: &Datos, t: &crate::theme::Tokens) {
+    let Some(n) = &datos.nube else {
+        ui.label(
+            RichText::new(if datos.sesion { "El servidor aún no ofrece el doblaje." } else { "Inicia sesión en Jacnex Studio para doblar." }).color(t.text_dim),
+        );
+        return;
+    };
+    let bloqueado = d.ocupado();
+    let (destino, origen, voz) = (d.destino_en(n).to_string(), d.origen_en(n).to_string(), d.voz_en(n).to_string());
+    ui.add_enabled_ui(!bloqueado, |ui| {
+        titulo(ui, "Doblar al idioma", t);
+        combo(ui, "doblaje-destino", &destino, &n.idiomas, &mut d.destino);
+        ui.add_space(6.0);
+        titulo(ui, "Idioma que se habla", t);
+        let mut origenes = vec![(AUTO.to_string(), "Automático".to_string())];
+        origenes.extend(n.idiomas.iter().cloned());
+        combo(ui, "doblaje-origen", &origen, &origenes, &mut d.origen);
+        ui.add_space(6.0);
+        titulo(ui, "Voz", t);
+        combo(ui, "doblaje-voz", &voz, &n.voces, &mut d.voz);
+    });
+    ui.add_space(6.0);
+    let resumen = if datos.frases == 0 {
+        if datos.sin_transcribir {
+            "Aún no hay voz transcrita: primero se transcribe (con el motor de «Editar»).".to_string()
+        } else {
+            "No hay voz para doblar en lo seleccionado.".to_string()
+        }
+    } else {
+        format!("{} frases · {} letras · {}", datos.frases, datos.letras, minutos(datos.segundos))
+    };
+    ui.label(RichText::new(resumen).small().color(t.text_dim));
+    ui.add_space(4.0);
+}
+
+/// Lo que se ve mientras trabaja.
+fn texto_etapa(e: Etapa) -> (String, Option<f32>) {
+    let cuenta = |h: usize, t: usize| if t == 0 { None } else { Some((h as f32 / t as f32).clamp(0.0, 1.0)) };
+    match e {
+        Etapa::Enviando => ("Enviando las frases…".into(), None),
+        Etapa::Traduciendo => ("Traduciendo…".into(), None),
+        Etapa::Voces { hechas, total } => (format!("Creando las voces… {hechas} de {total}"), cuenta(hechas as usize, total as usize)),
+        Etapa::Bajando { hechas, total } => (format!("Descargando las voces… {hechas} de {total}"), cuenta(hechas, total)),
+        Etapa::Armando => ("Armando el audio…".into(), None),
+        Etapa::Separando(p) => ("Separando la voz de la música…".into(), Some(f32::from(p) / 100.0)),
+    }
+}
+
+pub fn pie(ui: &mut egui::Ui, e: &mut Estado, datos: &Datos, t: &crate::theme::Tokens) {
+    let ancho = ui.available_width();
+    if let Some(tr) = &e.doblaje.trabajo {
+        let parando = tr.parar.load(Ordering::Relaxed);
+        let (texto, avance) = texto_etapa(tr.etapa);
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            let texto = if parando { "Deteniendo…".to_string() } else { format!("{texto}  {} s", tr.inicio.elapsed().as_secs()) };
+            ui.label(RichText::new(texto).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f).desired_height(6.0).fill(ACENTO));
+        }
+        ui.horizontal(|ui| {
+            ui.label(RichText::new("Se cobra solo lo que cuesta; si algo falla, se devuelve.").small().color(t.text_dim));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.small_button("Detener").clicked() {
+                    e.doblaje.pendiente = Some(Pedido::Detener);
+                }
+            });
+        });
+    } else if let Some((texto, avance)) = e.edicion.progreso() {
+        // transcribiendo antes de doblar
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{texto}  {} s", e.edicion.segundos())).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_height(6.0).fill(ACENTO));
+        }
+        if ui.small_button("Detener").clicked() {
+            e.edicion.detener();
+        }
+    } else if let Some(n) = datos.nube.as_ref().filter(|_| datos.frases > 0 && datos.falta.is_none()) {
+        let tope = n.reserva(datos.letras, datos.frases);
+        let excede = datos.frases > n.max_frases || datos.letras > n.max_letras || datos.segundos > n.max_segundos.min(dub::MAX_SEPARATE_SECONDS);
+        ui.label(RichText::new(format!("Cuesta como máximo {}; se cobra solo lo que cuesta de verdad.", creditos(tope))).small().strong().color(ACENTO_CLARO));
+        let mut alcanza = !excede;
+        if excede {
+            ui.label(
+                RichText::new(format!(
+                    "Es demasiado para un solo doblaje (hasta {} frases, {} letras, {}): selecciona un tramo.",
+                    n.max_frases,
+                    n.max_letras,
+                    minutos(n.max_segundos.min(dub::MAX_SEPARATE_SECONDS))
+                ))
+                .small()
+                .color(ROJO),
+            );
+        } else if let Some(s) = datos.saldo {
+            let (texto, color) = if s >= tope {
+                (format!("Te quedan {} después.", creditos(s - tope)), t.text_dim)
+            } else {
+                alcanza = false;
+                (format!("Te faltan {}.", creditos(tope - s)), ROJO)
+            };
+            ui.label(RichText::new(texto).small().color(color));
+        }
+        ui.add_space(2.0);
+        if boton_acento(ui, &format!("Doblar · hasta {}", creditos(tope)), egui::vec2(ancho, 36.0), alcanza).clicked() {
+            e.doblaje.pendiente = Some(Pedido::Doblar);
+        }
+    } else {
+        let transcribir = datos.frases == 0 && datos.sin_transcribir && datos.falta.is_none();
+        let texto = if transcribir { "Transcribir primero" } else { "Doblar" };
+        if boton_acento(ui, texto, egui::vec2(ancho, 36.0), transcribir).clicked() {
+            e.doblaje.pendiente = Some(Pedido::Transcribir);
+        }
+        let falta = datos.falta.or(if datos.frases == 0 && !transcribir { Some("No hay voz para doblar en lo seleccionado.") } else { None });
+        if let Some(f) = falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    let aviso = e.doblaje.aviso.as_ref().or(e.edicion.aviso.as_ref().filter(|_| !e.edicion.ocupado()));
+    if let Some((ok, m)) = aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
