+/// Jacnex: the model Jacnex Studio downloaded with Filmnex is used when Filmnex has none of its own.
+#[test]
+fn the_jacnex_studio_model_is_used_when_filmnex_has_none() {
+    use crate::transcript::pick_models_dir;
+    let raiz = std::env::temp_dir().join(format!("filmcraft-jacnex-models-{}", std::process::id()));
+    let (jacnex, propia) = (raiz.join("jacnex"), raiz.join("propia"));
+    let m = filmcraft_speech::models::find("whisper-tiny").unwrap();
+    let llenar = |dir: &std::path::Path| {
+        let d = filmcraft_speech::models::model_dir(dir, m);
+        std::fs::create_dir_all(&d).unwrap();
+        for f in m.files {
+            std::fs::File::create(d.join(f.name)).unwrap().set_len(f.size).unwrap();
+        }
+    };
+    // nothing anywhere: Filmnex's own folder (it downloads there)
+    assert_eq!(pick_models_dir(m.id, Some(jacnex.clone()), Some(propia.clone())), Some(propia.clone()));
+    llenar(&jacnex);
+    assert_eq!(pick_models_dir(m.id, Some(jacnex.clone()), Some(propia.clone())), Some(jacnex.clone()));
+    assert_eq!(pick_models_dir(m.id, Some(jacnex.clone()), None), Some(jacnex.clone()));
+    assert_eq!(pick_models_dir("no-such-model", Some(jacnex.clone()), Some(propia.clone())), Some(propia.clone()));
+    assert_eq!(pick_models_dir(m.id, None, Some(propia.clone())), Some(propia.clone()));
+    // a copy of its own wins
+    llenar(&propia);
+    assert_eq!(pick_models_dir(m.id, Some(jacnex), Some(propia.clone())), Some(propia));
+    let _ = std::fs::remove_dir_all(&raiz);
+}
diff --git a/crates/engine/tests/real_search.rs b/crates/engine/tests/real_search.rs
new file mode 100644
index 0000000..4776e5e
--- /dev/null
+++ b/crates/engine/tests/real_search.rs
@@ -0,0 +1,254 @@
+//! Timing and quality of "Buscar en el material" on a real clip with the real models.
+//!
+//! Needs the `whisper` feature, the models in `%LOCALAPPDATA%\Jacnex Studio\modelos` and these
+//! variables, so a plain `cargo test` skips it:
+//! - `SEARCH_CLIP`: the video file;
+//! - `SEARCH_OUT`: an empty folder for the cache, the transcript and the contact sheets;
+//! - `SEARCH_QUERIES`: a text file with one query per line.
+#![cfg(feature = "whisper")]
+
+use std::path::PathBuf;
+use std::time::Instant;
+
+use filmcraft_engine::Session;
+use filmcraft_engine::search::{self, IndexOptions, SearchProgress};
+use filmcraft_engine::speech_job;
+use serde_json::json;
+
+fn var(name: &str) -> Option<PathBuf> {
+    std::env::var_os(name).map(PathBuf::from)
+}
+
+#[test]
+fn real_clip_end_to_end() {
+    let (Some(clip), Some(out), Some(queries)) = (var("SEARCH_CLIP"), var("SEARCH_OUT"), var("SEARCH_QUERIES")) else {
+        eprintln!("skipped: SEARCH_CLIP, SEARCH_OUT and SEARCH_QUERIES are not set");
+        return;
+    };
+    std::fs::create_dir_all(&out).unwrap();
+    let models = filmcraft_engine::transcript::jacnex_models_dir().expect("the models folder");
+    let mut s = Session::default();
+    s.execute("file.import", json!({"paths": [clip.to_string_lossy()]})).unwrap();
+    let opts = |transcribe: bool, cache: bool, models_dir: bool| IndexOptions {
+        transcribe,
+        language: "es".into(),
+        whisper_model: "whisper-large-v3-turbo".into(),
+        cache: cache.then(|| out.join("cache")),
+        models_dir: models_dir.then(|| models.clone()),
+        ..Default::default()
+    };
+
+    // 1. transcription alone (video is not decoded here, only the audio)
+    let t0 = Instant::now();
+    let job = search::index_job(&s, opts(true, false, false)).unwrap();
+    let seconds = job.video_seconds();
+    eprintln!("clip: {seconds:.1} s of video, {:.1} s of audio to transcribe", job.speech_seconds());
+    let res = job.run(&mut |_| true).unwrap();
+    eprintln!("TIME whisper (read + transcribe): {:.1} s", t0.elapsed().as_secs_f64());
+    for n in &res.notes {
+        eprintln!("note: {n}");
+    }
+    if let Some(r) = res.transcripts {
+        for (_, t) in &r.done {
+            let text: Vec<String> = t.words.iter().map(|w| format!("{:.1}:{}", w.start.seconds(), w.text)).collect();
+            std::fs::write(out.join("transcript.txt"), text.join(" ")).unwrap();
+            eprintln!("transcript: {} words", t.words.len());
+        }
+        speech_job::apply_transcripts(&mut s, r).unwrap();
+    }
+
+    // 2. pictures + meaning, with the real video decode and no cache
+    let t0 = Instant::now();
+    let (mut loaded, mut last) = (None, 0.0f64);
+    let job = search::index_job(&s, opts(false, true, true)).unwrap();
+    let res = job
+        .run(&mut |p| {
+            if let SearchProgress::Loading = p {
+                loaded = Some(Instant::now());
+            }
+            if let SearchProgress::Pictures { fraction, .. } = p {
+                last = f64::from(fraction);
+            }
+            true
+        })
+        .unwrap();
+    let total = t0.elapsed().as_secs_f64();
+    let load = loaded.map_or(0.0, |l| l.duration_since(t0).as_secs_f64());
+    eprintln!("TIME index (models load {load:.1} s, rest {:.1} s, total {total:.1} s; last picture progress {last:.2})", total - load);
+    for n in &res.notes {
+        eprintln!("note: {n}");
+    }
+
+    // 3. the same again: everything comes from the cache
+    let t0 = Instant::now();
+    let again = search::index_job(&s, opts(false, true, true)).unwrap().run(&mut |_| true).unwrap();
+    eprintln!("TIME index again from the cache: {:.1} s", t0.elapsed().as_secs_f64());
+    drop(again);
+
+    // 4. the queries
+    let text = std::fs::read_to_string(queries).unwrap();
+    for q in text.lines().map(str::trim).filter(|l| !l.is_empty()).take(40) {
+        let t0 = Instant::now();
+        let hits = res.searcher.query(q, &res.media);
+        eprintln!("QUERY {q:?} ({:.0} ms, {} hits)", t0.elapsed().as_secs_f64() * 1000.0, hits.len());
+        for h in hits.iter().take(5) {
+            eprintln!(
+                "   {:5.1}-{:5.1} score {:.2} {}{}{} {:?}",
+                h.start,
+                h.end,
+                h.score,
+                if h.words { "W" } else { "-" },
+                if h.meaning { "M" } else { "-" },
+                if h.image { "I" } else { "-" },
+                h.quote.chars().take(70).collect::<String>()
+            );
+        }
+    }
+
+    // 5. contact sheets to look at the footage
+    let sources = search::index_job(&s, opts(false, false, false)).unwrap().sources();
+    for (_, src, video) in &sources {
+        if !*video {
+            continue;
+        }
+        let sheets = filmcraft_engine::search_sheets::contact_sheets(src, seconds, 10, &mut || true).unwrap();
+        for (k, sh) in sheets.iter().enumerate() {
+            std::fs::write(out.join(format!("sheet{k}.jpg")), &sh.jpeg).unwrap();
+            eprintln!("sheet{k}: {:.0}-{:.0} s", sh.from, sh.to);
+        }
+    }
+}
+
+/// How long the decoder takes per second of video when asked second by second (the way the index does it).
+#[test]
+fn real_clip_decode_speed() {
+    let Some(clip) = var("SEARCH_CLIP") else { return };
+    let mut s = Session::default();
+    s.execute("file.import", json!({"paths": [clip.to_string_lossy()]})).unwrap();
+    let opts = IndexOptions { language: "es".into(), ..Default::default() };
+    let sources = search::index_job(&s, opts).unwrap().sources();
+    let (_, src, _) = sources.first().unwrap();
+    let info = src.info();
+    eprintln!("DECODE clip: {:?} {:.1} s", info.video.as_ref().map(|v| (v.width, v.height, v.frame_rate)), info.duration.seconds());
+    let step = |from: f64, k: u32, scale: f32, draft: bool, late: bool, rgba: bool| {
+        let t0 = Instant::now();
+        for k in 0..k {
+            let t = filmcraft_time::Tick::from_seconds_f64(from + f64::from(k));
+            let late = late.then_some(filmcraft_time::Tick::ZERO);
+            let f = filmcraft_media::cancel::with_catch_up(late, || {
+                filmcraft_media::cancel::with_draft(draft, || src.video_frame(filmcraft_media::FrameRequest { time: t, scale }).unwrap())
+            });
+            if rgba {
+                std::hint::black_box(f.to_rgba8());
+            }
+        }
+        t0.elapsed().as_secs_f64() * 1000.0 / f64::from(k)
+    };
+    let mut from = 20.0;
+    for (name, scale, draft, late, rgba) in [
+        ("scale 0.27 + rgba (now)", 0.27, false, false, true),
+        ("scale 0.27 no rgba", 0.27, false, false, false),
+        ("scale 1.0 no rgba", 1.0, false, false, false),
+        ("draft + rgba", 0.27, true, false, true),
+        ("late(catch-up) + rgba", 0.27, false, true, true),
+        ("draft + late + rgba", 0.27, true, true, true),
+    ] {
+        eprintln!("DECODE {name}: {:.0} ms per 1 s step", step(from, 15, scale, draft, late, rgba));
+        from += 20.0;
+    }
+}
+
+/// Only the questions, on the cache of an earlier run and the words of its `transcript.txt`
+/// (`seconds:word` pairs): for tuning the ranking without transcribing again.
+#[test]
+fn real_clip_queries_only() {
+    let (Some(clip), Some(out), Some(queries)) = (var("SEARCH_CLIP"), var("SEARCH_OUT"), var("SEARCH_QUERIES")) else { return };
+    let Ok(raw) = std::fs::read_to_string(out.join("transcript.txt")) else { return };
+    let models = filmcraft_engine::transcript::jacnex_models_dir().unwrap();
+    let mut s = Session::default();
+    s.execute("file.import", json!({"paths": [clip.to_string_lossy()]})).unwrap();
+    let mut t = filmcraft_project::Transcript { language: "es".into(), ..Default::default() };
+    let pairs: Vec<(f64, String)> = raw.split(' ').filter_map(|p| p.split_once(':')).filter_map(|(a, b)| Some((a.parse().ok()?, b.to_string()))).collect();
+    for (k, (a, w)) in pairs.iter().enumerate() {
+        let end = pairs.get(k + 1).map_or(a + 0.4, |n| n.0.min(a + 0.6));
+        t.words.push(filmcraft_project::Word::new(w.clone(), filmcraft_time::Tick::from_seconds_f64(*a), filmcraft_time::Tick::from_seconds_f64(end)));
+    }
+    t.normalize();
+    let item = search::media_items(&s)[0];
+    speech_job::apply_transcripts(&mut s, speech_job::SpeechResult { done: vec![(item, t)], skipped: vec![] }).unwrap();
+    let o = IndexOptions { language: "es".into(), cache: Some(out.join("cache")), models_dir: Some(models), ..Default::default() };
+    let res = search::index_job(&s, o).unwrap().run(&mut |_| true).unwrap();
+    for q in std::fs::read_to_string(queries).unwrap().lines().map(str::trim).filter(|l| !l.is_empty()).take(60) {
+        let t0 = Instant::now();
+        let hits = res.searcher.query(q, &res.media);
+        eprintln!("QUERY {q:?} ({:.0} ms, {} hits)", t0.elapsed().as_secs_f64() * 1000.0, hits.len());
+        if let (Some(p), Some(v)) = (res.searcher.models().picture, res.media.first().and_then(|m| m.visual.clone())) {
+            let qi = p.text(q).unwrap();
+            let (sc, bi) = p.logit();
+            let mut all: Vec<(f32, f32)> = (0..v.times.len()).filter_map(|i| Some((v.times[i], filmcraft_search::index::dot(&qi, v.vector(i)?)))).collect();
+            all.sort_by(|a, b| b.1.total_cmp(&a.1));
+            let raw: Vec<String> =
+                all.iter().take(6).map(|(t, c)| format!("{t:.0}s cos {c:.3} p {:.2}", filmcraft_search::rank::image_score(*c, sc, bi))).collect();
+            eprintln!("   RAW {}", raw.join(" | "));
+        }
+        for h in hits.iter().take(3) {
+            let k = format!("{}{}{}", if h.words { "W" } else { "-" }, if h.meaning { "M" } else { "-" }, if h.image { "I" } else { "-" });
+            eprintln!("   {:5.1}-{:5.1} score {:.2} {k} {:?}", h.start, h.end, h.score, h.quote.chars().take(60).collect::<String>());
+        }
+    }
+}
+
+/// Only the pictures + meaning pass, no cache: the time the index takes. `SEARCH_WORKERS` sets the decoding threads (0: automatic).
+#[test]
+fn real_clip_index_only() {
+    let Some(clip) = var("SEARCH_CLIP") else { return };
+    let models = filmcraft_engine::transcript::jacnex_models_dir().unwrap();
+    if let Some(w) = std::env::var("SEARCH_WORKERS").ok().and_then(|w| w.parse().ok()) {
+        search::set_decode_workers(w);
+    }
+    let mut s = Session::default();
+    s.execute("file.import", json!({"paths": [clip.to_string_lossy()]})).unwrap();
+    let o = IndexOptions { language: "es".into(), models_dir: Some(models), ..Default::default() };
+    let job = search::index_job(&s, o).unwrap();
+    let seconds = job.video_seconds();
+    let (t0, mut loaded) = (Instant::now(), None);
+    let res = job
+        .run(&mut |p| {
+            if let SearchProgress::Loading = p {
+                loaded = Some(Instant::now());
+            }
+            true
+        })
+        .unwrap();
+    let total = t0.elapsed().as_secs_f64();
+    let load = loaded.map_or(0.0, |l| l.duration_since(t0).as_secs_f64());
+    for n in &res.notes {
+        eprintln!("note: {n}");
+    }
+    let n = res.media.first().and_then(|m| m.visual.as_ref()).map_or(0, |v| v.times.len());
+    eprintln!(
+        "INDEX {seconds:.0} s of video: models {load:.1} s + pictures {:.1} s = {total:.1} s ({:.2}x realtime, {:.0} s per minute), {n} vectors",
+        total - load,
+        (total - load) / seconds,
+        (total - load) / seconds * 60.0
+    );
+}
+
+/// How long the picture model takes per picture on an idle computer (no decoding at the same time).
+#[test]
+fn real_picture_model_speed() {
+    if var("SEARCH_CLIP").is_none() {
+        return;
+    }
+    let models = filmcraft_engine::transcript::jacnex_models_dir().unwrap();
+    let m = search::load_models(&models, &mut Vec::new());
+    let p = m.picture.unwrap();
+    let rgba: Vec<u8> = (0..512 * 288 * 4).map(|i| (i * 7 % 251) as u8).collect();
+    for b in [1usize, 4, 8] {
+        let pics: Vec<search::Pic> = (0..b).map(|_| search::Pic { rgba: &rgba, width: 512, height: 288 }).collect();
+        let _ = p.pictures(&pics).unwrap();
+        let t0 = Instant::now();
+        let _ = p.pictures(&pics).unwrap();
+        eprintln!("PICMODEL batch {b}: {:.0} ms per picture", t0.elapsed().as_secs_f64() * 1000.0 / b as f64);
+    }
+}
