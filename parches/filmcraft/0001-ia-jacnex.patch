+pub(crate) const ACENTO: Color32 = Color32::from_rgb(124, 92, 255);
+pub(crate) const ACENTO_CLARO: Color32 = Color32::from_rgb(205, 191, 255);
+pub(crate) const ROJO: Color32 = Color32::from_rgb(230, 120, 90);
+pub(crate) const VERDE: Color32 = Color32::from_rgb(110, 200, 140);
+const ANCHO: f32 = 600.0;
+/// Jacnex: el ancho de la barra lateral (grupos y herramientas).
+const LADO: f32 = 164.0;
+/// El ancho de las etiquetas de Ajustes.
+const ETIQUETA: f32 = 86.0;
+
+/// `1236` → `1 236`.
+pub(crate) fn miles(n: i64) -> String {
+    let s = n.unsigned_abs().to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i).is_multiple_of(3) {
+            out.push(' ');
+        }
+        out.push(c);
+    }
+    if n < 0 { format!("-{out}") } else { out }
+}
+
+pub(crate) fn creditos(c: i64) -> String {
+    if c == 1 { "1 crédito".into() } else { format!("{} créditos", miles(c)) }
+}
