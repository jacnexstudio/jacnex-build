+/// Lo que la ventana pide hacer al cerrarse el cuadro.
+#[derive(Default)]
+struct Pedidos {
+    cerrar: bool,
+    generar: bool,
+    elegir_foto: bool,
+    /// Usar una herramienta de «Editar» (con la descarga del modelo ya aceptada o no).
+    editar: Option<(crate::jacnex_edicion::Despues, bool)>,
+    /// Jacnex: pasar a vertical en esta computadora.
+    vertical: bool,
+}
+
+/// Lo que la ventana muestra de la secuencia (se calcula antes de dibujarla).
+struct Contexto {
+    falta: Option<&'static str>,
+    tamano: Option<(u32, u32)>,
+    corte: Option<Corte>,
+    hay_secuencia: bool,
+    /// El clip que se mejora (solo en «Mejorar calidad»), o por qué no hay.
+    mejora: Option<Result<ClipMejora, &'static str>>,
+    /// Lo que cobraría Nemotron por transcribir lo que falta (solo en «Editar», con Nemotron).
+    costo_nube: Option<i64>,
+    // Jacnex: lo que «Buscar» muestra del proyecto y de la cuenta
+    buscar: Option<crate::jacnex_buscar::Datos>,
+    corta: Option<crate::jacnex_corta::Datos>,
+    // Jacnex: lo que «Doblaje» muestra del proyecto y de la cuenta
+    doblaje: Option<crate::jacnex_doblaje::Datos>,
+}
+
+/// La ventana «IA de Jacnex» (y lo que la IA tenga en curso, aunque esté cerrada).
+pub fn ventana(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    actualizar(app, ctx);
+    if !app.jacnex_ia.abierta {
+        return;
+    }
+    let mut pide = Pedidos::default();
+    let mejora = (app.jacnex_ia.modo == Modo::Mejorar || (app.jacnex_ia.modo == Modo::Vertical && app.jacnex_ia.vertical.en_nube()))
+        .then(|| clip_a_mejorar(app, app.jacnex_ia.herramienta_actual().as_ref()));
+    let costo_nube = app.jacnex_ia.modo.local().and_then(|_| crate::jacnex_edicion::costo_nube(app));
+    let buscar = (app.jacnex_ia.modo == Modo::Buscar).then(|| crate::jacnex_buscar::datos(app));
+    let corta = (app.jacnex_ia.modo == Modo::Corta).then(|| crate::jacnex_corta::datos(app));
+    let doblaje = (app.jacnex_ia.modo == Modo::Doblaje).then(|| crate::jacnex_doblaje::datos(app));
+    let cx = Contexto {
+        falta: falta(app),
+        tamano: tamano_secuencia(app),
+        corte: corte_cercano(app),
+        hay_secuencia: secuencia(app).is_some(),
+        mejora,
+        costo_nube,
+        buscar,
+        corta,
+        doblaje,
+    };
+    let t = app.tokens;
+    let pantalla = ctx.content_rect();
+    egui::Window::new("IA de Jacnex")
+        .id(egui::Id::unique("jacnex-ia-ventana"))
+        .title_bar(false)
+        .resizable(false)
+        .default_width(ANCHO)
+        .default_pos(egui::pos2(pantalla.max.x - ANCHO - 40.0, pantalla.min.y + 56.0))
+        .show(ctx, |ui| {
+            ui.set_width(ANCHO);
+            let e = &mut app.jacnex_ia;
+            let sesion = e.con_sesion || e.local.is_some();
+            ui.horizontal(|ui| {
+                let (r, _) = ui.allocate_exact_size(egui::vec2(16.0, 16.0), egui::Sense::hover());
+                crate::icons::paint(ui.painter(), r, crate::icons::Icon::Sparkle, ACENTO_CLARO);
+                ui.label(RichText::new("IA de Jacnex").strong().size(14.0).color(t.text));
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    if boton_icono(ui, crate::icons::Icon::Close, "Cerrar", &t).clicked() {
+                        pide.cerrar = true;
+                    }
+                    if sesion && boton_icono(ui, crate::icons::Icon::Reset, "Actualizar saldo", &t).clicked() {
+                        pedir_info(e);
+                    }
+                    if let Some(i) = &e.info {
+                        let r = pastilla(ui, &creditos(i.creditos));
+                        if !i.nombre.is_empty() {
+                            r.on_hover_text(format!("Cuenta: {}", i.nombre));
+                        }
+                    }
+                });
+            });
+            if !sesion && !e.es_local() {
+                ui.label(RichText::new("Inicia sesión en Jacnex Studio para usar la IA.").small().color(t.text_dim));
+            }
+            if let Some(err) = &e.info_error {
+                ui.label(RichText::new(err.as_str()).small().color(ROJO));
+            }
+            ui.add_space(4.0);
+            ui.separator();
+            // Jacnex: barra lateral con los grupos y sus herramientas; a la derecha, la elegida
+            ui.horizontal_top(|ui| {
+                egui::Frame::NONE.fill(Color32::from_black_alpha(40)).corner_radius(8.0).inner_margin(6).show(ui, |ui| {
+                    ui.set_width(LADO - 12.0);
+                    ui.vertical(|ui| lado(ui, e, &t));
+                });
+                ui.add_space(4.0);
+                ui.vertical(|ui| {
+                    ui.add_space(2.0);
+                    cabecera(ui, e.modo, &t);
+                    ui.add_space(6.0);
+                    egui::ScrollArea::vertical()
+                        .max_height(pantalla.height() * 0.6)
+                        .auto_shrink([false, true])
+                        .show(ui, |ui| cuerpo(ui, e, &cx, &t, &mut pide));
+                    ui.separator();
+                    ui.add_space(4.0);
+                    pie(ui, e, &cx, &t, &mut pide);
+                });
+            });
+        });
+    if pide.cerrar {
+        app.jacnex_ia.abierta = false;
+    }
+    if pide.elegir_foto {
+        elegir_foto(app);
+    }
+    if let Some((d, aceptada)) = pide.editar {
+        crate::jacnex_edicion::ejecutar(app, d, aceptada);
+    }
+    if pide.vertical {
+        crate::jacnex_vertical::ejecutar(app);
+    }
+    // Jacnex: lo que se pidió en «Buscar» (buscar, ver un resultado, agregarlo…)
+    crate::jacnex_buscar::atender(app);
+    crate::jacnex_corta::atender(app);
+    crate::jacnex_doblaje::atender(app);
+    if pide.generar {
+        generar(app);
+    }
+}
+
+/// Jacnex: la herramienta usa créditos (con el motor elegido).
+fn usa_creditos(e: &Estado, m: Modo) -> bool {
+    match m {
+        Modo::Subtitulos | Modo::Silencios | Modo::Muletillas | Modo::PorTexto => e.edicion.en_nube(),
+        Modo::Vertical => e.vertical.en_nube(),
+        Modo::Buscar => e.buscar.con_ia,
+        _ => true,
+    }
+}
+
+/// Jacnex: lo que se ve a la derecha de una fila de la barra lateral.
+enum Marca<'a> {
+    Nada,
+    /// Cuántas herramientas tiene el grupo (cerrado).
+    Cuenta(&'a str),
+    /// La herramienta usa créditos.
+    Creditos,
+}
+
+/// Jacnex: una fila de la barra lateral (grupo o herramienta). `sangria` > 0 = herramienta.
+fn fila_lado(ui: &mut egui::Ui, icono: crate::icons::Icon, nombre: &str, marca: Marca, on: bool, sangria: f32, t: &crate::theme::Tokens) -> egui::Response {
+    let alto = if sangria > 0.0 { 26.0 } else { 28.0 };
+    let (fila, resp) = ui.allocate_exact_size(egui::vec2(ui.available_width(), alto), egui::Sense::click());
+    let rect = egui::Rect::from_min_max(fila.min + egui::vec2(sangria, 0.0), fila.max);
+    let p = ui.painter();
+    if on {
+        p.rect_filled(rect, 6.0, ACENTO.gamma_multiply(0.55));
+        if sangria > 0.0 {
+            let barra = egui::Rect::from_min_size(rect.min + egui::vec2(0.0, 5.0), egui::vec2(2.0, rect.height() - 10.0));
+            p.rect_filled(barra, 1.0, ACENTO_CLARO);
+        }
+    } else if resp.hovered() {
+        p.rect_filled(rect, 6.0, t.hover);
+    }
+    let lado_icono = if sangria > 0.0 { 14.0 } else { 16.0 };
+    let r_icono = egui::Rect::from_center_size(egui::pos2(rect.left() + 8.0 + lado_icono / 2.0, rect.center().y), egui::vec2(lado_icono, lado_icono));
+    let color_icono = if on {
+        Color32::WHITE
+    } else if sangria > 0.0 {
+        t.text_dim
+    } else {
+        ACENTO_CLARO.gamma_multiply(0.8)
+    };
+    crate::icons::paint(p, r_icono, icono, color_icono);
+    let fuente = if sangria > 0.0 { crate::theme::Tokens::ui(12.5) } else { crate::theme::Tokens::semibold(13.0) };
+    let color = if on { Color32::WHITE } else { t.text };
+    p.text(egui::pos2(r_icono.right() + 8.0, rect.center().y), egui::Align2::LEFT_CENTER, nombre, fuente, color);
+    let creditos = matches!(marca, Marca::Creditos);
+    match marca {
+        Marca::Cuenta(d) => {
+            p.text(egui::pos2(rect.right() - 8.0, rect.center().y), egui::Align2::RIGHT_CENTER, d, crate::theme::Tokens::ui(11.0), t.text_dim);
+        }
+        Marca::Creditos => {
+            p.circle_filled(egui::pos2(rect.right() - 10.0, rect.center().y), 3.0, if on { ACENTO_CLARO } else { ACENTO });
+        }
+        Marca::Nada => {}
+    }
+    resp.widget_info(|| egui::WidgetInfo::selected(egui::Role::Button, true, on, nombre));
+    if creditos { resp.on_hover_text("Usa créditos") } else { resp }
+}
+
+/// Jacnex: la barra lateral: los grupos y, en el abierto, sus herramientas.
+fn lado(ui: &mut egui::Ui, e: &mut Estado, t: &crate::theme::Tokens) {
+    ui.spacing_mut().item_spacing.y = 2.0;
+    let abierto = e.modo.grupo();
+    for g in Grupo::TODOS {
+        let modos = g.modos();
+        let unico = modos.len() == 1;
+        let es = g == abierto;
+        let cuenta = modos.len().to_string();
+        let marca = if !unico && !es {
+            Marca::Cuenta(cuenta.as_str())
+        } else if unico && modos.first().is_some_and(|m| usa_creditos(e, *m)) {
+            Marca::Creditos
+        } else {
+            Marca::Nada
+        };
+        if fila_lado(ui, g.icono(), g.nombre(), marca, es && unico, 0.0, t).clicked()
+            && !es
+            && let Some(m) = modos.first()
+        {
+            e.modo = *m;
+        }
+        if es && !unico {
+            for m in modos {
+                let marca = if usa_creditos(e, *m) { Marca::Creditos } else { Marca::Nada };
+                if fila_lado(ui, m.icono(), m.nombre(), marca, *m == e.modo, 12.0, t).clicked() {
+                    e.modo = *m;
+                }
+            }
+            ui.add_space(4.0);
+        }
+    }
+}
+
+/// Jacnex: la cabecera de la herramienta elegida: ícono, nombre y una línea.
+fn cabecera(ui: &mut egui::Ui, m: Modo, t: &crate::theme::Tokens) {
+    ui.horizontal(|ui| {
+        let (r, _) = ui.allocate_exact_size(egui::vec2(34.0, 34.0), egui::Sense::hover());
+        let p = ui.painter();
+        p.rect_filled(r, 8.0, ACENTO.gamma_multiply(0.22));
+        p.rect_stroke(r, 8.0, egui::Stroke::new(1.0, ACENTO.gamma_multiply(0.45)), egui::StrokeKind::Inside);
+        crate::icons::paint(p, r.shrink(9.0), m.icono(), ACENTO_CLARO);
+        ui.add_space(4.0);
+        ui.vertical(|ui| {
+            ui.spacing_mut().item_spacing.y = 1.0;
+            ui.label(RichText::new(m.nombre()).font(crate::theme::Tokens::semibold(15.0)).color(t.text));
+            ui.label(RichText::new(m.explicacion()).small().color(t.text_dim));
+        });
+    });
+}
+
+/// Jacnex: `#RRGGBB` → color (o `otro` si no se entiende).
+fn color_hex(hex: &str, otro: Color32) -> Color32 {
+    let canal = |i: usize| hex.get(i..i + 2).and_then(|c| u8::from_str_radix(c, 16).ok());
+    match (hex.starts_with('#'), canal(1), canal(3), canal(5)) {
+        (true, Some(r), Some(g), Some(b)) if hex.len() == 7 => Color32::from_rgb(r, g, b),
+        _ => otro,
+    }
+}
+
+/// Jacnex: una vista previa de los subtítulos con el estilo, la posición y el color elegidos.
+fn previa_subtitulos(ui: &mut egui::Ui, ed: &crate::jacnex_edicion::Edicion, t: &crate::theme::Tokens) {
+    use egui::text::{LayoutJob, TextFormat};
+    let ancho = ui.available_width().max(60.0);
+    let alto = (ancho * 9.0 / 16.0).min(200.0);
+    let (rect, _) = ui.allocate_exact_size(egui::vec2(ancho, alto), egui::Sense::hover());
+    let p = ui.painter().with_clip_rect(rect);
+    let mut fondo = egui::Mesh::default();
+    let (arriba, abajo) = (Color32::from_rgb(52, 66, 86), Color32::from_rgb(15, 18, 23));
+    fondo.colored_vertex(rect.left_top(), arriba);
+    fondo.colored_vertex(rect.right_top(), arriba);
+    fondo.colored_vertex(rect.right_bottom(), abajo);
+    fondo.colored_vertex(rect.left_bottom(), abajo);
+    fondo.add_triangle(0, 1, 2);
+    fondo.add_triangle(0, 2, 3);
+    p.add(fondo);
+    // Una silueta: cabeza y hombros.
+    let cx = rect.center().x;
+    p.circle_filled(egui::pos2(cx, rect.top() + alto * 0.36), alto * 0.13, Color32::from_rgb(104, 122, 145));
+    p.circle_filled(egui::pos2(cx, rect.bottom() + alto * 0.22), alto * 0.42, Color32::from_rgb(72, 86, 104));
+    let resalte = color_hex(ed.color_actual(), Color32::from_rgb(255, 214, 0));
+    let tam = (alto * 0.09).clamp(11.0, 18.0);
+    let fuerte = |c: Color32, s: f32| TextFormat::simple(crate::theme::Tokens::semibold(s), c);
+    let mut job = LayoutJob::default();
+    let estilo = ed.estilo_actual();
+    match estilo {
+        "word" => job.append("TODOS", 0.0, fuerte(resalte, tam * 1.5)),
+        "classic" => job.append("Hola a todos, bienvenidos", 0.0, TextFormat::simple(crate::theme::Tokens::ui(tam * 0.95), Color32::WHITE)),
+        _ => {
+            job.append("HOLA A ", 0.0, fuerte(Color32::WHITE, tam));
+            job.append("TODOS", 0.0, fuerte(resalte, tam));
+            job.append(" BIENVENIDOS", 0.0, fuerte(Color32::WHITE, tam));
+        }
+    }
+    let galley = p.layout_job(job);
+    let gs = galley.size();
+    let y = match ed.posicion_actual() {
+        "top" => rect.top() + alto * 0.12,
+        "middle" => rect.center().y - gs.y / 2.0,
+        _ => rect.bottom() - alto * 0.12 - gs.y,
+    };
+    let pos = egui::pos2(cx - gs.x / 2.0, y);
+    if estilo == "classic" {
+        p.rect_filled(egui::Rect::from_min_size(pos, gs).expand2(egui::vec2(8.0, 3.0)), 3.0, Color32::from_black_alpha(170));
+    } else {
+        p.galley_with_override_text_color(pos + egui::vec2(0.0, 2.0), galley.clone(), Color32::from_black_alpha(220));
+    }
+    p.galley(pos, galley, Color32::WHITE);
+    let etiqueta = p.layout_no_wrap("Vista previa".to_string(), crate::theme::Tokens::ui(10.0), Color32::WHITE);
+    let caja = egui::Rect::from_min_size(rect.min + egui::vec2(6.0, 6.0), etiqueta.size() + egui::vec2(10.0, 2.0));
+    p.rect_filled(caja, 4.0, Color32::from_black_alpha(115));
+    p.galley(caja.min + egui::vec2(5.0, 1.0), etiqueta, Color32::WHITE);
+    ui.painter().rect_stroke(rect, 0.0, egui::Stroke::new(1.0, t.field_border), egui::StrokeKind::Inside);
+}
+
+fn cuerpo(ui: &mut egui::Ui, e: &mut Estado, cx: &Contexto, t: &crate::theme::Tokens, pide: &mut Pedidos) {
+    if e.modo == Modo::Subtitulos {
+        previa_subtitulos(ui, &e.edicion, t);
+        ui.add_space(8.0);
+    }
+    match e.modo {
+        Modo::Foto => {
+            titulo(ui, "Foto", t);
+            ui.horizontal(|ui| {
+                let texto = match &e.foto {
+                    Some(r) => Path::new(r).file_name().map_or_else(|| r.clone(), |n| n.to_string_lossy().into_owned()),
+                    None if cx.hay_secuencia => "El cuadro bajo el cabezal".to_string(),
+                    None => "Ninguna: elige una imagen".to_string(),
+                };
+                ui.label(RichText::new(texto).color(t.text));
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    if e.foto.is_some() && ui.small_button("Usar el cabezal").clicked() {
+                        e.foto = None;
+                    }
+                    if ui.small_button("Elegir imagen…").clicked() {
+                        pide.elegir_foto = true;
+                    }
+                });
+            });
+            ui.add_space(6.0);
+        }
+        Modo::Transicion => {
+            titulo(ui, "Corte", t);
+            let texto = match &cx.corte {
+                Some(c) => format!("El corte en {:.1} s (el más cercano al cabezal).", c.en.seconds()),
+                None => "No hay dos clips seguidos en la secuencia.".to_string(),
+            };
+            ui.label(RichText::new(texto).color(if cx.corte.is_some() { t.text } else { ROJO }));
+            ui.add_space(6.0);
+        }
+        Modo::Mejorar | Modo::Vertical if cx.mejora.is_some() => {
+            titulo(ui, "Clip", t);
+            match &cx.mejora {
+                Some(Ok(c)) => {
+                    ui.label(RichText::new(format!("{} · {:.1} s", c.nombre, c.segundos)).color(t.text));
+                }
+                Some(Err(m)) => {
+                    ui.label(RichText::new(*m).color(ROJO));
+                }
+                None => {}
+            }
+            ui.add_space(6.0);
+        }
+        _ => {}
+    }
+    if e.modo == Modo::Buscar {
+        // Jacnex: «Buscar» dibuja su propio cuerpo
+        if let Some(d) = &cx.buscar {
+            crate::jacnex_buscar::cuerpo(ui, &mut e.buscar, d, t);
+        }
+        return;
+    }
+    if e.modo == Modo::Doblaje {
+        // Jacnex: «Doblaje» dibuja su propio cuerpo
+        if let Some(d) = &cx.doblaje {
+            crate::jacnex_doblaje::cuerpo(ui, &mut e.doblaje, d, t);
+        }
+        return;
+    }
+    let modo = e.modo;
+    let max_texto = e.herramienta_actual().map_or(0, |h| h.max_texto);
+    let letras = e.letras();
+    if let Some(texto) = e.texto_mut() {
+        titulo(ui, modo.titulo_texto(), t);
+        let filas = if modo == Modo::Voz { 5 } else { 3 };
+        ui.add(egui::TextEdit::multiline(texto).hint_text(modo.pista()).desired_rows(filas).desired_width(f32::INFINITY));
+        if modo == Modo::Voz {
+            let largo = max_texto > 0 && letras > max_texto;
+            let cuenta =
+                if max_texto > 0 { format!("{} / {} letras", miles_usize(letras), miles_usize(max_texto)) } else { format!("{} letras", miles_usize(letras)) };
+            ui.label(RichText::new(cuenta).small().color(if largo { ROJO } else { t.text_dim }));
+        }
+        ui.horizontal_wrapped(|ui| {
+            ui.spacing_mut().item_spacing = egui::vec2(4.0, 4.0);
+            for idea in modo.ideas() {
+                if ui.small_button(format!("+ {idea}")).clicked() {
+                    *texto = (*idea).to_string();
+                }
+            }
+        });
+        ui.add_space(8.0);
+    }
+    if let Some(d) = e.modo.local() {
+        ajustes_edicion(ui, &mut e.edicion, d, t);
+    } else if e.modo == Modo::Corta {
+        let ocupado = e.corta.ocupado();
+        crate::jacnex_corta::ajustes(ui, &mut e.corta, ocupado, t);
+        ajustes_edicion(ui, &mut e.edicion, crate::jacnex_edicion::Despues::Corta, t);
+    } else if e.modo == Modo::Vertical {
+        ajustes_vertical(ui, e, t);
+    } else if e.modo.es_video() {
+        ajustes_video(ui, e, cx, t);
+    } else {
+        ajustes_herramienta(ui, e, t);
+    }
+    ui.add_space(4.0);
+}
+
+fn miles_usize(n: usize) -> String {
+    miles(i64::try_from(n).unwrap_or(i64::MAX))
+}
+
+fn ajustes_video(ui: &mut egui::Ui, e: &mut Estado, cx: &Contexto, t: &crate::theme::Tokens) {
+    let modelos = e.modelos();
+    let actual = e.modelo_actual();
+    let (dur, son) = (e.duracion_actual(&actual), e.sonido_actual(&actual));
+    fila(ui, "Modelo", t, |ui| {
+        craft_ui::ComboBox::from_id_salt("jacnex-ia-modelo").selected_text(actual.nombre.as_str()).width(ui.available_width()).show_ui(ui, |ui| {
+            for m in &modelos {
+                let d = if m.duraciones.contains(&dur) { dur } else { m.duraciones.first().copied().unwrap_or(5) };
+                let costo = m.costo(d, m.sonido_opcional && e.sonido).map(|c| format!(" · {}", creditos(c))).unwrap_or_default();
+                if ui.selectable_label(m.id == actual.id, format!("{}{costo}", m.nombre)).on_hover_text(m.descripcion.as_str()).clicked() {
+                    e.modelo = m.id.clone();
+                }
+            }
+        });
+    });
+    if !actual.descripcion.is_empty() {
+        ui.label(RichText::new(actual.descripcion.as_str()).small().color(t.text_dim));
+    }
+    if actual.duraciones.len() > 1 {
+        fila(ui, "Duración", t, |ui| {
+            let nombres: Vec<String> = actual.duraciones.iter().map(|d| format!("{d} s")).collect();
+            let elegida = actual.duraciones.iter().position(|d| *d == dur).unwrap_or(0);
+            if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                && let Some(d) = actual.duraciones.get(i)
+            {
+                e.duracion = *d;
+            }
+        });
+    } else {
+        fila(ui, "Duración", t, |ui| ui.label(RichText::new(format!("{dur} s")).color(t.text)));
+    }
+    if e.modo == Modo::Texto {
+        let aspecto = aspecto_para(&actual, &e.aspecto, cx.tamano);
+        fila(ui, "Proporción", t, |ui| {
+            let elegida = actual.aspectos.iter().position(|a| *a == aspecto).unwrap_or(0);
+            if let Some(i) = segmentos(ui, &actual.aspectos, elegida, t)
+                && let Some(a) = actual.aspectos.get(i)
+            {
+                e.aspecto = a.clone();
+            }
+        });
+    }
+    if actual.sonido_opcional {
+        fila(ui, "Sonido", t, |ui| {
+            let nombres = ["Sin sonido".to_string(), "Con sonido".to_string()];
+            if let Some(i) = segmentos(ui, &nombres, usize::from(son), t) {
+                e.sonido = i == 1;
+            }
+        });
+    } else {
+        fila(ui, "Sonido", t, |ui| ui.label(RichText::new("Incluido").color(t.text)));
+    }
+}
