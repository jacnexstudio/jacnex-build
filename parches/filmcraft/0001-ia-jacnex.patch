+/// Pide lo elegido al servidor (en un hilo); al llegar se coloca en la línea de tiempo
+/// ([`actualizar`]).
+pub fn generar(app: &mut FilmcraftApp) {
+    if let Some(d) = app.jacnex_ia.modo.local() {
+        crate::jacnex_edicion::ejecutar(app, d, false);
+        return;
+    }
+    if app.jacnex_ia.modo == Modo::Vertical && !app.jacnex_ia.vertical.en_nube() {
+        crate::jacnex_vertical::ejecutar(app);
+        return;
+    }
+    if app.jacnex_ia.local.is_none() && !app.jacnex_ia.con_sesion {
+        app.jacnex_ia.con_sesion = conexion(&app.jacnex_ia).is_some();
+    }
+    if let Some(f) = falta(app) {
+        app.jacnex_ia.aviso = Some((false, f.into()));
+        return;
+    }
+    let Some(c) = conexion(&app.jacnex_ia) else {
+        app.jacnex_ia.aviso = Some((false, "Inicia sesión en Jacnex Studio para usar la IA.".into()));
+        return;
+    };
+    let preparado = preparar(app).and_then(|p| Ok((p, modelo_y_campos(app)?)));
+    let (Preparado { imagenes, video, destino }, (modelo, campos)) = match preparado {
+        Ok(r) => r,
+        Err(m) => {
+            app.jacnex_ia.aviso = Some((false, m));
+            return;
+        }
+    };
+    let e = &app.jacnex_ia;
+    debug_assert!(imagenes.len() == e.modo.imagenes());
+    let envio = Envio { modelo, prompt: e.modo.instrucciones(e.texto()), campos, imagenes, video, etapas: e.modo.etapas(), carpeta: carpeta(app) };
+    let rx = en_hilo(move |tx| {
+        let _ = tx.send(match red::generar(&c, envio, &tx) {
+            Ok(rutas) => Evento::Listo(rutas),
+            Err(m) => Evento::Error(m),
+        });
+    });
+    let e = &mut app.jacnex_ia;
+    e.aviso = None;
+    e.trabajo = Some(Trabajo { rx, modo: e.modo, etapa: "Preparando…", inicio: Instant::now(), destino });
+}
