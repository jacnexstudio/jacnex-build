+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use filmcraft_engine::Session;
+use filmcraft_project::{Transcript, Word};
+use filmcraft_speech::{FixedTranscriber, Options, ProgressFn, SpeechError, Transcriber};
+use filmcraft_time::Tick;
+use serde_json::json;
+
+use super::*;
+use crate::jacnex_ia::Modo;
+
+/// The demo with a fake transcriber: `words` (text, start s, end s) are what the first A1 clip
+/// says (in its media's time).
+fn app(words: &[(&str, f64, f64)]) -> FilmcraftApp {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let a = &s.active_sequence().unwrap().audio_tracks[0].items[0];
+    let sin = a.source_in;
+    let mut t = Transcript { language: "es".into(), ..Default::default() };
+    for (text, a, b) in words {
+        t.words.push(Word::new(*text, sin + Tick::from_seconds_f64(*a), sin + Tick::from_seconds_f64(*b)));
+    }
+    t.normalize();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: t, id: "fixed".into() }));
+    FilmcraftApp::new(s)
+}
+
+fn spaced(texts: &[&'static str]) -> Vec<(&'static str, f64, f64)> {
+    texts.iter().enumerate().map(|(i, t)| (*t, 0.1 + i as f64 * 0.3, 0.35 + i as f64 * 0.3)).collect()
+}
+
+/// Runs frames until the transcription ends (at most ~10 s).
+fn esperar(app: &mut FilmcraftApp) {
+    let ctx = egui::Context::default();
+    for _ in 0..1000 {
+        if !app.jacnex_ia.edicion.ocupado() {
+            return;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+        actualizar(app, &ctx);
+    }
+    panic!("the transcription never ended");
+}
+
+fn aviso(app: &FilmcraftApp) -> (bool, String) {
+    app.jacnex_ia.edicion.aviso.clone().unwrap()
+}
+
+#[test]
+fn subtitles_transcribe_in_the_background_then_land_on_a_new_track() {
+    let mut app = app(&spaced(&["Hola", "a", "todos,", "bienvenidos", "al", "canal."]));
+    let pistas = app.session.active_sequence().unwrap().video_tracks.len();
+    assert_eq!(falta(&app, Despues::Subtitulos), None);
+    ejecutar(&mut app, Despues::Subtitulos, false);
+    assert!(app.jacnex_ia.edicion.ocupado(), "runs on a worker thread");
+    assert_eq!(falta(&app, Despues::Subtitulos), Some("Espera a que termine la transcripción."));
+    esperar(&mut app);
+    let (ok, m) = aviso(&app);
+    assert!(ok, "{m}");
+    assert!(m.contains("subtítulos en la pista V"), "{m}");
+    let q = app.session.active_sequence().unwrap();
+    assert_eq!(q.video_tracks.len(), pistas + 1);
+    assert_eq!(q.video_tracks[pistas].name, "Subtítulos");
+    // the transcription is its own undo step, the captions another
+    assert_eq!(app.session.history.undo.last().map(|u| u.0.as_str()), Some("Create Animated Captions"));
+    // a second time nothing is transcribed again: straight to the tool
+    ejecutar(&mut app, Despues::Subtitulos, false);
+    assert!(!app.jacnex_ia.edicion.ocupado());
+    assert_eq!(app.session.active_sequence().unwrap().video_tracks.len(), pistas + 2);
+}
+
+#[test]
+fn spanish_fillers_and_long_pauses_are_removed() {
+    let mut w = spaced(&["Eh,", "hola,", "este,", "es", "este", "libro."]);
+    // 1.5 s of silence before the last words
+    w.push(("Bueno,", 3.5, 3.8));
+    w.push(("listo.", 3.85, 4.2));
+    let mut app = app(&w);
+    ejecutar(&mut app, Despues::Muletillas, false);
+    esperar(&mut app);
+    let (ok, m) = aviso(&app);
+    assert!(ok, "{m}");
+    // the fake transcriber says the same in every demo clip with audio
+    assert!(m.starts_with("Listo: se quitaron ") && m.ends_with(" muletillas (eh, este, bueno)."), "{m}");
+    app.jacnex_ia.edicion.pausa = 1.2;
+    ejecutar(&mut app, Despues::Silencios, false);
+    let (ok, m) = aviso(&app);
+    assert!(ok && m.starts_with("Listo: se quitaron ") && m.contains(" silencio"), "{m}");
+    ejecutar(&mut app, Despues::Silencios, false);
+    assert_eq!(aviso(&app).1, "No hay silencios de más de 1.2 s.");
+}
+
+#[test]
+fn edit_by_text_opens_the_transcript() {
+    let mut app = app(&spaced(&["Hola", "mundo."]));
+    ejecutar(&mut app, Despues::PorTexto, false);
+    esperar(&mut app);
+    assert!(aviso(&app).0);
+    assert_eq!(app.ui.text_tab, "Transcript");
+}
+
+/// A transcriber that takes until it is told to stop.
+struct Lento(Arc<AtomicBool>);
+
+impl Transcriber for Lento {
+    fn id(&self) -> String {
+        "lento".into()
+    }
+    fn transcribe(&self, _: &[f32], _: &Options, progress: ProgressFn) -> Result<Transcript, SpeechError> {
+        self.0.store(true, Ordering::Relaxed);
+        for i in 0..2000 {
+            if !progress(i as f32 / 2000.0, "") {
+                return Err(SpeechError::Cancelled);
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        Ok(Transcript::default())
+    }
+}
+
+#[test]
+fn a_transcription_can_be_stopped() {
+    let mut app = app(&[]);
+    let empezo = Arc::new(AtomicBool::new(false));
+    app.session.transcriber = Some(Arc::new(Lento(empezo.clone())));
+    let undo = app.session.history.undo.len();
+    ejecutar(&mut app, Despues::Subtitulos, false);
+    let ctx = egui::Context::default();
+    for _ in 0..500 {
+        if empezo.load(Ordering::Relaxed) {
+            break;
+        }
+        std::thread::sleep(Duration::from_millis(10));
+        actualizar(&mut app, &ctx);
+    }
+    actualizar(&mut app, &ctx);
+    let (texto, _) = app.jacnex_ia.edicion.progreso().unwrap();
+    assert!(texto.starts_with("Transcribiendo") || texto.starts_with("Leyendo"), "{texto}");
+    app.jacnex_ia.edicion.detener();
+    assert_eq!(app.jacnex_ia.edicion.progreso().unwrap().0, "Deteniendo…");
+    esperar(&mut app);
+    assert_eq!(aviso(&app), (false, "Transcripción detenida.".to_string()));
+    assert_eq!(app.session.history.undo.len(), undo, "nothing changed");
+}
+
+#[test]
+fn the_window_offers_the_edit_tools_without_an_account() {
+    let mut app = app(&spaced(&["Hola", "mundo."]));
+    crate::jacnex_ia::alternar(&mut app);
+    let ctx = egui::Context::default();
+    for modo in [Modo::Subtitulos, Modo::Silencios, Modo::Muletillas, Modo::PorTexto] {
+        app.jacnex_ia.modo = modo;
+        let mut out = ctx.run_ui(egui::RawInput::default(), |ui| crate::jacnex_ia::ventana(&mut app, ui.ctx()));
+        out.textures_delta.clear();
+        assert!(modo.local().is_some());
+        assert_eq!(falta(&app, modo.local().unwrap()), None, "no account, no credits needed");
+    }
+    // the generate entry point runs the local tool too
+    app.jacnex_ia.modo = Modo::Subtitulos;
+    crate::jacnex_ia::generar(&mut app);
+    assert!(app.jacnex_ia.edicion.ocupado());
+    esperar(&mut app);
+    assert!(aviso(&app).0, "{:?}", aviso(&app));
+}
