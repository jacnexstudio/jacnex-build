+const DURACION_MUSICA: u32 = 30;
+
+/// `max(1, ⌈letras × por_mil / 1000⌉)`: lo que cobra el servidor por la voz.
+fn creditos_de_voz(por_mil: i64, letras: usize) -> i64 {
+    let letras = i64::try_from(letras).unwrap_or(i64::MAX);
+    letras.saturating_mul(por_mil).saturating_add(999).div_euclid(1000).max(1)
+}
+
+/// `⌈⌈segundos⌉ × créditos por segundo⌉`: lo que cobra el servidor por mejorar un clip.
+fn creditos_de_mejora(centesimas_por_segundo: i64, segundos: f64) -> Option<i64> {
+    if !segundos.is_finite() || segundos <= 0.0 || segundos > 86_400.0 {
+        return None;
+    }
+    #[allow(clippy::cast_possible_truncation)]
+    let s = (segundos - 1e-6).ceil().max(1.0) as i64;
+    Some(s.saturating_mul(centesimas_por_segundo).saturating_add(99).div_euclid(100))
+}
