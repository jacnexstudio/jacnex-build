+/// El pie de la ventana en «Buscar».
+pub fn pie(ui: &mut egui::Ui, b: &mut Buscar, d: &Datos, t: &crate::theme::Tokens) {
+    let ancho = ui.available_width();
+    if let Some(tr) = &b.trabajo {
+        let (texto, avance) = texto_progreso(tr.progreso, tr.etapa);
+        let parando = tr.parar.load(Ordering::Relaxed);
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            let texto = if parando { "Deteniendo…".to_string() } else { format!("{texto}  {} s", tr.inicio.elapsed().as_secs()) };
+            ui.label(RichText::new(texto).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_height(6.0).fill(ACENTO));
+        }
+        ui.horizontal(|ui| {
+            let nota = if tr.ia { "Con IA se cobra solo lo que cuesta." } else { "Lo ya mirado queda guardado: la próxima vez es más rápido." };
+            ui.label(RichText::new(nota).small().color(t.text_dim));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.small_button("Detener").clicked() {
+                    b.pendiente = Some(Pedido::Detener);
+                }
+            });
+        });
+    } else if let (true, Some(m), Some(q)) = (b.con_ia, &b.material, &d.busqueda) {
+        let hojas = m.hojas.len();
+        let tope = q.reserva(m.letras, hojas);
+        let normal = q.esperado(m.letras, hojas);
+        ui.label(RichText::new(format!("{} · {} hojas de imágenes", m.nombre, hojas)).strong());
+        ui.label(RichText::new(format!("Cuesta como máximo {} (lo normal: unos {}).", creditos(tope), decimal(normal))).small().strong().color(ACENTO_CLARO));
+        if let Some(s) = d.saldo {
+            let (texto, color) = if s >= tope {
+                (format!("Te quedan {} después.", creditos(s - tope)), t.text_dim)
+            } else {
+                (format!("Te faltan {}.", creditos(tope - s)), ROJO)
+            };
+            ui.label(RichText::new(texto).small().color(color));
+        }
+        ui.add_space(2.0);
+        ui.horizontal(|ui| {
+            let alcanza = d.saldo.is_none_or(|s| s >= tope);
+            if boton_acento(ui, &format!("Enviar · hasta {}", creditos(tope)), egui::vec2(ancho - 90.0, 34.0), alcanza).clicked() {
+                b.pendiente = Some(Pedido::Enviar);
+            }
+            if ui.add(egui::Button::new("Cancelar").min_size(egui::vec2(82.0, 34.0))).clicked() {
+                b.pendiente = Some(Pedido::Descartar);
+            }
+        });
+    } else {
+        let texto = if b.con_ia { "Preparar la búsqueda con IA" } else { "Buscar" };
+        if b.con_ia {
+            ui.label(RichText::new("Antes de enviar verás cuánto cuesta.").small().color(t.text_dim));
+            ui.add_space(2.0);
+        }
+        if boton_acento(ui, texto, egui::vec2(ancho, 36.0), d.falta.is_none()).clicked() {
+            b.pendiente = Some(if b.con_ia { Pedido::Preparar } else { Pedido::Buscar });
+        }
+        if let Some(f) = d.falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    if let Some((ok, m)) = &b.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
