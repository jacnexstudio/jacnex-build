+#[test]
+fn place_puts_the_dub_in_its_sequence_even_when_another_one_is_active() {
+    let (mut s, clip, start) = session();
+    let made_for = s.state.active_sequence.unwrap();
+    let tracks = s.active_sequence().unwrap().audio_tracks.len();
+    s.execute("file.newSequence", json!({})).unwrap();
+    let other = s.state.active_sequence.unwrap();
+    assert_ne!(other, made_for, "the user switched to a new sequence");
+    let other_tracks = s.active_sequence().unwrap().audio_tracks.len();
+    let sel = s.state.selection.clone();
+    let undo = s.history.undo.len();
+    let r =
+        dub::place(&mut s, made_for, &dub::Dub { at: start, samples: &tone(3.0, 0.4), background: None, sources: &[clip], original: Original::Lower }).unwrap();
+    let dub::Placed::Track(a) = r else { panic!("expected a track, got {r:?}") };
+    assert_eq!((a.track, a.lowered), (tracks, 1));
