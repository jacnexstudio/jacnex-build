+    let pasos = s.history.undo.len();
+    let f = sentences(&sequence_words(&s));
+    let sec = |i: usize| (f[i].start.seconds(), f[i].end.seconds());
+    let (g0, g1) = sec(6);
+    let reply = con_gancho(g(g0, g1), &[sec(0), sec(3)]);
+    let p = parse_reply_hook(&reply, &f, dur, RATE, 4.5, true).unwrap();
+    let hook = p.hook.expect("hay gancho");
+    let plan = Plan { seq, seq_duration: dur, title: p.title, ranges: p.ranges, hook: p.hook };
+    apply(&mut s, &plan).unwrap();
+    assert_eq!(s.history.undo.len(), pasos + 1, "un solo paso de deshacer");
+    let nuevo = s.state.active_sequence.unwrap();
+    let q = nueva(&s, nuevo);
+    q.check().unwrap();
+    assert!((q.duration().seconds() - plan.seconds()).abs() <= RATE.frame_duration().seconds() * 2.5, "{} vs {}", q.duration().seconds(), plan.seconds());
+    // lo primero que suena es el gancho: el clip original que lo contiene, desde donde empieza
+    let orig = antes.audio_tracks[0].items.iter().find(|i| i.start <= hook.start && hook.start < i.end()).expect("clip del gancho");
+    let esperado = orig.source_in + (hook.start - orig.start);
+    let primero = q.audio_tracks[0].items.iter().min_by_key(|i| i.start).unwrap();
+    assert_eq!(primero.start, Tick::ZERO);
+    assert_eq!(primero.item, orig.item);
+    assert!((primero.source_in - esperado).seconds().abs() < 0.05, "{:?} vs {:?}", primero.source_in, esperado);
+    // y no se repite: el sonido y la imagen del gancho aparecen una vez
+    let veces = q.audio_tracks[0].items.iter().filter(|i| i.item == orig.item && i.source_in <= esperado && esperado < i.source_in + i.duration).count();
+    assert_eq!(veces, 1, "el gancho no se repite");
+    // imagen y sonido siguen juntos
+    for v in q.video_tracks.iter().flat_map(|t| &t.items) {
+        if let Some(a) = v.link.and_then(|l| q.audio_tracks.iter().flat_map(|t| &t.items).find(|a| a.link == Some(l))) {
+            assert_eq!((v.start, v.duration, v.source_in), (a.start, a.duration, a.source_in));
+        }
+    }
+    // sin huecos ni solapes en A1
+    let mut items: Vec<_> = q.audio_tracks[0].items.iter().collect();
+    items.sort_by_key(|i| i.start);
+    assert!(items.windows(2).all(|w| w[0].end() <= w[1].start));
+    // la original no cambió y deshacer quita la nueva
+    assert_eq!(nueva(&s, seq), antes);
+    s.execute("edit.undo", json!({})).unwrap();
+    assert!(s.project.item(nuevo).is_none());
+    // un gancho que se repite en los tramos no se aplica
+    let mala = Plan { ranges: vec![hook], ..plan };
+    assert!(apply(&mut s, &mala).is_err());
+}
