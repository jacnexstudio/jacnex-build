+//! Compares Light-ASD with a torch port dumped by a script (runs only when `REFRAME_CHECK_DIR` and
+//! `REFRAME_MODELS_DIR` are set).
+#![cfg(feature = "candle")]
+
+use std::path::PathBuf;
+
+fn read(p: &std::path::Path) -> Vec<f32> {
+    std::fs::read(p).unwrap().as_chunks::<4>().0.iter().map(|b| f32::from_le_bytes(*b)).collect()
+}
+
+#[test]
+fn lightasd_matches_torch() {
+    let (Ok(chk), Ok(models)) = (std::env::var("REFRAME_CHECK_DIR"), std::env::var("REFRAME_MODELS_DIR")) else { return };
+    let chk = PathBuf::from(chk);
+    let net = filmcraft_reframe::lightasd::LightAsd::load(&PathBuf::from(models).join(filmcraft_reframe::lightasd::MODEL_ID)).unwrap();
+    let want = read(&chk.join("lasd_o.f32"));
+    let got = net.score(&read(&chk.join("lasd_v.f32")), &read(&chk.join("lasd_a.f32")), want.len()).unwrap();
+    let err = got.iter().zip(&want).map(|(a, b)| (a - b).abs()).fold(0f32, f32::max);
+    eprintln!("lightasd max err {err:e} got {got:?}");
+    assert!(err < 1e-3, "{err}");
+}
