+// --- Generar y colocar ----------------------------------------------------------------------
+
+/// Por qué no se puede generar ahora (o nada).
+fn falta(app: &FilmcraftApp) -> Option<&'static str> {
+    let e = &app.jacnex_ia;
+    if e.modo == Modo::Buscar {
+        return crate::jacnex_buscar::falta(app);
+    }
+    if e.modo == Modo::Corta {
+        return crate::jacnex_corta::falta(app);
+    }
+    if e.modo == Modo::Doblaje {
+        return crate::jacnex_doblaje::falta(app);
+    }
+    if let Some(d) = e.modo.local() {
+        return crate::jacnex_edicion::falta(app, d);
+    }
+    if e.modo == Modo::Vertical && !e.vertical.en_nube() {
+        return crate::jacnex_vertical::falta_local(app);
+    }
+    if e.ocupado() {
+        return Some("Espera a que termine lo que se está creando.");
+    }
+    if !e.con_sesion && e.local.is_none() {
+        return Some("Inicia sesión en Jacnex Studio para usar la IA.");
+    }
+    let mut segundos = None;
+    let vacio = e.texto().trim().is_empty();
+    match e.modo {
+        Modo::Texto if vacio => return Some("Describe el video que quieres crear."),
+        Modo::Foto if e.foto.is_none() && secuencia(app).is_none() => return Some("Elige una imagen o abre una secuencia para usar el cuadro del cabezal."),
+        Modo::Transicion if corte_cercano(app).is_none() => return Some("Pon dos clips seguidos en la línea de tiempo y el cabezal cerca del corte."),
+        Modo::Voz if vacio => return Some("Escribe el texto que leerá la voz."),
+        Modo::Musica if vacio => return Some("Describe la música que quieres."),
+        Modo::Efecto if vacio => return Some("Describe el sonido que quieres."),
+        Modo::Mejorar | Modo::Vertical => match clip_a_mejorar(app, e.herramienta_actual().as_ref()) {
+            Ok(c) => segundos = Some(c.segundos),
+            Err(m) => return Some(m),
+        },
+        _ => {}
+    }
+    if let Some(h) = e.herramienta_actual()
+        && h.max_texto > 0
+        && e.letras() > h.max_texto
+    {
+        return Some("El texto es demasiado largo: acórtalo.");
+    }
+    if let (Some(i), Some(c)) = (&e.info, e.costo(segundos))
+        && i.creditos < c
+    {
+        return Some("No tienes créditos suficientes: recarga en jacnex.store.");
+    }
+    None
+}
