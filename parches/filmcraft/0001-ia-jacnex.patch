+/// Lo más largo que puede ser lo que se busca, en letras.
+const MAX_CONSULTA: usize = 200;
+/// Resultados que se muestran.
+const MAX_RESULTADOS: usize = 60;
+/// Resultados con miniatura (leerlas cuesta: el resto se ve sin imagen).
+const MAX_MINIATURAS: usize = 24;
+/// Ancho de las miniaturas que se leen, en píxeles.
+const ANCHO_MINIATURA: usize = 160;
+/// Archivos que se ofrecen para «Con IA».
+const MAX_ARCHIVOS: usize = 200;
+/// Palabras de una transcripción que se envían a la IA como mucho.
+const MAX_PALABRAS: usize = 200_000;
+/// Lo más largo del motivo de un resultado de la IA, en letras.
+const MAX_MOTIVO: usize = 160;
+/// Momentos que se toman de la respuesta de la IA.
+const MAX_MOMENTOS: usize = 10;
+/// Cada cuánto se vuelve a mirar qué modelos están instalados.
+const REVISAR_MODELOS: Duration = Duration::from_secs(5);
+
+/// Lo que la ventana pide hacer (se atiende después de dibujarla).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Pedido {
+    /// Buscar en esta computadora.
+    Buscar,
+    /// Con IA: reunir el material y calcular el costo.
+    Preparar,
+    /// Con IA: enviar lo preparado.
+    Enviar,
+    /// Dejar lo preparado.
+    Descartar,
+    /// Detener el trabajo en curso.
+    Detener,
+    /// Abrir el resultado en el visor de origen.
+    Ver(usize),
+    /// Poner el resultado en la secuencia.
+    Agregar(usize),
+}
+
+/// Lo que se ve de un resultado.
+struct Resultado {
+    hit: Hit,
+    nombre: String,
+    razon: String,
+    textura: Option<TextureHandle>,
+}
+
+/// El material de un archivo, listo para enviarlo a la IA.
+struct Material {
+    item: ItemId,
+    nombre: String,
+    segundos: f64,
+    contexto: String,
+    letras: usize,
+    hojas: Vec<(String, Vec<u8>)>,
+}
+
+/// Lo que el hilo le cuenta a la interfaz.
+enum Mensaje {
+    Progreso(SearchProgress),
+    Preparado(Material),
+    Hecho(Result<Salida, String>),
+}
+
+/// Un resultado antes de hacerse textura.
+struct Fila {
+    hit: Hit,
+    nombre: String,
+    razon: String,
+    miniatura: Option<Thumb>,
+}
+
+/// Lo que dejó una búsqueda.
+struct Salida {
+    filas: Vec<Fila>,
+    /// Los modelos ya cargados (para no cargarlos otra vez).
+    modelos: Option<Models>,
+    /// Transcripciones hechas de paso: se guardan en el proyecto.
+    transcripciones: Option<SpeechResult>,
+    notas: Vec<String>,
+    consulta: String,
+    /// Créditos cobrados (solo con IA).
+    cobrado: Option<i64>,
+}
+
+struct Trabajo {
+    rx: Receiver<Mensaje>,
+    parar: Arc<AtomicBool>,
+    progreso: Option<SearchProgress>,
+    etapa: &'static str,
+    inicio: Instant,
+    ia: bool,
+}
