+++ b/crates/engine/src/speech_edit_tests.rs
@@ -0,0 +1,212 @@
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+
+use crate::Session;
+use crate::speech_job::{CANCELLED, SpeechProgress, apply_transcripts, speech_job, untranscribed_sequence_items};
+use filmcraft_project::{ItemId, Transcript, Word};
+use filmcraft_speech::FixedTranscriber;
+use filmcraft_time::Tick;
+
+/// The demo project; `words` (text, start s, end s) become the transcript of the first A1
+/// clip's media, in `language`, through a fake transcriber.
+fn session(language: &str, words: &[(&str, f64, f64)]) -> (Session, ItemId) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let q = s.active_sequence().unwrap();
+    let a = &q.audio_tracks[0].items[0];
+    let (item, sin) = (a.item, a.source_in);
+    let mut t = Transcript { language: language.into(), ..Default::default() };
+    for (text, a, b) in words {
+        t.words.push(Word::new(*text, sin + Tick::from_seconds_f64(*a), sin + Tick::from_seconds_f64(*b)));
+    }
+    t.normalize();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: t, id: "fixed".into() }));
+    (s, item)
+}
+
+/// Words spaced 0.3 s apart (0.25 s long, 0.05 s gaps: no pauses).
+fn spaced(texts: &[&'static str]) -> Vec<(&'static str, f64, f64)> {
+    texts.iter().enumerate().map(|(i, t)| (*t, 0.1 + i as f64 * 0.3, 0.35 + i as f64 * 0.3)).collect()
+}
+
+fn words(s: &mut Session) -> Vec<String> {
+    let r = s.execute("transcript.inspect", json!({})).unwrap();
+    r["words"].as_array().unwrap().iter().map(|w| w["text"].as_str().unwrap().to_string()).collect()
+}
+
+#[test]
+fn spanish_fillers_go_only_where_they_stand_alone() {
+    let texts = ["Eh,", "hola,", "este,", "es", "este", "libro.", "Bueno,", "está", "muy", "bueno.", "O", "sea,", "listo."];
+    let (mut s, item) = session("es", &spaced(&texts));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let before = s.active_sequence().unwrap().duration();
+    let r = s.execute("transcript.removeFillersSmart", json!({})).unwrap();
+    assert_eq!(r["words"], json!(["Eh,", "este,", "Bueno,", "O sea,"]), "{r}");
+    assert_eq!(words(&mut s), ["hola,", "es", "este", "libro.", "está", "muy", "bueno.", "listo."]);
+    assert!(s.active_sequence().unwrap().duration() < before, "the sequence got shorter");
+    // one undo step
+    s.execute("edit.undo", json!({})).unwrap();
+    assert_eq!(words(&mut s).len(), texts.len());
+}
+
+#[test]
+fn a_pause_after_a_filler_counts_like_a_comma() {
+    // "pues" then 0.5 s of silence: a filler; "pues" inside a sentence: a word
+    let w = [("Pues", 0.1, 0.4), ("vamos", 0.9, 1.2), ("ya", 1.25, 1.5), ("pues", 1.55, 1.8), ("claro.", 1.85, 2.2)];
+    let (mut s, item) = session("es", &w);
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let r = s.execute("transcript.removeFillersSmart", json!({})).unwrap();
+    assert_eq!(r["words"], json!(["Pues"]), "{r}");
+}
+
+#[test]
+fn english_keeps_am_and_ah_but_drops_um() {
+    let (mut s, item) = session("en", &spaced(&["I", "am", "um", "fine,", "ah", "thanks."]));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let r = s.execute("transcript.removeFillersSmart", json!({})).unwrap();
+    assert_eq!(r["words"], json!(["um"]), "{r}");
+    // the same words read as Spanish: "ah" is a hesitation there
+    s.execute("edit.undo", json!({})).unwrap();
+    let r = s.execute("transcript.removeFillersSmart", json!({"language": "es"})).unwrap();
+    assert_eq!(r["words"], json!(["am", "um", "ah"]), "{r}");
+}
+
+#[test]
+fn no_fillers_removes_nothing() {
+    let (mut s, item) = session("es", &spaced(&["Hola", "a", "todos."]));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let r = s.execute("transcript.removeFillersSmart", json!({})).unwrap();
+    assert_eq!(r["removed"], 0);
+    assert!(s.execute("edit.undo", json!({})).is_ok());
+    assert!(s.project.transcripts.is_empty(), "the undo undid the transcription: removing nothing made no step");
+}
+
+fn caption_track(s: &Session, r: &Value) -> filmcraft_project::Track {
+    let q = s.active_sequence().unwrap();
+    q.video_tracks[r["trackIndex"].as_u64().unwrap() as usize].clone()
+}
+
+fn layer_text(it: &filmcraft_project::TrackItem) -> String {
+    let e = it.effects.iter().find(|e| e.effect == filmcraft_project::graphic::TEXT_LAYER).unwrap();
+    match &e.params["text"].value {
+        filmcraft_project::ParamValue::Text(t) => t.clone(),
+        v => panic!("{v:?}"),
+    }
+}
+
+#[test]
+fn highlighted_captions_make_a_clip_per_word_on_a_new_top_track() {
+    let texts = ["Hola", "a", "todos,", "bienvenidos", "al", "canal.", "Hoy", "cocinamos."];
+    let (mut s, item) = session("es", &spaced(&texts));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let tracks = s.active_sequence().unwrap().video_tracks.len();
+    let r = s.execute("transcript.createAnimatedCaptions", json!({"style": "highlight"})).unwrap();
+    assert_eq!(r["clips"], texts.len(), "{r}");
+    let q = s.active_sequence().unwrap();
+    assert_eq!(q.video_tracks.len(), tracks + 1);
+    assert_eq!(r["trackIndex"], tracks, "on top of everything");
+    let t = caption_track(&s, &r);
+    assert_eq!(t.name, "Subtítulos");
+    // phrases: "Hola a todos" (comma), "bienvenidos al canal" (period), "Hoy cocinamos"
+    let shown: Vec<String> = t.items.iter().map(layer_text).collect();
+    assert_eq!(shown[0], "Hola a todos");
+    assert_eq!(shown[2], "Hola a todos");
+    assert_eq!(shown[3], "bienvenidos al canal");
+    assert_eq!(shown[7], "Hoy cocinamos");
+    // the active word is highlighted: "todos" in the third clip
+    let e = t.items[2].effects.iter().find(|e| e.effect == filmcraft_project::graphic::TEXT_LAYER).unwrap();
+    let run = &e.layer.as_ref().unwrap().runs[0];
+    assert_eq!((run.start, run.end), (7, 12));
+    assert_eq!(run.style.fill, Some([1.0, 0.84, 0.0, 1.0]));
+    // frame-aligned, in order, never overlapping
+    let rate = s.sequence_rate();
+    for w in t.items.windows(2) {
+        assert!(w[0].end() <= w[1].start, "{:?} {:?}", w[0].range(), w[1].range());
+    }
+    for it in &t.items {
+        assert_eq!(rate.snap(it.start), it.start);
+    }
+    // one undo step
+    s.execute("edit.undo", json!({})).unwrap();
+    assert_eq!(s.active_sequence().unwrap().video_tracks.len(), tracks);
+}
+
+#[test]
+fn word_captions_pop_and_classic_captions_are_phrases() {
+    let texts = ["Uno,", "dos,", "tres.", "Cuatro", "cinco."];
+    let (mut s, item) = session("es", &spaced(&texts));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    let r = s.execute("transcript.createAnimatedCaptions", json!({"style": "word", "position": "middle"})).unwrap();
+    let t = caption_track(&s, &r);
+    assert_eq!(t.items.len(), 5);
+    assert_eq!(layer_text(&t.items[0]), "Uno");
+    let e = t.items[0].effects.iter().find(|e| e.effect == filmcraft_project::graphic::TEXT_LAYER).unwrap();
+    assert_eq!(e.params["scale"].keyframes.len(), 3, "pops in");
+    let r = s.execute("transcript.createAnimatedCaptions", json!({"style": "classic", "maxWords": 7})).unwrap();
+    let t = caption_track(&s, &r);
+    let shown: Vec<String> = t.items.iter().map(layer_text).collect();
+    assert_eq!(shown, ["Uno dos tres", "Cuatro cinco"], "sentences end a phrase; a comma only once the phrase has half its words");
+}
+
+#[test]
+fn hostile_caption_params_are_refused_or_ignored() {
+    let (mut s, item) = session("es", &spaced(&["Hola", "mundo."]));
+    assert!(s.execute("transcript.createAnimatedCaptions", json!({})).is_err(), "disabled without a transcript");
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    assert!(s.execute("transcript.createAnimatedCaptions", json!({"style": "sparkles"})).is_err());
+    assert!(s.execute("transcript.createAnimatedCaptions", json!({"position": "left"})).is_err());
+    let r = s.execute("transcript.createAnimatedCaptions", json!({"color": "#zzzzzzzz", "highlight": "ñññ", "size": -5, "maxWords": 1_000_000})).unwrap();
+    assert_eq!(r["clips"], 2);
+}
+
+#[test]
+fn a_job_transcribes_off_the_session_and_applies_as_one_step() {
+    let (s, item) = session("es", &spaced(&["Hola", "mundo."]));
+    assert!(untranscribed_sequence_items(&s).contains(&item), "the A1 media");
+    let job = speech_job(&s, &json!({"items": [item.0]})).unwrap();
+    assert_eq!(job.items(), vec![item]);
+    assert!(job.seconds() > 0.0);
+    assert_eq!(job.download_size(), None, "a transcriber is installed");
+    // runs on another thread, reporting progress
+    let r = std::thread::spawn(move || {
+        let mut seen = Vec::new();
+        let r = job.run(&mut |p| {
+            seen.push(p);
+            true
+        });
+        (r, seen)
+    })
+    .join()
+    .unwrap();
+    let (r, seen) = r;
+    assert!(seen.iter().any(|p| matches!(p, SpeechProgress::Reading { item: 0, of: 1 })), "{seen:?}");
+    assert!(seen.iter().any(|p| matches!(p, SpeechProgress::Transcribing { .. })), "{seen:?}");
+    let mut s = s;
+    let r = apply_transcripts(&mut s, r.unwrap()).unwrap();
+    assert_eq!(r["items"][0]["words"], 2, "{r}");
+    assert!(!untranscribed_sequence_items(&s).contains(&item));
+    s.execute("edit.undo", json!({})).unwrap();
+    assert!(s.project.transcripts.is_empty());
+}
+
+#[test]
+fn a_job_can_be_stopped() {
+    let (s, item) = session("es", &spaced(&["Hola"]));
+    let job = speech_job(&s, &json!({"items": [item.0]})).unwrap();
+    let e = job.run(&mut |p| !matches!(p, SpeechProgress::Transcribing { .. })).err().unwrap();
+    assert!(e.to_string().contains(CANCELLED), "{e}");
+}
+
+#[test]
+fn a_job_needs_something_with_audio() {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: Transcript::default(), id: "fixed".into() }));
+    assert!(speech_job(&s, &json!({"items": [999_999]})).is_err());
+    let video_only = s.active_sequence().unwrap().video_tracks[0].items[0].item;
+    let has_audio = s.project.resolve_media(video_only).is_some_and(|(_, m, _)| m.info.has_audio());
+    if !has_audio {
+        assert!(speech_job(&s, &json!({"items": [video_only.0]})).is_err());
+    }
+}
diff --git a/crates/engine/src/speech_job.rs b/crates/engine/src/speech_job.rs
new file mode 100644
index 0000000..cacc1dc
--- /dev/null
+++ b/crates/engine/src/speech_job.rs
@@ -0,0 +1,270 @@
+//! Transcription off the UI thread.
+//!
+//! [`speech_job`] collects what to transcribe on the UI thread (cheap: no decoding). A worker
+//! thread then runs [`SpeechJob::run`], which downloads the speech model if needed, reads the
+//! audio, transcribes it and reports progress. The UI thread commits the result with
+//! [`apply_transcripts`] as one undo step. `transcript.generate` runs the same steps in place.
+
+use std::path::PathBuf;
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+
+use filmcraft_media::SharedSource;
+use filmcraft_project::{ItemId, ItemKind, Transcript};
+use filmcraft_speech::{Options, SpeechError, Transcriber};
+
+use crate::commands::{bad, bool_p, str_p};
+use crate::transcript::{NO_SPEECH, speech_err, speech_models_dir, speech_options, targets};
+use crate::{EngineError, Result, Session};
+
+/// The longest audio of one clip that is transcribed (the decoded audio is held in memory:
+/// 2 h of 16 kHz mono is about 460 MB).
+pub const MAX_SPEECH_SECONDS: u64 = 2 * 3600;
+/// Audio is read this many seconds at a time, so a long clip never needs a second full-length
+/// buffer per channel.
+const CHUNK_SECONDS: usize = 30;
+
+/// What a running [`SpeechJob`] is doing.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SpeechProgress {
+    /// Downloading the speech model: `done` of `total` bytes.
+    Download { done: u64, total: u64 },
+    /// Loading the speech model.
+    Loading,
+    /// Reading the audio of clip `item` (0-based) of `of`.
+    Reading { item: usize, of: usize },
+    /// Transcribing clip `item` of `of`; `fraction` (0..1) of it is done.
+    Transcribing { item: usize, of: usize, fraction: f32 },
+}
+
+/// Why a job stopped early.
+pub const CANCELLED: &str = "transcription stopped";
+
+struct JobItem {
+    item: ItemId,
+    source: SharedSource,
+    /// Audio frames at 16 kHz.
+    frames: usize,
+}
+
+/// A transcription collected on the UI thread, to run anywhere ([`SpeechJob::run`]).
+pub struct SpeechJob {
+    items: Vec<JobItem>,
+    skipped: Vec<ItemId>,
+    model: String,
+    opts: Options,
+    /// A transcriber the host installed (tests, plug-ins): used instead of a model.
+    installed: Option<Arc<dyn Transcriber>>,
+    dir: Option<PathBuf>,
+    /// Download the model when it is missing (otherwise that is an error).
+    download: bool,
+}
+
+/// The transcripts a job made, and the items it could not read.
+pub struct SpeechResult {
+    pub done: Vec<(ItemId, Transcript)>,
+    pub skipped: Vec<ItemId>,
+}
+
+/// The media items behind the active sequence's enabled audio clips (the ones its transcript
+/// is made of), without duplicates.
+pub fn sequence_audio_items(s: &Session) -> Vec<ItemId> {
+    let Some(q) = s.active_sequence() else { return Vec::new() };
+    let mut out = Vec::new();
+    for it in q.audio_tracks.iter().flat_map(|t| t.items.iter()).filter(|it| it.enabled) {
+        if let Some((root, media, _)) = s.project.resolve_media(it.item)
+            && media.info.has_audio()
+            && !out.contains(&root)
+        {
+            out.push(root);
+        }
+    }
+    out
+}
+
+/// The active sequence's audio media that has no transcript yet.
+pub fn untranscribed_sequence_items(s: &Session) -> Vec<ItemId> {
+    sequence_audio_items(s).into_iter().filter(|i| !s.project.transcripts.contains_key(i)).collect()
+}
+
+/// Collect a transcription (params as `transcript.generate`, plus `"download": bool` to fetch a
+/// missing model). Fails when there is nothing to transcribe or no way to transcribe it.
+pub fn speech_job(s: &Session, p: &Value) -> Result<SpeechJob> {
+    collect(s, p, s.transcriber.clone())
+}
+
+/// Like [`speech_job`], but transcribed by `t` (an online service, say) instead of a model.
+pub fn speech_job_using(s: &Session, p: &Value, t: Arc<dyn Transcriber>) -> Result<SpeechJob> {
+    collect(s, p, Some(t))
+}
+
+fn collect(s: &Session, p: &Value, installed: Option<Arc<dyn Transcriber>>) -> Result<SpeechJob> {
+    let items = targets(s, p);
+    if items.is_empty() {
+        return Err(bad("transcript.generate", "nothing to transcribe (pass `items`, select clips, or open a sequence with audio)"));
+    }
+    // Settings ▸ Media Analysis & Transcription ▸ Speech model
+    let model = str_p(p, "model").unwrap_or(&s.prefs.media_analysis.whisper_model).to_string();
+    if installed.is_none() {
+        if filmcraft_speech::models::find(&model).is_none() {
+            return Err(speech_err(SpeechError::UnknownModel(model)));
+        }
+        if !filmcraft_speech::available() {
+            return Err(EngineError::Other(NO_SPEECH.into()));
+        }
+    }
+    // Jacnex: the copy Jacnex Studio downloaded with Filmnex, when it's there
+    let dir = speech_models_dir(&model);
+    let sr = u64::from(filmcraft_speech::SAMPLE_RATE);
+    let mut job =
+        SpeechJob { items: Vec::new(), skipped: Vec::new(), model, opts: speech_options(s, p), installed, dir, download: bool_p(p, "download") == Some(true) };
+    for item in items {
+        let dur = match s.project.item(item).map(|i| &i.kind) {
+            Some(ItemKind::Media(m)) => m.duration(),
+            _ => {
+                job.skipped.push(item);
+                continue;
+            }
+        };
+        let frames = u64::try_from(dur.to_units_floor(sr as i64)).unwrap_or(0);
+        let source = s.source(item).filter(|src| src.info().has_audio());
+        match (source, usize::try_from(frames)) {
+            (Some(source), Ok(frames)) if frames > 0 && frames as u64 <= MAX_SPEECH_SECONDS * sr => job.items.push(JobItem { item, source, frames }),
+            _ => job.skipped.push(item),
+        }
+    }
+    if job.items.is_empty() {
+        return Err(EngineError::Other("none of the clips has audio to transcribe".into()));
+    }
+    Ok(job)
+}
+
+impl SpeechJob {
+    /// The items that will be transcribed.
+    pub fn items(&self) -> Vec<ItemId> {
+        self.items.iter().map(|i| i.item).collect()
+    }
+
+    /// Seconds of audio to transcribe.
+    pub fn seconds(&self) -> f64 {
+        self.items.iter().map(|i| i.frames as f64).sum::<f64>() / f64::from(filmcraft_speech::SAMPLE_RATE)
+    }
+
+    /// The size in bytes of the model download this job needs (None: nothing to download).
+    /// Only file sizes are checked here; [`run`](Self::run) verifies the files.
+    pub fn download_size(&self) -> Option<u64> {
+        if self.installed.is_some() {
+            return None;
+        }
+        let m = filmcraft_speech::models::find(&self.model)?;
+        (!filmcraft_speech::models::present(self.dir.as_ref()?, m)).then(|| m.size())
+    }
+
+    /// Run the job (on any thread). `progress` returns false to stop: the job then fails with
+    /// [`CANCELLED`].
+    pub fn run(self, progress: &mut dyn FnMut(SpeechProgress) -> bool) -> Result<SpeechResult> {
+        let t = self.transcriber(progress)?;
+        let of = self.items.len();
+        let sr = filmcraft_speech::SAMPLE_RATE;
+        let step = CHUNK_SECONDS * sr as usize;
+        let mut done = Vec::with_capacity(of);
+        let mut skipped = self.skipped;
+        for (k, job) in self.items.into_iter().enumerate() {
+            if !progress(SpeechProgress::Reading { item: k, of }) {
+                return Err(EngineError::Other(CANCELLED.into()));
+            }
+            let mut mono: Vec<f32> = Vec::with_capacity(job.frames);
+            let mut at = 0usize;
+            let mut failed = false;
+            while at < job.frames {
+                let n = step.min(job.frames - at);
+                let Ok(start) = i64::try_from(at) else { break };
+                match job.source.audio(start, n, sr) {
+                    Ok(buf) => mono.extend(filmcraft_speech::downmix(&buf.channels).into_iter().take(n)),
+                    Err(_) => {
+                        failed = true;
+                        break;
+                    }
+                }
+                at += n;
+                if !progress(SpeechProgress::Reading { item: k, of }) {
+                    return Err(EngineError::Other(CANCELLED.into()));
+                }
+            }
+            if failed || mono.is_empty() {
+                skipped.push(job.item);
+                continue;
+            }
+            let mut stopped = false;
+            let r = t.transcribe(&mono, &self.opts, &mut |f, _| {
+                let go = progress(SpeechProgress::Transcribing { item: k, of, fraction: if f.is_finite() { f.clamp(0.0, 1.0) } else { 0.0 } });
+                stopped |= !go;
+                go
+            });
+            let mut tr = match r {
+                Ok(tr) => tr,
+                Err(SpeechError::Cancelled) => return Err(EngineError::Other(CANCELLED.into())),
+                Err(_) if stopped => return Err(EngineError::Other(CANCELLED.into())),
+                Err(e) => return Err(speech_err(e)),
+            };
+            tr.normalize();
+            done.push((job.item, tr));
+        }
+        if done.is_empty() {
+            return Err(EngineError::Other("none of the clips has audio to transcribe".into()));
+        }
+        Ok(SpeechResult { done, skipped })
+    }
+
+    /// The installed transcriber, or the model (downloaded first when allowed).
+    fn transcriber(&self, progress: &mut dyn FnMut(SpeechProgress) -> bool) -> Result<Arc<dyn Transcriber>> {
+        if let Some(t) = &self.installed {
+            return Ok(t.clone());
+        }
+        let m = filmcraft_speech::models::find(&self.model).ok_or_else(|| speech_err(SpeechError::UnknownModel(self.model.clone())))?;
+        let dir = self.dir.clone().ok_or_else(|| EngineError::Other("no data directory for speech models".into()))?;
+        if self.download && !filmcraft_speech::models::installed(&dir, m) {
+            download(&dir, m, progress)?;
+        }
+        if !progress(SpeechProgress::Loading) {
+            return Err(EngineError::Other(CANCELLED.into()));
+        }
+        filmcraft_speech::load(&dir, m.id).map_err(speech_err)
+    }
+}
+
+#[cfg(feature = "speech-download")]
+fn download(dir: &std::path::Path, m: &filmcraft_speech::models::ModelInfo, progress: &mut dyn FnMut(SpeechProgress) -> bool) -> Result<()> {
+    let r = filmcraft_speech::models::download(dir, m, &mut |done, total, _| progress(SpeechProgress::Download { done, total }));
+    match r {
+        Ok(()) => Ok(()),
+        Err(SpeechError::Cancelled) => Err(EngineError::Other(CANCELLED.into())),
+        Err(e) => Err(speech_err(e)),
+    }
+}
+
+#[cfg(not(feature = "speech-download"))]
+fn download(_: &std::path::Path, m: &filmcraft_speech::models::ModelInfo, _: &mut dyn FnMut(SpeechProgress) -> bool) -> Result<()> {
+    Err(speech_err(SpeechError::NotInstalled(m.id.into())))
+}
+
+/// Commit a job's transcripts (items deleted meanwhile are left out) as one undo step.
+pub fn apply_transcripts(s: &mut Session, r: SpeechResult) -> Result<Value> {
+    let done: Vec<(ItemId, Transcript)> = r.done.into_iter().filter(|(i, _)| s.project.item(*i).is_some()).collect();
+    if done.is_empty() {
+        return Err(EngineError::Other("the transcribed clips are no longer in the project".into()));
+    }
+    let report: Vec<Value> = done
+        .iter()
+        .map(|(i, t)| json!({"item": i.0, "words": t.words.len(), "speakers": t.speakers.len(), "language": t.language, "source": t.source}))
+        .collect();
+    let skipped: Vec<u64> = r.skipped.iter().map(|i| i.0).collect();
+    s.edit("Transcribe", move |pr, _| {
+        for (i, t) in done {
+            pr.transcripts.insert(i, Arc::new(t));
+        }
+        Ok(())
+    })?;
+    Ok(json!({"items": report, "skipped": skipped}))
+}
