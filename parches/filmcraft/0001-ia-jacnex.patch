+/// Tras reemplazar un clip por su versión mejorada (más grande), le ajusta Movimiento para que
+/// se vea del mismo tamaño que antes: la escala baja en la misma proporción en que subió la
+/// resolución, y un punto de anclaje elegido se mueve con ella. Con «Ajustar al tamaño del
+/// cuadro» o la escala animada no hace falta (o no se toca).
+fn conservar_tamano(app: &mut FilmcraftApp, sec: ItemId, clip: ClipId, viejo: ItemId, nuevo: ItemId) {
+    let p = &app.session.project;
+    let (Some((w0, h0)), Some((w1, h1))) = (p.source_size(viejo), p.source_size(nuevo)) else { return };
+    if w0 == 0 || h0 == 0 || w1 == 0 || h1 == 0 || (w0, h0) == (w1, h1) {
+        return;
+    }
+    let Some((_, it)) = p.sequence(sec).and_then(|q| q.find_item(clip)) else { return };
+    if it.scale_to_frame {
+        return;
+    }
+    let Some(m) = it.effect("motion") else { return };
+    let k = f64::from(w0) / f64::from(w1);
+    let mut cambios: Vec<(&str, Value)> = Vec::new();
+    let uniforme = m.param("uniform_scale").and_then(|p| p.value.as_bool()).unwrap_or(true);
+    for nombre in ["scale", "scale_width"] {
+        if nombre == "scale_width" && uniforme {
+            continue;
+        }
+        match m.param(nombre) {
+            Some(prm) if prm.is_animated() => return,
+            Some(prm) => {
+                if let ParamValue::Float(v) = prm.value
+                    && v.is_finite()
+                {
+                    cambios.push((nombre, json!(v * k)));
+                }
+            }
+            None => cambios.push((nombre, json!(100.0 * k))),
+        }
+    }
+    if let Some(prm) = m.param("anchor")
+        && !prm.is_animated()
+        && let ParamValue::Vec2(a) = &prm.value
+        && a.x.is_finite()
+        && a.y.is_finite()
+    {
+        cambios.push(("anchor", json!([a.x * f64::from(w1) / f64::from(w0), a.y * f64::from(h1) / f64::from(h0)])));
+    }
+    for (param, valor) in cambios {
+        let _ = app.session.execute("effects.setParam", json!({"clip": clip.0, "effect": "motion", "param": param, "value": valor}));
+    }
+}
+
+/// Importa lo recibido (`rutas`; el primero es el que se coloca) y lo coloca según `destino` →
+/// el aviso de éxito.
+fn colocar(app: &mut FilmcraftApp, rutas: &[PathBuf], destino: Destino) -> Result<String, String> {
+    let ruta = rutas.first().ok_or("No llegó ningún archivo.")?;
+    let textos: Vec<String> = rutas.iter().map(|r| r.to_string_lossy().into_owned()).collect();
+    let v = app.session.execute("file.import", json!({"paths": textos})).map_err(|e| format!("No se pudo importar lo recibido: {e}"))?;
+    if let Some(err) = v.pointer("/errors/0").and_then(Value::as_str) {
+        return Err(format!("No se pudo importar lo recibido: {err}"));
+    }
+    let id = v.pointer("/items/0").and_then(Value::as_u64).ok_or("No se pudo importar lo recibido.")?;
+    let otras = v.get("items").and_then(Value::as_array).map_or(0, |a| a.len().saturating_sub(1));
+    let mut guardado = format!("Se guardó en {}.", ruta.parent().map_or_else(String::new, |p| p.display().to_string()));
+    if otras > 0 {
+        guardado = format!("{guardado} La otra versión quedó en el proyecto.");
+    }
+    let sec = secuencia(app);
+    match destino {
+        Destino::Reemplazo { secuencia: s, clip, item } => {
+            let sigue = sec == Some(s) && app.session.project.sequence(s).is_some_and(|q| q.find_item(clip).is_some());
+            if !sigue {
+                return Ok(format!("Listo: tu clip mejorado está en el proyecto (el original ya no está en la secuencia abierta). {guardado}"));
+            }
+            app.session
+                .execute("clip.replaceFromBin", json!({"item": id, "clips": [clip.0], "keepSourceIn": true}))
+                .map_err(|e| format!("El clip mejorado se importó, pero no se pudo reemplazar: {e}"))?;
+            conservar_tamano(app, s, clip, item, ItemId(id));
+            return Ok(format!("Listo: el clip se reemplazó por su versión mejorada (Ctrl+Z lo deshace). {guardado}"));
+        }
+        Destino::Audio { en } => {
+            if sec.is_none() {
+                return Ok(format!("Listo: tu audio está en el proyecto; arrástralo a una secuencia. {guardado}"));
+            }
+            let dura = media_de(app, ItemId(id)).map_or(Tick(0), filmcraft_project::MediaClip::duration);
+            let pista = pista_de_audio_libre(app, en, dura).map_or_else(|| json!("new"), |p| json!(p.0));
+            app.session
+                .execute("timeline.place", json!({"item": id, "time": en.0, "video": false, "audioTrack": pista}))
+                .map_err(|e| format!("El audio se importó, pero no se pudo colocar: {e}"))?;
+            return Ok(format!("Listo: tu audio está en la línea de tiempo, en el cabezal (Ctrl+Z lo deshace). {guardado}"));
+        }
+        Destino::Cabezal | Destino::Corte { .. } => {}
+    }
+    let Some(sec) = sec else {
+        app.session.execute("file.newSequence", json!({"fromItem": id})).map_err(|e| format!("No se pudo crear la secuencia: {e}"))?;
+        return Ok(format!("Listo: se creó una secuencia con tu video. {guardado}"));
+    };
+    let en_corte = match destino {
+        Destino::Corte { secuencia: s, pista, en } if s == sec && app.session.project.sequence(sec).is_some_and(|q| q.track(pista).is_some()) => {
+            Some((pista, en))
+        }
+        _ => None,
+    };
+    let params = match en_corte {
+        Some((pista, en)) => json!({"item": id, "time": en.0, "insert": true, "track": pista.0}),
+        None => json!({"item": id, "time": punto_libre(app).0, "insert": true}),
+    };
+    app.session.execute("timeline.place", params).map_err(|e| format!("El video se importó, pero no se pudo colocar: {e}"))?;
+    let donde = if en_corte.is_some() { "en el corte" } else { "en la línea de tiempo" };
+    Ok(format!("Listo: tu video está {donde} (Ctrl+Z lo deshace). {guardado}"))
+}
+
+/// Atiende la red (cada cuadro, con la ventana abierta o no).
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    if let Some(rx) = app.jacnex_ia.info_rx.as_ref() {
+        match rx.try_recv() {
+            Ok(r) => {
+                app.jacnex_ia.info_rx = None;
+                match r {
+                    Ok(i) => {
+                        app.jacnex_ia.info = Some(i);
+                        app.jacnex_ia.info_error = None;
+                    }
+                    Err(e) => app.jacnex_ia.info_error = Some(e),
+                }
+            }
+            Err(TryRecvError::Empty) => ctx.request_repaint_after(Duration::from_millis(250)),
+            Err(TryRecvError::Disconnected) => app.jacnex_ia.info_rx = None,
+        }
+    }
+    actualizar_trabajo(app, ctx);
+    crate::jacnex_edicion::actualizar(app, ctx);
+    crate::jacnex_vertical::actualizar(app, ctx); // Jacnex
+    crate::jacnex_buscar::actualizar(app, ctx);
+    crate::jacnex_corta::actualizar(app, ctx);
+    crate::jacnex_doblaje::actualizar(app, ctx);
+}
+
+fn actualizar_trabajo(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    // No mientras un diálogo está abierto: el clip se coloca al cerrarlo.
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return };
+    let mut fin: Option<Result<Vec<PathBuf>, String>> = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Evento::Etapa(s)) => t.etapa = s,
+            Ok(Evento::Cobrado { saldo }) => {
+                if let (Some(i), Some(s)) = (app.jacnex_ia.info.as_mut(), saldo) {
+                    i.creditos = s;
+                }
+            }
+            Ok(Evento::Listo(ruta)) => fin = Some(Ok(ruta)),
+            Ok(Evento::Error(e)) => fin = Some(Err(e)),
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin.get_or_insert_with(|| Err("La generación se interrumpió.".into()));
+                break;
+            }
+        }
+        if fin.is_some() {
+            break;
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(500));
+        return;
+    };
+    if esperar && let Ok(ruta) = &fin {
+        // Vuelve a intentarlo en el próximo cuadro, con el resultado guardado.
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(Evento::Listo(ruta.clone()));
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    let destino = t.destino;
+    app.jacnex_ia.trabajo = None;
+    let aviso = match fin.and_then(|ruta| colocar(app, &ruta, destino)) {
+        Ok(m) => (true, m),
+        Err(m) => (false, m),
+    };
+    app.jacnex_ia.aviso = Some(aviso);
+    pedir_info(&mut app.jacnex_ia);
+    ctx.request_repaint();
+}
+
+/// Abre o cierra la ventana «IA de Jacnex» (Clip › IA de Jacnex…).
+pub fn alternar(app: &mut FilmcraftApp) {
+    let e = &mut app.jacnex_ia;
+    e.abierta = !e.abierta;
+    if e.abierta {
+        pedir_info(e);
+    }
+}
