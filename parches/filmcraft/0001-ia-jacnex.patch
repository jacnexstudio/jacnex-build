+}
+
+#[test]
+fn the_hook_option_is_on_by_default_and_changes_what_is_asked() {
+    let mut c = Corta::default();
+    assert!(c.con_gancho());
+    c.sin_gancho = true;
+    assert!(!c.con_gancho());
+    let mut app = app_con_voz(8);
