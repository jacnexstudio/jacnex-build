+/// Jacnex: el pie de «Vertical» en esta computadora: avance, «Detener» o el botón.
+fn pie_vertical(ui: &mut egui::Ui, e: &mut Estado, cx: &Contexto, t: &crate::theme::Tokens, pide: &mut Pedidos) {
+    let ancho = ui.available_width();
+    let v = &mut e.vertical;
+    if let Some((texto, avance)) = v.progreso() {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{texto}  {} s", v.segundos())).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_height(6.0).fill(ACENTO));
+        }
+        ui.horizontal(|ui| {
+            ui.label(RichText::new("Puedes seguir editando.").small().color(t.text_dim));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.small_button("Detener").clicked() {
+                    v.detener();
+                }
+            });
+        });
+    } else {
+        if boton_acento(ui, e.modo.accion(), egui::vec2(ancho, 36.0), cx.falta.is_none()).clicked() {
+            pide.vertical = true;
+        }
+        if let Some(f) = cx.falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    if let Some((ok, m)) = &e.vertical.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
