+/// Saves a few frames with the crop drawn on them.
+fn annotate(s: &Session, r: &ReframeResult, dir: &std::path::Path) {
+    let Some(p) = r.plans.first() else { return };
+    let it = s.active_sequence().unwrap().video_tracks[0].items[0].clone();
+    let src = s.source(it.item).unwrap();
+    let (cw, _) = r.aspect.crop(p.size.0 as f32, p.size.1 as f32);
+    let dur = it.duration.seconds();
+    for n in 0..8 {
+        let t = dur * (n as f64 + 0.5) / 8.0;
+        let Some(sh) = p.shots.iter().find(|x| t >= x.start && t < x.end) else { continue };
+        let i = sh.keys.partition_point(|k| f64::from(k.t as f32) <= t).saturating_sub(1);
+        let (a, b) = (sh.keys[i], sh.keys[(i + 1).min(sh.keys.len() - 1)]);
+        let f = if b.t > a.t { ((t - a.t) / (b.t - a.t)).clamp(0.0, 1.0) as f32 } else { 0.0 };
+        let cx = a.cx + (b.cx - a.cx) * f;
+        let fr = src.video_frame(filmcraft_media::FrameRequest { time: it.source_time_at(it.start + Tick::from_seconds_f64(t)), scale: 0.25 }).unwrap();
+        let mut px = fr.to_rgba8();
+        let (w, h) = (fr.width as usize, fr.height as usize);
+        let (x0, x1) = (((cx - cw / 2.0) * w as f32) as usize, ((cx + cw / 2.0) * w as f32) as usize);
+        for y in 0..h {
+            for x in 0..w {
+                if x < x0 || x >= x1.min(w) {
+                    for c in 0..3 {
+                        px[(y * w + x) * 4 + c] /= 3;
+                    }
+                }
+            }
+        }
+        image::save_buffer(dir.join(format!("frame{n}.png")), &px, w as u32, h as u32, image::ColorType::Rgba8).unwrap();
+    }
+}
