+    "uno",
+    "unos",
+    "y",
+    "ya",
+    "yo",
+    "escena",
+    "escenas",
+    "video",
+    "videos",
+    "clip",
+    "clips",
+    "muestra",
+    "muestran",
+    "the",
+    "of",
+    "and",
+    "to",
+    "in",
