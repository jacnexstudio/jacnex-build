+/// A separator for the tests: the background is a steady 0.1 and the voice a steady 0.3.
+struct Falso;
+
+impl dub::Separator for Falso {
+    fn available(&self) -> bool {
+        true
+    }
+    fn separate(&self, x: &[f32], sr: u32, ch: u16, _: &AtomicBool, progress: &mut dyn FnMut(f32)) -> filmcraft_engine::Result<dub::Stems> {
+        progress(0.5);
+        Ok(dub::Stems { sample_rate: sr, channels: ch, voice: vec![0.3; x.len()], background: vec![0.1; x.len()] })
+    }
+}
+
+/// Stops the job in the middle of separating, like a click on «Detener».
+struct Parador;
+
+impl dub::Separator for Parador {
+    fn available(&self) -> bool {
+        true
+    }
+    fn separate(&self, _: &[f32], _: u32, _: u16, stop: &AtomicBool, _: &mut dyn FnMut(f32)) -> filmcraft_engine::Result<dub::Stems> {
+        stop.store(true, Ordering::Relaxed);
+        Err(filmcraft_engine::EngineError::Other("stopped".into()))
+    }
+}
+
+/// Garbage from a separator: a different length than what was sent.
+struct Corto;
+
+impl dub::Separator for Corto {
+    fn available(&self) -> bool {
+        true
+    }
+    fn separate(&self, _: &[f32], sr: u32, ch: u16, _: &AtomicBool, _: &mut dyn FnMut(f32)) -> filmcraft_engine::Result<dub::Stems> {
+        Ok(dub::Stems { sample_rate: sr, channels: ch, voice: vec![0.0; 10], background: vec![0.1; 10] })
+    }
+}
+
+static FALSO: Falso = Falso;
+static PARADOR: Parador = Parador;
+static CORTO: Corto = Corto;
