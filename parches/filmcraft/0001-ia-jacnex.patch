+/// The detectors, when this build has them.
+#[cfg(feature = "whisper")]
+mod nets {
+    use std::path::Path;
+
+    use filmcraft_reframe::lightasd::{self, LightAsd};
+    use filmcraft_reframe::rtdetr::{self, RtDetr};
+    use filmcraft_reframe::track::{Det, Kind};
+    use filmcraft_reframe::yunet::{self, YuNet};
+    use filmcraft_reframe::{Image, PERSON, Rect};
+
+    pub use filmcraft_reframe::lightasd::CROP;
+    /// Seconds of video the speaker detector scores in one go.
+    pub const ASD_CHUNK_SECONDS: f64 = 2.0;
+
+    pub struct Nets {
+        yunet: YuNet,
+        det: RtDetr,
+        asd: LightAsd,
+    }
+
+    fn has(dir: &Path, id: &str, files: &[&str]) -> bool {
+        files.iter().all(|f| std::fs::metadata(dir.join(id).join(f)).is_ok_and(|m| m.is_file()))
+    }
+
+    fn detector(dir: &Path) -> Option<&'static str> {
+        [rtdetr::MODEL_ID_R18].into_iter().find(|id| has(dir, id, &["model.safetensors", "config.json"]))
+    }
+
+    pub fn present(dir: &Path) -> bool {
+        has(dir, yunet::MODEL_ID, &[yunet::FILE]) && has(dir, lightasd::MODEL_ID, &[lightasd::FILE]) && detector(dir).is_some()
+    }
+
+    pub fn load(dir: &Path) -> Result<Nets, String> {
+        let id = detector(dir).filter(|_| present(dir)).ok_or_else(|| super::FALTA_MODELO.to_string())?;
+        let e = |e: filmcraft_reframe::ReframeError| e.to_string();
+        Ok(Nets {
+            yunet: YuNet::load(&dir.join(yunet::MODEL_ID)).map_err(e)?,
+            det: RtDetr::load(&dir.join(id)).map_err(e)?,
+            asd: LightAsd::load(&dir.join(lightasd::MODEL_ID)).map_err(e)?,
+        })
+    }
+
+    impl Nets {
+        /// The faces.
+        pub fn faces(&self, img: &Image) -> Result<Vec<Det>, String> {
+            let faces = self.yunet.detect(img, yunet::DEFAULT_SIDE, 0.6).map_err(|e| e.to_string())?;
+            Ok(faces.iter().map(|f| Det { rect: f.rect, score: f.score, kind: Kind::Face }).collect())
+        }
+
+        /// People; when there are none, the biggest things.
+        pub fn people(&self, img: &Image) -> Result<Vec<Det>, String> {
+            let objs = self.det.detect(img, rtdetr::DEFAULT_SIDE, 0.4).map_err(|e| e.to_string())?;
+            let people: Vec<Det> = objs.iter().filter(|o| o.class == PERSON).map(|o| Det { rect: o.rect, score: o.score, kind: Kind::Person }).collect();
+            if !people.is_empty() {
+                return Ok(people);
+            }
+            let mut things: Vec<Det> = objs.iter().map(|o| Det { rect: o.rect, score: o.score, kind: Kind::Object }).collect();
+            things.sort_by(|a, b| (b.rect.area() * b.score).partial_cmp(&(a.rect.area() * a.score)).unwrap_or(std::cmp::Ordering::Equal));
+            things.truncate(3);
+            Ok(things)
+        }
+
+        /// Speaking scores of one face over `frames` frames (crops are 112x112 gray, back to back).
+        pub fn speak(&self, crops: &[f32], mfcc: &[f32], frames: usize) -> Result<Vec<f32>, String> {
+            self.asd.score(crops, mfcc, frames).map_err(|e| e.to_string())
+        }
+    }
+
+    /// The 112x112 gray crop around a face the speaker detector looks at (face box, extended down
+    /// to take in the mouth and chin).
+    pub fn face_crop(img: &Image, r: &Rect) -> Vec<f32> {
+        let (w, h) = (img.w as f32, img.h as f32);
+        let bs = (r.w() * w).max(r.h() * h).max(8.0) / 2.0;
+        let (cx, cy) = (r.cx() * w, r.cy() * h + 0.4 * bs);
+        let side = 1.4 * bs;
+        let n = CROP;
+        let px = |x: f32, y: f32| -> f32 {
+            let (x, y) = (x.clamp(0.0, w - 1.0), y.clamp(0.0, h - 1.0));
+            let i = (y as usize * img.w + x as usize) * 4;
+            match img.rgba.get(i..i + 3) {
+                Some(p) => 0.299 * p[0] as f32 + 0.587 * p[1] as f32 + 0.114 * p[2] as f32,
+                None => 0.0,
+            }
+        };
+        let mut out = Vec::with_capacity(n * n);
+        let step = side / n as f32;
+        for j in 0..n {
+            for i in 0..n {
+                let (x, y) = (cx - side / 2.0 + i as f32 * step, cy - side / 2.0 + j as f32 * step);
+                out.push(
+                    0.25 * (px(x + 0.25 * step, y + 0.25 * step)
+                        + px(x + 0.75 * step, y + 0.25 * step)
+                        + px(x + 0.25 * step, y + 0.75 * step)
+                        + px(x + 0.75 * step, y + 0.75 * step)),
+                );
+            }
+        }
+        out
+    }
+}
