+#[cfg(not(target_arch = "wasm32"))]
+mod red {
+    use super::{Conexion, Envio, Evento, Info, es_local};
+    use std::sync::mpsc::Sender;
+    use std::time::{Duration, Instant};
+
+    const LIMITE_JSON: u64 = 1024 * 1024;
+    /// Lo más que se espera un video.
+    pub(super) const ESPERA: Duration = Duration::from_secs(15 * 60);
+
+    fn agente(segundos: u64, https: bool) -> ureq::Agent {
+        let proveedor = std::sync::Arc::new(rustls_rustcrypto::provider());
+        ureq::Agent::config_builder()
+            .tls_config(
+                ureq::tls::TlsConfig::builder()
+                    .provider(ureq::tls::TlsProvider::Rustls)
+                    .root_certs(ureq::tls::RootCerts::PlatformVerifier)
+                    .unversioned_rustls_crypto_provider(proveedor)
+                    .build(),
+            )
+            .https_only(https)
+            .timeout_global(Some(Duration::from_secs(segundos)))
+            .http_status_as_error(false)
+            .user_agent("Filmnex")
+            .build()
+            .new_agent()
+    }
+
+    pub(super) fn agente_para(c: &Conexion, segundos: u64) -> ureq::Agent {
+        agente(segundos, !es_local(&c.servidor))
+    }
+
+    /// El cuerpo JSON de una respuesta; los errores del servidor (`{error:{message}}`) como texto.
+    pub(super) fn json(r: Result<ureq::http::Response<ureq::Body>, ureq::Error>) -> Result<serde_json::Value, String> {
+        let mut r = r.map_err(|e| format!("No se pudo conectar con Jacnex: {e}"))?;
+        let estado = r.status().as_u16();
+        let texto = r.body_mut().with_config().limit(LIMITE_JSON).read_to_string().map_err(|e| format!("Respuesta incompleta: {e}"))?;
+        let v: serde_json::Value = serde_json::from_str(&texto).unwrap_or(serde_json::Value::Null);
+        if (200..300).contains(&estado) {
+            return Ok(v);
+        }
+        let msg = v.pointer("/error/message").and_then(|m| m.as_str()).or_else(|| v.get("error").and_then(|m| m.as_str())).map(str::to_string);
+        Err(match (estado, msg) {
+            (401, _) => "Tu sesión de Jacnex venció. Vuelve a iniciar sesión en Jacnex Studio.".into(),
+            (_, Some(m)) => m,
+            (404, None) => "El servidor de Jacnex aún no tiene esta función. Inténtalo más tarde.".into(),
+            _ => format!("El servidor respondió {estado}."),
+        })
+    }
+
+    pub fn info(c: &Conexion) -> Result<Info, String> {
+        let url = format!("{}/v1/jacnex/estado", c.servidor);
+        let v = json(agente_para(c, 20).get(&url).header("Authorization", &format!("Bearer {}", c.llave)).call())?;
+        Ok(super::leer_info(&v))
+    }
+
+    /// Un cuerpo multipart/form-data: campos de texto y, después, los archivos `(campo, archivo)`.
+    pub(super) fn multipart(campos: &[(&str, String)], archivos: &[(&str, &super::Imagen)]) -> (String, Vec<u8>) {
+        let semilla = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos());
+        let limite = format!("----filmnex{semilla:x}");
+        let mut b = Vec::new();
+        for (k, v) in campos {
+            b.extend_from_slice(format!("--{limite}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n").as_bytes());
+        }
+        for (campo, (nombre, tipo, datos)) in archivos {
+            let nombre: String = nombre.chars().filter(|c| !matches!(c, '"' | '\r' | '\n' | '\\')).collect();
+            b.extend_from_slice(
+                format!("--{limite}\r\nContent-Disposition: form-data; name=\"{campo}\"; filename=\"{nombre}\"\r\nContent-Type: {tipo}\r\n\r\n").as_bytes(),
+            );
+            b.extend_from_slice(datos);
+            b.extend_from_slice(b"\r\n");
+        }
+        b.extend_from_slice(format!("--{limite}--\r\n").as_bytes());
+        (format!("multipart/form-data; boundary={limite}"), b)
+    }
+
+    /// El clip que se mejora, leído del disco (con su límite de tamaño).
+    fn leer_video(ruta: &std::path::Path, tipo: &'static str) -> Result<super::Imagen, String> {
+        let pesa = std::fs::metadata(ruta).map_err(|e| format!("No se pudo leer el clip: {e}"))?.len();
+        if pesa > super::MAX_MEJORA {
+            return Err("El clip pesa más de 50 MB: recórtalo o expórtalo más liviano.".into());
+        }
+        let datos = std::fs::read(ruta).map_err(|e| format!("No se pudo leer el clip: {e}"))?;
+        let nombre = ruta.file_name().map_or_else(|| "clip.mp4".to_string(), |n| n.to_string_lossy().into_owned());
+        Ok((nombre, tipo, datos))
+    }
+
+    /// Crea el trabajo de `e`, espera su resultado, lo descarga y lo guarda. Devuelve lo recibido
+    /// (la música trae 2 versiones; el resto, una).
+    pub fn generar(c: &Conexion, e: Envio, tx: &Sender<Evento>) -> Result<Vec<std::path::PathBuf>, String> {
+        let auth = format!("Bearer {}", c.llave);
+        let _ = tx.send(Evento::Etapa("Enviando tu pedido…"));
+        let mut campos = vec![("model", e.modelo), ("prompt", e.prompt), ("n", "1".to_string())];
+        campos.extend(e.campos);
+        let video = match &e.video {
+            Some((ruta, tipo)) => Some(leer_video(ruta, tipo)?),
+            None => None,
+        };
+        let mut archivos: Vec<(&str, &super::Imagen)> = e.imagenes.iter().map(|i| ("image", i)).collect();
+        if let Some(v) = &video {
+            archivos.push(("video", v));
+        }
+        let (tipo, cuerpo) = multipart(&campos, &archivos);
+        drop(video);
+        let url = format!("{}/v1/jacnex/generar", c.servidor);
+        let v = json(agente_para(c, 180).post(&url).header("Authorization", &auth).header("Content-Type", &tipo).send(&cuerpo[..]))?;
+        let id = v
+            .get("id")
+            .and_then(|x| x.as_str())
+            .or_else(|| v.pointer("/ids/0").and_then(|x| x.as_str()))
+            .map(str::to_string)
+            .ok_or_else(|| "El servidor no devolvió el trabajo.".to_string())?;
+        let _ = tx.send(Evento::Cobrado { saldo: v.get("saldo").and_then(|x| x.as_i64()) });
+        let _ = tx.send(Evento::Etapa(e.etapas.0));
+        let inicio = Instant::now();
+        let resultados: Vec<String> = loop {
+            std::thread::sleep(Duration::from_millis(2000));
+            if inicio.elapsed() > ESPERA {
+                return Err("La IA tardó demasiado. Si el resultado no llega, tus créditos se devuelven solos.".into());
+            }
+            let consulta = format!("{}/v1/jacnex/trabajo/{id}", c.servidor);
+            let v = match json(agente_para(c, 30).get(&consulta).header("Authorization", &auth).call()) {
+                Ok(v) => v,
+                // Un corte de red momentáneo no pierde el trabajo: se vuelve a consultar.
+                Err(m) if m.starts_with("No se pudo conectar") => continue,
+                Err(m) => return Err(m),
+            };
+            match v.get("estado").and_then(|x| x.as_str()) {
+                Some("listo") => {
+                    let lista: Vec<String> = v
+                        .get("resultados")
+                        .and_then(|x| x.as_array())
+                        .map(|a| a.iter().filter_map(|u| u.as_str()).filter(|u| !u.is_empty()).take(super::MAX_RESULTADOS).map(str::to_string).collect())
+                        .unwrap_or_default();
+                    if lista.is_empty() {
+                        return Err("La IA no devolvió ningún resultado. Tus créditos fueron devueltos.".into());
+                    }
+                    break lista;
+                }
+                Some("fallido") => {
+                    let m = v.get("error").and_then(|x| x.as_str()).unwrap_or("La IA no pudo completarlo.");
+                    return Err(format!("{m} Tus créditos fueron devueltos."));
+                }
+                _ => {}
+            }
+        };
+        let _ = tx.send(Evento::Etapa(e.etapas.1));
+        let mut rutas = Vec::new();
+        for (i, url) in resultados.iter().enumerate() {
+            // El primero tiene que llegar; una versión extra que falla no estropea lo recibido.
+            let r = descargar(c, url, &auth, super::MAX_VIDEO).and_then(|bytes| super::guardar(&e.carpeta, &bytes));
+            match r {
+                Ok(ruta) => rutas.push(ruta),
+                Err(m) if i == 0 => return Err(m),
+                Err(_) => {}
+            }
+        }
+        Ok(rutas)
+    }
+
+    /// Lo más que se lee del JSON con las palabras de una transcripción.
+    const MAX_TRANSCRIPCION: u64 = 32 * 1024 * 1024;
+
+    /// Envía un WAV a transcribir con `modelo`, espera y devuelve el JSON con las palabras.
+    /// `seguir` se consulta a menudo: si responde false se deja de esperar.
+    pub fn transcribir(c: &Conexion, modelo: &str, wav: &super::Imagen, seguir: &mut dyn FnMut(f32) -> bool) -> Result<serde_json::Value, String> {
+        trabajo_json(c, &[("model", modelo.to_string()), ("n", "1".to_string())], &[("audio", wav)], seguir, ("La transcripción", "No se pudo transcribir."))
+    }
+
+    /// Jacnex: «Versión corta»: manda la indicación y el texto con tiempos y devuelve el JSON
+    /// `{titulo, tramos, creditos}`. `seguir` se consulta a menudo: si responde false se deja de esperar.
+    pub fn corta(
+        c: &Conexion,
+        indicacion: &str,
+        contexto: &str,
+        segundos: f64,
+        objetivo: u32,
+        gancho: bool,
+        seguir: &mut dyn FnMut(f32) -> bool,
+    ) -> Result<serde_json::Value, String> {
+        let campos = [
+            ("model", super::MODELO_CORTA.to_string()),
+            ("n", "1".to_string()),
+            ("prompt", indicacion.chars().take(300).collect()),
+            ("context", contexto.to_string()),
+            ("duration", format!("{segundos:.2}")),
+            ("target", objetivo.to_string()),
+            ("hook", if gancho { "1" } else { "0" }.to_string()),
+        ];
+        trabajo_json(c, &campos, &[], seguir, ("La versión corta", "No se pudo armar la versión corta."))
+    }
+
+    /// Jacnex: «Buscar con IA»: manda la búsqueda, el texto con tiempos y las hojas de imágenes (como mucho 10) y
+    /// devuelve el JSON `{momentos, creditos}`. `seguir` se consulta a menudo: si responde false se deja de esperar.
+    pub fn buscar(
+        c: &Conexion,
+        consulta: &str,
+        contexto: &str,
+        segundos: f64,
+        hojas: &[super::Imagen],
+        seguir: &mut dyn FnMut(f32) -> bool,
+    ) -> Result<serde_json::Value, String> {
+        let campos = [
+            ("model", super::MODELO_BUSQUEDA.to_string()),
+            ("n", "1".to_string()),
+            ("prompt", consulta.chars().take(400).collect()),
+            ("context", contexto.to_string()),
+            ("duration", format!("{segundos:.2}")),
+        ];
+        let archivos: Vec<(&str, &super::Imagen)> = hojas.iter().map(|h| ("image", h)).collect();
+        trabajo_json(c, &campos, &archivos, seguir, ("La búsqueda", "No se pudo buscar."))
+    }
+
+    /// Crea un trabajo con `campos` y `archivos`, espera su resultado (un JSON) y lo descarga. `textos`: cómo se
+    /// llama lo que se pidió («La transcripción») y el mensaje si el servidor no explica el fallo.
+    fn trabajo_json(
+        c: &Conexion,
+        campos: &[(&str, String)],
+        archivos: &[(&str, &super::Imagen)],
+        seguir: &mut dyn FnMut(f32) -> bool,
+        (nombre, fallo): (&str, &str),
+    ) -> Result<serde_json::Value, String> {
+        let auth = format!("Bearer {}", c.llave);
+        let (tipo, cuerpo) = multipart(campos, archivos);
+        let url = format!("{}/v1/jacnex/generar", c.servidor);
+        let v = json(agente_para(c, 300).post(&url).header("Authorization", &auth).header("Content-Type", &tipo).send(&cuerpo[..]))?;
+        drop(cuerpo);
+        let id = v
+            .get("id")
+            .and_then(|x| x.as_str())
+            .or_else(|| v.pointer("/ids/0").and_then(|x| x.as_str()))
+            .filter(|id| !id.is_empty() && id.len() <= 128 && id.chars().all(|c| c.is_ascii_alphanumeric() || c == '-' || c == '_'))
+            .map(str::to_string)
+            .ok_or_else(|| "El servidor no devolvió el trabajo.".to_string())?;
+        let inicio = Instant::now();
+        let mut vuelta = 0u32;
+        let url = loop {
+            // Se espera en pasos cortos para que «Detener» responda enseguida.
+            for _ in 0..8 {
+                std::thread::sleep(Duration::from_millis(250));
+                if !seguir(1.0 - 1.0 / (1.0 + inicio.elapsed().as_secs_f32() / 30.0)) {
+                    return Err(crate::jacnex_nemotron::DETENIDO.into());
+                }
+            }
+            vuelta += 1;
+            if inicio.elapsed() > ESPERA {
+                return Err(format!("{nombre} tardó demasiado. Si no llega, tus créditos se devuelven solos."));
+            }
+            let consulta = format!("{}/v1/jacnex/trabajo/{id}", c.servidor);
+            let v = match json(agente_para(c, 30).get(&consulta).header("Authorization", &auth).call()) {
+                Ok(v) => v,
+                Err(m) if m.starts_with("No se pudo conectar") && vuelta < 1000 => continue,
+                Err(m) => return Err(m),
+            };
+            match v.get("estado").and_then(|x| x.as_str()) {
+                Some("listo") => {
+                    let url = v.pointer("/resultados/0").and_then(|u| u.as_str()).filter(|u| !u.is_empty()).map(str::to_string);
+                    break url.ok_or_else(|| format!("{nombre} llegó vacía. Tus créditos fueron devueltos."))?;
+                }
+                Some("fallido") => {
+                    let m = v.get("error").and_then(|x| x.as_str()).unwrap_or(fallo);
+                    return Err(format!("{m} Tus créditos fueron devueltos."));
+                }
+                _ => {}
+            }
+        };
+        let bytes = descargar(c, &url, &auth, MAX_TRANSCRIPCION)?;
+        let v = serde_json::from_slice(&bytes).map_err(|_| format!("{nombre} llegó dañada."))?;
+        Ok(v)
+    }
+
+    pub(super) fn descargar(c: &Conexion, url: &str, auth: &str, limite: u64) -> Result<Vec<u8>, String> {
+        let local = es_local(url) && es_local(&c.servidor);
+        if !local && !url.starts_with("https://") {
+            return Err("La dirección del resultado no es segura.".into());
+        }
+        // La llave solo viaja a Jacnex: los resultados alojados en otro sitio se piden sin ella.
+        let mut pedido = agente(600, !local).get(url);
+        if url.starts_with(&format!("{}/", c.servidor)) {
+            pedido = pedido.header("Authorization", auth);
+        }
+        let mut r = pedido.call().map_err(|e| format!("No se pudo descargar el resultado: {e}"))?;
+        if !r.status().is_success() {
+            return Err(format!("No se pudo descargar el resultado ({}).", r.status().as_u16()));
+        }
+        r.body_mut().with_config().limit(limite).read_to_vec().map_err(|e| format!("Descarga incompleta: {e}"))
+    }
+}
