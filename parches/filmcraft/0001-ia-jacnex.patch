+/// El pie de las herramientas de «Editar»: el avance de la transcripción, la pregunta por la
+/// descarga del modelo o el botón.
+fn pie_edicion(ui: &mut egui::Ui, e: &mut Estado, d: crate::jacnex_edicion::Despues, cx: &Contexto, t: &crate::theme::Tokens, pide: &mut Pedidos) {
+    let ancho = ui.available_width();
+    let ed = &mut e.edicion;
+    if let Some((texto, avance)) = ed.progreso() {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{texto}  {} s", ed.segundos())).strong());
+        });
+        if let Some(f) = avance {
+            ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_height(6.0).fill(ACENTO));
+        }
+        ui.horizontal(|ui| {
+            ui.label(RichText::new(e.modo.espera()).small().color(t.text_dim));
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                if ui.small_button("Detener").clicked() {
+                    ed.detener();
+                }
+            });
+        });
+    } else if let Some((bytes, despues)) = ed.pide_descarga {
+        let mb = bytes.div_ceil(MB).max(1);
+        ui.label(RichText::new(format!("La primera vez se descarga el modelo de voz (unos {mb} MB).")).strong());
+        ui.add_space(4.0);
+        ui.horizontal(|ui| {
+            if boton_acento(ui, &format!("Descargar {mb} MB y seguir"), egui::vec2(ancho - 90.0, 32.0), true).clicked() {
+                pide.editar = Some((despues, true));
+            }
+            if ui.add(egui::Button::new("Cancelar").min_size(egui::vec2(82.0, 32.0))).clicked() {
+                ed.pide_descarga = None;
+            }
+        });
+    } else {
+        if ed.en_nube()
+            && let Some(c) = cx.costo_nube
+        {
+            let texto = format!("Transcribir cuesta {}.", creditos(c));
+            ui.label(RichText::new(texto).small().strong().color(ACENTO_CLARO));
+            ui.add_space(2.0);
+        }
+        if boton_acento(ui, e.modo.accion(), egui::vec2(ancho, 36.0), cx.falta.is_none()).clicked() {
+            pide.editar = Some((d, false));
+        }
+        if let Some(f) = cx.falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    if let Some((ok, m)) = &e.edicion.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
+
+fn pie(ui: &mut egui::Ui, e: &mut Estado, cx: &Contexto, t: &crate::theme::Tokens, pide: &mut Pedidos) {
+    if e.modo == Modo::Buscar {
+        // Jacnex: «Buscar» dibuja su propio pie
+        if let Some(d) = &cx.buscar {
+            crate::jacnex_buscar::pie(ui, &mut e.buscar, d, t);
+        }
+        return;
+    }
+    if e.modo == Modo::Corta {
+        if let Some(d) = &cx.corta {
+            crate::jacnex_corta::pie(ui, &mut e.corta, &mut e.edicion, d, t);
+        }
+        return;
+    }
+    if e.modo == Modo::Doblaje {
+        // Jacnex: «Doblaje» dibuja su propio pie
+        if let Some(d) = &cx.doblaje {
+            crate::jacnex_doblaje::pie(ui, e, d, t);
+        }
+        return;
+    }
+    if let Some(d) = e.modo.local() {
+        pie_edicion(ui, e, d, cx, t, pide);
+        return;
+    }
+    if e.modo == Modo::Vertical && !e.vertical.en_nube() {
+        pie_vertical(ui, e, cx, t, pide);
+        return;
+    }
+    let ancho = ui.available_width();
+    if let Some(tr) = &e.trabajo {
+        ui.horizontal(|ui| {
+            ui.add(egui::Spinner::new().color(ACENTO));
+            ui.label(RichText::new(format!("{}  {} s", tr.etapa, tr.inicio.elapsed().as_secs())).strong());
+        });
+        ui.label(RichText::new(tr.modo.espera()).small().color(t.text_dim));
+    } else {
+        let segundos = cx.mejora.as_ref().and_then(|m| m.as_ref().ok()).map(|c| c.segundos);
+        let costo = e.costo(segundos);
+        if let Some(c) = costo {
+            ui.horizontal(|ui| {
+                ui.label(RichText::new(format!("{} {}", cuesta(e.modo), creditos(c))).small().strong().color(ACENTO_CLARO));
+                if let Some(i) = &e.info {
+                    ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                        if i.creditos >= c {
+                            ui.label(RichText::new(format!("Te quedan {}", miles(i.creditos - c))).small().color(t.text_dim));
+                        } else {
+                            ui.label(RichText::new(format!("Te faltan {}", miles(c - i.creditos))).small().color(ROJO));
+                        }
+                    });
+                }
+            });
+            ui.add_space(2.0);
+        }
+        let texto = match costo {
+            Some(c) => format!("{} · {}", e.modo.accion(), creditos(c)),
+            None => e.modo.accion().to_string(),
+        };
+        if boton_acento(ui, &texto, egui::vec2(ancho, 36.0), cx.falta.is_none()).clicked() {
+            pide.generar = true;
+        }
+        if let Some(f) = cx.falta {
+            ui.label(RichText::new(f).small().color(t.text_dim));
+        }
+    }
+    if let Some((ok, m)) = &e.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
