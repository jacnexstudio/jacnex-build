+//! Real MP3 files through the dub path (decode, mix). The files are made with the workspace's own
+//! MP3 encoder (ffmpeg is not installed here), so they are real MPEG-1/2 Layer III streams.
+//!
+//! - `DUB_MP3_OUT=<dir>`: the generated files are also written there.
+//! - `DUB_MP3_DIR=<dir>`: every `*.mp3` in it is decoded and mixed (and the hostile variants of each
+//!   are tried); the numbers are printed (`--nocapture`).
+
+use filmcraft_mp3enc::{Config, Encoder};
+
+use crate::dub::{self, MAX_MP3_BYTES, Phrase, RATE};
+
+/// A tone that moves in loudness like speech: bursts of `freq` and its harmonics with pauses.
+fn speechlike(secs: f64, sr: u32, freq: f64) -> Vec<f32> {
+    let tau = 2.0 * std::f64::consts::PI;
+    (0..(secs * f64::from(sr)) as usize)
+        .map(|i| {
+            let t = i as f64 / f64::from(sr);
+            let syllable = (0.5 + 0.5 * (tau * 3.5 * t).sin()).powi(2);
+            let v = (tau * freq * t).sin() + 0.5 * (tau * 2.0 * freq * t).sin() + 0.25 * (tau * 3.0 * freq * t).sin();
+            (0.35 * syllable * v) as f32
+        })
+        .collect()
+}
+
+fn noise(secs: f64, sr: u32) -> Vec<f32> {
+    let mut x = 0x1234_5678u32;
+    (0..(secs * f64::from(sr)) as usize)
+        .map(|_| {
+            x ^= x << 13;
+            x ^= x >> 17;
+            x ^= x << 5;
+            (f64::from(x % 20_000) / 10_000.0 - 1.0) as f32 * 0.2
+        })
+        .collect()
+}
+
+fn encode(channels: &[Vec<f32>], sr: u32, kbps: u32) -> Vec<u8> {
+    let mut e = Encoder::new(Config::cbr(sr, channels.len(), kbps)).expect("encoder");
+    let planar: Vec<&[f32]> = channels.iter().map(Vec::as_slice).collect();
+    let mut out = e.encode(&planar);
+    out.extend(e.flush());
+    out
+}
+
+fn hz(x: &[f32]) -> f64 {
+    let n = x.windows(2).filter(|w| w[0] < 0.0 && w[1] >= 0.0).count();
+    n as f64 * f64::from(RATE) / x.len() as f64
+}
+
+fn rms(v: &[f32]) -> f64 {
+    (v.iter().map(|x| f64::from(*x).powi(2)).sum::<f64>() / v.len().max(1) as f64).sqrt()
+}
+
+/// (name, bytes, seconds, tone Hz or 0 for noise)
+fn samples() -> Vec<(String, Vec<u8>, f64, f64)> {
+    let mut v = Vec::new();
+    for (sr, kbps) in [(22_050u32, 64u32), (44_100, 128)] {
+        for ch in [1usize, 2] {
+            let tono = speechlike(2.0, sr, 200.0);
+            let chans: Vec<Vec<f32>> = (0..ch).map(|_| tono.clone()).collect();
+            v.push((format!("voz-{sr}-{ch}ch.mp3"), encode(&chans, sr, kbps), 2.0, 200.0));
+            let r = noise(1.5, sr);
+            let chans: Vec<Vec<f32>> = (0..ch).map(|_| r.clone()).collect();
+            v.push((format!("ruido-{sr}-{ch}ch.mp3"), encode(&chans, sr, kbps), 1.5, 0.0));
+        }
+    }
+    v
+}
+
+#[test]
+fn real_mp3s_decode_to_mono_at_the_dub_rate() {
+    let out = std::env::var_os("DUB_MP3_OUT").map(std::path::PathBuf::from);
+    for (name, bytes, secs, freq) in samples() {
+        if let Some(dir) = &out {
+            let _ = std::fs::create_dir_all(dir);
+            std::fs::write(dir.join(&name), &bytes).expect("write sample");
+        }
+        let pcm = dub::decode_voice(&name, bytes.clone()).unwrap_or_else(|e| panic!("{name}: {e}"));
+        let got = pcm.len() as f64 / f64::from(RATE);
+        assert!((got - secs).abs() < 0.12, "{name}: {got} s, expected {secs}");
+        assert!(pcm.iter().all(|v| v.is_finite() && v.abs() <= 1.0), "{name}");
+        assert!(rms(&pcm) > 0.02, "{name}: silent");
+        if freq > 0.0 {
+            // the speech-like tone has bursts; its fundamental still shows in the zero crossings
+            let f = hz(&pcm);
+            assert!(f > freq * 0.9 && f < freq * 2.2, "{name}: {f} Hz");
+        }
+        println!("{name}: {} bytes -> {:.3} s, rms {:.3}", bytes.len(), got, rms(&pcm));
+        // mixed as the dub does: two phrases, the second one too long for its gap
+        let fr = [Phrase { start: 0.0, end: 1.0, pcm: pcm.clone() }, Phrase { start: 2.4, end: 3.4, pcm }];
+        let (mix, fit) = dub::mix(&fr, 4.0);
+        assert_eq!(mix.len(), 4 * RATE as usize);
+        assert_eq!(fit.placed, 2, "{name}");
+        assert!(mix.iter().all(|v| v.is_finite() && v.abs() <= 1.0));
+    }
+}
+
+#[test]
+fn a_stretched_real_mp3_keeps_its_pitch() {
+    let tono: Vec<f32> = (0..(2.0 * 44_100.0) as usize).map(|i| 0.5 * (2.0 * std::f64::consts::PI * 330.0 * i as f64 / 44_100.0).sin() as f32).collect();
+    let pcm = dub::decode_voice("t.mp3", encode(&[tono], 44_100, 128)).expect("decode");
+    let (out, fit) = dub::mix(&[Phrase { start: 0.0, end: 1.0, pcm }, Phrase { start: 1.7, end: 2.0, pcm: vec![0.1; 100] }], 2.2);
+    assert_eq!(fit.sped_up, 1);
+    let f = hz(&out[RATE as usize / 5..(1.5 * f64::from(RATE)) as usize]);
+    assert!((f - 330.0).abs() / 330.0 < 0.03, "{f}");
+}
+
+/// Hostile variants never panic and never produce more than the limits allow.
+fn hostile(name: &str, bytes: &[u8]) {
+    let mut flipped = bytes.to_vec();
+    for i in (0..flipped.len()).step_by(97) {
+        flipped[i] ^= 0xFF;
+    }
+    let cases: Vec<Vec<u8>> = vec![
+        bytes[..bytes.len() / 2].to_vec(),
+        bytes[..bytes.len().min(417)].to_vec(),
+        bytes[..bytes.len().min(5)].to_vec(),
+        bytes.iter().map(|b| b ^ 0x5A).collect(),
+        [&bytes[..bytes.len() / 3], &[0xFFu8; 3000][..], &bytes[bytes.len() / 3..]].concat(),
+        vec![0u8; 100_000],
+        b"ID3\x04\x00\x00\x7f\x7f\x7f\x7f".repeat(500),
+        flipped,
+    ];
+    for (i, c) in cases.into_iter().enumerate() {
+        let r = std::panic::catch_unwind(|| dub::decode_voice(&format!("{name}-{i}.mp3"), c));
+        match r {
+            Ok(Ok(pcm)) => {
+                assert!(pcm.len() <= (dub::MAX_VOICE_SECONDS * f64::from(RATE)) as usize + RATE as usize, "{name}-{i}: unbounded");
+                assert!(pcm.iter().all(|v| v.is_finite() && v.abs() <= 1.0));
+            }
+            Ok(Err(e)) => assert!(!e.to_string().is_empty()),
+            Err(_) => panic!("{name}-{i}: decode panicked"),
+        }
+    }
+}
+
+#[test]
+fn truncated_or_garbage_mp3s_fail_cleanly() {
+    for (name, bytes, _, _) in samples() {
+        hostile(&name, &bytes);
+    }
+    // a file that is just over the size limit is refused before any decoding
+    assert!(dub::decode_voice("x.mp3", vec![0xFF; MAX_MP3_BYTES + 1]).is_err());
+    // a half-file is either refused with a message or yields only its (bounded) audio
+    let (_, bytes, _, _) = samples().remove(0);
+    let half = bytes[..bytes.len() / 2].to_vec();
+    match dub::decode_voice("mitad.mp3", half) {
+        Ok(p) => assert!(p.len() < (2.0 * f64::from(RATE)) as usize + 4800),
+        Err(e) => println!("half file: {e}"),
+    }
+}
+
+/// Runs when `DUB_MP3_DIR` points to a folder with real mp3 files (for example ones from ffmpeg or from
+/// the real service): they are decoded, checked, mixed, and the hostile variants of each are tried.
+#[test]
+fn mp3_files_from_the_environment() {
+    let Some(dir) = std::env::var_os("DUB_MP3_DIR") else { return };
+    let mut n = 0;
+    for e in std::fs::read_dir(&dir).expect("DUB_MP3_DIR").flatten().take(200) {
+        let p = e.path();
+        if p.extension().and_then(|x| x.to_str()).is_none_or(|x| !x.eq_ignore_ascii_case("mp3")) {
+            continue;
+        }
+        let bytes = std::fs::read(&p).expect("read");
+        if bytes.len() > MAX_MP3_BYTES {
+            continue;
+        }
+        let name = p.file_name().and_then(|s| s.to_str()).unwrap_or("x.mp3").to_string();
+        let pcm = dub::decode_voice(&name, bytes.clone()).unwrap_or_else(|e| panic!("{name}: {e}"));
+        let secs = pcm.len() as f64 / f64::from(RATE);
+        let (mix, fit) = dub::mix(&[Phrase { start: 0.5, end: 0.5 + secs * 0.9, pcm: pcm.clone() }], secs + 1.0);
+        println!("{name}: {} bytes -> {secs:.3} s, rms {:.3}, mixed {} samples, sped_up {}", bytes.len(), rms(&pcm), mix.len(), fit.sped_up);
+        assert!(secs > 0.0 && rms(&pcm) > 0.0, "{name}: silent or empty");
+        hostile(&name, &bytes);
+        n += 1;
+    }
+    println!("{n} mp3 files OK");
+}
