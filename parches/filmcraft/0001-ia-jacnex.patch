+//! Compares RT-DETRv2 with the transformers implementation, dumped by a script (runs only when
+//! `REFRAME_CHECK_DIR` and `REFRAME_RTDETR_DIR` are set; `REFRAME_RTDETR_NAME` is `rtr18` / `rtr50`).
+#![cfg(feature = "candle")]
+
+use std::path::PathBuf;
+
+fn read(p: &std::path::Path) -> Vec<f32> {
+    std::fs::read(p).unwrap().as_chunks::<4>().0.iter().map(|b| f32::from_le_bytes(*b)).collect()
+}
+
+#[test]
+fn rtdetr_matches_transformers() {
+    let (Ok(chk), Ok(dir), Ok(name)) = (std::env::var("REFRAME_CHECK_DIR"), std::env::var("REFRAME_RTDETR_DIR"), std::env::var("REFRAME_RTDETR_NAME")) else {
+        return;
+    };
+    let chk = PathBuf::from(chk);
+    let net = filmcraft_reframe::rtdetr::RtDetr::load(&PathBuf::from(dir)).unwrap();
+    let t = std::time::Instant::now();
+    let raw = net.raw(read(&chk.join(format!("{name}_in.f32"))), 640, 352).unwrap();
+    eprintln!("forward {:?}", t.elapsed());
+    for (what, got, want) in
+        [("logits", &raw.logits, read(&chk.join(format!("{name}_logits.f32")))), ("boxes", &raw.boxes, read(&chk.join(format!("{name}_boxes.f32"))))]
+    {
+        assert_eq!(got.len(), want.len(), "{what}");
+        let err = got.iter().zip(&want).map(|(a, b)| (a - b).abs()).fold(0f32, f32::max);
+        let mag = want.iter().map(|a| a.abs()).fold(0f32, f32::max);
+        eprintln!("{what}: max err {err:e} (max |v| {mag})");
+        assert!(err < 2e-3 * mag.max(1.0), "{what} err {err}");
+    }
+}
