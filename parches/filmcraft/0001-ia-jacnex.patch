+// --- Dibujo -------------------------------------------------------------------------------------
+
+/// «m:ss» (o «h:mm:ss»).
+fn tiempo(segundos: f32) -> String {
+    let s = if segundos.is_finite() { segundos.max(0.0) as u64 } else { 0 };
+    if s >= 3600 { format!("{}:{:02}:{:02}", s / 3600, s / 60 % 60, s % 60) } else { format!("{}:{:02}", s / 60, s % 60) }
+}
+
+fn rango(h: &Hit) -> String {
+    format!("{} – {}", tiempo(h.start), tiempo(h.end.max(h.start)))
+}
+
+/// Por qué coincide un resultado de esta computadora: lo que se dice, entre comillas, o «imagen».
+fn razon(h: &Hit) -> String {
+    let dicho = h.quote.trim();
+    let corto: String = dicho.chars().take(90).collect();
+    let corto = if dicho.chars().count() > 90 { format!("{corto}…") } else { corto };
+    match (h.words || h.meaning, h.image) {
+        (true, true) if !dicho.is_empty() => format!("«{corto}» · imagen"),
+        (true, _) if !dicho.is_empty() => format!("«{corto}»"),
+        (_, true) => "imagen".to_string(),
+        _ => "coincide".to_string(),
+    }
+}
+
+fn texto_progreso(p: Option<SearchProgress>, etapa: &'static str) -> (String, Option<f32>) {
+    let de = |item: usize, of: usize| if of > 1 { format!(" ({} de {})", item + 1, of) } else { String::new() };
+    match p {
+        None => (etapa.to_string(), None),
+        Some(SearchProgress::Speech(_)) => ("Transcribiendo lo que falta…".into(), None),
+        Some(SearchProgress::Loading) => ("Cargando los modelos…".into(), None),
+        Some(SearchProgress::Words { item, of }) => (format!("Leyendo las palabras{}…", de(item, of)), Some(item as f32 / of.max(1) as f32)),
+        Some(SearchProgress::Pictures { item, of, fraction }) => (
+            format!("Mirando las imágenes{}… {:.0} %", de(item, of), fraction.clamp(0.0, 1.0) * 100.0),
+            Some((item as f32 + fraction.clamp(0.0, 1.0)) / of.max(1) as f32),
+        ),
+    }
+}
