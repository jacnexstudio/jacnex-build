+fn pedir_info(e: &mut Estado) {
+    if e.info_rx.is_some() {
+        return;
+    }
+    let c = conexion(e);
+    e.con_sesion = c.is_some();
+    let Some(c) = c else {
+        e.info = None;
+        e.info_error = None;
+        return;
+    };
+    e.info_rx = Some(en_hilo(move |tx| {
+        let _ = tx.send(red::info(&c));
+    }));
+}
