diff --git a/crates/engine/src/dub.rs b/crates/engine/src/dub.rs
new file mode 100644
index 0000000..475e683
--- /dev/null
+++ b/crates/engine/src/dub.rs
@@ -0,0 +1,509 @@
+//! Jacnex: Doblaje (IA de Jacnex › Audio › Doblaje).
+//!
+//! The server translates the speech and voices each phrase (one mp3 per phrase). This module is
+//! the part that lives in the project:
+//! - [`dub_scope`]: the transcribed words to dub (the selected clips, else the whole sequence),
+//!   with the audio clips they are heard through and the time range they cover;
+//! - [`decode_voice`]: an mp3 from the server (hostile input) to mono samples;
+//! - [`mix`]: puts every phrase where its original phrase was, keeping the timing: a phrase that
+//!   is longer than its gap is sped up a little (never more than [`MAX_SPEEDUP`]) and, if it still
+//!   does not fit, trimmed with a short fade;
+//! - [`apply`]: ONE undo step that adds a NEW audio track with the dub, aligned to the range, and
+//!   lowers or mutes the original audio clips (they are not deleted).
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use filmcraft_audio_dsp::stretch::Wsola;
+use filmcraft_edit::transcript::SeqWord;
+use filmcraft_project::{ClipId, ItemId, TrackId, TrackKind};
+use filmcraft_time::{Tick, TimeRange};
+use serde_json::json;
+
+use crate::{EngineError, Result, Session};
+
+/// The sample rate of the dub (what the server's voices are made at).
+pub const RATE: u32 = 24_000;
+/// Most phrases that are mixed.
+pub const MAX_PHRASES: usize = 200;
+/// The biggest mp3 that is decoded.
+pub const MAX_MP3_BYTES: usize = 25 * 1024 * 1024;
+/// The longest voice of one phrase, in seconds.
+pub const MAX_VOICE_SECONDS: f64 = 120.0;
+/// The longest dub, in seconds.
+pub const MAX_TOTAL_SECONDS: f64 = 3600.0;
+/// How much faster than natural a phrase may be played to fit its gap.
+pub const MAX_SPEEDUP: f64 = 1.25;
+/// How much the original audio is lowered ([`Original::Lower`]), in dB.
+pub const LOWER_DB: f64 = -18.0;
+/// The lowest clip gain ([`Original::Mute`]).
+pub const MUTE_DB: f64 = -96.0;
+
+/// What happens to the original audio under the dub.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Original {
+    /// Silent (the clips stay in the timeline).
+    Mute,
+    /// Quiet, as a bed under the dub.
+    Lower,
+}
+
+/// One dubbed phrase: where it goes (seconds from the start of the dub) and its voice.
+#[derive(Clone, Debug, Default)]
+pub struct Phrase {
+    pub start: f64,
+    pub end: f64,
+    /// Mono samples at [`RATE`].
+    pub pcm: Vec<f32>,
+}
+
+/// What [`mix`] had to do.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Fit {
+    pub placed: usize,
+    /// Sped up to fit.
+    pub sped_up: usize,
+    /// Still too long after speeding up: the end was cut.
+    pub trimmed: usize,
+}
+
+/// The words to dub and where they are.
+#[derive(Clone, Debug, Default)]
+pub struct Scope {
+    pub words: Vec<SeqWord>,
+    /// The audio clips the words are heard through (to lower their volume).
+    pub clips: Vec<ClipId>,
+    pub start: Tick,
+    pub seconds: f64,
+}
+
+/// The transcribed words of the selected clips (a video clip counts through its linked audio),
+/// else of the whole sequence.
+pub fn dub_scope(s: &Session) -> Scope {
+    let Some(seq) = s.active_sequence() else { return Scope::default() };
+    let all = crate::transcript::sequence_words(s);
+    let selected = &s.state.selection;
+    let words: Vec<SeqWord> = if selected.is_empty() {
+        all
+    } else {
+        let links: Vec<u64> = selected.iter().filter_map(|c| seq.find_item(*c).and_then(|(_, i)| i.link)).collect();
+        all.into_iter().filter(|w| selected.contains(&w.clip) || seq.find_item(w.clip).and_then(|(_, i)| i.link).is_some_and(|l| links.contains(&l))).collect()
+    };
+    let mut clips: Vec<ClipId> = Vec::new();
+    for w in &words {
+        if !clips.contains(&w.clip) && clips.len() < 4096 {
+            clips.push(w.clip);
+        }
+    }
+    let ranges: Vec<TimeRange> = clips.iter().filter_map(|c| seq.find_item(*c).map(|(_, i)| i.range())).collect();
+    let (Some(start), Some(end)) = (ranges.iter().map(|r| r.start).min(), ranges.iter().map(|r| r.end()).max()) else { return Scope::default() };
+    Scope { words, clips, start, seconds: (end - start).seconds().max(0.0) }
+}
+
+/// An mp3 from the server to mono samples at [`RATE`]. Anything wrong is an error, never a panic.
+pub fn decode_voice(name: &str, bytes: Vec<u8>) -> Result<Vec<f32>> {
+    if bytes.is_empty() || bytes.len() > MAX_MP3_BYTES {
+        return Err(EngineError::Other("the voice file has an invalid size".into()));
+    }
+    let src = filmcraft_codecs::open_bytes(name, Arc::from(bytes))?;
+    let secs = src.info().duration.seconds();
+    if !secs.is_finite() || secs <= 0.0 || secs > MAX_VOICE_SECONDS {
+        return Err(EngineError::Other("the voice has an invalid length".into()));
+    }
+    let total = (secs * f64::from(RATE)).ceil() as usize;
+    let mut out: Vec<f32> = Vec::with_capacity(total);
+    const CHUNK: usize = 48_000;
+    while out.len() < total {
+        let n = CHUNK.min(total - out.len());
+        let buf = src.audio(out.len() as i64, n, RATE)?;
+        let frames = buf.frames();
+        if frames == 0 || buf.channels.is_empty() {
+            break;
+        }
+        let ch = buf.channels.len() as f32;
+        for i in 0..frames {
+            let sum: f32 = buf.channels.iter().map(|c| c.get(i).copied().unwrap_or(0.0)).sum();
+            let v = sum / ch;
+            out.push(if v.is_finite() { v.clamp(-1.0, 1.0) } else { 0.0 });
+        }
+    }
+    if out.is_empty() {
+        return Err(EngineError::Other("the voice has no audio".into()));
+    }
+    Ok(out)
+}
+
+/// Longest phrase (samples) that is time-stretched; a longer one is trimmed instead (bounds the work).
+const MAX_STRETCH: usize = 45 * RATE as usize;
+
+/// `pcm` played faster to last exactly `len` samples (`len <= pcm.len()`) WITHOUT changing its
+/// pitch: WSOLA from [`filmcraft_audio_dsp::stretch`], the same time-stretch as a clip with
+/// "Maintain Audio Pitch". Hostile input is fine: the work is bounded by `pcm.len()` and positions
+/// always land inside it.
+fn stretch_to(pcm: &[f32], len: usize) -> Vec<f32> {
+    if pcm.is_empty() || len == 0 {
+        return Vec::new();
+    }
+    if len >= pcm.len() || pcm.len() > MAX_STRETCH {
+        let mut v = pcm.to_vec();
+        v.truncate(len);
+        return v;
+    }
+    let w = Wsola::new(RATE);
+    let h = w.hop();
+    let speed = pcm.len() as f64 / len as f64;
+    let hops = len.div_ceil(h);
+    let slice = |p: i64| pcm.get(usize::try_from(p.max(0)).unwrap_or(usize::MAX)..).unwrap_or(&[]);
+    let mut out = vec![0.0f32; (hops + 1) * h];
+    let n = h.min(pcm.len());
+    out[..n].copy_from_slice(&pcm[..n]);
+    let mut pos = 0i64;
+    for k in 1..=hops {
+        let nominal = (k as f64 * h as f64 * speed).round() as i64;
+        let cont = pos + h as i64;
+        let next = w.align(pcm, cont, nominal).clamp(0, pcm.len() as i64);
+        w.overlap(slice(cont), slice(next), &mut out[k * h..(k + 1) * h]);
+        pos = next;
+    }
+    out.truncate(len);
+    out
+}
+
+fn fade(buf: &mut [f32], head: usize, tail: usize) {
+    let n = buf.len();
+    for i in 0..head.min(n) {
+        buf[i] *= i as f32 / head as f32;
+    }
+    for i in 0..tail.min(n) {
+        buf[n - 1 - i] *= i as f32 / tail as f32;
+    }
+}
+
+/// Puts every phrase at its time in one mono buffer of `total_secs` (at most [`MAX_TOTAL_SECONDS`]).
+/// A phrase may run into the silence before the next one; if it is longer than that it is sped up
+/// without changing its pitch (time-stretch, at most [`MAX_SPEEDUP`]) and, failing that, trimmed with a 30 ms fade.
+pub fn mix(phrases: &[Phrase], total_secs: f64) -> (Vec<f32>, Fit) {
+    let rate = f64::from(RATE);
+    let total_secs = if total_secs.is_finite() { total_secs.clamp(0.0, MAX_TOTAL_SECONDS) } else { 0.0 };
+    let total = (total_secs * rate).round() as usize;
+    let mut out = vec![0.0f32; total];
+    let mut fit = Fit::default();
+    let mut order: Vec<&Phrase> = phrases.iter().take(MAX_PHRASES).filter(|p| p.start.is_finite() && !p.pcm.is_empty()).collect();
+    order.sort_by(|a, b| a.start.total_cmp(&b.start));
+    let at = |t: f64| ((t.max(0.0) * rate).round() as usize).min(total);
+    for (i, p) in order.iter().enumerate() {
+        let start = at(p.start);
+        let next = order.get(i + 1).map_or(total, |n| at(n.start).max(start));
+        let room = next - start;
+        if room == 0 {
+            continue;
+        }
+        let mut pcm = if p.pcm.len() <= room {
+            p.pcm.clone()
+        } else if p.pcm.len() as f64 / room as f64 <= MAX_SPEEDUP {
+            fit.sped_up += 1;
+            stretch_to(&p.pcm, room)
+        } else {
+            fit.sped_up += 1;
+            fit.trimmed += 1;
+            let mut v = stretch_to(&p.pcm, (p.pcm.len() as f64 / MAX_SPEEDUP).ceil() as usize);
+            v.truncate(room);
+            let tail = (rate * 0.03) as usize;
+            let n = v.len();
+            fade(&mut v[..], 0, tail.min(n));
+            v
+        };
+        let edge = (rate * 0.004) as usize;
+        fade(&mut pcm, edge, edge);
+        for (o, v) in out[start..].iter_mut().zip(&pcm) {
+            *o = (*o + *v).clamp(-1.0, 1.0);
+        }
+        fit.placed += 1;
+    }
+    (out, fit)
+}
+
+/// What the dub puts in the timeline.
+#[derive(Clone, Copy, Debug)]
+pub struct Dub<'a> {
+    /// Where the dub starts (the start of the dubbed range).
+    pub at: Tick,
+    /// The dub: mono at [`RATE`].
+    pub samples: &'a [f32],
+    /// The original without its voice (music, effects), from the local separator. It goes on its own
+    /// track at full level.
+    pub background: Option<Background<'a>>,
+    /// The original audio clips: muted (or lowered) so they do not play under the dub.
+    pub sources: &'a [ClipId],
+    pub original: Original,
+}
+
+/// Interleaved audio at its own rate (the background stem).
+#[derive(Clone, Copy, Debug)]
+pub struct Background<'a> {
+    pub samples: &'a [f32],
+    pub rate: u32,
+    pub channels: u16,
+}
+
+/// What [`apply`] did.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Applied {
+    /// Index of the dub's audio track.
+    pub track: usize,
+    /// Index of the background's audio track, when there is one.
+    pub background_track: Option<usize>,
+    pub lowered: usize,
+}
+
+/// Where a finished dub went.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Placed {
+    /// On new audio tracks of the sequence it was made for (active or not).
+    Track(Applied),
+    /// That sequence no longer exists: the audio (dub, and background if any) is in the bin, as clips
+    /// the user can place.
+    Bin(Vec<ItemId>),
+}
+
+/// ONE undo step: a new audio track with `samples` (mono, at [`RATE`]) starting at `at`, and the
+/// original `sources` lowered or muted (clip gain). Nothing is deleted. If anything fails
+/// everything is rolled back.
+pub fn apply(s: &mut Session, at: Tick, samples: &[f32], sources: &[ClipId], original: Original) -> Result<Applied> {
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    apply_to(s, seq_id, &Dub { at, samples, background: None, sources, original })
+}
+
+/// Like [`apply`] for the sequence `seq_id` even when it is not the active one, so a paid dub is
+/// never lost, and with the background track when there is one. If that sequence was deleted
+/// meanwhile, the audio is imported into the bin instead. ONE undo step either way.
+pub fn place(s: &mut Session, seq_id: ItemId, d: &Dub) -> Result<Placed> {
+    if s.project.sequence(seq_id).is_some() {
+        return apply_to(s, seq_id, d).map(Placed::Track);
+    }
+    check(d)?;
+    s.edit_group("Dub", |s| {
+        let mut items = Vec::new();
+        if let Some(b) = &d.background {
+            let (path, bytes) = write_wav(s, b.samples, b.rate, b.channels, "Dub Background")?;
+            items.push(crate::commands::import_bytes(s, &path, bytes.into(), None)?);
+        }
+        let (path, bytes) = write_wav(s, d.samples, RATE, 1, "Dub")?;
+        items.push(crate::commands::import_bytes(s, &path, bytes.into(), None)?);
+        Ok(items)
+    })
+    .map(Placed::Bin)
+}
+
+fn check(d: &Dub) -> Result<()> {
+    let limit = (MAX_TOTAL_SECONDS * f64::from(RATE)) as usize;
+    if d.samples.is_empty() || d.samples.len() > limit {
+        return Err(EngineError::Other("the dub has an invalid length".into()));
+    }
+    if let Some(b) = &d.background {
+        let ok =
+            (1..=2).contains(&b.channels) && (8_000..=192_000).contains(&b.rate) && !b.samples.is_empty() && b.samples.len() % usize::from(b.channels) == 0;
+        if !ok || b.samples.len() > limit.saturating_mul(2) * 8 {
+            return Err(EngineError::Other("the background audio is not valid".into()));
+        }
+    }
+    if d.at < Tick::ZERO {
+        return Err(EngineError::Other("the dub cannot start before 0".into()));
+    }
+    Ok(())
+}
+
+/// A float WAV with `channels` interleaved channels in the project's `Dubs` folder: (path, bytes).
+fn write_wav(s: &mut Session, samples: &[f32], rate: u32, channels: u16, name: &str) -> Result<(String, Vec<u8>)> {
+    let dir = crate::voiceover::media_dir(s, &json!({}), "Dubs")?;
+    let path = crate::voiceover::unique_wav_path(s, &dir, name)?;
+    if !cfg!(target_arch = "wasm32") {
+        std::fs::create_dir_all(&dir).map_err(|e| EngineError::Other(format!("{dir}: {e}")))?;
+    }
+    let mut bytes = crate::voiceover::write_wav_f32(samples, rate);
+    if channels == 2 && bytes.len() >= 44 {
+        // the same float data, declared as stereo: channels, byte rate and block align
+        bytes[22..24].copy_from_slice(&2u16.to_le_bytes());
+        bytes[28..32].copy_from_slice(&(rate.saturating_mul(8)).to_le_bytes());
+        bytes[32..34].copy_from_slice(&8u16.to_le_bytes());
+    }
+    s.services.write_file(&path, &bytes).map_err(|e| EngineError::Other(format!("{path}: {e}")))?;
+    Ok((path, bytes))
+}
+
+fn apply_to(s: &mut Session, seq_id: ItemId, d: &Dub) -> Result<Applied> {
+    check(d)?;
+    let dur = Tick::from_units(d.samples.len() as i64, i64::from(RATE));
+    let bg_dur = d.background.map(|b| Tick::from_units((b.samples.len() / usize::from(b.channels)) as i64, i64::from(b.rate)));
+    let sources = d.sources.to_vec();
+    let (at, original) = (d.at, d.original);
+    let active = s.state.active_sequence;
+    s.edit_group("Dub", |s| {
+        // the commands below work on the active sequence: borrow it, and give it back at the end
+        s.state.active_sequence = Some(seq_id);
+        let before: Vec<TrackId> = s.active_sequence().map(|q| q.audio_tracks.iter().map(|t| t.id).collect()).unwrap_or_default();
+        let wanted = if bg_dur.is_some() { 2 } else { 1 };
+        s.execute("sequence.addTracks", json!({"video": 0, "audio": wanted, "audioAfter": "last"}))?;
+        let added: Vec<(TrackId, usize)> = s
+            .active_sequence()
+            .map(|q| q.audio_tracks.iter().enumerate().filter(|(_, t)| !before.contains(&t.id)).map(|(i, t)| (t.id, i)).collect())
+            .unwrap_or_default();
+        if added.len() != wanted {
+            return Err(EngineError::Other("could not add the audio tracks".into()));
+        }
+        // the background goes first (below), the dub on top of it
+        let (bg_track, (track, index)) = if bg_dur.is_some() { (Some(added[0]), added[1]) } else { (None, added[0]) };
+        let (path, bytes) = write_wav(s, d.samples, RATE, 1, "Dub")?;
+        let item = crate::commands::import_bytes(s, &path, bytes.into(), None)?;
+        let bg_item = match d.background {
+            Some(b) => {
+                let (path, bytes) = write_wav(s, b.samples, b.rate, b.channels, "Dub Background")?;
+                Some(crate::commands::import_bytes(s, &path, bytes.into(), None)?)
+            }
+            None => None,
+        };
+        let seq_rate = s.project.sequence(seq_id).map(|q| q.settings.frame_rate).unwrap_or_default();
+        let lowered = s.edit("New Dub", |pr, st| {
+            let place = |pr: &mut filmcraft_project::Project, item: ItemId, track: TrackId, len: Tick| -> Result<ClipId> {
+                let mut it = pr
+                    .make_track_item(item, TrackKind::Audio, at, TimeRange::new(Tick::ZERO, len), seq_rate)
+                    .ok_or(EngineError::Other("the dub is not importable".into()))?;
+                it.duration = len;
+                let id = it.id;
+                let seq = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+                let t = seq.audio_tracks.iter_mut().find(|t| t.id == track).ok_or_else(|| EngineError::Other("the dub track was deleted".into()))?;
+                let pos = t.items.partition_point(|x| x.start <= at);
+                t.items.insert(pos, it);
+                Ok(id)
+            };
+            if let (Some(item), Some((track, _)), Some(len)) = (bg_item, bg_track, bg_dur) {
+                place(pr, item, track, len)?;
+            }
+            let id = place(pr, item, track, dur)?;
+            let seq = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+            let mut lowered = 0usize;
+            let new_tracks: Vec<TrackId> = added.iter().map(|(t, _)| *t).collect();
+            for t in seq.audio_tracks.iter_mut().filter(|t| !new_tracks.contains(&t.id)).chain(seq.video_tracks.iter_mut()) {
+                for c in t.items.iter_mut().filter(|c| sources.contains(&c.id)) {
+                    let g = if c.gain_db.is_finite() { c.gain_db } else { 0.0 };
+                    c.gain_db = match original {
+                        Original::Mute => MUTE_DB,
+                        Original::Lower => (g + LOWER_DB).max(MUTE_DB),
+                    };
+                    lowered += 1;
+                }
+            }
+            seq.check().map_err(EngineError::Other)?;
+            if active == Some(seq_id) {
+                st.selection = vec![id];
+            }
+            Ok(lowered)
+        })?;
+        s.state.active_sequence = active;
+        Ok(Applied { track: index, background_track: bg_track.map(|(_, i)| i), lowered })
+    })
+}
+
+// --- Separating the original voice from the background -------------------------------------------
+
+/// The original audio split in two (interleaved samples at `sample_rate`).
+#[derive(Clone, Debug)]
+pub struct Stems {
+    pub sample_rate: u32,
+    pub channels: u16,
+    pub voice: Vec<f32>,
+    pub background: Vec<f32>,
+}
+
+/// Splits speech from music and effects. The real one is a local model that only Jacnex Studio installs.
+pub trait Separator: Sync {
+    /// Whether the model is installed.
+    fn available(&self) -> bool;
+    /// Separates `samples` (interleaved). Must stop soon after `stop` becomes true, with an error.
+    fn separate(&self, samples: &[f32], sample_rate: u32, channels: u16, stop: &AtomicBool, progress: &mut dyn FnMut(f32)) -> Result<Stems>;
+}
+
+/// The local voice separator (Kim Vocal 2, Mel-Band RoFormer) that Jacnex Studio installs.
+struct Real;
+
+impl Separator for Real {
+    fn available(&self) -> bool {
+        crate::separate::separator_available()
+    }
+    fn separate(&self, x: &[f32], sr: u32, ch: u16, stop: &AtomicBool, progress: &mut dyn FnMut(f32)) -> Result<Stems> {
+        let r = crate::separate::separate_voice(x, sr, ch, stop, progress)?;
+        Ok(Stems { sample_rate: r.sample_rate, channels: r.channels, voice: r.voice, background: r.background })
+    }
+}
+
+/// The separator Doblaje uses.
+pub fn separator() -> &'static dyn Separator {
+    &Real
+}
+
+/// The longest range that is separated (memory: the audio is held as stereo floats, twice).
+pub const MAX_SEPARATE_SECONDS: f64 = 600.0;
+
+/// The original audio of the dubbed range, ready to be mixed in a background thread.
+pub struct Capture {
+    project: Arc<filmcraft_project::Project>,
+    seq: filmcraft_project::Sequence,
+    provider: crate::media_pool::PoolProvider,
+    first: i64,
+    frames: usize,
+    pub rate: u32,
+}
+
+/// Prepares the mix of ONLY the dubbed clips (`clips`), `seconds` from `at`, in sequence `seq_id`.
+pub fn capture(s: &Session, seq_id: ItemId, clips: &[ClipId], at: Tick, seconds: f64) -> Result<Capture> {
+    let seq = s.project.sequence(seq_id).ok_or(EngineError::NoSequence)?;
+    if !seconds.is_finite() || seconds <= 0.0 || seconds > MAX_SEPARATE_SECONDS || at < Tick::ZERO {
+        return Err(EngineError::Other("the range to separate is not valid".into()));
+    }
+    let rate = seq.settings.sample_rate.clamp(8_000, 192_000);
+    let mut only = seq.clone();
+    for t in only.video_tracks.iter_mut().chain(only.audio_tracks.iter_mut()) {
+        t.items.retain(|i| clips.contains(&i.id));
+    }
+    let provider = s.media.full_res_provider(s.project.clone(), s.services.clone()).own_sources();
+    Ok(Capture {
+        project: s.project.clone(),
+        seq: only,
+        provider,
+        first: at.to_units_floor(i64::from(rate)),
+        frames: (seconds * f64::from(rate)).ceil() as usize,
+        rate,
+    })
+}
+
+impl Capture {
+    /// Interleaved stereo at [`Capture::rate`]. `None` if `stop` was set.
+    pub fn render(&self, stop: &AtomicBool, progress: &mut dyn FnMut(f32)) -> Option<Vec<f32>> {
+        let mut out = Vec::with_capacity(self.frames.saturating_mul(2));
+        let mut pos = 0usize;
+        while pos < self.frames {
+            if stop.load(Ordering::Relaxed) {
+                return None;
+            }
+            let n = (self.rate as usize).min(self.frames - pos);
+            let buf = filmcraft_render::audio::mix_sequence(&self.project, &self.seq, self.first + pos as i64, n, &self.provider);
+            let (l, r) = (buf.channels.first(), buf.channels.get(1).or_else(|| buf.channels.first()));
+            for i in 0..n {
+                let get = |c: Option<&Vec<f32>>| c.and_then(|c| c.get(i)).copied().filter(|v| v.is_finite()).unwrap_or(0.0).clamp(-4.0, 4.0);
+                out.push(get(l));
+                out.push(get(r));
+            }
+            pos += n;
+            progress(pos as f32 / self.frames as f32);
+        }
+        Some(out)
+    }
+}
+
