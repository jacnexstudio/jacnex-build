@@ -0,0 +1,318 @@
+//! Jacnex: search inside the footage, with fake models (the real ones are tested in the search crate).
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use serde_json::json;
+
+use crate::Session;
+use crate::search::{self, IndexOptions, MeaningEmbedder, Models, Pic, PictureEmbedder, SearchProgress};
+use filmcraft_project::{ItemId, Transcript, Word};
+use filmcraft_speech::FixedTranscriber;
+use filmcraft_time::Tick;
+
+/// Pictures become their mean colour; the text "rojo" is red.
+struct FakePictures {
+    seen: AtomicUsize,
+}
+
+impl PictureEmbedder for FakePictures {
+    fn id(&self) -> &str {
+        "fake-picture"
+    }
+    fn dim(&self) -> usize {
+        4
+    }
+    fn side(&self) -> usize {
+        32
+    }
+    fn pictures(&self, p: &[Pic]) -> crate::Result<Vec<Vec<f32>>> {
+        self.seen.fetch_add(p.len(), Ordering::SeqCst);
+        Ok(p.iter()
+            .map(|p| {
+                let n = (p.rgba.len() / 4).max(1) as f32;
+                let mut m = [0f32; 3];
+                for px in p.rgba.as_chunks::<4>().0.iter() {
+                    for (c, v) in m.iter_mut().enumerate() {
+                        *v += f32::from(px[c]) / 255.0 / n;
+                    }
+                }
+                vec![m[0], m[1], m[2], 0.1]
+            })
+            .collect())
+    }
+    fn text(&self, q: &str) -> crate::Result<Vec<f32>> {
+        Ok(if q.contains("rojo") { vec![1.0, 0.0, 0.0, 0.0] } else { vec![0.0, 0.0, 0.0, 1.0] })
+    }
+    fn logit(&self) -> (f32, f32) {
+        (20.0, -10.0)
+    }
+}
+
+/// Sentences about price are close to the question about price.
+struct FakeMeaning;
+
+impl MeaningEmbedder for FakeMeaning {
+    fn id(&self) -> &str {
+        "fake-meaning"
+    }
+    fn dim(&self) -> usize {
+        2
+    }
+    fn embed(&self, t: &str, _: bool) -> crate::Result<Vec<f32>> {
+        let t = t.to_lowercase();
+        Ok(if t.contains("cuesta") || t.contains("precio") { vec![1.0, 0.0] } else { vec![0.0, 1.0] })
+    }
+}
+
+fn session() -> (Session, ItemId) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let a = &s.active_sequence().unwrap().audio_tracks[0].items[0];
+    let item = a.item;
+    (s, item)
+}
+
+fn transcript() -> Transcript {
+    let mut t = Transcript { language: "es".into(), ..Default::default() };
+    for (text, a, b) in [("Hola", 0.2, 0.5), ("amigos,", 0.5, 0.9), ("esto", 1.0, 1.3), ("cuesta", 1.3, 1.7), ("cincuenta", 1.7, 2.2), ("soles.", 2.2, 2.6)] {
+        t.words.push(Word::new(text, Tick::from_seconds_f64(a), Tick::from_seconds_f64(b)));
+    }
+    t.normalize();
+    t
+}
+
+fn options(cache: &std::path::Path, models: Models, transcribe: bool) -> IndexOptions {
+    IndexOptions { cache: Some(cache.to_path_buf()), models, transcribe, language: "es".into(), whisper_model: "whisper-base".into(), ..Default::default() }
+}
+
+#[test]
+fn words_are_found_without_any_model() {
+    let (mut s, item) = session();
+    Arc::make_mut(&mut s.project).transcripts.insert(item, Arc::new(transcript()));
+    let dir = tempfile::tempdir().unwrap();
+    let job = search::index_job(&s, options(dir.path(), Models::default(), false)).unwrap();
+    let r = job.run(&mut |_| true).unwrap();
+    let hits = r.searcher.query("cuando dice cincuenta soles", &r.media);
+    assert!(!hits.is_empty(), "{:?}", r.notes);
+    let h = &hits[0];
+    assert_eq!(h.id, item.0);
+    assert!(h.words && !h.image);
+    assert!(h.start >= 1.0 && h.end <= 3.2, "{h:?}");
+    assert!(h.quote.contains("cincuenta"));
+    assert!(r.searcher.query("   ", &r.media).is_empty());
+    assert!(r.searcher.query("zzzzqq", &r.media).is_empty());
+}
+
+#[test]
+fn media_without_a_transcript_is_transcribed_first_and_handed_back() {
+    let (mut s, item) = session();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: transcript(), id: "fixed".into() }));
+    let dir = tempfile::tempdir().unwrap();
+    let job = search::index_job(&s, options(dir.path(), Models::default(), true)).unwrap();
+    assert!(job.speech_seconds() > 0.0);
+    let mut saw_speech = false;
+    let r = job
+        .run(&mut |p| {
+            saw_speech |= matches!(p, SearchProgress::Speech(_));
+            true
+        })
+        .unwrap();
+    assert!(saw_speech);
+    let tr = r.transcripts.as_ref().unwrap();
+    assert!(tr.done.iter().any(|(i, _)| *i == item));
+    assert!(!r.searcher.query("cuesta cincuenta", &r.media).is_empty());
+    // the caller keeps them (one undo step)
+    crate::speech_job::apply_transcripts(&mut s, r.transcripts.unwrap()).unwrap();
+    assert!(s.project.transcripts.contains_key(&item));
+}
+
+#[test]
+fn meaning_finds_what_the_words_do_not_say() {
+    let (mut s, item) = session();
+    Arc::make_mut(&mut s.project).transcripts.insert(item, Arc::new(transcript()));
+    let dir = tempfile::tempdir().unwrap();
+    let models = Models { picture: None, meaning: Some(Arc::new(FakeMeaning)) };
+    let r = search::index_job(&s, options(dir.path(), models, false)).unwrap().run(&mut |_| true).unwrap();
+    let hits = r.searcher.query("cuando habla del precio", &r.media);
+    assert!(!hits.is_empty());
+    assert!(hits[0].meaning);
+}
+
+#[test]
+fn pictures_are_indexed_once_kept_and_resumed_after_a_stop() {
+    let (mut s, item) = session();
+    Arc::make_mut(&mut s.project).transcripts.insert(item, Arc::new(transcript()));
+    let dir = tempfile::tempdir().unwrap();
+    let pics = Arc::new(FakePictures { seen: AtomicUsize::new(0) });
+    let models = || Models { picture: Some(pics.clone()), meaning: None };
+
+    // stopped part way: what was done is kept
+    let mut calls = 0;
+    let stopped = search::index_job(&s, options(dir.path(), models(), false)).unwrap().run(&mut |p| {
+        if matches!(p, SearchProgress::Pictures { .. }) {
+            calls += 1;
+        }
+        calls < 3
+    });
+    assert!(stopped.is_err_and(|e| e.to_string().contains(search::CANCELLED)));
+    let after_stop = pics.seen.load(Ordering::SeqCst);
+
+    let r = search::index_job(&s, options(dir.path(), models(), false)).unwrap().run(&mut |_| true).unwrap();
+    let v = r.media.iter().find(|m| m.item == item).and_then(|m| m.visual.clone()).expect("visual index");
+    assert!(v.complete && !v.times.is_empty());
+    assert!(v.times.windows(2).all(|w| w[0] <= w[1]), "times ascend");
+    let total = pics.seen.load(Ordering::SeqCst);
+    assert!(total >= after_stop);
+
+    // done: a third run embeds nothing
+    let r = search::index_job(&s, options(dir.path(), models(), false)).unwrap().run(&mut |_| true).unwrap();
+    assert_eq!(pics.seen.load(Ordering::SeqCst), total, "cached");
+    assert!(r.media.iter().any(|m| m.visual.is_some()));
+    let _ = r.searcher.query("el cielo rojo", &r.media);
+}
+
+#[test]
+fn a_broken_cache_is_rebuilt_not_trusted() {
+    let (mut s, item) = session();
+    Arc::make_mut(&mut s.project).transcripts.insert(item, Arc::new(transcript()));
+    let dir = tempfile::tempdir().unwrap();
+    let pics = Arc::new(FakePictures { seen: AtomicUsize::new(0) });
+    let models = || Models { picture: Some(pics.clone()), meaning: Some(Arc::new(FakeMeaning)) };
+    search::index_job(&s, options(dir.path(), models(), false)).unwrap().run(&mut |_| true).unwrap();
+    for e in std::fs::read_dir(dir.path()).unwrap() {
+        let p = e.unwrap().path();
+        let mut b = std::fs::read(&p).unwrap();
+        let n = b.len() / 2;
+        b.truncate(n);
+        b.push(0xff);
+        std::fs::write(&p, b).unwrap();
+    }
+    let r = search::index_job(&s, options(dir.path(), models(), false)).unwrap().run(&mut |_| true).unwrap();
+    assert!(!r.searcher.query("cincuenta", &r.media).is_empty());
+}
+
+#[test]
+fn an_empty_project_has_nothing_to_search() {
+    let s = Session::default();
+    assert!(search::index_job(&s, IndexOptions::default()).is_err());
+}
+
+#[test]
+fn model_status_reads_the_models_folder_and_never_panics() {
+    assert_eq!(search::ModelStatus::of(None), search::ModelStatus::default());
+    let d = tempfile::tempdir().unwrap();
+    assert!(!search::ModelStatus::of(Some(d.path())).picture);
+}
+
+#[test]
+fn frame_times_are_bounded_and_spread_over_the_file() {
+    use crate::search_sheets::{MAX_SHEETS, frame_times};
+    assert!(frame_times(0.0, 10).is_empty() && frame_times(f64::NAN, 10).is_empty() && frame_times(-3.0, 10).is_empty());
+    let few = frame_times(5.0, 10);
+    assert_eq!(few.len(), 5);
+    assert!(few.windows(2).all(|w| w[0] < w[1]) && few.iter().all(|t| (0.0..5.0).contains(t)));
+    let long = frame_times(7200.0, 10);
+    assert_eq!(long.len(), MAX_SHEETS * 12);
+    assert!(long.last().is_some_and(|t| *t > 7000.0 && *t < 7200.0), "spread over the whole file");
+    assert_eq!(frame_times(1.0e12, 99).len(), MAX_SHEETS * 12, "a huge duration and sheet count are clamped");
+}
+
+#[test]
+fn contact_sheets_are_jpegs_with_a_time_range() {
+    let (s, _) = session();
+    let q = s.active_sequence().unwrap();
+    let video = q.video_tracks.iter().flat_map(|t| t.items.iter()).next().map(|c| c.item).expect("a video clip");
+    let source = s.source(video).expect("source");
+    let seconds =
+        s.project.item(video).and_then(|i| if let filmcraft_project::ItemKind::Media(m) = &i.kind { Some(m.duration().seconds()) } else { None }).unwrap();
+    let mut asked = 0;
+    let sheets = crate::search_sheets::contact_sheets(&source, seconds.min(30.0), 2, &mut || {
+        asked += 1;
+        true
+    })
+    .unwrap();
+    assert!(!sheets.is_empty() && sheets.len() <= 2 && asked > 0);
+    for sh in &sheets {
+        assert_eq!(&sh.jpeg[..2], &[0xff, 0xd8], "JPEG");
+        assert!(sh.from <= sh.to);
+    }
+    // stopping is an error, not a panic
+    let r = crate::search_sheets::contact_sheets(&source, 10.0, 1, &mut || false);
+    assert!(r.is_err_and(|e| e.to_string().contains(search::CANCELLED)));
+}
+
+#[test]
+fn thumbnails_come_from_the_best_moment() {
+    let (mut s, item) = session();
+    Arc::make_mut(&mut s.project).transcripts.insert(item, Arc::new(transcript()));
+    let dir = tempfile::tempdir().unwrap();
+    let job = search::index_job(&s, options(dir.path(), Models::default(), false)).unwrap();
+    let sources = job.sources();
+    assert!(!sources.is_empty());
+    let video = sources.iter().find(|(_, _, v)| *v).map(|(i, _, _)| *i).expect("a video");
+    let hit = filmcraft_search::rank::Hit {
+        id: video.0,
+        start: 0.0,
+        end: 1.0,
+        score: 0.5,
+        words: true,
+        meaning: false,
+        image: false,
+        quote: String::new(),
+        best: 0.5,
+    };
+    let t = search::thumbnail(&sources, &hit, 96).expect("a thumbnail");
+    assert!(t.width > 0 && t.rgba.len() == t.width * t.height * 4);
+    let missing = filmcraft_search::rank::Hit { id: u64::MAX, ..hit };
+    assert!(search::thumbnail(&sources, &missing, 96).is_none());
+}
+
+#[test]
+fn missing_speech_model_is_told_and_pictures_are_still_searched() {
+    let (s, _) = session();
+    let dir = tempfile::tempdir().unwrap();
+    let mut o = options(dir.path(), Models::default(), true);
+    o.whisper_model = "whisper-model-that-is-not-installed".into();
+    let r = search::index_job(&s, o).unwrap().run(&mut |_| true).unwrap();
+    assert!(r.transcripts.is_none());
+    assert!(r.notes.iter().any(|n| n.contains("solo por imagen") && n.contains("Actualiza Filmnex")), "{:?}", r.notes);
+}
+
+/// A file that stops being readable after `until` seconds (a truncated download).
+struct Truncated {
+    inner: filmcraft_media::SharedSource,
+    until: f64,
+}
+
+impl filmcraft_media::MediaSource for Truncated {
+    fn info(&self) -> &filmcraft_media::MediaInfo {
+        self.inner.info()
+    }
+    fn video_frame(&self, req: filmcraft_media::FrameRequest) -> filmcraft_media::Result<Arc<filmcraft_frame::VideoFrame>> {
+        if req.time.seconds() > self.until {
+            return Err(filmcraft_media::MediaError::Decode("truncated data while reading sample data".into()));
+        }
+        self.inner.video_frame(req)
+    }
+    fn audio(&self, start: i64, frames: usize, sample_rate: u32) -> filmcraft_media::Result<filmcraft_frame::AudioBuffer> {
+        self.inner.audio(start, frames, sample_rate)
+    }
+}
+
+#[test]
+fn a_truncated_file_gives_a_partial_index_not_a_failure() {
+    let (s, item) = session();
+    let inner = s.source(item).unwrap();
+    let seconds = inner.info().duration.seconds();
+    assert!(seconds > 12.0, "the demo clip is long enough to fail 5 samples in a row: {seconds}");
+    s.media.insert(item, Arc::new(Truncated { inner, until: 3.5 }));
+    let dir = tempfile::tempdir().unwrap();
+    let pics = Arc::new(FakePictures { seen: AtomicUsize::new(0) });
+    let models = Models { picture: Some(pics.clone()), meaning: None };
+    let r = search::index_job(&s, options(dir.path(), models, false)).unwrap().run(&mut |_| true).unwrap();
+    let v = r.media.iter().find(|m| m.item == item).and_then(|m| m.visual.clone()).expect("a partial index, not a failure");
+    assert!(v.complete && !v.times.is_empty());
+    assert!(v.times.iter().all(|t| *t <= 3.5), "{:?}", v.times);
+    assert!(r.notes.iter().any(|n| n.contains("incompleto")), "{:?}", r.notes);
+}
