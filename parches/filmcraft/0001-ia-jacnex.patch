@@ -0,0 +1,454 @@
+//! Cutting a clip into overlapping chunks for the network and joining the results.
+//!
+//! The clip is read in place (interleaved, at its own rate and channel count). For each chunk, the slice of the
+//! clip it covers is mixed to two channels and resampled to the network's rate; the network's voice estimate is
+//! faded in and out with a Hann window and added into a rolling buffer; samples nothing will touch again are
+//! normalised, resampled back to the clip's rate by a [`Stream`], and written to the output. Only a couple of
+//! chunks are ever held besides the output itself.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use crate::resample::{Resampler, Stream};
+use crate::{Result, SeparateError};
+
+/// Each chunk shares its first `1 / OVERLAP` with the end of the one before (a quarter: 1.33 times the work of
+/// no overlap; half would cost twice as much for a tiny gain, since the seam is cross-faded anyway).
+pub const OVERLAP: usize = 4;
+/// Chunks in one clip (a hostile length must not make a huge plan).
+pub const MAX_CHUNKS: usize = 200_000;
+/// Channels accepted.
+pub const MAX_CHANNELS: u16 = 64;
+/// A weight never reaches zero, so every covered sample can be normalised.
+const MIN_WEIGHT: f32 = 1e-6;
+
+/// What the network needs from a chunk runner.
+pub trait ChunkModel {
+    /// Sample rate the network works at.
+    fn rate(&self) -> u32;
+    /// Samples per chunk.
+    fn chunk(&self) -> usize;
+    /// The voice of one stereo chunk (`left` and `right` have exactly `chunk()` samples; so does the result).
+    fn run(&self, left: &[f32], right: &[f32], stop: &AtomicBool) -> Result<(Vec<f32>, Vec<f32>)>;
+}
+
+/// The two parts of a clip, interleaved, at the clip's own rate and channel count.
+#[derive(Clone, Debug, Default)]
+pub struct Stems {
+    pub sample_rate: u32,
+    pub channels: u16,
+    pub voice: Vec<f32>,
+    pub background: Vec<f32>,
+}
+
+/// First sample of each chunk, in the network's rate, for `total` samples: every `step`, and the last one
+/// ends exactly at the end (so no chunk is mostly padding).
+pub fn plan_starts(total: usize, chunk: usize, step: usize) -> Vec<usize> {
+    if total <= chunk || chunk == 0 || step == 0 {
+        return vec![0];
+    }
+    let mut starts = Vec::new();
+    let mut s = 0usize;
+    while s + chunk < total && starts.len() < MAX_CHUNKS {
+        starts.push(s);
+        s += step;
+    }
+    let last = total - chunk;
+    if starts.last().is_none_or(|&p| p < last) {
+        starts.push(last);
+    }
+    starts
+}
+
+/// Samples from one chunk's start to the next's.
+pub fn step_of(chunk: usize) -> usize {
+    (chunk - chunk / OVERLAP).max(1)
+}
+
+/// Weight of sample `i` of chunk `k` of `count`: 1 in the middle, a linear cross-fade over the shared part (so
+/// two chunks that overlap by exactly `fade` add up to one), none at the clip's own start and end where nothing
+/// overlaps. Never zero.
+pub fn weight(i: usize, chunk: usize, fade: usize, k: usize, count: usize) -> f32 {
+    let f = (fade + 1) as f32;
+    let up = if k == 0 { 1.0 } else { ((i + 1) as f32 / f).min(1.0) };
+    let down = if k + 1 == count { 1.0 } else { ((chunk - i) as f32 / f).min(1.0) };
+    up.min(down).max(MIN_WEIGHT)
+}
+
+fn clean(v: f32) -> f32 {
+    if v.is_finite() { v } else { 0.0 }
+}
+
+/// Frame `i` of the clip as the (left, right) the network hears: mono doubles up, more than two channels are
+/// split between the sides by even and odd.
+fn mix(samples: &[f32], channels: usize, i: usize) -> (f32, f32) {
+    let f = &samples[i * channels..(i + 1) * channels];
+    match channels {
+        1 => (clean(f[0]), clean(f[0])),
+        2 => (clean(f[0]), clean(f[1])),
+        _ => {
+            let (mut l, mut r, mut nl, mut nr) = (0.0, 0.0, 0.0f32, 0.0f32);
+            for (c, v) in f.iter().enumerate() {
+                if c % 2 == 0 {
+                    l += clean(*v);
+                    nl += 1.0;
+                } else {
+                    r += clean(*v);
+                    nr += 1.0;
+                }
+            }
+            (l / nl, r / nr)
+        }
+    }
+}
+
+struct Writer<'a> {
+    samples: &'a [f32],
+    channels: usize,
+    left: Stream,
+    right: Stream,
+    voice: Vec<f32>,
+    background: Vec<f32>,
+    frames: usize,
+    pending_l: Vec<f32>,
+    pending_r: Vec<f32>,
+}
+
+impl Writer<'_> {
+    /// Sends finished samples of the network's rate through the converters and writes whatever comes out.
+    fn feed(&mut self, l: &[f32], r: &[f32]) {
+        self.left.push(l, &mut self.pending_l);
+        self.right.push(r, &mut self.pending_r);
+        self.write();
+    }
+
+    fn finish(&mut self) {
+        self.left.finish(&mut self.pending_l);
+        self.right.finish(&mut self.pending_r);
+        self.write();
+    }
+
+    fn write(&mut self) {
+        let n = self.pending_l.len().min(self.pending_r.len());
+        for k in 0..n {
+            if self.frames >= self.samples.len() / self.channels {
+                break;
+            }
+            let (vl, vr) = (self.pending_l[k], self.pending_r[k]);
+            for c in 0..self.channels {
+                let v = match (self.channels, c) {
+                    (1, _) => (vl + vr) * 0.5,
+                    (_, 0) => vl,
+                    (_, 1) => vr,
+                    _ => (vl + vr) * 0.5,
+                };
+                let heard = clean(self.samples[self.frames * self.channels + c]);
+                self.voice.push(v);
+                self.background.push(heard - v);
+            }
+            self.frames += 1;
+        }
+        self.pending_l.drain(..n);
+        self.pending_r.drain(..n);
+    }
+}
+
+fn reserve(v: &mut Vec<f32>, n: usize) -> Result<()> {
+    v.try_reserve_exact(n).map_err(|_| SeparateError::Input("not enough memory for the result".into()))
+}
+
+/// Separates the voice of `samples` (interleaved, `channels` channels at `rate` Hz). Calls `progress` with a
+/// fraction in `0..=1` as chunks finish, and gives up with [`SeparateError::Stopped`] as soon as `stop` is set.
+pub fn separate<M: ChunkModel>(model: &M, samples: &[f32], rate: u32, channels: u16, stop: &AtomicBool, progress: &mut dyn FnMut(f32)) -> Result<Stems> {
+    if channels == 0 || channels > MAX_CHANNELS {
+        return Err(SeparateError::Input(format!("{channels} channels")));
+    }
+    let ch = usize::from(channels);
+    if !samples.len().is_multiple_of(ch) {
+        return Err(SeparateError::Input("the samples are not a whole number of frames".into()));
+    }
+    let frames = samples.len() / ch;
+    let mut out = Stems { sample_rate: rate, channels, ..Stems::default() };
+    let (chunk, mrate) = (model.chunk(), model.rate());
+    if chunk < 2 {
+        return Err(SeparateError::Model("the chunk is too short".into()));
+    }
+    let down = Resampler::new(rate, mrate)?;
+    let up = Resampler::new(mrate, rate)?;
+    if frames == 0 {
+        return Ok(out);
+    }
+    let total = down.out_len(frames);
+    let (step, fade) = (step_of(chunk), chunk - step_of(chunk));
+    let starts = plan_starts(total, chunk, step);
+    let count = starts.len();
+    let mut w = Writer {
+        samples,
+        channels: ch,
+        left: Stream::new(Resampler::new(mrate, rate)?, frames as u64),
+        right: Stream::new(Resampler::new(mrate, rate)?, frames as u64),
+        voice: Vec::new(),
+        background: Vec::new(),
+        frames: 0,
+        pending_l: Vec::new(),
+        pending_r: Vec::new(),
+    };
+    reserve(&mut w.voice, samples.len())?;
+    reserve(&mut w.background, samples.len())?;
+    let reach = down.reach() + 1;
+    let (mut acc_l, mut acc_r, mut acc_w): (Vec<f32>, Vec<f32>, Vec<f32>) = (Vec::new(), Vec::new(), Vec::new());
+    let mut acc_base = 0usize;
+    progress(0.0);
+    for (k, &start) in starts.iter().enumerate() {
+        if stop.load(Ordering::Relaxed) {
+            return Err(SeparateError::Stopped);
+        }
+        // everything before this chunk is final
+        let done = (start - acc_base).min(acc_l.len());
+        if done > 0 {
+            let (l, r): (Vec<f32>, Vec<f32>) = (0..done).map(|i| (acc_l[i] / acc_w[i], acc_r[i] / acc_w[i])).unzip();
+            w.feed(&l, &r);
+            acc_l.drain(..done);
+            acc_r.drain(..done);
+            acc_w.drain(..done);
+        }
+        acc_base = start;
+        // the part of the clip this chunk hears, at the network's rate
+        let lo = ((start as f64 * down.step()).floor() as i64 - reach as i64).max(0) as usize;
+        let hi = (((start + chunk) as f64 * down.step()).ceil() as usize + reach).min(frames);
+        let (heard_l, heard_r): (Vec<f32>, Vec<f32>) = if lo < hi { (lo..hi).map(|i| mix(samples, ch, i)).unzip() } else { (Vec::new(), Vec::new()) };
+        let input =
+            |side: &[f32]| -> Vec<f32> { (0..chunk).map(|i| if start + i < total { down.at(side, lo as i64, (start + i) as u64) } else { 0.0 }).collect() };
+        let (cl, cr) = (input(&heard_l), input(&heard_r));
+        let (yl, yr) = model.run(&cl, &cr, stop)?;
+        if yl.len() != chunk || yr.len() != chunk {
+            return Err(SeparateError::Net(format!("the network gave {} samples for a chunk of {chunk}", yl.len())));
+        }
+        if acc_l.len() < chunk {
+            acc_l.resize(chunk, 0.0);
+            acc_r.resize(chunk, 0.0);
+            acc_w.resize(chunk, 0.0);
+        }
+        for i in 0..chunk {
+            let wt = weight(i, chunk, fade, k, count);
+            acc_l[i] += clean(yl[i]) * wt;
+            acc_r[i] += clean(yr[i]) * wt;
+            acc_w[i] += wt;
+        }
+        progress(((k + 1) as f32 / count as f32).min(0.99));
+    }
+    let rest = total.saturating_sub(acc_base).min(acc_l.len());
+    let (l, r): (Vec<f32>, Vec<f32>) = (0..rest).map(|i| (acc_l[i] / acc_w[i], acc_r[i] / acc_w[i])).unzip();
+    w.feed(&l, &r);
+    w.finish();
+    drop(up);
+    out.voice = w.voice;
+    out.background = w.background;
+    if out.voice.len() != samples.len() {
+        return Err(SeparateError::Net(format!("{} samples came out of {}", out.voice.len(), samples.len())));
+    }
+    progress(1.0);
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::AtomicUsize;
+
+    /// A network stand-in: the voice is `gain` times what it hears.
+    struct Gain {
+        rate: u32,
+        chunk: usize,
+        gain: f32,
+        runs: AtomicUsize,
+    }
+
+    impl ChunkModel for Gain {
+        fn rate(&self) -> u32 {
+            self.rate
+        }
+        fn chunk(&self) -> usize {
+            self.chunk
+        }
+        fn run(&self, l: &[f32], r: &[f32], _: &AtomicBool) -> Result<(Vec<f32>, Vec<f32>)> {
+            self.runs.fetch_add(1, Ordering::Relaxed);
+            assert!(l.len() == self.chunk && r.len() == self.chunk);
+            Ok((l.iter().map(|v| v * self.gain).collect(), r.iter().map(|v| v * self.gain).collect()))
+        }
+    }
+
+    fn gain(rate: u32, chunk: usize, gain: f32) -> Gain {
+        Gain { rate, chunk, gain, runs: AtomicUsize::new(0) }
+    }
+
+    fn music(rate: u32, ch: usize, frames: usize) -> Vec<f32> {
+        let mut v = Vec::with_capacity(frames * ch);
+        for i in 0..frames {
+            let t = i as f32 / rate as f32;
+            for c in 0..ch {
+                v.push(0.3 * (t * 2.0 * std::f32::consts::PI * (200.0 + 90.0 * c as f32)).sin() + 0.1 * (t * 31.0).sin());
+            }
+        }
+        v
+    }
+
+    fn run(m: &Gain, x: &[f32], rate: u32, ch: u16) -> Stems {
+        separate(m, x, rate, ch, &AtomicBool::new(false), &mut |_| {}).unwrap()
+    }
+
+    #[test]
+    fn chunk_starts_cover_the_clip_with_the_last_one_ending_at_the_end() {
+        assert_eq!(plan_starts(100, 1000, 500), vec![0]);
+        assert_eq!(plan_starts(1000, 1000, 500), vec![0]);
+        assert_eq!(plan_starts(1500, 1000, 500), vec![0, 500]);
+        assert_eq!(plan_starts(1600, 1000, 500), vec![0, 500, 600]);
+        assert_eq!(plan_starts(3000, 1000, 500), vec![0, 500, 1000, 1500, 2000]);
+        for total in [1001usize, 1999, 2500, 7777] {
+            let s = plan_starts(total, 1000, 500);
+            assert_eq!(s[0], 0);
+            assert_eq!(s.last().copied(), Some(total - 1000));
+            assert!(s.windows(2).all(|p| p[1] > p[0] && p[1] - p[0] <= 500));
+        }
+        assert_eq!(plan_starts(10, 0, 5), vec![0]);
+    }
+
+    #[test]
+    fn weights_of_chunks_that_overlap_by_the_fade_add_up_to_one() {
+        let (c, step) = (1000, step_of(1000));
+        let fade = c - step;
+        assert_eq!((step, fade), (750, 250));
+        for m in 0..fade {
+            let sum = weight(step + m, c, fade, 1, 4) + weight(m, c, fade, 2, 4);
+            assert!((sum - 1.0).abs() < 1e-5, "{m}: {sum}");
+        }
+        // the middle is flat, the clip's own ends are flat, and nothing is ever zero
+        assert_eq!((weight(500, c, fade, 1, 4), weight(0, c, fade, 0, 3), weight(999, c, fade, 2, 3)), (1.0, 1.0, 1.0));
+        assert!(weight(0, c, fade, 1, 3) > 0.0 && weight(999, c, fade, 1, 3) > 0.0);
+        assert_eq!(step_of(1), 1);
+    }
+
+    #[test]
+    fn a_unity_network_gives_the_clip_back_as_the_voice_and_nothing_as_the_rest() {
+        for (rate, ch, frames, chunk) in
+            [(44100u32, 2usize, 20_000usize, 4096usize), (48000, 2, 30_000, 4096), (16000, 1, 9_000, 2048), (96000, 2, 40_000, 8192)]
+        {
+            let m = gain(44100, chunk, 1.0);
+            let x = music(rate, ch, frames);
+            let s = run(&m, &x, rate, ch as u16);
+            assert_eq!((s.voice.len(), s.background.len(), s.sample_rate, s.channels), (x.len(), x.len(), rate, ch as u16));
+            let edge = 3000.min(frames / 4) * ch;
+            let worst = x[edge..x.len() - edge].iter().zip(&s.voice[edge..]).map(|(a, b)| (a - b).abs()).fold(0.0f32, f32::max);
+            assert!(worst < 5e-3, "{rate} Hz x{ch}: {worst}");
+            let rest = s.background[edge..s.background.len() - edge].iter().fold(0.0f32, |m, v| m.max(v.abs()));
+            assert!(rest < 5e-3, "{rest}");
+        }
+    }
+
+    #[test]
+    fn voice_plus_background_is_always_the_input() {
+        let m = gain(44100, 4096, 0.4);
+        let x = music(48000, 2, 25_000);
+        let s = run(&m, &x, 48000, 2);
+        assert!(x.iter().zip(s.voice.iter().zip(&s.background)).all(|(a, (v, b))| (a - (v + b)).abs() < 1e-6));
+        // and the voice is the share the network took
+        let mid = 12_000 * 2;
+        assert!((s.voice[mid] - 0.4 * x[mid]).abs() < 5e-3);
+    }
+
+    #[test]
+    fn chunks_overlap_and_a_clip_shorter_than_a_chunk_runs_once() {
+        let m = gain(44100, 4096, 1.0);
+        let x = music(44100, 2, 3000);
+        let s = run(&m, &x, 44100, 2);
+        assert_eq!(m.runs.load(Ordering::Relaxed), 1);
+        assert_eq!(s.voice.len(), x.len());
+        let m = gain(44100, 4096, 1.0);
+        run(&m, &music(44100, 2, 4096 * 3), 44100, 2);
+        assert_eq!(m.runs.load(Ordering::Relaxed), plan_starts(4096 * 3, 4096, step_of(4096)).len());
+    }
+
+    #[test]
+    fn more_than_two_channels_share_the_voice_and_mono_stays_mono() {
+        let m = gain(44100, 2048, 1.0);
+        let x = music(44100, 6, 6000);
+        let s = run(&m, &x, 44100, 6);
+        assert_eq!(s.voice.len(), x.len());
+        assert!(x.iter().zip(s.voice.iter().zip(&s.background)).all(|(a, (v, b))| (a - (v + b)).abs() < 1e-5));
+        let mono = run(&m, &music(44100, 1, 5000), 44100, 1);
+        assert_eq!(mono.channels, 1);
+        assert_eq!(mono.voice.len(), 5000);
+    }
+
+    #[test]
+    fn hostile_input_is_refused_or_cleaned() {
+        let m = gain(44100, 2048, 1.0);
+        let stop = AtomicBool::new(false);
+        let go = |x: &[f32], rate: u32, ch: u16| separate(&m, x, rate, ch, &stop, &mut |_| {});
+        assert!(go(&[0.0; 10], 44100, 0).is_err());
+        assert!(go(&[0.0; 10], 44100, 65).is_err());
+        assert!(go(&[0.0; 7], 44100, 2).is_err());
+        assert!(go(&[0.0; 10], 10, 2).is_err());
+        assert!(go(&[0.0; 10], 44100 * 100, 2).is_err());
+        assert!(go(&[], 44100, 2).unwrap().voice.is_empty());
+        // not-a-number and infinities become silence
+        let mut x = music(44100, 2, 5000);
+        x[10] = f32::NAN;
+        x[11] = f32::INFINITY;
+        x[4000] = f32::NEG_INFINITY;
+        let s = go(&x, 44100, 2).unwrap();
+        assert!(s.voice.iter().chain(&s.background).all(|v| v.is_finite()));
+        // a network that answers the wrong size is an error, not a panic
+        struct Bad;
+        impl ChunkModel for Bad {
+            fn rate(&self) -> u32 {
+                44100
+            }
+            fn chunk(&self) -> usize {
+                1024
+            }
+            fn run(&self, _: &[f32], _: &[f32], _: &AtomicBool) -> Result<(Vec<f32>, Vec<f32>)> {
+                Ok((vec![0.0; 5], vec![0.0; 5]))
+            }
+        }
+        assert!(matches!(separate(&Bad, &x, 44100, 2, &stop, &mut |_| {}), Err(SeparateError::Net(_))));
+    }
+
+    #[test]
+    fn stopping_ends_the_work_between_chunks() {
+        let m = gain(44100, 2048, 1.0);
+        let x = music(44100, 2, 30_000);
+        let stop = AtomicBool::new(false);
+        let mut seen = Vec::new();
+        let r = separate(&m, &x, 44100, 2, &stop, &mut |p| {
+            seen.push(p);
+            if p > 0.3 {
+                stop.store(true, Ordering::Relaxed);
+            }
+        });
+        assert!(matches!(r, Err(SeparateError::Stopped)));
+        assert!(m.runs.load(Ordering::Relaxed) < plan_starts(30_000, 2048, step_of(2048)).len());
+        // asked before starting: not one chunk runs
+        let m = gain(44100, 2048, 1.0);
+        let r = separate(&m, &x, 44100, 2, &AtomicBool::new(true), &mut |_| {});
+        assert!(matches!(r, Err(SeparateError::Stopped)) && m.runs.load(Ordering::Relaxed) == 0);
+        assert!(seen.windows(2).all(|p| p[1] >= p[0]));
+    }
+
+    #[test]
+    fn progress_goes_up_to_one() {
+        let m = gain(44100, 2048, 1.0);
+        let mut seen = Vec::new();
+        separate(&m, &music(44100, 2, 10_000), 44100, 2, &AtomicBool::new(false), &mut |p| seen.push(p)).unwrap();
+        assert_eq!(seen.first().copied(), Some(0.0));
+        assert_eq!(seen.last().copied(), Some(1.0));
+        assert!(seen.windows(2).all(|p| p[1] >= p[0]) && seen.len() > 4);
+    }
+
+    #[test]
+    fn an_hour_of_audio_is_planned_without_holding_it_all() {
+        // only the plan: 1 h at 44.1 kHz with the network's 8 s chunks
+        let starts = plan_starts(3600 * 44100, 352_800, step_of(352_800));
+        assert_eq!(starts.last().copied(), Some(3600 * 44100 - 352_800));
+        assert!(starts.len() < 1000, "{}", starts.len());
+    }
+}
