new file mode 100644
index 0000000..6f7bba1
--- /dev/null
+++ b/crates/engine/src/separate.rs
@@ -0,0 +1,128 @@
+//! Jacnex: separate what is said from the music and the effects (Doblaje).
+//!
+//! The network (Mel-Band RoFormer, "Kim Vocal 2") runs on the CPU with candle. Its weights are never part
+//! of Filmnex: Jacnex Studio puts them in `jacnex_models_dir()/separar-kim-vocal-2/`. Without the `whisper`
+//! feature (wasm builds, tests) nothing is available and every call says so.
+
+use std::sync::atomic::AtomicBool;
+
+use crate::{EngineError, Result};
+
+/// The folder Jacnex Studio fills with the network.
+pub const MODEL_ID: &str = "separar-kim-vocal-2";
+/// Exact size of `model.safetensors` (f16 matrices, f32 the rest).
+pub const WEIGHTS_BYTES: u64 = 457_260_680;
+/// What to tell the user when the network is not there.
+pub const FALTA_MODELO: &str = "Instala el separador de voz desde Jacnex Studio para usar esta función.";
+
+/// The two parts of a clip, interleaved, at the clip's own rate and channel count.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Stems {
+    pub sample_rate: u32,
+    pub channels: u16,
+    /// The speech.
+    pub voice: Vec<f32>,
+    /// Everything else (music, effects, ambience): the clip minus the voice.
+    pub background: Vec<f32>,
+}
+
+fn model_dir() -> Option<std::path::PathBuf> {
+    crate::transcript::jacnex_models_dir().map(|d| d.join(MODEL_ID))
+}
+
+fn files_ok(dir: &std::path::Path) -> bool {
+    let size = |f: &str| std::fs::metadata(dir.join(f)).ok().filter(|m| m.is_file()).map(|m| m.len());
+    size("model.safetensors") == Some(WEIGHTS_BYTES) && size("config.json").is_some_and(|n| (1..=4096).contains(&n))
+}
+
+/// Whether this build can separate and the network is on this computer (files present with the right sizes).
+pub fn separator_available() -> bool {
+    cfg!(feature = "whisper") && model_dir().is_some_and(|d| files_ok(&d))
+}
+
+/// Splits `samples` (interleaved, `channels` channels at `sample_rate` Hz) into voice and background.
+///
+/// Works in chunks of eight seconds, so memory stays bounded on long clips (the results are as long as the
+/// input). `progress` gets `0.0..=1.0`; setting `stop` ends it early with an error.
+#[cfg(feature = "whisper")]
+pub fn separate_voice(samples: &[f32], sample_rate: u32, channels: u16, stop: &AtomicBool, progress: &mut dyn FnMut(f32)) -> Result<Stems> {
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+
+    use filmcraft_separate::SeparateError;
+    use filmcraft_separate::model::MelBandRoformer;
+
+    let dir = model_dir().filter(|d| files_ok(d)).ok_or_else(|| EngineError::Other(FALTA_MODELO.into()))?;
+    let run = || -> filmcraft_separate::Result<filmcraft_separate::Stems> {
+        let net = MelBandRoformer::load(&dir)?;
+        filmcraft_separate::separate(&net, samples, sample_rate, channels, stop, progress)
+    };
+    let out = catch_unwind(AssertUnwindSafe(run)).unwrap_or_else(|_| Err(SeparateError::Net("the separator panicked".into())));
+    match out {
+        Ok(s) => Ok(Stems { sample_rate: s.sample_rate, channels: s.channels, voice: s.voice, background: s.background }),
+        Err(SeparateError::Stopped) => Err(EngineError::Other("Separación cancelada.".into())),
+        Err(SeparateError::Model(e)) => Err(EngineError::Other(format!("{FALTA_MODELO} ({e})"))),
+        Err(e) => Err(EngineError::Other(format!("No se pudo separar la voz: {e}"))),
+    }
+}
+
+/// Without the `whisper` feature there is no network.
+#[cfg(not(feature = "whisper"))]
+pub fn separate_voice(_: &[f32], _: u32, _: u16, _: &AtomicBool, _: &mut dyn FnMut(f32)) -> Result<Stems> {
+    Err(EngineError::Other(FALTA_MODELO.into()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nothing_is_available_without_the_files() {
+        let dir = tempfile::tempdir().unwrap();
+        assert!(!files_ok(dir.path()));
+        std::fs::write(dir.path().join("model.safetensors"), b"short").unwrap();
+        std::fs::write(dir.path().join("config.json"), b"{}").unwrap();
+        assert!(!files_ok(dir.path()), "the weights must have the exact size");
+    }
+
+    #[test]
+    fn separating_without_the_model_is_an_error_not_a_panic() {
+        let stop = AtomicBool::new(false);
+        let r = separate_voice(&[0.0; 100], 44100, 2, &stop, &mut |_| {});
+        // test runs use FILMCRAFT_DATA_DIR-less defaults: either the model is absent (error) or present (ok)
+        if !separator_available() {
+            assert!(r.is_err());
+        }
+    }
+
+    /// The real model through this wrapper, as Doblaje calls it. Only with `JACNEX_SEPARATE_ENGINE=1` and the
+    /// model installed by Jacnex Studio (it takes about half a minute).
+    #[test]
+    fn the_installed_model_separates_through_the_engine() {
+        if std::env::var_os("JACNEX_SEPARATE_ENGINE").is_none() || !separator_available() {
+            return;
+        }
+        let rate = 48_000u32;
+        let n = rate as usize * 3;
+        let mut x = Vec::with_capacity(n * 2);
+        for i in 0..n {
+            let s = i as f32 / rate as f32;
+            let voice = 0.3 * (std::f32::consts::TAU * 220.0 * s).sin() * (std::f32::consts::TAU * 3.0 * s).sin().abs();
+            let music = 0.2 * (std::f32::consts::TAU * 55.0 * s).sin();
+            x.push(voice + music);
+            x.push(voice - music);
+        }
+        let stop = AtomicBool::new(false);
+        let mut last = 0.0f32;
+        let r = separate_voice(&x, rate, 2, &stop, &mut |p| last = p).unwrap();
+        assert_eq!((r.sample_rate, r.channels), (rate, 2));
+        assert_eq!(r.voice.len(), x.len());
+        assert_eq!(r.background.len(), x.len());
+        assert!((last - 1.0).abs() < 1e-3, "progress ends at 1, got {last}");
+        for i in 0..x.len() {
+            assert!(r.voice[i].is_finite() && r.background[i].is_finite());
+            assert!((r.voice[i] + r.background[i] - x[i]).abs() < 1e-4, "voice + background = input");
+        }
+        let stopped = AtomicBool::new(true);
+        assert!(separate_voice(&x, rate, 2, &stopped, &mut |_| {}).is_err(), "a stop is an error");
+    }
+}
