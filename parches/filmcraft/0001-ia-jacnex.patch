+/// Una lista desplegable de (id, nombre); devuelve el id elegido.
+fn desplegable(ui: &mut egui::Ui, id: &str, lista: &[(&'static str, &'static str)], actual: &str) -> Option<&'static str> {
+    let nombre = lista.iter().find(|(c, _)| *c == actual).map_or("", |(_, n)| *n);
+    let mut elegido = None;
+    craft_ui::ComboBox::from_id_salt(id).selected_text(nombre).width(ui.available_width()).show_ui(ui, |ui| {
+        for (c, n) in lista {
+            if ui.selectable_label(*c == actual, *n).clicked() {
+                elegido = Some(*c);
+            }
+        }
+    });
+    elegido
+}
