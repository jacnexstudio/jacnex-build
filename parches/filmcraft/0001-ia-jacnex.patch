+    "who",
+    "what",
+];
+
+/// Whether `w` (folded) is a word that says nothing about what is looked for.
+pub fn is_stop(w: &str) -> bool {
+    STOP.contains(&w)
+}
+
+/// One word of a query.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Term {
+    /// Folded.
+    pub text: String,
+    /// How much it counts (longer words say more).
+    pub weight: f32,
+}
+
+/// A query read for the word search.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Query {
+    pub terms: Vec<Term>,
+}
+
+impl Query {
+    /// Reads `q`: its content words (the stop words only when nothing else is left), without
+    /// repeats, at most [`MAX_TERMS`].
+    pub fn parse(q: &str) -> Query {
+        let q: String = q.chars().take(MAX_QUERY_CHARS).collect();
+        let all = tokens(&q);
+        let mut words: Vec<String> = all.iter().filter(|w| !is_stop(w)).cloned().collect();
+        if words.is_empty() {
+            words = all.into_iter().filter(|w| w.chars().count() > 1).collect();
+        }
+        let mut terms: Vec<Term> = Vec::new();
+        for w in words {
+            if terms.len() >= MAX_TERMS {
+                break;
+            }
+            if !terms.iter().any(|t| t.text == w) {
+                #[allow(clippy::cast_precision_loss)]
+                let weight = (w.chars().count().min(8) as f32 / 8.0).max(0.4);
+                terms.push(Term { text: w, weight });
+            }
+        }
+        Query { terms }
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.terms.is_empty()
+    }
+}
+
+/// The edit distance between `a` and `b` when it is at most `max` (None when it is more).
+fn edit_distance(a: &[char], b: &[char], max: usize) -> Option<usize> {
+    if a.len().abs_diff(b.len()) > max {
+        return None;
+    }
+    let mut prev: Vec<usize> = (0..=b.len()).collect();
+    let mut cur = vec![0usize; b.len() + 1];
+    for (i, ca) in a.iter().enumerate() {
+        if let Some(c0) = cur.first_mut() {
+            *c0 = i + 1;
+        }
+        let mut best = i + 1;
+        for (j, cb) in b.iter().enumerate() {
+            let sub = prev.get(j).copied().unwrap_or(0) + usize::from(ca != cb);
+            let del = prev.get(j + 1).copied().unwrap_or(0) + 1;
+            let ins = cur.get(j).copied().unwrap_or(0) + 1;
+            let v = sub.min(del).min(ins);
+            if let Some(slot) = cur.get_mut(j + 1) {
+                *slot = v;
+            }
+            best = best.min(v);
+        }
+        if best > max {
+            return None;
+        }
+        std::mem::swap(&mut prev, &mut cur);
+    }
+    prev.get(b.len()).copied().filter(|d| *d <= max)
+}
+
+/// How well the word `w` (folded) matches the query term `t` (folded): 1 same word, 0.85 same
+/// start and ending ("precio" / "precios"), 0.7 a typo or a slightly different form, else 0.
+pub fn match_word(t: &str, w: &str) -> f32 {
+    if t == w {
+        return 1.0;
+    }
+    let tc: Vec<char> = t.chars().take(MAX_WORD_CHARS).collect();
+    let wc: Vec<char> = w.chars().take(MAX_WORD_CHARS).collect();
+    let short = tc.len().min(wc.len());
+    if short < 4 {
+        return 0.0;
+    }
+    // plural, gender, verb endings: they share a long start
+    let common = tc.iter().zip(wc.iter()).take_while(|(a, b)| a == b).count();
+    if common >= 4 && common + 3 >= tc.len().max(wc.len()) && common * 4 >= short * 3 {
+        return 0.85;
+    }
+    let max = if short >= 8 { 2 } else { 1 };
+    if edit_distance(&tc, &wc, max).is_some() { 0.7 } else { 0.0 }
+}
+
+/// A chunk's words that matched, scored.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct WordHit {
+    /// 0..1: the share of the query found, with a little extra for the words in order.
+    pub score: f32,
+    /// The first and last matching word (indexes into the words given).
+    pub first: usize,
+    pub last: usize,
+}
+
+/// Looks for `q` in the folded `words`: every term takes its best word.
+pub fn find_terms(q: &Query, words: &[String]) -> Option<WordHit> {
+    if q.is_empty() || words.is_empty() {
+        return None;
+    }
+    let mut total = 0.0f32;
+    let mut got = 0.0f32;
+    let (mut first, mut last) = (usize::MAX, 0usize);
+    let mut order: Vec<usize> = Vec::new();
+    for t in &q.terms {
+        total += t.weight;
+        let mut best = (0.0f32, 0usize);
+        for (i, w) in words.iter().enumerate() {
+            let m = match_word(&t.text, w);
+            if m > best.0 {
+                best = (m, i);
+            }
+        }
+        if best.0 >= 0.7 {
+            got += t.weight * best.0;
+            first = first.min(best.1);
+            last = last.max(best.1);
+            order.push(best.1);
+        }
+    }
+    if order.is_empty() || total <= 0.0 {
+        return None;
+    }
+    let mut score = got / total;
+    // several terms in the order they were asked, close together
+    if order.len() >= 2 && order.windows(2).all(|p| matches!(p, [a, b] if b > a && b - a <= 3)) {
+        score = (score + 0.1).min(1.0);
+    }
+    Some(WordHit { score, first, last })
+}
+
+/// Longest chunk, in words.
+pub const CHUNK_MAX_WORDS: usize = 40;
+/// Shortest chunk that is closed at a sentence end or a pause.
+const CHUNK_MIN_WORDS: usize = 6;
+/// Longest chunk, in seconds.
+const CHUNK_MAX_SECONDS: f32 = 18.0;
+/// A silence this long between words closes the chunk (once it has [`CHUNK_MIN_WORDS`]).
+const CHUNK_PAUSE: f32 = 0.8;
+/// Most words a transcript may have for the search (more are ignored).
+pub const MAX_WORDS: usize = 400_000;
+
+/// Cuts `words` into chunks at sentence ends and pauses.
+pub fn chunk_words(words: &[Word]) -> Vec<Chunk> {
+    let mut out: Vec<Chunk> = Vec::new();
+    let words = words.get(..words.len().min(MAX_WORDS)).unwrap_or(&[]);
+    let mut from = 0usize;
+    let close = |from: usize, to: usize, out: &mut Vec<Chunk>| {
+        let slice = words.get(from..to).unwrap_or(&[]);
+        let (Some(a), Some(b)) = (slice.first(), slice.last()) else { return };
+        let text = slice.iter().map(|w| w.text.trim()).filter(|t| !t.is_empty()).collect::<Vec<_>>().join(" ");
+        if text.is_empty() {
+            return;
+        }
+        let (Ok(f), Ok(e)) = (u32::try_from(from), u32::try_from(to)) else { return };
+        out.push(Chunk { first: f, end_word: e, start: a.start, end: b.end.max(a.start), text });
+    };
+    for i in 0..words.len() {
+        let Some(w) = words.get(i) else { break };
+        let n = i + 1 - from;
+        let start = words.get(from).map_or(w.start, |f| f.start);
+        let gap = words.get(i + 1).map_or(f32::INFINITY, |nx| nx.start - w.end);
+        let ends_sentence = w.text.trim_end().ends_with(['.', '?', '!', '…']);
+        let full = n >= CHUNK_MAX_WORDS || w.end - start >= CHUNK_MAX_SECONDS;
+        let natural = n >= CHUNK_MIN_WORDS && (ends_sentence || gap >= CHUNK_PAUSE);
+        if full || natural || i + 1 == words.len() {
+            close(from, i + 1, &mut out);
+            from = i + 1;
+        }
+    }
+    out
+}
+
+/// A quote from `words` around `first..=last`, at most about `max` words, with … at cut ends.
+pub fn quote(words: &[Word], first: usize, last: usize, max: usize) -> String {
+    if words.is_empty() {
+        return String::new();
+    }
+    let last = last.min(words.len() - 1);
+    let first = first.min(last);
+    let span = last - first + 1;
+    let pad = max.saturating_sub(span) / 2;
+    let a = first.saturating_sub(pad);
+    let b = (last + pad + 1).min(words.len());
+    let text = words.get(a..b).unwrap_or(&[]).iter().map(|w| w.text.trim()).collect::<Vec<_>>().join(" ");
+    format!("{}{}{}", if a > 0 { "…" } else { "" }, text, if b < words.len() { "…" } else { "" })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn w(t: &str, a: f32, b: f32) -> Word {
+        Word { text: t.into(), start: a, end: b }
+    }
+
+    #[test]
+    fn folds_accents_and_case() {
+        assert_eq!(fold("¿Cuánto CUESTA el Niño?"), " cuanto cuesta el nino ");
+        assert_eq!(tokens("Canción, piña"), vec!["cancion", "pina"]);
+    }
+
+    #[test]
+    fn query_drops_the_words_people_ask_with() {
+        let q = Query::parse("cuando habla del precio");
+        assert_eq!(q.terms.iter().map(|t| t.text.as_str()).collect::<Vec<_>>(), vec!["precio"]);
+        let only_stop = Query::parse("el de la");
+        assert!(!only_stop.is_empty());
+        assert!(Query::parse("   ").is_empty());
+    }
+
+    #[test]
+    fn word_matching_tolerates_forms_and_typos() {
+        assert_eq!(match_word("precio", "precio"), 1.0);
+        assert!(match_word("precio", "precios") >= 0.85);
+        assert!(match_word("playa", "playas") >= 0.85);
+        assert!(match_word("precio", "presio") >= 0.7);
+        assert_eq!(match_word("precio", "pozo"), 0.0);
+        assert_eq!(match_word("sol", "son"), 0.0);
+    }
+
+    #[test]
+    fn terms_are_found_in_order_and_scored() {
+        let words: Vec<String> = tokens("el precio final del producto es muy bueno");
+        let q = Query::parse("precio producto");
+        let h = find_terms(&q, &words).unwrap();
+        assert!(h.score > 0.95);
+        assert_eq!((h.first, h.last), (1, 4));
+        assert!(find_terms(&Query::parse("playa"), &words).is_none());
+        let half = find_terms(&Query::parse("precio playa"), &words).unwrap();
+        assert!(half.score < 0.6);
+    }
+
+    #[test]
+    fn chunks_close_at_sentences_and_pauses_and_cover_every_word() {
+        let mut ws = Vec::new();
+        for i in 0..30 {
+            let t = if i == 9 { "listo." } else { "palabra" };
+            ws.push(w(t, i as f32 * 0.4, i as f32 * 0.4 + 0.3));
+        }
+        let cs = chunk_words(&ws);
+        assert!(cs.len() >= 2);
+        assert_eq!(cs[0].first, 0);
+        assert_eq!(cs.last().unwrap().end_word, 30);
+        for p in cs.windows(2) {
+            assert_eq!(p[0].end_word, p[1].first);
+        }
+        assert!(chunk_words(&[]).is_empty());
+    }
+
+    #[test]
+    fn quote_is_bounded_and_marks_cuts() {
+        let ws: Vec<Word> = (0..50).map(|i| w(&format!("w{i}"), i as f32, i as f32 + 0.5)).collect();
+        let q = quote(&ws, 20, 21, 8);
+        assert!(q.starts_with('…') && q.ends_with('…'));
+        assert!(q.contains("w20") && q.contains("w21"));
+        assert_eq!(quote(&[], 3, 9, 8), "");
+    }
+
+    #[test]
+    fn hostile_text_does_not_panic() {
+        let long = "ñ".repeat(100_000);
+        let q = Query::parse(&long);
+        assert!(q.terms.len() <= MAX_TERMS);
+        let _ = match_word(&"a".repeat(10_000), &"b".repeat(10_000));
+    }
+}
