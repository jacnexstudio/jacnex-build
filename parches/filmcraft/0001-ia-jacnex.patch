+/// Jacnex: un modelo de «Buscar con IA» del servidor y cómo calcula lo que reserva y cobra. Lo que se
+/// cobra al final es lo que informa kie.ai (a lo más lo reservado); aquí solo se estima.
+#[derive(Clone, Debug, PartialEq)]
+pub(crate) struct BusquedaNube {
+    pub id: String,
+    pub nombre: String,
+    /// Hojas de imágenes que acepta por envío.
+    pub max_hojas: usize,
+    /// Letras del texto con tiempos que acepta.
+    pub max_caracteres: usize,
+    /// Lo más largo que puede durar el archivo, en segundos.
+    pub max_segundos: f64,
+    /// Lo que pesan todas las hojas, en MB.
+    pub max_megas: usize,
+    pub caracteres_por_token: f64,
+    pub tokens_por_hoja: f64,
+    pub tokens_respuesta: f64,
+    /// Cuánto se multiplica lo esperado para reservar.
+    pub margen: f64,
+    /// Lo más que se reserva.
+    pub max_creditos: i64,
+    pub creditos_por_millon: f64,
+}
+
+impl BusquedaNube {
+    /// Los tokens que se espera que gaste (como el servidor).
+    pub fn tokens(&self, caracteres: usize, hojas: usize) -> f64 {
+        #[allow(clippy::cast_precision_loss)]
+        let (c, h) = (caracteres as f64, hojas as f64);
+        (c / self.caracteres_por_token.max(0.1)).ceil() + h * self.tokens_por_hoja + self.tokens_respuesta
+    }
+
+    /// Lo que costaría normalmente, en créditos.
+    pub fn esperado(&self, caracteres: usize, hojas: usize) -> f64 {
+        self.tokens(caracteres, hojas) * self.creditos_por_millon / 1e6
+    }
+
+    /// Lo más que se cobra (se reserva y lo que sobre se devuelve).
+    pub fn reserva(&self, caracteres: usize, hojas: usize) -> i64 {
+        let e = (self.esperado(caracteres, hojas) * self.margen).ceil();
+        #[allow(clippy::cast_possible_truncation)]
+        let e = if e.is_finite() { e.clamp(1.0, 1e9) as i64 } else { 1 };
+        e.min(self.max_creditos.max(1))
+    }
+}
+
+/// Jacnex: una entrada de `busquedas` (sin id o con números fuera de rango se ignora).
+pub(crate) fn leer_busqueda(m: &Value) -> Option<BusquedaNube> {
+    let n = |k: &str| m.get(k).and_then(Value::as_f64).filter(|x| x.is_finite() && *x >= 0.0);
+    let id = m.get("id").and_then(Value::as_str).filter(|i| !i.is_empty() && i.len() <= 64)?.to_string();
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+    let entero = |k: &str, tope: f64| n(k).map(|x| x.min(tope) as usize);
+    Some(BusquedaNube {
+        nombre: m.get("nombre").and_then(Value::as_str).unwrap_or("").chars().take(80).collect(),
+        max_hojas: entero("maxHojas", 10.0)?,
+        max_caracteres: entero("maxCaracteres", 2e6)?,
+        max_segundos: n("maxSegundos")?.min(86_400.0),
+        max_megas: entero("maxMegas", 100.0)?,
+        caracteres_por_token: n("caracteresPorToken").filter(|x| *x > 0.0)?,
+        tokens_por_hoja: n("tokensPorHoja")?,
+        tokens_respuesta: n("tokensRespuesta")?,
+        margen: n("margen").filter(|x| *x >= 1.0)?,
+        #[allow(clippy::cast_possible_truncation)]
+        max_creditos: n("maxCreditos").filter(|x| *x >= 1.0)?.min(1e6) as i64,
+        creditos_por_millon: n("creditosPorMillon")?,
+        id,
+    })
+}
