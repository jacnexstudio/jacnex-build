+/// Una entrada de `transcripciones` (sin id o con números fuera de rango se ignora).
+fn leer_motor_nube(m: &Value) -> Option<MotorNube> {
+    let s = |k: &str| m.get(k).and_then(Value::as_str).unwrap_or("").to_string();
+    let id = s("id");
+    let por_minuto = m.get("creditosPorMinuto").and_then(Value::as_f64).filter(|c| c.is_finite() && *c >= 0.0 && *c < 1e6)?;
+    let max_segundos = m.get("maxSegundos").and_then(Value::as_u64).and_then(|x| u32::try_from(x).ok()).filter(|x| *x >= 60)?;
+    let max_megas = m.get("maxMegas").and_then(Value::as_u64).filter(|x| (1..=4096).contains(x))?;
+    if id.is_empty() {
+        return None;
+    }
+    #[allow(clippy::cast_possible_truncation)]
+    let por_minuto = (por_minuto * 100.0).round() as i64;
+    Some(MotorNube { nombre: s("nombre"), id, por_minuto, max_segundos, max_megas })
+}
+
+/// Lo más que se lee de las listas del catálogo (voces, resoluciones).
+const MAX_LISTA: usize = 64;
+
+/// Una entrada de `audios` o `mejoras` (las de familia desconocida se ignoran).
+fn leer_herramienta(m: &Value) -> Option<Herramienta> {
+    let s = |k: &str| m.get(k).and_then(Value::as_str).unwrap_or("").to_string();
+    let id = s("id");
+    let familia = s("familia");
+    if id.is_empty() || !Modo::TODOS.iter().any(|modo| modo.familia() == Some(familia.as_str())) {
+        return None;
+    }
+    let n = |k: &str| m.get(k).and_then(Value::as_u64);
+    let voces = m
+        .get("voces")
+        .and_then(Value::as_array)
+        .map(|a| {
+            a.iter()
+                .take(MAX_LISTA)
+                .filter_map(|v| {
+                    let s = |k: &str| v.get(k).and_then(Value::as_str).unwrap_or("").to_string();
+                    let voz = Voz { id: s("id"), nombre: s("nombre"), genero: s("genero"), estilo: s("estilo") };
+                    (!voz.id.is_empty() && !voz.nombre.is_empty()).then_some(voz)
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let duracion = match (n("duracionMin"), n("duracionMax")) {
+        (Some(a), Some(b)) if a <= b => Some((u32::try_from(a).ok()?, u32::try_from(b).ok()?)),
+        _ => None,
+    };
+    #[allow(clippy::cast_possible_truncation)]
+    let por_segundo = m
+        .get("creditosPorSegundo")
+        .and_then(Value::as_object)
+        .map(|o| {
+            o.iter()
+                .take(MAX_LISTA)
+                .filter_map(|(r, c)| {
+                    let c = c.as_f64().filter(|c| c.is_finite() && *c >= 0.0 && *c < 1e6)?;
+                    Some((r.clone(), (c * 100.0).round() as i64))
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let (proveedor, nombre) = (s("proveedor"), s("nombre"));
+    Some(Herramienta {
+        nombre: if nombre.is_empty() { proveedor } else { nombre },
+        id,
+        familia,
+        descripcion: s("descripcion"),
+        creditos: m.get("creditos").and_then(Value::as_i64),
+        por_mil: m.get("creditosPorMil").and_then(Value::as_i64),
+        max_texto: n("maxTexto").and_then(|x| usize::try_from(x).ok()).unwrap_or(0),
+        idioma: m.get("idioma").and_then(Value::as_bool).unwrap_or(false),
+        voces,
+        duracion,
+        max_segundos: n("maxSegundos").and_then(|x| u32::try_from(x).ok()).unwrap_or(60),
+        max_megas: n("maxMegas").unwrap_or(50),
+        por_segundo,
+    })
+}
