+    let seq = app.session.state.active_sequence.expect("sequence");
+    let (clip, inicio) = {
+        let a = &app.session.active_sequence().expect("seq").audio_tracks[0].items[0];
+        (a.id, a.start)
+    };
+    (app, seq, clip, inicio)
+}
