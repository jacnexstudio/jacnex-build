@@ -0,0 +1,47 @@
+//! Filmnex voice separation: splits what is said from the music and the effects.
+//!
+//! The network is a Mel-Band RoFormer (`model`, behind the `candle` feature: pure Rust on the CPU). Around it,
+//! [`pipeline`] cuts any clip into overlapping chunks of the length the network wants, resamples each one from
+//! the clip's own rate (and the result back), and joins the chunks with a cross-fade, so memory stays bounded
+//! however long the clip is. The network is behind the [`pipeline::ChunkModel`] trait, so all of that is tested
+//! without model files.
+
+pub mod fft;
+pub mod pipeline;
+pub mod resample;
+pub mod stft;
+
+#[cfg(feature = "candle")]
+pub mod model;
+
+use std::fmt;
+
+pub use pipeline::{ChunkModel, Stems, separate};
+
+/// What can go wrong.
+#[derive(Debug)]
+pub enum SeparateError {
+    /// The audio or a parameter is not usable.
+    Input(String),
+    /// A model file is missing, damaged or not the expected network.
+    Model(String),
+    /// The network failed while running.
+    Net(String),
+    /// The caller asked to stop.
+    Stopped,
+}
+
+impl fmt::Display for SeparateError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Input(e) => write!(f, "audio: {e}"),
+            Self::Model(e) => write!(f, "model: {e}"),
+            Self::Net(e) => write!(f, "network: {e}"),
+            Self::Stopped => f.write_str("separation stopped"),
+        }
+    }
+}
+
+impl std::error::Error for SeparateError {}
+
+pub type Result<T> = std::result::Result<T, SeparateError>;
