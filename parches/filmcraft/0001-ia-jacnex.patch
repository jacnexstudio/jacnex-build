@@ -0,0 +1,232 @@
+//! Jacnex: transcribir con Nemotron 3.5 Transcribe (NVIDIA), en el servidor de Jacnex. Usa
+//! créditos (0,3 por minuto de audio) y no necesita descargar nada ni memoria de sobra.
+//!
+//! El audio va en WAV (16 kHz, mono, 16 bits) en partes de hasta 20 minutos; el servidor cobra
+//! por los segundos que dice la cabecera del WAV (mínimo 1 crédito por parte). Lo que vuelve es
+//! un JSON con cada palabra, su tiempo y quién habla.
+
+use filmcraft_project::{Speaker, Transcript, Word, transcript::normalize_word};
+use filmcraft_speech::{Options, ProgressFn, SAMPLE_RATE, SpeechError, Transcriber, seconds_tick};
+use serde_json::Value;
+
+use crate::jacnex_ia::{Conexion, MotorNube};
+
+/// El id del motor en el servidor.
+pub const MODELO: &str = "nemotron-transcribe";
+/// Lo que queda en `Transcript::source`.
+pub const FUENTE: &str = "nemotron-3.5";
+/// El error de una transcripción detenida.
+pub const DETENIDO: &str = "transcription stopped";
+/// La parte más larga que se envía, en segundos (el servidor acepta hasta 25 minutos).
+pub const PARTE: u32 = 20 * 60;
+/// El precio si el catálogo aún no llegó: centésimas de crédito por minuto.
+pub const POR_MINUTO: i64 = 30;
+/// Lo más que se toma de cada parte (un JSON hostil no llena la memoria).
+const MAX_PALABRAS: usize = 100_000;
+/// Hablantes distintos que se distinguen; el resto queda sin hablante.
+const MAX_HABLANTES: usize = 32;
+/// Lo más largo de una palabra, en caracteres.
+const MAX_LETRAS: usize = 64;
+
+/// Cómo se divide y se cobra lo que se envía.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Plan {
+    /// Segundos de cada parte.
+    pub parte: u32,
+    /// Centésimas de crédito por minuto.
+    pub por_minuto: i64,
+}
+
+impl Plan {
+    /// Según el catálogo del servidor (o los valores de siempre si no llegó): partes que no pasan
+    /// del límite de duración ni de peso.
+    pub(crate) fn de(m: Option<&MotorNube>) -> Self {
+        let Some(m) = m else { return Self { parte: PARTE, por_minuto: POR_MINUTO } };
+        let por_peso = (m.max_megas.saturating_mul(1024 * 1024).saturating_sub(1024) / (u64::from(SAMPLE_RATE) * 2)).min(u64::from(u32::MAX));
+        let parte = PARTE.min(m.max_segundos).min(u32::try_from(por_peso).unwrap_or(u32::MAX)).max(60);
+        Self { parte, por_minuto: m.por_minuto }
+    }
+
+    /// Los créditos de una parte de `segundos` (como el servidor: segundos enteros hacia arriba,
+    /// mínimo 1 crédito).
+    fn creditos_parte(&self, segundos: f64) -> i64 {
+        #[allow(clippy::cast_possible_truncation)]
+        let s = (segundos - 1e-6).ceil().max(1.0) as i64;
+        s.saturating_mul(self.por_minuto).saturating_add(5999).div_euclid(6000).max(1)
+    }
+
+    /// Lo que cuesta transcribir un clip de `segundos`.
+    pub fn creditos(&self, segundos: f64) -> i64 {
+        if !segundos.is_finite() || segundos <= 0.0 {
+            return 0;
+        }
+        let parte = f64::from(self.parte);
+        let enteras = (segundos / parte).floor();
+        let resto = segundos - enteras * parte;
+        #[allow(clippy::cast_possible_truncation)]
+        let mut total = (enteras as i64).saturating_mul(self.creditos_parte(parte));
+        if resto > 1e-3 {
+            total = total.saturating_add(self.creditos_parte(resto));
+        }
+        total
+    }
+}
+
+/// El transcriptor: manda cada parte al servidor de Jacnex.
+pub struct Nemotron {
+    pub(crate) conexion: Conexion,
+    pub plan: Plan,
+}
+
+/// Un WAV PCM de 16 bits, mono, 16 kHz.
+pub fn wav(muestras: &[f32]) -> Vec<u8> {
+    let datos = u32::try_from(muestras.len().saturating_mul(2)).unwrap_or(u32::MAX - 64) & !1;
+    let mut out = Vec::with_capacity(44 + datos as usize);
+    out.extend_from_slice(b"RIFF");
+    out.extend_from_slice(&datos.saturating_add(36).to_le_bytes());
+    out.extend_from_slice(b"WAVEfmt ");
+    out.extend_from_slice(&16u32.to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes());
+    out.extend_from_slice(&1u16.to_le_bytes());
+    out.extend_from_slice(&SAMPLE_RATE.to_le_bytes());
+    out.extend_from_slice(&(SAMPLE_RATE * 2).to_le_bytes());
+    out.extend_from_slice(&2u16.to_le_bytes());
+    out.extend_from_slice(&16u16.to_le_bytes());
+    out.extend_from_slice(b"data");
+    out.extend_from_slice(&datos.to_le_bytes());
+    for m in muestras.iter().take(datos as usize / 2) {
+        let m = if m.is_finite() { m.clamp(-1.0, 1.0) } else { 0.0 };
+        #[allow(clippy::cast_possible_truncation)]
+        out.extend_from_slice(&((m * 32767.0).round() as i16).to_le_bytes());
+    }
+    out
+}
+
+/// Un número del JSON (o un texto con un número).
+fn numero(v: Option<&Value>) -> Option<f64> {
+    let v = v?;
+    v.as_f64().or_else(|| v.as_str().and_then(|s| s.trim().parse().ok())).filter(|x: &f64| x.is_finite())
+}
+
+/// Las palabras de un resultado (`words: [{word, start, end, speaker}]`), con la puntuación y las
+/// mayúsculas de `text` cuando coinciden. Los tiempos se corren `desde` segundos y no pasan de
+/// `hasta`; los hablantes se numeran por orden de aparición en `hablantes`.
+pub fn leer(v: &Value, desde: f64, hasta: f64, hablantes: &mut Vec<String>, palabras: &mut Vec<Word>) {
+    let Some(lista) = v.get("words").and_then(Value::as_array) else { return };
+    let texto: Vec<&str> = v.get("text").and_then(Value::as_str).map_or_else(Vec::new, |t| t.split_whitespace().take(MAX_PALABRAS * 2).collect());
+    let mut k = 0usize;
+    for w in lista.iter().take(MAX_PALABRAS) {
+        let Some(bruta) = w.get("word").or_else(|| w.get("text")).and_then(Value::as_str) else { continue };
+        let bruta = bruta.trim();
+        let (Some(a), Some(b)) = (numero(w.get("start")), numero(w.get("end"))) else { continue };
+        if bruta.is_empty() || a < 0.0 || b < a {
+            continue;
+        }
+        let a = (desde + a).min(hasta);
+        let b = (desde + b).min(hasta).max(a);
+        // la palabra con su puntuación, si el texto completo la trae en el mismo orden
+        let buscada = normalize_word(bruta);
+        let mut texto_palabra = bruta;
+        for salto in 0..3 {
+            if let Some(t) = texto.get(k + salto)
+                && normalize_word(t) == buscada
+            {
+                texto_palabra = t;
+                k += salto + 1;
+                break;
+            }
+        }
+        let texto_palabra: String = texto_palabra.chars().take(MAX_LETRAS).collect();
+        let mut palabra = Word::new(texto_palabra, seconds_tick(a), seconds_tick(b));
+        palabra.speaker = hablante(w.get("speaker"), hablantes);
+        palabras.push(palabra);
+    }
+}
+
+/// El número de `speaker` («speaker_0», 0…) por orden de aparición.
+fn hablante(v: Option<&Value>, hablantes: &mut Vec<String>) -> Option<u32> {
+    let v = v?;
+    let nombre = match v {
+        Value::String(s) => s.chars().take(MAX_LETRAS).collect(),
+        Value::Number(n) => n.to_string(),
+        _ => return None,
+    };
+    if nombre.is_empty() {
+        return None;
+    }
+    let i = match hablantes.iter().position(|h| *h == nombre) {
+        Some(i) => i,
+        None if hablantes.len() < MAX_HABLANTES => {
+            hablantes.push(nombre);
+            hablantes.len() - 1
+        }
+        None => return None,
+    };
+    u32::try_from(i).ok()
+}
+
+/// El idioma más probable de `palabras` (es, en o pt) por sus palabras más comunes; «es» si no se
+/// sabe. Nemotron no lo informa y las muletillas dependen del idioma.
+pub fn idioma(palabras: &[Word]) -> String {
+    const ES: &[&str] = &["que", "el", "la", "los", "las", "y", "es", "por", "con", "una", "para", "del", "pero", "como", "muy", "está", "esto", "yo"];
+    const EN: &[&str] = &["the", "and", "to", "is", "that", "it", "you", "of", "this", "for", "with", "was", "are", "what", "i", "we", "have"];
+    const PT: &[&str] = &["não", "você", "é", "uma", "com", "do", "da", "os", "para", "mas", "como", "muito", "está", "isso", "eu", "também"];
+    let mut cuentas = [0usize; 3];
+    for w in palabras.iter().take(5000) {
+        let n = w.normalized();
+        for (c, lista) in cuentas.iter_mut().zip([ES, EN, PT]) {
+            if lista.contains(&n.as_str()) {
+                *c += 1;
+            }
+        }
+    }
+    let [es, en, pt] = cuentas;
+    if en > es && en >= pt {
+        "en".into()
+    } else if pt > es && pt > en {
+        "pt".into()
+    } else {
+        "es".into()
+    }
+}
+
+impl Transcriber for Nemotron {
+    fn id(&self) -> String {
+        FUENTE.into()
+    }
+
+    fn transcribe(&self, audio: &[f32], opts: &Options, progress: ProgressFn) -> Result<Transcript, SpeechError> {
+        let paso = (self.plan.parte.max(60) * SAMPLE_RATE) as usize;
+        let partes = audio.len().div_ceil(paso).max(1);
+        let mut hablantes = Vec::new();
+        let mut palabras = Vec::new();
+        for (k, trozo) in audio.chunks(paso).enumerate() {
+            let base = k as f32 / partes as f32;
+            if !progress(base, "Sending") {
+                return Err(SpeechError::Cancelled);
+            }
+            let desde = (k * paso) as f64 / f64::from(SAMPLE_RATE);
+            let hasta = desde + trozo.len() as f64 / f64::from(SAMPLE_RATE);
+            let mut seguir = |f: f32| progress(base + f.clamp(0.0, 0.95) / partes as f32, "Transcribing");
+            let v = crate::jacnex_ia::transcribir_wav(&self.conexion, MODELO, wav(trozo), &mut seguir)
+                .map_err(|m| if m == DETENIDO { SpeechError::Cancelled } else { SpeechError::Io(m) })?;
+            leer(&v, desde, hasta, &mut hablantes, &mut palabras);
+        }
+        let mut t =
+            Transcript { language: opts.language.clone().unwrap_or_else(|| idioma(&palabras)), source: FUENTE.into(), speakers: Vec::new(), words: palabras };
+        if opts.diarize && !hablantes.is_empty() {
+            t.speakers = (1..=hablantes.len()).map(|i| Speaker { name: format!("Speaker {i}") }).collect();
+        } else {
+            t.speakers = vec![Speaker { name: "Speaker 1".into() }];
+            for w in &mut t.words {
+                w.speaker = Some(0);
+            }
+        }
+        t.normalize();
+        Ok(t)
+    }
+}
+
+#[cfg(test)]
+#[path = "jacnex_nemotron_tests.rs"]
+mod tests;
