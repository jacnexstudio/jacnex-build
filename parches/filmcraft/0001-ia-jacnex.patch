+/// Un botón de ícono pequeño.
+fn boton_icono(ui: &mut egui::Ui, icono: crate::icons::Icon, ayuda: &str, t: &crate::theme::Tokens) -> egui::Response {
+    let (rect, resp) = ui.allocate_exact_size(egui::vec2(22.0, 22.0), egui::Sense::click());
+    if resp.hovered() {
+        ui.painter().rect_filled(rect, 4.0, t.hover);
+    }
+    crate::icons::paint(ui.painter(), rect.shrink(5.0), icono, if resp.hovered() { t.text } else { t.text_dim });
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Button, true, ayuda));
+    resp.on_hover_text(ayuda)
+}
+
+/// El botón principal, de color.
+pub(crate) fn boton_acento(ui: &mut egui::Ui, texto: &str, tam: egui::Vec2, activo: bool) -> egui::Response {
+    // Jacnex: el texto centrado (un relleno a cada lado)
+    let contenido = (egui::Atom::grow(), RichText::new(texto).strong().color(Color32::WHITE), egui::Atom::grow());
+    let b = egui::Button::new(contenido).fill(ACENTO).corner_radius(8.0).min_size(tam);
+    ui.add_enabled(activo, b)
+}
+
+/// El título de una sección, en versalitas tenues.
+pub(crate) fn titulo(ui: &mut egui::Ui, texto: &str, t: &crate::theme::Tokens) -> egui::Response {
+    ui.label(RichText::new(texto.to_uppercase()).size(10.5).strong().color(t.text_dim))
+}
+
+/// Los créditos de la cuenta, en una píldora.
+fn pastilla(ui: &mut egui::Ui, texto: &str) -> egui::Response {
+    let galley = ui.painter().layout_no_wrap(texto.to_string(), egui::FontId::proportional(12.0), ACENTO_CLARO);
+    let (rect, resp) = ui.allocate_exact_size(galley.size() + egui::vec2(18.0, 8.0), egui::Sense::hover());
+    let p = ui.painter();
+    p.rect_filled(rect, rect.height() / 2.0, ACENTO.gamma_multiply(0.22));
+    p.rect_stroke(rect, rect.height() / 2.0, egui::Stroke::new(1.0, ACENTO.gamma_multiply(0.55)), egui::StrokeKind::Inside);
+    p.galley(rect.center() - galley.size() / 2.0, galley, ACENTO_CLARO);
+    resp.widget_info(|| egui::WidgetInfo::labeled(egui::Role::Label, true, texto));
+    resp
+}
