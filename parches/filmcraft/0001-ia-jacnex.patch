+    };
+    let dub::Placed::Track(a) = dub::place(&mut s, made_for, &d).unwrap() else { panic!("track expected") };
+    assert_eq!((a.background_track, a.track), (Some(tracks), tracks + 1));
+    let q = s.active_sequence().unwrap();
+    assert_eq!(q.audio_tracks.len(), tracks + 2);
+    let (b, v) = (&q.audio_tracks[tracks].items, &q.audio_tracks[tracks + 1].items);
+    assert_eq!((b.len(), v.len()), (1, 1));
+    assert_eq!((b[0].start, v[0].start), (start, start), "both aligned to the clip");
+    assert!((b[0].duration.seconds() - 3.0).abs() < 0.05 && (v[0].duration.seconds() - 3.0).abs() < 0.05);
+    assert_eq!(b[0].gain_db, 0.0, "the background is at full level");
+    assert_eq!(q.find_item(clip).unwrap().1.gain_db, dub::MUTE_DB, "the original is muted, not deleted");
+    q.check().unwrap();
