+/// Controlled speaker test: two single-speaker clips side by side, the sound alternating between
+/// them every `REFRAME_ASD_SWAP` seconds. Needs `REFRAME_ASD_A`, `REFRAME_ASD_B` (absolute paths).
+#[test]
+fn speaker_follows_the_alternating_audio() {
+    let (Some(pa), Some(pb)) = (std::env::var_os("REFRAME_ASD_A"), std::env::var_os("REFRAME_ASD_B")) else { return };
+    let num = |k: &str, d: f64| std::env::var(k).ok().and_then(|v| v.parse::<f64>().ok()).unwrap_or(d);
+    let (secs, swap, ta, tb) = (num("REFRAME_ASD_SECONDS", 40.0), num("REFRAME_ASD_SWAP", 5.0), num("REFRAME_ASD_A_AT", 0.0), num("REFRAME_ASD_B_AT", 0.0));
+    let mut s = Session::default();
+    let mut ids = Vec::new();
+    for p in [pa, pb] {
+        s.execute("file.import", json!({"paths": [p.to_string_lossy()]})).unwrap();
+        let known: Vec<_> = ids.clone();
+        ids.push(s.project.items.values().find(|i| i.has_video() && i.as_media().is_some() && !known.contains(&i.id)).map(|i| i.id).unwrap());
+    }
+    s.execute("file.newSequence", json!({"name": "S", "video": 1, "audio": 1, "width": 1280, "height": 360})).unwrap();
+    s.execute("timeline.place", json!({"item": ids[0].0, "time": 0})).unwrap();
+    let mut w = reframe_job(&s, Aspect::VERTICAL).unwrap().clips.remove(0);
+    w.size = (1280, 360);
+    w.item.duration = Tick::from_seconds_f64(secs);
+    let srcs = [s.source(ids[0]).unwrap(), s.source(ids[1]).unwrap()];
+    let starts = [ta, tb];
+    let cw = num("REFRAME_ASD_HALF", 640.0) as usize;
+    let ch = cw * 9 / 16;
+    // "listen" mode: the side without the sound shows that person quiet (loop:START:LEN seconds of the
+    // clip, played again and again, or still:T, one held frame); "both" keeps both mouths moving
+    let listen = std::env::var("REFRAME_ASD_MODE").is_ok_and(|m| m == "listen");
+    let quiet: Vec<String> = ["REFRAME_ASD_QUIET_A", "REFRAME_ASD_QUIET_B"].iter().map(|k| std::env::var(k).unwrap_or_else(|_| "still:0".into())).collect();
+    let video_time = |k: usize, t: f64| -> f64 {
+        let seg = (t / swap).floor() as i64;
+        if !listen || seg.rem_euclid(2) as usize == k {
+            return starts[k] + t;
+        }
+        let parts: Vec<&str> = quiet[k].split(':').collect();
+        let n = |i: usize| parts.get(i).and_then(|v| v.parse::<f64>().ok()).unwrap_or(0.0);
+        if parts[0] == "loop" { n(1) + (t % n(2).max(0.5)) } else { n(1) }
+    };
+    let frame = |t: f64| -> Result<(Vec<u8>, usize, usize)> {
+        let mut out = vec![255u8; 2 * cw * ch * 4];
+        for (k, src) in srcs.iter().enumerate() {
+            let info = src.info().video.clone().unwrap();
+            let f = src
+                .video_frame(FrameRequest { time: Tick::from_seconds_f64(video_time(k, t)), scale: (cw as f32 / info.width as f32).min(1.0) })
+                .map_err(|e| EngineError::Other(e.to_string()))?;
+            let px = f.to_rgba8();
+            for y in 0..ch {
+                for x in 0..cw {
+                    let (sx, sy) = (x * f.width as usize / cw, y * f.height as usize / ch);
+                    let i = (sy * f.width as usize + sx) * 4;
+                    let o = (y * 2 * cw + k * cw + x) * 4;
+                    out[o..o + 4].copy_from_slice(&px[i..i + 4]);
+                }
+            }
+        }
+        Ok((out, 2 * cw, ch))
+    };
+    let sr = filmcraft_reframe::mfcc::SAMPLE_RATE;
+    let audio = |at: f64, n: usize| -> Vec<f32> {
+        let mut mix = vec![0.0f32; n];
+        for (k, src) in srcs.iter().enumerate() {
+            let b = src
+                .audio(((starts[k] + at + num("REFRAME_ASD_SHIFT", 0.0)).max(0.0) * sr as f64) as i64, n, sr as u32)
+                .map(|b| filmcraft_speech::downmix(&b.channels))
+                .unwrap_or_default();
+            for (i, v) in b.iter().enumerate().take(n) {
+                let seg = ((at + i as f64 / sr as f64) / swap).floor() as i64;
+                if seg.rem_euclid(2) as usize == k {
+                    mix[i] = *v;
+                }
+            }
+        }
+        mix
+    };
+    fn audio_of(src: &SharedSource, at: f64, sr: usize) -> Vec<f32> {
+        src.audio((at * sr as f64) as i64, sr, sr as u32).map(|b| filmcraft_speech::downmix(&b.channels)).unwrap_or_default()
+    }
+    let feed = Feed { frame: &frame, audio: &audio };
+    let nets = nets::load(&models_dir().unwrap()).unwrap();
+    let n = (secs / STEP) as usize;
+    let times: Vec<f64> = (0..n).map(|i| i as f64 * STEP).collect();
+    let dets: Vec<Vec<Det>> = times
+        .iter()
+        .map(|t| {
+            let (px, fw, fh) = frame(*t).unwrap();
+            nets.faces(&Image::new(&px, fw, fh).unwrap()).unwrap()
+        })
+        .collect();
+    if let Some(dir) = std::env::var_os("REFRAME_ASD_DUMP") {
+        for t in [3.0, 12.0, 22.0] {
+            let (px, fw, fh) = frame(t).unwrap();
+            image::save_buffer(std::path::Path::new(&dir).join(format!("comp{t}.png")), &px, fw as u32, fh as u32, image::ColorType::Rgba8).unwrap();
+            let img = Image::new(&px, fw, fh).unwrap();
+            for (j, d) in nets.faces(&img).unwrap().iter().enumerate() {
+                let c: Vec<u8> = nets::face_crop(&img, &d.rect).iter().map(|v| *v as u8).collect();
+                image::save_buffer(std::path::Path::new(&dir).join(format!("crop{t}_{j}.png")), &c, 112, 112, image::ColorType::L8).unwrap();
+            }
+        }
+        for k in 0..2 {
+            let rms: Vec<String> = (0..secs as usize)
+                .map(|s| {
+                    format!("{:.3}", {
+                        let b = audio_of(&srcs[k], starts[k] + s as f64, sr);
+                        (b.iter().map(|v| v * v).sum::<f32>() / b.len().max(1) as f32).sqrt()
+                    })
+                })
+                .collect();
+            eprintln!("audio rms {k}: {}", rms.join(" "));
+        }
+        if std::env::var_os("REFRAME_ASD_RMS_ONLY").is_some() {
+            return;
+        }
+    }
+    let ids = link(&dets);
+    let mut a = Analysis {
+        dur: secs,
+        times,
+        speaking: dets.iter().map(|d| vec![0.5; d.len()]).collect(),
+        dets,
+        ids,
+        cuts: Vec::new(),
+        segs: Vec::new(),
+        turns: Vec::new(),
+    };
+    let mut sink = |_: ReframeProgress| true;
+    let mut cx = Cx { prog: &mut sink, clip: 0, of: 1 };
+    let mut budget = MAX_ASD_FRAMES;
+    let t0 = Instant::now();
+    let wins = speakers(&feed, &nets, &mut a, &mut cx, &mut budget).unwrap();
+    eprintln!("speaker pass {:.1}s for {secs}s, {} windows, {} frames", t0.elapsed().as_secs_f64(), wins.len(), MAX_ASD_FRAMES - budget);
+    eprintln!("turns (camera cuts): {:?}", a.turns.iter().map(|t| (t * 10.0).round() / 10.0).collect::<Vec<_>>());
+    // which side a face track is on
+    let side_of = |id: u32| -> usize {
+        let xs: Vec<f32> =
+            (0..a.times.len()).flat_map(|i| a.ids[i].iter().zip(&a.dets[i]).filter(|(x, _)| **x == id).map(|(_, d)| d.rect.cx()).collect::<Vec<_>>()).collect();
+        usize::from(xs.iter().sum::<f32>() / xs.len().max(1) as f32 >= 0.5)
+    };
+    let sides: std::collections::HashMap<u32, usize> = a.ids.iter().flatten().map(|id| (*id, side_of(*id))).collect();
+    let segs = a.segs.clone();
+    let table: Vec<(f64, f32, f32)> = (0..(secs * 5.0) as usize)
+        .map(|k| {
+            let t = k as f64 * 0.2;
+            let s = gate::scores(&wins, t).unwrap_or_default();
+            let get = |side: usize| s.iter().filter(|(id, _)| sides.get(id) == Some(&side)).map(|(_, v)| *v).fold(f32::NAN, f32::max);
+            (t, get(0), get(1))
+        })
+        .collect();
+    let seg_pick = |t: f64| -> char {
+        match gate::seg_at(&segs, t).and_then(|s| s.who) {
+            Some(id) => {
+                if sides.get(&id) == Some(&0) {
+                    'L'
+                } else {
+                    'R'
+                }
+            }
+            None => '-',
+        }
+    };
+    let plan = plan_clip(&w, a, Aspect::VERTICAL);
+    let cam = |t: f64| -> f32 {
+        let shot = plan.shots.iter().find(|s| t >= s.start && t < s.end).unwrap_or(&plan.shots[0]);
+        let keys = &shot.keys;
+        let i = keys.partition_point(|k| f64::from(k.t as f32) <= t).saturating_sub(1);
+        let (p, q) = (keys[i], keys[(i + 1).min(keys.len() - 1)]);
+        let f = if q.t > p.t { ((t - p.t) / (q.t - p.t)).clamp(0.0, 1.0) as f32 } else { 0.0 };
+        p.cx + (q.cx - p.cx) * f
+    };
+    let (mut hit, mut total, mut picked, mut wrong) = (0, 0, 0, 0);
+    // the true speaker at every instant, and how far the camera / decision trail it after each change
+    let truth = |t: f64| if ((t / swap).floor() as i64) % 2 == 0 { 'L' } else { 'R' };
+    eprintln!("sec | audio | scoreL scoreR | speaker | camera x | follows");
+    for sec in 0..secs as usize {
+        let t = sec as f64 + 0.5;
+        let side = truth(t);
+        let (mut l, mut r) = (Vec::new(), Vec::new());
+        for (tt, sl, sr_) in &table {
+            if (*tt - t).abs() <= 0.5 {
+                l.push(*sl);
+                r.push(*sr_);
+            }
+        }
+        let avg = |v: &[f32]| {
+            let v: Vec<f32> = v.iter().copied().filter(|x| !x.is_nan()).collect();
+            if v.is_empty() { f32::NAN } else { v.iter().sum::<f32>() / v.len() as f32 }
+        };
+        let c = cam(t);
+        let cam_side = if c < 0.5 { 'L' } else { 'R' };
+        let pick = seg_pick(t);
+        total += 1;
+        hit += usize::from(cam_side == side);
+        picked += usize::from(pick == side);
+        wrong += usize::from(pick != side && pick != '-');
+        eprintln!(
+            "{sec:3} | {side} | {:.2} {:.2} | speaker {pick} | camera x {c:.2} {cam_side} | {}",
+            avg(&l),
+            avg(&r),
+            if cam_side == side { "yes" } else { "NO" }
+        );
+    }
+    // after each true change, how long until the decision / the camera are on the new side
+    for (name, f) in [("speaker", &seg_pick as &dyn Fn(f64) -> char), ("camera", &|t: f64| if cam(t) < 0.5 { 'L' } else { 'R' })] {
+        let mut lags = Vec::new();
+        let mut k = 1;
+        while (k as f64) * swap < secs - 1.0 {
+            let t0 = k as f64 * swap;
+            let want = truth(t0 + 0.1);
+            let lag = (0..(swap * 20.0) as usize).map(|j| t0 + j as f64 * 0.05).find(|t| f(*t) == want).map(|t| t - t0);
+            lags.push(lag.map_or("never".to_string(), |l| format!("{l:.2}")));
+            k += 1;
+        }
+        eprintln!("{name} lag after each change (s): {}", lags.join(" "));
+    }
+    let mut acc = [[0.0f32; 2]; 4];
+    for (tt, sl, sr_) in &table {
+        let side = usize::from(((tt / swap).floor() as i64) % 2 != 0);
+        for (face, v) in [(0usize, *sl), (1usize, *sr_)] {
+            if !v.is_nan() {
+                let slot = face * 2 + usize::from(face == side);
+                acc[slot][0] += v;
+                acc[slot][1] += 1.0;
+            }
+        }
+    }
+    let m = |k: usize| acc[k][0] / acc[k][1].max(1.0);
+    eprintln!("mean score: left face with its audio {:.2} / other audio {:.2}; right face with its audio {:.2} / other audio {:.2}", m(1), m(0), m(3), m(2));
+    eprintln!("speaker decision right {picked}/{total}, wrong {wrong}; camera on the talking side: {hit}/{total}");
+}
diff --git a/crates/engine/src/reframe_par.rs b/crates/engine/src/reframe_par.rs
new file mode 100644
index 0000000..efe5678
--- /dev/null
+++ b/crates/engine/src/reframe_par.rs
@@ -0,0 +1,142 @@
+//! Jacnex: Pasar a vertical, a small bounded worker pool. The networks and the decoder each use a
+//! few cores on their own; a handful of frames in flight at once keeps the whole machine busy.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::sync::{Mutex, PoisonError};
+use std::time::Duration;
+
+/// Why a parallel run did not finish.
+#[derive(Debug, PartialEq)]
+pub enum ParError {
+    /// `tick` asked to stop.
+    Stopped,
+    /// A piece of work failed (the first message) or a worker died.
+    Failed(String),
+}
+
+/// The most workers ever started.
+pub const MAX_WORKERS: usize = 6;
+
+/// How many workers to use on this computer.
+pub fn workers() -> usize {
+    let cores = std::thread::available_parallelism().map_or(2, std::num::NonZeroUsize::get);
+    (cores / 3).clamp(1, 4).min(MAX_WORKERS)
+}
+
+/// Runs `work(0..count)` on `workers` threads and returns the results in order. `tick(done)` is
+/// called on the calling thread about every 40 ms and once at the end; returning false stops the
+/// run (work already started finishes first).
+pub fn par_map<T: Send>(
+    count: usize,
+    workers: usize,
+    work: &(dyn Fn(usize) -> Result<T, String> + Sync),
+    tick: &mut dyn FnMut(usize) -> bool,
+) -> Result<Vec<T>, ParError> {
+    if count == 0 {
+        return Ok(Vec::new());
+    }
+    let workers = workers.clamp(1, MAX_WORKERS).min(count);
+    let next = AtomicUsize::new(0);
+    let done = AtomicUsize::new(0);
+    let alive = AtomicUsize::new(0);
+    let stop = AtomicBool::new(false);
+    let slots: Mutex<Vec<Option<Result<T, String>>>> = Mutex::new((0..count).map(|_| None).collect());
+    let mut stopped = false;
+    std::thread::scope(|sc| {
+        for _ in 0..workers {
+            alive.fetch_add(1, Ordering::SeqCst);
+            let spawned = std::thread::Builder::new().name("jacnex-vertical-worker".into()).spawn_scoped(sc, || {
+                loop {
+                    if stop.load(Ordering::Relaxed) {
+                        break;
+                    }
+                    let i = next.fetch_add(1, Ordering::SeqCst);
+                    if i >= count {
+                        break;
+                    }
+                    let r = catch_unwind(AssertUnwindSafe(|| work(i))).unwrap_or_else(|_| Err("error interno al analizar un cuadro".into()));
+                    if r.is_err() {
+                        stop.store(true, Ordering::Relaxed);
+                    }
+                    if let Some(s) = slots.lock().unwrap_or_else(PoisonError::into_inner).get_mut(i) {
+                        *s = Some(r);
+                    }
+                    done.fetch_add(1, Ordering::SeqCst);
+                }
+                alive.fetch_sub(1, Ordering::SeqCst);
+            });
+            if spawned.is_err() {
+                alive.fetch_sub(1, Ordering::SeqCst);
+            }
+        }
+        // at most count * 25 polls of 40 ms would be a bug; the loop ends when the work does
+        loop {
+            let d = done.load(Ordering::SeqCst);
+            if !tick(d) {
+                stop.store(true, Ordering::Relaxed);
+                stopped = true;
+                break;
+            }
+            if d >= count || stop.load(Ordering::Relaxed) || alive.load(Ordering::SeqCst) == 0 {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(40));
+        }
+    });
+    if stopped {
+        return Err(ParError::Stopped);
+    }
+    let slots = slots.into_inner().unwrap_or_else(PoisonError::into_inner);
+    let mut out = Vec::with_capacity(count);
+    for s in slots {
+        match s {
+            Some(Ok(v)) => out.push(v),
+            Some(Err(e)) => return Err(ParError::Failed(e)),
+            None => return Err(ParError::Failed("el análisis se interrumpió".into())),
+        }
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn results_come_back_in_order() {
+        let r = par_map(50, 4, &|i| Ok(i * 2), &mut |_| true).unwrap();
+        assert_eq!(r, (0..50).map(|i| i * 2).collect::<Vec<_>>());
+    }
+
+    #[test]
+    fn an_error_stops_the_run() {
+        let r = par_map(100, 3, &|i| if i == 5 { Err("boom".to_string()) } else { Ok(i) }, &mut |_| true);
+        assert_eq!(r, Err(ParError::Failed("boom".into())));
+    }
+
+    #[test]
+    fn a_panic_is_an_error_not_a_crash() {
+        let r = par_map(10, 2, &|i| if i == 3 { panic!("x") } else { Ok(i) }, &mut |_| true);
+        assert!(matches!(r, Err(ParError::Failed(_))));
+    }
+
+    #[test]
+    fn tick_can_stop_it() {
+        let r = par_map(
+            1000,
+            2,
+            &|i| {
+                std::thread::sleep(Duration::from_millis(5));
+                Ok(i)
+            },
+            &mut |d| d < 3,
+        );
+        assert_eq!(r, Err(ParError::Stopped));
+    }
+
+    #[test]
+    fn nothing_to_do_is_fine() {
+        assert_eq!(par_map::<usize>(0, 4, &|i| Ok(i), &mut |_| true), Ok(Vec::new()));
+    }
+}
diff --git a/crates/engine/src/search.rs b/crates/engine/src/search.rs
new file mode 100644
index 0000000..87ce5f1
--- /dev/null
+++ b/crates/engine/src/search.rs
@@ -0,0 +1,924 @@
+//! Jacnex: search inside the footage ("Buscar en el material").
+//!
+//! The user asks in words ("cuando habla del precio", "la toma de la playa"); the engine looks
+//! in what is said (the transcripts, by words and by meaning) and in what is seen (one picture
+//! vector about every second) of every media file of the project.
+//!
+//! - [`index_job`] collects the media on the UI thread (cheap: nothing is decoded); a worker
+//!   thread then runs [`IndexJob::run`], which transcribes what has no transcript, loads the
+//!   models, reads each file's cached index or builds it, and reports progress. Each file is
+//!   indexed once: the index lives in the cache folder, keyed by the file's path, size and
+//!   modification time (see `filmcraft_search::index`), and a stopped job keeps what it did.
+//! - [`Searcher::query`] ranks the moments for a question (fast: the index is in memory).
+//!
+//! The neural models are looked for in Jacnex Studio's models folder and never downloaded here
+//! ([`filmcraft_search::catalog`]). Without them the words are still searched.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+use filmcraft_media::{FrameRequest, SharedSource};
+use filmcraft_project::{ItemId, ItemKind, MediaRef as ProjectMediaRef, Transcript};
+pub use filmcraft_search::catalog::MISSING;
+use filmcraft_search::index::{self, SpeechIndex, VisualIndex};
+pub use filmcraft_search::rank::Hit;
+use filmcraft_search::rank::{self, MediaRef, QueryVectors};
+use filmcraft_search::text::Word;
+use filmcraft_time::Tick;
+
+use crate::speech_job::{self, SpeechJob, SpeechProgress, SpeechResult};
+use crate::{EngineError, Result, Session};
+
+/// Why a job stopped early.
+pub const CANCELLED: &str = "search stopped";
+/// Most media files indexed at once.
+pub const MAX_MEDIA: usize = 2000;
+/// The longest video that is sampled (seconds).
+pub const MAX_VIDEO_SECONDS: f64 = 12.0 * 3600.0;
+/// Seconds between pictures (longer media use a longer step so a file never has too many).
+pub const SAMPLE_SECONDS: f64 = 1.0;
+/// Most pictures of one file.
+pub const MAX_SAMPLES: usize = 14_400;
+/// Chunks of speech embedded per file, at most.
+pub const MAX_CHUNKS: usize = 20_000;
+/// Samples one decoding thread takes at a time (one stretch of video, decoded forward).
+const CHUNK: usize = 16;
+/// Samples in a row that cannot be decoded before the rest of the file is given up on.
+const MAX_FAILED: usize = 5;
+/// Pictures embedded together.
+const BATCH: usize = 4;
+/// Pictures between two saves of a file's index (a stopped job resumes from the last one).
+const CHECKPOINT: usize = 120;
+/// Side of the small grey picture two frames are compared with.
+const THUMB: usize = 16;
+/// Mean difference (0..255) under which a frame counts as the same shot (the vector is reused).
+const SAME: f32 = 2.5;
+/// Mean difference over which a frame is a cut (the moment half way is sampled too).
+const CUT: f32 = 40.0;
+
+/// A picture to embed: RGBA8, row by row.
+pub struct Pic<'a> {
+    pub rgba: &'a [u8],
+    pub width: usize,
+    pub height: usize,
+}
+
+/// Turns pictures and short texts into vectors of one shared space (SigLIP 2 in the app; tests
+/// install their own).
+pub trait PictureEmbedder: Send + Sync {
+    /// A name that goes in the cache file names (the model folder).
+    fn id(&self) -> &str;
+    fn dim(&self) -> usize;
+    /// Square side the pictures are squashed to.
+    fn side(&self) -> usize;
+    fn pictures(&self, p: &[Pic]) -> Result<Vec<Vec<f32>>>;
+    fn text(&self, q: &str) -> Result<Vec<f32>>;
+    /// Scale and bias of the picture-text cosine (`sigmoid(scale * cos + bias)`).
+    fn logit(&self) -> (f32, f32);
+}
+
+/// Turns sentences into vectors of their meaning (Qwen3-Embedding in the app).
+pub trait MeaningEmbedder: Send + Sync {
+    fn id(&self) -> &str;
+    fn dim(&self) -> usize;
+    fn embed(&self, text: &str, query: bool) -> Result<Vec<f32>>;
+}
+
+/// The embedders a search uses (each may be missing).
+#[derive(Clone, Default)]
+pub struct Models {
+    pub picture: Option<Arc<dyn PictureEmbedder>>,
+    pub meaning: Option<Arc<dyn MeaningEmbedder>>,
+}
+
+/// Which of the models are installed, and what to tell the user when one is not.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct ModelStatus {
+    pub picture: bool,
+    pub meaning: bool,
+}
+
+impl ModelStatus {
+    /// The models folder (`None` when there is none).
+    pub fn of(dir: Option<&Path>) -> ModelStatus {
+        let Some(dir) = dir else { return ModelStatus::default() };
+        ModelStatus {
+            picture: filmcraft_search::catalog::find(dir, filmcraft_search::catalog::VISUAL).is_some(),
+            meaning: filmcraft_search::catalog::find(dir, filmcraft_search::catalog::MEANING).is_some(),
+        }
+    }
+
+    /// Whether this build can run the models at all (feature `search`).
+    pub fn available() -> bool {
+        cfg!(feature = "search")
+    }
+}
+
+/// Where the indexes are kept.
+pub fn cache_dir() -> Option<PathBuf> {
+    crate::autosave::default_data_dir().map(|d| d.join("search"))
+}
+
+/// Loads the installed models from `dir` (Jacnex Studio's models folder). A model that is not
+/// there, or that fails to load, is left out: `notes` says why.
+#[cfg(feature = "search")]
+pub fn load_models(dir: &Path, notes: &mut Vec<String>) -> Models {
+    use filmcraft_search::catalog::{MEANING, VISUAL, find};
+    let mut m = Models::default();
+    if let Some((info, d)) = find(dir, VISUAL) {
+        match real::Picture::load(info.id, &d) {
+            Ok(p) => m.picture = Some(Arc::new(p)),
+            Err(e) => notes.push(format!("no se pudo cargar el modelo de imágenes: {e}")),
+        }
+    }
+    if let Some((info, d)) = find(dir, MEANING) {
+        match real::Meaning::load(info.id, &d) {
+            Ok(p) => m.meaning = Some(Arc::new(p)),
+            Err(e) => notes.push(format!("no se pudo cargar el modelo de significado: {e}")),
+        }
+    }
+    m
+}
+
+/// Without the `search` feature there are no models.
+#[cfg(not(feature = "search"))]
+pub fn load_models(_: &Path, _: &mut Vec<String>) -> Models {
+    Models::default()
+}
+
+#[cfg(feature = "search")]
+mod real {
+    use super::{MeaningEmbedder, Pic, PictureEmbedder};
+    use crate::{EngineError, Result};
+    use filmcraft_search::models as m;
+    use std::path::Path;
+
+    fn e(x: filmcraft_search::SearchError) -> EngineError {
+        EngineError::Other(x.to_string())
+    }
+
+    pub struct Picture {
+        id: String,
+        pictures: m::PictureModel,
+        text: m::PictureText,
+    }
+
+    impl Picture {
+        pub fn load(id: &str, dir: &Path) -> Result<Picture> {
+            Ok(Picture { id: id.into(), pictures: m::PictureModel::load(dir).map_err(e)?, text: m::PictureText::load(dir).map_err(e)? })
+        }
+    }
+
+    impl PictureEmbedder for Picture {
+        fn id(&self) -> &str {
+            &self.id
+        }
+        fn dim(&self) -> usize {
+            self.pictures.dim()
+        }
+        fn side(&self) -> usize {
+            self.pictures.side()
+        }
+        fn pictures(&self, p: &[Pic]) -> Result<Vec<Vec<f32>>> {
+            let v: Vec<m::Picture> = p.iter().map(|p| m::Picture { rgba: p.rgba, width: p.width, height: p.height }).collect();
+            self.pictures.embed(&v).map_err(e)
+        }
+        fn text(&self, q: &str) -> Result<Vec<f32>> {
+            self.text.embed(q).map_err(e)
+        }
+        fn logit(&self) -> (f32, f32) {
+            self.text.logit()
+        }
+    }
+
+    pub struct Meaning {
+        id: String,
+        model: m::MeaningModel,
+    }
+
+    impl Meaning {
+        pub fn load(id: &str, dir: &Path) -> Result<Meaning> {
+            Ok(Meaning { id: id.into(), model: m::MeaningModel::load(dir).map_err(e)? })
+        }
+    }
+
+    impl MeaningEmbedder for Meaning {
+        fn id(&self) -> &str {
+            &self.id
+        }
+        fn dim(&self) -> usize {
+            self.model.dim()
+        }
+        fn embed(&self, text: &str, query: bool) -> Result<Vec<f32>> {
+            self.model.embed(text, query).map_err(e)
+        }
+    }
+}
+
+/// What a running job is doing.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum SearchProgress {
+    /// Transcribing the media that has no transcript yet (the speech job's own progress).
+    Speech(SpeechProgress),
+    /// Loading the models.
+    Loading,
+    /// Reading the words of file `item` (0-based) of `of`.
+    Words { item: usize, of: usize },
+    /// Looking at the pictures of file `item` of `of`; `fraction` (0..1) of it is done.
+    Pictures { item: usize, of: usize, fraction: f32 },
+}
+
+/// One media file of the project.
+struct Entry {
+    item: ItemId,
+    name: String,
+    key: String,
+    source: SharedSource,
+    seconds: f64,
+    video: bool,
+    /// A still picture: one sample.
+    still: bool,
+    transcript: Option<Arc<Transcript>>,
+}
+
+/// An indexing job collected on the UI thread, to run anywhere ([`IndexJob::run`]).
+pub struct IndexJob {
+    entries: Vec<Entry>,
+    speech: Option<SpeechJob>,
+    cache: Option<PathBuf>,
+    models: Models,
+    /// Load the models from here when `models` is empty.
+    models_dir: Option<PathBuf>,
+    /// Things worth telling the user that were found while collecting the job.
+    notes: Vec<String>,
+    /// Opens a file again, with decoders of its own (for the threads that decode ahead).
+    own: Arc<dyn Fn(ItemId) -> Option<SharedSource> + Send + Sync>,
+}
+
+/// Whether the speech model `model` cannot be used here (not installed, or this build cannot transcribe).
+fn speech_missing(model: &str) -> bool {
+    if !filmcraft_speech::available() {
+        return true;
+    }
+    match (filmcraft_speech::models::find(model), crate::transcript::speech_models_dir(model)) {
+        (Some(m), Some(d)) => !filmcraft_speech::models::present(&d, m),
+        _ => true,
+    }
+}
+
+/// One media file's index.
+#[derive(Clone)]
+pub struct Indexed {
+    pub item: ItemId,
+    pub name: String,
+    pub speech: Option<Arc<SpeechIndex>>,
+    pub visual: Option<Arc<VisualIndex>>,
+}
+
+/// What a job made.
+pub struct IndexResult {
+    pub media: Vec<Indexed>,
+    pub searcher: Arc<Searcher>,
+    /// Transcripts made on the way (apply them with [`speech_job::apply_transcripts`]).
+    pub transcripts: Option<SpeechResult>,
+    /// What went wrong without stopping the job (Spanish, for the user).
+    pub notes: Vec<String>,
+}
+
+/// How to collect a job.
+#[derive(Default)]
+pub struct IndexOptions {
+    /// Transcribe what has no transcript with this (an online service); `None`: Whisper.
+    pub transcriber: Option<Arc<dyn filmcraft_speech::Transcriber>>,
+    /// Transcribe at all (off: only the transcripts that exist are searched).
+    pub transcribe: bool,
+    /// The spoken language (`"es"`, `"auto"`…).
+    pub language: String,
+    /// The Whisper model for the missing transcripts.
+    pub whisper_model: String,
+    /// Where the indexes are kept (`None`: nothing is kept).
+    pub cache: Option<PathBuf>,
+    /// Where the models are (`None`: none are used).
+    pub models_dir: Option<PathBuf>,
+    /// Models already loaded (tests).
+    pub models: Models,
+}
+
+/// The project's media items, without duplicates: every file in the bin (the clips of a
+/// sequence are made of these).
+pub fn media_items(s: &Session) -> Vec<ItemId> {
+    s.project.items.iter().filter(|(_, it)| matches!(&it.kind, ItemKind::Media(m) if !m.offline)).map(|(id, _)| *id).take(MAX_MEDIA).collect()
+}
+
+fn file_key(m: &filmcraft_project::MediaClip, name: &str) -> String {
+    match &m.media {
+        ProjectMediaRef::File { path } => index::file_key(Path::new(path)).unwrap_or_else(|| index::key_of(path, m.info.file_size.unwrap_or(0), 0)),
+        ProjectMediaRef::Generator(g) => index::key_of(&format!("generator:{g:?}:{name}"), 0, 0),
+    }
+}
+
+/// Collects an indexing job for the project's media.
+pub fn index_job(s: &Session, o: IndexOptions) -> Result<IndexJob> {
+    let mut entries = Vec::new();
+    for id in media_items(s) {
+        let Some(it) = s.project.item(id) else { continue };
+        let ItemKind::Media(m) = &it.kind else { continue };
+        let seconds = m.duration().seconds();
+        if !seconds.is_finite() || seconds <= 0.0 {
+            continue;
+        }
+        let Some(source) = s.source(id) else { continue };
+        let video = m.info.has_video();
+        let still = video && matches!(m.info.kind, filmcraft_media::MediaKind::Still);
+        if !video && !m.info.has_audio() {
+            continue;
+        }
+        entries.push(Entry {
+            item: id,
+            name: it.name.clone(),
+            key: file_key(m, &it.name),
+            source,
+            seconds: seconds.min(MAX_VIDEO_SECONDS),
+            video,
+            still,
+            transcript: s.project.transcripts.get(&id).cloned(),
+        });
+    }
+    if entries.is_empty() {
+        return Err(EngineError::Other("the project has no media to search".into()));
+    }
+    // what has no transcript yet is transcribed first
+    let mut speech = None;
+    let mut notes = Vec::new();
+    if o.transcribe {
+        let missing: Vec<u64> = entries.iter().filter(|e| e.transcript.is_none() && e.source.info().has_audio()).map(|e| e.item.0).collect();
+        if !missing.is_empty() {
+            let p = serde_json::json!({"items": missing, "language": o.language, "download": false, "model": o.whisper_model});
+            let cannot = o.transcriber.is_none() && s.transcriber.is_none() && speech_missing(&o.whisper_model);
+            let job = match o.transcriber {
+                Some(t) => speech_job::speech_job_using(s, &p, t),
+                None => speech_job::speech_job(s, &p),
+            };
+            // not being able to transcribe is not fatal: the pictures and the words that exist are searched
+            speech = job.ok();
+            if cannot {
+                speech = None;
+                let n = missing.len();
+                let clips = if n == 1 { "1 clip sin transcripción" } else { &format!("{n} clips sin transcripción") };
+                notes.push(format!("{clips}: se buscan solo por imagen. {MISSING}"));
+            }
+        }
+    }
+    let (pool, project, services) = (s.media.clone(), s.project.clone(), s.services.clone());
+    let own = Arc::new(move |item| pool.own_source(&project, item, &*services));
+    Ok(IndexJob { entries, speech, cache: o.cache, models: o.models, models_dir: o.models_dir, notes, own })
+}
+
+fn stop() -> EngineError {
+    EngineError::Other(CANCELLED.into())
+}
+
+/// A transcript's words as the search reads them (seconds), in time order, bounded.
+fn words_of(t: &Transcript) -> Vec<Word> {
+    let mut out = Vec::new();
+    let mut last = 0.0f32;
+    for w in t.words.iter().take(filmcraft_search::text::MAX_WORDS) {
+        let start = w.start.seconds() as f32;
+        let end = w.end.seconds() as f32;
+        if !start.is_finite() || !end.is_finite() || start < 0.0 || w.text.trim().is_empty() {
+            continue;
+        }
+        let start = start.max(last);
+        let end = end.max(start);
+        last = start;
+        out.push(Word { text: w.text.trim().chars().take(80).collect(), start, end });
+    }
+    out
+}
+
+impl IndexJob {
+    /// The media that will be looked at.
+    pub fn items(&self) -> Vec<ItemId> {
+        self.entries.iter().map(|e| e.item).collect()
+    }
+
+    /// The media sources of the job, to make thumbnails of the results ([`thumbnail`]).
+    pub fn sources(&self) -> Sources {
+        self.entries.iter().map(|e| (e.item, e.source.clone(), e.video && e.source.info().video.is_some())).collect()
+    }
+
+    /// Seconds of video that may need to be looked at (an upper bound: cached files are free).
+    pub fn video_seconds(&self) -> f64 {
+        self.entries.iter().filter(|e| e.video && !e.still).map(|e| e.seconds).sum()
+    }
+
+    /// Seconds of audio that will be transcribed first.
+    pub fn speech_seconds(&self) -> f64 {
+        self.speech.as_ref().map_or(0.0, SpeechJob::seconds)
+    }
+
+    /// Runs the job (on any thread). `progress` returns false to stop: the job then fails with
+    /// [`CANCELLED`], keeping what it indexed.
+    pub fn run(self, progress: &mut dyn FnMut(SearchProgress) -> bool) -> Result<IndexResult> {
+        let mut notes = self.notes;
+        let mut transcripts: Option<SpeechResult> = None;
+        if let Some(job) = self.speech {
+            match job.run(&mut |p| progress(SearchProgress::Speech(p))) {
+                Ok(r) => transcripts = Some(r),
+                Err(EngineError::Other(m)) if m == speech_job::CANCELLED => return Err(stop()),
+                Err(e) => notes.push(format!("no se pudo transcribir lo que falta: {e}")),
+            }
+        }
+        if !progress(SearchProgress::Loading) {
+            return Err(stop());
+        }
+        let models = if self.models.picture.is_some() || self.models.meaning.is_some() {
+            self.models.clone()
+        } else if let Some(d) = &self.models_dir {
+            load_models(d, &mut notes)
+        } else {
+            Models::default()
+        };
+        let searcher = Arc::new(Searcher { models: models.clone() });
+        let fresh: BTreeMap<ItemId, &Transcript> = transcripts.iter().flat_map(|r| r.done.iter().map(|(i, t)| (*i, t))).collect();
+        let of = self.entries.len();
+        let mut media = Vec::with_capacity(of);
+        for (k, e) in self.entries.iter().enumerate() {
+            if !progress(SearchProgress::Words { item: k, of }) {
+                return Err(stop());
+            }
+            let transcript = fresh.get(&e.item).copied().or(e.transcript.as_deref());
+            let speech = transcript.and_then(|t| speech_index(e, t, models.meaning.as_deref(), self.cache.as_deref(), &mut notes)).map(Arc::new);
+            let mut visual = None;
+            if e.video
+                && let Some(p) = &models.picture
+            {
+                match visual_index(e, (k, of), p.as_ref(), self.cache.as_deref(), &*self.own, &mut notes, progress) {
+                    Ok(v) => visual = Some(Arc::new(v)),
+                    Err(EngineError::Other(m)) if m == CANCELLED => return Err(stop()),
+                    Err(err) => notes.push(format!("{}: no se pudo mirar el video ({err})", e.name)),
+                }
+            }
+            media.push(Indexed { item: e.item, name: e.name.clone(), speech, visual });
+        }
+        Ok(IndexResult { media, searcher, transcripts, notes })
+    }
+}
+
+/// The words index of `e`: from the cache when it matches the words, else made (and kept).
+fn speech_index(e: &Entry, t: &Transcript, meaning: Option<&dyn MeaningEmbedder>, cache: Option<&Path>, notes: &mut Vec<String>) -> Option<SpeechIndex> {
+    let words = words_of(t);
+    if words.is_empty() {
+        return None;
+    }
+    let path = cache.map(|c| index::speech_path(c, &e.key));
+    let hash = index::words_hash(&words);
+    let mut idx = match path.as_deref().map(SpeechIndex::load) {
+        Some(Ok(i)) if i.words_hash == hash => i,
+        _ => SpeechIndex::from_words(words),
+    };
+    let wanted = meaning.map(|m| m.id().to_string()).unwrap_or_default();
+    let has = idx.has_vectors() && idx.model == wanted;
+    if let Some(m) = meaning
+        && !has
+    {
+        let mut vectors = Vec::new();
+        let mut dim = 0;
+        let mut ok = idx.chunks.len() <= MAX_CHUNKS;
+        for c in idx.chunks.iter().take(MAX_CHUNKS) {
+            match m.embed(&c.text, false) {
+                Ok(v) if !v.is_empty() && (dim == 0 || v.len() == dim) && v.iter().all(|x| x.is_finite()) => {
+                    dim = v.len();
+                    vectors.extend(v);
+                }
+                _ => {
+                    ok = false;
+                    break;
+                }
+            }
+        }
+        if ok && dim > 0 && dim <= index::MAX_DIM {
+            idx.model = wanted;
+            idx.dim = dim;
+            idx.vectors = vectors;
+            if let Some(p) = &path
+                && let Err(err) = idx.save(p)
+            {
+                notes.push(format!("{}: no se pudo guardar el índice ({err})", e.name));
+            }
+        } else if idx.chunks.len() > MAX_CHUNKS {
+            notes.push(format!("{}: tiene demasiado texto; solo se buscan las palabras", e.name));
+        }
+    } else if meaning.is_none()
+        && path.as_ref().is_some_and(|p| !p.exists())
+        && let Some(p) = &path
+    {
+        // words only: still kept, so the chunks are not rebuilt
+        let _ = idx.save(p);
+    }
+    Some(idx)
+}
+
+/// A small grey picture of a frame, to tell whether two frames are the same shot.
+fn thumb(rgba: &[u8], w: usize, h: usize) -> Vec<u8> {
+    let mut out = Vec::with_capacity(THUMB * THUMB);
+    for ty in 0..THUMB {
+        for tx in 0..THUMB {
+            let x = (tx * 2 + 1) * w / (THUMB * 2);
+            let y = (ty * 2 + 1) * h / (THUMB * 2);
+            let o = (y.min(h.saturating_sub(1)) * w + x.min(w.saturating_sub(1))) * 4;
+            let g = match rgba.get(o..o + 3) {
+                Some(p) => (u32::from(p[0]) * 30 + u32::from(p[1]) * 59 + u32::from(p[2]) * 11) / 100,
+                None => 0,
+            };
+            out.push(g as u8);
+        }
+    }
+    out
+}
+
+fn distance(a: &[u8], b: &[u8]) -> f32 {
+    if a.len() != b.len() || a.is_empty() {
+        return 255.0;
+    }
+    a.iter().zip(b).map(|(x, y)| f32::from(x.abs_diff(*y))).sum::<f32>() / a.len() as f32
+}
+
+/// A frame of `e` at `t` seconds, small, as RGBA8.
+fn frame(src: &SharedSource, t: f64, side: usize) -> Result<(Vec<u8>, usize, usize)> {
+    let info = src.info();
+    let full = info.video.as_ref().map_or(1920.0, |v| f64::from(v.width.max(v.height).max(1)));
+    // decode no bigger than twice the side the model looks at
+    let scale = ((side as f64 * 2.0) / full).clamp(0.05, 1.0) as f32;
+    let f = src.video_frame(FrameRequest { time: Tick::from_seconds_f64(t), scale }).map_err(|x| EngineError::Other(x.to_string()))?;
+    let (w, h) = (f.width as usize, f.height as usize);
+    let rgba = f.to_rgba8();
+    if w == 0 || h == 0 || rgba.len() != w.saturating_mul(h).saturating_mul(4) {
+        return Err(EngineError::Other("bad frame".into()));
+    }
+    Ok((rgba, w, h))
+}
+
+/// The pictures index of `e`: from the cache (resumed when it was stopped) else made.
+fn visual_index(
+    e: &Entry,
+    // which entry this is, of how many (for the progress)
+    (k, of): (usize, usize),
+    p: &dyn PictureEmbedder,
+    cache: Option<&Path>,
+    own: &(dyn Fn(ItemId) -> Option<SharedSource> + Sync),
+    notes: &mut Vec<String>,
+    progress: &mut dyn FnMut(SearchProgress) -> bool,
+) -> Result<VisualIndex> {
+    let step = if e.still { e.seconds.max(1.0) } else { SAMPLE_SECONDS.max(e.seconds / MAX_SAMPLES as f64) };
+    let path = cache.map(|c| index::visual_path(c, &e.key, p.id()));
+    let mut idx = match path.as_deref().map(VisualIndex::load) {
+        Some(Ok(v)) if v.model == p.id() && v.dim == p.dim() && (v.interval - step as f32).abs() < 1e-3 => v,
+        _ => VisualIndex::new(p.id(), p.dim(), step as f32, e.seconds as f32),
+    };
+    if idx.complete {
+        return Ok(idx);
+    }
+    let side = p.side();
+    // where a stopped job left off
+    let n = idx.times.last().map_or(0usize, |t| (f64::from(*t) / step).round() as usize + 1);
+    let total = if e.still { 1 } else { ((e.seconds / step).ceil() as usize).clamp(1, MAX_SAMPLES) };
+    let mut since_save = 0usize;
+    let save = |idx: &VisualIndex| {
+        if let Some(p) = &path {
+            let _ = idx.save(p);
+        }
+    };
+    // The pictures are decoded ahead on worker threads (in chunks, each worker with a decoder of its own) while this
+    // thread embeds the ones already decoded, in order. `batch` holds what waits for the model.
+    let mut batch: Vec<(f32, Vec<u8>, usize, usize, Vec<u8>)> = Vec::new();
+    // `same[i]`: sample i of the batch is the same shot as the one before it (no embedding needed)
+    let mut same: Vec<bool> = Vec::new();
+    let start = n;
+    let chunks = total.saturating_sub(start).div_ceil(CHUNK);
+    let plan = Plan { step, side, total, start };
+    let stop_flag = AtomicBool::new(false);
+    let next_chunk = AtomicUsize::new(0);
+    let consumed = AtomicUsize::new(0);
+    let workers = decode_workers(chunks, e.still);
+    let mut cut_short: Option<usize> = None;
+    let (tx, rx) = std::sync::mpsc::channel::<(usize, Chunk)>();
+    let outcome: Result<()> = std::thread::scope(|scope| {
+        for w in 0..workers {
+            let tx = tx.clone();
+            let (stop_flag, next_chunk, consumed, plan) = (&stop_flag, &next_chunk, &consumed, &plan);
+            let spawned =
+                std::thread::Builder::new().name("search-decode".into()).spawn_scoped(scope, move || {
+                    // the first worker reads through the project's source (decoder already warm), the others open the file again
+                    let src = if w == 0 { Some(e.source.clone()) } else { own(e.item) };
+                    let Some(src) = src else { return };
+                    loop {
+                        let c = next_chunk.fetch_add(1, Ordering::SeqCst);
+                        if c >= chunks {
+                            break;
+                        }
+                        // not far ahead of the embedding (bounded memory)
+                        let mut waited = 0u32;
+                        while c > consumed.load(Ordering::SeqCst) + workers + 1 && !stop_flag.load(Ordering::SeqCst) && waited < 60_000 {
+                            std::thread::sleep(std::time::Duration::from_millis(5));
+                            waited += 1;
+                        }
+                        if stop_flag.load(Ordering::SeqCst) {
+                            break;
+                        }
+                        let from = plan.start + c * CHUNK;
+                        let to = (from + CHUNK).min(plan.total);
+                        // a decoder that panics on a hostile file is the same as one that cannot read on: the pass ends there
+                        let made = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| decode_chunk(&src, e, *plan, from, to, stop_flag)))
+                            .unwrap_or(Chunk { samples: Vec::new(), dead: true, stopped: false });
+                        let dead = made.dead || made.stopped;
+                        if tx.send((c, made)).is_err() || dead {
+                            break;
+                        }
+                    }
+                });
+            if spawned.is_err() && w == 0 {
+                // no thread at all: nothing can be decoded
+                return Err(EngineError::Other("could not start the video decoder".into()));
+            }
+        }
+        drop(tx);
+        let mut pending: BTreeMap<usize, Chunk> = BTreeMap::new();
+        let mut c = 0usize;
+        let mut done = start;
+        let result: Result<()> = 'run: {
+            while c < chunks {
+                let got = loop {
+                    if let Some(g) = pending.remove(&c) {
+                        break g;
+                    }
+                    if !progress(SearchProgress::Pictures { item: k, of, fraction: done as f32 / total as f32 }) {
+                        break 'run Err(stop());
+                    }
+                    match rx.recv_timeout(std::time::Duration::from_millis(100)) {
+                        Ok((i, g)) => {
+                            pending.insert(i, g);
+                        }
+                        Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {}
+                        Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {
+                            if !pending.contains_key(&c) {
+                                break 'run Err(EngineError::Other("the video decoder stopped".into()));
+                            }
+                        }
+                    }
+                };
+                if got.stopped {
+                    break 'run Err(stop());
+                }
+                let dead = got.dead;
+                for smp in got.samples {
+                    if !progress(SearchProgress::Pictures { item: k, of, fraction: smp.n as f32 / total as f32 }) {
+                        break 'run Err(stop());
+                    }
+                    if let Some((mt, mr, mw, mh)) = smp.mid {
+                        batch.push((mt, mr, mw, mh, Vec::new()));
+                        same.push(false);
+                    }
+                    batch.push((smp.t, smp.rgba, smp.w, smp.h, smp.thumb));
+                    same.push(smp.same);
+                    done = smp.n + 1;
+                    if batch.len() >= BATCH + 2 || done >= total {
+                        if let Err(x) = drain(&mut idx, &mut batch, &mut same, p) {
+                            break 'run Err(x);
+                        }
+                        since_save += BATCH;
+                        if since_save >= CHECKPOINT {
+                            since_save = 0;
+                            save(&idx);
+                        }
+                    }
+                }
+                if dead {
+                    // the file ends (or breaks) here: what was seen is the index
+                    cut_short = Some(done);
+                    break;
+                }
+                c += 1;
+                consumed.store(c, Ordering::SeqCst);
+            }
+            Ok(())
+        };
+        stop_flag.store(true, Ordering::SeqCst);
+        result
+    });
+    if let Err(x) = outcome {
+        if matches!(&x, EngineError::Other(m) if m == CANCELLED) {
+            // what was embedded stays in the cache
+            drain(&mut idx, &mut batch, &mut same, p).ok();
+            save(&idx);
+        }
+        return Err(x);
+    }
+    drain(&mut idx, &mut batch, &mut same, p)?;
+    if let Some(at) = cut_short {
+        let seconds = idx.times.last().copied().unwrap_or(0.0).max(0.0);
+        notes.push(format!("{}: el video está incompleto o dañado; se buscó hasta el segundo {seconds:.0} (muestra {at} de {total}).", e.name));
+    }
+    idx.complete = true;
+    save(&idx);
+    Ok(idx)
+}
+
+/// What one decoding thread made of a stretch of the video.
+struct Chunk {
+    samples: Vec<Sampled>,
+    /// Decoding failed [`MAX_FAILED`] samples in a row: the file ends (or breaks) here.
+    dead: bool,
+    /// The job was stopped.
+    stopped: bool,
+}
+
+/// One sampled moment, decoded and ready to embed.
+struct Sampled {
+    n: usize,
+    t: f32,
+    /// Empty when it is the same shot as the one before.
+    rgba: Vec<u8>,
+    w: usize,
+    h: usize,
+    thumb: Vec<u8>,
+    same: bool,
+    /// A cut lies before this sample: the moment half way (time, picture, size).
+    mid: Option<(f32, Vec<u8>, usize, usize)>,
+}
+
+/// How a file is sampled.
+#[derive(Clone, Copy)]
+struct Plan {
+    step: f64,
+    side: usize,
+    total: usize,
+    /// First sample of this run (a resumed job starts after what was saved).
+    start: usize,
+}
+
+/// Decodes the samples `from..to`, in order, with `src` (one forward pass: the decoder keeps going from one second to the next).
+fn decode_chunk(src: &SharedSource, e: &Entry, plan: Plan, from: usize, to: usize, stop_flag: &AtomicBool) -> Chunk {
+    let time_of = |n: usize| if e.still { 0.0 } else { (n as f64 * plan.step).min((e.seconds - 0.05).max(0.0)) };
+    // the sample before the chunk tells whether the first one is a cut or the same shot
+    let mut last: Option<Vec<u8>> = None;
+    if from > plan.start
+        && !e.still
+        && let Ok((r, w, h)) = frame(src, time_of(from - 1), plan.side)
+    {
+        last = Some(thumb(&r, w, h));
+    }
+    let mut out = Vec::with_capacity(to.saturating_sub(from));
+    let mut failed = 0usize;
+    for n in from..to {
+        if stop_flag.load(Ordering::SeqCst) {
+            return Chunk { samples: out, dead: false, stopped: true };
+        }
+        let t = time_of(n);
+        let Ok((rgba, w, h)) = frame(src, t, plan.side) else {
+            // past the real end of a truncated file every sample fails: a few in a row end the pass
+            failed += 1;
+            if failed >= MAX_FAILED {
+                return Chunk { samples: out, dead: true, stopped: false };
+            }
+            continue;
+        };
+        failed = 0;
+        let th = thumb(&rgba, w, h);
+        let d = last.as_ref().map_or(255.0, |l| distance(l, &th));
+        let same = d < SAME;
+        // a cut between two samples: the moment in the middle is looked at too
+        let mid = if d > CUT && n > 0 && !e.still && plan.step >= 1.0 {
+            let mt = t - plan.step / 2.0;
+            frame(src, mt, plan.side).ok().map(|(r, mw, mh)| (mt as f32, r, mw, mh))
+        } else {
+            None
+        };
+        out.push(Sampled { n, t: t as f32, rgba: if same { Vec::new() } else { rgba }, w, h, thumb: th.clone(), same, mid });
+        last = Some(th);
+    }
+    Chunk { samples: out, dead: false, stopped: false }
+}
+
+static DECODE_WORKERS: AtomicUsize = AtomicUsize::new(0);
+
+/// Sets how many threads decode the video while the model embeds (0: as many as the computer can spare). For tests and tuning.
+pub fn set_decode_workers(n: usize) {
+    DECODE_WORKERS.store(n, Ordering::SeqCst);
+}
+
+fn decode_workers(chunks: usize, still: bool) -> usize {
+    if still || chunks <= 1 {
+        return 1;
+    }
+    let set = DECODE_WORKERS.load(Ordering::SeqCst);
+    let auto = std::thread::available_parallelism().map_or(2, |n| n.get() / 3).clamp(1, 4);
+    (if set == 0 { auto } else { set }).clamp(1, 8).min(chunks)
+}
+
+/// Embeds the frames of `batch` that are not the same shot as the one before and pushes every
+/// sample (the same-shot ones with the previous vector).
+fn drain(idx: &mut VisualIndex, batch: &mut Vec<(f32, Vec<u8>, usize, usize, Vec<u8>)>, same: &mut Vec<bool>, p: &dyn PictureEmbedder) -> Result<()> {
+    let fresh: Vec<usize> = (0..batch.len()).filter(|i| !same.get(*i).copied().unwrap_or(false)).collect();
+    let mut vectors: Vec<Vec<f32>> = Vec::with_capacity(fresh.len());
+    for group in fresh.chunks(BATCH) {
+        let pics: Vec<Pic> = group.iter().filter_map(|i| batch.get(*i)).map(|(_, r, w, h, _)| Pic { rgba: r, width: *w, height: *h }).collect();
+        let vs = p.pictures(&pics)?;
+        if vs.len() != pics.len() {
+            return Err(EngineError::Other("unexpected model output".into()));
+        }
+        vectors.extend(vs);
+    }
+    let mut fresh_vecs = vectors.into_iter();
+    let mut last: Option<Vec<f32>> = (!idx.times.is_empty()).then(|| idx.vector(idx.times.len() - 1).map(<[f32]>::to_vec)).flatten();
+    for (i, (t, ..)) in batch.iter().enumerate() {
+        let v = if same.get(i).copied().unwrap_or(false) { last.clone() } else { fresh_vecs.next() };
+        if let Some(v) = v {
+            last = Some(v.clone());
+            idx.push(*t, v);
+        }
+    }
+    batch.clear();
+    same.clear();
+    Ok(())
+}
+
+/// Ranks moments for questions. Cheap to share.
+pub struct Searcher {
+    models: Models,
+}
+
+impl Searcher {
+    /// A searcher that uses `models`.
+    pub fn new(models: Models) -> Searcher {
+        Searcher { models }
+    }
+
+    /// The loaded models (to hand to the next job so they are not loaded again).
+    pub fn models(&self) -> Models {
+        self.models.clone()
+    }
+
+    /// Which kinds of search this searcher can do: (words always; meaning; pictures).
+    pub fn abilities(&self) -> (bool, bool) {
+        (self.models.meaning.is_some(), self.models.picture.is_some())
+    }
+
+    /// The best moments of `media` for `query`.
+    pub fn query(&self, query: &str, media: &[Indexed]) -> Vec<Hit> {
+        let query = query.trim();
+        if query.is_empty() || media.is_empty() {
+            return Vec::new();
+        }
+        let mut qv = QueryVectors::default();
+        if let Some(m) = &self.models.meaning
+            && let Ok(v) = m.embed(query, true)
+        {
+            qv.meaning = Some(v);
+        }
+        if let Some(p) = &self.models.picture
+            && let Ok(v) = p.text(query)
+        {
+            let (scale, bias) = p.logit();
+            qv.image = Some(v);
+            qv.image_scale = scale;
+            qv.image_bias = bias;
+        }
+        let refs: Vec<MediaRef> = media.iter().map(|m| MediaRef { id: m.item.0, speech: m.speech.as_deref(), visual: m.visual.as_deref() }).collect();
+        rank::search(query, &qv, &refs)
+    }
+}
+
+/// The range of `hit` in the project, to show or to put on the timeline.
+pub fn hit_range(hit: &Hit) -> (Tick, Tick) {
+    (Tick::from_seconds_f64(f64::from(hit.start)), Tick::from_seconds_f64(f64::from(hit.end.max(hit.start))))
+}
+
+/// The media sources of a job: (item, source, has pictures).
+pub type Sources = Vec<(ItemId, SharedSource, bool)>;
+
+/// A small picture of a result: RGBA8, row by row.
+pub struct Thumb {
+    pub rgba: Vec<u8>,
+    pub width: usize,
+    pub height: usize,
+}
+
+/// The picture of `hit` (its best moment), about `width` pixels wide. `None` for audio-only media or
+/// when the frame cannot be read.
+pub fn thumbnail(sources: &Sources, hit: &Hit, width: usize) -> Option<Thumb> {
+    let (_, source, video) = sources.iter().find(|(i, _, _)| i.0 == hit.id)?;
+    if !video {
+        return None;
+    }
+    let info = source.info();
+    let full = f64::from(info.video.as_ref()?.width.max(1));
+    let scale = (width.clamp(16, 1024) as f64 / full).clamp(0.02, 1.0) as f32;
+    let at = if hit.best.is_finite() && hit.best >= 0.0 { f64::from(hit.best) } else { f64::from(hit.start.max(0.0)) };
+    let f = source.video_frame(FrameRequest { time: Tick::from_seconds_f64(at), scale }).ok()?;
+    let (w, h) = (f.width as usize, f.height as usize);
+    let rgba = f.to_rgba8();
+    (w > 0 && h > 0 && rgba.len() == w.checked_mul(h)?.checked_mul(4)?).then_some(Thumb { rgba, width: w, height: h })
+}
diff --git a/crates/engine/src/search_sheets.rs b/crates/engine/src/search_sheets.rs
new file mode 100644
index 0000000..c6d7048
--- /dev/null
+++ b/crates/engine/src/search_sheets.rs
@@ -0,0 +1,152 @@
+//! Jacnex: contact sheets for "Buscar con IA".
+//!
+//! A sheet is one JPEG with a grid of frames of a video, each with its time in seconds burned into
+//! the corner, so a model that reads pictures can say *when* something is seen. At most
+//! [`MAX_SHEETS`] sheets of [`COLUMNS`] x [`ROWS`] frames are made for one file, spread evenly over it.
+
+use filmcraft_media::{FrameRequest, SharedSource};
+use filmcraft_render::Image;
+use filmcraft_time::Tick;
+
+use crate::{EngineError, Result};
+
+/// Most sheets made for one file (the server accepts no more).
+pub const MAX_SHEETS: usize = 10;
+/// Frames across a sheet.
+pub const COLUMNS: usize = 4;
+/// Frames down a sheet.
+pub const ROWS: usize = 3;
+/// Width of one frame, in pixels.
+const CELL_W: usize = 320;
+/// The shortest and tallest a frame may be, in pixels.
+const CELL_H_MIN: usize = 90;
+const CELL_H_MAX: usize = 360;
+/// The longest video that is sheeted (seconds).
+const MAX_SECONDS: f64 = 12.0 * 3600.0;
+/// Size of one pixel of the label font.
+const LABEL_SCALE: usize = 3;
+
+/// One sheet and the time range its frames cover.
+pub struct Sheet {
+    pub jpeg: Vec<u8>,
+    pub from: f64,
+    pub to: f64,
+}
+
+/// The times (seconds) of the frames of a file `seconds` long: about one per second when there
+/// are few, otherwise evenly spread so that `max_sheets` sheets hold them all.
+pub fn frame_times(seconds: f64, max_sheets: usize) -> Vec<f64> {
+    if !seconds.is_finite() || seconds <= 0.0 {
+        return Vec::new();
+    }
+    let seconds = seconds.min(MAX_SECONDS);
+    let cap = max_sheets.clamp(1, MAX_SHEETS) * COLUMNS * ROWS;
+    let n = (seconds.ceil() as usize).clamp(1, cap);
+    let step = seconds / n as f64;
+    (0..n).map(|i| ((i as f64 + 0.5) * step).min((seconds - 0.05).max(0.0))).collect()
+}
+
+/// Rows of the glyphs "0".."9" and "s": 5 pixels wide, 7 tall, the high bit on the left.
+const GLYPHS: [[u8; 7]; 11] = [
+    [0b01110, 0b10001, 0b10011, 0b10101, 0b11001, 0b10001, 0b01110],
+    [0b00100, 0b01100, 0b00100, 0b00100, 0b00100, 0b00100, 0b01110],
+    [0b01110, 0b10001, 0b00001, 0b00010, 0b00100, 0b01000, 0b11111],
+    [0b11110, 0b00001, 0b00001, 0b01110, 0b00001, 0b00001, 0b11110],
+    [0b00010, 0b00110, 0b01010, 0b10010, 0b11111, 0b00010, 0b00010],
+    [0b11111, 0b10000, 0b11110, 0b00001, 0b00001, 0b10001, 0b01110],
+    [0b00110, 0b01000, 0b10000, 0b11110, 0b10001, 0b10001, 0b01110],
+    [0b11111, 0b00001, 0b00010, 0b00100, 0b01000, 0b01000, 0b01000],
+    [0b01110, 0b10001, 0b10001, 0b01110, 0b10001, 0b10001, 0b01110],
+    [0b01110, 0b10001, 0b10001, 0b01111, 0b00001, 0b00010, 0b01100],
+    [0b00000, 0b00000, 0b01111, 0b10000, 0b01110, 0b00001, 0b11110],
+];
+
+/// sRGB (0..255) to linear light, as the renderer stores pictures.
+fn linear_table() -> [f32; 256] {
+    let mut t = [0f32; 256];
+    for (i, v) in t.iter_mut().enumerate() {
+        let c = i as f32 / 255.0;
+        *v = if c <= 0.04045 { c / 12.92 } else { ((c + 0.055) / 1.055).powf(2.4) };
+    }
+    t
+}
+
+fn put(img: &mut Image, x: usize, y: usize, rgb: [f32; 3]) {
+    if x < img.w && y < img.h {
+        let i = (y * img.w + x) * 4;
+        if let Some(p) = img.px.get_mut(i..i + 4) {
+            p.copy_from_slice(&[rgb[0], rgb[1], rgb[2], 1.0]);
+        }
+    }
+}
+
+/// Burns `text` (digits and "s") at (`x`, `y`) on a black box, white letters.
+fn label(img: &mut Image, x: usize, y: usize, text: &str) {
+    let glyph = |c: char| match c {
+        '0'..='9' => c.to_digit(10).and_then(|d| GLYPHS.get(d as usize)),
+        's' => GLYPHS.get(10),
+        _ => None,
+    };
+    let chars: Vec<char> = text.chars().take(8).collect();
+    let (gw, gh) = (5 * LABEL_SCALE, 7 * LABEL_SCALE);
+    let box_w = chars.len() * (gw + LABEL_SCALE) + LABEL_SCALE;
+    for yy in 0..gh + 2 * LABEL_SCALE {
+        for xx in 0..box_w {
+            put(img, x + xx, y + yy, [0.0; 3]);
+        }
+    }
+    for (k, c) in chars.iter().enumerate() {
+        let Some(g) = glyph(*c) else { continue };
+        for (row, bits) in g.iter().enumerate() {
+            for col in 0..5 {
+                if bits >> (4 - col) & 1 == 1 {
+                    for dy in 0..LABEL_SCALE {
+                        for dx in 0..LABEL_SCALE {
+                            put(img, x + LABEL_SCALE + k * (gw + LABEL_SCALE) + col * LABEL_SCALE + dx, y + LABEL_SCALE + row * LABEL_SCALE + dy, [1.0; 3]);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// The sheets of `source` (a video `seconds` long). `keep_going` is asked between frames: false
+/// stops with an error. A frame that cannot be read leaves its cell black.
+pub fn contact_sheets(source: &SharedSource, seconds: f64, max_sheets: usize, keep_going: &mut dyn FnMut() -> bool) -> Result<Vec<Sheet>> {
+    let info = source.info();
+    let video = info.video.as_ref().ok_or_else(|| EngineError::Other("the file has no pictures".into()))?;
+    let (vw, vh) = (video.width.max(1) as usize, video.height.max(1) as usize);
+    let cell_h = (CELL_W * vh / vw).clamp(CELL_H_MIN, CELL_H_MAX);
+    let scale = (CELL_W as f32 / vw as f32).clamp(0.02, 1.0);
+    let times = frame_times(seconds, max_sheets);
+    let table = linear_table();
+    let mut sheets = Vec::new();
+    for group in times.chunks(COLUMNS * ROWS) {
+        let mut img = Image::filled(COLUMNS * CELL_W, ROWS * cell_h, [0.0, 0.0, 0.0, 1.0]);
+        for (k, t) in group.iter().enumerate() {
+            if !keep_going() {
+                return Err(EngineError::Other(crate::search::CANCELLED.into()));
+            }
+            let (ox, oy) = ((k % COLUMNS) * CELL_W, (k / COLUMNS) * cell_h);
+            if let Ok(f) = source.video_frame(FrameRequest { time: Tick::from_seconds_f64(*t), scale }) {
+                let (w, h) = (f.width as usize, f.height as usize);
+                let rgba = f.to_rgba8();
+                if w > 0 && h > 0 && rgba.len() == w.saturating_mul(h).saturating_mul(4) {
+                    for y in 0..h.min(cell_h) {
+                        for x in 0..w.min(CELL_W) {
+                            let i = (y * w + x) * 4;
+                            if let Some(p) = rgba.get(i..i + 3) {
+                                put(&mut img, ox + x, oy + y, [table[usize::from(p[0])], table[usize::from(p[1])], table[usize::from(p[2])]]);
+                            }
+                        }
+                    }
+                }
+            }
+            label(&mut img, ox + 2, oy + 2, &format!("{}s", t.round() as u64));
+        }
+        let jpeg = filmcraft_export::still::encode(&img, filmcraft_export::still::StillFormat::Jpeg, 8).map_err(|e| EngineError::Other(e.to_string()))?;
+        sheets.push(Sheet { jpeg, from: group.first().copied().unwrap_or(0.0), to: group.last().copied().unwrap_or(0.0) });
+    }
+    Ok(sheets)
+}
