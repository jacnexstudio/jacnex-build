+//! Jacnex: Versión corta, los ajustes, el costo y los avisos cuando falta algo.
+
+use std::sync::Arc;
+
+use filmcraft_engine::Session;
+use filmcraft_project::{Transcript, Word};
+use filmcraft_speech::FixedTranscriber;
+use serde_json::json;
+
+use super::*;
+use crate::jacnex_ia::{Grupo, Modo};
+
+/// El catálogo del servidor tal como lo da `/v1/jacnex/catalogo` (45 créditos por millón de tokens).
+fn catalogo() -> Value {
+    json!({
+        "creditos": 100,
+        "cortas": [{
+            "id": "corta-ia", "nombre": "Versión corta", "maxTexto": 400, "maxHojas": 0, "maxMegas": 1,
+            "maxCaracteres": 300_000, "maxSegundos": 43_200, "caracteresPorToken": 2, "tokensPorHoja": 1500,
+            "tokensRespuesta": 1500, "margen": 4, "maxCreditos": 400, "creditosPorMillon": 45,
+            "objetivos": [15, 30, 60, 90]
+        }]
+    })
+}
+
+/// Una secuencia sintética de un solo clip largo (`max(n*3+10, 200)` s), para que la prueba nunca dependa de lo que dure la demo,
+/// con una voz falsa que dice `n` frases de 3 s cada una.
+fn app_con_voz(n: usize) -> FilmcraftApp {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let largo = Tick::from_seconds_f64(((n * 3 + 10) as f64).max(200.0));
+    let id = s.state.active_sequence.expect("a sequence is open");
+    let p = Arc::make_mut(&mut s.project);
+    if let Some(q) = p.sequence_mut(id) {
+        for t in q.video_tracks.iter_mut().chain(q.audio_tracks.iter_mut()) {
+            t.items.truncate(1);
+            t.transitions.clear();
+            if let Some(i) = t.items.first_mut() {
+                i.start = Tick::ZERO;
+                i.duration = largo;
+            }
+        }
+        q.caption_tracks.clear();
+    }
+    let a = &s.active_sequence().unwrap().audio_tracks[0].items[0];
+    let (sin, item) = (a.source_in, a.item);
+    let mut t = Transcript { language: "es".into(), ..Default::default() };
+    for i in 0..n {
+        let ini = i as f64 * 3.0;
+        t.words.push(Word::new("Hola", sin + Tick::from_seconds_f64(ini), sin + Tick::from_seconds_f64(ini + 1.0)));
+        t.words.push(Word::new("mundo.", sin + Tick::from_seconds_f64(ini + 1.0), sin + Tick::from_seconds_f64(ini + 2.0)));
+    }
+    t.normalize();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: t, id: "fixed".into() }));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    FilmcraftApp::new(s)
+}
+
+#[test]
+fn defaults_and_limits() {
