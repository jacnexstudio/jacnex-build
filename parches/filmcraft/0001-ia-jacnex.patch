+/// El estado de «Buscar».
+#[derive(Default)]
+pub struct Buscar {
+    /// Lo que se busca.
+    pub consulta: String,
+    /// Buscar con IA (créditos) en lugar de en esta computadora.
+    pub con_ia: bool,
+    /// El archivo donde busca la IA (ninguno = el del visor de origen).
+    pub archivo: Option<ItemId>,
+    pendiente: Option<Pedido>,
+    trabajo: Option<Trabajo>,
+    modelos: Models,
+    resultados: Vec<Resultado>,
+    /// La búsqueda de la que son los resultados.
+    de: String,
+    /// El último aviso: (salió bien, texto).
+    aviso: Option<(bool, String)>,
+    material: Option<Material>,
+    modelos_vistos: Cell<Option<(Instant, ModelStatus)>>,
+}
+
+impl Buscar {
+    /// Hay una búsqueda en curso.
+    pub fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    /// Los modelos instalados, mirados cada pocos segundos.
+    fn instalados(&self) -> ModelStatus {
+        if let Some((cuando, m)) = self.modelos_vistos.get()
+            && cuando.elapsed() < REVISAR_MODELOS
+        {
+            return m;
+        }
+        let m = ModelStatus::of(filmcraft_engine::transcript::jacnex_models_dir().as_deref());
+        self.modelos_vistos.set(Some((Instant::now(), m)));
+        m
+    }
+}
+
+/// Lo que «Buscar» necesita saber del proyecto y de la cuenta para dibujarse.
+pub struct Datos {
+    archivos: Vec<(ItemId, String)>,
+    fuente: Option<ItemId>,
+    modelos: ModelStatus,
+    sesion: bool,
+    busqueda: Option<BusquedaNube>,
+    saldo: Option<i64>,
+    falta: Option<&'static str>,
+}
+
+/// Se calcula antes de dibujar la ventana.
+pub fn datos(app: &FilmcraftApp) -> Datos {
+    let mut archivos: Vec<(ItemId, String)> = search::media_items(&app.session)
+        .into_iter()
+        .filter_map(|i| match app.session.project.item(i) {
+            Some(it) if matches!(&it.kind, ItemKind::Media(m) if m.info.has_video() || m.info.has_audio()) => Some((i, it.name.chars().take(80).collect())),
+            _ => None,
+        })
+        .take(MAX_ARCHIVOS)
+        .collect();
+    archivos.sort_by_key(|a| a.1.to_lowercase());
+    let e = &app.jacnex_ia;
+    Datos {
+        archivos,
+        fuente: app.session.state.source_item,
+        modelos: e.buscar.instalados(),
+        sesion: e.hay_sesion(),
+        busqueda: e.busqueda_nube().cloned(),
+        saldo: e.saldo(),
+        falta: falta(app),
+    }
+}
+
+/// El archivo donde buscaría la IA.
+fn archivo_ia(app: &FilmcraftApp) -> Option<ItemId> {
+    let b = &app.jacnex_ia.buscar;
+    b.archivo.or(app.session.state.source_item).filter(|i| app.session.project.item(*i).is_some_and(|it| matches!(it.kind, ItemKind::Media(_))))
+}
+
+/// Por qué no se puede buscar ahora (o nada).
+pub fn falta(app: &FilmcraftApp) -> Option<&'static str> {
+    let e = &app.jacnex_ia;
+    let b = &e.buscar;
+    if b.ocupado() {
+        return Some("Espera a que termine la búsqueda.");
+    }
+    if b.consulta.trim().is_empty() {
+        return Some("Escribe lo que buscas.");
+    }
+    if b.con_ia {
+        if !e.hay_sesion() {
+            return Some("Inicia sesión en Jacnex Studio para buscar con IA.");
+        }
+        if e.busqueda_nube().is_none() {
+            return Some("El servidor aún no ofrece la búsqueda con IA.");
+        }
+        if archivo_ia(app).is_none() {
+            return Some("Elige el archivo donde buscar.");
+        }
+    } else if search::media_items(&app.session).is_empty() {
+        return Some("El proyecto no tiene material para buscar.");
+    }
+    None
+}
