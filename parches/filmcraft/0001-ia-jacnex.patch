+#[test]
+fn background_goes_on_its_own_track_and_everything_is_one_undo() {
+    let (mut s, clip, start) = session();
+    let made_for = s.state.active_sequence.unwrap();
+    let tracks = s.active_sequence().unwrap().audio_tracks.len();
+    let undo = s.history.undo.len();
+    let music = bg(3.0);
+    let d = dub::Dub {
+        at: start,
+        samples: &tone(3.0, 0.4),
+        background: Some(dub::Background { samples: &music, rate: 44_100, channels: 2 }),
+        sources: &[clip],
