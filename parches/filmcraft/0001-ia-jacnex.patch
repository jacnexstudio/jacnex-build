+//! RT-DETRv2 object detector (COCO, 80 classes) on candle.
+//!
+//! The network: a ResNet-vd backbone, a hybrid encoder (one transformer layer on the coarsest
+//! level, then a top-down and a bottom-up feature pyramid with RepVGG blocks), top-300 query
+//! selection and a decoder of multi-scale deformable attention layers with iterative box
+//! refinement. There is no non-maximum suppression: every query is one detection.
+//!
+//! Weights are read from the Hugging Face `model.safetensors` of `PekingU/rtdetr_v2_r*vd` plus its
+//! `config.json`; batch-norm layers are folded into the convolutions on load. The depth of the
+//! backbone and the decoder are discovered from the weight names, so the 18 and 50 layer models
+//! share this code.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use candle_core::{D, Device, Tensor};
+use candle_nn::ops::softmax_last_dim;
+
+use crate::nn::{Conv, load_weights, net};
+use crate::{Image, Obj, Rect, ReframeError, Result};
+
+/// The file the weights are read from, inside the model folder.
+pub const FILE: &str = "model.safetensors";
+/// The model folder name of the 18 layer model.
+pub const MODEL_ID_R18: &str = "reframe-rtdetrv2-r18vd";
+/// The longest side images are resized to (the model was trained around 640).
+pub const DEFAULT_SIDE: usize = 640;
+const HEADS: usize = 8;
+const LEVELS: usize = 3;
+const POINTS: usize = 4;
+const OFFSET_SCALE: f32 = 0.5;
+const EPS_BN: f64 = 1e-5;
+const EPS_LN: f64 = 1e-5;
+const MAX_QUERIES: usize = 1000;
+
+struct Lin {
+    w: Tensor,
+    b: Tensor,
+}
+
+impl Lin {
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        x.matmul(&self.w)?.broadcast_add(&self.b)
+    }
+}
+
+struct Ln {
+    w: Tensor,
+    b: Tensor,
+}
+
+impl Ln {
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        let mean = x.mean_keepdim(D::Minus1)?;
+        let xc = x.broadcast_sub(&mean)?;
+        let var = xc.sqr()?.mean_keepdim(D::Minus1)?;
+        xc.broadcast_div(&var.affine(1.0, EPS_LN)?.sqrt()?)?.broadcast_mul(&self.w)?.broadcast_add(&self.b)
+    }
+}
+
+#[derive(Clone, Copy, PartialEq)]
+enum Act {
+    None,
+    Relu,
+    Silu,
+}
+
+fn act(x: &Tensor, a: Act) -> candle_core::Result<Tensor> {
+    match a {
+        Act::None => Ok(x.clone()),
+        Act::Relu => x.relu(),
+        Act::Silu => x.silu(),
+    }
+}
+
+/// A convolution with its batch-norm folded in, plus an activation.
+struct Cb {
+    conv: Conv,
+    act: Act,
+}
+
+impl Cb {
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        act(&self.conv.forward(x)?, self.act)
+    }
+}
+
+struct Weights(HashMap<String, Tensor>);
+
+impl Weights {
+    fn get(&self, name: &str) -> Result<&Tensor> {
+        self.0.get(name).ok_or_else(|| ReframeError::Model(format!("missing weight `{name}`")))
+    }
+    fn has(&self, name: &str) -> bool {
+        self.0.contains_key(name)
+    }
+    fn lin(&self, p: &str) -> Result<Lin> {
+        let w = self.get(&format!("{p}.weight"))?.t().and_then(|t| t.contiguous()).map_err(net)?;
+        Ok(Lin { w, b: self.get(&format!("{p}.bias"))?.clone() })
+    }
+    fn ln(&self, p: &str) -> Result<Ln> {
+        Ok(Ln { w: self.get(&format!("{p}.weight"))?.clone(), b: self.get(&format!("{p}.bias"))?.clone() })
+    }
+    /// Convolution at `conv` with the batch-norm at `norm` folded in.
+    fn cb(&self, conv: &str, norm: &str, stride: usize, act: Act) -> Result<Cb> {
+        let w = self.get(conv)?;
+        let g = self.get(&format!("{norm}.weight"))?;
+        let be = self.get(&format!("{norm}.bias"))?;
+        let mu = self.get(&format!("{norm}.running_mean"))?;
+        let var = self.get(&format!("{norm}.running_var"))?;
+        let k = w.dim(2).map_err(net)?;
+        let f = || -> candle_core::Result<(Tensor, Tensor)> {
+            let s = (g / var.affine(1.0, EPS_BN)?.sqrt()?)?;
+            let o = s.elem_count();
+            let wf = w.broadcast_mul(&s.reshape((o, 1, 1, 1))?)?;
+            let bf = (be - (mu * &s)?)?;
+            Ok((wf, bf))
+        };
+        let (w, b) = f().map_err(net)?;
+        Ok(Cb { conv: Conv { w, b: Some(b), pad: (k / 2, k / 2), stride, groups: 1 }, act })
+    }
+    /// A `conv`/`norm` pair under `prefix` named like the `ConvNormLayer` modules (`.conv`, `.norm`).
+    fn cn(&self, prefix: &str, stride: usize, act: Act) -> Result<Cb> {
+        self.cb(&format!("{prefix}.conv.weight"), &format!("{prefix}.norm"), stride, act)
+    }
+    /// A `convolution`/`normalization` pair under `prefix` (the ResNet naming).
+    fn rn(&self, prefix: &str, stride: usize, act: Act) -> Result<Cb> {
+        self.cb(&format!("{prefix}.convolution.weight"), &format!("{prefix}.normalization"), stride, act)
+    }
+}
+
+enum Shortcut {
+    Identity,
+    Conv(Cb),
+    /// 2x2 average pool (ceil mode) then a 1x1 convolution.
+    PoolConv(Cb),
+}
+
+struct ResLayer {
+    convs: Vec<Cb>,
+    shortcut: Shortcut,
+}
+
+struct Backbone {
+    stem: Vec<Cb>,
+    stages: Vec<Vec<ResLayer>>,
+}
+
+struct Mha {
+    q: Lin,
+    k: Lin,
+    v: Lin,
+    o: Lin,
+}
+
+impl Mha {
+    fn load(w: &Weights, p: &str) -> Result<Self> {
+        Ok(Self {
+            q: w.lin(&format!("{p}.q_proj"))?,
+            k: w.lin(&format!("{p}.k_proj"))?,
+            v: w.lin(&format!("{p}.v_proj"))?,
+            o: w.lin(&format!("{p}.out_proj"))?,
+        })
+    }
+
+    /// Self-attention over `x` (N, C); `pos` is added to the queries and keys only.
+    fn forward(&self, x: &Tensor, pos: Option<&Tensor>) -> candle_core::Result<Tensor> {
+        let (n, c) = x.dims2()?;
+        let hd = c / HEADS;
+        let qk = match pos {
+            Some(p) => (x + p)?,
+            None => x.clone(),
+        };
+        let split = |t: Tensor| -> candle_core::Result<Tensor> { t.reshape((n, HEADS, hd))?.permute((1, 0, 2))?.contiguous() };
+        let q = split(self.q.forward(&qk)?)?;
+        let k = split(self.k.forward(&qk)?)?;
+        let v = split(self.v.forward(x)?)?;
+        let att = softmax_last_dim(&(q.matmul(&k.transpose(1, 2)?.contiguous()?)? * (1.0 / (hd as f64).sqrt()))?)?;
+        let out = att.matmul(&v)?.permute((1, 0, 2))?.contiguous()?.reshape((n, c))?;
+        self.o.forward(&out)
+    }
+}
+
+struct EncLayer {
+    attn: Mha,
+    ln1: Ln,
+    fc1: Lin,
+    fc2: Lin,
+    ln2: Ln,
+}
+
+impl EncLayer {
+    fn forward(&self, x: &Tensor, pos: &Tensor) -> candle_core::Result<Tensor> {
+        let h = self.ln1.forward(&(x + self.attn.forward(x, Some(pos))?)?)?;
+        let m = self.fc2.forward(&self.fc1.forward(&h)?.gelu_erf()?)?;
+        self.ln2.forward(&(h + m)?)
+    }
+}
+
+struct Csp {
+    c1: Cb,
+    c2: Cb,
+    blocks: Vec<(Cb, Cb)>,
+    c3: Option<Cb>,
+}
+
+impl Csp {
+    fn load(w: &Weights, p: &str) -> Result<Self> {
+        let mut blocks = Vec::new();
+        for i in 0..8 {
+            if !w.has(&format!("{p}.bottlenecks.{i}.conv1.conv.weight")) {
+                break;
+            }
+            blocks.push((w.cn(&format!("{p}.bottlenecks.{i}.conv1"), 1, Act::None)?, w.cn(&format!("{p}.bottlenecks.{i}.conv2"), 1, Act::None)?));
+        }
+        let c3 = if w.has(&format!("{p}.conv3.conv.weight")) { Some(w.cn(&format!("{p}.conv3"), 1, Act::Silu)?) } else { None };
+        Ok(Self { c1: w.cn(&format!("{p}.conv1"), 1, Act::Silu)?, c2: w.cn(&format!("{p}.conv2"), 1, Act::Silu)?, blocks, c3 })
+    }
+
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        let mut a = self.c1.forward(x)?;
+        for (c3, c1) in &self.blocks {
+            a = (c3.forward(&a)? + c1.forward(&a)?)?.silu()?;
+        }
+        let y = (a + self.c2.forward(x)?)?;
+        match &self.c3 {
+            Some(c) => c.forward(&y),
+            None => Ok(y),
+        }
+    }
+}
+
+struct DecLayer {
+    attn: Mha,
+    ln1: Ln,
+    offsets: Lin,
+    weights: Lin,
+    value: Lin,
+    out: Lin,
+    ln2: Ln,
+    fc1: Lin,
+    fc2: Lin,
+    ln3: Ln,
+}
+
+struct Mlp {
+    layers: Vec<Lin>,
+}
+
+impl Mlp {
+    fn load(w: &Weights, p: &str, n: usize) -> Result<Self> {
+        Ok(Self { layers: (0..n).map(|i| w.lin(&format!("{p}.layers.{i}"))).collect::<Result<_>>()? })
+    }
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        let mut x = x.clone();
+        for (i, l) in self.layers.iter().enumerate() {
+            x = l.forward(&x)?;
+            if i + 1 < self.layers.len() {
+                x = x.relu()?;
+            }
+        }
+        Ok(x)
+    }
+}
+
+/// The loaded detector.
+pub struct RtDetr {
+    backbone: Backbone,
+    in_proj: Vec<Cb>,
+    aifi: EncLayer,
+    lateral: Vec<Cb>,
+    fpn: Vec<Csp>,
+    down: Vec<Cb>,
+    pan: Vec<Csp>,
+    dec_proj: Vec<Cb>,
+    enc_out: Lin,
+    enc_ln: Ln,
+    enc_score: Lin,
+    enc_box: Mlp,
+    query_pos: Mlp,
+    layers: Vec<DecLayer>,
+    box_heads: Vec<Mlp>,
+    class_heads: Vec<Lin>,
+    classes: usize,
+    dim: usize,
+}
+
+/// What the network gives for one image, before any threshold.
+pub struct Raw {
+    /// Per query, the class logits (`queries * classes`).
+    pub logits: Vec<f32>,
+    /// Per query, the centre-x, centre-y, width and height in 0..1 (`queries * 4`).
+    pub boxes: Vec<f32>,
+    pub queries: usize,
+    pub classes: usize,
+}
+
+impl RtDetr {
+    /// Loads the detector from `dir/model.safetensors`.
+    pub fn load(dir: &Path) -> Result<Self> {
+        let w = Weights(load_weights(dir, FILE)?);
+        let cfg: serde_json::Value =
+            serde_json::from_slice(&std::fs::read(dir.join("config.json")).map_err(|e| ReframeError::Model(format!("config.json: {e}")))?)
+                .map_err(|e| ReframeError::Model(format!("config.json: {e}")))?;
+        let uint = |k: &str, max: u64| -> Result<usize> {
+            let v = cfg.get(k).and_then(|v| v.as_u64()).ok_or_else(|| ReframeError::Model(format!("config.json: `{k}` missing")))?;
+            if v == 0 || v > max {
+                return Err(ReframeError::Model(format!("config.json: `{k}` out of range")));
+            }
+            Ok(v as usize)
+        };
+        let dim = uint("d_model", 1024)?;
+        let n_dec = uint("decoder_layers", 12)?;
+        let classes = cfg
+            .get("id2label")
+            .and_then(|v| v.as_object())
+            .map(|o| o.len())
+            .filter(|&n| n > 0 && n <= 1000)
+            .ok_or_else(|| ReframeError::Model("config.json: id2label".into()))?;
+        if dim != 256
+            || cfg.get("decoder_attention_heads").and_then(|v| v.as_u64()) != Some(HEADS as u64)
+            || cfg.get("decoder_n_points").and_then(|v| v.as_u64()) != Some(POINTS as u64)
+        {
+            return Err(ReframeError::Model("unsupported RT-DETR variant".into()));
+        }
+        let m = "model.";
+        // backbone
+        let bp = format!("{m}backbone.model");
+        let stem = (0..3).map(|i| w.rn(&format!("{bp}.embedder.embedder.{i}"), if i == 0 { 2 } else { 1 }, Act::Relu)).collect::<Result<Vec<_>>>()?;
+        let mut stages = Vec::new();
+        for s in 0..4 {
+            let mut layers = Vec::new();
+            for l in 0..32 {
+                let lp = format!("{bp}.encoder.stages.{s}.layers.{l}");
+                if !w.has(&format!("{lp}.layer.0.convolution.weight")) {
+                    break;
+                }
+                let stride = if l == 0 && s > 0 { 2 } else { 1 };
+                let bottleneck = w.has(&format!("{lp}.layer.2.convolution.weight"));
+                let n = if bottleneck { 3 } else { 2 };
+                let mut convs = Vec::new();
+                for i in 0..n {
+                    let (st, a) = if bottleneck {
+                        (if i == 1 { stride } else { 1 }, if i == n - 1 { Act::None } else { Act::Relu })
+                    } else {
+                        (if i == 0 { stride } else { 1 }, if i == n - 1 { Act::None } else { Act::Relu })
+                    };
+                    convs.push(w.rn(&format!("{lp}.layer.{i}"), st, a)?);
+                }
+                let shortcut = if w.has(&format!("{lp}.shortcut.1.convolution.weight")) {
+                    Shortcut::PoolConv(w.rn(&format!("{lp}.shortcut.1"), 1, Act::None)?)
+                } else if w.has(&format!("{lp}.shortcut.convolution.weight")) {
+                    Shortcut::Conv(w.rn(&format!("{lp}.shortcut"), stride, Act::None)?)
+                } else {
+                    Shortcut::Identity
+                };
+                layers.push(ResLayer { convs, shortcut });
+            }
+            if layers.is_empty() {
+                return Err(ReframeError::Model("backbone stage missing".into()));
+            }
+            stages.push(layers);
+        }
+        let in_proj = (0..3)
+            .map(|i| w.cb(&format!("{m}encoder_input_proj.{i}.0.weight"), &format!("{m}encoder_input_proj.{i}.1"), 1, Act::None))
+            .collect::<Result<Vec<_>>>()?;
+        let ep = format!("{m}encoder.encoder.0.layers.0");
+        let aifi = EncLayer {
+            attn: Mha::load(&w, &format!("{ep}.self_attn"))?,
+            ln1: w.ln(&format!("{ep}.self_attn_layer_norm"))?,
+            fc1: w.lin(&format!("{ep}.fc1"))?,
+            fc2: w.lin(&format!("{ep}.fc2"))?,
+            ln2: w.ln(&format!("{ep}.final_layer_norm"))?,
+        };
+        let e = format!("{m}encoder");
+        let lateral = (0..2).map(|i| w.cn(&format!("{e}.lateral_convs.{i}"), 1, Act::Silu)).collect::<Result<Vec<_>>>()?;
+        let fpn = (0..2).map(|i| Csp::load(&w, &format!("{e}.fpn_blocks.{i}"))).collect::<Result<Vec<_>>>()?;
+        let down = (0..2).map(|i| w.cn(&format!("{e}.downsample_convs.{i}"), 2, Act::Silu)).collect::<Result<Vec<_>>>()?;
+        let pan = (0..2).map(|i| Csp::load(&w, &format!("{e}.pan_blocks.{i}"))).collect::<Result<Vec<_>>>()?;
+        let dec_proj = (0..3)
+            .map(|i| w.cb(&format!("{m}decoder_input_proj.{i}.0.weight"), &format!("{m}decoder_input_proj.{i}.1"), 1, Act::None))
+            .collect::<Result<Vec<_>>>()?;
+        let mut layers = Vec::new();
+        let mut box_heads = Vec::new();
+        let mut class_heads = Vec::new();
+        for i in 0..n_dec {
+            let p = format!("{m}decoder.layers.{i}");
+            layers.push(DecLayer {
+                attn: Mha::load(&w, &format!("{p}.self_attn"))?,
+                ln1: w.ln(&format!("{p}.self_attn_layer_norm"))?,
+                offsets: w.lin(&format!("{p}.encoder_attn.sampling_offsets"))?,
+                weights: w.lin(&format!("{p}.encoder_attn.attention_weights"))?,
+                value: w.lin(&format!("{p}.encoder_attn.value_proj"))?,
+                out: w.lin(&format!("{p}.encoder_attn.output_proj"))?,
+                ln2: w.ln(&format!("{p}.encoder_attn_layer_norm"))?,
+                fc1: w.lin(&format!("{p}.fc1"))?,
+                fc2: w.lin(&format!("{p}.fc2"))?,
+                ln3: w.ln(&format!("{p}.final_layer_norm"))?,
+            });
+            box_heads.push(Mlp::load(&w, &format!("{m}decoder.bbox_embed.{i}"), 3)?);
+            class_heads.push(w.lin(&format!("{m}decoder.class_embed.{i}"))?);
+        }
+        Ok(Self {
+            backbone: Backbone { stem, stages },
+            in_proj,
+            aifi,
+            lateral,
+            fpn,
+            down,
+            pan,
+            dec_proj,
+            enc_out: w.lin(&format!("{m}enc_output.0"))?,
+            enc_ln: w.ln(&format!("{m}enc_output.1"))?,
+            enc_score: w.lin(&format!("{m}enc_score_head"))?,
+            enc_box: Mlp::load(&w, &format!("{m}enc_bbox_head"), 3)?,
+            query_pos: Mlp::load(&w, &format!("{m}decoder.query_pos_head"), 2)?,
+            layers,
+            box_heads,
+            class_heads,
+            classes,
+            dim,
+        })
+    }
+
+    fn pool3(x: &Tensor) -> candle_core::Result<Tensor> {
+        // 3x3, stride 2, padding 1; the input is post-ReLU so zero padding equals -inf padding
+        x.pad_with_zeros(2, 1, 1)?.pad_with_zeros(3, 1, 1)?.max_pool2d_with_stride(3, 2)
+    }
+
+    fn backbone(&self, x: &Tensor) -> candle_core::Result<[Tensor; 3]> {
+        let mut x = x.clone();
+        for c in &self.backbone.stem {
+            x = c.forward(&x)?;
+        }
+        x = Self::pool3(&x)?;
+        let mut outs = Vec::new();
+        for (si, stage) in self.backbone.stages.iter().enumerate() {
+            for l in stage {
+                let mut y = x.clone();
+                for c in &l.convs {
+                    y = c.forward(&y)?;
+                }
+                let r = match &l.shortcut {
+                    Shortcut::Identity => x.clone(),
+                    Shortcut::Conv(c) => c.forward(&x)?,
+                    Shortcut::PoolConv(c) => c.forward(&x.avg_pool2d_with_stride(2, 2)?)?,
+                };
+                x = (y + r)?.relu()?;
+            }
+            if si >= 1 {
+                outs.push(x.clone());
+            }
+        }
+        let mut it = outs.into_iter();
+        match (it.next(), it.next(), it.next()) {
+            (Some(a), Some(b), Some(c)) => Ok([a, b, c]),
+            _ => Err(candle_core::Error::Msg("backbone needs 4 stages".into())),
+        }
+    }
+
+    fn sine_pos(&self, h: usize, w: usize) -> candle_core::Result<Tensor> {
+        let pos_dim = self.dim / 4;
+        let omega: Vec<f32> = (0..pos_dim).map(|i| 1.0 / 10000f32.powf(i as f32 / pos_dim as f32)).collect();
+        let mut v = Vec::with_capacity(h * w * self.dim);
+        for y in 0..h {
+            for x in 0..w {
+                for o in &omega {
+                    v.push((y as f32 * o).sin());
+                }
+                for o in &omega {
+                    v.push((y as f32 * o).cos());
+                }
+                for o in &omega {
+                    v.push((x as f32 * o).sin());
+                }
+                for o in &omega {
+                    v.push((x as f32 * o).cos());
+                }
+            }
+        }
+        Tensor::from_vec(v, (h * w, self.dim), &Device::Cpu)
+    }
+
+    fn up2(t: &Tensor) -> candle_core::Result<Tensor> {
+        t.upsample_nearest2d(t.dim(2)? * 2, t.dim(3)? * 2)
+    }
+
+    /// Hybrid encoder: maps the three backbone outputs to three 256-channel maps.
+    fn encoder(&self, feats: [Tensor; 3]) -> candle_core::Result<[Tensor; 3]> {
+        let p: Vec<Tensor> = feats.iter().zip(&self.in_proj).map(|(f, c)| c.forward(f)).collect::<candle_core::Result<_>>()?;
+        let (c, h, w) = (p[2].dim(1)?, p[2].dim(2)?, p[2].dim(3)?);
+        let tokens = p[2].reshape((c, h * w))?.t()?.contiguous()?;
+        let tokens = self.aifi.forward(&tokens, &self.sine_pos(h, w)?)?;
+        let top = tokens.t()?.reshape((1, c, h, w))?.contiguous()?;
+        let maps = [p[0].clone(), p[1].clone(), top];
+        // top-down
+        let mut fpn = vec![maps[2].clone()];
+        for (i, (lat, blk)) in self.lateral.iter().zip(&self.fpn).enumerate() {
+            let back = &maps[1 - i];
+            let top = lat.forward(&fpn[fpn.len() - 1])?;
+            let n = fpn.len();
+            fpn[n - 1] = top.clone();
+            let fused = Tensor::cat(&[&Self::up2(&top)?, back], 1)?;
+            fpn.push(blk.forward(&fused)?);
+        }
+        fpn.reverse();
+        // bottom-up
+        let mut pan = vec![fpn[0].clone()];
+        for (i, (dn, blk)) in self.down.iter().zip(&self.pan).enumerate() {
+            let d = dn.forward(&pan[pan.len() - 1])?;
+            let fused = Tensor::cat(&[&d, &fpn[i + 1]], 1)?;
+            pan.push(blk.forward(&fused)?);
+        }
+        let mut it = pan.into_iter();
+        match (it.next(), it.next(), it.next()) {
+            (Some(a), Some(b), Some(c)) => Ok([a, b, c]),
+            _ => Err(candle_core::Error::Msg("encoder needs 3 levels".into())),
+        }
+    }
+
+    /// Anchors (logit space, `f32::MAX` where invalid) and the validity mask per memory row.
+    fn anchors(shapes: &[(usize, usize)]) -> (Vec<f32>, Vec<f32>) {
+        let mut anchors = Vec::new();
+        let mut valid = Vec::new();
+        for (lvl, &(h, w)) in shapes.iter().enumerate() {
+            let wh = 0.05 * 2f32.powi(lvl as i32);
+            for y in 0..h {
+                for x in 0..w {
+                    let a = [(x as f32 + 0.5) / w as f32, (y as f32 + 0.5) / h as f32, wh, wh];
+                    let ok = a.iter().all(|v| *v > 0.01 && *v < 0.99);
+                    valid.push(if ok { 1.0 } else { 0.0 });
+                    for v in a {
+                        anchors.push(if ok { (v / (1.0 - v)).ln() } else { f32::MAX });
+                    }
+                }
+            }
+        }
+        (anchors, valid)
+    }
+
+    /// Multi-scale deformable attention: returns (Q, C) before the output projection.
+    #[allow(clippy::too_many_arguments)]
+    fn sample(value: &[f32], shapes: &[(usize, usize)], starts: &[usize], refs: &[f32], offs: &[f32], attw: &[f32], q: usize, dim: usize) -> Vec<f32> {
+        let hd = dim / HEADS;
+        let mut out = vec![0f32; q * dim];
+        let lp = LEVELS * POINTS;
+        for qi in 0..q {
+            let r = &refs[qi * 4..qi * 4 + 4];
+            for h in 0..HEADS {
+                // softmax over the 12 weights of this head
+                let wbase = (qi * HEADS + h) * lp;
+                let ws = &attw[wbase..wbase + lp];
+                let mx = ws.iter().cloned().fold(f32::MIN, f32::max);
+                let ex: Vec<f32> = ws.iter().map(|v| (v - mx).exp()).collect();
+                let sum: f32 = ex.iter().sum();
+                let o = &mut out[qi * dim + h * hd..qi * dim + (h + 1) * hd];
+                for l in 0..LEVELS {
+                    let (hh, ww) = shapes[l];
+                    for p in 0..POINTS {
+                        let idx = l * POINTS + p;
+                        let ob = (wbase + idx) * 2;
+                        let sx = r[0] + offs[ob] * (1.0 / POINTS as f32) * r[2] * OFFSET_SCALE;
+                        let sy = r[1] + offs[ob + 1] * (1.0 / POINTS as f32) * r[3] * OFFSET_SCALE;
+                        let a = ex[idx] / sum;
+                        let (px, py) = (sx * ww as f32 - 0.5, sy * hh as f32 - 0.5);
+                        let (x0, y0) = (px.floor(), py.floor());
+                        let (fx, fy) = (px - x0, py - y0);
+                        for (dx, dy, wt) in [(0.0, 0.0, (1.0 - fx) * (1.0 - fy)), (1.0, 0.0, fx * (1.0 - fy)), (0.0, 1.0, (1.0 - fx) * fy), (1.0, 1.0, fx * fy)]
+                        {
+                            let (cx, cy) = (x0 + dx, y0 + dy);
+                            if cx < 0.0 || cy < 0.0 || cx >= ww as f32 || cy >= hh as f32 || wt == 0.0 {
+                                continue;
+                            }
+                            let row = starts[l] + cy as usize * ww + cx as usize;
+                            let v = &value[row * dim + h * hd..row * dim + (h + 1) * hd];
+                            for (oc, vc) in o.iter_mut().zip(v) {
+                                *oc += a * wt * vc;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        out
+    }
+
+    /// Runs the network on a planar RGB image in 0..1 (`3 * h * w`, both multiples of 32).
+    pub fn raw(&self, planar: Vec<f32>, w: usize, h: usize) -> Result<Raw> {
+        if w == 0 || h == 0 || !w.is_multiple_of(32) || !h.is_multiple_of(32) || w > 2048 || h > 2048 || planar.len() != 3 * w * h {
+            return Err(ReframeError::Image("RT-DETR needs a size that is a multiple of 32".into()));
+        }
+        self.forward(planar, w, h).map_err(net)
+    }
+
+    fn forward(&self, planar: Vec<f32>, w: usize, h: usize) -> candle_core::Result<Raw> {
+        let dev = Device::Cpu;
+        let x = Tensor::from_vec(planar, (1, 3, h, w), &dev)?;
+        let feats = self.backbone(&x)?;
+        let maps = self.encoder(feats)?;
+        let mut shapes = Vec::new();
+        let mut toks = Vec::new();
+        for (m, p) in maps.iter().zip(&self.dec_proj) {
+            let y = p.forward(m)?;
+            let (c, hh, ww) = (y.dim(1)?, y.dim(2)?, y.dim(3)?);
+            shapes.push((hh, ww));
+            toks.push(y.reshape((c, hh * ww))?.t()?.contiguous()?);
+        }
+        let memory = Tensor::cat(&toks, 0)?;
+        let s = memory.dim(0)?;
+        let mut starts = Vec::new();
+        let mut acc = 0;
+        for &(hh, ww) in &shapes {
+            starts.push(acc);
+            acc += hh * ww;
+        }
+        // query selection
+        let (anchors, valid) = Self::anchors(&shapes);
+        let valid_t = Tensor::from_vec(valid, (s, 1), &dev)?;
+        let anchors_t = Tensor::from_vec(anchors, (s, 4), &dev)?;
+        let out_mem = self.enc_ln.forward(&self.enc_out.forward(&memory.broadcast_mul(&valid_t)?)?)?;
+        let enc_cls = self.enc_score.forward(&out_mem)?;
+        let enc_box = (self.enc_box.forward(&out_mem)? + &anchors_t)?;
+        let best: Vec<f32> = enc_cls.max(D::Minus1)?.to_vec1()?;
+        let nq = 300.min(s).min(MAX_QUERIES);
+        let mut order: Vec<usize> = (0..s).collect();
+        order.sort_by(|&a, &b| best[b].partial_cmp(&best[a]).unwrap_or(std::cmp::Ordering::Equal).then(a.cmp(&b)));
+        order.truncate(nq);
+        let idx = Tensor::from_vec(order.iter().map(|&i| i as u32).collect::<Vec<_>>(), nq, &dev)?;
+        let mut refs_unact = enc_box.index_select(&idx, 0)?;
+        let mut target = out_mem.index_select(&idx, 0)?;
+        let value_all = memory.clone();
+        let sig = |t: &Tensor| candle_nn::ops::sigmoid(t);
+        let mut refs = sig(&refs_unact)?;
+        let mut logits = Vec::new();
+        for (i, l) in self.layers.iter().enumerate() {
+            let pos = self.query_pos.forward(&refs)?;
+            // self-attention
+            let a = l.attn.forward(&target, Some(&pos))?;
+            let hdn = l.ln1.forward(&(&target + a)?)?;
+            // deformable cross-attention
+            let qin = (&hdn + &pos)?;
+            let value = l.value.forward(&value_all)?;
+            let offs = l.offsets.forward(&qin)?;
+            let attw = l.weights.forward(&qin)?;
+            let sampled = Self::sample(&to_vec_c(&value)?, &shapes, &starts, &to_vec_c(&refs)?, &to_vec_c(&offs)?, &to_vec_c(&attw)?, nq, self.dim);
+            let ca = l.out.forward(&Tensor::from_vec(sampled, (nq, self.dim), &dev)?)?;
+            let hdn = l.ln2.forward(&(&hdn + ca)?)?;
+            let m = l.fc2.forward(&l.fc1.forward(&hdn)?.relu()?)?;
+            target = l.ln3.forward(&(&hdn + m)?)?;
+            // box refinement
+            let delta = self.box_heads[i].forward(&target)?;
+            refs_unact = (delta + inv_sigmoid(&refs)?)?;
+            refs = sig(&refs_unact)?;
+            if i + 1 == self.layers.len() {
+                logits = to_vec_c(&self.class_heads[i].forward(&target)?)?;
+            }
+        }
+        Ok(Raw { logits, boxes: to_vec_c(&refs)?, queries: nq, classes: self.classes })
+    }
+
+    /// Detections of `img` with a score above `min_score`: the best class of each query, boxes as
+    /// fractions of the picture. The image is resized so its long side is `side` (a multiple of
+    /// 32 on both sides).
+    pub fn detect(&self, img: &Image, side: usize, min_score: f32) -> Result<Vec<Obj>> {
+        let side = side.clamp(160, 1280);
+        let scale = side as f32 / img.w.max(img.h) as f32;
+        let nw = (((img.w as f32 * scale).round() as usize).max(32)).div_ceil(32) * 32;
+        let nh = (((img.h as f32 * scale).round() as usize).max(32)).div_ceil(32) * 32;
+        let mut planar = img.resize_planar_aa(nw, nh, [0, 1, 2]);
+        planar.iter_mut().for_each(|v| *v /= 255.0);
+        let raw = self.raw(planar, nw, nh)?;
+        let mut out = Vec::new();
+        for q in 0..raw.queries {
+            let l = &raw.logits[q * raw.classes..(q + 1) * raw.classes];
+            let (class, best) = l.iter().enumerate().fold((0usize, f32::MIN), |a, (i, &v)| if v > a.1 { (i, v) } else { a });
+            let score = 1.0 / (1.0 + (-best).exp());
+            if score < min_score {
+                continue;
+            }
+            let b = &raw.boxes[q * 4..q * 4 + 4];
+            let r = Rect::new(
+                (b[0] - b[2] / 2.0).clamp(0.0, 1.0),
+                (b[1] - b[3] / 2.0).clamp(0.0, 1.0),
+                (b[0] + b[2] / 2.0).clamp(0.0, 1.0),
+                (b[1] + b[3] / 2.0).clamp(0.0, 1.0),
+            );
+            if r.area() > 0.0 {
+                out.push(Obj { rect: r, score, class: class as u16 });
+            }
+        }
+        out.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal));
+        Ok(out)
+    }
+}
+
+fn to_vec_c(t: &Tensor) -> candle_core::Result<Vec<f32>> {
+    t.flatten_all()?.to_vec1()
+}
+
+fn inv_sigmoid(x: &Tensor) -> candle_core::Result<Tensor> {
+    let x = x.clamp(0f32, 1f32)?;
+    let x1 = x.clamp(1e-5f32, 1f32)?;
+    let x2 = x.affine(-1.0, 1.0)?.clamp(1e-5f32, 1f32)?;
+    (x1 / x2)?.log()
+}
diff --git a/crates/reframe/src/track.rs b/crates/reframe/src/track.rs
new file mode 100644
index 0000000..0f6f800
--- /dev/null
+++ b/crates/reframe/src/track.rs
@@ -0,0 +1,116 @@
+//! Links the detections of consecutive samples into tracks, so "the same face" keeps one id
+//! while it moves. Greedy matching on overlap, with a centre-distance fallback for fast motion.
+
+use crate::Rect;
+
+/// What a detection is. Faces are preferred over people, people over other objects.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Kind {
+    Face,
+    Person,
+    Object,
+}
+
+/// One detection in one sample.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Det {
+    pub rect: Rect,
+    pub score: f32,
+    pub kind: Kind,
+}
+
+/// Samples a track may be missing for before it is closed.
+const MAX_GAP: usize = 4;
+/// Most tracks kept alive at once (hostile input cannot grow the work without bound).
+const MAX_ACTIVE: usize = 128;
+
+struct Active {
+    id: u32,
+    last: Rect,
+    kind: Kind,
+    seen: usize,
+}
+
+/// Gives every detection a track id: `frames[i][j]` gets `result[i][j]`. Ids start at 0 and grow;
+/// a detection only continues a track of its own kind.
+pub fn link(frames: &[Vec<Det>]) -> Vec<Vec<u32>> {
+    let mut active: Vec<Active> = Vec::new();
+    let mut next = 0u32;
+    let mut out = Vec::with_capacity(frames.len());
+    for (i, dets) in frames.iter().enumerate() {
+        active.retain(|a| i - a.seen <= MAX_GAP);
+        let mut ids = vec![u32::MAX; dets.len()];
+        // all (cost, track, det) pairs that plausibly match, best first
+        let mut pairs: Vec<(f32, usize, usize)> = Vec::new();
+        for (ti, a) in active.iter().enumerate() {
+            for (di, d) in dets.iter().enumerate() {
+                if d.kind != a.kind {
+                    continue;
+                }
+                let iou = a.last.iou(&d.rect);
+                let dist = ((a.last.cx() - d.rect.cx()).powi(2) + (a.last.cy() - d.rect.cy()).powi(2)).sqrt();
+                let size = a.last.w().max(d.rect.w()).max(1e-4);
+                // moved less than 1.5 sizes and not a wildly different size
+                let ratio = (a.last.area().max(1e-9) / d.rect.area().max(1e-9)).max(d.rect.area().max(1e-9) / a.last.area().max(1e-9));
+                if iou > 0.1 || (dist < 1.5 * size && ratio < 4.0) {
+                    pairs.push((1.0 - iou + dist / size * 0.25, ti, di));
+                }
+            }
+        }
+        pairs.sort_by(|a, b| a.0.partial_cmp(&b.0).unwrap_or(std::cmp::Ordering::Equal));
+        let mut used = vec![false; active.len()];
+        for (_, ti, di) in pairs {
+            if used[ti] || ids[di] != u32::MAX {
+                continue;
+            }
+            used[ti] = true;
+            ids[di] = active[ti].id;
+            active[ti].last = dets[di].rect;
+            active[ti].seen = i;
+        }
+        for (di, d) in dets.iter().enumerate() {
+            if ids[di] == u32::MAX {
+                ids[di] = next;
+                if active.len() < MAX_ACTIVE {
+                    active.push(Active { id: next, last: d.rect, kind: d.kind, seen: i });
+                }
+                next = next.wrapping_add(1);
+            }
+        }
+        out.push(ids);
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn face(x: f32) -> Det {
+        Det { rect: Rect::new(x, 0.3, x + 0.1, 0.45), score: 0.9, kind: Kind::Face }
+    }
+
+    #[test]
+    fn a_moving_face_keeps_its_id_and_two_faces_get_two() {
+        let frames = vec![vec![face(0.1), face(0.7)], vec![face(0.12), face(0.68)], vec![face(0.7), face(0.15)]];
+        let ids = link(&frames);
+        assert_eq!(ids[0], vec![0, 1]);
+        assert_eq!(ids[1], vec![0, 1]);
+        assert_eq!(ids[2], vec![1, 0]);
+    }
+
+    #[test]
+    fn a_track_survives_a_short_gap_but_not_a_long_one() {
+        let mut frames = vec![vec![face(0.4)], vec![], vec![face(0.41)]];
+        assert_eq!(link(&frames)[2], vec![0]);
+        frames.splice(1..1, std::iter::repeat_n(Vec::new(), 8));
+        assert_ne!(link(&frames).last().cloned().unwrap_or_default(), vec![0]);
+    }
+
+    #[test]
+    fn kinds_do_not_mix() {
+        let p = Det { kind: Kind::Person, ..face(0.1) };
+        let ids = link(&[vec![face(0.1)], vec![p]]);
+        assert_ne!(ids[0][0], ids[1][0]);
+    }
+}
diff --git a/crates/reframe/src/yunet.rs b/crates/reframe/src/yunet.rs
new file mode 100644
index 0000000..e47a06e
--- /dev/null
+++ b/crates/reframe/src/yunet.rs
@@ -0,0 +1,184 @@
+//! YuNet (2023mar) face detector on candle.
+//!
+//! A tiny anchor-free detector (about 75 k parameters): a depth-wise separable backbone, a
+//! three-level feature pyramid and one head per stride (8, 16, 32) that gives a face score, a box
+//! and five landmarks per cell. The input is BGR in 0..255, any size that is a multiple of 32.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use candle_core::{Device, Tensor};
+
+use crate::nn::{Conv, get, load_weights, net, to_vec};
+use crate::{Face, Image, Rect, ReframeError, Result, nms};
+
+/// The file the model is read from, inside its folder.
+pub const FILE: &str = "model.safetensors";
+/// The model folder name under the Jacnex models directory.
+pub const MODEL_ID: &str = "reframe-yunet-2023mar";
+/// The longest side the detector is run at (faces are small, so a large size helps close-ups less
+/// than wide shots; 960 keeps a face of 1/40 of the frame width visible).
+pub const DEFAULT_SIDE: usize = 960;
+const STRIDES: [usize; 3] = [8, 16, 32];
+const MAX_FACES: usize = 64;
+
+/// A depth-wise separable unit: 1x1 conv, then 3x3 depth-wise conv, then optional ReLU.
+struct Unit {
+    pw: Conv,
+    dw: Conv,
+    relu: bool,
+}
+
+impl Unit {
+    fn load(w: &HashMap<String, Tensor>, i: usize, relu: bool, groups_dw: Option<usize>) -> Result<Self> {
+        let mk = |i: usize, pad: usize, groups: Option<usize>| -> Result<Conv> {
+            let wt = get(w, &format!("conv{i:02}.weight"))?.clone();
+            let b = get(w, &format!("conv{i:02}.bias"))?.clone();
+            let g = groups.unwrap_or(1);
+            Ok(Conv { w: wt, b: Some(b), pad: (pad, pad), stride: 1, groups: g })
+        };
+        let pw = mk(i, 0, None)?;
+        let out = pw.w.dim(0).map_err(net)?;
+        let dw = mk(i + 1, 1, Some(groups_dw.unwrap_or(out)))?;
+        Ok(Self { pw, dw, relu })
+    }
+
+    fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        let y = self.dw.forward(&self.pw.forward(x)?)?;
+        if self.relu { y.relu() } else { Ok(y) }
+    }
+}
+
+/// The loaded detector.
+pub struct YuNet {
+    stem: Conv,
+    /// model0.conv2 .. model5.conv2 (two units per stage, in graph order, with pooling points).
+    backbone: Vec<Unit>,
+    lateral: [Unit; 3],
+    /// Per level: cls, bbox, obj, kps heads (two convs each).
+    heads: [[Unit; 4]; 3],
+}
+
+impl YuNet {
+    /// Loads the detector from `dir/model.safetensors`.
+    pub fn load(dir: &Path) -> Result<Self> {
+        let w = load_weights(dir, FILE)?;
+        let stem = Conv { w: get(&w, "conv00.weight")?.clone(), b: Some(get(&w, "conv00.bias")?.clone()), pad: (1, 1), stride: 2, groups: 1 };
+        // units 1..=22 are backbone pairs (1,2) (3,4) ... (21,22)
+        let mut backbone = Vec::new();
+        for i in (1..=21).step_by(2) {
+            backbone.push(Unit::load(&w, i, true, None)?);
+        }
+        let lateral = [Unit::load(&w, 23, true, None)?, Unit::load(&w, 25, true, None)?, Unit::load(&w, 27, true, None)?];
+        // heads: cls 29.., bbox 35.., obj 41.., kps 47.. ; per level a pair (no ReLU)
+        let head = |base: usize, lvl: usize| Unit::load(&w, base + lvl * 2, false, None);
+        let mk = |lvl: usize| -> Result<[Unit; 4]> { Ok([head(29, lvl)?, head(35, lvl)?, head(41, lvl)?, head(47, lvl)?]) };
+        let heads = [mk(0)?, mk(1)?, mk(2)?];
+        Ok(Self { stem, backbone, lateral, heads })
+    }
+
+    fn pool(x: &Tensor) -> candle_core::Result<Tensor> {
+        x.max_pool2d_with_stride(2, 2)
+    }
+
+    /// Raw network outputs for a BGR planar float image of `w` x `h` (both multiples of 32):
+    /// per level, `[cls, obj, bbox, kps]` flattened over (cell, channel).
+    fn forward(&self, planar: Vec<f32>, w: usize, h: usize) -> candle_core::Result<Vec<[Tensor; 4]>> {
+        let x = Tensor::from_vec(planar, (1, 3, h, w), &Device::Cpu)?;
+        let mut x = self.stem.forward(&x)?.relu()?;
+        let u = &self.backbone;
+        // s2 -> s4
+        x = Self::pool(&u[0].forward(&x)?)?;
+        x = u[1].forward(&x)?;
+        x = u[2].forward(&x)?;
+        x = u[3].forward(&x)?;
+        x = u[4].forward(&x)?;
+        x = Self::pool(&x)?; // s8
+        x = u[5].forward(&x)?;
+        let p3 = u[6].forward(&x)?;
+        x = Self::pool(&p3)?; // s16
+        x = u[7].forward(&x)?;
+        let p4 = u[8].forward(&x)?;
+        x = Self::pool(&p4)?; // s32
+        x = u[9].forward(&x)?;
+        let p5 = u[10].forward(&x)?;
+        let n2 = self.lateral[0].forward(&p5)?;
+        let up = |t: &Tensor| -> candle_core::Result<Tensor> { t.upsample_nearest2d(t.dim(2)? * 2, t.dim(3)? * 2) };
+        let n1 = self.lateral[1].forward(&p4.broadcast_add(&up(&n2)?)?)?;
+        let n0 = self.lateral[2].forward(&p3.broadcast_add(&up(&n1)?)?)?;
+        let mut out = Vec::new();
+        for (lvl, f) in [n0, n1, n2].iter().enumerate() {
+            let hd = &self.heads[lvl];
+            let one = |u: &Unit| -> candle_core::Result<Tensor> {
+                let y = u.forward(f)?;
+                let ch = y.dim(1)?;
+                y.permute((0, 2, 3, 1))?.reshape((y.dim(2)? * y.dim(3)?, ch))
+            };
+            out.push([one(&hd[0])?, one(&hd[2])?, one(&hd[1])?, one(&hd[3])?]);
+        }
+        Ok(out)
+    }
+
+    /// Faces of `img`, boxes and landmarks as fractions of the picture. `min_score` is the
+    /// confidence threshold (0.6 is a good default); at most 64 faces come back.
+    pub fn detect(&self, img: &Image, side: usize, min_score: f32) -> Result<Vec<Face>> {
+        let side = side.clamp(64, 2048);
+        let scale = side as f32 / img.w.max(img.h) as f32;
+        let nw = ((img.w as f32 * scale).round() as usize).max(32).div_ceil(32) * 32;
+        let nh = ((img.h as f32 * scale).round() as usize).max(32).div_ceil(32) * 32;
+        let planar = img.resize_planar(nw, nh, [2, 1, 0]);
+        let outs = self.forward(planar, nw, nh).map_err(net)?;
+        let mut faces = Vec::new();
+        for (lvl, o) in outs.iter().enumerate() {
+            let s = STRIDES[lvl] as f32;
+            let (cols, rows) = (nw / STRIDES[lvl], nh / STRIDES[lvl]);
+            let cls = to_vec(&o[0])?;
+            let obj = to_vec(&o[1])?;
+            let bbox = to_vec(&o[2])?;
+            let kps = to_vec(&o[3])?;
+            if cls.len() != rows * cols || bbox.len() != rows * cols * 4 || kps.len() != rows * cols * 10 {
+                return Err(ReframeError::Net("unexpected head size".into()));
+            }
+            for r in 0..rows {
+                for c in 0..cols {
+                    let i = r * cols + c;
+                    let sig = |v: f32| 1.0 / (1.0 + (-v).exp());
+                    let score = (sig(cls[i]).clamp(0.0, 1.0) * sig(obj[i]).clamp(0.0, 1.0)).sqrt();
+                    if score < min_score {
+                        continue;
+                    }
+                    let b = &bbox[i * 4..i * 4 + 4];
+                    let cx = (c as f32 + b[0]) * s;
+                    let cy = (r as f32 + b[1]) * s;
+                    let bw = b[2].clamp(-10.0, 10.0).exp() * s;
+                    let bh = b[3].clamp(-10.0, 10.0).exp() * s;
+                    let rect = Rect::new((cx - bw / 2.0) / nw as f32, (cy - bh / 2.0) / nh as f32, (cx + bw / 2.0) / nw as f32, (cy + bh / 2.0) / nh as f32);
+                    let mut lm = [(0.0, 0.0); 5];
+                    for (n, l) in lm.iter_mut().enumerate() {
+                        let k = &kps[i * 10 + n * 2..i * 10 + n * 2 + 2];
+                        *l = (((k[0] + c as f32) * s) / nw as f32, ((k[1] + r as f32) * s) / nh as f32);
+                    }
+                    faces.push(Face { rect, score, landmarks: lm });
+                }
+            }
+        }
+        nms(&mut faces, |f| f.rect, |f| f.score, 0.3, MAX_FACES);
+        Ok(faces)
+    }
+
+    /// The raw outputs, for tests against a reference.
+    #[doc(hidden)]
+    pub fn raw(&self, bgr_planar: Vec<f32>, w: usize, h: usize) -> Result<Vec<Vec<f32>>> {
+        if bgr_planar.len() != 3 * w * h || !w.is_multiple_of(32) || !h.is_multiple_of(32) || w == 0 || h == 0 {
+            return Err(ReframeError::Image("bad raw size".into()));
+        }
+        let outs = self.forward(bgr_planar, w, h).map_err(net)?;
+        let mut v = Vec::new();
+        for o in &outs {
+            for t in o {
+                v.push(to_vec(t)?);
+            }
+        }
+        Ok(v)
+    }
+}
