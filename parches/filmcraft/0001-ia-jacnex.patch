+    /// Un /v1/jacnex falso: estado, generar, trabajo (listo a la segunda consulta) y el «video».
+    fn servidor_falso() -> (String, std::sync::Arc<std::sync::Mutex<Vec<Vec<u8>>>>) {
+        servidor_con(Vec::new())
+    }
+
+    /// [`servidor_falso`]; la mejora de calidad devuelve `mejorado`. Según el modelo pedido
+    /// responde un «video» (PNG), un audio (WAV) o dos (la música).
+    fn servidor_con(mejorado: Vec<u8>) -> (String, std::sync::Arc<std::sync::Mutex<Vec<Vec<u8>>>>) {
+        use std::io::{BufRead, BufReader, Read, Write};
+        let l = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let base = format!("http://127.0.0.1:{}", l.local_addr().unwrap().port());
+        let recibido = std::sync::Arc::new(std::sync::Mutex::new(Vec::new()));
+        let (r2, base2) = (recibido.clone(), base.clone());
+        std::thread::spawn(move || {
+            let mut consultas = 0;
+            let mut rutas: Vec<&str> = Vec::new();
+            for s in l.incoming() {
+                let Ok(mut s) = s else { continue };
+                let mut lector = BufReader::new(s.try_clone().unwrap());
+                let mut linea = String::new();
+                if lector.read_line(&mut linea).is_err() {
+                    continue;
+                }
+                let mut largo = 0usize;
+                loop {
+                    let mut h = String::new();
+                    if lector.read_line(&mut h).unwrap_or(0) == 0 || h.trim_end().is_empty() {
+                        break;
+                    }
+                    if let Some(v) = h.to_ascii_lowercase().strip_prefix("content-length:") {
+                        largo = v.trim().parse().unwrap();
+                    }
+                }
+                let mut cuerpo = vec![0; largo];
+                let _ = lector.read_exact(&mut cuerpo);
+                let ruta = linea.split_whitespace().nth(1).unwrap_or("").to_string();
+                let (tipo, datos) = if ruta == "/r/video" {
+                    ("application/octet-stream", png())
+                } else if ruta.starts_with("/r/audio") {
+                    ("audio/wav", wav())
+                } else if ruta == "/r/mejorado" {
+                    ("video/mp4", mejorado.clone())
+                } else if ruta == "/v1/jacnex/estado" {
+                    ("application/json", info_prueba().to_string().into_bytes())
+                } else if ruta == "/v1/jacnex/generar" {
+                    let modelo = |m: &str| {
+                        let campo = format!("name=\"model\"\r\n\r\n{m}\r\n");
+                        cuerpo.windows(campo.len()).any(|w| w == campo.as_bytes())
+                    };
+                    rutas = if modelo("musica-suno") {
+                        vec!["/r/audio1", "/r/audio2"]
+                    } else if modelo("voz-turbo") || modelo("voz-premium") || modelo("efecto-sonido") {
+                        vec!["/r/audio1"]
+                    } else if modelo("mejorar-video") {
+                        vec!["/r/mejorado"]
+                    } else {
+                        vec!["/r/video"]
+                    };
+                    r2.lock().unwrap().push(cuerpo);
+                    consultas = 0;
+                    ("application/json", json!({"id": "t1", "creditos": 30, "saldo": 470}).to_string().into_bytes())
+                } else {
+                    consultas += 1;
+                    let resultados: Vec<String> = rutas.iter().map(|r| format!("{base2}{r}")).collect();
+                    let v = if consultas < 2 { json!({"estado": "procesando"}) } else { json!({"estado": "listo", "resultados": resultados}) };
+                    ("application/json", v.to_string().into_bytes())
+                };
+                let _ = write!(s, "HTTP/1.1 200 OK\r\nContent-Type: {tipo}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", datos.len());
+                let _ = s.write_all(&datos);
+            }
+        });
+        (base, recibido)
+    }
