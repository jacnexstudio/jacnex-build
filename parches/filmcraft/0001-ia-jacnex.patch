--- /dev/null
+++ b/crates/ui-egui/src/jacnex_edicion.rs
@@ -0,0 +1,481 @@
+//! Jacnex: editar con la voz (IA de Jacnex › Editar):
+//! - **Subtítulos**: animados (la palabra que se dice resaltada, palabra por palabra o
+//!   clásicos), en una pista de video nueva.
+//! - **Quitar silencios** y **quitar muletillas** («eh», «este,», «o sea,»…).
+//! - **Editar por texto**: el panel Texto › Transcripción, donde borrar palabras corta el video.
+//!
+//! Cada herramienta transcribe antes lo que falte, en un hilo aparte (la ventana no se congela),
+//! con uno de dos motores:
+//! - **Whisper large-v3-turbo**, en esta computadora y sin créditos. La primera vez se descarga
+//!   el modelo de voz, después de preguntar.
+//! - **Nemotron 3.5 Transcribe**, en el servidor de Jacnex ([`crate::jacnex_nemotron`]): usa
+//!   créditos y no descarga nada.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::time::{Duration, Instant};
+
+use filmcraft_engine::speech_job::{self, SpeechProgress, SpeechResult};
+use serde_json::{Value, json};
+
+use crate::FilmcraftApp;
+
+/// Lo que se hace al terminar de transcribir.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Despues {
+    /// Solo transcribir (el botón «Transcribir» del panel Texto).
+    Nada,
+    Subtitulos,
+    Silencios,
+    Muletillas,
+    PorTexto,
+    /// Jacnex: «Versión corta»: tras transcribir, arma el texto para la IA.
+    Corta,
+}
+
+/// Los estilos de subtítulos: (id del motor, nombre).
+pub const ESTILOS: &[(&str, &str)] = &[("highlight", "Palabra resaltada"), ("word", "Palabra por palabra"), ("classic", "Clásico")];
+/// Dónde van los subtítulos: (id del motor, nombre).
+pub const POSICIONES: &[(&str, &str)] = &[("bottom", "Abajo"), ("middle", "Centro"), ("top", "Arriba")];
+/// Los colores del resaltado: (hex, nombre).
+pub const COLORES: &[(&str, &str)] = &[("#FFD600", "Amarillo"), ("#2BE38B", "Verde"), ("#38B6FF", "Celeste"), ("#FF5C8A", "Rosado")];
+/// Cuánto debe durar un silencio para quitarlo (segundos).
+pub const PAUSAS: &[f32] = &[0.5, 0.8, 1.2, 2.0];
+pub const PAUSA: f32 = 0.8;
+/// El idioma de lo que se habla: (código para Whisper, nombre).
+pub const IDIOMAS: &[(&str, &str)] = &[("es", "Español"), ("auto", "Automático"), ("en", "Inglés"), ("pt", "Portugués")];
+/// Quién transcribe: (id, nombre).
+pub const MOTORES: &[(&str, &str)] = &[("whisper", "Whisper large-v3-turbo"), ("nemotron", "Nemotron 3.5 Transcribe")];
+/// El modelo de Whisper que usan estas herramientas (aunque Ajustes tenga otro).
+pub const WHISPER: &str = "whisper-large-v3-turbo";
+
+/// Los ajustes de las herramientas y la transcripción en curso.
+#[derive(Default)]
+pub struct Edicion {
+    /// El estilo de subtítulos (vacío = el primero).
+    pub estilo: String,
+    pub posicion: String,
+    /// El color del resaltado (vacío = el primero).
+    pub color: String,
+    /// Los segundos de silencio que se quitan (0 = [`PAUSA`]).
+    pub pausa: f32,
+    /// El idioma que se habla (vacío = español).
+    pub idioma: String,
+    /// Quién transcribe (vacío = Whisper, en esta computadora).
+    pub motor: String,
+    trabajo: Option<Transcripcion>,
+    /// La descarga del modelo espera un sí: (bytes, lo que se hará luego).
+    pub pide_descarga: Option<(u64, Despues)>,
+    /// El último aviso: (salió bien, texto).
+    pub aviso: Option<(bool, String)>,
+}
+
+fn elegido<'a>(lista: &'a [(&'a str, &'a str)], valor: &str) -> &'a str {
+    lista.iter().find(|(id, _)| *id == valor).or(lista.first()).map_or("", |(id, _)| *id)
+}
+
+impl Edicion {
+    pub fn estilo_actual(&self) -> &str {
+        elegido(ESTILOS, &self.estilo)
+    }
+    pub fn posicion_actual(&self) -> &str {
+        elegido(POSICIONES, &self.posicion)
+    }
+    pub fn color_actual(&self) -> &str {
+        elegido(COLORES, &self.color)
+    }
+    pub fn idioma_actual(&self) -> &str {
+        elegido(IDIOMAS, &self.idioma)
+    }
+    pub fn motor_actual(&self) -> &str {
+        elegido(MOTORES, &self.motor)
+    }
+    /// Transcribe Nemotron, en el servidor (usa créditos).
+    pub fn en_nube(&self) -> bool {
+        self.motor_actual() == "nemotron"
+    }
+    pub fn pausa_actual(&self) -> f32 {
+        if PAUSAS.contains(&self.pausa) { self.pausa } else { PAUSA }
+    }
+    pub fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    /// Lo que se ve mientras transcribe: (texto, avance 0..1 si se sabe).
+    pub fn progreso(&self) -> Option<(String, Option<f32>)> {
+        let t = self.trabajo.as_ref()?;
+        let parado = t.parar.load(Ordering::Relaxed);
+        if parado {
+            return Some(("Deteniendo…".into(), None));
+        }
+        Some(match t.progreso {
+            None => ("Preparando…".into(), None),
+            Some(SpeechProgress::Download { done, total }) => {
+                let f = if total > 0 { (done as f64 / total as f64) as f32 } else { 0.0 };
+                (format!("Descargando el modelo de voz… {} de {} MB", done / MB, total.max(1).div_ceil(MB)), Some(f))
+            }
+            Some(SpeechProgress::Loading) => ("Cargando el modelo de voz…".into(), None),
+            Some(SpeechProgress::Reading { item, of }) => (format!("Leyendo el audio{}…", de(item, of)), None),
+            Some(SpeechProgress::Transcribing { item, of, fraction }) => {
+                let n = of.max(1) as f32;
+                let quien = if t.nube { " con Nemotron" } else { "" };
+                (format!("Transcribiendo{quien}{}… {:.0} %", de(item, of), fraction * 100.0), Some((item as f32 + fraction) / n))
+            }
+        })
+    }
+
+    /// Los segundos desde que empezó la transcripción.
+    pub fn segundos(&self) -> u64 {
+        self.trabajo.as_ref().map_or(0, |t| t.inicio.elapsed().as_secs())
+    }
+
+    /// Detiene la transcripción en curso.
+    pub fn detener(&mut self) {
+        if let Some(t) = &self.trabajo {
+            t.parar.store(true, Ordering::Relaxed);
+        }
+    }
+}
+
+const MB: u64 = 1024 * 1024;
+
+fn de(item: usize, of: usize) -> String {
+    if of > 1 { format!(" el clip {} de {}", item + 1, of) } else { String::new() }
+}
+
+enum Mensaje {
+    Progreso(SpeechProgress),
+    Fin(Result<SpeechResult, String>),
+}
+
+struct Transcripcion {
+    rx: Receiver<Mensaje>,
+    parar: Arc<AtomicBool>,
+    despues: Despues,
+    progreso: Option<SpeechProgress>,
+    inicio: Instant,
+    /// La hace Nemotron (al terminar se vuelve a pedir el saldo).
+    nube: bool,
+}
+
+/// Se puede transcribir en esta versión.
+pub fn hay_voz(app: &FilmcraftApp) -> bool {
+    app.session.transcriber.is_some() || filmcraft_engine::transcript::speech_available()
+}
+
+/// Se puede transcribir con el motor elegido (Nemotron no necesita nada de esta computadora).
+pub fn puede_transcribir(app: &FilmcraftApp) -> bool {
+    app.jacnex_ia.edicion.en_nube() || hay_voz(app)
+}
+
+/// Lo que se cobraría por transcribir con Nemotron lo que falta de la secuencia (`None` con
+/// Whisper o si no falta nada).
+pub fn costo_nube(app: &FilmcraftApp) -> Option<i64> {
+    if !app.jacnex_ia.edicion.en_nube() {
+        return None;
+    }
+    let plan = crate::jacnex_nemotron::Plan::de(app.jacnex_ia.motor_nube(crate::jacnex_nemotron::MODELO));
+    let total: i64 = speech_job::untranscribed_sequence_items(&app.session)
+        .iter()
+        .filter_map(|i| match app.session.project.item(*i).map(|it| &it.kind) {
+            Some(filmcraft_project::ItemKind::Media(m)) => Some(plan.creditos(m.duration().seconds().min(speech_job::MAX_SPEECH_SECONDS as f64))),
+            _ => None,
+        })
+        .fold(0i64, i64::saturating_add);
+    (total > 0).then_some(total)
+}
+
+/// Por qué no se puede usar la herramienta ahora (o nada).
+pub fn falta(app: &FilmcraftApp, despues: Despues) -> Option<&'static str> {
+    let ed = &app.jacnex_ia.edicion;
+    if ed.ocupado() {
+        return Some("Espera a que termine la transcripción.");
+    }
+    if app.session.active_sequence().is_none() {
+        return Some("Abre una secuencia con voz.");
+    }
+    let palabras = !filmcraft_engine::transcript::sequence_words(&app.session).is_empty();
+    let faltan = !speech_job::untranscribed_sequence_items(&app.session).is_empty();
+    if !palabras && !faltan {
+        return Some("La secuencia no tiene clips con audio.");
+    }
+    if faltan && ed.en_nube() && !app.jacnex_ia.hay_sesion() {
+        return Some("Inicia sesión en Jacnex Studio para usar Nemotron.");
+    }
+    if faltan && !puede_transcribir(app) && !(palabras && despues != Despues::Nada) {
+        return Some("Esta versión no puede transcribir: elige Nemotron o actualiza Filmnex.");
+    }
+    None
+}
+
+/// Usa una herramienta: transcribe lo que falte (preguntando antes de descargar el modelo) y
+/// luego hace `despues`.
+pub fn ejecutar(app: &mut FilmcraftApp, despues: Despues, descarga_aceptada: bool) {
+    let nube = app.jacnex_ia.edicion.en_nube();
+    if nube {
+        // la sesión pudo iniciarse con la ventana cerrada
+        app.jacnex_ia.mirar_sesion();
+    }
+    if let Some(f) = falta(app, despues) {
+        app.jacnex_ia.edicion.aviso = Some((false, f.into()));
+        return;
+    }
+    app.jacnex_ia.edicion.pide_descarga = None;
+    app.jacnex_ia.edicion.aviso = None;
+    let faltan = speech_job::untranscribed_sequence_items(&app.session);
+    if faltan.is_empty() || !puede_transcribir(app) {
+        hacer(app, despues);
+        return;
+    }
+    let ids: Vec<u64> = faltan.iter().map(|i| i.0).collect();
+    let idioma = app.jacnex_ia.edicion.idioma_actual().to_string();
+    let p = json!({"items": ids, "language": idioma, "download": true, "model": WHISPER});
+    let job = if nube {
+        let Some(conexion) = crate::jacnex_ia::conexion(&app.jacnex_ia) else {
+            app.jacnex_ia.edicion.aviso = Some((false, "Inicia sesión en Jacnex Studio para usar Nemotron.".into()));
+            return;
+        };
+        let plan = crate::jacnex_nemotron::Plan::de(app.jacnex_ia.motor_nube(crate::jacnex_nemotron::MODELO));
+        speech_job::speech_job_using(&app.session, &p, Arc::new(crate::jacnex_nemotron::Nemotron { conexion, plan }))
+    } else {
+        speech_job::speech_job(&app.session, &p)
+    };
+    let job = match job {
+        Ok(j) => j,
+        Err(e) => {
+            // lo que no se puede leer no impide usar lo ya transcrito
+            if filmcraft_engine::transcript::sequence_words(&app.session).is_empty() {
+                app.jacnex_ia.edicion.aviso = Some((false, format!("No se pudo transcribir: {}", motivo(&e.to_string()))));
+            } else {
+                hacer(app, despues);
+            }
+            return;
+        }
+    };
+    if !descarga_aceptada && let Some(n) = job.download_size() {
+        app.jacnex_ia.edicion.pide_descarga = Some((n, despues));
+        return;
+    }
+    let parar = Arc::new(AtomicBool::new(false));
+    let (tx, rx) = std::sync::mpsc::channel();
+    let p2 = parar.clone();
+    let hilo = std::thread::Builder::new().name("jacnex-transcribir".into()).spawn(move || {
+        let tx2 = tx.clone();
+        let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || {
+            let mut ultimo = Instant::now() - Duration::from_secs(1);
+            job.run(&mut |p| {
+                // no más de unas 20 veces por segundo (la descarga avisa por cada bloque)
+                if ultimo.elapsed() >= Duration::from_millis(50) || !matches!(p, SpeechProgress::Download { .. }) {
+                    ultimo = Instant::now();
+                    let _ = tx2.send(Mensaje::Progreso(p));
+                }
+                !p2.load(Ordering::Relaxed)
+            })
+        }));
+        let fin = match r {
+            Ok(Ok(r)) => Ok(r),
+            Ok(Err(e)) => Err(e.to_string()),
+            Err(_) => Err("error interno al transcribir (ver el registro de fallos)".into()),
+        };
+        let _ = tx.send(Mensaje::Fin(fin));
+    });
+    if let Err(e) = hilo {
+        app.jacnex_ia.edicion.aviso = Some((false, format!("No se pudo empezar a transcribir: {e}")));
+        return;
+    }
+    app.jacnex_ia.edicion.trabajo = Some(Transcripcion { rx, parar, despues, progreso: None, inicio: Instant::now(), nube });
+}
+
+/// Un error del motor, en palabras del usuario.
+fn motivo(e: &str) -> String {
+    if e.contains(speech_job::CANCELLED) {
+        "se detuvo.".into()
+    } else if e.contains("no audio to transcribe") || e.contains("nothing to transcribe") {
+        "los clips no tienen audio.".into()
+    } else if e.contains("download") {
+        format!("no se pudo descargar el modelo de voz; revisa tu conexión ({e}).")
+    } else if e.contains("not downloaded") {
+        "falta el modelo de voz.".into()
+    } else {
+        e.to_string()
+    }
+}
+
+/// Recibe el avance de la transcripción y, al terminar, la guarda y hace lo pedido.
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.edicion.trabajo.as_mut() else { return };
+    let mut fin = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Mensaje::Progreso(p)) => t.progreso = Some(p),
+            Ok(Mensaje::Fin(r)) => {
+                fin = Some(r);
+                break;
+            }
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin = Some(Err("la transcripción se interrumpió".into()));
+                break;
+            }
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    };
+    if esperar {
+        // con un diálogo abierto no se toca el proyecto: se vuelve a intentar luego
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(Mensaje::Fin(fin));
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    let despues = t.despues;
+    let parado = t.parar.load(Ordering::Relaxed);
+    let nube = t.nube;
+    app.jacnex_ia.edicion.trabajo = None;
+    if nube {
+        // lo cobrado (o lo devuelto) se ve en el saldo
+        app.jacnex_ia.refrescar();
+    }
+    ctx.request_repaint();
+    match fin {
+        Ok(r) => {
+            if let Err(e) = speech_job::apply_transcripts(&mut app.session, r) {
+                app.jacnex_ia.edicion.aviso = Some((false, format!("No se pudo guardar la transcripción: {e}")));
+                return;
+            }
+            hacer(app, despues);
+        }
+        Err(_) if parado => app.jacnex_ia.edicion.aviso = Some((false, "Transcripción detenida.".into())),
+        Err(e) => app.jacnex_ia.edicion.aviso = Some((false, format!("No se pudo transcribir: {}", motivo(&e)))),
+    }
+}
+
+fn numero(v: &Value, k: &str) -> u64 {
+    v.get(k).and_then(Value::as_u64).unwrap_or(0)
+}
+
+fn plural(n: u64, uno: &str, varios: &str) -> String {
+    if n == 1 { format!("1 {uno}") } else { format!("{n} {varios}") }
+}
+
+/// Hace la herramienta con la transcripción ya lista.
+fn hacer(app: &mut FilmcraftApp, despues: Despues) {
+    if despues == Despues::Corta {
+        crate::jacnex_corta::preparar_luego(app);
+        return;
+    }
+    let ed = &app.jacnex_ia.edicion;
+    let r = match despues {
+        Despues::Nada => Ok("Transcripción lista: está en el panel Texto › Transcripción.".to_string()),
+        Despues::Subtitulos => {
+            let p = json!({"style": ed.estilo_actual(), "position": ed.posicion_actual(), "highlight": ed.color_actual()});
+            app.session.execute("transcript.createAnimatedCaptions", p).map(|v| {
+                let pista = numero(&v, "trackIndex") + 1;
+                format!(
+                    "Listo: {} en la pista V{pista}. Para cambiar el texto, edítalo en el panel Texto.",
+                    plural(numero(&v, "clips"), "subtítulo", "subtítulos")
+                )
+            })
+        }
+        Despues::Silencios => {
+            let pausa = f64::from(ed.pausa_actual());
+            app.session.execute("transcript.removePauses", json!({"minSeconds": pausa, "keepSeconds": 0.15})).map(|v| {
+                let n = numero(&v, "removed");
+                let s = v.get("seconds").and_then(Value::as_f64).unwrap_or(0.0);
+                if n == 0 {
+                    format!("No hay silencios de más de {pausa:.1} s.")
+                } else {
+                    format!("Listo: se quitaron {} ({s:.1} s).", plural(n, "silencio", "silencios"))
+                }
+            })
+        }
+        Despues::Muletillas => app.session.execute("transcript.removeFillersSmart", json!({})).map(|v| {
+            let n = numero(&v, "removed");
+            let lista: Vec<String> = v.get("words").and_then(Value::as_array).map_or_else(Vec::new, |a| {
+                let mut vistas: Vec<String> = Vec::new();
+                for w in a.iter().filter_map(Value::as_str) {
+                    let w = w.trim_end_matches([',', '.', ';', '…']).to_lowercase();
+                    if !vistas.contains(&w) && vistas.len() < 5 {
+                        vistas.push(w);
+                    }
+                }
+                vistas
+            });
+            if n == 0 {
+                "No se encontraron muletillas.".to_string()
+            } else {
+                format!("Listo: se quitaron {} ({}).", plural(n, "muletilla", "muletillas"), lista.join(", "))
+            }
+        }),
+        Despues::PorTexto => {
+            app.show_panel(crate::dock::PanelKind::Text);
+            app.ui.text_tab = "Transcript".into();
+            Ok("Listo: en el panel Texto › Transcripción, selecciona palabras y bórralas (o «Extraer») para cortar el video.".to_string())
+        }
+        Despues::Corta => return, // atendido arriba
+    };
+    app.jacnex_ia.edicion.aviso = Some(match r {
+        Ok(m) => (true, m),
+        Err(e) => (false, format!("No se pudo: {e}")),
+    });
+}
+
+/// El avance de la transcripción (o la pregunta por la descarga, o el último aviso) en el panel
+/// Texto › Transcripción, debajo del botón «Transcribir», dentro de `r`.
+pub fn en_panel(app: &mut FilmcraftApp, ui: &mut egui::Ui, r: egui::Rect) {
+    let t = app.tokens;
+    let mut child = ui.new_child(egui::UiBuilder::new().max_rect(r).id_salt("jacnex-ed-panel").layout(egui::Layout::top_down(egui::Align::Center)));
+    let ui = &mut child;
+    let mut descargar = None;
+    let ed = &mut app.jacnex_ia.edicion;
+    if let Some((texto, avance)) = ed.progreso() {
+        let l = ui.label(egui::RichText::new(format!("{texto}  {} s", ed.segundos())).size(12.0).color(t.text));
+        app.auto.add("text.transcript.progress", l.rect, &texto);
+        if let Some(f) = avance {
+            let b = ui.add(egui::ProgressBar::new(f.clamp(0.0, 1.0)).desired_width(200.0).desired_height(5.0));
+            app.auto.add("text.transcript.progressBar", b.rect, "Avance");
+        }
+        let b = ui.small_button("Detener");
+        app.auto.add("text.transcript.stop", b.rect, "Detener");
+        if b.clicked() {
+            ed.detener();
+        }
+    } else if let Some((bytes, despues)) = ed.pide_descarga {
+        let mb = bytes.div_ceil(MB).max(1);
+        let l = ui.label(
+            egui::RichText::new(format!("La primera vez se descarga el modelo de voz (unos {mb} MB); luego queda en esta computadora."))
+                .size(12.0)
+                .color(t.text),
+        );
+        app.auto.add("text.transcript.downloadNote", l.rect, "Descarga del modelo de voz");
+        ui.horizontal(|ui| {
+            let b = ui.button(format!("Descargar {mb} MB"));
+            app.auto.add("text.transcript.download", b.rect, "Descargar el modelo de voz");
+            if b.clicked() {
+                descargar = Some(despues);
+            }
+            let c = ui.button("Cancelar");
+            app.auto.add("text.transcript.downloadCancel", c.rect, "Cancelar");
+            if c.clicked() {
+                app.jacnex_ia.edicion.pide_descarga = None;
+            }
+        });
+    } else if let Some((ok, m)) = &ed.aviso {
+        let color = if *ok { t.text_dim } else { egui::Color32::from_rgb(230, 120, 90) };
+        let l = ui.label(egui::RichText::new(m.as_str()).size(12.0).color(color));
+        let m = m.clone();
+        app.auto.add("text.transcript.notice", l.rect, &m);
+    }
+    if let Some(d) = descargar {
+        ejecutar(app, d, true);
+    }
+}
