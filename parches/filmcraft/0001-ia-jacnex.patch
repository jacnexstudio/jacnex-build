+/// Elige la imagen para «Animar foto».
+fn elegir_foto(app: &mut FilmcraftApp) {
+    let dialogo = crate::native_dialogs::FileDialog::open_file("Imágenes", &["jpg", "jpeg", "png", "webp"]);
+    let r = app.pick(dialogo, |app, rutas| {
+        if let Some(r) = rutas.into_iter().next() {
+            app.jacnex_ia.foto = Some(r);
+            app.jacnex_ia.aviso = None;
+        }
+        Ok(Value::Null)
+    });
+    if let Err(m) = r {
+        app.jacnex_ia.aviso = Some((false, m));
+    }
+}
