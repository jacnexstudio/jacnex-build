+
+    #[test]
+    fn results_are_ranked_and_bounded() {
+        let s = speech(&[("precio precio precio.", 0.0), ("hablamos del precio de la casa en la ciudad.", 40.0)]);
+        let hits = search("precio", &QueryVectors::default(), &[MediaRef { id: 1, speech: Some(&s), visual: None }]);
