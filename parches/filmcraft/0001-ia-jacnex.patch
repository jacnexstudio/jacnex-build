@@ -0,0 +1,279 @@
+//! Sample-rate conversion with a windowed-sinc kernel (Blackman-Harris, 24 zero crossings), from a table of
+//! fractional phases. It is stateless (`at` reads from any slice), so the chunks of a long clip can be converted
+//! one at a time without seams, and [`Stream`] turns the model's output back to the clip's rate as it is made.
+
+use crate::{Result, SeparateError};
+
+/// Rates accepted (a hostile header must not ask for a huge kernel).
+pub const MIN_RATE: u32 = 1000;
+pub const MAX_RATE: u32 = 768_000;
+/// Fractional phases in the table; positions in between are interpolated linearly.
+const SUB: usize = 512;
+/// Zero crossings of the kernel on each side (at the lower of the two rates).
+const ZEROS: f64 = 24.0;
+
+pub struct Resampler {
+    from: u32,
+    to: u32,
+    /// Input samples per output sample.
+    step: f64,
+    half: usize,
+    width: usize,
+    table: Vec<f32>,
+}
+
+fn sinc(x: f64) -> f64 {
+    if x.abs() < 1e-12 { 1.0 } else { (std::f64::consts::PI * x).sin() / (std::f64::consts::PI * x) }
+}
+
+/// Blackman-Harris window over `t` in `-1..1`.
+fn window(t: f64) -> f64 {
+    if t.abs() >= 1.0 {
+        return 0.0;
+    }
+    let p = std::f64::consts::PI * t;
+    0.358_75 + 0.488_29 * p.cos() + 0.141_28 * (2.0 * p).cos() + 0.011_68 * (3.0 * p).cos()
+}
+
+impl Resampler {
+    pub fn new(from: u32, to: u32) -> Result<Self> {
+        if !(MIN_RATE..=MAX_RATE).contains(&from) || !(MIN_RATE..=MAX_RATE).contains(&to) {
+            return Err(SeparateError::Input(format!("sample rates {from} -> {to} are out of range")));
+        }
+        let step = f64::from(from) / f64::from(to);
+        // going down, the low-pass sits a little under the new Nyquist; going up, at the old one
+        let cutoff = if step > 1.0 { 0.97 / step } else { 1.0 };
+        let radius = ZEROS / cutoff;
+        let half = radius.ceil() as usize;
+        let width = 2 * half;
+        let mut table = vec![0.0f32; (SUB + 1) * width];
+        if from != to {
+            for r in 0..=SUB {
+                let frac = r as f64 / SUB as f64;
+                let row: Vec<f64> = (0..width)
+                    .map(|j| {
+                        let x = j as f64 - (half as f64 - 1.0) - frac;
+                        cutoff * sinc(cutoff * x) * window(x / radius)
+                    })
+                    .collect();
+                let sum: f64 = row.iter().sum();
+                let norm = if sum.abs() > 1e-12 { sum } else { 1.0 };
+                for (j, v) in row.iter().enumerate() {
+                    table[r * width + j] = (v / norm) as f32;
+                }
+            }
+        }
+        Ok(Self { from, to, step, half, width, table })
+    }
+
+    pub fn is_identity(&self) -> bool {
+        self.from == self.to
+    }
+
+    pub fn from_rate(&self) -> u32 {
+        self.from
+    }
+
+    pub fn to_rate(&self) -> u32 {
+        self.to
+    }
+
+    /// Input samples per output sample.
+    pub fn step(&self) -> f64 {
+        self.step
+    }
+
+    /// How far (in input samples) the kernel reaches on each side.
+    pub fn reach(&self) -> usize {
+        self.half
+    }
+
+    /// Output samples for `n` input samples.
+    pub fn out_len(&self, n: usize) -> usize {
+        (n as u128 * u128::from(self.to) / u128::from(self.from)) as usize
+    }
+
+    /// Output sample `j`, reading input from `src`, whose first sample is the input sample number `base`.
+    /// What lies outside `src` counts as silence.
+    pub fn at(&self, src: &[f32], base: i64, j: u64) -> f32 {
+        let p = j as f64 * self.step;
+        let i0 = p.floor();
+        if self.from == self.to {
+            let i = i0 as i64 - base;
+            return if i >= 0 { src.get(i as usize).copied().unwrap_or(0.0) } else { 0.0 };
+        }
+        let frac = (p - i0) * SUB as f64;
+        let r0 = (frac.floor() as usize).min(SUB - 1);
+        let a = (frac - r0 as f64) as f32;
+        let start = i0 as i64 - self.half as i64 + 1 - base;
+        let (row0, row1) = (&self.table[r0 * self.width..(r0 + 1) * self.width], &self.table[(r0 + 1) * self.width..(r0 + 2) * self.width]);
+        let mut acc = 0.0f32;
+        let inside = start >= 0 && start as usize + self.width <= src.len();
+        if inside {
+            let s = &src[start as usize..start as usize + self.width];
+            for j in 0..self.width {
+                acc += s[j] * (row0[j] + a * (row1[j] - row0[j]));
+            }
+        } else {
+            for j in 0..self.width {
+                let i = start + j as i64;
+                if i >= 0 && (i as usize) < src.len() {
+                    acc += src[i as usize] * (row0[j] + a * (row1[j] - row0[j]));
+                }
+            }
+        }
+        acc
+    }
+
+    /// The whole signal at once (the tests and short inputs; long clips go through chunks and [`Stream`]).
+    pub fn convert(&self, input: &[f32]) -> Vec<f32> {
+        (0..self.out_len(input.len()) as u64).map(|j| self.at(input, 0, j)).collect()
+    }
+}
+
+/// Converts a signal that arrives in pieces, holding only the samples the kernel still needs.
+pub struct Stream {
+    rs: Resampler,
+    buf: Vec<f32>,
+    base: i64,
+    next: u64,
+    limit: u64,
+}
+
+impl Stream {
+    /// `limit` is how many output samples the whole signal has.
+    pub fn new(rs: Resampler, limit: u64) -> Self {
+        Self { rs, buf: Vec::new(), base: 0, next: 0, limit }
+    }
+
+    /// Output samples made so far.
+    pub fn made(&self) -> u64 {
+        self.next
+    }
+
+    /// Adds input samples and appends every output sample whose neighbourhood has arrived.
+    pub fn push(&mut self, samples: &[f32], out: &mut Vec<f32>) {
+        self.buf.extend_from_slice(samples);
+        let end = self.base + self.buf.len() as i64;
+        while self.next < self.limit {
+            let i0 = (self.next as f64 * self.rs.step).floor() as i64;
+            if i0 + self.rs.half as i64 >= end {
+                break;
+            }
+            out.push(self.rs.at(&self.buf, self.base, self.next));
+            self.next += 1;
+        }
+        self.trim();
+    }
+
+    /// The input is over: the rest of the output (what is past the end counts as silence).
+    pub fn finish(&mut self, out: &mut Vec<f32>) {
+        while self.next < self.limit {
+            out.push(self.rs.at(&self.buf, self.base, self.next));
+            self.next += 1;
+        }
+        self.buf.clear();
+    }
+
+    fn trim(&mut self) {
+        let i0 = (self.next as f64 * self.rs.step).floor() as i64;
+        let keep_from = i0 - self.rs.half as i64 + 1;
+        let drop = (keep_from - self.base).clamp(0, self.buf.len() as i64) as usize;
+        if drop > 0 {
+            self.buf.drain(..drop);
+            self.base += drop as i64;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tone(rate: u32, hz: f64, n: usize) -> Vec<f32> {
+        (0..n).map(|i| (2.0 * std::f64::consts::PI * hz * i as f64 / f64::from(rate)).sin() as f32 * 0.5).collect()
+    }
+
+    fn rms_error(a: &[f32], b: &[f32], skip: usize) -> f64 {
+        let n = a.len().min(b.len()) - 2 * skip;
+        (a[skip..skip + n].iter().zip(&b[skip..skip + n]).map(|(x, y)| f64::from(x - y).powi(2)).sum::<f64>() / n as f64).sqrt()
+    }
+
+    #[test]
+    fn rates_out_of_range_are_refused() {
+        assert!(Resampler::new(0, 44100).is_err() && Resampler::new(44100, 999).is_err() && Resampler::new(44100, 768_001).is_err());
+        assert!(Resampler::new(48000, 44100).is_ok());
+    }
+
+    #[test]
+    fn the_same_rate_is_the_identity() {
+        let r = Resampler::new(44100, 44100).unwrap();
+        let x = tone(44100, 440.0, 1000);
+        assert!(r.is_identity() && r.convert(&x) == x);
+        assert_eq!(r.at(&x, 10, 5), 0.0);
+        assert_eq!(r.at(&x, 0, 5000), 0.0);
+    }
+
+    #[test]
+    fn a_tone_keeps_its_shape_when_converted_down_and_up() {
+        for (a, b) in [(48000u32, 44100u32), (16000, 44100), (96000, 44100), (22050, 44100), (44100, 48000)] {
+            let (down, up) = (Resampler::new(a, b).unwrap(), Resampler::new(b, a).unwrap());
+            let x = tone(a, 1000.0, a as usize / 2);
+            let y = down.convert(&x);
+            assert_eq!(y.len(), down.out_len(x.len()));
+            let want = tone(b, 1000.0, y.len());
+            assert!(rms_error(&y, &want, 2000) < 2e-3, "{a}->{b}: {}", rms_error(&y, &want, 2000));
+            let back = up.convert(&y);
+            assert!(rms_error(&back, &x, 2000) < 3e-3, "{a}->{b}->{a}");
+        }
+    }
+
+    #[test]
+    fn what_is_above_the_new_nyquist_is_removed() {
+        let r = Resampler::new(48000, 16000).unwrap();
+        let hi = r.convert(&tone(48000, 12000.0, 48000));
+        let peak = hi[1000..hi.len() - 1000].iter().fold(0.0f32, |m, v| m.max(v.abs()));
+        assert!(peak < 0.01, "aliasing {peak}");
+    }
+
+    #[test]
+    fn the_stream_gives_exactly_what_the_whole_conversion_gives() {
+        for (a, b, piece) in [(44100u32, 48000u32, 1000usize), (44100, 16000, 777), (44100, 44100, 4096), (44100, 96000, 1)] {
+            let x = tone(a, 700.0, 6000);
+            let rs = Resampler::new(a, b).unwrap();
+            let whole = rs.convert(&x);
+            let mut s = Stream::new(Resampler::new(a, b).unwrap(), whole.len() as u64);
+            let mut out = Vec::new();
+            for c in x.chunks(piece.min(2000)) {
+                s.push(c, &mut out);
+            }
+            s.finish(&mut out);
+            assert_eq!(out.len(), whole.len(), "{a}->{b}");
+            assert!(out.iter().zip(&whole).all(|(p, q)| (p - q).abs() < 1e-6), "{a}->{b}");
+            assert_eq!(s.made(), whole.len() as u64);
+        }
+    }
+
+    #[test]
+    fn the_stream_keeps_little_in_memory() {
+        let mut s = Stream::new(Resampler::new(44100, 48000).unwrap(), 10_000_000);
+        let mut out = Vec::new();
+        let block = vec![0.1f32; 4000];
+        for _ in 0..200 {
+            s.push(&block, &mut out);
+            out.clear();
+        }
+        assert!(s.buf.len() < 4000 + 200, "{}", s.buf.len());
+    }
+
+    #[test]
+    fn empty_input_gives_empty_output() {
+        let r = Resampler::new(48000, 44100).unwrap();
+        assert!(r.convert(&[]).is_empty());
+        let mut s = Stream::new(Resampler::new(48000, 44100).unwrap(), 0);
+        let mut out = Vec::new();
+        s.push(&[], &mut out);
+        s.finish(&mut out);
+        assert!(out.is_empty());
+    }
+}
