+//! Words: folding, near-spellings, a query's terms and the transcript cut into chunks.
+
+use serde::{Deserialize, Serialize};
+
+/// Most terms of a query that are looked for (the rest is ignored).
+pub const MAX_TERMS: usize = 16;
+/// Longest query that is read, in characters.
+pub const MAX_QUERY_CHARS: usize = 400;
+/// Longest word that is compared (longer ones are cut), in characters.
+const MAX_WORD_CHARS: usize = 48;
+
+/// A word of a transcript with its media time in seconds.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Word {
+    pub text: String,
+    pub start: f32,
+    pub end: f32,
+}
+
+/// A run of words that reads as one thought: the unit of the meaning search.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Chunk {
+    /// Index of the first word.
+    pub first: u32,
+    /// Index after the last word.
+    pub end_word: u32,
+    pub start: f32,
+    pub end: f32,
+    pub text: String,
+}
+
+/// Lower case, without accents, letters and digits only (everything else becomes a space).
+pub fn fold(s: &str) -> String {
+    let mut out = String::with_capacity(s.len().min(MAX_QUERY_CHARS * 8));
+    for c in s.chars().take(MAX_QUERY_CHARS * 4) {
+        for l in c.to_lowercase() {
+            let m = match l {
+                'á' | 'à' | 'ä' | 'â' | 'ã' | 'å' => 'a',
+                'é' | 'è' | 'ë' | 'ê' => 'e',
+                'í' | 'ì' | 'ï' | 'î' => 'i',
+                'ó' | 'ò' | 'ö' | 'ô' | 'õ' => 'o',
+                'ú' | 'ù' | 'ü' | 'û' => 'u',
+                'ñ' => 'n',
+                'ç' => 'c',
+                c if c.is_alphanumeric() => c,
+                _ => ' ',
+            };
+            out.push(m);
+        }
+    }
+    out
+}
+
+/// The folded words of `s`.
+pub fn tokens(s: &str) -> Vec<String> {
+    fold(s).split_whitespace().map(|w| w.chars().take(MAX_WORD_CHARS).collect()).collect()
+}
+
+/// Words that say nothing about what is looked for (Spanish and English, folded), and the words
+/// people use to ask ("cuando habla de…", "la toma donde…").
+const STOP: &[&str] = &[
+    "a",
+    "al",
+    "algo",
+    "algun",
+    "alguna",
+    "algunas",
+    "algunos",
+    "ante",
+    "antes",
+    "aparece",
+    "aparecen",
+    "aqui",
+    "asi",
+    "aun",
+    "cada",
+    "como",
+    "con",
+    "contra",
+    "cual",
+    "cuales",
+    "cuando",
+    "de",
+    "del",
+    "desde",
+    "donde",
+    "dice",
+    "dicen",
+    "durante",
+    "e",
+    "el",
+    "ella",
+    "ellas",
+    "ellos",
+    "en",
+    "entre",
+    "era",
+    "eran",
+    "es",
+    "esa",
+    "esas",
+    "ese",
+    "eso",
+    "esos",
+    "esta",
+    "estan",
+    "estas",
+    "este",
+    "esto",
+    "estos",
+    "fue",
+    "ha",
+    "habla",
+    "hablan",
+    "hablar",
+    "hay",
+    "la",
+    "las",
+    "le",
+    "les",
+    "lo",
+    "los",
+    "mas",
+    "me",
+    "menciona",
+    "mencionan",
+    "mi",
+    "mis",
+    "momento",
+    "mucho",
+    "muy",
+    "no",
+    "nos",
+    "o",
+    "otra",
+    "otro",
+    "para",
+    "parte",
+    "pero",
+    "por",
+    "porque",
+    "que",
+    "quien",
+    "quienes",
+    "sale",
+    "salen",
+    "se",
