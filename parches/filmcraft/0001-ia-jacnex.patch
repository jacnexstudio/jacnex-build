+// --- La secuencia: cuadros, cortes y dónde va el clip ------------------------------------------
+
+/// La secuencia activa, si existe.
+fn secuencia(app: &FilmcraftApp) -> Option<ItemId> {
+    app.session.state.active_sequence.filter(|s| app.session.project.sequence(*s).is_some())
+}
+
+/// El tamaño de la secuencia activa.
+fn tamano_secuencia(app: &FilmcraftApp) -> Option<(u32, u32)> {
+    let q = app.session.project.sequence(secuencia(app)?)?;
+    Some((q.settings.width, q.settings.height))
+}
+
+/// El corte entre dos clips seguidos más cercano al cabezal, en las pistas de video sin bloquear
+/// de la secuencia activa.
+fn corte_cercano(app: &FilmcraftApp) -> Option<Corte> {
+    let sec = secuencia(app)?;
+    let q = app.session.project.sequence(sec)?;
+    let cabezal = app.session.playhead();
+    let cuadro = q.settings.frame_rate.frame_duration().0.max(1);
+    let mut mejor: Option<(i64, Corte)> = None;
+    for pista in q.video_tracks.iter().filter(|p| !p.locked) {
+        let mut clips: Vec<_> = pista.items.iter().filter(|c| c.duration.0 > 0).collect();
+        clips.sort_by_key(|c| c.start);
+        for par in clips.windows(2) {
+            let (Some(a), Some(b)) = (par.first(), par.get(1)) else { continue };
+            let fin = a.end();
+            // Seguidos: el segundo empieza donde termina el primero (a un cuadro como mucho).
+            let hueco = b.start.0.saturating_sub(fin.0);
+            if !(0..=cuadro).contains(&hueco) {
+                continue;
+            }
+            let distancia = fin.0.saturating_sub(cabezal.0).saturating_abs();
+            let antes = Tick(fin.0.saturating_sub(cuadro).max(a.start.0));
+            let corte = Corte { secuencia: sec, pista: pista.id, en: fin, antes };
+            if mejor.as_ref().is_none_or(|(d, _)| distancia < *d) {
+                mejor = Some((distancia, corte));
+            }
+        }
+    }
+    mejor.map(|(_, c)| c)
+}
+
+/// Dónde va un clip «en el cabezal»: en el cabezal o, si cae dentro de un clip de la pista de
+/// destino, al final de ese clip (para no partirlo).
+fn punto_libre(app: &FilmcraftApp) -> Tick {
+    let cabezal = app.session.playhead();
+    let Some(q) = secuencia(app).and_then(|s| app.session.project.sequence(s)) else { return cabezal };
+    let destino = app.session.targeting().video_dest;
+    let pista = destino.and_then(|d| q.video_tracks.iter().find(|t| t.id == d)).or(q.video_tracks.first());
+    pista.and_then(|p| p.items.iter().find(|c| c.start < cabezal && cabezal < c.end()).map(|c| c.end())).unwrap_or(cabezal)
+}
+
+/// Una pista de audio sin bloquear de la secuencia activa libre en [`desde`, `desde + dura`):
+/// la de destino si lo está; si no, la primera libre. `None` = hay que añadir una.
+fn pista_de_audio_libre(app: &FilmcraftApp, desde: Tick, dura: Tick) -> Option<TrackId> {
+    let q = app.session.project.sequence(secuencia(app)?)?;
+    let hasta = Tick(desde.0.saturating_add(dura.0.max(1)));
+    let libre = |t: &&filmcraft_project::Track| !t.locked && t.items.iter().all(|c| c.end() <= desde || c.start >= hasta);
+    let destino = app.session.targeting().audio_dest;
+    q.audio_tracks.iter().filter(|t| Some(t.id) == destino).find(libre).or_else(|| q.audio_tracks.iter().find(libre)).map(|t| t.id)
+}
+
+/// El archivo de un elemento del proyecto (siguiendo los subclips hasta su media).
+fn media_de(app: &FilmcraftApp, item: ItemId) -> Option<&filmcraft_project::MediaClip> {
+    let mut id = item;
+    // acotado: un proyecto dañado podría tener un subclip que apunta a sí mismo
+    for _ in 0..16 {
+        match &app.session.project.item(id)?.kind {
+            filmcraft_project::ItemKind::Media(m) => return Some(m),
+            filmcraft_project::ItemKind::Subclip { parent, .. } => id = *parent,
+            _ => return None,
+        }
+    }
+    None
+}
+
+/// El clip que se mejora: el primer clip de video seleccionado o, si no hay, el que está bajo el
+/// cabezal (en la pista de destino o la más alta). Con el motivo si no sirve.
+fn clip_a_mejorar(app: &FilmcraftApp, h: Option<&Herramienta>) -> Result<ClipMejora, &'static str> {
+    const ELIGE: &str = "Selecciona en la línea de tiempo el clip que quieres mejorar.";
+    let sec = secuencia(app).ok_or(ELIGE)?;
+    let q = app.session.project.sequence(sec).ok_or(ELIGE)?;
+    let es_video = |id: ClipId| q.video_tracks.iter().any(|t| t.items.iter().any(|c| c.id == id));
+    let elegido = app.session.state.selection.iter().copied().find(|c| es_video(*c));
+    let elegido = elegido.or_else(|| {
+        let cabezal = app.session.playhead();
+        let destino = app.session.targeting().video_dest;
+        let bajo = |t: &filmcraft_project::Track| t.items.iter().find(|c| c.start <= cabezal && cabezal < c.end()).map(|c| c.id);
+        q.video_tracks.iter().find(|t| Some(t.id) == destino).and_then(bajo).or_else(|| q.video_tracks.iter().rev().find_map(bajo))
+    });
+    let clip = elegido.ok_or(ELIGE)?;
+    let (_, it) = q.find_item(clip).ok_or(ELIGE)?;
+    let m = media_de(app, it.item).ok_or("Ese clip no es un video: elige un clip de un archivo MP4 o MOV.")?;
+    let MediaRef::File { path } = &m.media else { return Err("Ese clip no es un video: elige un clip de un archivo MP4 o MOV.") };
+    let ruta = PathBuf::from(path);
+    let ext = ruta.extension().and_then(|e| e.to_str()).unwrap_or("").to_ascii_lowercase();
+    let tipo = match ext.as_str() {
+        "mp4" | "m4v" => "video/mp4",
+        "mov" => "video/quicktime",
+        _ => return Err("Solo se mejoran clips de archivos MP4 o MOV."),
+    };
+    if m.info.video.is_none() {
+        return Err("Ese clip no tiene imagen: elige un clip de video.");
+    }
+    let segundos = m.duration().seconds();
+    let max_segundos = h.map_or(60, |h| h.max_segundos);
+    if segundos > f64::from(max_segundos) + 0.05 {
+        return Err("El clip dura más de lo que admite esta herramienta: exporta solo la parte que quieres usar.");
+    }
+    let max = h.map_or(MAX_MEJORA, |h| h.max_megas.saturating_mul(MB)).min(MAX_MEJORA);
+    match std::fs::metadata(&ruta) {
+        Ok(md) if md.len() > max => return Err("El archivo del clip pesa demasiado: expórtalo más liviano."),
+        Ok(_) => {}
+        Err(_) => return Err("No se encuentra el archivo del clip en el disco."),
+    }
+    Ok(ClipMejora { secuencia: sec, clip, item: it.item, nombre: it.name.clone(), ruta, tipo, segundos })
+}
+
+/// El cuadro de la secuencia `sec` en `t`, como JPEG (lado largo de hasta 1 920 px).
+fn cuadro(app: &FilmcraftApp, sec: ItemId, t: Tick) -> Result<Vec<u8>, String> {
+    let s = &app.session;
+    let q = s.project.sequence(sec).ok_or("No hay una secuencia abierta.")?;
+    let lado = q.settings.width.max(q.settings.height).max(1);
+    #[allow(clippy::cast_precision_loss)]
+    let escala = (LADO_CUADRO / lado as f32).min(1.0);
+    let proveedor = s.media.full_res_provider(s.project.clone(), s.services.clone());
+    let _ = filmcraft_media::pending::take();
+    let opciones = filmcraft_render::RenderOptions { scale: escala, captions: true, ..Default::default() };
+    let img = filmcraft_render::render_sequence(&s.project, sec, t, opciones, &proveedor);
+    if filmcraft_media::pending::take() {
+        return Err("El cuadro aún se está cargando: vuelve a intentarlo en un momento.".into());
+    }
+    if img.w == 0 || img.h == 0 {
+        return Err("La secuencia no tiene imagen en ese punto.".into());
+    }
+    let bytes =
+        filmcraft_export::still::encode(&img, filmcraft_export::still::StillFormat::Jpeg, 8).map_err(|e| format!("No se pudo preparar el cuadro: {e}"))?;
+    if bytes.len() > MAX_IMAGEN {
+        return Err("El cuadro es demasiado grande para enviarlo.".into());
+    }
+    Ok(bytes)
+}
+
+/// La imagen elegida para «Animar foto».
+fn leer_foto(ruta: &str) -> Result<Imagen, String> {
+    let ext = Path::new(ruta).extension().and_then(|e| e.to_str()).unwrap_or("").to_ascii_lowercase();
+    let tipo = match ext.as_str() {
+        "jpg" | "jpeg" => "image/jpeg",
+        "png" => "image/png",
+        "webp" => "image/webp",
+        _ => return Err("Usa una imagen JPG, PNG o WebP.".into()),
+    };
+    let bytes = std::fs::read(ruta).map_err(|e| format!("No se pudo leer la imagen: {e}"))?;
+    if bytes.len() > MAX_IMAGEN {
+        return Err("La imagen pesa más de 10 MB: usa una más liviana.".into());
+    }
+    let nombre = Path::new(ruta).file_name().map_or_else(|| format!("foto.{ext}"), |n| n.to_string_lossy().into_owned());
+    Ok((nombre, tipo, bytes))
+}
+
+/// La carpeta de los videos: «IA de Jacnex» junto al proyecto guardado o, si no se ha guardado,
+/// Videos › Filmnex IA.
+fn carpeta(app: &FilmcraftApp) -> PathBuf {
+    if let Some(c) = &app.jacnex_ia.carpeta {
+        return c.clone();
+    }
+    if let Some(dir) = app.session.path.as_deref().and_then(|p| Path::new(p).parent()).filter(|d| !d.as_os_str().is_empty()) {
+        return dir.join(CARPETA);
+    }
+    let casa = std::env::var_os("USERPROFILE").or_else(|| std::env::var_os("HOME")).map(PathBuf::from);
+    casa.map_or_else(|| std::env::temp_dir().join("Filmnex IA"), |c| c.join("Videos").join("Filmnex IA"))
+}
