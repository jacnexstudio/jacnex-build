+fn ajustes_herramienta(ui: &mut egui::Ui, e: &mut Estado, t: &crate::theme::Tokens) {
+    let lista = e.herramientas();
+    let Some(h) = e.herramienta_actual() else {
+        ui.label(RichText::new("Esta función aún no está disponible.").small().color(t.text_dim));
+        return;
+    };
+    match e.modo {
+        Modo::Voz => {
+            if lista.len() > 1 {
+                fila(ui, "Calidad", t, |ui| {
+                    let nombres: Vec<String> = lista.iter().map(|x| calidad_de_voz(&x.nombre)).collect();
+                    let elegida = lista.iter().position(|x| x.id == h.id).unwrap_or(0);
+                    if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                        && let Some(x) = lista.get(i)
+                    {
+                        e.voz_modelo = x.id.clone();
+                    }
+                });
+            }
+            let voz = e.voz_actual(&h);
+            fila(ui, "Voz", t, |ui| match &voz {
+                Some(v) => {
+                    craft_ui::ComboBox::from_id_salt("jacnex-ia-voz")
+                        .selected_text(format!("{} ({})", v.nombre, v.genero))
+                        .width(ui.available_width())
+                        .show_ui(ui, |ui| {
+                            for x in &h.voces {
+                                if ui.selectable_label(x.id == v.id, format!("{} · {}, {}", x.nombre, x.genero, x.estilo)).clicked() {
+                                    e.voz = x.id.clone();
+                                }
+                            }
+                        });
+                }
+                None => {
+                    ui.label(RichText::new("Cargando las voces…").color(t.text_dim));
+                }
+            });
+            fila(ui, "Velocidad", t, |ui| {
+                let nombres: Vec<String> =
+                    VELOCIDADES.iter().map(|v| if (*v - 1.0).abs() < 0.01 { "Normal".to_string() } else { format!("{v:.1}×") }).collect();
+                let actual = e.velocidad_actual();
+                let elegida = VELOCIDADES.iter().position(|v| (*v - actual).abs() < 0.01).unwrap_or(2);
+                if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                    && let Some(v) = VELOCIDADES.get(i)
+                {
+                    e.velocidad = *v;
+                }
+            });
+            if h.idioma {
+                let actual = e.idioma_actual();
+                let nombre = IDIOMAS.iter().find(|(c, _)| *c == actual).map_or("Español", |(_, n)| *n);
+                fila(ui, "Idioma", t, |ui| {
+                    craft_ui::ComboBox::from_id_salt("jacnex-ia-idioma").selected_text(nombre).width(ui.available_width()).show_ui(ui, |ui| {
+                        for (c, n) in IDIOMAS {
+                            if ui.selectable_label(*c == actual, *n).clicked() {
+                                e.idioma = (*c).to_string();
+                            }
+                        }
+                    });
+                });
+            }
+            if let Some(p) = h.por_mil {
+                ui.label(RichText::new(format!("{} por cada 1 000 letras.", creditos(p))).small().color(t.text_dim));
+            }
+        }
+        Modo::Musica => {
+            fila(ui, "Tipo", t, |ui| {
+                let nombres = ["Instrumental".to_string(), "Con letra".to_string()];
+                if let Some(i) = segmentos(ui, &nombres, usize::from(e.con_letra), t) {
+                    e.con_letra = i == 1;
+                }
+            });
+            if e.con_letra {
+                ui.label(RichText::new("La IA escribe y canta la letra; la duración la elige ella (unos 2 a 4 minutos).").small().color(t.text_dim));
+            } else {
+                let (min, max) = h.duracion.unwrap_or((10, 360));
+                let opciones: Vec<u32> = DURACIONES_MUSICA.iter().copied().filter(|d| (min..=max).contains(d)).collect();
+                if !opciones.is_empty() {
+                    let actual = e.duracion_musica_actual(&h);
+                    fila(ui, "Duración", t, |ui| {
+                        let nombres: Vec<String> = opciones.iter().map(|d| duracion_corta(*d)).collect();
+                        let elegida = opciones.iter().position(|d| *d == actual).unwrap_or(0);
+                        if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                            && let Some(d) = opciones.get(i)
+                        {
+                            e.duracion_musica = *d;
+                        }
+                    });
+                }
+            }
+        }
+        Modo::Efecto => {
+            fila(ui, "En bucle", t, |ui| {
+                let nombres = ["No".to_string(), "Sí, sin cortes".to_string()];
+                if let Some(i) = segmentos(ui, &nombres, usize::from(e.bucle), t) {
+                    e.bucle = i == 1;
+                }
+            });
+        }
+        Modo::Mejorar => {
+            let actual = e.resolucion_actual();
+            fila(ui, "Resolución", t, |ui| {
+                let nombres: Vec<String> = RESOLUCIONES.iter().map(|r| r.replace('P', "p")).collect();
+                let elegida = RESOLUCIONES.iter().position(|r| *r == actual).unwrap_or(1);
+                if let Some(i) = segmentos(ui, &nombres, elegida, t)
+                    && let Some(r) = RESOLUCIONES.get(i)
+                {
+                    e.resolucion = (*r).to_string();
+                }
+            });
+            if let Some((_, c)) = h.por_segundo.iter().find(|(r, _)| r == actual).filter(|(_, c)| *c > 0) {
+                #[allow(clippy::cast_precision_loss)]
+                let por = *c as f64 / 100.0;
+                let texto =
+                    if c % 100 == 0 { format!("{} créditos por segundo de clip.", c / 100) } else { format!("{por:.1} créditos por segundo de clip.") };
+                ui.label(RichText::new(texto).small().color(t.text_dim));
+            }
+        }
+        _ => {}
+    }
+    if !h.descripcion.is_empty() {
+        ui.label(RichText::new(h.descripcion.as_str()).small().color(t.text_dim));
+    }
+}
