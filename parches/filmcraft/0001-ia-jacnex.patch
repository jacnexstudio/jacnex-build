+#[test]
+fn the_limits_match_the_server() {
+    assert_eq!(limits(30.0), (15.0, 35.5));
+    assert_eq!(limits(60.0), (30.0, 70.0));
+}
+
+// --- La secuencia nueva ----------------------------------------------------------------------
+
+/// El proyecto de demostración con 2 frases por cada clip del audio A1: [0,1.5] y [2.0,2.9] s de cada
+/// clip. Devuelve la sesión, la secuencia y lo que dura.
+fn sesion() -> (Session, ItemId, Tick) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let seq = s.state.active_sequence.unwrap();
+    let items: Vec<(ItemId, Tick)> = s.active_sequence().unwrap().audio_tracks[0].items.iter().map(|i| (i.item, i.source_in)).collect();
+    for (item, sin) in items {
+        let mut tr = Transcript { language: "es".into(), ..Default::default() };
+        for (text, a, b) in [("Hola", 0.1, 0.5), ("a", 0.5, 0.8), ("todos.", 0.8, 1.5), ("Segunda", 2.0, 2.4), ("frase.", 2.4, 2.9)] {
+            tr.words.push(Word::new(text, sin + t(a), sin + t(b)));
+        }
+        tr.normalize();
+        std::sync::Arc::make_mut(&mut s.project).transcripts.insert(item, std::sync::Arc::new(tr));
+    }
+    let dur = s.active_sequence().unwrap().duration();
+    (s, seq, dur)
+}
+
+fn plan_de(s: &Session, seq: ItemId, dur: Tick, pedido: &[(f64, f64)], objetivo: f64) -> Plan {
+    let frases = sentences(&sequence_words(s));
+    let (title, ranges) = parse_reply(&tramos(pedido), &frases, dur, RATE, objetivo).unwrap();
+    Plan { seq, seq_duration: dur, title, ranges, hook: None }
+}
+
+fn nueva(s: &Session, id: ItemId) -> filmcraft_project::Sequence {
+    match &s.project.item(id).unwrap().kind {
+        ItemKind::Sequence(q) => (**q).clone(),
+        _ => panic!("no es una secuencia"),
+    }
+}
