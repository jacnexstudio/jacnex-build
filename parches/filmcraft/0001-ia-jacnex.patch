+    assert_eq!(c.objetivo_actual(), 30);
+    assert!(!c.ocupado() && !c.preparada());
+    c.objetivo = 90;
+    assert_eq!(c.objetivo_actual(), 90);
+    c.objetivo = 7;
+    assert_eq!(c.objetivo_actual(), 30, "an unknown length falls back to 30 s");
+    c.indicacion = format!("  lo del   precio\n{}", "x".repeat(1000));
+    let limpia = c.indicacion_limpia();
+    assert!(limpia.starts_with("lo del precio x") && limpia.chars().count() <= MAX_INDICACION);
+}
+
+#[test]
+fn mode_sits_after_vertical_in_editar() {
+    assert_eq!(Modo::Corta.grupo(), Grupo::Editar);
+    let m = Grupo::Editar.modos();
+    let v = m.iter().position(|x| *x == Modo::Vertical).unwrap();
+    assert_eq!(m.get(v + 1), Some(&Modo::Corta));
+    assert_eq!(Modo::TODOS.len(), 15);
+    assert!(Modo::TODOS.contains(&Modo::Corta));
+    assert_eq!(Modo::Corta.nombre(), "Versión corta");
+}
+
+#[test]
+fn price_matches_the_server_formula() {
+    let mut app = app_con_voz(1);
+    app.jacnex_ia.simular_catalogo(&catalogo());
+    let q = app.jacnex_ia.corta_nube().cloned().expect("the catalogue has the model");
+    assert_eq!(q.id, "corta-ia");
+    // 1 hora de voz: ~100 000 letras -> 50 000 + 1 500 tokens a 45 créditos por millón.
+    let (tope, normal) = precio(&q, 100_000);
+    assert!((normal - (50_000.0 + 1500.0) * 45.0 / 1e6).abs() < 1e-9, "{normal}");
+    assert_eq!(tope, (normal * 4.0).ceil() as i64);
+    // lo más barato se reserva por un crédito como mínimo y nunca más de maxCreditos
+    assert_eq!(precio(&q, 0).0, 1);
+    assert_eq!(precio(&q, usize::MAX / 4).0, 400);
+    assert_eq!(decimal(2.4), "2,4 créditos");
+    assert_eq!(decimal(7.0), "7 créditos");
+    assert_eq!(decimal(f64::NAN), "?");
+}
+
+#[test]
+fn bad_catalogue_entries_are_ignored() {
