+        assert_eq!(e.costo(Some(4.2)), Some(15), "2K: 5 s × 3");
+        e.resolucion = "1080P".into();
+        assert_eq!(e.costo(Some(3.0)), Some(5), "1080p: 3 s × 1,5 = 4,5 → 5");
+        e.resolucion = "8K".into();
+        assert_eq!(e.resolucion_actual(), RESOLUCION, "una resolución que no existe: la de siempre");
+        assert_eq!(creditos_de_mejora(300, f64::NAN), None);
