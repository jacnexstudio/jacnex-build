+fn bg(secs: f64) -> Vec<f32> {
+    // stereo interleaved at 44.1 kHz
+    (0..(secs * 44_100.0) as usize).flat_map(|i| [0.2 * ((i as f32) * 0.01).sin(), 0.1 * ((i as f32) * 0.02).sin()]).collect()
+}
