+/// `15` → «15 s», `120` → «2 min».
+fn duracion_corta(s: u32) -> String {
+    if s >= 60 && s.is_multiple_of(60) { format!("{} min", s / 60) } else { format!("{s} s") }
+}
+
+/// La calidad de una voz, por su nombre: «Voz en off premium» → «Premium».
+fn calidad_de_voz(nombre: &str) -> String {
+    let resto = nombre.trim().strip_prefix("Voz en off").unwrap_or(nombre).trim();
+    let mut letras = resto.chars();
+    match letras.next() {
+        Some(p) => p.to_uppercase().chain(letras).collect(),
+        None => "Estándar".into(),
+    }
+}
