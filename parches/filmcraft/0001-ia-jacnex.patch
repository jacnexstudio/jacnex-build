+    fn esperar(app: &mut FilmcraftApp, ctx: &egui::Context, hasta: impl Fn(&FilmcraftApp) -> bool) {
+        let inicio = Instant::now();
+        while !hasta(app) {
+            assert!(inicio.elapsed() < Duration::from_secs(60), "no llegó: {:?}", aviso(app));
+            actualizar(app, ctx);
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
