+#[test]
+fn the_ai_price_is_estimated_like_the_server() {
+    let q = nube();
+    // 1000 letters and 2 sheets: 500 + 3000 + 3000 = 6500 tokens, 0.2925 credits, x4 = 1.17, rounded up to 2
+    assert!((q.tokens(1000, 2) - 6500.0).abs() < 1e-9);
+    assert!((q.esperado(1000, 2) - 0.2925).abs() < 1e-9);
+    assert_eq!(q.reserva(1000, 2), 2);
+    // the reserve never passes the cap and never drops below 1
+    assert!(q.reserva(300_000, 10) <= 400);
+    assert_eq!(q.reserva(0, 0), 1);
+    let caro = BusquedaNube { creditos_por_millon: 1e9, ..q };
+    assert_eq!(caro.reserva(300_000, 10), 400);
