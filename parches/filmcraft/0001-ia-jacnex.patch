+//! Jacnex: «Pasar a vertical» (IA de Jacnex › Editar › Vertical).
+//!
+//! Dos motores:
+//! - **En esta computadora** (sin créditos): detecta caras, personas y quién habla con los
+//!   modelos de Jacnex Studio ([`filmcraft_engine::reframe_job`]), en un hilo aparte con avance y
+//!   «Detener». Al terminar crea una secuencia NUEVA con el mismo montaje en vertical; la
+//!   original no se toca ([`filmcraft_engine::reframe_apply`]). Los modelos no se descargan
+//!   desde Filmnex: si faltan, se pide actualizar desde Jacnex Studio.
+//! - **Con IA (créditos)**: un clip de hasta 10 s se envía al servidor de Jacnex y vuelve ya
+//!   reencuadrado; el flujo está en [`crate::jacnex_ia`] (igual que «Mejorar calidad»).
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::time::{Duration, Instant};
+
+use filmcraft_engine::reframe_apply;
+use filmcraft_engine::reframe_job::{self, ReframeJob, ReframeProgress, ReframeResult};
+use filmcraft_reframe::plan::Aspect;
+use serde_json::Value;
+
+use crate::FilmcraftApp;
+
+/// Las formas que se ofrecen: (id, nombre).
+pub const ASPECTOS: &[(&str, &str)] = &[("9:16", "Vertical 9:16"), ("1:1", "Cuadrado 1:1"), ("4:5", "Retrato 4:5")];
+/// Quién reencuadra: (id, nombre).
+pub const MOTORES: &[(&str, &str)] = &[("local", "En tu PC"), ("nube", "Con IA (créditos)")];
+/// El clip más largo que acepta el motor con créditos, en segundos.
+pub const MAX_NUBE: f64 = 10.0;
+
+/// Los ajustes de «Vertical» y el análisis en curso.
+#[derive(Default)]
+pub struct Vertical {
+    /// La forma (vacío = 9:16).
+    pub aspecto: String,
+    /// El motor (vacío = en esta computadora).
+    pub motor: String,
+    /// Con IA: 1080p en lugar de 720p.
+    pub alta: bool,
+    trabajo: Option<Analisis>,
+    /// El último aviso: (salió bien, texto).
+    pub aviso: Option<(bool, String)>,
+}
+
+enum Mensaje {
+    Progreso(ReframeProgress),
+    Fin(Result<ReframeResult, String>),
+}
+
+struct Analisis {
+    rx: Receiver<Mensaje>,
+    parar: Arc<AtomicBool>,
+    progreso: Option<ReframeProgress>,
+    inicio: Instant,
+}
+
+impl Vertical {
+    pub fn aspecto_id(&self) -> &'static str {
+        ASPECTOS.iter().find(|(id, _)| *id == self.aspecto).or(ASPECTOS.first()).map_or("9:16", |(id, _)| *id)
+    }
+
+    /// La forma elegida, para el motor.
+    pub fn forma(&self) -> Aspect {
+        match self.aspecto_id() {
+            "1:1" => Aspect::SQUARE,
+            "4:5" => Aspect::PORTRAIT,
+            _ => Aspect::VERTICAL,
+        }
+    }
+
+    /// La forma que se pide al servidor (kie.ai no tiene 4:5: se usa 3:4, la más cercana).
+    pub fn forma_nube(&self) -> &'static str {
+        match self.aspecto_id() {
+            "1:1" => "1:1",
+            "4:5" => "3:4",
+            _ => "9:16",
+        }
+    }
+
+    pub fn motor_id(&self) -> &'static str {
+        MOTORES.iter().find(|(id, _)| *id == self.motor).or(MOTORES.first()).map_or("local", |(id, _)| *id)
+    }
+
+    /// Reencuadra con la IA del servidor (usa créditos).
+    pub fn en_nube(&self) -> bool {
+        self.motor_id() == "nube"
+    }
+
+    /// La resolución que se pide con créditos.
+    pub fn resolucion_nube(&self) -> &'static str {
+        if self.alta { "1080p" } else { "720p" }
+    }
+
+    pub fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    /// Lo que se ve mientras analiza: (texto, avance 0..1 si se sabe).
+    pub fn progreso(&self) -> Option<(String, Option<f32>)> {
+        let t = self.trabajo.as_ref()?;
+        if t.parar.load(Ordering::Relaxed) {
+            return Some(("Deteniendo…".into(), None));
+        }
+        let de = |clip: usize, of: usize| if of > 1 { format!(" el clip {} de {}", clip + 1, of) } else { String::new() };
+        let medio = |clip: usize, of: usize, f: f32| (clip as f32 + f.clamp(0.0, 1.0)) / of.max(1) as f32;
+        Some(match t.progreso {
+            None => ("Preparando…".into(), None),
+            Some(ReframeProgress::Loading) => ("Cargando los modelos…".into(), None),
+            Some(ReframeProgress::Analysing { clip, of, fraction }) => {
+                (format!("Buscando a las personas{}… {:.0} %", de(clip, of), fraction * 100.0), Some(medio(clip, of, fraction)))
+            }
+            Some(ReframeProgress::Speakers { clip, of, fraction }) => {
+                (format!("Viendo quién habla{}… {:.0} %", de(clip, of), fraction * 100.0), Some(medio(clip, of, fraction)))
+            }
+            Some(ReframeProgress::Planning) => ("Moviendo la cámara…".into(), None),
+        })
+    }
+
+    /// Los segundos desde que empezó.
+    pub fn segundos(&self) -> u64 {
+        self.trabajo.as_ref().map_or(0, |t| t.inicio.elapsed().as_secs())
+    }
+
+    /// Detiene el análisis en curso.
+    pub fn detener(&mut self) {
+        if let Some(t) = &self.trabajo {
+            t.parar.store(true, Ordering::Relaxed);
+        }
+    }
+}
+
+/// Por qué no se puede reencuadrar en esta computadora ahora (o nada).
+pub fn falta_local(app: &FilmcraftApp) -> Option<&'static str> {
+    if app.jacnex_ia.vertical.ocupado() {
+        return Some("Espera a que termine el análisis.");
+    }
+    if let Some(m) = reframe_job::missing() {
+        return Some(m);
+    }
+    if app.session.active_sequence().is_none() {
+        return Some("Abre una secuencia con video.");
+    }
+    None
+}
+
+/// Empieza a analizar la secuencia abierta.
+pub fn ejecutar(app: &mut FilmcraftApp) {
+    if let Some(f) = falta_local(app) {
+        app.jacnex_ia.vertical.aviso = Some((false, f.into()));
+        return;
+    }
+    let job = match reframe_job::reframe_job(&app.session, app.jacnex_ia.vertical.forma()) {
+        Ok(j) => j,
+        Err(e) => {
+            app.jacnex_ia.vertical.aviso = Some((false, format!("No se pudo empezar: {}", motivo(&e.to_string()))));
+            return;
+        }
+    };
+    let parar = Arc::new(AtomicBool::new(false));
+    let (tx, rx) = std::sync::mpsc::channel();
+    let p2 = parar.clone();
+    let hilo = std::thread::Builder::new().name("jacnex-vertical".into()).spawn(move || {
+        let tx2 = tx.clone();
+        let r = std::panic::catch_unwind(std::panic::AssertUnwindSafe(move || correr(job, &tx2, &p2)));
+        let fin = match r {
+            Ok(Ok(r)) => Ok(r),
+            Ok(Err(e)) => Err(e),
+            Err(_) => Err("error interno al analizar el video (ver el registro de fallos)".into()),
+        };
+        let _ = tx.send(Mensaje::Fin(fin));
+    });
+    let v = &mut app.jacnex_ia.vertical;
+    match hilo {
+        Ok(_) => {
+            v.aviso = None;
+            v.trabajo = Some(Analisis { rx, parar, progreso: None, inicio: Instant::now() });
+        }
+        Err(e) => v.aviso = Some((false, format!("No se pudo empezar: {e}"))),
+    }
+}
+
+fn correr(job: ReframeJob, tx: &std::sync::mpsc::Sender<Mensaje>, parar: &AtomicBool) -> Result<ReframeResult, String> {
+    job.run(&mut |p| {
+        let _ = tx.send(Mensaje::Progreso(p));
+        !parar.load(Ordering::Relaxed)
+    })
+    .map_err(|e| e.to_string())
+}
+
+/// Un error del motor, en palabras del usuario.
+fn motivo(e: &str) -> String {
+    if e.contains(reframe_job::CANCELLED) { "se detuvo.".into() } else { e.to_string() }
+}
+
+fn numero(v: &Value, k: &str) -> u64 {
+    v.get(k).and_then(Value::as_u64).unwrap_or(0)
+}
+
+/// Recibe el avance y, al terminar, crea la secuencia vertical.
+pub fn actualizar(app: &mut FilmcraftApp, ctx: &egui::Context) {
+    let esperar = app.dialog.is_some();
+    let Some(t) = app.jacnex_ia.vertical.trabajo.as_mut() else { return };
+    let mut fin = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Mensaje::Progreso(p)) => t.progreso = Some(p),
+            Ok(Mensaje::Fin(r)) => {
+                fin = Some(r);
+                break;
+            }
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                fin = Some(Err("el análisis se interrumpió".into()));
+                break;
+            }
+        }
+    }
+    let Some(fin) = fin else {
+        ctx.request_repaint_after(Duration::from_millis(200));
+        return;
+    };
+    if esperar {
+        // con un diálogo abierto no se toca el proyecto: se vuelve a intentar luego
+        let (tx, rx) = std::sync::mpsc::channel();
+        let _ = tx.send(Mensaje::Fin(fin));
+        t.rx = rx;
+        ctx.request_repaint_after(Duration::from_millis(250));
+        return;
+    }
+    let parado = t.parar.load(Ordering::Relaxed);
+    app.jacnex_ia.vertical.trabajo = None;
+    ctx.request_repaint();
+    let aviso = match fin {
+        Ok(r) => {
+            let (con_cara, sin) =
+                r.plans.iter().fold((0usize, 0usize), |(a, b), p| if p.found[3] == 0 && p.found.iter().sum::<usize>() > 0 { (a + 1, b) } else { (a, b + 1) });
+            let saltados = r.skipped;
+            match reframe_apply::apply(&mut app.session, r) {
+                Ok(v) => {
+                    let forma = format!("{}x{}", numero(&v, "width"), numero(&v, "height"));
+                    let mut m = format!("Listo: secuencia nueva de {forma} con el encuadre ya animado. La original no se tocó.");
+                    if sin > 0 && con_cara == 0 {
+                        m.push_str(" No se encontraron personas: el encuadre quedó al centro.");
+                    }
+                    if saltados > 0 {
+                        m.push_str(&format!(" Se omitieron {saltados} clips que no son de video."));
+                    }
+                    (true, m)
+                }
+                Err(e) => (false, format!("No se pudo crear la secuencia vertical: {e}")),
+            }
+        }
+        Err(_) if parado => (false, "Análisis detenido.".into()),
+        Err(e) => (false, format!("No se pudo reencuadrar: {}", motivo(&e))),
+    };
+    app.jacnex_ia.vertical.aviso = Some(aviso);
+}
+
