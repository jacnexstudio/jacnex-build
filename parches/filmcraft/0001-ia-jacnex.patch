+#[test]
+fn apply_adds_a_track_lowers_the_original_and_is_one_undo() {
+    let (mut s, clip, start) = session();
+    let tracks = s.active_sequence().unwrap().audio_tracks.len();
+    let clips_before: usize = s.active_sequence().unwrap().audio_tracks.iter().map(|t| t.items.len()).sum();
+    let undo_before = s.history.undo.len();
+    let samples = tone(3.0, 0.4);
+    let r = dub::apply(&mut s, start, &samples, &[clip], Original::Mute).unwrap();
+    let q = s.active_sequence().unwrap();
+    assert_eq!(q.audio_tracks.len(), tracks + 1, "a NEW audio track");
+    assert_eq!(r.track, tracks);
+    assert_eq!(r.lowered, 1);
+    let dubbed = &q.audio_tracks[tracks].items;
+    assert_eq!(dubbed.len(), 1);
+    assert_eq!(dubbed[0].start, start, "aligned to the clip");
+    assert!((dubbed[0].duration.seconds() - 3.0).abs() < 0.05);
+    let orig = q.find_item(clip).unwrap().1;
+    assert_eq!(orig.gain_db, dub::MUTE_DB, "muted, not deleted");
+    let after: usize = q.audio_tracks.iter().map(|t| t.items.len()).sum();
+    assert_eq!(after, clips_before + 1);
+    assert_eq!(s.history.undo.len(), undo_before + 1, "one undo step");
+    q.check().unwrap();
+
+    s.undo().unwrap();
+    let q = s.active_sequence().unwrap();
+    assert_eq!(q.audio_tracks.len(), tracks, "undo removes the track");
+    assert_eq!(q.find_item(clip).unwrap().1.gain_db, 0.0, "undo restores the original volume");
+    assert_eq!(s.history.undo.len(), undo_before);
+    s.redo().unwrap();
+    assert_eq!(s.active_sequence().unwrap().audio_tracks.len(), tracks + 1);
+}
+
+#[test]
+fn apply_can_lower_instead_of_mute_and_rejects_bad_input() {
+    let (mut s, clip, start) = session();
+    dub::apply(&mut s, start, &tone(1.0, 0.4), &[clip], Original::Lower).unwrap();
+    assert_eq!(s.active_sequence().unwrap().find_item(clip).unwrap().1.gain_db, dub::LOWER_DB);
+    let n = s.history.undo.len();
+    assert!(dub::apply(&mut s, start, &[], &[clip], Original::Lower).is_err());
+    assert!(dub::apply(&mut s, Tick(-5), &tone(1.0, 0.4), &[clip], Original::Lower).is_err());
+    assert!(dub::apply(&mut s, start, &tone(1.0, 0.4), &[ClipId(u64::MAX)], Original::Lower).is_ok(), "an unknown clip is just not lowered");
+    assert_eq!(s.history.undo.len(), n + 1);
+}
+
+fn sine(freq: f64, secs: f64) -> Vec<f32> {
+    (0..(secs * f64::from(RATE)) as usize).map(|i| 0.6 * (2.0 * std::f64::consts::PI * freq * i as f64 / f64::from(RATE)).sin() as f32).collect()
+}
+
+/// Positive-going zero crossings per second.
+fn hz(x: &[f32]) -> f64 {
+    let n = x.windows(2).filter(|w| w[0] < 0.0 && w[1] >= 0.0).count();
+    n as f64 * f64::from(RATE) / x.len() as f64
+}
+
+#[test]
+fn speeding_up_keeps_the_length_and_the_pitch() {
+    for (freq, speed) in [(220.0, 1.1), (440.0, 1.25), (180.0, 1.05), (1000.0, 1.2)] {
+        let input = sine(freq, 2.0);
+        let len = (input.len() as f64 / speed) as usize;
+        let out = super::stretch_to(&input, len);
+        assert_eq!(out.len(), len, "exact length");
+        let f = hz(&out[RATE as usize / 10..out.len() - RATE as usize / 10]);
+        assert!((f - freq).abs() / freq < 0.03, "{freq} Hz x{speed} came out at {f} Hz");
+        let rms = |v: &[f32]| (v.iter().map(|x| f64::from(*x).powi(2)).sum::<f64>() / v.len() as f64).sqrt();
+        assert!((rms(&out) / rms(&input) - 1.0).abs() < 0.15, "level kept");
+        assert!(out.iter().all(|v| v.is_finite() && v.abs() <= 1.0));
+    }
+    // the old linear resample would have moved a 440 Hz tone by the speed factor
+    assert!(super::stretch_to(&[], 10).is_empty() && super::stretch_to(&[0.1; 10], 0).is_empty());
+    assert_eq!(super::stretch_to(&sine(300.0, 0.5), 1_000_000).len(), (0.5 * f64::from(RATE)) as usize, "never longer than the input");
+    assert_eq!(super::stretch_to(&[0.5; 3], 2).len(), 2, "tiny input does not panic");
+    let ruido: Vec<f32> = (0..48_000u32).map(|i| ((i.wrapping_mul(2_654_435_761) >> 8) % 2000) as f32 / 1000.0 - 1.0).collect();
+    assert_eq!(super::stretch_to(&ruido, 40_000).len(), 40_000);
+}
+
+#[test]
+fn a_speed_up_in_the_mix_does_not_shift_the_pitch() {
+    let (out, fit) = dub::mix(&[Phrase { start: 0.0, end: 1.0, pcm: sine(300.0, 2.0) }, phrase(1.8, 2.5, 0.5)], 3.0);
+    assert_eq!((fit.sped_up, fit.trimmed), (1, 0));
+    let f = hz(&out[RATE as usize / 5..(1.6 * f64::from(RATE)) as usize]);
+    assert!((f - 300.0).abs() / 300.0 < 0.03, "{f}");
+}
