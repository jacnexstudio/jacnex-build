+impl Estado {
+    /// Los modelos de video, de más a menos usados: los del servidor, o los conocidos mientras
+    /// no responde.
+    fn modelos(&self) -> Vec<ModeloInfo> {
+        let mut lista: Vec<ModeloInfo> = match &self.info {
+            Some(i) if !i.videos.is_empty() => i.videos.clone(),
+            _ => modelos_base(),
+        };
+        if self.modo == Modo::Transicion {
+            lista.retain(|m| m.imagen_final);
+        }
+        lista.sort_by_key(|m| POPULARIDAD.iter().position(|p| *p == m.id).unwrap_or(POPULARIDAD.len()));
+        lista
+    }
+
+    fn modelo_actual(&self) -> ModeloInfo {
+        let lista = self.modelos();
+        let id = if self.modelo.is_empty() { MODELO } else { self.modelo.as_str() };
+        lista.iter().find(|m| m.id == id).or_else(|| lista.iter().find(|m| m.id == MODELO)).or(lista.first()).cloned().unwrap_or_else(|| {
+            let mut base = modelos_base();
+            if base.is_empty() {
+                ModeloInfo {
+                    id: MODELO.into(),
+                    nombre: "Google Veo 3.1 Lite".into(),
+                    descripcion: String::new(),
+                    aspectos: vec!["16:9".into(), "9:16".into()],
+                    duraciones: vec![8],
+                    imagen_final: true,
+                    sonido_opcional: false,
+                    creditos: Vec::new(),
+                    con_sonido: Vec::new(),
+                }
+            } else {
+                base.swap_remove(0)
+            }
+        })
+    }
+
+    /// La duración que se pide: la elegida si el modelo la tiene; si no, la primera.
+    fn duracion_actual(&self, m: &ModeloInfo) -> u32 {
+        if m.duraciones.contains(&self.duracion) { self.duracion } else { m.duraciones.first().copied().unwrap_or(5) }
+    }
+
+    fn sonido_actual(&self, m: &ModeloInfo) -> bool {
+        m.sonido_opcional && self.sonido
+    }
+
+    /// Lo escrito para el modo actual.
+    fn texto(&self) -> &str {
+        match self.modo {
+            Modo::Voz => &self.guion,
+            Modo::Musica => &self.musica,
+            Modo::Efecto => &self.efecto,
+            Modo::Mejorar
+            | Modo::Subtitulos
+            | Modo::Silencios
+            | Modo::Muletillas
+            | Modo::PorTexto
+            | Modo::Vertical
+            | Modo::Corta
+            | Modo::Buscar
+            | Modo::Doblaje => "",
+            _ => &self.prompt,
+        }
+    }
+
+    /// El campo de texto del modo actual (Mejorar no tiene: usa uno vacío de descarte).
+    fn texto_mut(&mut self) -> Option<&mut String> {
+        match self.modo {
+            Modo::Voz => Some(&mut self.guion),
+            Modo::Musica => Some(&mut self.musica),
+            Modo::Efecto => Some(&mut self.efecto),
+            Modo::Mejorar | Modo::Subtitulos | Modo::Silencios | Modo::Muletillas | Modo::PorTexto | Modo::Vertical | Modo::Corta => None,
+            _ => Some(&mut self.prompt),
+        }
+    }
+
+    /// Las letras del texto que se envía (como las cuenta el servidor).
+    fn letras(&self) -> usize {
+        self.texto().trim().chars().count()
+    }
+
+    /// Las herramientas del modo (voz, música, efecto o mejora): las del servidor o, mientras no
+    /// responde, las conocidas.
+    fn herramientas(&self) -> Vec<Herramienta> {
+        let Some(familia) = self.modo.familia() else { return Vec::new() };
+        let lista = match &self.info {
+            Some(i) if i.herramientas.iter().any(|h| h.familia == familia) => i.herramientas.clone(),
+            _ => herramientas_base(),
+        };
+        lista.into_iter().filter(|h| h.familia == familia).collect()
+    }
+
+    fn herramienta_actual(&self) -> Option<Herramienta> {
+        let lista = self.herramientas();
+        let elegida = if self.modo == Modo::Voz { lista.iter().find(|h| h.id == self.voz_modelo) } else { None };
+        elegida.or(lista.first()).cloned()
+    }
+
+    /// La voz que se pide: la elegida si existe; si no, la primera.
+    fn voz_actual(&self, h: &Herramienta) -> Option<Voz> {
+        h.voces.iter().find(|v| v.id == self.voz).or(h.voces.first()).cloned()
+    }
+
+    fn velocidad_actual(&self) -> f32 {
+        if (0.7..=1.2).contains(&self.velocidad) { self.velocidad } else { 1.0 }
+    }
+
+    fn idioma_actual(&self) -> &'static str {
+        IDIOMAS.iter().find(|(c, _)| *c == self.idioma).or(IDIOMAS.first()).map_or("es", |(c, _)| *c)
+    }
+
+    fn duracion_musica_actual(&self, h: &Herramienta) -> u32 {
+        let d = if self.duracion_musica == 0 { DURACION_MUSICA } else { self.duracion_musica };
+        match h.duracion {
+            Some((min, max)) if min <= max => d.clamp(min, max),
+            _ => d,
+        }
+    }
+
+    fn resolucion_actual(&self) -> &'static str {
+        RESOLUCIONES.iter().copied().find(|r| *r == self.resolucion).unwrap_or(RESOLUCION)
+    }
+
+    /// Los créditos de lo que se va a crear, según el servidor. `segundos` es la duración del
+    /// clip que se mejora.
+    fn costo(&self, segundos: Option<f64>) -> Option<i64> {
+        if self.es_local() {
+            return None;
+        }
+        self.info.as_ref()?;
+        if self.modo.es_video() {
+            let m = self.modelo_actual();
+            return m.costo(self.duracion_actual(&m), self.sonido_actual(&m));
+        }
+        let h = self.herramienta_actual()?;
+        match self.modo {
+            Modo::Voz => Some(creditos_de_voz(h.por_mil?, self.letras())),
+            Modo::Mejorar => {
+                let por = h.por_segundo.iter().find(|(r, _)| r == self.resolucion_actual())?.1;
+                creditos_de_mejora(por, segundos?)
+            }
+            Modo::Vertical => {
+                let por = h.por_segundo.iter().find(|(r, _)| r == self.vertical.resolucion_nube())?.1;
+                creditos_de_mejora(por, segundos?)
+            }
+            _ => h.creditos,
+        }
+    }
+
+    fn ocupado(&self) -> bool {
+        self.trabajo.is_some()
+    }
+
+    /// Jacnex: la herramienta se hace en esta computadora, sin créditos ni sesión.
+    fn es_local(&self) -> bool {
+        self.modo.local().is_some() || (self.modo == Modo::Vertical && !self.vertical.en_nube())
+    }
+}
+
+/// La proporción que se pide: la elegida si el modelo la tiene; si no, la más cercana a la de la
+/// secuencia (`ancho`×`alto`), o la primera del modelo.
+fn aspecto_para(m: &ModeloInfo, elegido: &str, tamano: Option<(u32, u32)>) -> String {
+    if m.aspectos.iter().any(|a| a == elegido) {
+        return elegido.to_string();
+    }
+    let razon = |a: &str| -> Option<f64> {
+        let (x, y) = a.split_once(':')?;
+        let (x, y) = (x.trim().parse::<f64>().ok()?, y.trim().parse::<f64>().ok()?);
+        (x > 0.0 && y > 0.0).then_some(x / y)
+    };
+    if let Some((w, h)) = tamano.filter(|(w, h)| *w > 0 && *h > 0) {
+        let r = f64::from(w) / f64::from(h);
+        let mejor = m.aspectos.iter().filter_map(|a| Some((a, (razon(a)?.ln() - r.ln()).abs()))).min_by(|a, b| a.1.total_cmp(&b.1));
+        if let Some((a, _)) = mejor {
+            return a.clone();
+        }
+    }
+    m.aspectos.first().cloned().unwrap_or_else(|| "16:9".into())
+}
