+++ b/crates/separate/src/fft.rs
@@ -0,0 +1,80 @@
+//! A radix-2 complex FFT (the STFT of the separation network uses 2048 points).
+
+use crate::{Result, SeparateError};
+
+/// Largest transform accepted (a hostile size must not allocate gigabytes of tables).
+pub const MAX_FFT: usize = 1 << 16;
+
+/// A forward/inverse FFT of a power-of-two size, with its tables precomputed.
+pub struct Fft {
+    n: usize,
+    rev: Vec<u32>,
+    cos: Vec<f32>,
+    sin: Vec<f32>,
+}
+
+impl Fft {
+    pub fn new(n: usize) -> Result<Self> {
+        if !n.is_power_of_two() || !(2..=MAX_FFT).contains(&n) {
+            return Err(SeparateError::Input(format!("FFT size {n} is not a power of two between 2 and {MAX_FFT}")));
+        }
+        let bits = n.trailing_zeros();
+        let rev = (0..n as u32).map(|i| i.reverse_bits() >> (32 - bits)).collect();
+        let (cos, sin) = (0..n / 2)
+            .map(|k| {
+                let a = -2.0 * std::f64::consts::PI * k as f64 / n as f64;
+                (a.cos() as f32, a.sin() as f32)
+            })
+            .unzip();
+        Ok(Self { n, rev, cos, sin })
+    }
+
+    pub fn len(&self) -> usize {
+        self.n
+    }
+
+    pub fn is_empty(&self) -> bool {
+        false
+    }
+
+    /// In place, `e^{-i}` (no scaling). Slices of the wrong length are left untouched.
+    pub fn forward(&self, re: &mut [f32], im: &mut [f32]) {
+        self.run(re, im, false);
+    }
+
+    /// In place, `e^{+i}` (no scaling: divide by `len()` for the exact inverse).
+    pub fn inverse(&self, re: &mut [f32], im: &mut [f32]) {
+        self.run(re, im, true);
+    }
+
+    fn run(&self, re: &mut [f32], im: &mut [f32], inverse: bool) {
+        let n = self.n;
+        if re.len() != n || im.len() != n {
+            return;
+        }
+        for (i, &j) in self.rev.iter().enumerate() {
+            let j = j as usize;
+            if j > i {
+                re.swap(i, j);
+                im.swap(i, j);
+            }
+        }
+        let sign = if inverse { -1.0 } else { 1.0 };
+        let mut half = 1;
+        while half < n {
+            let step = n / (half * 2);
+            for start in (0..n).step_by(half * 2) {
+                for k in 0..half {
+                    let (wr, wi) = (self.cos[k * step], sign * self.sin[k * step]);
+                    let (a, b) = (start + k, start + k + half);
+                    let (tr, ti) = (re[b] * wr - im[b] * wi, re[b] * wi + im[b] * wr);
+                    re[b] = re[a] - tr;
+                    im[b] = im[a] - ti;
+                    re[a] += tr;
+                    im[a] += ti;
+                }
+            }
+            half *= 2;
+        }
+    }
+}
diff --git a/crates/separate/src/lib.rs b/crates/separate/src/lib.rs
