+/// El cuerpo de la ventana en «Buscar».
+pub fn cuerpo(ui: &mut egui::Ui, b: &mut Buscar, d: &Datos, t: &crate::theme::Tokens) {
+    titulo(ui, "Qué buscas", t);
+    let r = ui.add(egui::TextEdit::singleline(&mut b.consulta).hint_text("Ej.: cuando habla del precio").desired_width(f32::INFINITY));
+    if b.consulta.chars().count() > MAX_CONSULTA {
+        b.consulta = b.consulta.chars().take(MAX_CONSULTA).collect();
+    }
+    if r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter)) && d.falta.is_none() {
+        b.pendiente = Some(if b.con_ia { Pedido::Preparar } else { Pedido::Buscar });
+    }
+    ui.horizontal_wrapped(|ui| {
+        ui.spacing_mut().item_spacing = egui::vec2(4.0, 4.0);
+        for idea in ["cuando habla del precio", "la toma de la playa", "cuando aparece el producto"] {
+            if ui.small_button(format!("+ {idea}")).clicked() {
+                b.consulta = idea.to_string();
+            }
+        }
+    });
+    ui.add_space(8.0);
+    titulo(ui, "Cómo buscar", t);
+    let motores = ["En tu PC".to_string(), "Con IA (créditos)".to_string()];
+    if let Some(i) = segmentos(ui, &motores, usize::from(b.con_ia), t) {
+        b.con_ia = i == 1;
+        b.material = None;
+    }
+    ui.add_space(4.0);
+    if b.con_ia {
+        ajustes_ia(ui, b, d, t);
+    } else {
+        ajustes_local(ui, d, t);
+    }
+    if !b.resultados.is_empty() {
+        ui.add_space(8.0);
+        titulo(ui, &format!("{} · {}", plural(b.resultados.len()), b.de.chars().take(40).collect::<String>()), t);
+        let mut pedido = None;
+        for (i, r) in b.resultados.iter().enumerate() {
+            fila(ui, i, r, t, &mut pedido);
+        }
+        if pedido.is_some() {
+            b.pendiente = pedido;
+        }
+    }
+    ui.add_space(4.0);
+}
+
+fn plural(n: usize) -> String {
+    if n == 1 { "1 resultado".into() } else { format!("{n} resultados") }
+}
+
+fn ajustes_local(ui: &mut egui::Ui, d: &Datos, t: &crate::theme::Tokens) {
+    if !ModelStatus::available() {
+        ui.label(RichText::new("En esta versión se buscan las palabras que se dicen (exactas y parecidas).").small().color(t.text_dim));
+        return;
+    }
+    let (sig, img) = (d.modelos.meaning, d.modelos.picture);
+    let marca = |ok: bool| if ok { "listo" } else { "falta" };
+    ui.label(RichText::new(format!("Palabras: listo · Significado: {} · Imagen: {}", marca(sig), marca(img))).small().color(t.text_dim));
+    if !sig || !img {
+        ui.label(RichText::new(search::MISSING).small().color(ROJO));
+    }
+}
+
+fn ajustes_ia(ui: &mut egui::Ui, b: &mut Buscar, d: &Datos, t: &crate::theme::Tokens) {
+    let actual = b.archivo.or(d.fuente).filter(|i| d.archivos.iter().any(|(a, _)| a == i));
+    let nombre = d.archivos.iter().find(|(i, _)| Some(*i) == actual).map_or("Elige un archivo", |(_, n)| n.as_str());
+    ui.label(RichText::new("Archivo donde buscar").color(t.text_dim));
+    craft_ui::ComboBox::from_id_salt("jacnex-buscar-archivo").selected_text(nombre).width(ui.available_width()).show_ui(ui, |ui| {
+        for (i, n) in &d.archivos {
+            if ui.selectable_label(Some(*i) == actual, n.as_str()).clicked() {
+                b.archivo = Some(*i);
+                b.material = None;
+            }
+        }
+    });
+    ui.label(
+        RichText::new("La IA lee la transcripción y hojas con fotogramas de ESE archivo. Se cobra lo que cuesta de verdad, como máximo lo que se muestra antes de enviar.")
+            .small()
+            .color(t.text_dim),
+    );
+    if !d.sesion {
+        ui.label(RichText::new("Inicia sesión en Jacnex Studio para buscar con IA.").small().color(ROJO));
+    }
+}
+
+/// Un resultado: miniatura, clip, tiempo, por qué coincide y los botones.
+fn fila(ui: &mut egui::Ui, i: usize, r: &Resultado, t: &crate::theme::Tokens, pedido: &mut Option<Pedido>) {
+    egui::Frame::NONE.fill(t.field_bg).corner_radius(6.0).inner_margin(6).show(ui, |ui| {
+        ui.set_width(ui.available_width());
+        ui.horizontal(|ui| {
+            let tam = egui::vec2(88.0, 50.0);
+            match &r.textura {
+                Some(tx) => {
+                    let alto = tam.y.min(tam.x * tx.size()[1] as f32 / tx.size()[0].max(1) as f32);
+                    let im = egui::Image::new(egui::load::SizedTexture::new(tx.id(), egui::vec2(tam.x, alto))).sense(egui::Sense::click());
+                    if ui.add(im).on_hover_text("Ver en el visor de origen").clicked() {
+                        *pedido = Some(Pedido::Ver(i));
+                    }
+                }
+                None => {
+                    let (rect, resp) = ui.allocate_exact_size(tam, egui::Sense::click());
+                    ui.painter().rect_filled(rect, 4.0, t.panel_bg);
+                    ui.painter().text(rect.center(), egui::Align2::CENTER_CENTER, "sonido", egui::FontId::proportional(11.0), t.text_dim);
+                    if resp.clicked() {
+                        *pedido = Some(Pedido::Ver(i));
+                    }
+                }
+            }
+            ui.vertical(|ui| {
+                ui.label(RichText::new(format!("{}  ·  {}", r.nombre, rango(&r.hit))).strong().color(t.text));
+                ui.label(RichText::new(r.razon.as_str()).small().color(ACENTO_CLARO));
+                ui.horizontal(|ui| {
+                    if ui.small_button("Ver").clicked() {
+                        *pedido = Some(Pedido::Ver(i));
+                    }
+                    if ui.small_button("Agregar a la secuencia").clicked() {
+                        *pedido = Some(Pedido::Agregar(i));
+                    }
+                });
+            });
+        });
+    });
+}
