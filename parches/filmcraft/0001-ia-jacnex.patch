+//! Editing from the transcript, aware of the spoken language:
+//!
+//! - `transcript.removeFillersSmart`: removes hesitations ("eh", "mm", "um"…) always, and
+//!   discourse fillers ("este", "o sea", "bueno", "pues"…) only where they stand on their own:
+//!   at the start of a clause and followed by a comma or a pause. "Este libro" or "muy bueno"
+//!   stay.
+//! - `transcript.createAnimatedCaptions`: social-style captions as graphic text clips on a new
+//!   video track, one undo step. Styles: the current word highlighted in the phrase, one word at
+//!   a time with a pop, or classic phrases on a box.
+
+use std::ops::Range;
+
+use serde_json::{Value, json};
+
+use filmcraft_edit::transcript::{self as tx, SeqWord};
+use filmcraft_geom::Vec2;
+use filmcraft_project::graphic::{ensure_layer_uids, new_text_layer};
+use filmcraft_project::{CharStyle, EffectInstance, ItemId, LayerExtra, Param, ParamValue, StyleRun, TrackId, TrackKind};
+use filmcraft_time::{FrameRate, Tick, TimeRange};
+
+use crate::commands::{CommandSpec, bad, bool_p, f64_p, has_seq, str_p, u64_p};
+use crate::transcript::{remove_ranges, sequence_words};
+use crate::{EngineError, Result, Session};
+
+fn spec(id: &'static str, label: &'static str, params: &'static str, run: fn(&mut Session, &Value) -> Result<Value>) -> CommandSpec {
+    CommandSpec {
+        id,
+        label,
+        menu: &["Sequence", "Transcript"],
+        shortcut: None,
+        params,
+        enabled: has_words,
+        run,
+        journal: true,
+        named: crate::commands::NamedKeys::NONE,
+    }
+}
+
+fn has_words(s: &Session) -> std::result::Result<(), String> {
+    has_seq(s)?;
+    if sequence_words(s).is_empty() { Err("the sequence has no transcript (Transcribe first)".into()) } else { Ok(()) }
+}
+
+// --- Filler words ------------------------------------------------------------------------------
+
+/// Hesitations removed in every language.
+const HESITATIONS: &[&str] = &["um", "uh", "umm", "uhm", "erm", "er", "hmm", "mm", "mmm", "mhm"];
+/// More hesitations in Spanish ("ah" and "am" are words in English, so only here).
+const HESITATIONS_ES: &[&str] = &["eh", "ehh", "ehm", "em", "emm", "ah", "ahh", "am", "amm", "aja"];
+/// Spanish discourse fillers: removed only where they stand alone.
+const DISCOURSE_ES: &[&str] = &["o sea", "osea", "este", "bueno", "pues", "digamos", "o sea que"];
+/// Words after which a discourse filler still starts a clause ("y, este, …", "pero bueno, …").
+const CLAUSE_JOINERS_ES: &[&str] = &["y", "pero", "entonces", "que"];
+/// A silence at least this long around a word counts like a comma.
+const PAUSE: f64 = 0.3;
+
+fn ends_clause(text: &str) -> bool {
+    text.trim_end().ends_with([',', ';', ':', '…']) || text.trim_end().ends_with("...")
+}
+
+fn ends_sentence(text: &str) -> bool {
+    let t = text.trim_end().trim_end_matches(['"', '\'', '»', ')']);
+    t.ends_with(['.', '?', '!']) && !t.ends_with("...")
+}
+
+/// Word index ranges that are filler words. `language(i)` is the ISO 639-1 code of word `i`'s
+/// transcript.
+pub fn find_smart_fillers(words: &[SeqWord], language: impl Fn(usize) -> String) -> Vec<Range<usize>> {
+    let norm: Vec<String> = words.iter().map(SeqWord::normalized).collect();
+    let pause = Tick::from_seconds_f64(PAUSE);
+    let mut phrases: Vec<Vec<&str>> = DISCOURSE_ES.iter().map(|p| p.split(' ').collect()).collect();
+    // longest first: "o sea que" before "o sea"
+    phrases.sort_by_key(|p| std::cmp::Reverse(p.len()));
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < words.len() {
+        let es = language(i).to_ascii_lowercase().starts_with("es");
+        let w = norm[i].as_str();
+        if !w.is_empty() && (HESITATIONS.contains(&w) || (es && HESITATIONS_ES.contains(&w))) {
+            out.push(i..i + 1);
+            i += 1;
+            continue;
+        }
+        if es {
+            let hit = phrases.iter().find(|p| i + p.len() <= words.len() && p.iter().enumerate().all(|(k, x)| norm[i + k] == *x));
+            if let Some(p) = hit {
+                let last = i + p.len() - 1;
+                let starts = match i.checked_sub(1) {
+                    None => true,
+                    Some(b) => {
+                        ends_clause(&words[b].text)
+                            || ends_sentence(&words[b].text)
+                            || words[i].start - words[b].end >= pause
+                            || CLAUSE_JOINERS_ES.contains(&norm[b].as_str())
+                    }
+                };
+                let alone = !ends_sentence(&words[last].text)
+                    && (ends_clause(&words[last].text) || words.get(last + 1).is_some_and(|n| n.start - words[last].end >= pause));
+                if starts && alone {
+                    out.push(i..last + 1);
+                    i = last + 1;
+                    continue;
+                }
+            }
+        }
+        i += 1;
+    }
+    out
+}
+
+fn remove_fillers_smart(s: &mut Session, p: &Value) -> Result<Value> {
+    let words = sequence_words(s);
+    let forced = str_p(p, "language").map(str::to_string);
+    let project = s.project.clone();
+    let language = |i: usize| match &forced {
+        Some(l) => l.clone(),
+        None => words.get(i).and_then(|w| project.transcripts.get(&w.item)).map(|t| t.language.clone()).unwrap_or_default(),
+    };
+    let hits = find_smart_fillers(&words, language);
+    let removed: Vec<String> = hits.iter().map(|h| words[h.clone()].iter().map(|w| w.text.as_str()).collect::<Vec<_>>().join(" ")).collect();
+    let ranges = tx::filler_ranges(&words, &hits, s.sequence_rate());
+    let mut r = remove_ranges(s, "Remove Filler Words", ranges)?;
+    if let Some(o) = r.as_object_mut() {
+        o.insert("words".into(), json!(removed));
+    }
+    Ok(r)
+}
+
+// --- Animated captions -------------------------------------------------------------------------
+
+/// How the captions look and move.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CaptionLook {
+    /// The phrase, with the word being said highlighted (and a little bigger).
+    Highlight,
+    /// One word at a time, popping in.
+    Word,
+    /// The phrase on a dark box, no animation.
+    Classic,
+}
+
+impl CaptionLook {
+    fn from_name(n: &str) -> Option<Self> {
+        match n {
+            "highlight" => Some(Self::Highlight),
+            "word" => Some(Self::Word),
+            "classic" => Some(Self::Classic),
+            _ => None,
+        }
+    }
+    fn default_words(self) -> usize {
+        match self {
+            Self::Highlight => 4,
+            Self::Word => 1,
+            Self::Classic => 7,
+        }
+    }
+}
+
+/// Where the captions sit.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CaptionPlace {
+    Bottom,
+    Middle,
+    Top,
+}
+
+/// Most clips one call creates (a clip per word: about 3 hours of speech).
+const MAX_CLIPS: usize = 40_000;
+/// A phrase stays on screen this long after its last word (unless the next one starts).
+const HOLD: f64 = 0.35;
+/// A silence this long ends the phrase.
+const PHRASE_PAUSE: f64 = 0.7;
+
+/// The words grouped into phrases of at most `max_words` words and `max_chars` characters,
+/// broken at sentence ends, commas (once the phrase has half its words, at least two), long
+/// pauses and speaker changes.
+pub fn phrases(words: &[SeqWord], max_words: usize, max_chars: usize) -> Vec<Range<usize>> {
+    let max_words = max_words.clamp(1, 12);
+    let max_chars = max_chars.max(1);
+    let pause = Tick::from_seconds_f64(PHRASE_PAUSE);
+    let comma = (max_words / 2).max(2);
+    let mut out = Vec::new();
+    let mut a = 0;
+    let mut chars = 0;
+    for i in 0..words.len() {
+        let len = display(&words[i].text).chars().count();
+        if i > a {
+            let prev = &words[i - 1];
+            let n = i - a;
+            let split = n >= max_words
+                || chars + 1 + len > max_chars
+                || ends_sentence(&prev.text)
+                || (n >= comma && ends_clause(&prev.text))
+                || words[i].start - prev.end >= pause
+                || words[i].speaker != prev.speaker
+                || words[i].track != prev.track;
+            if split {
+                out.push(a..i);
+                a = i;
+                chars = 0;
+            }
+        }
+        chars += if i > a { 1 + len } else { len };
+    }
+    if a < words.len() {
+        out.push(a..words.len());
+    }
+    out
+}
+
+/// A word as shown in a caption: without the trailing commas and periods (question and
+/// exclamation marks stay).
+fn display(text: &str) -> &str {
+    let t = text.trim();
+    let cut = t.trim_end_matches([',', '.', ';', ':', '…']);
+    if cut.is_empty() { t } else { cut }
+}
+
+/// One caption clip: its text, time, and the characters of the highlighted word.
+#[derive(Clone, Debug, PartialEq)]
+pub struct CaptionClip {
+    pub text: String,
+    pub start: Tick,
+    pub end: Tick,
+    /// Character range of the word being said (None: nothing highlighted).
+    pub active: Option<Range<usize>>,
+}
+
+/// The caption clips for `words`, frame-aligned and never overlapping.
+pub fn caption_clips(words: &[SeqWord], look: CaptionLook, max_words: usize, max_chars: usize, rate: FrameRate) -> Vec<CaptionClip> {
+    let groups = phrases(words, if look == CaptionLook::Word { 1 } else { max_words }, max_chars);
+    let hold = Tick::from_seconds_f64(HOLD);
+    let frame = rate.frame_duration();
+    let mut out: Vec<CaptionClip> = Vec::new();
+    let mut cursor = Tick::ZERO;
+    for (g, r) in groups.iter().enumerate() {
+        let Some(last) = words.get(r.end.saturating_sub(1)) else { continue };
+        let mut end = last.end + hold;
+        if let Some(next) = groups.get(g + 1).and_then(|n| words.get(n.start)) {
+            end = end.min(next.start);
+        }
+        let end = end.max(last.end);
+        let texts: Vec<&str> = words[r.clone()].iter().map(|w| display(&w.text)).collect();
+        let text = texts.join(" ");
+        // character offsets of each word in `text`
+        let mut offsets = Vec::with_capacity(texts.len());
+        let mut at = 0usize;
+        for t in &texts {
+            let n = t.chars().count();
+            offsets.push(at..at + n);
+            at += n + 1;
+        }
+        let mut push = |start: Tick, stop: Tick, active: Option<Range<usize>>| {
+            let s = rate.snap_nearest(start).max(cursor);
+            let e = rate.snap_nearest(stop);
+            if e >= s + frame {
+                out.push(CaptionClip { text: text.clone(), start: s, end: e, active });
+                cursor = e;
+            }
+        };
+        match look {
+            CaptionLook::Classic => push(words[r.start].start, end, None),
+            CaptionLook::Highlight | CaptionLook::Word => {
+                for k in r.clone() {
+                    let stop = if k + 1 < r.end { words[k + 1].start } else { end };
+                    let active = if look == CaptionLook::Highlight { offsets.get(k - r.start).cloned() } else { None };
+                    push(words[k].start, stop, active);
+                }
+            }
+        }
+        if out.len() >= MAX_CLIPS {
+            out.truncate(MAX_CLIPS);
+            break;
+        }
+    }
+    out
+}
+
+/// The look of the caption text layers.
+struct Styling {
+    look: CaptionLook,
+    size: f64,
+    position: Vec2,
+    color: [f32; 4],
+    highlight: [f32; 4],
+    caps: bool,
+}
+
+fn set(e: &mut EffectInstance, id: &str, v: ParamValue) {
+    e.params.insert(id.into(), Param::new(v));
+}
+
+fn layer_for(c: &CaptionClip, st: &Styling, frame: Tick) -> EffectInstance {
+    let mut e = new_text_layer(&c.text, st.position, st.size);
+    set(&mut e, "name", ParamValue::Text("Subtítulo".into()));
+    set(&mut e, "font", ParamValue::Text("Inter".into()));
+    set(&mut e, "align", ParamValue::Choice(1));
+    set(&mut e, "fill_color", ParamValue::Color(st.color));
+    set(&mut e, "caps", ParamValue::Choice(u32::from(st.caps)));
+    match st.look {
+        CaptionLook::Classic => {
+            set(&mut e, "font_style", ParamValue::Text("SemiBold".into()));
+            set(&mut e, "background", ParamValue::Bool(true));
+            set(&mut e, "background_opacity", ParamValue::Float(70.0));
+            set(&mut e, "background_size", ParamValue::Float((st.size * 0.22).clamp(2.0, 80.0)));
+            set(&mut e, "background_radius", ParamValue::Float((st.size * 0.18).clamp(0.0, 60.0)));
+        }
+        CaptionLook::Highlight | CaptionLook::Word => {
+            set(&mut e, "font_style", ParamValue::Text("Bold".into()));
+            set(&mut e, "stroke", ParamValue::Bool(true));
+            set(&mut e, "stroke_color", ParamValue::Color([0.0, 0.0, 0.0, 1.0]));
+            set(&mut e, "stroke_width", ParamValue::Float((st.size * 0.1).clamp(1.0, 40.0)));
+            set(&mut e, "shadow", ParamValue::Bool(true));
+            set(&mut e, "shadow_opacity", ParamValue::Float(55.0));
+            set(&mut e, "shadow_distance", ParamValue::Float((st.size * 0.06).clamp(1.0, 30.0)));
+            set(&mut e, "shadow_blur", ParamValue::Float((st.size * 0.2).clamp(1.0, 60.0)));
+        }
+    }
+    if let Some(r) = &c.active {
+        let style = CharStyle { fill: Some(st.highlight), size: Some((st.size * 1.12) as f32), ..Default::default() };
+        e.layer = Some(Box::new(LayerExtra { runs: vec![StyleRun { start: r.start, end: r.end, style }], ..Default::default() }));
+    }
+    if st.look == CaptionLook::Word && c.end - c.start >= Tick(frame.0 * 4) {
+        // pop in: 70 % → 108 % → 100 % over the first four frames
+        if let Some(p) = e.params.get_mut("scale") {
+            p.put_keyframe(Tick::ZERO, ParamValue::Float(70.0));
+            p.put_keyframe(Tick(frame.0 * 2), ParamValue::Float(108.0));
+            p.put_keyframe(Tick(frame.0 * 4), ParamValue::Float(100.0));
+        }
+    }
+    e
+}
+
+fn color_p(p: &Value, k: &str) -> Option<[f32; 4]> {
+    let s = str_p(p, k)?.trim().trim_start_matches('#');
+    if s.len() != 6 || !s.is_ascii() {
+        return None;
+    }
+    let c = |i: usize| u8::from_str_radix(s.get(i..i + 2)?, 16).ok().map(|v| f32::from(v) / 255.0);
+    Some([c(0)?, c(2)?, c(4)?, 1.0])
+}
+
+fn create_animated_captions(s: &mut Session, p: &Value) -> Result<Value> {
+    const CMD: &str = "transcript.createAnimatedCaptions";
+    let seq_id = s.state.active_sequence.ok_or(EngineError::NoSequence)?;
+    let look = match str_p(p, "style") {
+        Some(n) => CaptionLook::from_name(n).ok_or_else(|| bad(CMD, "`style` is highlight, word or classic"))?,
+        None => CaptionLook::Highlight,
+    };
+    let place = match str_p(p, "position").unwrap_or("bottom") {
+        "bottom" => CaptionPlace::Bottom,
+        "middle" | "center" => CaptionPlace::Middle,
+        "top" => CaptionPlace::Top,
+        _ => return Err(bad(CMD, "`position` is bottom, middle or top")),
+    };
+    let (w, h, rate) = {
+        let q = s.active_sequence().ok_or(EngineError::NoSequence)?;
+        (q.settings.width.max(16), q.settings.height.max(16), q.settings.frame_rate)
+    };
+    let (wf, hf) = (f64::from(w), f64::from(h));
+    let short = wf.min(hf);
+    let base = match look {
+        CaptionLook::Highlight => 0.075,
+        CaptionLook::Word => 0.1,
+        CaptionLook::Classic => 0.05,
+    };
+    let size = f64_p(p, "size").filter(|v| v.is_finite()).unwrap_or(short * base).clamp(8.0, 600.0);
+    let max_words = u64_p(p, "maxWords").map_or(look.default_words(), |n| n.clamp(1, 12) as usize);
+    // the phrase fits in 86 % of the frame width (bold caps are about 0.62 em wide)
+    let max_chars = ((wf * 0.86) / (size * 0.62)).floor().clamp(6.0, 80.0) as usize;
+    let y = match place {
+        CaptionPlace::Bottom => hf * 0.8,
+        CaptionPlace::Middle => hf * 0.5 + size * 0.35,
+        CaptionPlace::Top => hf * 0.14 + size,
+    };
+    let st = Styling {
+        look,
+        size,
+        position: Vec2::new(wf / 2.0, y),
+        color: color_p(p, "color").unwrap_or([1.0, 1.0, 1.0, 1.0]),
+        highlight: color_p(p, "highlight").unwrap_or([1.0, 0.84, 0.0, 1.0]),
+        caps: bool_p(p, "caps").unwrap_or(look != CaptionLook::Classic),
+    };
+    let words = sequence_words(s);
+    let clips = caption_clips(&words, look, max_words, max_chars, rate);
+    if clips.is_empty() {
+        return Err(EngineError::Other("the transcript has no words to caption".into()));
+    }
+    let name = str_p(p, "name").unwrap_or("Subtítulos").to_string();
+    let frame = rate.frame_duration();
+    let n = clips.len();
+    let (track, index) = s.edit("Create Animated Captions", |pr, ed| {
+        let src: ItemId = crate::graphics::graphic_source(pr, w, h, rate);
+        let track_id = TrackId(pr.alloc_id());
+        let mut track = filmcraft_project::Track::new(track_id, TrackKind::Video, name);
+        for c in &clips {
+            let dur = c.end - c.start;
+            let mut ti = pr.make_track_item(src, TrackKind::Video, c.start, TimeRange::new(Tick::ZERO, dur), rate).ok_or_else(|| bad(CMD, "bad item"))?;
+            ti.name = c.text.chars().take(40).collect();
+            ti.effects.push(layer_for(c, &st, frame));
+            ensure_layer_uids(&mut ti.effects);
+            for e in &mut ti.effects {
+                filmcraft_project::resolve_auto_points(e, (w, h), (w, h));
+            }
+            track.items.push(ti);
+        }
+        track.sort();
+        let q = pr.sequence_mut(seq_id).ok_or(EngineError::NoSequence)?;
+        q.video_tracks.push(track);
+        let index = q.video_tracks.len() - 1;
+        q.check().map_err(EngineError::Other)?;
+        ed.selection.clear();
+        Ok((track_id, index))
+    })?;
+    Ok(json!({"track": track.0, "trackIndex": index, "clips": n}))
+}
+
+pub fn commands() -> Vec<CommandSpec> {
+    vec![
+        spec("transcript.removeFillersSmart", "Remove Filler Words (Language-Aware)", r#"{"language":"es|en"?}"#, remove_fillers_smart),
+        spec(
+            "transcript.createAnimatedCaptions",
+            "Create Animated Captions…",
+            r##"{"style":"highlight|word|classic"?,"position":"bottom|middle|top"?,"maxWords":n?,"size":px?,"color":"#RRGGBB"?,"highlight":"#RRGGBB"?,"caps":bool?,"name":str?}"##,
+            create_animated_captions,
+        ),
+    ]
+}
