+++ b/crates/separate/src/stft.rs
@@ -0,0 +1,187 @@
+//! The STFT and its inverse, as `torch.stft` / `torch.istft` do them in the original network:
+//! periodic Hann window, `center = True` with reflect padding, one-sided, not normalised.
+
+use crate::fft::Fft;
+use crate::{Result, SeparateError};
+
+/// A spectrogram, frame-major: `re[frame * bins + bin]`.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct Spec {
+    pub frames: usize,
+    pub bins: usize,
+    pub re: Vec<f32>,
+    pub im: Vec<f32>,
+}
+
+pub struct Stft {
+    n_fft: usize,
+    hop: usize,
+    window: Vec<f32>,
+    fft: Fft,
+}
+
+/// Index of `i` mirrored into `0..n` without repeating the edge sample (`torch` reflect padding), for any `i`.
+fn reflect(i: i64, n: usize) -> usize {
+    if n <= 1 {
+        return 0;
+    }
+    let period = 2 * (n as i64 - 1);
+    let m = i.rem_euclid(period);
+    (if m >= n as i64 { period - m } else { m }) as usize
+}
+
+impl Stft {
+    /// `win_length == n_fft`, as in the network.
+    pub fn new(n_fft: usize, hop: usize) -> Result<Self> {
+        if hop == 0 || hop > n_fft {
+            return Err(SeparateError::Input(format!("hop {hop} does not fit FFT size {n_fft}")));
+        }
+        let fft = Fft::new(n_fft)?;
+        let window = (0..n_fft).map(|i| (0.5 - 0.5 * (2.0 * std::f64::consts::PI * i as f64 / n_fft as f64).cos()) as f32).collect();
+        Ok(Self { n_fft, hop, window, fft })
+    }
+
+    pub fn bins(&self) -> usize {
+        self.n_fft / 2 + 1
+    }
+
+    /// Frames `forward` gives for `len` samples.
+    pub fn frames_for(&self, len: usize) -> usize {
+        1 + len / self.hop
+    }
+
+    pub fn forward(&self, x: &[f32]) -> Spec {
+        let bins = self.bins();
+        let frames = self.frames_for(x.len());
+        let mut spec = Spec { frames, bins, re: vec![0.0; frames * bins], im: vec![0.0; frames * bins] };
+        if x.is_empty() {
+            return spec;
+        }
+        let pad = (self.n_fft / 2) as i64;
+        let (mut re, mut im) = (vec![0.0f32; self.n_fft], vec![0.0f32; self.n_fft]);
+        for t in 0..frames {
+            let start = (t * self.hop) as i64 - pad;
+            for (k, w) in self.window.iter().enumerate() {
+                re[k] = x[reflect(start + k as i64, x.len())] * w;
+                im[k] = 0.0;
+            }
+            self.fft.forward(&mut re, &mut im);
+            spec.re[t * bins..(t + 1) * bins].copy_from_slice(&re[..bins]);
+            spec.im[t * bins..(t + 1) * bins].copy_from_slice(&im[..bins]);
+        }
+        spec
+    }
+
+    /// `(frames - 1) * hop` samples. A malformed spectrogram gives silence of that length.
+    pub fn inverse(&self, spec: &Spec) -> Vec<f32> {
+        let bins = self.bins();
+        if spec.frames == 0 || spec.bins != bins || spec.re.len() != spec.frames * bins || spec.im.len() != spec.re.len() {
+            return vec![0.0; spec.frames.saturating_sub(1) * self.hop];
+        }
+        let total = (spec.frames - 1) * self.hop + self.n_fft;
+        let (mut out, mut env) = (vec![0.0f32; total], vec![0.0f32; total]);
+        let (mut re, mut im) = (vec![0.0f32; self.n_fft], vec![0.0f32; self.n_fft]);
+        let scale = 1.0 / self.n_fft as f32;
+        for t in 0..spec.frames {
+            let (fr, fi) = (&spec.re[t * bins..(t + 1) * bins], &spec.im[t * bins..(t + 1) * bins]);
+            for k in 0..bins {
+                re[k] = fr[k];
+                // a real signal has no imaginary part at DC and Nyquist
+                im[k] = if k == 0 || k == bins - 1 { 0.0 } else { fi[k] };
+            }
+            for k in 1..bins - 1 {
+                re[self.n_fft - k] = fr[k];
+                im[self.n_fft - k] = -fi[k];
+            }
+            self.fft.inverse(&mut re, &mut im);
+            let base = t * self.hop;
+            for k in 0..self.n_fft {
+                out[base + k] += re[k] * scale * self.window[k];
+                env[base + k] += self.window[k] * self.window[k];
+            }
+        }
+        let pad = self.n_fft / 2;
+        (pad..total - pad).map(|i| if env[i] > 1e-11 { out[i] / env[i] } else { out[i] }).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn signal(n: usize) -> Vec<f32> {
+        (0..n).map(|i| (i as f32 * 0.05).sin() * 0.5 + (i as f32 * 0.31).cos() * 0.25 + ((i * 7919) % 101) as f32 / 1010.0).collect()
+    }
+
+    #[test]
+    fn reflect_padding_mirrors_without_repeating_the_edge() {
+        assert_eq!([reflect(-1, 5), reflect(-2, 5), reflect(5, 5), reflect(6, 5), reflect(0, 5), reflect(4, 5)], [1, 2, 3, 2, 0, 4]);
+        // far outside, and degenerate lengths, never go out of range
+        assert!(reflect(i64::MIN / 2, 7) < 7 && reflect(10_000_000, 3) < 3);
+        assert_eq!((reflect(5, 1), reflect(-5, 0)), (0, 0));
+    }
+
+    #[test]
+    fn fft_matches_a_direct_dft_and_inverts() {
+        let n = 16;
+        let fft = Fft::new(n).unwrap();
+        let x = signal(n);
+        let (mut re, mut im) = (x.clone(), vec![0.0; n]);
+        fft.forward(&mut re, &mut im);
+        for k in 0..n {
+            let (mut dr, mut di) = (0.0f64, 0.0f64);
+            for (i, v) in x.iter().enumerate() {
+                let a = -2.0 * std::f64::consts::PI * (i * k) as f64 / n as f64;
+                dr += f64::from(*v) * a.cos();
+                di += f64::from(*v) * a.sin();
+            }
+            assert!((f64::from(re[k]) - dr).abs() < 1e-4 && (f64::from(im[k]) - di).abs() < 1e-4, "bin {k}");
+        }
+        fft.inverse(&mut re, &mut im);
+        for (a, b) in re.iter().zip(&x) {
+            assert!((a / n as f32 - b).abs() < 1e-5);
+        }
+        assert!(Fft::new(0).is_err() && Fft::new(6).is_err() && Fft::new(1 << 20).is_err());
+    }
+
+    #[test]
+    fn wrong_sized_buffers_are_left_alone() {
+        let fft = Fft::new(8).unwrap();
+        let (mut re, mut im) = (vec![1.0; 4], vec![0.0; 8]);
+        fft.forward(&mut re, &mut im);
+        assert_eq!(re, vec![1.0; 4]);
+    }
+
+    #[test]
+    fn stft_then_istft_gives_the_signal_back() {
+        let st = Stft::new(2048, 441).unwrap();
+        let x = signal(441 * 40);
+        let spec = st.forward(&x);
+        assert_eq!((spec.frames, spec.bins), (41, 1025));
+        let y = st.inverse(&spec);
+        assert_eq!(y.len(), x.len());
+        let worst = x.iter().zip(&y).map(|(a, b)| (a - b).abs()).fold(0.0f32, f32::max);
+        assert!(worst < 1e-4, "worst {worst}");
+    }
+
+    #[test]
+    fn a_pure_tone_lands_in_its_bin() {
+        let st = Stft::new(2048, 512).unwrap();
+        let x: Vec<f32> = (0..8192).map(|i| (2.0 * std::f32::consts::PI * 64.0 * i as f32 / 2048.0).sin()).collect();
+        let s = st.forward(&x);
+        let t = 5;
+        let mag = |k: usize| s.re[t * 1025 + k].hypot(s.im[t * 1025 + k]);
+        assert!(mag(64) > 400.0 && mag(64) > 100.0 * mag(200), "{} {}", mag(64), mag(200));
+    }
+
+    #[test]
+    fn empty_and_malformed_input_do_not_panic() {
+        let st = Stft::new(64, 16).unwrap();
+        assert_eq!(st.forward(&[]).frames, 1);
+        assert!(st.inverse(&Spec::default()).is_empty());
+        let bad = Spec { frames: 3, bins: 5, re: vec![0.0; 3], im: vec![] };
+        assert_eq!(st.inverse(&bad), vec![0.0; 32]);
+        assert!(Stft::new(64, 0).is_err() && Stft::new(64, 65).is_err() && Stft::new(63, 16).is_err());
+        assert_eq!(st.forward(&[0.5]).frames, 1);
+    }
+}
