+/// Opciones del mismo ancho, una elegida. Devuelve la que se pulsó.
+pub(crate) fn segmentos(ui: &mut egui::Ui, opciones: &[String], elegida: usize, t: &crate::theme::Tokens) -> Option<usize> {
+    let mut pulsada = None;
+    egui::Frame::NONE.fill(t.field_bg).stroke(egui::Stroke::new(1.0, t.field_border)).corner_radius(7.0).inner_margin(2).show(ui, |ui| {
+        ui.spacing_mut().item_spacing.x = 2.0;
+        #[allow(clippy::cast_precision_loss)]
+        let n = opciones.len().max(1) as f32;
+        let w = ((ui.available_width() - 2.0 * (n - 1.0)) / n).max(20.0);
+        ui.horizontal(|ui| {
+            for (i, o) in opciones.iter().enumerate() {
+                let on = i == elegida;
+                let texto = RichText::new(o.as_str()).color(if on { Color32::WHITE } else { t.text_dim });
+                let fondo = if on { ACENTO.gamma_multiply(0.55) } else { Color32::TRANSPARENT };
+                let b = egui::Button::new(texto).fill(fondo).frame_when_inactive(on).min_size(egui::vec2(w, 22.0)).corner_radius(5.0);
+                if ui.add(b).clicked() {
+                    pulsada = Some(i);
+                }
+            }
+        });
+    });
+    pulsada
+}
+
+/// Una fila de Ajustes: etiqueta a la izquierda, control a la derecha.
+fn fila<R>(ui: &mut egui::Ui, etiqueta: &str, t: &crate::theme::Tokens, control: impl FnOnce(&mut egui::Ui) -> R) -> R {
+    ui.horizontal(|ui| {
+        ui.allocate_ui_with_layout(egui::vec2(ETIQUETA, 24.0), egui::Layout::left_to_right(egui::Align::Center), |ui| {
+            ui.set_min_width(ETIQUETA);
+            ui.label(RichText::new(etiqueta).color(t.text_dim));
+        });
+        control(ui)
+    })
+    .inner
+}
