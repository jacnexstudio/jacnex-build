+use std::sync::Arc;
+
+use serde_json::json;
+
+use crate::Session;
+use crate::dub::{self, Original, Phrase, RATE};
+use filmcraft_project::{ClipId, ItemId, Transcript, Word};
+use filmcraft_speech::FixedTranscriber;
+use filmcraft_time::Tick;
+
+fn tone(secs: f64, amp: f32) -> Vec<f32> {
+    (0..(secs * f64::from(RATE)) as usize).map(|i| amp * ((i as f32) * 0.05).sin()).collect()
+}
+
+fn phrase(start: f64, end: f64, secs: f64) -> Phrase {
+    Phrase { start, end, pcm: tone(secs, 0.5) }
+}
+
+fn energy(v: &[f32], from: f64, to: f64) -> f32 {
+    let a = (from * f64::from(RATE)) as usize;
+    let b = ((to * f64::from(RATE)) as usize).min(v.len());
+    v[a.min(b)..b].iter().map(|x| x.abs()).sum()
+}
+
+/// The demo project with the first A1 clip transcribed ("Hola mundo." then "Otra frase.").
+fn session() -> (Session, ClipId, Tick) {
+    let mut s = Session::default();
+    s.execute("file.openDemoProject", json!({})).unwrap();
+    let q = s.active_sequence().unwrap();
+    let a = &q.audio_tracks[0].items[0];
+    let (item, sin, clip, start) = (a.item, a.source_in, a.id, a.start);
+    let sec = |x: f64| sin + Tick::from_seconds_f64(x);
+    let mut t = Transcript { language: "es".into(), ..Default::default() };
+    for (text, a, b) in [("Hola", 0.2, 0.5), ("mundo.", 0.6, 1.0), ("Otra", 2.6, 3.0), ("frase.", 3.0, 3.5)] {
+        t.words.push(Word::new(text, sec(a), sec(b)));
+    }
+    t.normalize();
+    s.transcriber = Some(Arc::new(FixedTranscriber { transcript: t, id: "fixed".into() }));
+    s.execute("transcript.generate", json!({"items": [item.0]})).unwrap();
+    (s, clip, start)
+}
+
+#[test]
+fn mix_keeps_each_phrase_at_its_time() {
+    let (out, fit) = dub::mix(&[phrase(1.0, 2.0, 0.8), phrase(3.0, 4.0, 0.9)], 5.0);
+    assert_eq!(out.len(), 5 * RATE as usize);
+    assert_eq!(fit, dub::Fit { placed: 2, sped_up: 0, trimmed: 0 });
+    assert!(energy(&out, 0.0, 0.95) == 0.0, "silence before the first phrase");
+    assert!(energy(&out, 1.1, 1.7) > 100.0);
+    assert!(energy(&out, 2.0, 2.9) == 0.0, "silence between phrases");
+    assert!(energy(&out, 3.1, 3.8) > 100.0);
+    assert!(out.iter().all(|v| v.abs() <= 1.0));
+}
+
+#[test]
+fn mix_runs_into_the_gap_then_speeds_up_then_trims() {
+    // 1.5 s of voice for a 1 s phrase with 3 s free before the next: it just runs on
+    let (out, fit) = dub::mix(&[phrase(0.0, 1.0, 1.5), phrase(4.0, 5.0, 0.5)], 6.0);
+    assert_eq!(fit.sped_up, 0);
+    assert!(energy(&out, 1.2, 1.4) > 10.0);
+    // 2 s of voice with 1.8 s before the next phrase: faster (x1.11), no cut
+    let (out, fit) = dub::mix(&[phrase(0.0, 1.0, 2.0), phrase(1.8, 2.5, 0.5)], 3.0);
+    assert_eq!((fit.sped_up, fit.trimmed), (1, 0));
+    assert!(energy(&out, 1.6, 1.78) > 10.0, "it now ends right before the next phrase");
+    // 3 s of voice in 1 s: more than x1.25, so the end is cut
+    let (out, fit) = dub::mix(&[phrase(0.0, 1.0, 3.0), phrase(1.0, 2.0, 0.5)], 2.0);
+    assert_eq!((fit.sped_up, fit.trimmed), (1, 1));
+    assert!(out.iter().all(|v| v.abs() <= 1.0));
+}
+
+#[test]
+fn mix_survives_hostile_input() {
+    let bad = vec![
+        Phrase { start: f64::NAN, end: 1.0, pcm: vec![0.5; 10] },
+        Phrase { start: -5.0, end: 1.0, pcm: vec![f32::NAN, f32::INFINITY, 2.0] },
+        Phrase { start: 1e18, end: 1e19, pcm: vec![0.5; 10] },
+        Phrase { start: 0.5, end: 0.4, pcm: Vec::new() },
+    ];
+    let (out, _) = dub::mix(&bad, 1.0);
+    assert_eq!(out.len(), RATE as usize);
+    assert_eq!(dub::mix(&bad, f64::NAN).0.len(), 0);
+    assert_eq!(dub::mix(&bad, 1e12).0.len(), (dub::MAX_TOTAL_SECONDS * f64::from(RATE)) as usize);
+    let many: Vec<Phrase> = (0..5000).map(|i| phrase(f64::from(i) * 0.001, 1.0, 0.001)).collect();
+    assert!(dub::mix(&many, 6.0).1.placed <= dub::MAX_PHRASES);
+}
+
+#[test]
+fn decode_voice_reads_audio_and_rejects_garbage() {
+    let wav = crate::voiceover::write_wav_f32(&tone(1.0, 0.4), 48_000); // 0.5 s at 48 kHz
+    let pcm = dub::decode_voice("voz.wav", wav).unwrap();
+    assert!((pcm.len() as i64 - (RATE / 2) as i64).abs() < 64, "{}", pcm.len());
+    assert!(pcm.iter().any(|v| v.abs() > 0.1) && pcm.iter().all(|v| v.is_finite() && v.abs() <= 1.0));
+    assert!(dub::decode_voice("voz.mp3", Vec::new()).is_err());
+    assert!(dub::decode_voice("voz.mp3", b"no es un mp3".to_vec()).is_err());
+    assert!(dub::decode_voice("voz.mp3", vec![0xFF; 4096]).is_err());
+    assert!(dub::decode_voice("voz.mp3", vec![0; dub::MAX_MP3_BYTES + 1]).is_err());
+    let largo = crate::voiceover::write_wav_f32(&vec![0.1; (RATE as usize) * 130], RATE);
+    assert!(dub::decode_voice("voz.wav", largo).is_err(), "longer than MAX_VOICE_SECONDS");
+}
+
+#[test]
+fn scope_finds_the_words_and_clips() {
+    let (mut s, clip, start) = session();
+    let all = dub::dub_scope(&s);
+    assert_eq!(all.words.len(), 4);
+    assert_eq!(all.clips, vec![clip]);
+    assert_eq!(all.start, start);
+    assert!(all.seconds > 1.0);
+    // a selection that has no transcribed audio leaves nothing to dub
+    let other = s.active_sequence().unwrap().audio_tracks.iter().flat_map(|t| t.items.iter()).map(|i| i.id).find(|c| *c != clip);
+    s.state.selection = other.into_iter().collect();
+    if other.is_some() {
+        assert!(dub::dub_scope(&s).words.is_empty());
+    }
+    s.state.selection = vec![clip];
+    assert_eq!(dub::dub_scope(&s).words.len(), 4);
+}
