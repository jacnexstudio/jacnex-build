new file mode 100644
index 0000000..68cb4e9
--- /dev/null
+++ b/crates/reframe/src/lightasd.rs
@@ -0,0 +1,216 @@
+//! Light-ASD active-speaker detector on candle: says, for a track of face crops and the audio
+//! that goes with them, in which frames that face is the one talking.
+//!
+//! About one million parameters: a visual encoder over 112x112 gray mouth-and-face crops, an audio
+//! encoder over MFCC, a sum of both, a bidirectional GRU and a linear layer. Batch-norm layers
+//! are folded into the convolutions when the model file is made. Input is 25 face crops a second
+//! and 100 MFCC frames a second (4 per video frame).
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use candle_core::{Device, Tensor};
+
+use crate::mfcc::NUM_CEP;
+use crate::nn::{Conv, get, load_weights, net, to_vec};
+use crate::{ReframeError, Result};
+
+/// The file the model is read from, inside its folder.
+pub const FILE: &str = "model.safetensors";
+/// The model folder name under the Jacnex models directory.
+pub const MODEL_ID: &str = "reframe-lightasd-ava";
+/// Side of the square gray face crop the visual encoder takes.
+pub const CROP: usize = 112;
+/// The most video frames scored in one call (30 s at 25 fps).
+pub const MAX_FRAMES: usize = 750;
+const HID: usize = 128;
+const MEAN: f32 = 0.4161;
+const STD: f32 = 0.1688;
+
+struct Block {
+    s3: Conv,
+    t3: Conv,
+    s5: Conv,
+    t5: Conv,
+    last: Conv,
+}
+
+struct Gru {
+    wih: Vec<f32>,
+    whh: Vec<f32>,
+    bih: Vec<f32>,
+    bhh: Vec<f32>,
+}
+
+/// The loaded detector.
+pub struct LightAsd {
+    visual: Vec<Block>,
+    audio: Vec<Block>,
+    gru_f: Gru,
+    gru_b: Gru,
+    fc_w: Vec<f32>,
+    fc_b: Vec<f32>,
+}
+
+fn conv(w: &HashMap<String, Tensor>, name: &str, pad: (usize, usize), stride: usize) -> Result<Conv> {
+    Ok(Conv { w: get(w, &format!("{name}.weight"))?.clone(), b: Some(get(w, &format!("{name}.bias"))?.clone()), pad, stride, groups: 1 })
+}
+
+fn vec_of(w: &HashMap<String, Tensor>, name: &str, len: usize) -> Result<Vec<f32>> {
+    let v = to_vec(get(w, name)?)?;
+    if v.len() != len {
+        return Err(ReframeError::Model(format!("`{name}` has {} values, expected {len}", v.len())));
+    }
+    Ok(v)
+}
+
+fn gru(w: &HashMap<String, Tensor>, p: &str) -> Result<Gru> {
+    Ok(Gru {
+        wih: vec_of(w, &format!("{p}.wih"), 3 * HID * HID)?,
+        whh: vec_of(w, &format!("{p}.whh"), 3 * HID * HID)?,
+        bih: vec_of(w, &format!("{p}.bih"), 3 * HID)?,
+        bhh: vec_of(w, &format!("{p}.bhh"), 3 * HID)?,
+    })
+}
+
+fn sigmoid(v: f32) -> f32 {
+    1.0 / (1.0 + (-v).exp())
+}
+
+impl Gru {
+    /// Runs over `x` (T x 128, row-major) in order, returns every hidden state.
+    fn run(&self, x: &[f32], t: usize) -> Vec<f32> {
+        let mut h = vec![0f32; HID];
+        let mut out = Vec::with_capacity(t * HID);
+        let mut gi = vec![0f32; 3 * HID];
+        let mut gh = vec![0f32; 3 * HID];
+        for step in 0..t {
+            let xt = &x[step * HID..(step + 1) * HID];
+            for r in 0..3 * HID {
+                let wi = &self.wih[r * HID..(r + 1) * HID];
+                let wh = &self.whh[r * HID..(r + 1) * HID];
+                gi[r] = self.bih[r] + wi.iter().zip(xt).map(|(a, b)| a * b).sum::<f32>();
+                gh[r] = self.bhh[r] + wh.iter().zip(&h).map(|(a, b)| a * b).sum::<f32>();
+            }
+            for j in 0..HID {
+                let r = sigmoid(gi[j] + gh[j]);
+                let z = sigmoid(gi[HID + j] + gh[HID + j]);
+                let n = (gi[2 * HID + j] + r * gh[2 * HID + j]).tanh();
+                h[j] = (1.0 - z) * n + z * h[j];
+            }
+            out.extend_from_slice(&h);
+        }
+        out
+    }
+}
+
+impl LightAsd {
+    /// Loads the detector from `dir/model.safetensors`.
+    pub fn load(dir: &Path) -> Result<Self> {
+        let w = load_weights(dir, FILE)?;
+        let mut visual = Vec::new();
+        let mut audio = Vec::new();
+        for b in 1..=3 {
+            let v = |n: &str, pad: (usize, usize), stride: usize| conv(&w, &format!("visual.block{b}.{n}"), pad, stride);
+            let down = if b == 1 { 2 } else { 1 };
+            visual.push(Block {
+                s3: v("s_3", (1, 1), down)?,
+                t3: v("t_3", (1, 0), 1)?,
+                s5: v("s_5", (2, 2), down)?,
+                t5: v("t_5", (2, 0), 1)?,
+                last: v("last", (0, 0), 1)?,
+            });
+            let a = |n: &str, pad: (usize, usize)| conv(&w, &format!("audio.block{b}.{n}"), pad, 1);
+            audio.push(Block { s3: a("m_3", (1, 0))?, t3: a("t_3", (0, 1))?, s5: a("m_5", (2, 0))?, t5: a("t_5", (0, 2))?, last: a("last", (0, 0))? });
+        }
+        Ok(Self { visual, audio, gru_f: gru(&w, "gru_f")?, gru_b: gru(&w, "gru_b")?, fc_w: vec_of(&w, "fc.weight", 2 * HID)?, fc_b: vec_of(&w, "fc.bias", 2)? })
+    }
+
+    /// Scores `t` video frames: `faces` is `t` crops of 112x112 gray values (0..255), `mfcc` is
+    /// `4 * t` frames of 13 coefficients. Higher means "this face is speaking"; above 0 is the
+    /// model's own "yes".
+    pub fn score(&self, faces: &[f32], mfcc: &[f32], t: usize) -> Result<Vec<f32>> {
+        if t == 0 || t > MAX_FRAMES || faces.len() != t * CROP * CROP || mfcc.len() != 4 * t * NUM_CEP {
+            return Err(ReframeError::Net("bad Light-ASD input size".into()));
+        }
+        self.score_inner(faces, mfcc, t).map_err(net)
+    }
+
+    fn pool_hw(x: &Tensor) -> candle_core::Result<Tensor> {
+        // 3x3 max-pool, stride 2, padding 1 (values are post-ReLU, so zero padding is exact)
+        x.pad_with_zeros(2, 1, 1)?.pad_with_zeros(3, 1, 1)?.max_pool2d_with_stride(3, 2)
+    }
+
+    fn pool_time(x: &Tensor) -> candle_core::Result<Tensor> {
+        x.pad_with_zeros(3, 1, 1)?.max_pool2d_with_stride((1, 3), (1, 2))
+    }
+
+    /// Light-ASD "Visual_Block" / "Audio_Block": two branches, each a conv then a conv, summed
+    /// and passed through a 1x1 conv. The "t" kernels run on the T axis of a (1, C, T, H*W)
+    /// layout (visual) or on the width (audio), depending on how the block was built.
+    fn block(b: &Block, x: &Tensor) -> candle_core::Result<Tensor> {
+        let x3 = b.t3.forward(&b.s3.forward(x)?.relu()?)?.relu()?;
+        let x5 = b.t5.forward(&b.s5.forward(x)?.relu()?)?.relu()?;
+        b.last.forward(&(x3 + x5)?)?.relu()
+    }
+
+    fn visual_embed(&self, faces: &[f32], t: usize) -> candle_core::Result<Tensor> {
+        let dev = Device::Cpu;
+        let norm: Vec<f32> = faces.iter().map(|v| (v / 255.0 - MEAN) / STD).collect();
+        // frames as a batch for the spatial convs; time convs run on (1, C, T, H*W)
+        let mut x = Tensor::from_vec(norm, (t, 1, CROP, CROP), &dev)?;
+        for (i, b) in self.visual.iter().enumerate() {
+            // spatial convs per frame (kernel 1xkxk), then temporal convs across frames
+            let sp3 = b.s3.forward(&x)?.relu()?;
+            let sp5 = b.s5.forward(&x)?.relu()?;
+            let (c, h, w) = (sp3.dim(1)?, sp3.dim(2)?, sp3.dim(3)?);
+            let tm = |s: &Tensor, k: &Conv| -> candle_core::Result<Tensor> {
+                let z = s.permute((1, 0, 2, 3))?.reshape((1, c, t, h * w))?;
+                let z = k.forward(&z)?.relu()?;
+                z.reshape((c, t, h, w))?.permute((1, 0, 2, 3))
+            };
+            let y = (tm(&sp3, &b.t3)? + tm(&sp5, &b.t5)?)?;
+            x = b.last.forward(&y)?.relu()?;
+            if i < 2 {
+                x = Self::pool_hw(&x)?;
+            }
+        }
+        // adaptive max-pool to 1x1 -> (T, 128)
+        x.max(3)?.max(2)?.reshape((t, HID))
+    }
+
+    fn audio_embed(&self, mfcc: &[f32], t: usize) -> candle_core::Result<Tensor> {
+        let dev = Device::Cpu;
+        // (4T, 13) -> (1, 1, 13, 4T)
+        let m = Tensor::from_slice(mfcc, (4 * t, NUM_CEP), &dev)?.t()?.reshape((1, 1, NUM_CEP, 4 * t))?;
+        let mut x = m;
+        for (i, b) in self.audio.iter().enumerate() {
+            x = Self::block(b, &x)?;
+            if i < 2 {
+                x = Self::pool_time(&x)?;
+            }
+        }
+        // mean over the 13 axis -> (1, 128, T) -> (T, 128)
+        x.mean(2)?.reshape((HID, t))?.t()?.contiguous()
+    }
+
+    fn score_inner(&self, faces: &[f32], mfcc: &[f32], t: usize) -> candle_core::Result<Vec<f32>> {
+        let v = self.visual_embed(faces, t)?;
+        let a = self.audio_embed(mfcc, t)?;
+        let sum: Vec<f32> = (v + a)?.flatten_all()?.to_vec1()?;
+        let gelu = |v: Vec<f32>| -> candle_core::Result<Vec<f32>> { Tensor::from_vec(v, t * HID, &Device::Cpu)?.gelu_erf()?.to_vec1() };
+        let f = gelu(self.gru_f.run(&sum, t))?;
+        // backward GRU over the reversed sequence, then un-reversed
+        let mut rev = Vec::with_capacity(f.len());
+        for i in (0..t).rev() {
+            rev.extend_from_slice(&f[i * HID..(i + 1) * HID]);
+        }
+        let b = self.gru_b.run(&rev, t);
+        let mut un = Vec::with_capacity(b.len());
+        for i in (0..t).rev() {
+            un.extend_from_slice(&b[i * HID..(i + 1) * HID]);
+        }
+        let g = gelu(un)?;
+        Ok((0..t).map(|i| self.fc_b[1] + g[i * HID..(i + 1) * HID].iter().zip(&self.fc_w[HID..2 * HID]).map(|(a, b)| a * b).sum::<f32>()).collect())
+    }
+}
diff --git a/crates/reframe/src/mfcc.rs b/crates/reframe/src/mfcc.rs
new file mode 100644
index 0000000..b0d953a
--- /dev/null
+++ b/crates/reframe/src/mfcc.rs
@@ -0,0 +1,171 @@
+//! MFCC features the way Light-ASD expects them: the same numbers `python_speech_features.mfcc`
+//! gives for 16 kHz audio with 25 ms windows every 10 ms (13 coefficients, 26 mel filters,
+//! 512-point FFT, pre-emphasis 0.97, lifter 22, log-energy in coefficient 0).
+//!
+//! The model was trained on 16-bit PCM values, so the input is scaled to that range inside.
+
+use std::f64::consts::PI;
+
+/// Samples per second the features are computed at.
+pub const SAMPLE_RATE: usize = 16_000;
+/// Cepstral coefficients per frame.
+pub const NUM_CEP: usize = 13;
+const FRAME_LEN: usize = 400; // 25 ms
+const FRAME_STEP: usize = 160; // 10 ms
+const NFFT: usize = 512;
+const NFILT: usize = 26;
+const PREEMPH: f64 = 0.97;
+const LIFTER: f64 = 22.0;
+/// The most audio one call accepts (10 minutes), so a hostile length cannot exhaust memory.
+pub const MAX_SAMPLES: usize = SAMPLE_RATE * 600;
+
+/// In-place iterative radix-2 FFT (`re`/`im` lengths are equal powers of two).
+fn fft(re: &mut [f64], im: &mut [f64]) {
+    let n = re.len();
+    if n < 2 || !n.is_power_of_two() || im.len() != n {
+        return;
+    }
+    let mut j = 0usize;
+    for i in 1..n {
+        let mut bit = n >> 1;
+        while j & bit != 0 {
+            j ^= bit;
+            bit >>= 1;
+        }
+        j ^= bit;
+        if i < j {
+            re.swap(i, j);
+            im.swap(i, j);
+        }
+    }
+    let mut len = 2;
+    while len <= n {
+        let ang = -2.0 * PI / len as f64;
+        let (wr, wi) = (ang.cos(), ang.sin());
+        for start in (0..n).step_by(len) {
+            let (mut cr, mut ci) = (1.0f64, 0.0f64);
+            for k in 0..len / 2 {
+                let (a, b) = (start + k, start + k + len / 2);
+                let tr = re[b] * cr - im[b] * ci;
+                let ti = re[b] * ci + im[b] * cr;
+                re[b] = re[a] - tr;
+                im[b] = im[a] - ti;
+                re[a] += tr;
+                im[a] += ti;
+                let ncr = cr * wr - ci * wi;
+                ci = cr * wi + ci * wr;
+                cr = ncr;
+            }
+        }
+        len <<= 1;
+    }
+}
+
+fn hz2mel(hz: f64) -> f64 {
+    2595.0 * (1.0 + hz / 700.0).log10()
+}
+
+fn mel2hz(mel: f64) -> f64 {
+    700.0 * (10f64.powf(mel / 2595.0) - 1.0)
+}
+
+/// The mel filter bank as (first bin, weights) per filter.
+fn filterbank() -> Vec<(usize, Vec<f64>)> {
+    let (lo, hi) = (hz2mel(0.0), hz2mel(SAMPLE_RATE as f64 / 2.0));
+    let bins: Vec<f64> =
+        (0..NFILT + 2).map(|i| (((NFFT + 1) as f64) * mel2hz(lo + (hi - lo) * i as f64 / (NFILT + 1) as f64) / SAMPLE_RATE as f64).floor()).collect();
+    (0..NFILT)
+        .map(|j| {
+            let (b0, b1, b2) = (bins[j] as usize, bins[j + 1] as usize, bins[j + 2] as usize);
+            let mut w = Vec::with_capacity(b2.saturating_sub(b0));
+            for i in b0..b1 {
+                w.push((i as f64 - bins[j]) / (bins[j + 1] - bins[j]));
+            }
+            for i in b1..b2 {
+                w.push((bins[j + 2] - i as f64) / (bins[j + 2] - bins[j + 1]));
+            }
+            (b0, w)
+        })
+        .collect()
+}
+
+/// MFCC frames (row-major, `NUM_CEP` values per frame) of mono 16 kHz audio in -1..1.
+/// Gives `1 + ceil((n - 400) / 160)` frames (1 for very short audio); empty input gives none.
+pub fn mfcc(samples: &[f32]) -> Vec<f32> {
+    let samples = &samples[..samples.len().min(MAX_SAMPLES)];
+    if samples.is_empty() {
+        return Vec::new();
+    }
+    // 16-bit PCM scale, pre-emphasis
+    let x: Vec<f64> = samples.iter().map(|&s| (s as f64 * 32768.0).clamp(-32768.0, 32768.0)).collect();
+    let mut pre = Vec::with_capacity(x.len());
+    pre.push(x[0]);
+    for i in 1..x.len() {
+        pre.push(x[i] - PREEMPH * x[i - 1]);
+    }
+    let frames = if pre.len() <= FRAME_LEN { 1 } else { 1 + (pre.len() - FRAME_LEN).div_ceil(FRAME_STEP) };
+    let fb = filterbank();
+    let lift: Vec<f64> = (0..NUM_CEP).map(|n| 1.0 + (LIFTER / 2.0) * (PI * n as f64 / LIFTER).sin()).collect();
+    // DCT-II (orthonormal) matrix NUM_CEP x NFILT
+    let dct: Vec<Vec<f64>> = (0..NUM_CEP)
+        .map(|k| {
+            let scale = if k == 0 { (1.0 / NFILT as f64).sqrt() } else { (2.0 / NFILT as f64).sqrt() };
+            (0..NFILT).map(|n| scale * (PI * k as f64 * (2.0 * n as f64 + 1.0) / (2.0 * NFILT as f64)).cos()).collect()
+        })
+        .collect();
+    let eps = f64::EPSILON;
+    let mut out = Vec::with_capacity(frames * NUM_CEP);
+    let (mut re, mut im) = (vec![0f64; NFFT], vec![0f64; NFFT]);
+    for f in 0..frames {
+        re.iter_mut().for_each(|v| *v = 0.0);
+        im.iter_mut().for_each(|v| *v = 0.0);
+        let start = f * FRAME_STEP;
+        for i in 0..FRAME_LEN {
+            re[i] = pre.get(start + i).copied().unwrap_or(0.0);
+        }
+        fft(&mut re, &mut im);
+        let pspec: Vec<f64> = (0..=NFFT / 2).map(|k| (re[k] * re[k] + im[k] * im[k]) / NFFT as f64).collect();
+        let energy = pspec.iter().sum::<f64>();
+        let energy = if energy == 0.0 { eps } else { energy };
+        let logfb: Vec<f64> = fb
+            .iter()
+            .map(|(b0, w)| {
+                let e: f64 = w.iter().enumerate().map(|(i, wt)| wt * pspec.get(b0 + i).copied().unwrap_or(0.0)).sum();
+                (if e == 0.0 { eps } else { e }).ln()
+            })
+            .collect();
+        for (k, row) in dct.iter().enumerate() {
+            let c: f64 = row.iter().zip(&logfb).map(|(a, b)| a * b).sum::<f64>() * lift[k];
+            out.push(if k == 0 { energy.ln() as f32 } else { c as f32 });
+        }
+    }
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fft_of_a_cosine_has_one_peak() {
+        let n = 64;
+        let mut re: Vec<f64> = (0..n).map(|i| (2.0 * PI * 5.0 * i as f64 / n as f64).cos()).collect();
+        let mut im = vec![0.0; n];
+        fft(&mut re, &mut im);
+        let mag: Vec<f64> = re.iter().zip(&im).map(|(a, b)| a.hypot(*b)).collect();
+        assert!((mag[5] - 32.0).abs() < 1e-9 && mag[3] < 1e-9);
+    }
+
+    #[test]
+    fn frame_count_matches_the_reference() {
+        assert!(mfcc(&[]).is_empty());
+        assert_eq!(mfcc(&[0.0; 100]).len(), NUM_CEP);
+        // 1 s of audio: 1 + ceil((16000-400)/160) = 99 frames
+        assert_eq!(mfcc(&vec![0.01; 16000]).len(), 99 * NUM_CEP);
+    }
+
+    #[test]
+    fn silence_is_finite() {
+        assert!(mfcc(&vec![0.0; 4000]).iter().all(|v| v.is_finite()));
+    }
+}
diff --git a/crates/reframe/src/nn.rs b/crates/reframe/src/nn.rs
new file mode 100644
index 0000000..4038f1d
--- /dev/null
+++ b/crates/reframe/src/nn.rs
@@ -0,0 +1,64 @@
+//! Small helpers shared by the networks.
+
+use std::collections::HashMap;
+use std::path::Path;
+
+use candle_core::{DType, Device, Tensor};
+
+use crate::{ReframeError, Result};
+
+/// The largest weight file read (the biggest model is about 300 MB; this refuses a hostile file).
+pub const MAX_WEIGHTS: u64 = 1 << 30;
+
+pub fn net<E: std::fmt::Display>(e: E) -> ReframeError {
+    ReframeError::Net(e.to_string())
+}
+
+/// Reads the tensors of `dir/name`.
+pub fn load_weights(dir: &Path, name: &str) -> Result<HashMap<String, Tensor>> {
+    let path = dir.join(name);
+    let bad = |e: &dyn std::fmt::Display| ReframeError::Model(format!("{}: {e}", path.display()));
+    let len = std::fs::metadata(&path).map_err(|e| bad(&e))?.len();
+    if len > MAX_WEIGHTS {
+        return Err(bad(&"too big"));
+    }
+    let bytes = std::fs::read(&path).map_err(|e| bad(&e))?;
+    let st = candle_core::safetensors::load_buffer(&bytes, &Device::Cpu).map_err(|e| bad(&e))?;
+    Ok(st.into_iter().map(|(k, v)| (k, v.to_dtype(DType::F32).unwrap_or(v))).collect())
+}
+
+/// A weight by name.
+pub fn get<'a>(w: &'a HashMap<String, Tensor>, name: &str) -> Result<&'a Tensor> {
+    w.get(name).ok_or_else(|| ReframeError::Model(format!("missing weight `{name}`")))
+}
+
+/// A convolution: weight (O, I/groups, kh, kw) and bias.
+#[derive(Clone)]
+pub struct Conv {
+    pub w: Tensor,
+    pub b: Option<Tensor>,
+    /// Padding (rows, columns).
+    pub pad: (usize, usize),
+    pub stride: usize,
+    pub groups: usize,
+}
+
+impl Conv {
+    pub fn forward(&self, x: &Tensor) -> candle_core::Result<Tensor> {
+        // candle's conv2d takes one padding value; non-square padding is applied beforehand
+        let (x, p) = if self.pad.0 != self.pad.1 {
+            (x.pad_with_zeros(2, self.pad.0, self.pad.0)?.pad_with_zeros(3, self.pad.1, self.pad.1)?, 0)
+        } else {
+            (x.clone(), self.pad.0)
+        };
+        let y = x.conv2d(&self.w, p, self.stride, 1, self.groups)?;
+        match &self.b {
+            Some(b) => y.broadcast_add(&b.reshape((1, b.elem_count(), 1, 1))?),
+            None => Ok(y),
+        }
+    }
+}
+
+pub fn to_vec(t: &Tensor) -> Result<Vec<f32>> {
+    t.flatten_all().and_then(|t| t.to_vec1::<f32>()).map_err(net)
+}
diff --git a/crates/reframe/src/plan.rs b/crates/reframe/src/plan.rs
new file mode 100644
index 0000000..4e7b5ad
--- /dev/null
+++ b/crates/reframe/src/plan.rs
@@ -0,0 +1,388 @@
+//! The virtual camera. For every shot it picks who to keep in frame, then moves a crop window the
+//! way a camera operator would: it holds still while the subject stays near the middle (dead
+//! zone), eases into a move when the subject leaves it, never jumps inside a shot and starts
+//! every shot already on its subject (a cut is a hard re-target).
+//!
+//! The crop keeps the full height of the picture (or the full width for a very narrow source), so
+//! only its position moves; the output is a short list of keys (time, centre) in fractions of the
+//! source frame.
+
+use crate::Rect;
+use crate::track::Kind;
+
+/// A target shape.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Aspect {
+    pub w: u32,
+    pub h: u32,
+}
+
+impl Aspect {
+    pub const VERTICAL: Aspect = Aspect { w: 9, h: 16 };
+    pub const SQUARE: Aspect = Aspect { w: 1, h: 1 };
+    pub const PORTRAIT: Aspect = Aspect { w: 4, h: 5 };
+
+    /// The crop window as fractions of a `src_w` x `src_h` picture: (width, height).
+    pub fn crop(&self, src_w: f32, src_h: f32) -> (f32, f32) {
+        let at = self.w.max(1) as f32 / self.h.max(1) as f32;
+        let a_s = (src_w / src_h.max(1e-6)).max(1e-6);
+        if at <= a_s { ((at / a_s).clamp(0.01, 1.0), 1.0) } else { (1.0, (a_s / at).clamp(0.01, 1.0)) }
+    }
+}
+
+/// Something worth keeping in frame in one sample.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Subject {
+    /// Track id (stable across samples).
+    pub id: u32,
+    pub rect: Rect,
+    pub kind: Kind,
+    /// Probability that this subject is the one speaking (0.5 = unknown).
+    pub speaking: f32,
+}
+
+/// The subjects found at one moment.
+#[derive(Clone, Debug, Default)]
+pub struct Sample {
+    /// Seconds from the start of the clip.
+    pub t: f64,
+    pub subjects: Vec<Subject>,
+}
+
+/// One camera key: crop centre in fractions of the source picture.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct Key {
+    pub t: f64,
+    pub cx: f32,
+    pub cy: f32,
+}
+
+/// Tuning of the camera.
+#[derive(Clone, Copy, Debug)]
+pub struct Options {
+    /// Half-width of the dead zone, as a fraction of the crop width.
+    pub dead_zone: f32,
+    /// Seconds the camera takes to settle after the subject leaves the dead zone.
+    pub smooth_time: f32,
+    /// Fastest the camera may move, in crop widths per second.
+    pub max_speed: f32,
+    /// Seconds a challenger must stay better before the camera changes subject.
+    pub hold: f64,
+    /// Largest error kept when the path is reduced to keys, as a fraction of the crop width.
+    pub tolerance: f32,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Self { dead_zone: 0.12, smooth_time: 0.7, max_speed: 1.2, hold: 0.9, tolerance: 0.01 }
+    }
+}
+
+/// Simulation step and key sampling rate.
+const SIM_HZ: f64 = 30.0;
+const KEY_HZ: f64 = 10.0;
+/// Most simulation steps for one shot (about 9 hours at 30 Hz).
+const MAX_STEPS: usize = 1_000_000;
+
+/// The point of a subject the camera should centre on.
+fn focus(s: &Subject) -> (f32, f32) {
+    match s.kind {
+        Kind::Person => (s.rect.cx(), s.rect.y0 + 0.2 * s.rect.h()),
+        _ => (s.rect.cx(), s.rect.cy()),
+    }
+}
+
+fn score(s: &Subject) -> f32 {
+    let spk = ((s.speaking - 0.5) * 2.0).clamp(0.0, 1.0);
+    s.rect.area().max(1e-6).sqrt() * (1.0 + 3.0 * spk)
+}
+
+/// The subjects of the best kind present (faces, else people, else objects).
+fn best_kind(subs: &[Subject]) -> Vec<&Subject> {
+    let Some(k) = subs.iter().map(|s| s.kind).min() else { return Vec::new() };
+    subs.iter().filter(|s| s.kind == k).collect()
+}
+
+/// Per sample, the point the camera wants (None when nothing was found), with the hysteresis that
+/// stops it from hopping between people.
+fn targets(samples: &[Sample], crop_w: f32, o: &Options) -> Vec<Option<(f32, f32)>> {
+    let mut out = Vec::with_capacity(samples.len());
+    let mut cur: Option<u32> = None;
+    let mut cur_seen = f64::NEG_INFINITY;
+    let mut challenger: Option<(u32, f64)> = None;
+    for sm in samples {
+        let cands = best_kind(&sm.subjects);
+        let cur_here = cur.and_then(|c| cands.iter().find(|s| s.id == c).copied());
+        let best = cands.iter().copied().max_by(|a, b| score(a).partial_cmp(&score(b)).unwrap_or(std::cmp::Ordering::Equal));
+        match (cur_here, best) {
+            (_, None) => {}
+            (None, Some(b)) => {
+                // current subject gone: wait briefly (it may be a missed detection), then switch
+                if cur.is_none() || sm.t - cur_seen > 0.5 {
+                    cur = Some(b.id);
+                    challenger = None;
+                }
+            }
+            (Some(c), Some(b)) => {
+                cur_seen = sm.t;
+                if b.id != c.id && score(b) > 1.3 * score(c) {
+                    let since = match challenger {
+                        Some((id, t0)) if id == b.id => t0,
+                        _ => sm.t,
+                    };
+                    challenger = Some((b.id, since));
+                    if sm.t - since >= o.hold {
+                        cur = Some(b.id);
+                        challenger = None;
+                    }
+                } else {
+                    challenger = None;
+                }
+            }
+        }
+        let primary = cur.and_then(|c| cands.iter().find(|s| s.id == c).copied());
+        out.push(primary.map(|p| {
+            // nobody known to be speaking: keep everyone in frame when they fit
+            let quiet = cands.iter().all(|s| s.speaking < 0.7);
+            let (mut x0, mut x1, mut ys) = (p.rect.x0, p.rect.x1, focus(p).1);
+            if quiet && cands.len() > 1 {
+                let (mut ux0, mut ux1) = (x0, x1);
+                for s in &cands {
+                    ux0 = ux0.min(s.rect.x0);
+                    ux1 = ux1.max(s.rect.x1);
+                }
+                if ux1 - ux0 <= crop_w * 0.9 {
+                    (x0, x1) = (ux0, ux1);
+                    ys = cands.iter().map(|s| focus(s).1).sum::<f32>() / cands.len() as f32;
+                }
+            }
+            (0.5 * (x0 + x1), ys)
+        }));
+    }
+    out
+}
+
+/// Ramer-Douglas-Peucker on (t, x, y) with a vertical error limit, bounded.
+fn reduce(pts: &[Key], tol_x: f32, tol_y: f32) -> Vec<Key> {
+    if pts.len() <= 2 {
+        return pts.to_vec();
+    }
+    let mut keep = vec![false; pts.len()];
+    keep[0] = true;
+    keep[pts.len() - 1] = true;
+    let mut stack = vec![(0usize, pts.len() - 1)];
+    let mut guard = 0usize;
+    while let Some((a, b)) = stack.pop() {
+        guard += 1;
+        if guard > 4 * pts.len() + 16 || b <= a + 1 {
+            continue;
+        }
+        let (pa, pb) = (pts[a], pts[b]);
+        let span = (pb.t - pa.t).max(1e-9);
+        let (mut worst, mut wi) = (0.0f32, a);
+        for (i, p) in pts.iter().enumerate().take(b).skip(a + 1) {
+            let f = ((p.t - pa.t) / span) as f32;
+            let ex = (pa.cx + (pb.cx - pa.cx) * f - p.cx).abs() / tol_x.max(1e-6);
+            let ey = (pa.cy + (pb.cy - pa.cy) * f - p.cy).abs() / tol_y.max(1e-6);
+            let e = ex.max(ey);
+            if e > worst {
+                (worst, wi) = (e, i);
+            }
+        }
+        if worst > 1.0 {
+            keep[wi] = true;
+            stack.push((a, wi));
+            stack.push((wi, b));
+        }
+    }
+    pts.iter().zip(keep).filter(|(_, k)| *k).map(|(p, _)| *p).collect()
+}
+
+/// Critically damped follow (the "smooth damp" spring).
+fn smooth_damp(x: f32, target: f32, vel: &mut f32, smooth: f32, max_speed: f32, dt: f32) -> f32 {
+    let smooth = smooth.max(1e-3);
+    let omega = 2.0 / smooth;
+    let k = omega * dt;
+    let exp = 1.0 / (1.0 + k + 0.48 * k * k + 0.235 * k * k * k);
+    let max_change = max_speed * smooth;
+    let change = (x - target).clamp(-max_change, max_change);
+    let t = x - change;
+    let temp = (*vel + omega * change) * dt;
+    *vel = (*vel - omega * temp) * exp;
+    let mut out = t + (change + temp) * exp;
+    if (target - x > 0.0) == (out > target) {
+        out = target;
+        *vel = 0.0;
+    }
+    out
+}
+
+/// The camera keys for one shot `[start, end)` (seconds). `samples` may cover more than the shot;
+/// `crop` is the crop window size from [`Aspect::crop`]. Keys are in the same time base as the
+/// samples, always include the shot's first and last instant, and keep the crop inside the frame.
+pub fn plan_shot(samples: &[Sample], shot: (f64, f64), crop: (f32, f32), o: &Options) -> Vec<Key> {
+    let (start, end) = (shot.0, shot.1.max(shot.0));
+    let inside: Vec<Sample> = samples.iter().filter(|s| s.t >= start - 1e-9 && s.t < end).cloned().collect();
+    let (cw, ch) = (crop.0.clamp(0.01, 1.0), crop.1.clamp(0.01, 1.0));
+    let clampx = |x: f32| if cw >= 1.0 { 0.5 } else { x.clamp(cw / 2.0, 1.0 - cw / 2.0) };
+    let clampy = |y: f32| if ch >= 1.0 { 0.5 } else { y.clamp(ch / 2.0, 1.0 - ch / 2.0) };
+    let tg = targets(&inside, cw, o);
+    // fill gaps: hold the previous target, and the first known one backwards
+    let known: Vec<(f64, (f32, f32))> = inside.iter().zip(&tg).filter_map(|(s, t)| t.map(|t| (s.t, t))).collect();
+    if known.is_empty() {
+        let k = Key { t: start, cx: 0.5, cy: 0.5 };
+        return if end > start { vec![k, Key { t: end, ..k }] } else { vec![k] };
+    }
+    let at = |t: f64| -> (f32, f32) {
+        let i = known.partition_point(|k| k.0 <= t);
+        if i == 0 {
+            return known[0].1;
+        }
+        if i >= known.len() {
+            return known[known.len() - 1].1;
+        }
+        let (a, b) = (known[i - 1], known[i]);
+        let f = ((t - a.0) / (b.0 - a.0).max(1e-9)).clamp(0.0, 1.0) as f32;
+        (a.1.0 + (b.1.0 - a.1.0) * f, a.1.1 + (b.1.1 - a.1.1) * f)
+    };
+    // the camera starts on the subject: median of the first half second
+    let first: Vec<(f32, f32)> = known.iter().filter(|k| k.0 <= known[0].0 + 0.5).map(|k| k.1).collect();
+    let mid = |mut v: Vec<f32>| {
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap_or(std::cmp::Ordering::Equal));
+        v[v.len() / 2]
+    };
+    let (mut x, mut y) = (mid(first.iter().map(|p| p.0).collect()), mid(first.iter().map(|p| p.1).collect()));
+    let (mut vx, mut vy) = (0.0f32, 0.0f32);
+    let dt = 1.0 / SIM_HZ;
+    let steps = (((end - start) * SIM_HZ).ceil() as usize).clamp(1, MAX_STEPS);
+    let key_every = (SIM_HZ / KEY_HZ).round() as usize;
+    let mut path = Vec::new();
+    for n in 0..=steps {
+        let t = (start + n as f64 * dt).min(end);
+        if n > 0 {
+            let (tx, ty) = at(t);
+            let dz = o.dead_zone * cw;
+            let want_x = if tx > x + dz {
+                tx - dz
+            } else if tx < x - dz {
+                tx + dz
+            } else {
+                x
+            };
+            let dzy = o.dead_zone * ch;
+            let want_y = if ty > y + dzy {
+                ty - dzy
+            } else if ty < y - dzy {
+                ty + dzy
+            } else {
+                y
+            };
+            x = smooth_damp(x, clampx(want_x), &mut vx, o.smooth_time, o.max_speed * cw, dt as f32);
+            y = smooth_damp(y, clampy(want_y), &mut vy, o.smooth_time, o.max_speed * ch, dt as f32);
+        }
+        if n % key_every.max(1) == 0 || n == steps {
+            path.push(Key { t, cx: clampx(x), cy: clampy(y) });
+        }
+    }
+    reduce(&path, o.tolerance * cw, o.tolerance * ch)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn subj(id: u32, cx: f32, speaking: f32) -> Subject {
+        Subject { id, rect: Rect::new(cx - 0.05, 0.3, cx + 0.05, 0.5), kind: Kind::Face, speaking }
+    }
+
+    fn series(f: impl Fn(f64) -> Vec<Subject>, secs: f64) -> Vec<Sample> {
+        (0..(secs * 3.0) as usize).map(|i| Sample { t: i as f64 / 3.0, subjects: f(i as f64 / 3.0) }).collect()
+    }
+
+    fn pos(keys: &[Key], t: f64) -> f32 {
+        let i = keys.partition_point(|k| k.t <= t);
+        if i == 0 {
+            return keys[0].cx;
+        }
+        if i >= keys.len() {
+            return keys[keys.len() - 1].cx;
+        }
+        let (a, b) = (keys[i - 1], keys[i]);
+        a.cx + (b.cx - a.cx) * ((t - a.t) / (b.t - a.t)) as f32
+    }
+
+    #[test]
+    fn crop_sizes() {
+        let (w, h) = Aspect::VERTICAL.crop(1920.0, 1080.0);
+        assert!((w - 0.31640625).abs() < 1e-4 && h == 1.0);
+        let (w, h) = Aspect::SQUARE.crop(1080.0, 1920.0);
+        assert!(w == 1.0 && (h - 0.5625).abs() < 1e-4);
+    }
+
+    #[test]
+    fn jittering_subject_does_not_move_the_camera() {
+        let s = series(|t| vec![subj(0, 0.5 + 0.015 * ((t * 7.0).sin() as f32), 0.5)], 10.0);
+        let k = plan_shot(&s, (0.0, 10.0), (0.316, 1.0), &Options::default());
+        let (lo, hi) = k.iter().fold((1.0f32, 0.0f32), |a, k| (a.0.min(k.cx), a.1.max(k.cx)));
+        assert!(hi - lo < 0.02, "moved {lo}..{hi}");
+    }
+
+    #[test]
+    fn camera_follows_a_walking_subject_smoothly() {
+        let s = series(|t| vec![subj(0, 0.2 + 0.06 * t as f32, 0.5)], 10.0);
+        let k = plan_shot(&s, (0.0, 10.0), (0.316, 1.0), &Options::default());
+        assert!((k[0].cx - 0.2).abs() < 0.02, "starts on the subject");
+        let end = 0.2 + 0.06 * 9.6;
+        assert!((pos(&k, 9.9) - end).abs() < 0.12);
+        // never faster than the speed limit
+        for w in k.windows(2) {
+            assert!((w[1].cx - w[0].cx).abs() / (w[1].t - w[0].t) as f32 <= 1.2 * 0.316 + 1e-3);
+        }
+        assert!(k.len() < 40, "keys are reduced: {}", k.len());
+    }
+
+    #[test]
+    fn each_shot_starts_on_its_subject() {
+        let s = series(|t| vec![subj(if t < 5.0 { 0 } else { 1 }, if t < 5.0 { 0.2 } else { 0.8 }, 0.5)], 10.0);
+        let a = plan_shot(&s, (0.0, 5.0), (0.316, 1.0), &Options::default());
+        let b = plan_shot(&s, (5.0, 10.0), (0.316, 1.0), &Options::default());
+        assert!((a[0].cx - 0.2).abs() < 0.02 && (b[0].cx - 0.8).abs() < 0.02);
+        assert!(a.iter().all(|k| k.t < 5.0 + 1e-6) && b[0].t >= 5.0 - 1e-6);
+    }
+
+    #[test]
+    fn the_camera_goes_to_the_one_speaking() {
+        // two people far apart; from 4 s on the right one talks
+        let s = series(|t| vec![subj(0, 0.15, if t < 4.0 { 0.9 } else { 0.1 }), subj(1, 0.85, if t < 4.0 { 0.1 } else { 0.95 })], 12.0);
+        let k = plan_shot(&s, (0.0, 12.0), (0.316, 1.0), &Options::default());
+        assert!(pos(&k, 2.0) < 0.3, "on the first speaker");
+        assert!(pos(&k, 11.0) > 0.7, "on the second speaker");
+        // it did not go there before the hold time passed
+        assert!(pos(&k, 4.3) < 0.5);
+    }
+
+    #[test]
+    fn two_close_people_are_framed_together() {
+        let s = series(|_| vec![subj(0, 0.4, 0.5), subj(1, 0.55, 0.5)], 4.0);
+        let k = plan_shot(&s, (0.0, 4.0), (0.316, 1.0), &Options::default());
+        assert!((k[0].cx - 0.475).abs() < 0.03);
+    }
+
+    #[test]
+    fn nothing_found_gives_the_centre_and_edges_are_respected() {
+        let k = plan_shot(&[], (0.0, 3.0), (0.316, 1.0), &Options::default());
+        assert_eq!(k.len(), 2);
+        assert!(k.iter().all(|k| k.cx == 0.5));
+        let s = series(|_| vec![subj(0, 0.02, 0.5)], 3.0);
+        let k = plan_shot(&s, (0.0, 3.0), (0.316, 1.0), &Options::default());
+        assert!(k.iter().all(|k| k.cx >= 0.158 - 1e-6));
+    }
+
+    #[test]
+    fn people_are_the_fallback_when_there_are_no_faces() {
+        let p = Subject { id: 5, rect: Rect::new(0.6, 0.1, 0.8, 0.9), kind: Kind::Person, speaking: 0.5 };
+        let s = series(|_| vec![p], 3.0);
+        let k = plan_shot(&s, (0.0, 3.0), (0.316, 1.0), &Options::default());
+        assert!((k[0].cx - 0.7).abs() < 0.02);
+    }
+}
