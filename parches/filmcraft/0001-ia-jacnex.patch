+fn herramientas_base() -> Vec<Herramienta> {
+    HERRAMIENTAS_BASE
+        .iter()
+        .map(|(id, nombre, familia, idioma)| Herramienta {
+            id: (*id).into(),
+            nombre: (*nombre).into(),
+            familia: (*familia).into(),
+            idioma: *idioma,
+            duracion: (*familia == "suno-musica").then_some((10, 360)),
+            max_segundos: if *familia == "kie-reframe" { 10 } else { 60 },
+            max_megas: if *familia == "kie-reframe" { 100 } else { 50 },
+            por_segundo: if *familia == "kie-reframe" {
+                vec![("720p".into(), 0), ("1080p".into(), 0)]
+            } else {
