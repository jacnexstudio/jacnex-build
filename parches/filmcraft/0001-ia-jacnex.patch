+/// El catálogo de `/v1/jacnex/estado` (los modelos de video están en `videos`).
+fn leer_info(v: &Value) -> Info {
+    let videos = v
+        .get("videos")
+        .and_then(Value::as_array)
+        .map(|lista| {
+            lista
+                .iter()
+                .filter_map(|m| {
+                    let s = |k: &str| m.get(k).and_then(Value::as_str).unwrap_or("").to_string();
+                    let id = s("id");
+                    if id.is_empty() {
+                        return None;
+                    }
+                    let (proveedor, nombre) = (s("proveedor"), s("nombre"));
+                    let nombre = if proveedor.is_empty() { nombre } else { format!("{proveedor} {nombre}") };
+                    let aspectos = m
+                        .get("aspectos")
+                        .and_then(Value::as_array)
+                        .map(|a| a.iter().filter_map(Value::as_str).filter(|a| a.contains(':')).map(str::to_string).collect())
+                        .unwrap_or_default();
+                    let mut duraciones: Vec<u32> = m
+                        .get("duraciones")
+                        .and_then(Value::as_array)
+                        .map(|a| a.iter().filter_map(|d| d.as_u64().and_then(|d| u32::try_from(d).ok())).collect())
+                        .unwrap_or_default();
+                    duraciones.sort_unstable();
+                    duraciones.dedup();
+                    let flag = |k: &str| m.get(k).and_then(Value::as_bool).unwrap_or(false);
+                    Some(ModeloInfo {
+                        id,
+                        nombre,
+                        descripcion: s("descripcion"),
+                        aspectos,
+                        duraciones,
+                        imagen_final: flag("imagenFinal"),
+                        sonido_opcional: flag("sonidoOpcional"),
+                        creditos: por_duracion(m.get("creditos")),
+                        con_sonido: por_duracion(m.get("creditosConSonido")),
+                    })
+                })
+                .collect()
+        })
+        .unwrap_or_default();
+    let herramientas = ["audios", "mejoras"]
+        .iter()
+        .filter_map(|k| v.get(*k).and_then(Value::as_array))
+        .flat_map(|a| a.iter().take(MAX_LISTA))
+        .filter_map(leer_herramienta)
+        .collect();
+    let transcripciones =
+        v.get("transcripciones").and_then(Value::as_array).map_or_else(Vec::new, |a| a.iter().take(MAX_LISTA).filter_map(leer_motor_nube).collect());
+    let cortas = v.get("cortas").and_then(Value::as_array).map_or_else(Vec::new, |a| a.iter().take(MAX_LISTA).filter_map(leer_busqueda).collect());
+    let busquedas = v.get("busquedas").and_then(Value::as_array).map_or_else(Vec::new, |a| a.iter().take(MAX_LISTA).filter_map(leer_busqueda).collect());
+    Info {
+        nombre: v.get("nombre").and_then(Value::as_str).unwrap_or("").to_string(),
+        creditos: v.get("creditos").and_then(Value::as_i64).unwrap_or(0),
+        videos,
+        herramientas,
+        transcripciones,
+        busquedas,
+        cortas,
+        doblajes: v
+            .get("doblajes")
+            .and_then(Value::as_array)
+            .map_or_else(Vec::new, |a| a.iter().take(MAX_LISTA).filter_map(crate::jacnex_doblaje::leer).collect()),
+    }
+}
