+/// Jacnex: los ajustes de «Vertical»: la forma, el motor y lo propio de cada motor.
+fn ajustes_vertical(ui: &mut egui::Ui, e: &mut Estado, t: &crate::theme::Tokens) {
+    use crate::jacnex_vertical::{ASPECTOS, MAX_NUBE, MOTORES};
+    let ocupado = e.vertical.ocupado();
+    fila(ui, "Forma", t, |ui| {
+        let nombres: Vec<String> = ASPECTOS.iter().map(|(_, n)| (*n).to_string()).collect();
+        let elegida = ASPECTOS.iter().position(|(id, _)| *id == e.vertical.aspecto_id()).unwrap_or(0);
+        if let Some(i) = segmentos(ui, &nombres, elegida, t)
+            && let Some((id, _)) = ASPECTOS.get(i)
+            && !ocupado
+        {
+            e.vertical.aspecto = (*id).to_string();
+        }
+    });
+    fila(ui, "Motor", t, |ui| {
+        let nombres: Vec<String> = MOTORES.iter().map(|(_, n)| (*n).to_string()).collect();
+        let elegido = MOTORES.iter().position(|(id, _)| *id == e.vertical.motor_id()).unwrap_or(0);
+        if let Some(i) = segmentos(ui, &nombres, elegido, t)
+            && let Some((id, _)) = MOTORES.get(i)
+            && !ocupado
+        {
+            e.vertical.motor = (*id).to_string();
+        }
+    });
+    if e.vertical.en_nube() {
+        fila(ui, "Calidad", t, |ui| {
+            let nombres = ["720p".to_string(), "1080p".to_string()];
+            if let Some(i) = segmentos(ui, &nombres, usize::from(e.vertical.alta), t) {
+                e.vertical.alta = i == 1;
+            }
+        });
+        let por =
+            e.herramienta_actual().and_then(|h| h.por_segundo.iter().find(|(r, _)| r == e.vertical.resolucion_nube()).map(|(_, c)| *c)).filter(|c| *c > 0);
+        if let Some(c) = por {
+            #[allow(clippy::cast_precision_loss)]
+            let texto = format!("{:.0} créditos por segundo de clip.", c as f64 / 100.0);
+            ui.label(RichText::new(texto).small().color(t.text_dim));
+        }
+        ui.label(RichText::new(format!("Clips de hasta {MAX_NUBE:.0} s.")).small().color(t.text_dim));
+    }
+}
