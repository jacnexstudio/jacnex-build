+#[test]
+fn capture_mixes_only_the_dubbed_clips() {
+    let (s, clip, start) = session();
+    let seq = s.state.active_sequence.unwrap();
+    let cap = dub::capture(&s, seq, &[clip], start, 1.0).unwrap();
+    let stop = std::sync::atomic::AtomicBool::new(false);
+    let mut last = 0.0;
+    let pcm = cap.render(&stop, &mut |p| last = p).expect("rendered");
+    assert_eq!(pcm.len(), cap.rate as usize * 2, "one second of stereo");
+    assert!((last - 1.0).abs() < 1e-3);
+    assert!(pcm.iter().all(|v| v.is_finite()));
+    // stopped: nothing
+    stop.store(true, std::sync::atomic::Ordering::Relaxed);
+    assert!(cap.render(&stop, &mut |_| {}).is_none());
+    // hostile ranges
+    for secs in [0.0, -1.0, f64::NAN, f64::INFINITY, dub::MAX_SEPARATE_SECONDS + 1.0] {
+        assert!(dub::capture(&s, seq, &[clip], start, secs).is_err(), "{secs}");
+    }
+    assert!(dub::capture(&s, ItemId(u64::MAX), &[clip], start, 1.0).is_err());
+    // the real separator: available only when Jacnex Studio installed its model
+    assert_eq!(dub::separator().available(), crate::separate::separator_available());
+}
