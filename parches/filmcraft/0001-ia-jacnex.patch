+//! Compares the Rust YuNet with onnxruntime outputs dumped by a script. Runs only when
+//! `REFRAME_CHECK_DIR` (the dumped files) and the model are present.
+#![cfg(feature = "candle")]
+
+use std::path::PathBuf;
+
+fn read(p: &std::path::Path) -> Vec<f32> {
+    std::fs::read(p).unwrap().as_chunks::<4>().0.iter().map(|b| f32::from_le_bytes(*b)).collect()
+}
+
+#[test]
+fn yunet_matches_onnxruntime() {
+    let (Ok(chk), Ok(models)) = (std::env::var("REFRAME_CHECK_DIR"), std::env::var("REFRAME_MODELS_DIR")) else { return };
+    let chk = PathBuf::from(chk);
+    let net = filmcraft_reframe::yunet::YuNet::load(&PathBuf::from(models).join(filmcraft_reframe::yunet::MODEL_ID)).unwrap();
+    let raw = net.raw(read(&chk.join("yunet_in.f32")), 640, 640).unwrap();
+    // order here: per level [cls, obj, bbox, kps]
+    let names = ["cls", "obj", "bbox", "kps"];
+    for (lvl, s) in [8, 16, 32].iter().enumerate() {
+        for (k, n) in names.iter().enumerate() {
+            let want = read(&chk.join(format!("yunet_{n}_{s}.f32")));
+            let got: Vec<f32> = raw[lvl * 4 + k].iter().map(|v| if k < 2 { 1.0 / (1.0 + (-v).exp()) } else { *v }).collect();
+            assert_eq!(want.len(), got.len(), "{n}_{s}");
+            let err = want.iter().zip(&got).map(|(a, b)| (a - b).abs()).fold(0f32, f32::max);
+            let mag = want.iter().map(|a| a.abs()).fold(0f32, f32::max);
+            eprintln!("{n}_{s}: max err {err:e} (max |v| {mag})");
+            assert!(err < 1e-3 * mag.max(1.0), "{n}_{s} err {err}");
+        }
+    }
+}
