diff --git a/crates/search/src/catalog.rs b/crates/search/src/catalog.rs
new file mode 100644
index 0000000..a9ae672
--- /dev/null
+++ b/crates/search/src/catalog.rs
@@ -0,0 +1,66 @@
+//! The models the search uses, and where it looks for them.
+//!
+//! Filmnex never downloads these: Jacnex Studio puts each one in `<models dir>/<id>/`. A model
+//! counts as present when every file it needs is there.
+
+use std::path::{Path, PathBuf};
+
+/// What a model is for.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Role {
+    /// Images and short texts in one space (search by what is seen).
+    Visual,
+    /// Meaning of sentences (search by what is said, beyond exact words).
+    Meaning,
+}
+
+/// One model the search can use.
+#[derive(Clone, Copy, Debug)]
+pub struct ModelInfo {
+    /// The folder name.
+    pub id: &'static str,
+    pub name: &'static str,
+    pub role: Role,
+    /// Files that must be in the folder.
+    pub files: &'static [&'static str],
+    /// Square side of the images it takes (visual models).
+    pub image_side: u32,
+}
+
+/// Visual models: the first one present is used. Only the base model is shipped (a CPU runs it about ten
+/// times faster than the big SigLIP 2); more can be added here without touching anything else.
+pub const VISUAL: &[ModelInfo] = &[ModelInfo {
+    id: "siglip2-base-patch16-256",
+    name: "SigLIP 2 base",
+    role: Role::Visual,
+    files: &["config.json", "tokenizer.json", "model.safetensors"],
+    image_side: 256,
+}];
+
+/// Meaning models, best first.
+pub const MEANING: &[ModelInfo] = &[ModelInfo {
+    id: "qwen3-embedding-0.6b",
+    name: "Qwen3 Embedding 0.6B",
+    role: Role::Meaning,
+    files: &["config.json", "tokenizer.json", "model.safetensors"],
+    image_side: 0,
+}];
+
+/// Every model, for the launcher and the tests.
+pub fn all() -> Vec<ModelInfo> {
+    VISUAL.iter().chain(MEANING.iter()).copied().collect()
+}
+
+/// Whether all of `m`'s files are in `dir/<id>`.
+pub fn present(dir: &Path, m: &ModelInfo) -> bool {
+    let d = dir.join(m.id);
+    m.files.iter().all(|f| d.join(f).is_file())
+}
+
+/// The folder of the first model of `list` that is present in `dir`.
+pub fn find(dir: &Path, list: &[ModelInfo]) -> Option<(ModelInfo, PathBuf)> {
+    list.iter().find(|m| present(dir, m)).map(|m| (*m, dir.join(m.id)))
+}
+
+/// What to tell the user when a model is missing.
+pub const MISSING: &str = "Actualiza Filmnex desde Jacnex Studio para usar esta función.";
diff --git a/crates/search/src/index.rs b/crates/search/src/index.rs
new file mode 100644
index 0000000..1b893c1
--- /dev/null
+++ b/crates/search/src/index.rs
@@ -0,0 +1,436 @@
+//! The per-media indexes and their cache on disk.
+//!
+//! One cache file per media file and kind, named after the file's identity (path, size,
+//! modification time): `v-<key>-<model>.fnx` for the picture embeddings, `t-<key>.fnx` for the
+//! words, their chunks and the chunk embeddings. A file that changed has another key, so its old
+//! cache is simply never read again. Everything read back is checked (sizes, counts, finite
+//! numbers, ranges): a damaged or planted cache file is refused, not trusted.
+//!
+//! Layout of a cache file: `FNXSRCH1`, the header length (u32, little endian), the header (JSON)
+//! and the vectors (f32, little endian).
+
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use serde::de::DeserializeOwned;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::text::{Chunk, MAX_WORDS, Word};
+use crate::{INDEX_VERSION, Result, SearchError};
+
+const MAGIC: &[u8; 8] = b"FNXSRCH1";
+/// Largest header that is read (bytes).
+const MAX_HEADER: usize = 64 * 1024 * 1024;
+/// Most vector numbers in one file (1 GiB of f32).
+const MAX_FLOATS: usize = 256 * 1024 * 1024;
+/// Widest vector.
+pub const MAX_DIM: usize = 4096;
+/// Most picture samples of one media file.
+pub const MAX_FRAMES: usize = 400_000;
+
+/// The cache key of a file: a hash of its path, size and modification time (seconds).
+pub fn file_key(path: &Path) -> Option<String> {
+    let md = std::fs::metadata(path).ok()?;
+    if !md.is_file() {
+        return None;
+    }
+    let mtime = md.modified().ok().and_then(|t| t.duration_since(std::time::UNIX_EPOCH).ok()).map_or(0, |d| d.as_secs());
+    Some(key_of(&path.to_string_lossy(), md.len(), mtime))
+}
+
+/// The key for a path, a size and a modification time.
+pub fn key_of(path: &str, size: u64, mtime: u64) -> String {
+    let mut h = Sha256::new();
+    h.update(INDEX_VERSION.to_le_bytes());
+    h.update(path.as_bytes());
+    h.update([0]);
+    h.update(size.to_le_bytes());
+    h.update(mtime.to_le_bytes());
+    hex(&h.finalize()[..16])
+}
+
+fn hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+/// A name that is safe as a file name part (model ids come from our own catalogue, but a cache
+/// path never takes anything it was not given as plain letters, digits, `-`, `.`).
+fn safe(s: &str) -> String {
+    s.chars().map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '.' { c } else { '_' }).take(64).collect()
+}
+
+/// Where the picture index of `key` made by `model` lives.
+pub fn visual_path(dir: &Path, key: &str, model: &str) -> PathBuf {
+    dir.join(format!("v-{}-{}.fnx", safe(key), safe(model)))
+}
+
+/// Where the words index of `key` lives.
+pub fn speech_path(dir: &Path, key: &str) -> PathBuf {
+    dir.join(format!("t-{}.fnx", safe(key)))
+}
+
+fn write_part<H: Serialize>(path: &Path, header: &H, vectors: &[f32]) -> Result<()> {
+    let head = serde_json::to_vec(header).map_err(|e| SearchError::Io(e.to_string()))?;
+    let n = u32::try_from(head.len()).map_err(|_| SearchError::Io("index header too large".into()))?;
+    if let Some(dir) = path.parent() {
+        std::fs::create_dir_all(dir)?;
+    }
+    let tmp = path.with_extension("fnx.tmp");
+    {
+        let mut f = std::io::BufWriter::new(std::fs::File::create(&tmp)?);
+        f.write_all(MAGIC)?;
+        f.write_all(&n.to_le_bytes())?;
+        f.write_all(&head)?;
+        for v in vectors {
+            f.write_all(&v.to_le_bytes())?;
+        }
+        f.flush()?;
+    }
+    std::fs::rename(&tmp, path).inspect_err(|_| {
+        let _ = std::fs::remove_file(&tmp);
+    })?;
+    Ok(())
+}
+
+fn read_part<H: DeserializeOwned>(path: &Path) -> Result<(H, Vec<f32>)> {
+    let bad = |m: &str| SearchError::BadIndex(m.to_string());
+    let mut f = std::io::BufReader::new(std::fs::File::open(path)?);
+    let mut magic = [0u8; 8];
+    f.read_exact(&mut magic).map_err(|_| bad("short file"))?;
+    if &magic != MAGIC {
+        return Err(bad("not an index file"));
+    }
+    let mut len = [0u8; 4];
+    f.read_exact(&mut len).map_err(|_| bad("short file"))?;
+    let len = u32::from_le_bytes(len) as usize;
+    if len > MAX_HEADER {
+        return Err(bad("header too large"));
+    }
+    let mut head = vec![0u8; len];
+    f.read_exact(&mut head).map_err(|_| bad("short header"))?;
+    let header: H = serde_json::from_slice(&head).map_err(|_| bad("unreadable header"))?;
+    let mut rest = Vec::new();
+    f.take((MAX_FLOATS as u64) * 4 + 1).read_to_end(&mut rest)?;
+    if rest.len() > MAX_FLOATS * 4 || rest.len() % 4 != 0 {
+        return Err(bad("bad vector data"));
+    }
+    let vectors: Vec<f32> = rest.as_chunks::<4>().0.iter().map(|c| f32::from_le_bytes(*c)).collect();
+    Ok((header, vectors))
+}
+
+/// L2-normalises `v` in place (a zero or non-finite vector becomes zeros).
+pub fn normalize(v: &mut [f32]) {
+    let n: f32 = v.iter().map(|x| x * x).sum::<f32>().sqrt();
+    if n.is_finite() && n > 1e-12 {
+        for x in v.iter_mut() {
+            *x /= n;
+        }
+    } else {
+        v.iter_mut().for_each(|x| *x = 0.0);
+    }
+}
+
+/// The dot product of two vectors (the shorter length counts).
+pub fn dot(a: &[f32], b: &[f32]) -> f32 {
+    a.iter().zip(b).map(|(x, y)| x * y).sum()
+}
+
+/// A hash of the words (text and times), to tell a transcript that changed.
+pub fn words_hash(words: &[Word]) -> String {
+    let mut h = Sha256::new();
+    for w in words.iter().take(MAX_WORDS) {
+        h.update(w.text.as_bytes());
+        h.update([0]);
+        h.update(w.start.to_le_bytes());
+        h.update(w.end.to_le_bytes());
+    }
+    hex(&h.finalize()[..12])
+}
+
+// ---------------------------------------------------------------------------------------------
+// Words
+
+#[derive(Serialize, Deserialize)]
+struct SpeechHeader {
+    version: u32,
+    words_hash: String,
+    words: Vec<Word>,
+    chunks: Vec<Chunk>,
+    /// The model that embedded the chunks ("" when they are not).
+    model: String,
+    dim: usize,
+}
+
+/// What is said in one media file: the words, their chunks and, when a meaning model was there,
+/// one vector per chunk.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct SpeechIndex {
+    pub words_hash: String,
+    pub words: Vec<Word>,
+    pub chunks: Vec<Chunk>,
+    /// The model of `vectors` ("" when there are none).
+    pub model: String,
+    pub dim: usize,
+    /// `chunks.len() * dim` numbers, each vector of length 1.
+    pub vectors: Vec<f32>,
+}
+
+impl SpeechIndex {
+    /// An index of `words` without vectors.
+    pub fn from_words(words: Vec<Word>) -> SpeechIndex {
+        let words: Vec<Word> = words.into_iter().take(MAX_WORDS).collect();
+        SpeechIndex { words_hash: words_hash(&words), chunks: crate::text::chunk_words(&words), words, ..Default::default() }
+    }
+
+    pub fn has_vectors(&self) -> bool {
+        self.dim > 0 && self.vectors.len() == self.chunks.len() * self.dim && !self.chunks.is_empty()
+    }
+
+    /// The vector of chunk `i`.
+    pub fn vector(&self, i: usize) -> Option<&[f32]> {
+        if self.dim == 0 {
+            return None;
+        }
+        self.vectors.get(i.checked_mul(self.dim)?..(i + 1).checked_mul(self.dim)?)
+    }
+
+    pub fn save(&self, path: &Path) -> Result<()> {
+        let h = SpeechHeader {
+            version: INDEX_VERSION,
+            words_hash: self.words_hash.clone(),
+            words: self.words.clone(),
+            chunks: self.chunks.clone(),
+            model: self.model.clone(),
+            dim: self.dim,
+        };
+        write_part(path, &h, &self.vectors)
+    }
+
+    pub fn load(path: &Path) -> Result<SpeechIndex> {
+        let (h, vectors): (SpeechHeader, Vec<f32>) = read_part(path)?;
+        let bad = |m: &str| SearchError::BadIndex(m.to_string());
+        if h.version != INDEX_VERSION {
+            return Err(bad("another version"));
+        }
+        if h.words.len() > MAX_WORDS || h.dim > MAX_DIM {
+            return Err(bad("too large"));
+        }
+        if h.words.iter().any(|w| !w.start.is_finite() || !w.end.is_finite()) {
+            return Err(bad("bad word times"));
+        }
+        for c in &h.chunks {
+            let ok = c.first < c.end_word && (c.end_word as usize) <= h.words.len() && c.start.is_finite() && c.end.is_finite() && c.start <= c.end;
+            if !ok {
+                return Err(bad("bad chunk"));
+            }
+        }
+        let vectors = if h.dim == 0 || vectors.is_empty() {
+            Vec::new()
+        } else if vectors.len() == h.chunks.len() * h.dim && vectors.iter().all(|x| x.is_finite()) {
+            vectors
+        } else {
+            return Err(bad("bad vectors"));
+        };
+        let dim = if vectors.is_empty() { 0 } else { h.dim };
+        Ok(SpeechIndex { words_hash: h.words_hash, words: h.words, chunks: h.chunks, model: if dim == 0 { String::new() } else { h.model }, dim, vectors })
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Pictures
+
+#[derive(Serialize, Deserialize)]
+struct VisualHeader {
+    version: u32,
+    model: String,
+    dim: usize,
+    /// Seconds between samples.
+    interval: f32,
+    duration: f32,
+    /// Every sample is there (otherwise indexing stopped, and can go on from the last).
+    complete: bool,
+    times: Vec<f32>,
+}
+
+/// What is seen in one media file: one vector per sampled picture.
+#[derive(Clone, Debug, Default, PartialEq)]
+pub struct VisualIndex {
+    pub model: String,
+    pub dim: usize,
+    pub interval: f32,
+    pub duration: f32,
+    pub complete: bool,
+    /// Media time (seconds) of each sample, ascending.
+    pub times: Vec<f32>,
+    /// `times.len() * dim` numbers, each vector of length 1.
+    pub vectors: Vec<f32>,
+}
+
+impl VisualIndex {
+    pub fn new(model: &str, dim: usize, interval: f32, duration: f32) -> VisualIndex {
+        VisualIndex { model: model.into(), dim, interval, duration, ..Default::default() }
+    }
+
+    /// Adds a sample (the vector is normalised; wrong sizes and non-finite numbers are refused).
+    pub fn push(&mut self, t: f32, mut v: Vec<f32>) -> bool {
+        if v.len() != self.dim || !t.is_finite() || self.times.len() >= MAX_FRAMES || v.iter().any(|x| !x.is_finite()) {
+            return false;
+        }
+        normalize(&mut v);
+        self.times.push(t);
+        self.vectors.extend(v);
+        true
+    }
+
+    /// The vector of sample `i`.
+    pub fn vector(&self, i: usize) -> Option<&[f32]> {
+        self.vectors.get(i.checked_mul(self.dim)?..(i + 1).checked_mul(self.dim)?)
+    }
+
+    pub fn save(&self, path: &Path) -> Result<()> {
+        let h = VisualHeader {
+            version: INDEX_VERSION,
+            model: self.model.clone(),
+            dim: self.dim,
+            interval: self.interval,
+            duration: self.duration,
+            complete: self.complete,
+            times: self.times.clone(),
+        };
+        write_part(path, &h, &self.vectors)
+    }
+
+    pub fn load(path: &Path) -> Result<VisualIndex> {
+        let (h, vectors): (VisualHeader, Vec<f32>) = read_part(path)?;
+        let bad = |m: &str| SearchError::BadIndex(m.to_string());
+        if h.version != INDEX_VERSION {
+            return Err(bad("another version"));
+        }
+        if h.dim == 0 || h.dim > MAX_DIM || h.times.len() > MAX_FRAMES || vectors.len() != h.times.len() * h.dim {
+            return Err(bad("bad sizes"));
+        }
+        if !h.interval.is_finite() || h.interval <= 0.0 || !h.duration.is_finite() {
+            return Err(bad("bad interval"));
+        }
+        if h.times.iter().any(|t| !t.is_finite()) || h.times.windows(2).any(|p| p[1] < p[0]) || vectors.iter().any(|x| !x.is_finite()) {
+            return Err(bad("bad numbers"));
+        }
+        Ok(VisualIndex { model: h.model, dim: h.dim, interval: h.interval, duration: h.duration, complete: h.complete, times: h.times, vectors })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn words() -> Vec<Word> {
+        (0..20).map(|i| Word { text: format!("w{i}"), start: i as f32, end: i as f32 + 0.5 }).collect()
+    }
+
+    #[test]
+    fn keys_depend_on_path_size_and_time() {
+        let a = key_of("C:/a.mp4", 10, 5);
+        assert_eq!(a, key_of("C:/a.mp4", 10, 5));
+        assert_ne!(a, key_of("C:/b.mp4", 10, 5));
+        assert_ne!(a, key_of("C:/a.mp4", 11, 5));
+        assert_ne!(a, key_of("C:/a.mp4", 10, 6));
+        assert_eq!(a.len(), 32);
+    }
+
+    #[test]
+    fn file_key_follows_the_file() {
+        let d = tempfile::tempdir().unwrap();
+        let p = d.path().join("x.bin");
+        assert!(file_key(&p).is_none());
+        std::fs::write(&p, b"abc").unwrap();
+        let k1 = file_key(&p).unwrap();
+        std::fs::write(&p, b"abcd").unwrap();
+        assert_ne!(k1, file_key(&p).unwrap());
+        assert!(file_key(d.path()).is_none());
+    }
+
+    #[test]
+    fn speech_index_round_trips() {
+        let d = tempfile::tempdir().unwrap();
+        let mut s = SpeechIndex::from_words(words());
+        assert!(!s.chunks.is_empty());
+        s.model = "m".into();
+        s.dim = 3;
+        s.vectors = (0..s.chunks.len() * 3).map(|i| i as f32).collect();
+        let p = speech_path(d.path(), "abc");
+        s.save(&p).unwrap();
+        let back = SpeechIndex::load(&p).unwrap();
+        assert_eq!(back, s);
+        assert!(back.has_vectors());
+        assert!(back.vector(0).is_some());
+    }
+
+    #[test]
+    fn visual_index_round_trips_and_normalises() {
+        let d = tempfile::tempdir().unwrap();
+        let mut v = VisualIndex::new("m", 2, 1.0, 10.0);
+        assert!(v.push(0.0, vec![3.0, 4.0]));
+        assert!(!v.push(1.0, vec![1.0]));
+        assert!(!v.push(1.0, vec![f32::NAN, 1.0]));
+        assert!(v.push(1.0, vec![0.0, 2.0]));
+        v.complete = true;
+        let p = visual_path(d.path(), "k", "m");
+        v.save(&p).unwrap();
+        let b = VisualIndex::load(&p).unwrap();
+        assert_eq!(b, v);
+        assert!((b.vector(0).unwrap()[0] - 0.6).abs() < 1e-6);
+    }
+
+    #[test]
+    fn damaged_files_are_refused_not_trusted() {
+        let d = tempfile::tempdir().unwrap();
+        let mut v = VisualIndex::new("m", 2, 1.0, 10.0);
+        v.push(0.0, vec![1.0, 0.0]);
+        let p = visual_path(d.path(), "k", "m");
+        v.save(&p).unwrap();
+        let good = std::fs::read(&p).unwrap();
+        // every truncation and every flipped byte: an error or a valid index, never a panic
+        for cut in 0..good.len() {
+            std::fs::write(&p, &good[..cut]).unwrap();
+            let r = std::panic::catch_unwind(|| VisualIndex::load(&p));
+            assert!(r.is_ok(), "panic at cut {cut}");
+        }
+        for i in 0..good.len() {
+            let mut b = good.clone();
+            b[i] ^= 0xff;
+            std::fs::write(&p, &b).unwrap();
+            let r = std::panic::catch_unwind(|| VisualIndex::load(&p));
+            assert!(r.is_ok(), "panic at byte {i}");
+        }
+        std::fs::write(&p, b"FNXSRCH1\xff\xff\xff\xff").unwrap();
+        assert!(VisualIndex::load(&p).is_err());
+        std::fs::write(&p, b"nothing").unwrap();
+        assert!(SpeechIndex::load(&p).is_err());
+        assert!(SpeechIndex::load(&d.path().join("missing.fnx")).is_err());
+    }
+
+    #[test]
+    fn a_chunk_pointing_outside_the_words_is_refused() {
+        let d = tempfile::tempdir().unwrap();
+        let mut s = SpeechIndex::from_words(words());
+        s.chunks[0].end_word = 999;
+        let p = speech_path(d.path(), "k");
+        s.save(&p).unwrap();
+        assert!(SpeechIndex::load(&p).is_err());
+    }
+
+    #[test]
+    fn vector_helpers() {
+        let mut z = vec![0.0f32; 3];
+        normalize(&mut z);
+        assert_eq!(z, vec![0.0; 3]);
+        let mut n = vec![f32::INFINITY, 1.0];
+        normalize(&mut n);
+        assert_eq!(n, vec![0.0, 0.0]);
+        assert_eq!(dot(&[1.0, 2.0], &[3.0, 4.0]), 11.0);
+        let idx = SpeechIndex::default();
+        assert!(idx.vector(0).is_none());
+        assert_eq!(words_hash(&words()), words_hash(&words()));
+    }
+}
