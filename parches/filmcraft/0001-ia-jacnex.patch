+        creditos: 3,
+        colocadas: 1,
+        faltan: 1,
+        ajuste: Fit { placed: 1, sped_up: 2, trimmed: 1 },
+        inicio,
+        clips,
+        secuencia,
+        fondo: fondo.then(|| (vec![0.1; 48_000 * 2], 48_000, 2)),
+        destino: "en".into(),
+    }
+}
