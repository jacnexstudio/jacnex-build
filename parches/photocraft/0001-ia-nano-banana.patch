+    fn factor(&self) -> u32 {
+        if self.factor == 4 { 4 } else { 2 }
+    }
+
+    /// Los modelos de imagen: los del servidor, o los conocidos mientras no responde.
+    fn modelos(&self) -> Vec<ModeloInfo> {
+        match &self.info {
+            Some(i) if i.modelos.iter().any(|m| !m.herramienta) => i.modelos.iter().filter(|m| !m.herramienta).cloned().collect(),
+            _ => modelos_base(),
+        }
+    }
+
+    fn modelo_actual(&self) -> ModeloInfo {
+        let lista = self.modelos();
+        let id = if self.modelo.is_empty() { MODELO } else { self.modelo.as_str() };
+        lista.iter().find(|m| m.id == id).or_else(|| lista.iter().find(|m| m.id == MODELO)).or(lista.first()).cloned().unwrap_or_else(|| ModeloInfo {
+            id: MODELO.into(),
+            nombre: "Google Nano Banana".into(),
+            descripcion: String::new(),
+            herramienta: false,
+            aspectos: Vec::new(),
+            creditos: Vec::new(),
+        })
+    }
+
+    fn herramienta_servidor(&self, id: &str) -> Option<&ModeloInfo> {
+        self.info.as_ref()?.modelos.iter().find(|m| m.id == id)
+    }
+
+    fn elegir_herramienta(&mut self, h: Herramienta) {
+        if h == self.herramienta {
+            return;
+        }
+        if h == Herramienta::Texto {
+            self.modelo = MODELO_TEXTO.into();
+        } else if self.herramienta == Herramienta::Texto && self.modelo == MODELO_TEXTO {
+            self.modelo.clear();
+        }
+        self.herramienta = h;
+        self.aviso = None;
+    }
+}
