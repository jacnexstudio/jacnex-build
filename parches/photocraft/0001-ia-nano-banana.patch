+pub fn ventana(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    actualizar(app, ctx);
+    if !app.jacnex_ia.abierta {
+        return;
+    }
+    let mut abierta = true;
+    let mut accion_generar = false;
+    let plan = plan(app);
+    let sesion = app.jacnex_ia.con_sesion;
+    egui::Window::new("IA de Jacnex")
+        .id(egui::Id::unique("jacnex-ia-ventana"))
+        .open(&mut abierta)
+        .resizable(false)
+        .collapsible(true)
+        .default_width(340.0)
+        .show(ctx, |ui| {
+            ui.set_width(340.0);
+            let e = &mut app.jacnex_ia;
+            ui.horizontal(|ui| {
+                ui.label(RichText::new(format!("Modelo: {MODELO_NOMBRE}")).strong());
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    if sesion && ui.small_button("Actualizar").on_hover_text("Actualizar saldo").clicked() {
+                        pedir_info(e);
