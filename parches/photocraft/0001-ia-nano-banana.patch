+/// `px` (`w`×`h`, RGBA) reducida a lo sumo a 200 px de lado.
+fn miniatura(px: &[u8], w: u32, h: u32) -> Option<egui::ColorImage> {
+    if w == 0 || h == 0 || px.len() < (w as usize) * (h as usize) * 4 {
+        return None;
+    }
+    let (tw, th) = caber(w, h, 200);
+    let mut out = Vec::with_capacity((tw * th * 4) as usize);
+    for y in 0..th {
+        let sy = (u64::from(y) * u64::from(h) / u64::from(th)) as usize;
+        for x in 0..tw {
+            let sx = (u64::from(x) * u64::from(w) / u64::from(tw)) as usize;
+            let i = (sy * w as usize + sx) * 4;
+            out.extend_from_slice(&px[i..i + 4]);
+        }
+    }
+    Some(egui::ColorImage::from_rgba_unmultiplied([tw as usize, th as usize], &out))
+}
+
+/// Prepara las miniaturas del último resultado (una vez por resultado).
+fn preparar_miniaturas(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let e = &mut app.jacnex_ia;
+    let Some(r) = &e.resultado else {
+        e.miniaturas = None;
+        return;
+    };
+    let clave = (r.doc, r.capa);
+    if e.miniaturas.as_ref().is_some_and(|m| m.0 == clave) {
+        return;
+    }
+    let (w, h) = (r.zona.width(), r.zona.height());
+    let tex = r
+        .variaciones
+        .iter()
+        .enumerate()
+        .filter_map(|(i, px)| Some(ctx.load_texture(format!("jacnex-ia-variacion-{i}"), miniatura(px, w, h)?, egui::TextureOptions::LINEAR)))
+        .collect();
+    e.miniaturas = Some((clave, tex));
+}
