+            let f = (rect.width() / tam.x).min(rect.height() / tam.y);
+            let img = egui::Rect::from_center_size(rect.center(), tam * f);
+            egui::Image::from_texture(tx).corner_radius(6.0).paint_at(ui, img);
+            let elegida = r.actual == i;
+            if elegida {
+                pt.rect_stroke(rect.expand(1.0), 8.0, egui::Stroke::new(2.0, ACENTO), egui::StrokeKind::Outside);
+            } else if resp.hovered() {
