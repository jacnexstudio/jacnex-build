+        }
+    });
+    if r.aplicable {
+        ui.add_space(6.0);
+        ui.horizontal(|ui| {
+            let mitad = ((ancho - 6.0) / 2.0).floor();
+            if boton_aplicar(ui, "Aplicar", egui::vec2(mitad, 30.0)).on_hover_text("Combina el resultado con la capa de abajo").clicked() {
+                pide.aplicar = true;
