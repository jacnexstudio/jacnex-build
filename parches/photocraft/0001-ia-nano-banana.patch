+    generar_y_esperar(&mut h);
+    let b = h.state().session.active().unwrap().doc.bounds();
+    assert_eq!((b.width(), b.height()), (533, 300), "{:?}", h.state().jacnex_ia_aviso());
+    assert_eq!(pixel(h.state(), 5, 150), ROJO, "lo nuevo, a la izquierda");
+    assert_eq!(pixel(h.state(), 528, 150), ROJO, "lo nuevo, a la derecha");
+    assert_eq!(pixel(h.state(), 266, 150), BLANCO, "la foto original, intacta");
+    {
+        let r = recibido.lock().unwrap();
+        assert_eq!(campo(&r.generar[0], "aspect").as_deref(), Some("16:9"));
+        assert_eq!(campo(&r.generar[0], "size").as_deref(), Some("533x300"));
