+        _ => {
+            ui.label("Toda la imagen, tal como se ve (todas las capas visibles).");
+        }
+    }
+    ui.add_space(4.0);
+
+    // Paso 2: qué.
+    ui.label(RichText::new("2 · Qué quieres").strong());
+    match h {
+        Herramienta::Relleno => {
+            let pista = if p.con_seleccion { "Ej.: un perro durmiendo (vacío = quitar y rellenar)" } else { "Describe la imagen o el cambio" };
+            ui.add(egui::TextEdit::multiline(&mut e.prompt).hint_text(pista).desired_rows(3).desired_width(f32::INFINITY));
+            ideas(ui, &mut e.prompt, if p.con_seleccion { IDEAS_SELECCION } else { IDEAS_LIENZO });
+        }
+        Herramienta::QuitarObjeto => {
+            ui.label("Nada que escribir: la IA borra lo seleccionado y rellena con lo que habría detrás.");
+        }
+        Herramienta::Expandir => {
+            ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Opcional: qué poner en lo nuevo").desired_width(f32::INFINITY));
+            ideas(ui, &mut e.prompt, IDEAS_EXPANDIR);
