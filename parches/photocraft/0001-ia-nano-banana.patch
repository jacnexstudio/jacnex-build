diff --git a/crates/ui-egui/src/jacnex_ia.rs b/crates/ui-egui/src/jacnex_ia.rs
new file mode 100644
index 000000000..4446e574e
--- /dev/null
+++ b/crates/ui-egui/src/jacnex_ia.rs
@@ -0,0 +1,878 @@
+//! Jacnex: la IA integrada de Photonex (piloto con Google Nano Banana).
+//!
+//! Funciona como el Relleno generativo de la aplicación de referencia, pero explicado paso a paso:
+//!
+//! - **Con una selección**: se envía la zona seleccionada (más un margen alrededor, para que la
+//!   IA respete luz y perspectiva) y una máscara; el resultado vuelve como una **capa nueva**
+//!   recortada por la selección, justo encima de la capa activa. Ctrl+Z la quita.
+//! - **Sin selección**: o se edita la imagen entera, o se crea una imagen nueva que ocupa el
+//!   lienzo; también como capa nueva.
+//!
+//! Se abre desde Edición › Relleno generativo (IA)… o desde la barra contextual que aparece bajo
+//! la selección (como la barra de tareas contextual de Recortar). La red va en un hilo aparte:
+//! la interfaz nunca se congela. El servidor es app.jacnex.store (`/v1/jacnex/*`), con la llave de
+//! la sesión iniciada en Jacnex Studio. Los créditos se descuentan en el servidor, que los devuelve
+//! si la generación falla.
+
+use std::sync::mpsc::{Receiver, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::{Color32, RichText};
+use photocraft_doc::DocId;
+use photocraft_engine::jacnex_ia as motor;
+use photocraft_geom::Rect;
+use photocraft_raster::Surface;
+
+use crate::PhotocraftApp;
+use crate::canvas::ViewXform;
+use crate::widgets::task_bar;
+
+/// El modelo del piloto.
+pub const MODELO: &str = "nano-banana";
+const MODELO_NOMBRE: &str = "Google Nano Banana";
+/// El lado largo de lo que se envía: más no mejora el resultado y tarda más en subir.
+const MAX_LADO: u32 = 1536;
+/// El contexto alrededor de la selección, como fracción de su tamaño.
+const MARGEN: f32 = 0.15;
+
+/// Ideas de un clic para quien no sabe qué escribir.
+const IDEAS_SELECCION: &[&str] = &["un cielo al atardecer", "flores de colores", "quitar el objeto", "un sombrero elegante", "agua cristalina"];
+const IDEAS_LIENZO: &[&str] = &["estilo acuarela", "de noche con luces de neón", "foto de producto con fondo de estudio", "estilo ilustración 3D"];
+
+/// Qué hacer cuando no hay selección.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum SinSeleccion {
+    /// Cambiar la imagen entera según la indicación.
+    #[default]
+    EditarTodo,
+    /// Una imagen nueva (solo texto), del tamaño del lienzo.
+    CrearNueva,
+}
+
+/// La cuenta y el saldo, según el servidor.
+#[derive(Clone, Debug)]
+struct Info {
+    nombre: String,
+    creditos: i64,
+    costo: i64,
+    costo_edicion: i64,
+}
+
+/// Lo que el hilo de red le cuenta a la interfaz.
+enum Evento {
+    Etapa(&'static str),
+    Cobrado { saldo: Option<i64> },
+    Listo { rgba: Vec<u8>, ancho: u32, alto: u32 },
+    Error(String),
+}
+
+/// Una generación en marcha (o lista, esperando a que su documento vuelva a estar activo).
+struct Trabajo {
+    doc: DocId,
+    zona: Rect,
+    mascara: Option<Surface>,
+    nombre_capa: String,
+    inicio: Instant,
+    etapa: &'static str,
+    rx: Receiver<Evento>,
+    listo: Option<(Vec<u8>, u32, u32)>,
+}
+
+/// El estado de la IA en la app.
+#[derive(Default)]
+pub struct Estado {
+    /// La ventana «IA de Jacnex» está abierta.
+    pub abierta: bool,
+    /// La indicación (prompt), compartida por la ventana y la barra contextual.
+    pub prompt: String,
+    /// La barra contextual muestra el campo de texto.
+    barra_expandida: bool,
+    pub sin_seleccion: SinSeleccion,
+    info: Option<Info>,
+    info_error: Option<String>,
+    info_rx: Option<Receiver<Result<Info, String>>>,
+    trabajo: Option<Trabajo>,
+    /// El último aviso: (salió bien, texto).
+    aviso: Option<(bool, String)>,
+    /// Hay una sesión de Jacnex Studio (se vuelve a mirar al abrir la ventana o actualizar).
+    con_sesion: bool,
+    /// Un servidor de pruebas en esta máquina, en lugar de la cuenta de Jacnex Studio
+    /// ([`usar_servidor_local`]).
+    local: Option<(String, String)>,
+    /// Los límites de la selección para la barra, con lo que identifica esa selección: medirlos
+    /// recorre sus píxeles, así que no se repite en cada cuadro.
+    limites: Option<((DocId, u64, Rect), Option<Rect>)>,
+}
+
+/// Usa un Forgenex de pruebas en esta máquina (`http://127.0.0.1:…` o `http://localhost:…`) con
+/// la llave `llave`, en lugar de la sesión de Jacnex Studio. Otras direcciones se rechazan.
+pub fn usar_servidor_local(app: &mut PhotocraftApp, servidor: &str, llave: &str) -> bool {
+    let ok = es_local(servidor) && llave.starts_with("jk_");
+    if ok {
+        app.jacnex_ia.local = Some((servidor.trim_end_matches('/').to_string(), llave.to_string()));
+    }
+    ok
+}
+
+// --- Cuenta y servidor -----------------------------------------------------------------------
+
+struct Conexion {
+    servidor: String,
+    llave: String,
+}
+
+/// El servidor: app.jacnex.store. `JACNEX_IA_SERVIDOR` solo puede apuntar a esta misma máquina
+/// (pruebas con un Forgenex local); cualquier otro valor se ignora.
+fn servidor() -> String {
+    match std::env::var("JACNEX_IA_SERVIDOR") {
+        Ok(s) if es_local(&s) => s.trim_end_matches('/').to_string(),
+        _ => "https://app.jacnex.store".to_string(),
+    }
+}
+
+fn es_local(url: &str) -> bool {
+    url.starts_with("http://127.0.0.1:") || url.starts_with("http://localhost:")
+}
+
+/// La llave de la sesión de Jacnex Studio (`%LOCALAPPDATA%\Jacnex Studio\cuenta.json`). Con un
+/// servidor local de pruebas vale `JACNEX_IA_LLAVE`.
+fn conexion(e: &Estado) -> Option<Conexion> {
+    if let Some((servidor, llave)) = &e.local {
+        return Some(Conexion { servidor: servidor.clone(), llave: llave.clone() });
+    }
+    let servidor = servidor();
+    if es_local(&servidor)
+        && let Ok(llave) = std::env::var("JACNEX_IA_LLAVE")
+    {
+        return llave.starts_with("jk_").then_some(Conexion { servidor, llave });
+    }
+    let base = std::env::var_os("LOCALAPPDATA").map(std::path::PathBuf::from).or_else(|| {
+        std::env::var_os("HOME").map(|h| std::path::PathBuf::from(h).join(".local").join("share"))
+    })?;
+    let texto = std::fs::read_to_string(base.join("Jacnex Studio").join("cuenta.json")).ok()?;
+    let v: serde_json::Value = serde_json::from_str(&texto).ok()?;
+    let llave = v.get("llave")?.as_str()?.to_string();
+    llave.starts_with("jk_").then_some(Conexion { servidor, llave })
+}
+
+// --- Red (escritorio) -------------------------------------------------------------------------
+
+#[cfg(not(target_arch = "wasm32"))]
+mod red {
+    use super::{Conexion, Evento, Info, MODELO, es_local};
+    use std::sync::mpsc::Sender;
+    use std::time::{Duration, Instant};
+
+    const LIMITE_JSON: u64 = 1024 * 1024;
+    const LIMITE_IMAGEN: u64 = 48 * 1024 * 1024;
+
+    fn agente(segundos: u64, https: bool) -> ureq::Agent {
+        ureq::Agent::config_builder()
+            .tls_config(ureq::tls::TlsConfig::builder().root_certs(ureq::tls::RootCerts::PlatformVerifier).build())
+            .https_only(https)
+            .timeout_global(Some(Duration::from_secs(segundos)))
+            .http_status_as_error(false)
+            .user_agent("Photonex")
+            .build()
+            .new_agent()
+    }
+
+    fn agente_para(c: &Conexion, segundos: u64) -> ureq::Agent {
+        agente(segundos, !es_local(&c.servidor))
+    }
+
+    /// El cuerpo JSON de una respuesta; los errores del servidor (`{error:{message}}`) como texto.
+    fn json(r: Result<ureq::http::Response<ureq::Body>, ureq::Error>) -> Result<serde_json::Value, String> {
+        let mut r = r.map_err(|e| format!("No se pudo conectar con Jacnex: {e}"))?;
+        let estado = r.status().as_u16();
+        let texto = r.body_mut().with_config().limit(LIMITE_JSON).read_to_string().map_err(|e| format!("Respuesta incompleta: {e}"))?;
+        let v: serde_json::Value = serde_json::from_str(&texto).unwrap_or(serde_json::Value::Null);
+        if (200..300).contains(&estado) {
+            return Ok(v);
+        }
+        let msg = v.pointer("/error/message").and_then(|m| m.as_str()).map(str::to_string);
+        Err(match (estado, msg) {
+            (401, _) => "Tu sesión de Jacnex venció. Vuelve a iniciar sesión en Jacnex Studio.".into(),
+            (_, Some(m)) => m,
+            _ => format!("El servidor respondió {estado}."),
+        })
+    }
+
+    pub fn info(c: &Conexion) -> Result<Info, String> {
+        let url = format!("{}/v1/jacnex/estado?modelo={MODELO}", c.servidor);
+        let v = json(agente_para(c, 20).get(&url).header("Authorization", &format!("Bearer {}", c.llave)).call())?;
+        let n = |p: &str| v.pointer(p).and_then(|x| x.as_i64()).unwrap_or(0);
+        Ok(Info {
+            nombre: v.get("nombre").and_then(|x| x.as_str()).unwrap_or("").to_string(),
+            creditos: n("/creditos"),
+            costo: n("/modelo/costo"),
+            costo_edicion: n("/modelo/costoEdicion"),
+        })
+    }
+
+    /// Un cuerpo multipart/form-data: campos de texto y archivos PNG.
+    fn multipart(campos: &[(&str, &str)], archivos: &[(&str, &str, &[u8])]) -> (String, Vec<u8>) {
+        let semilla = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_or(0, |d| d.as_nanos());
+        let limite = format!("----photonex{semilla:x}{:x}", archivos.iter().map(|a| a.2.len()).sum::<usize>());
+        let mut b = Vec::new();
+        for (k, v) in campos {
+            b.extend_from_slice(format!("--{limite}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n{v}\r\n").as_bytes());
+        }
+        for (k, nombre, datos) in archivos {
+            b.extend_from_slice(
+                format!("--{limite}\r\nContent-Disposition: form-data; name=\"{k}\"; filename=\"{nombre}\"\r\nContent-Type: image/png\r\n\r\n").as_bytes(),
+            );
+            b.extend_from_slice(datos);
+            b.extend_from_slice(b"\r\n");
+        }
+        b.extend_from_slice(format!("--{limite}--\r\n").as_bytes());
+        (format!("multipart/form-data; boundary={limite}"), b)
+    }
+
+    pub struct Pedido {
+        pub conexion: Conexion,
+        pub prompt: String,
+        pub tamano: String,
+        pub imagenes: Vec<Vec<u8>>,
+    }
+
+    /// Crea el trabajo, espera el resultado y lo descarga; todo lo cuenta por `tx`.
+    pub fn generar(p: Pedido, tx: &Sender<Evento>) -> Result<(), String> {
+        let c = &p.conexion;
+        let auth = format!("Bearer {}", c.llave);
+        let _ = tx.send(Evento::Etapa("Enviando la imagen…"));
+        let archivos: Vec<(&str, &str, &[u8])> =
+            p.imagenes.iter().enumerate().map(|(i, d)| ("image", if i == 0 { "imagen.png" } else { "mascara.png" }, d.as_slice())).collect();
+        let (tipo, cuerpo) = multipart(&[("model", MODELO), ("prompt", &p.prompt), ("size", &p.tamano)], &archivos);
+        let url = format!("{}/v1/jacnex/generar", c.servidor);
+        let v = json(agente_para(c, 120).post(&url).header("Authorization", &auth).header("Content-Type", &tipo).send(&cuerpo[..]))?;
+        let id = v.get("id").and_then(|x| x.as_str()).ok_or("El servidor no devolvió el trabajo.")?.to_string();
+        let _ = tx.send(Evento::Cobrado { saldo: v.get("saldo").and_then(|x| x.as_i64()) });
+        let _ = tx.send(Evento::Etapa("La IA está creando…"));
+        let inicio = Instant::now();
+        let consulta = format!("{}/v1/jacnex/trabajo/{id}", c.servidor);
+        let url_resultado = loop {
+            std::thread::sleep(Duration::from_millis(1500));
+            if inicio.elapsed() > Duration::from_secs(300) {
+                return Err("La IA tardó demasiado. Si no llega, tus créditos se devuelven solos.".into());
+            }
+            let v = match json(agente_para(c, 30).get(&consulta).header("Authorization", &auth).call()) {
+                Ok(v) => v,
+                // Un corte de red momentáneo no pierde el trabajo: se vuelve a consultar.
+                Err(e) if e.starts_with("No se pudo conectar") => continue,
+                Err(e) => return Err(e),
+            };
+            match v.get("estado").and_then(|x| x.as_str()) {
+                Some("listo") => {
+                    break v.pointer("/resultados/0").and_then(|x| x.as_str()).ok_or("La IA no devolvió ninguna imagen.")?.to_string();
+                }
+                Some("fallido") => {
+                    let e = v.get("error").and_then(|x| x.as_str()).unwrap_or("La IA no pudo completar la imagen.");
+                    return Err(format!("{e} Tus créditos fueron devueltos."));
+                }
+                _ => {}
+            }
+        };
+        let _ = tx.send(Evento::Etapa("Descargando el resultado…"));
+        let local = es_local(&url_resultado) && es_local(&c.servidor);
+        if !local && !url_resultado.starts_with("https://") {
+            return Err("La dirección del resultado no es segura.".into());
+        }
+        // La llave solo viaja a Jacnex: los resultados alojados en otro sitio se piden sin ella.
+        let mut pedido = agente(120, !local).get(&url_resultado);
+        if url_resultado.starts_with(&format!("{}/", c.servidor)) {
+            pedido = pedido.header("Authorization", &auth);
+        }
+        let mut r = pedido.call().map_err(|e| format!("No se pudo descargar el resultado: {e}"))?;
+        if !r.status().is_success() {
+            return Err(format!("No se pudo descargar el resultado ({}).", r.status().as_u16()));
+        }
+        let bytes = r.body_mut().with_config().limit(LIMITE_IMAGEN).read_to_vec().map_err(|e| format!("Descarga incompleta: {e}"))?;
+        let img = photocraft_codecs::decode(&bytes).map_err(|e| format!("La imagen recibida no se pudo leer: {e}"))?;
+        let _ = tx.send(Evento::Listo { rgba: img.to_rgba8(), ancho: img.width(), alto: img.height() });
+        Ok(())
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+mod red {
+    use super::{Conexion, Evento, Info};
+    use std::sync::mpsc::Sender;
+    const SOLO_ESCRITORIO: &str = "La IA está disponible en la app de escritorio.";
+    pub struct Pedido {
+        pub conexion: Conexion,
+        pub prompt: String,
+        pub tamano: String,
+        pub imagenes: Vec<Vec<u8>>,
+    }
+    pub fn info(_: &Conexion) -> Result<Info, String> {
+        Err(SOLO_ESCRITORIO.into())
+    }
+    pub fn generar(_: Pedido, _: &Sender<Evento>) -> Result<(), String> {
+        Err(SOLO_ESCRITORIO.into())
+    }
+}
+
+/// Corre `f` en un hilo y devuelve por dónde llega su respuesta.
+fn en_hilo<T: Send + 'static>(f: impl FnOnce(std::sync::mpsc::Sender<T>) + Send + 'static) -> Receiver<T> {
+    let (tx, rx) = std::sync::mpsc::channel();
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let _ = std::thread::Builder::new().name("jacnex-ia".into()).spawn(move || f(tx));
+    }
+    #[cfg(target_arch = "wasm32")]
+    f(tx);
+    rx
+}
+
+fn pedir_info(e: &mut Estado) {
+    if e.info_rx.is_some() {
+        return;
+    }
+    let c = conexion(e);
+    e.con_sesion = c.is_some();
+    let Some(c) = c else {
+        e.info = None;
+        e.info_error = None;
+        return;
+    };
+    e.info_rx = Some(en_hilo(move |tx| {
+        let _ = tx.send(red::info(&c));
+    }));
+}
