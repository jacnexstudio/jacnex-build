index 000000000..e3071c8fb
--- /dev/null
+++ b/crates/engine/src/jacnex_ia.rs
@@ -0,0 +1,136 @@
+//! Jacnex: what Photonex's built-in AI (`photocraft-ui-egui`'s `jacnex_ia`) needs from the
+//! document: the area it works on, that area's pixels as the person sees them, and the result
+//! placed back as a new layer (masked by the selection, one undo step).
+
+use photocraft_color::PixelFormat;
+use photocraft_doc::{Document, Layer, LayerId, LayerMask};
+use photocraft_geom::Rect;
+use photocraft_raster::Surface;
+
+use crate::{EngineError, Result, Session};
+
+/// The area the AI looks at and draws in, in document pixels.
+#[derive(Clone, Debug)]
+pub struct Zone {
+    /// What is sent to the model: the selection's bounds and some of what surrounds them (so it
+    /// can match light and perspective), or the whole canvas without a selection.
+    pub context: Rect,
+    /// The selection's bounds inside the canvas; `None` without a selection.
+    pub selected: Option<Rect>,
+    /// The selection itself (coverage), to mask the new layer with.
+    pub selection: Option<Surface>,
+}
+
+/// The area of the active document: see [`Zone`]. `margin` is the share of the selection's size
+/// added on each side as context (0.25 = a quarter). `None` without a document or when the
+/// selection lies outside the canvas.
+pub fn zone(s: &Session, margin: f32) -> Option<Zone> {
+    let d = s.active()?;
+    let canvas = d.doc.bounds();
+    if canvas.is_empty() {
+        return None;
+    }
+    let Some(sel) = d.doc.selection.as_ref() else { return Some(Zone { context: canvas, selected: None, selection: None }) };
+    let bounds = sel.content_bounds().intersect(&canvas);
+    if bounds.is_empty() {
+        return None;
+    }
+    let pad = |len: u32| ((len as f32 * margin.clamp(0.0, 2.0)).round() as i32).max(0);
+    let (px, py) = (pad(bounds.width()), pad(bounds.height()));
+    let context = Rect::new(
+        bounds.x0.saturating_sub(px),
+        bounds.y0.saturating_sub(py),
+        bounds.x1.saturating_add(px),
+        bounds.y1.saturating_add(py),
+    )
+    .intersect(&canvas);
+    Some(Zone { context, selected: Some(bounds), selection: Some(sel.clone()) })
+}
+
+/// The visible composite (what the canvas shows, without the checkerboard) in `r`, as RGBA8.
+pub fn composite_rgba8(doc: &Document, r: Rect) -> Vec<[u8; 4]> {
+    let fmt = doc.pixel_format();
+    let flat = photocraft_compose::flatten_to_surface(doc, PixelFormat::new(fmt.mode, fmt.sample, true), None);
+    let mut px = vec![[0u8; 4]; r.width() as usize * r.height() as usize];
+    flat.read_rgba8_into(r, &mut px);
+    px
+}
+
+/// The coverage of `selection` in `r` (0 = not selected, 255 = selected), one byte a pixel.
+pub fn coverage(selection: &Surface, r: Rect) -> Vec<u8> {
+    let mut px = vec![[0u8; 4]; r.width() as usize * r.height() as usize];
+    selection.read_rgba8_into(r, &mut px);
+    px.into_iter().map(|p| p[0]).collect()
+}
+
+/// Adds `rgba` (interleaved RGBA8 covering `r`) to the active document as a new layer named
+/// `name` above the active one, masked by `mask` (a selection) when given. One history step
+/// labelled `label`; the selection stays, as after Generative Fill in the reference application.
+pub fn place(s: &mut Session, label: &str, name: &str, r: Rect, rgba: &[u8], mask: Option<&Surface>) -> Result<LayerId> {
+    if r.is_empty() || rgba.len() != r.width() as usize * r.height() as usize * 4 {
+        return Err(EngineError::Other("the generated image does not match its area".into()));
+    }
+    let d = s.active().ok_or(EngineError::NoDocument)?;
+    let fmt = d.doc.pixel_format();
+    let target = PixelFormat::new(fmt.mode, fmt.sample, true);
+    let mut surface = Surface::from_interleaved(PixelFormat::RGBA8, r, rgba);
+    if surface.format() != target {
+        surface = surface.try_convert(target)?;
+    }
+    surface.prune();
+    let mask = mask.map(|m| crate::commands::mask_at_depth(LayerMask { surface: m.clone(), ..LayerMask::reveal_all() }, d.doc.depth)).transpose()?;
+    s.edit(label, |doc, active| {
+        let mut layer = Layer::raster(name, target);
+        *crate::pixels_mut(&mut layer)? = surface;
+        layer.mask = mask;
+        let id = crate::layer_place::insert_new(doc, *active, layer, crate::layer_place::Place::AutoEditable);
+        *active = Some(id);
+        Ok(id)
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn session() -> Session {
+        let mut s = Session::new();
+        s.execute("file.new", json!({"width": 64, "height": 48, "background": "white"})).unwrap();
+        s
+    }
+
+    #[test]
+    fn without_a_selection_the_zone_is_the_canvas() {
+        let s = session();
+        let z = zone(&s, 0.25).unwrap();
+        assert_eq!(z.context, Rect::new(0, 0, 64, 48));
+        assert!(z.selected.is_none());
+    }
+
+    #[test]
+    fn a_selection_adds_context_inside_the_canvas_and_masks_the_new_layer() {
+        let mut s = session();
+        s.execute("select.rect", json!({"x": 40, "y": 10, "width": 20, "height": 20, "antiAlias": false})).unwrap();
+        let z = zone(&s, 0.25).unwrap();
+        assert_eq!(z.selected, Some(Rect::new(40, 10, 60, 30)));
+        assert_eq!(z.context, Rect::new(35, 5, 64, 35));
+        let layers = s.active().unwrap().doc.layers.len();
+        let px = [200u8, 200, 200, 255].repeat(z.context.width() as usize * z.context.height() as usize);
+        let id = place(&mut s, "Generative Fill", "IA", z.context, &px, z.selection.as_ref()).unwrap();
+        let d = s.active().unwrap();
+        assert_eq!(d.doc.layers.len(), layers + 1);
+        assert_eq!(d.active_layer, Some(id));
+        assert!(d.doc.layer(id).unwrap().mask.is_some());
+        assert!(d.doc.selection.is_some());
+        let shown = composite_rgba8(&d.doc, Rect::new(0, 0, 64, 48));
+        assert_eq!(shown[20 * 64 + 50], [200, 200, 200, 255], "inside the selection: the new pixels");
+        assert_ne!(shown[20 * 64 + 36][0], 200, "outside it the mask hides them");
+    }
+
+    #[test]
+    fn a_wrong_size_is_an_error_not_a_panic() {
+        let mut s = session();
+        assert!(place(&mut s, "x", "x", Rect::new(0, 0, 4, 4), &[0; 10], None).is_err());
+    }
+}
