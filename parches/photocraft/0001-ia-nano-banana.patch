+fn ajustes(ui: &mut egui::Ui, e: &mut Estado, p: &Plan, ideogram: bool) {
+    let h = e.herramienta;
+    ui.add_space(2.0);
+    if h == Herramienta::Expandir {
+        fila(ui, "Proporción", |ui| {
+            let actual = e.proporcion;
+            craft_ui::ComboBox::from_id_salt("jacnex-ia-proporcion").width(ui.available_width()).selected_text(actual.nombre()).show_ui(ui, |ui| {
+                for pr in Proporcion::TODAS {
+                    ui.selectable_value(&mut e.proporcion, pr, pr.nombre());
+                }
+            });
+        });
+        if let Some((nw, nh)) = lienzo_expandido(p.lienzo.width(), p.lienzo.height(), e.proporcion) {
+            fila(ui, "", |ui| ui.label(RichText::new(format!("Quedará de {nw} × {nh} px")).small()));
+        }
+    }
+    if h == Herramienta::MejorarResolucion {
+        fila(ui, "Aumento", |ui| {
+            let opciones: Vec<String> = [2u32, 4]
+                .iter()
+                .map(|f| format!("×{f} · {} × {}", p.lienzo.width().saturating_mul(*f), p.lienzo.height().saturating_mul(*f)))
+                .collect();
+            if let Some(i) = segmentos(ui, &opciones, usize::from(e.factor() == 4)) {
+                e.factor = if i == 1 { 4 } else { 2 };
+            }
+        });
+    }
+    if h == Herramienta::QuitarObjeto {
+        fila(ui, "Motor", |ui| {
+            let ideo = match e.costo_ideogram() {
+                Some(c) => format!("Ideogram · {}", creditos(c)),
+                None => "Ideogram".to_string(),
+            };
+            let elegida = usize::from(e.motor_quitar == MotorQuitar::Ideogram);
+            match segmentos(ui, &["En tu PC".into(), ideo], elegida) {
+                Some(0) => e.motor_quitar = MotorQuitar::Local,
+                Some(_) => e.motor_quitar = MotorQuitar::Ideogram,
+                None => {}
+            }
+        });
+        let nota = match e.motor_quitar {
+            MotorQuitar::Local => "En segundos: cables, manchas, cosas pequeñas.",
+            MotorQuitar::Ideogram => "En la nube: zonas grandes o fondos complejos.",
+        };
+        fila(ui, "", |ui| ui.label(RichText::new(nota).small()));
+    }
+    if h.usa_modelo() {
+        let actual = e.modelo_actual();
+        let ofrece_ideogram = h == Herramienta::Relleno && p.con_seleccion;
+        let costo_ideo = e.costo_ideogram();
+        let elegido = if ideogram { "Ideogram 3.0".to_string() } else { actual.nombre.clone() };
+        let pista = if ideogram { DESCRIPCION_IDEOGRAM.to_string() } else { actual.descripcion.clone() };
+        let modelos = e.modelos();
+        fila(ui, "Modelo", |ui| {
+            craft_ui::ComboBox::from_id_salt("jacnex-ia-modelo").width(ui.available_width()).selected_text(elegido).show_ui(ui, |ui| {
+                for m in &modelos {
+                    let texto = match m.costo("1k") {
+                        Some(c) => format!("{} · desde {}", m.nombre, creditos(c)),
+                        None => m.nombre.clone(),
+                    };
+                    if ui.selectable_label(!ideogram && m.id == actual.id, texto).on_hover_text(m.descripcion.as_str()).clicked() {
+                        e.modelo = m.id.clone();
+                    }
+                }
+                if ofrece_ideogram {
+                    let texto = match costo_ideo {
+                        Some(c) => format!("Ideogram 3.0 · {}", creditos(c)),
+                        None => "Ideogram 3.0".to_string(),
+                    };
+                    if ui.selectable_label(ideogram, texto).on_hover_text(DESCRIPCION_IDEOGRAM).clicked() {
+                        e.modelo = IDEOGRAM.into();
+                    }
+                }
+            });
+        });
+        if !pista.is_empty() {
+            let pista = if h == Herramienta::Texto { format!("{pista} GPT Image 2 es el que mejor escribe texto.") } else { pista };
+            fila(ui, "", |ui| ui.add(egui::Label::new(RichText::new(pista).small()).wrap()));
+        }
+    }
+    if h.admite_variaciones() || ideogram {
+        fila(ui, "Variaciones", |ui| {
+            let opciones: Vec<String> = (1..=3).map(|n: u32| n.to_string()).collect();
+            if let Some(i) = segmentos(ui, &opciones, e.variaciones() as usize - 1) {
+                e.variaciones = i as u32 + 1;
+            }
+        });
+    }
+    ui.add_space(4.0);
+}
+
+/// El pie fijo: lo que costará, lo que quedará y el botón.
+fn pie(ui: &mut egui::Ui, e: &mut Estado, p: &Plan, repetir: bool, pide: &mut Pedidos) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let ancho = ui.available_width();
+    match e.trabajo.as_ref() {
+        Some(tr) => progreso(ui, tr),
+        None => {
+            let h = e.herramienta;
+            let n = if h.admite_variaciones() || e.usa_ideogram(p.con_seleccion) { e.variaciones() } else { 1 };
+            if let Some(c) = p.costo {
+                ui.horizontal(|ui| {
+                    let izq = if c == 0 {
+                        "En tu PC · 0 créditos".to_string()
+                    } else if n > 1 {
+                        format!("{n} variaciones · {}", creditos(c))
+                    } else {
+                        creditos(c)
+                    };
+                    ui.label(RichText::new(izq).small().strong().color(ACENTO_CLARO));
+                    if let Some(i) = &e.info
+                        && c > 0
+                    {
+                        ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                            if i.creditos >= c {
+                                ui.label(RichText::new(format!("Te quedan {}", miles(i.creditos - c))).small().color(t.text_faint));
+                            } else {
+                                ui.label(RichText::new(format!("Te faltan {}", miles(c - i.creditos))).small().color(ROJO));
+                            }
+                        });
+                    }
+                });
+                ui.add_space(2.0);
+            }
+            let icono = if repetir { "rotate-cw" } else { "sparkles" };
+            if boton_acento(ui, icono, &texto_generar(p.costo, repetir), egui::vec2(ancho, 36.0), p.falta.is_none()).clicked() {
+                pide.generar = true;
+            }
+            if let Some(f) = &p.falta {
+                ui.label(RichText::new(f.as_str()).small().color(t.text_dim));
+            }
+        }
+    }
+    if let Some((ok, m)) = &e.aviso {
+        ui.add_space(2.0);
+        ui.label(RichText::new(m.as_str()).small().color(if *ok { VERDE } else { ROJO }));
+    }
+    ui.add_space(2.0);
+}
+
+// --- Barra contextual bajo la selección ---------------------------------------------------------
+
+/// La barra se ofrece con una selección, una herramienta de selección, la opción Ventana › Barra
+/// de tareas contextual activa y sin diálogos (como la de Recortar, que tiene prioridad).
+fn barra_visible(app: &PhotocraftApp) -> bool {
+    app.ui.panels.context_task_bar
+        && app.ui.dialogs.is_empty()
+        && !crate::crop_task_bar::eligible(app)
+        && crate::canvas::tool_feedback::is_selection_tool(app.ui.tool)
+        && app.drag.is_none()
+        && app.session.active().is_some_and(|d| d.doc.selection.is_some())
+}
+
+/// Lo que se pidió desde la barra.
+enum Barra {
+    Nada,
+    Generar,
+    QuitarObjeto,
+    Variacion(usize),
+    Aplicar,
+    OtraVez,
+    Descartar,
+}
+
+/// El último resultado, si la barra lo ofrece: en este documento, sin aplicar y con la misma
+/// selección. (variación actual, cuántas, se puede generar otra vez).
+fn resultado_en_barra(app: &PhotocraftApp) -> Option<(usize, usize, bool)> {
+    let doc = app.session.active().map(|d| d.doc.id);
+    let e = &app.jacnex_ia;
+    let r = e.resultado.as_ref().filter(|r| r.aplicable && Some(r.doc) == doc && r.sel == seleccion_actual(app))?;
+    let otra = r.repetible && r.herramienta == e.herramienta;
+    Some((r.actual, r.variaciones.len(), otra))
+}
+
+/// Dibuja la barra bajo la selección del documento activo (desde la pasada de superposición del
+/// lienzo, en la pestaña de ese documento).
+pub fn barra(app: &mut PhotocraftApp, ui: &mut egui::Ui, xf: &ViewXform) {
+    if !barra_visible(app) {
+        app.jacnex_ia.barra_expandida = false;
+        return;
+    }
+    let Some(sel) = limites_seleccion(app) else { return };
+    let a = xf.to_screen(sel.x0 as f32, sel.y0 as f32);
+    let b = xf.to_screen(sel.x1 as f32, sel.y1 as f32);
+    let anchor = egui::Rect::from_two_pos(a, b);
+    let ctx = ui.ctx().clone();
+    let mut place = app.ui.panels.task_bar;
+    let resultado = if app.jacnex_ia.barra_expandida || app.jacnex_ia.trabajo.is_some() { None } else { resultado_en_barra(app) };
+    let costo = if app.jacnex_ia.barra_expandida || resultado.is_some_and(|r| r.2) { plan(app).and_then(|p| p.costo) } else { None };
+    let shown = task_bar::show(&ctx, &mut place, anchor, xf.rect, |ui, more| contenido_barra(app, ui, more, costo, resultado));
+    app.ui.panels.task_bar = place;
+    let Some(shown) = shown else { return };
+    if shown.hide {
+        app.ui.panels.context_task_bar = false;
+        return;
+    }
+    match shown.inner {
+        Barra::Nada => {}
+        Barra::Generar => {
+            otra_vez(app);
+            if app.jacnex_ia.trabajo.is_some() {
+                app.jacnex_ia.barra_expandida = false;
+            }
+        }
+        Barra::QuitarObjeto => {
+            app.jacnex_ia.elegir_herramienta(Herramienta::QuitarObjeto);
+            generar(app);
+        }
+        Barra::Variacion(i) => cambiar_variacion(app, i),
+        Barra::Aplicar => aplicar(app),
+        Barra::OtraVez => otra_vez(app),
+        Barra::Descartar => descartar(app),
+    }
+}
+
+/// Los límites de la selección activa dentro del lienzo, medidos solo cuando la selección cambia.
+fn limites_seleccion(app: &mut PhotocraftApp) -> Option<Rect> {
+    let d = app.session.active()?;
+    let sel = d.doc.selection.as_ref()?;
+    let clave = (d.doc.id, d.revision, sel.tile_bounds());
+    match &app.jacnex_ia.limites {
+        Some((c, r)) if *c == clave => *r,
+        _ => {
+            let r = Some(sel.content_bounds().intersect(&d.doc.bounds())).filter(|r| !r.is_empty());
+            app.jacnex_ia.limites = Some((clave, r));
+            r
+        }
+    }
+}
+
+fn contenido_barra(
+    app: &mut PhotocraftApp,
+    ui: &mut egui::Ui,
+    more: &mut task_bar::MoreMenu,
+    costo: Option<i64>,
+    resultado: Option<(usize, usize, bool)>,
+) -> Barra {
+    let mut pedido = Barra::Nada;
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let e = &mut app.jacnex_ia;
+    if let Some(tr) = e.trabajo.as_ref() {
+        ui.add(egui::Spinner::new().color(ACENTO));
+        ui.label(format!("{}  {} s", tr.etapa, tr.inicio.elapsed().as_secs()));
+    } else if let Some((actual, total, otra)) = resultado {
+        // Después de generar: elegir la variación y aplicar, sin ir al panel.
+        if total > 1 {
+            ui.add_enabled_ui(actual > 0, |ui| {
+                if crate::icons::button(ui, "chevron-left", task_bar::BUTTON, false, "Variación anterior").clicked() {
+                    pedido = Barra::Variacion(actual - 1);
+                }
+            });
+            ui.label(RichText::new(format!("{} / {total}", actual + 1)).strong().color(t.text));
+            ui.add_enabled_ui(actual + 1 < total, |ui| {
+                if crate::icons::button(ui, "chevron-right", task_bar::BUTTON, false, "Variación siguiente").clicked() {
+                    pedido = Barra::Variacion(actual + 1);
+                }
+            });
+            crate::widgets::vline(ui, 18.0);
+        }
+        if boton_aplicar(ui, "Aplicar", egui::vec2(0.0, task_bar::BUTTON)).on_hover_text("Combina el resultado con la capa de abajo").clicked() {
+            pedido = Barra::Aplicar;
+        }
+        if otra {
+            let tip = match costo {
+                Some(c) if c > 0 => format!("Generar de nuevo · {}", creditos(c)),
+                _ => "Generar de nuevo".to_string(),
+            };
+            if boton_plano(ui, "rotate-cw", "Otra vez", t.icon).on_hover_text(tip).clicked() {
+                pedido = Barra::OtraVez;
+            }
+        }
+        if boton_plano(ui, "x", "Descartar", t.icon).on_hover_text("Quita este resultado (Ctrl+Z lo recupera)").clicked() {
+            pedido = Barra::Descartar;
+        }
+    } else if !e.barra_expandida {
+        if boton_plano(ui, "sparkles", "Relleno generativo", ACENTO_CLARO).on_hover_text("Añade o cambia algo en tu selección con IA").clicked() {
+            e.barra_expandida = true;
+            if !matches!(e.herramienta, Herramienta::Relleno | Herramienta::Texto) {
+                e.elegir_herramienta(Herramienta::Relleno);
+            }
+            pedir_info(e);
+        }
+        let tip = match e.motor_quitar {
+            MotorQuitar::Local => "Borra lo seleccionado y rellena con lo de alrededor (en tu PC)",
+            MotorQuitar::Ideogram => "Borra lo seleccionado y rellena con lo que habría detrás (Ideogram)",
+        };
+        if boton_plano(ui, "eraser", "Quitar objeto", t.icon).on_hover_text(tip).clicked() {
+            pedir_info(e);
+            pedido = Barra::QuitarObjeto;
+        }
+        if crate::icons::button(ui, "sliders-horizontal", task_bar::BUTTON, false, "Más herramientas de IA").clicked() {
+            e.abierta = true;
+            pedir_info(e);
+        }
+    } else {
+        let r = ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Describe qué poner…").desired_width(240.0).margin(egui::vec2(8.0, 4.0)));
+        let r = r.on_hover_text("Déjalo vacío para quitar lo seleccionado");
+        let enter = r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter));
+        if boton_acento(ui, "sparkles", &texto_generar(costo, false), egui::vec2(0.0, task_bar::BUTTON), true).clicked() || enter {
+            if e.herramienta != Herramienta::Relleno {
+                e.elegir_herramienta(Herramienta::Relleno);
+            }
+            pedido = Barra::Generar;
+        }
+        if crate::icons::button(ui, "sliders-horizontal", task_bar::BUTTON, false, "Modelo, variaciones y más herramientas").clicked() {
+            e.abierta = true;
+        }
+        if crate::icons::button(ui, "x", task_bar::BUTTON, false, "Cerrar").clicked() {
+            e.barra_expandida = false;
+        }
+    }
+    more.show(ui);
+    if let Some((false, m)) = &e.aviso
+        && e.trabajo.is_none()
+    {
+        ui.colored_label(ROJO, "(!)").on_hover_text(m.as_str());
+    }
+    pedido
+}
