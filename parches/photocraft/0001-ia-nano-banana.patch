+#[test]
+fn the_menu_opens_the_guided_window() {
+    let mut h = harness();
+    // Un servidor que no responde: la prueba no lee la sesión real de Jacnex Studio.
+    assert!(ia::usar_servidor_local(h.state_mut(), "http://127.0.0.1:9", "jk_x"));
+    let item = photocraft_ui_egui::menus::menu_items(h.state()).into_iter().find(|i| i.id == "jacnex.ia").expect("en el menú");
+    assert_eq!(item.path, vec!["Edit".to_string()]);
+    assert!(item.enabled);
+    let ctx = h.ctx.clone();
+    photocraft_ui_egui::menus::invoke(h.state_mut(), &ctx, "jacnex.ia", Value::Null).unwrap();
+    h.run_steps(6);
+    assert!(h.state().jacnex_ia.abierta);
+    assert!(h.get_all_by_label("IA de Jacnex").count() >= 1);
+    // El modelo por defecto y su descripción, aunque el servidor no responda.
+    h.get_by_label_contains("Rápido y muy bueno para el día a día");
+    h.get_by_label("HERRAMIENTA");
+    h.get_by_label_contains("Generar");
+    // Las herramientas, en el desplegable.
+    h.get_by_label("Relleno generativo").click();
+    h.run_steps(3);
+    for herramienta in ["Quitar fondo", "Expandir imagen", "Mejorar resolución", "Texto con IA", "Retoques en un clic", "Generar fondo"] {
+        h.get_by_label(herramienta);
+    }
+    // Cada herramienta se dibuja sin fallar.
+    evidencia(&mut h, "panel-menu-herramientas");
+    h.key_press(egui::Key::Escape);
+    for herramienta in Herramienta::TODAS {
+        h.state_mut().jacnex_ia.herramienta = herramienta;
+        h.run_steps(3);
+        evidencia(&mut h, &format!("panel-{herramienta:?}"));
+    }
+}
