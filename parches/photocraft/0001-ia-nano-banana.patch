+
+impl Estado {
+    fn variaciones(&self) -> u32 {
+        self.variaciones.clamp(1, 3)
+    }
+
+    fn factor(&self) -> u32 {
+        if self.factor == 4 { 4 } else { 2 }
+    }
+
+    /// Los modelos de imagen, de más a menos usados: los del servidor, o los conocidos mientras
+    /// no responde.
+    fn modelos(&self) -> Vec<ModeloInfo> {
+        let mut lista = match &self.info {
+            Some(i) if i.modelos.iter().any(|m| !m.herramienta) => i.modelos.iter().filter(|m| !m.herramienta).cloned().collect(),
+            _ => modelos_base(),
+        };
+        lista.sort_by_key(|m| POPULARIDAD.iter().position(|p| *p == m.id).unwrap_or(POPULARIDAD.len()));
+        lista
+    }
+
+    fn modelo_actual(&self) -> ModeloInfo {
+        let lista = self.modelos();
+        let id = if self.modelo.is_empty() { MODELO } else { self.modelo.as_str() };
+        lista.iter().find(|m| m.id == id).or_else(|| lista.iter().find(|m| m.id == MODELO)).or(lista.first()).cloned().unwrap_or_else(|| ModeloInfo {
+            id: MODELO.into(),
+            nombre: "Google Nano Banana 2".into(),
+            descripcion: String::new(),
+            herramienta: false,
+            aspectos: Vec::new(),
+            creditos: Vec::new(),
+        })
+    }
+
+    /// Va a Ideogram: Quitar objeto con ese motor, o Relleno generativo con una selección y
+    /// Ideogram elegido en la lista.
+    fn usa_ideogram(&self, con_seleccion: bool) -> bool {
+        match self.herramienta {
+            Herramienta::QuitarObjeto => self.motor_quitar == MotorQuitar::Ideogram,
+            Herramienta::Relleno => con_seleccion && self.modelo == IDEOGRAM,
+            _ => false,
+        }
+    }
+
+    /// Quitar objeto gratis, en este equipo.
+    fn quitar_local(&self) -> bool {
+        self.herramienta == Herramienta::QuitarObjeto && self.motor_quitar == MotorQuitar::Local
+    }
+
+    /// Lo que cuesta una imagen de Ideogram, según el servidor.
+    fn costo_ideogram(&self) -> Option<i64> {
+        self.herramienta_servidor(IDEOGRAM).and_then(|t| t.costo("unica"))
+    }
+
+    fn herramienta_servidor(&self, id: &str) -> Option<&ModeloInfo> {
+        self.info.as_ref()?.modelos.iter().find(|m| m.id == id)
+    }
+
+    fn elegir_herramienta(&mut self, h: Herramienta) {
+        if h == self.herramienta {
+            return;
+        }
+        if h == Herramienta::Texto {
+            self.modelo = MODELO_TEXTO.into();
+        } else if self.herramienta == Herramienta::Texto && self.modelo == MODELO_TEXTO {
+            self.modelo.clear();
+        }
+        self.herramienta = h;
+        self.aviso = None;
+    }
+}
