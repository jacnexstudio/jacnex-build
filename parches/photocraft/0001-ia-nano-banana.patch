+// --- Imágenes ---------------------------------------------------------------------------------
+
+/// `src` (RGBA8, `sw`×`sh`) escalada para cubrir `dw`×`dh` sin deformarse (lo que sobra se recorta
+/// del centro), con interpolación bilineal y, al reducir mucho, un promedio previo por bloques.
+fn cubrir(src: &[u8], sw: u32, sh: u32, dw: u32, dh: u32) -> Vec<u8> {
+    let mut out = vec![0u8; dw as usize * dh as usize * 4];
+    if sw == 0 || sh == 0 || dw == 0 || dh == 0 || src.len() < sw as usize * sh as usize * 4 {
+        return out;
+    }
+    if (sw, sh) == (dw, dh) {
+        let n = out.len();
+        out.copy_from_slice(&src[..n]);
+        return out;
+    }
+    // Reducciones de más de la mitad: primero bloques enteros, para no perder detalle a saltos.
+    let factor = ((sw as f32 / dw as f32).min(sh as f32 / dh as f32) / 2.0).floor().max(1.0) as u32;
+    let (src, sw, sh) = if factor > 1 { reducir(src, sw, sh, factor) } else { (src.to_vec(), sw, sh) };
+    let escala = (dw as f32 / sw as f32).max(dh as f32 / sh as f32);
+    let ox = (sw as f32 - dw as f32 / escala) / 2.0;
+    let oy = (sh as f32 - dh as f32 / escala) / 2.0;
+    let px = |x: usize, y: usize, c: usize| src[(y * sw as usize + x) * 4 + c] as f32;
+    for y in 0..dh as usize {
+        let fy = (oy + (y as f32 + 0.5) / escala - 0.5).clamp(0.0, (sh - 1) as f32);
+        let (y0, ty) = (fy.floor() as usize, fy.fract());
+        let y1 = (y0 + 1).min(sh as usize - 1);
+        for x in 0..dw as usize {
+            let fx = (ox + (x as f32 + 0.5) / escala - 0.5).clamp(0.0, (sw - 1) as f32);
+            let (x0, tx) = (fx.floor() as usize, fx.fract());
+            let x1 = (x0 + 1).min(sw as usize - 1);
+            let o = (y * dw as usize + x) * 4;
+            for c in 0..4 {
+                let a = px(x0, y0, c) + (px(x1, y0, c) - px(x0, y0, c)) * tx;
+                let b = px(x0, y1, c) + (px(x1, y1, c) - px(x0, y1, c)) * tx;
+                out[o + c] = (a + (b - a) * ty).round().clamp(0.0, 255.0) as u8;
+            }
+        }
+    }
+    out
+}
+
+/// Promedio por bloques de `f`×`f`.
+fn reducir(src: &[u8], sw: u32, sh: u32, f: u32) -> (Vec<u8>, u32, u32) {
+    let (w, h) = ((sw / f).max(1), (sh / f).max(1));
+    let mut out = vec![0u8; w as usize * h as usize * 4];
+    for y in 0..h as usize {
+        for x in 0..w as usize {
+            let mut s = [0u32; 4];
+            let mut n = 0u32;
+            for yy in y * f as usize..((y + 1) * f as usize).min(sh as usize) {
+                for xx in x * f as usize..((x + 1) * f as usize).min(sw as usize) {
+                    let o = (yy * sw as usize + xx) * 4;
+                    for c in 0..4 {
+                        s[c] += src[o + c] as u32;
+                    }
+                    n += 1;
+                }
+            }
+            let o = (y * w as usize + x) * 4;
+            for c in 0..4 {
+                out[o + c] = (s[c] / n.max(1)) as u8;
+            }
+        }
+    }
+    (out, w, h)
+}
+
+/// `w`×`h` escalado para que el lado largo sea a lo sumo `max`, manteniendo la forma.
+fn caber(w: u32, h: u32, max: u32) -> (u32, u32) {
+    let largo = w.max(h).max(1);
+    if largo <= max {
+        return (w.max(1), h.max(1));
+    }
+    let f = max as f32 / largo as f32;
+    (((w as f32 * f).round() as u32).max(1), ((h as f32 * f).round() as u32).max(1))
+}
+
+/// El tamaño de envío a un modelo de imagen.
+fn tamano_envio(w: u32, h: u32) -> (u32, u32) {
+    caber(w, h, MAX_LADO)
+}
+
+/// El tamaño de envío a Quitar fondo: lado largo ≤ 2048 y corto ≥ 256 (agrandando si hace falta).
+fn tamano_recorte(w: u32, h: u32) -> Result<(u32, u32), String> {
+    let (w, h) = caber(w, h, MAX_LADO_RECORTE);
+    let corto = w.min(h).max(1);
+    if corto >= MIN_LADO_RECORTE {
+        return Ok((w, h));
+    }
+    let f = MIN_LADO_RECORTE as f32 / corto as f32;
+    let (nw, nh) = (((w as f32 * f).round() as u32).max(MIN_LADO_RECORTE), ((h as f32 * f).round() as u32).max(MIN_LADO_RECORTE));
+    if nw.max(nh) > 4096 { Err("La imagen es demasiado alargada para quitarle el fondo.".into()) } else { Ok((nw, nh)) }
+}
+
+/// `rect` agrandado (sin deformar lo que contiene) a la proporción de `aspectos` más cercana:
+/// primero dentro de `lienzo`, y si no cabe, centrado sobre él (lo que sale fuera se rellena al
+/// enviar y se descarta al colocar). Sin proporciones, `rect` tal cual.
+fn ajustar_aspecto(rect: Rect, lienzo: Rect, aspectos: &[(u32, u32)]) -> (Rect, Option<(u32, u32)>) {
+    let (w, h) = (f64::from(rect.width().max(1)), f64::from(rect.height().max(1)));
+    let Some(&a) = aspectos.iter().min_by(|x, y| {
+        let d = |p: &(u32, u32)| ((f64::from(p.0) / f64::from(p.1)).ln() - (w / h).ln()).abs();
+        d(x).total_cmp(&d(y))
+    }) else {
+        return (rect, None);
+    };
+    let r = f64::from(a.0) / f64::from(a.1);
+    let (nw, nh) = if w / h < r { ((h * r).round(), h) } else { (w, (w / r).round()) };
+    let (nw, nh) = (nw.min(f64::from(i32::MAX / 4)) as i32, nh.min(f64::from(i32::MAX / 4)) as i32);
+    let colocar = |a0: i32, len: i32, nlen: i32, l0: i32, l1: i32| -> i32 {
+        let ini = a0 - (nlen - len) / 2;
+        if nlen <= l1 - l0 { ini.clamp(l0, l1 - nlen) } else { l0 - (nlen - (l1 - l0)) / 2 }
+    };
+    let x0 = colocar(rect.x0, rect.width() as i32, nw, lienzo.x0, lienzo.x1);
+    let y0 = colocar(rect.y0, rect.height() as i32, nh, lienzo.y0, lienzo.y1);
+    (Rect::new(x0, y0, x0 + nw, y0 + nh), Some(a))
+}
+
+/// Lo visible del documento en `zona`, RGBA8, sobre gris donde es transparente o cae fuera de
+/// `lienzo` (`.3` = alfa original, para Quitar fondo).
+fn vista(doc: &photocraft_doc::Document, zona: Rect, lienzo: Rect) -> Vec<u8> {
+    let dentro = zona.intersect(&lienzo);
+    let (w, h) = (zona.width() as usize, zona.height() as usize);
+    let mut out = Vec::with_capacity(w * h * 4);
+    for _ in 0..w * h {
+        out.extend_from_slice(&[GRIS[0], GRIS[1], GRIS[2], 255]);
+    }
+    if dentro.is_empty() {
+        return out;
+    }
+    let px = motor::composite_rgba8(doc, dentro);
+    let (dw, ox, oy) = (dentro.width() as usize, (dentro.x0 - zona.x0) as usize, (dentro.y0 - zona.y0) as usize);
+    for (i, p) in px.iter().enumerate() {
+        let (x, y) = (i % dw + ox, i / dw + oy);
+        let o = (y * w + x) * 4;
+        let a = u32::from(p[3]);
+        for c in 0..3 {
+            out[o + c] = ((u32::from(p[c]) * a + u32::from(GRIS[c]) * (255 - a) + 127) / 255) as u8;
+        }
+    }
+    out
+}
+
+/// El trozo `sub` (dentro de `zona`) de `px` (RGBA8 o de un byte por píxel, `canales`).
+fn recortar(px: &[u8], zona: Rect, sub: Rect, canales: usize) -> Vec<u8> {
+    let sub = sub.intersect(&zona);
+    let (zw, sw) = (zona.width() as usize, sub.width() as usize);
+    let mut out = Vec::with_capacity(sw * sub.height() as usize * canales);
+    for y in sub.y0..sub.y1 {
+        let ini = (((y - zona.y0) as usize) * zw + (sub.x0 - zona.x0) as usize) * canales;
+        if let Some(fila) = px.get(ini..ini + sw * canales) {
+            out.extend_from_slice(fila);
+        }
+    }
+    out
+}
+
+fn codificar(rgba: Vec<u8>, w: u32, h: u32, formato: photocraft_codecs::Format, layout: photocraft_codecs::ChannelLayout) -> Result<Vec<u8>, String> {
+    let img = photocraft_codecs::Image::from_u8(w, h, layout, rgba).map_err(|e| e.to_string())?;
+    let op = photocraft_codecs::EncodeOptions { jpeg_quality: 92, ..Default::default() };
+    photocraft_codecs::encode(&img, formato, &op).map_err(|e| format!("No se pudo preparar la imagen: {e}"))
+}
+
+/// RGBA8 (opaca) a JPEG: mucho más liviana que PNG, así se sube rápido.
+fn jpg(rgba: &[u8], w: u32, h: u32, nombre: &'static str) -> Result<Archivo, String> {
+    let rgb: Vec<u8> = rgba.as_chunks::<4>().0.iter().flat_map(|p| [p[0], p[1], p[2]]).collect();
+    Ok(Archivo { nombre, tipo: "image/jpeg", datos: codificar(rgb, w, h, photocraft_codecs::Format::Jpeg, photocraft_codecs::ChannelLayout::Rgb)? })
+}
+
+/// Una máscara (un byte por píxel) a PNG en escala de grises.
+fn png_gris(gris: Vec<u8>, w: u32, h: u32) -> Result<Archivo, String> {
+    Ok(Archivo {
+        nombre: "mascara.png",
+        tipo: "image/png",
+        datos: codificar(gris, w, h, photocraft_codecs::Format::Png, photocraft_codecs::ChannelLayout::Gray)?,
+    })
+}
+
+/// Una máscara de un byte por píxel escalada a `dw`×`dh`.
+fn escalar_gris(gris: &[u8], w: u32, h: u32, dw: u32, dh: u32) -> Vec<u8> {
+    let rgba: Vec<u8> = gris.iter().flat_map(|&v| [v, v, v, 255]).collect();
+    cubrir(&rgba, w, h, dw, dh).as_chunks::<4>().0.iter().map(|p| p[0]).collect()
+}
+
+/// El alfa de `img` escalado a `w`×`h`.
+fn alfa_de(img: &Img, w: u32, h: u32) -> Vec<u8> {
+    let rgba: Vec<u8> = img.rgba.as_chunks::<4>().0.iter().flat_map(|p| [p[3], p[3], p[3], 255]).collect();
+    cubrir(&rgba, img.ancho, img.alto, w, h).as_chunks::<4>().0.iter().map(|p| p[0]).collect()
+}
+
+/// La máscara de Expandir en `zona`: blanca (generar) fuera de `original`, negra dentro, con un
+/// borde suave de `suave` px hacia dentro en los lados que tocan lo nuevo, para que no se note
+/// la unión.
+fn mascara_expandir(zona: Rect, original: Rect, suave: i32) -> Vec<u8> {
+    let (w, h) = (zona.width() as usize, zona.height() as usize);
+    let mut out = vec![255u8; w * h];
+    let suave = suave.max(1);
+    let lados = [original.x0 > zona.x0, original.x1 < zona.x1, original.y0 > zona.y0, original.y1 < zona.y1];
+    for y in original.y0.max(zona.y0)..original.y1.min(zona.y1) {
+        for x in original.x0.max(zona.x0)..original.x1.min(zona.x1) {
+            let mut d = i32::MAX;
+            for (lado, dist) in lados.iter().zip([x - original.x0, original.x1 - 1 - x, y - original.y0, original.y1 - 1 - y]) {
+                if *lado {
+                    d = d.min(dist);
+                }
+            }
+            let v = if d >= suave { 0 } else { (255 - (d * 255 / suave)).clamp(0, 255) as u8 };
+            out[(y - zona.y0) as usize * w + (x - zona.x0) as usize] = v;
+        }
+    }
+    out
+}
