diff --git a/crates/ui-egui/tests/it/jacnex_ia.rs b/crates/ui-egui/tests/it/jacnex_ia.rs
new file mode 100644
index 000000000..a958779a2
--- /dev/null
+++ b/crates/ui-egui/tests/it/jacnex_ia.rs
@@ -0,0 +1,543 @@
+//! Jacnex: la IA integrada (`jacnex_ia`). Con una selección, la barra contextual ofrece
+//! «Relleno generativo»; Generar envía la zona y su máscara al servidor, y el resultado vuelve como
+//! una capa nueva recortada por la selección (un solo paso de historial). Las demás herramientas
+//! (variaciones, Quitar fondo, Generar fondo, Expandir, Mejorar resolución) se prueban igual.
+//! Relleno con selección va a Ideogram 3.0 (foto + máscara negra); Quitar objeto se hace gratis en
+//! este equipo (MI-GAN, sin pedir nada al servidor) o con Ideogram.
+//!
+//! La app entera corre en un arnés de egui_kittest; el servidor es uno falso en 127.0.0.1 que
+//! responde como /v1/jacnex de Forgenex. Con `JACNEX_IA_PRUEBA=<url>|<llave>` la prueba de la barra
+//! va contra un Forgenex local de verdad (con kie.ai simulado).
+
+use std::collections::HashMap;
+use std::io::{BufRead, BufReader, Read, Write};
+use std::net::TcpListener;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use egui::vec2;
+use egui_kittest::kittest::Queryable;
+use photocraft_geom::Rect;
+use photocraft_ui_egui::PhotocraftApp;
+use photocraft_ui_egui::control::{ControlRequest, Outcome, handle};
+use photocraft_ui_egui::jacnex_ia::{self as ia, Herramienta, Proporcion};
+use serde_json::{Value, json};
+
+type Harness = egui_kittest::Harness<'static, PhotocraftApp>;
+
+const ROJO: [u8; 4] = [220, 30, 40, 255];
+const VERDE: [u8; 4] = [30, 200, 60, 255];
+const AZUL: [u8; 4] = [30, 60, 220, 255];
+const BLANCO: [u8; 4] = [255, 255, 255, 255];
+
+fn harness() -> Harness {
+    let mut h = Harness::builder().with_size(vec2(1100.0, 760.0)).with_max_steps(64).build_eframe(|cc| {
+        PhotocraftApp::setup_context(&cc.egui_ctx, Default::default());
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), Default::default());
+        // JACNEX_IA_IDIOMA=auto: las capturas en el idioma predeterminado de Jacnex (español).
+        let idioma = std::env::var("JACNEX_IA_IDIOMA").unwrap_or_else(|_| "en".into());
+        app.session.prefs.edit(|p| p.interface.language = idioma);
+        app.run("file.new", json!({"width": 400, "height": 300, "background": "white"})).expect("new");
+        app
+    });
+    h.run_steps(4);
+    control(&mut h, "ui.set", json!({"tool": "rectMarquee", "zoom": 1.0, "center": [200, 150]}));
+    h
+}
+
+/// Con JACNEX_IA_EVIDENCIA=carpeta, guarda cómo se ve la interfaz (render fuera de pantalla).
+fn evidencia(h: &mut Harness, nombre: &str) {
+    if let Some(dir) = std::env::var_os("JACNEX_IA_EVIDENCIA") {
+        std::fs::create_dir_all(&dir).unwrap();
+        h.run_steps(3);
+        h.render().expect("render fuera de pantalla").save(std::path::Path::new(&dir).join(format!("{nombre}.png"))).unwrap();
+    }
+}
+
+fn control(h: &mut Harness, method: &str, params: Value) -> Value {
+    let ctx = h.ctx.clone();
+    let (req, _rx) = ControlRequest::new(method, params.clone());
+    let Outcome::Done(v) = handle(h.state_mut(), &ctx, &req) else { panic!("{method} {params}: not done") };
+    assert_eq!(v["ok"], true, "{method} {params}: {v}");
+    h.run_steps(4);
+    v
+}
+
+/// Lo que el servidor falso recibió: el cuerpo de cada /generar.
+#[derive(Default)]
+struct Recibido {
+    generar: Vec<String>,
+}
+
+fn png(w: u32, h: u32, px: impl Fn(u32, u32) -> [u8; 4]) -> Vec<u8> {
+    let mut datos = Vec::with_capacity((w * h * 4) as usize);
+    for y in 0..h {
+        for x in 0..w {
+            datos.extend_from_slice(&px(x, y));
+        }
+    }
+    let img = photocraft_codecs::Image::from_u8(w, h, photocraft_codecs::ChannelLayout::Rgba, datos).unwrap();
+    photocraft_codecs::encode(&img, photocraft_codecs::Format::Png, &photocraft_codecs::EncodeOptions::default()).unwrap()
+}
+
+/// Un campo de texto del formulario multipart.
+fn campo(cuerpo: &str, nombre: &str) -> Option<String> {
+    let marca = format!("name=\"{nombre}\"\r\n\r\n");
+    let ini = cuerpo.find(&marca)? + marca.len();
+    Some(cuerpo[ini..].split("\r\n").next()?.to_string())
+}
+
+/// Un /v1/jacnex falso: estado (catálogo), generar (un trabajo por variación), trabajo (listo a la
+/// segunda consulta) y las imágenes: un color por variación; Quitar fondo devuelve la mitad
+/// izquierda opaca; Mejorar resolución, el doble del lienzo de las pruebas.
+fn servidor_falso() -> (String, Arc<Mutex<Recibido>>) {
+    let l = TcpListener::bind("127.0.0.1:0").unwrap();
+    let base = format!("http://127.0.0.1:{}", l.local_addr().unwrap().port());
+    let recibido = Arc::new(Mutex::new(Recibido::default()));
+    let (r2, base2) = (recibido.clone(), base.clone());
+    std::thread::spawn(move || {
+        // id → (resultado, consultas).
+        let mut trabajos: HashMap<String, (String, u32)> = HashMap::new();
+        let mut siguiente = 0;
+        for s in l.incoming() {
+            let Ok(mut s) = s else { continue };
+            let mut lector = BufReader::new(s.try_clone().unwrap());
+            let mut linea = String::new();
+            if lector.read_line(&mut linea).is_err() {
+                continue;
+            }
+            let (mut largo, mut auth) = (0usize, String::new());
+            loop {
+                let mut h = String::new();
+                if lector.read_line(&mut h).unwrap_or(0) == 0 {
+                    break;
+                }
+                let h = h.trim_end();
+                if h.is_empty() {
+                    break;
+                }
+                let (k, v) = h.split_once(':').unwrap_or((h, ""));
+                match k.to_ascii_lowercase().as_str() {
+                    "content-length" => largo = v.trim().parse().unwrap(),
+                    "authorization" => auth = v.trim().to_string(),
+                    _ => {}
+                }
+            }
+            let mut cuerpo = vec![0; largo];
+            let _ = lector.read_exact(&mut cuerpo);
+            let ruta = linea.split_whitespace().nth(1).unwrap_or("").to_string();
+            let (estado, tipo, datos): (u16, &str, Vec<u8>) = if let Some(r) = ruta.strip_prefix("/r/") {
+                let datos = match r {
+                    "quitar-fondo.png" => png(64, 48, |x, _| if x < 32 { [250, 250, 250, 255] } else { [0, 0, 0, 0] }),
+                    "mejorar-resolucion.png" => png(800, 600, |_, _| AZUL),
+                    "1.png" => png(64, 48, |_, _| VERDE),
+                    "2.png" => png(64, 48, |_, _| AZUL),
+                    _ => png(64, 48, |_, _| ROJO),
+                };
+                (200, "image/png", datos)
+            } else if auth != "Bearer jk_prueba" {
+                (401, "application/json", br#"{"error":{"message":"Llave no valida"}}"#.to_vec())
+            } else if ruta.starts_with("/v1/jacnex/estado") {
+                let gemini = ["1:1", "4:5", "3:4", "2:3", "9:16", "4:3", "3:2", "16:9", "21:9"];
+                let v = json!({"nombre": "Prueba", "creditos": 100, "modelos": [
+                    {"id": "nano-banana", "nombre": "Nano Banana", "proveedor": "Google", "tipo": "imagen", "descripcion": "Económico", "aspectos": gemini, "creditos": {"unica": 9}},
+                    {"id": "nano-banana-2", "nombre": "Nano Banana 2", "proveedor": "Google", "tipo": "imagen", "descripcion": "Día a día", "aspectos": gemini, "creditos": {"1k": 12, "2k": 18}},
+                    {"id": "gpt-image-2", "nombre": "GPT Image 2", "proveedor": "OpenAI", "tipo": "imagen", "descripcion": "Texto", "aspectos": ["1:1", "4:3", "3:4", "3:2", "2:3", "16:9", "9:16"], "creditos": {"1k": 15, "2k": 25, "4k": 40}},
+                    {"id": "ideogram-edit", "nombre": "Ideogram 3.0", "proveedor": "Ideogram", "tipo": "herramienta", "aspectos": [], "creditos": {"unica": 7}},
+                    {"id": "quitar-fondo", "nombre": "Quitar fondo", "proveedor": "Recraft", "tipo": "herramienta", "aspectos": [], "creditos": {"unica": 5}},
+                    {"id": "mejorar-resolucion", "nombre": "Mejorar resolución", "proveedor": "Topaz Labs", "tipo": "herramienta", "aspectos": [], "creditos": {"x2": 25, "x4": 50}}
+                ]});
+                (200, "application/json", v.to_string().into_bytes())
+            } else if ruta == "/v1/jacnex/generar" {
+                let texto = String::from_utf8_lossy(&cuerpo).into_owned();
+                let modelo = campo(&texto, "model").unwrap_or_default();
+                let n: usize = campo(&texto, "n").and_then(|n| n.parse().ok()).unwrap_or(1);
+                r2.lock().unwrap().generar.push(texto);
+                let ids: Vec<String> = (0..n)
+                    .map(|i| {
+                        siguiente += 1;
+                        let id = format!("t{siguiente}");
+                        let archivo = if modelo == "quitar-fondo" || modelo == "mejorar-resolucion" { modelo.clone() } else { i.to_string() };
+                        trabajos.insert(id.clone(), (format!("{base2}/r/{archivo}.png"), 0));
+                        id
+                    })
+                    .collect();
+                (201, "application/json", json!({"id": ids[0], "ids": ids, "creditos": 9 * n, "saldo": 91}).to_string().into_bytes())
+            } else if let Some((url, consultas)) = ruta.strip_prefix("/v1/jacnex/trabajo/").and_then(|id| trabajos.get_mut(id)) {
+                *consultas += 1;
+                let v = if *consultas < 2 { json!({"estado": "procesando", "resultados": []}) } else { json!({"estado": "listo", "resultados": [url]}) };
+                (200, "application/json", v.to_string().into_bytes())
+            } else {
+                (404, "application/json", br#"{"error":{"message":"no"}}"#.to_vec())
+            };
+            let _ = write!(s, "HTTP/1.1 {estado} X\r\nContent-Type: {tipo}\r\nContent-Length: {}\r\nConnection: close\r\n\r\n", datos.len());
+            let _ = s.write_all(&datos);
+        }
+    });
+    (base, recibido)
+}
+
+fn pixel(app: &PhotocraftApp, x: i32, y: i32) -> [u8; 4] {
+    let d = app.session.active().unwrap();
+    photocraft_engine::jacnex_ia::composite_rgba8(&d.doc, Rect::new(x, y, x + 1, y + 1))[0]
+}
+
+/// Un arnés conectado al servidor falso.
+fn conectado() -> (Harness, Arc<Mutex<Recibido>>) {
+    let (servidor, recibido) = servidor_falso();
+    let mut h = harness();
+    assert!(ia::usar_servidor_local(h.state_mut(), &servidor, "jk_prueba"));
+    (h, recibido)
+}
+
+/// Pulsa Generar (por código) y espera a que el resultado se coloque.
+fn generar_y_esperar(h: &mut Harness) {
+    ia::generar(h.state_mut());
+    assert!(ia::ocupado(h.state()), "no empezó: {:?}", h.state().jacnex_ia.prompt);
+    let inicio = Instant::now();
+    while ia::hay_trabajo(h.state()) {
+        assert!(inicio.elapsed() < Duration::from_secs(60), "el resultado no llegó");
+        h.run_steps(2);
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    h.run_steps(4);
+}
+
+#[test]
+fn generative_fill_from_the_selection_bar_lands_as_a_masked_layer() {
+    let (servidor, llave, recibido) = match std::env::var("JACNEX_IA_PRUEBA").ok().and_then(|v| v.split_once('|').map(|(a, b)| (a.to_string(), b.to_string())))
+    {
+        Some((s, l)) => (s, l, None),
+        None => {
+            let (s, r) = servidor_falso();
+            (s, "jk_prueba".to_string(), Some(r))
+        }
+    };
+    let mut h = harness();
+    assert!(ia::usar_servidor_local(h.state_mut(), &servidor, &llave));
+    assert!(!ia::usar_servidor_local(h.state_mut(), "https://example.com", &llave), "solo esta máquina");
+    h.state_mut().run("select.rect", json!({"x": 100, "y": 100, "width": 120, "height": 80, "antiAlias": false})).unwrap();
+    h.run_steps(4);
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+
+    // La barra bajo la selección: primero el botón (y Quitar objeto), luego el campo y Generar.
+    h.get_by_label("Quitar objeto");
+    h.get_all_by_label("Relleno generativo").next().expect("la barra ofrece Relleno generativo").click();
+    h.run_steps(4);
+    // Ideogram ya no es el predeterminado: se elige en la lista de modelos.
+    h.state_mut().jacnex_ia.modelo = "ideogram-edit".into();
+    h.state_mut().jacnex_ia.prompt = "flores rojas".into();
+    let inicio = Instant::now();
+    // El costo llega del servidor: Ideogram, «Generar · 7 créditos».
+    while h.query_all_by_label_contains("7 créditos").next().is_none() {
+        assert!(inicio.elapsed() < Duration::from_secs(10) || recibido.is_none(), "no llegó el costo");
+        if inicio.elapsed() > Duration::from_secs(10) {
+            break;
+        }
+        h.run_steps(2);
+        std::thread::sleep(Duration::from_millis(50));
+    }
+    h.get_all_by_label_contains("Generar").next().unwrap().click();
+    let inicio = Instant::now();
+    while h.state().session.active().unwrap().doc.layers.len() == capas {
+        assert!(inicio.elapsed() < Duration::from_secs(60), "el resultado no llegó: {:?}", h.state().jacnex_ia_aviso());
+        h.run_steps(2);
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    h.run_steps(4);
+
+    let app = h.state();
+    let d = app.session.active().unwrap();
+    assert_eq!(d.doc.layers.len(), capas + 1);
+    let capa = d.doc.layer(d.active_layer.unwrap()).unwrap();
+    assert!(capa.name.starts_with("IA · flores rojas"), "{}", capa.name);
+    assert!(capa.mask.is_some(), "recortada por la selección");
+    assert!(d.doc.selection.is_some(), "la selección sigue");
+    if recibido.is_some() {
+        assert_eq!(pixel(app, 160, 140), ROJO, "dentro de la selección: el resultado");
+    } else {
+        assert_ne!(pixel(app, 160, 140), BLANCO, "dentro de la selección: el resultado");
+    }
+    assert_eq!(pixel(app, 90, 90), BLANCO, "fuera: la imagen de antes");
+    if let Some(r) = recibido {
+        let r = r.lock().unwrap();
+        assert_eq!(r.generar.len(), 1);
+        let cuerpo = &r.generar[0];
+        assert_eq!(campo(cuerpo, "model").as_deref(), Some("ideogram-edit"));
+        assert!(cuerpo.contains("flores rojas. Photorealistic"));
+        assert_eq!(cuerpo.matches("name=\"image\"").count(), 2, "la zona y su máscara");
+        assert!(cuerpo.contains("Content-Type: image/jpeg"), "la foto va en JPEG");
+        assert!(cuerpo.contains("Content-Type: image/png"), "la máscara en PNG");
+        // Ideogram no lleva tamaño ni proporción: la imagen y la máscara ya la tienen.
+        assert_eq!(campo(cuerpo, "size"), None);
+        assert_eq!(campo(cuerpo, "aspect"), None);
+        assert_eq!(campo(cuerpo, "n").as_deref(), Some("1"));
+    }
+
+    // Un solo Ctrl+Z quita el resultado.
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas);
+}
+
+#[test]
+fn after_generating_the_bar_offers_apply_again_and_discard() {
+    let (mut h, recibido) = conectado();
+    h.state_mut().run("select.rect", json!({"x": 100, "y": 100, "width": 120, "height": 80, "antiAlias": false})).unwrap();
+    h.run_steps(4);
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    h.state_mut().jacnex_ia.prompt = "flores rojas".into();
+    generar_y_esperar(&mut h);
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1);
+
+    // La barra cambia a: Aplicar · Otra vez · Descartar.
+    h.get_by_label("Aplicar");
+    h.get_by_label("Descartar");
+    h.get_by_label("Otra vez").click();
+    h.run_steps(2);
+    assert!(ia::ocupado(h.state()), "Otra vez no empezó: {:?}", h.state().jacnex_ia_aviso());
+    let inicio = Instant::now();
+    while ia::hay_trabajo(h.state()) {
+        assert!(inicio.elapsed() < Duration::from_secs(60), "el resultado no llegó");
+        h.run_steps(2);
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    h.run_steps(4);
+    assert_eq!(recibido.lock().unwrap().generar.len(), 2);
+    // El resultado anterior se cambió por el nuevo (no se apilan).
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1);
+
+    h.get_by_label("Descartar").click();
+    h.run_steps(3);
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas);
+    // Y la barra vuelve a ofrecer la IA.
+    h.get_by_label("Quitar objeto");
+    // Ctrl+Z recupera lo descartado.
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1);
+}
+
+#[test]
+fn three_variations_switch_without_paying_again_and_apply_merges_down() {
+    let (mut h, recibido) = conectado();
+    h.state_mut().run("select.rect", json!({"x": 100, "y": 100, "width": 120, "height": 80, "antiAlias": false})).unwrap();
+    h.run_steps(4);
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    let e = &mut h.state_mut().jacnex_ia;
+    e.prompt = "un gato".into();
+    e.variaciones = 3;
+    generar_y_esperar(&mut h);
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1, "{:?}", h.state().jacnex_ia_aviso());
+    assert_eq!(pixel(h.state(), 160, 140), ROJO, "la primera variación");
+    {
+        let r = recibido.lock().unwrap();
+        assert_eq!(r.generar.len(), 1, "un solo pedido");
+        assert_eq!(campo(&r.generar[0], "n").as_deref(), Some("3"));
+    }
+
+    evidencia(&mut h, "barra-resultado");
+    h.state_mut().jacnex_ia.abierta = true;
+    evidencia(&mut h, "panel-resultados");
+    h.state_mut().jacnex_ia.abierta = false;
+    h.run_steps(2);
+    ia::cambiar_variacion(h.state_mut(), 2);
+    h.run_steps(2);
+    assert_eq!(pixel(h.state(), 160, 140), AZUL, "la tercera");
+    ia::cambiar_variacion(h.state_mut(), 1);
+    assert_eq!(pixel(h.state(), 160, 140), VERDE, "la segunda");
+    assert_eq!(recibido.lock().unwrap().generar.len(), 1, "cambiar no vuelve a pedir");
+    assert_eq!(pixel(h.state(), 90, 90), BLANCO);
+
+    ia::aplicar(h.state_mut());
+    h.run_steps(2);
+    let d = h.state().session.active().unwrap();
+    assert_eq!(d.doc.layers.len(), capas, "combinada con la de abajo");
+    assert_eq!(pixel(h.state(), 160, 140), VERDE, "el resultado queda en la imagen");
+    assert_eq!(pixel(h.state(), 90, 90), BLANCO);
+}
