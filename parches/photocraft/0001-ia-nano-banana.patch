+++ b/crates/engine/src/jacnex_ia.rs
@@ -0,0 +1,242 @@
+//! Jacnex: what Photonex's built-in AI (`photocraft-ui-egui`'s `jacnex_ia`) needs from the
+//! document: the area it works on, that area's pixels as the person sees them, and the result
+//! placed back as a new layer (masked by the selection, one undo step).
+
+use photocraft_color::PixelFormat;
+use photocraft_doc::{Document, Layer, LayerId, LayerMask};
+use photocraft_geom::Rect;
+use photocraft_raster::Surface;
+
+use crate::{EngineError, Result, Session};
+
+/// The area the AI looks at and draws in, in document pixels.
+#[derive(Clone, Debug)]
+pub struct Zone {
+    /// What is sent to the model: the selection's bounds and some of what surrounds them (so it
+    /// can match light and perspective), or the whole canvas without a selection.
+    pub context: Rect,
+    /// The selection's bounds inside the canvas; `None` without a selection.
+    pub selected: Option<Rect>,
+    /// The selection itself (coverage), to mask the new layer with.
+    pub selection: Option<Surface>,
+}
+
+/// The area of the active document: see [`Zone`]. `margin` is the share of the selection's size
+/// added on each side as context (0.25 = a quarter). `None` without a document or when the
+/// selection lies outside the canvas.
+pub fn zone(s: &Session, margin: f32) -> Option<Zone> {
+    let d = s.active()?;
+    let canvas = d.doc.bounds();
+    if canvas.is_empty() {
+        return None;
+    }
+    let Some(sel) = d.doc.selection.as_ref() else { return Some(Zone { context: canvas, selected: None, selection: None }) };
+    let bounds = sel.content_bounds().intersect(&canvas);
+    if bounds.is_empty() {
+        return None;
+    }
+    Some(Zone { context: context_rect(bounds, canvas, margin), selected: Some(bounds), selection: Some(sel.clone()) })
+}
+
+/// `bounds` grown by `margin` of its size on each side, inside `canvas` (see [`zone`]).
+pub fn context_rect(bounds: Rect, canvas: Rect, margin: f32) -> Rect {
+    let pad = |len: u32| ((len as f32 * margin.clamp(0.0, 2.0)).round() as i32).max(0);
+    let (px, py) = (pad(bounds.width()), pad(bounds.height()));
+    Rect::new(bounds.x0.saturating_sub(px), bounds.y0.saturating_sub(py), bounds.x1.saturating_add(px), bounds.y1.saturating_add(py)).intersect(&canvas)
+}
+
+/// The visible composite (what the canvas shows, without the checkerboard) in `r`, as RGBA8.
+pub fn composite_rgba8(doc: &Document, r: Rect) -> Vec<[u8; 4]> {
+    let fmt = doc.pixel_format();
+    let flat = photocraft_compose::flatten_to_surface(doc, PixelFormat::new(fmt.mode, fmt.sample, true), None);
+    let mut px = vec![[0u8; 4]; r.width() as usize * r.height() as usize];
+    flat.read_rgba8_into(r, &mut px);
+    px
+}
+
+/// The coverage of `selection` in `r` (0 = not selected, 255 = selected), one byte a pixel.
+pub fn coverage(selection: &Surface, r: Rect) -> Vec<u8> {
+    let mut px = vec![[0u8; 4]; r.width() as usize * r.height() as usize];
+    selection.read_rgba8_into(r, &mut px);
+    px.into_iter().map(|p| p[0]).collect()
+}
+
+/// Adds `rgba` (interleaved RGBA8 covering `r`) to the active document as a new layer named
+/// `name` above the active one, masked by `mask` (a selection) when given. One history step
+/// labelled `label`; the selection stays, as after Generative Fill in the reference application.
+pub fn place(s: &mut Session, label: &str, name: &str, r: Rect, rgba: &[u8], mask: Option<&Surface>) -> Result<LayerId> {
+    let (surface, mask, fmt) = prepare(s, r, rgba, mask)?;
+    s.edit(label, |doc, active| {
+        let mut layer = Layer::raster(name, fmt);
+        *crate::pixels_mut(&mut layer)? = surface;
+        layer.mask = mask;
+        let id = crate::layer_place::insert_new(doc, *active, layer, crate::layer_place::Place::AutoEditable);
+        *active = Some(id);
+        Ok(id)
+    })
+}
+
+/// The largest side [`open_as_document`] accepts (Upscale ×4 of a 2048 px image).
+pub const MAX_SIDE: u32 = 16_384;
+
+/// A GRAY8 mask covering `r` from one byte a pixel (255 = shown), for [`place`]. `None` when the
+/// sizes do not match.
+pub fn mask_from_gray(r: Rect, gray: &[u8]) -> Option<Surface> {
+    (!r.is_empty() && gray.len() == r.width() as usize * r.height() as usize).then(|| Surface::from_interleaved(PixelFormat::GRAY8, r, gray))
+}
+
+/// [`place`] for a cutout (Remove Background): the new layer is masked by `mask` and every other
+/// top-level layer is hidden in the same step, so the subject shows on transparency. The hidden
+/// layers stay in the document; showing them again (or Ctrl+Z) brings the background back.
+pub fn place_alone(s: &mut Session, label: &str, name: &str, r: Rect, rgba: &[u8], mask: &Surface) -> Result<LayerId> {
+    let (surface, mask, fmt) = prepare(s, r, rgba, Some(mask))?;
+    s.edit(label, |doc, active| {
+        let mut layer = Layer::raster(name, fmt);
+        *crate::pixels_mut(&mut layer)? = surface;
+        layer.mask = mask;
+        let id = layer.id;
+        for l in doc.layers.iter_mut() {
+            l.visible = false;
+        }
+        // At the top of the stack, outside any group: it is the only thing left to see.
+        let index = doc.layers.len();
+        doc.layers.insert(index, layer);
+        *active = Some(id);
+        Ok(id)
+    })
+}
+
+fn prepare(s: &Session, r: Rect, rgba: &[u8], mask: Option<&Surface>) -> Result<(Surface, Option<LayerMask>, PixelFormat)> {
+    if r.is_empty() || rgba.len() != r.width() as usize * r.height() as usize * 4 {
+        return Err(EngineError::Other("the generated image does not match its area".into()));
+    }
+    let d = s.active().ok_or(EngineError::NoDocument)?;
+    let fmt = d.doc.pixel_format();
+    let target = PixelFormat::new(fmt.mode, fmt.sample, true);
+    let mut surface = Surface::from_interleaved(PixelFormat::RGBA8, r, rgba);
+    if surface.format() != target {
+        surface = surface.try_convert(target)?;
+    }
+    surface.prune();
+    let mask = mask.map(|m| crate::commands::mask_at_depth(LayerMask { surface: m.clone(), ..LayerMask::reveal_all() }, d.doc.depth)).transpose()?;
+    Ok((surface, mask, target))
+}
+
+/// Replaces the pixels of layer `id` in the active document with `rgba` covering `r` (switching
+/// between the variations of one generation). One history step labelled `label`.
+pub fn replace_pixels(s: &mut Session, label: &str, id: LayerId, r: Rect, rgba: &[u8]) -> Result<()> {
+    let (surface, _, _) = prepare(s, r, rgba, None)?;
+    if s.active().and_then(|d| d.doc.layer(id)).is_none() {
+        return Err(EngineError::Other("the AI layer is no longer in the document".into()));
+    }
+    s.edit(label, |doc, active| {
+        let layer = doc.layer_mut(id).ok_or_else(|| EngineError::Other("the AI layer is no longer in the document".into()))?;
+        *crate::pixels_mut(layer)? = surface;
+        *active = Some(id);
+        Ok(())
+    })
+}
+
+/// Opens `rgba` (`width`×`height`, RGBA8) as a new RGB 8-bit document named `name` with one
+/// layer, and makes it active. Returns its index.
+pub fn open_as_document(s: &mut Session, name: &str, width: u32, height: u32, rgba: &[u8]) -> Result<usize> {
+    if width == 0 || height == 0 || width > MAX_SIDE || height > MAX_SIDE || rgba.len() != width as usize * height as usize * 4 {
+        return Err(EngineError::Other("the image does not have a usable size".into()));
+    }
+    let mut doc = Document::new(name, photocraft_geom::Size::new(width, height), photocraft_color::ColorMode::Rgb, photocraft_color::SampleType::U8);
+    let mut layer = Layer::raster("Imagen", PixelFormat::RGBA8);
+    let mut surface = Surface::from_interleaved(PixelFormat::RGBA8, Rect::new(0, 0, width as i32, height as i32), rgba);
+    surface.prune();
+    *crate::pixels_mut(&mut layer)? = surface;
+    let id = layer.id;
+    doc.layers.push(layer);
+    let i = s.add_document(doc, None);
+    if let Some(d) = s.active_mut() {
+        d.active_layer = Some(id);
+    }
+    Ok(i)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    fn session() -> Session {
+        let mut s = Session::new();
+        s.execute("file.new", json!({"width": 64, "height": 48, "background": "white"})).unwrap();
+        s
+    }
+
+    #[test]
+    fn without_a_selection_the_zone_is_the_canvas() {
+        let s = session();
+        let z = zone(&s, 0.25).unwrap();
+        assert_eq!(z.context, Rect::new(0, 0, 64, 48));
+        assert!(z.selected.is_none());
+    }
+
+    #[test]
+    fn a_selection_adds_context_inside_the_canvas_and_masks_the_new_layer() {
+        let mut s = session();
+        s.execute("select.rect", json!({"x": 40, "y": 10, "width": 20, "height": 20, "antiAlias": false})).unwrap();
+        let z = zone(&s, 0.25).unwrap();
+        assert_eq!(z.selected, Some(Rect::new(40, 10, 60, 30)));
+        assert_eq!(z.context, Rect::new(35, 5, 64, 35));
+        let layers = s.active().unwrap().doc.layers.len();
+        let px = [200u8, 200, 200, 255].repeat(z.context.width() as usize * z.context.height() as usize);
+        let id = place(&mut s, "Generative Fill", "IA", z.context, &px, z.selection.as_ref()).unwrap();
+        let d = s.active().unwrap();
+        assert_eq!(d.doc.layers.len(), layers + 1);
+        assert_eq!(d.active_layer, Some(id));
+        assert!(d.doc.layer(id).unwrap().mask.is_some());
+        assert!(d.doc.selection.is_some());
+        let shown = composite_rgba8(&d.doc, Rect::new(0, 0, 64, 48));
+        assert_eq!(shown[20 * 64 + 50], [200, 200, 200, 255], "inside the selection: the new pixels");
+        assert_ne!(shown[20 * 64 + 36][0], 200, "outside it the mask hides them");
+    }
+
+    #[test]
+    fn a_wrong_size_is_an_error_not_a_panic() {
+        let mut s = session();
+        assert!(place(&mut s, "x", "x", Rect::new(0, 0, 4, 4), &[0; 10], None).is_err());
+    }
+
+    #[test]
+    fn a_cutout_hides_the_rest_and_variations_swap_in_one_step() {
+        let mut s = session();
+        let r = Rect::new(0, 0, 64, 48);
+        let px = [10u8, 20, 30, 255].repeat(64 * 48);
+        let mut gray = vec![0u8; 64 * 48];
+        gray[..64 * 24].fill(255);
+        let mask = mask_from_gray(r, &gray).unwrap();
+        assert!(mask_from_gray(r, &[0; 3]).is_none());
+        let id = place_alone(&mut s, "Remove Background", "IA", r, &px, &mask).unwrap();
+        let d = s.active().unwrap();
+        assert!(d.doc.layers.iter().filter(|l| l.id != id).all(|l| !l.visible));
+        assert_eq!(d.doc.layers.last().unwrap().id, id);
+        let shown = composite_rgba8(&d.doc, r);
+        assert_eq!(shown[10 * 64 + 5], [10, 20, 30, 255], "the kept half");
+        assert_eq!(shown[40 * 64 + 5][3], 0, "the removed half is transparent");
+
+        replace_pixels(&mut s, "Variation", id, r, &[90u8, 90, 90, 255].repeat(64 * 48)).unwrap();
+        assert_eq!(composite_rgba8(&s.active().unwrap().doc, r)[10 * 64 + 5], [90, 90, 90, 255]);
+        s.execute("edit.undo", json!({})).unwrap();
+        assert_eq!(composite_rgba8(&s.active().unwrap().doc, r)[10 * 64 + 5], [10, 20, 30, 255]);
+        assert!(replace_pixels(&mut s, "x", id, r, &[0; 7]).is_err());
+    }
+
+    #[test]
+    fn an_upscaled_result_opens_as_its_own_document() {
+        let mut s = session();
+        let i = open_as_document(&mut s, "Foto x2", 8, 6, &[1u8, 2, 3, 255].repeat(48)).unwrap();
+        assert_eq!(s.documents().len(), 2);
+        let d = s.active().unwrap();
+        assert_eq!(s.documents()[i].doc.id, d.doc.id);
+        assert_eq!((d.doc.size.width, d.doc.size.height), (8, 6));
+        assert_eq!(composite_rgba8(&d.doc, Rect::new(7, 5, 8, 6))[0], [1, 2, 3, 255]);
+        assert!(d.active_layer.is_some());
+        assert!(open_as_document(&mut s, "x", 0, 6, &[]).is_err());
+        assert!(open_as_document(&mut s, "x", 2, 2, &[0; 4]).is_err());
+    }
+}
diff --git a/crates/engine/src/jacnex_migan.rs b/crates/engine/src/jacnex_migan.rs
new file mode 100644
index 000000000..7d97c4354
--- /dev/null
+++ b/crates/engine/src/jacnex_migan.rs
@@ -0,0 +1,772 @@
+//! Jacnex: Remove Object on this computer, free and offline, with MI-GAN (Sargsyan et al.,
+//! "MI-GAN: A Simple Baseline for Image Inpainting on Mobile Devices", ICCV 2023; Picsart AI
+//! Research, MIT code and weights). The 512 px Places2 generator runs here in plain Rust: no
+//! runtime, no GPU, no download. Its weights (fp16) are compiled in from
+//! `assets/migan/migan-512.jxm`; notice in `assets/migan/LICENSE-WEIGHTS` and `ATTRIBUTION.md`.
+//!
+//! [`remove`] takes the photo and the area to remove, crops a square around that area (with
+//! 128 px of context on each side, at least 512 px), runs the network at 512×512 and blends the
+//! result back with a soft edge. Only the crop changes; it is returned with its position.
+
+use std::collections::HashMap;
+use std::sync::{Arc, OnceLock};
+
+use rayon::prelude::*;
+
+use crate::{EngineError, Result};
+
+/// The network's side, in pixels.
+const RES: usize = 512;
+/// Context kept around the area to remove, on each side, before scaling to [`RES`].
+const PADDING: usize = 128;
+/// The largest photo side accepted (the crop is what runs; this bounds the copies).
+pub const MAX_SIDE: u32 = 30_000;
+
+#[cfg(not(target_arch = "wasm32"))]
+static WEIGHTS: &[u8] = include_bytes!("../assets/migan/migan-512.jxm");
+/// The browser build does not carry the 13 MB of weights.
+#[cfg(target_arch = "wasm32")]
+static WEIGHTS: &[u8] = &[];
+
+/// What [`remove`] changed: the crop `(x, y, width, height)` and its new RGBA8 pixels.
+#[derive(Clone, Debug)]
+pub struct Filled {
+    pub x: u32,
+    pub y: u32,
+    pub width: u32,
+    pub height: u32,
+    pub rgba: Vec<u8>,
+}
+
+/// Whether the local model is in this build.
+pub fn available() -> bool {
+    model().is_ok()
+}
+
+/// How far around the hole's bounds (`width`×`height`) [`remove`] looks: a caller can cut the
+/// image to the hole's bounds grown by this on every side and get the same result.
+pub fn context_margin(width: u32, height: u32) -> u32 {
+    let side = (width.max(height) as usize).saturating_add(2 * PADDING).max(RES);
+    u32::try_from(side).unwrap_or(u32::MAX)
+}
+
+/// Fills `hole` (one byte a pixel, anything above 0 = remove) of `rgba` (`width`×`height`,
+/// RGBA8) with what could be behind it. `None`-like cases (nothing to remove, sizes that do not
+/// match) are errors, never panics.
+pub fn remove(rgba: &[u8], width: u32, height: u32, hole: &[u8]) -> Result<Filled> {
+    let (w, h) = (width as usize, height as usize);
+    if width == 0 || height == 0 || width > MAX_SIDE || height > MAX_SIDE {
+        return Err(EngineError::Other("the image does not have a usable size".into()));
+    }
+    let n = w.checked_mul(h).ok_or_else(|| EngineError::Other("the image is too large".into()))?;
+    if rgba.len() != n.saturating_mul(4) || hole.len() != n {
+        return Err(EngineError::Other("the image and the area to remove do not match".into()));
+    }
+    let (x0, x1, y0, y1) = crop_box(hole, w, h).ok_or_else(|| EngineError::Other("there is nothing to remove".into()))?;
+    let m = model().map_err(|e| EngineError::Other(e.clone()))?;
+    let (cw, ch) = (x1 - x0, y1 - y0);
+
+    // The crop, as floats, and its hole (1 = remove).
+    let mut img = vec![0f32; cw * ch * 3];
+    let mut holes = vec![0u8; cw * ch];
+    for y in 0..ch {
+        for x in 0..cw {
+            let s = (y0 + y) * w + x0 + x;
+            let d = y * cw + x;
+            for c in 0..3 {
+                img[d * 3 + c] = f32::from(rgba.get(s * 4 + c).copied().unwrap_or(0));
+            }
+            holes[d] = u8::from(hole.get(s).copied().unwrap_or(0) > 0);
+        }
+    }
+
+    // The network's input: known area − 0.5, then the photo in [−1, 1] with the hole blanked.
+    let small = resize(&img, cw, ch, RES, RES, 3);
+    let small_hole = shrink_hole(&holes, cw, ch, RES, RES);
+    let mut input = Map::new(RES, RES, 4);
+    for (p, px) in input.d.chunks_exact_mut(4).enumerate() {
+        let known = 1.0 - f32::from(small_hole.get(p).copied().unwrap_or(1));
+        px[0] = known - 0.5;
+        for c in 0..3 {
+            px[c + 1] = (small.get(p * 3 + c).copied().unwrap_or(0.0) * 2.0 / 255.0 - 1.0) * known;
+        }
+    }
+    let out = m.run(&input)?;
+    let out: Vec<f32> = out.d.iter().map(|v| ((v * 0.5 + 0.5) * 255.0).clamp(0.0, 255.0)).collect();
+    let out = resize(&out, RES, RES, cw, ch, 3);
+
+    // Blend: the known area, eroded by one pixel into the hole's edge and blurred, keeps the photo.
+    let keep = blend_mask(&holes, cw, ch);
+    let mut res = vec![0u8; cw * ch * 4];
+    for (d, px) in res.chunks_exact_mut(4).enumerate() {
+        let k = keep.get(d).copied().unwrap_or(1.0);
+        for c in 0..3 {
+            let a = img.get(d * 3 + c).copied().unwrap_or(0.0);
+            let b = out.get(d * 3 + c).copied().unwrap_or(0.0);
+            px[c] = (a * k + b * (1.0 - k)).round().clamp(0.0, 255.0) as u8;
+        }
+        px[3] = 255;
+    }
+    Ok(Filled { x: x0 as u32, y: y0 as u32, width: cw as u32, height: ch as u32, rgba: res })
+}
+
+/// The crop `(x0, x1, y0, y1)` (end exclusive) around the hole: a square of the hole's larger
+/// side plus [`PADDING`] on each side (at least [`RES`]), centred on it, moved and cut to fit.
+fn crop_box(hole: &[u8], w: usize, h: usize) -> Option<(usize, usize, usize, usize)> {
+    let (mut x_min, mut x_max, mut y_min, mut y_max) = (usize::MAX, 0, usize::MAX, 0);
+    for (y, row) in hole.chunks_exact(w).enumerate().take(h) {
+        for (x, &v) in row.iter().enumerate() {
+            if v > 0 {
+                x_min = x_min.min(x);
+                x_max = x_max.max(x);
+                y_min = y_min.min(y);
+                y_max = y_max.max(y);
+            }
+        }
+    }
+    if x_min == usize::MAX {
+        return None;
+    }
+    let side = (x_max - x_min).max(y_max - y_min) + 2 * PADDING;
+    let side = side.max(RES);
+    let half = side / 2;
+    let axis = |lo: usize, hi: usize, len: usize| {
+        let centre = (lo + hi) / 2;
+        let mut a = centre.saturating_sub(half);
+        let mut b = (centre + half).min(len);
+        // Cut at one border: give the rest to the other side.
+        let excess = side.saturating_sub(b - a);
+        a = a.saturating_sub(excess);
+        b = (b + excess).min(len);
+        (a, b)
+    };
+    let (x0, x1) = axis(x_min, x_max, w);
+    let (y0, y1) = axis(y_min, y_max, h);
+    (x1 > x0 && y1 > y0).then_some((x0, x1, y0, y1))
+}
+
+/// Resizes `src` (`sw`×`sh`, `c` interleaved channels) with a triangle filter that widens when
+/// shrinking, so a large crop does not alias when it goes down to 512.
+fn resize(src: &[f32], sw: usize, sh: usize, dw: usize, dh: usize, c: usize) -> Vec<f32> {
+    let horizontal = weights(sw, dw);
+    let vertical = weights(sh, dh);
+    let mut mid = vec![0f32; dw * sh * c];
+    mid.par_chunks_mut(dw * c).enumerate().for_each(|(y, row)| {
+        let line = src.get(y * sw * c..(y + 1) * sw * c).unwrap_or(&[]);
+        for (x, (start, ws)) in horizontal.iter().enumerate() {
+            for (i, wt) in ws.iter().enumerate() {
+                let s = (start + i) * c;
+                for k in 0..c {
+                    if let (Some(o), Some(v)) = (row.get_mut(x * c + k), line.get(s + k)) {
+                        *o += wt * v;
+                    }
+                }
+            }
+        }
+    });
+    let mut out = vec![0f32; dw * dh * c];
+    out.par_chunks_mut(dw * c).enumerate().for_each(|(y, row)| {
+        let Some((start, ws)) = vertical.get(y) else { return };
+        for (i, wt) in ws.iter().enumerate() {
+            let line = mid.get((start + i) * dw * c..(start + i + 1) * dw * c).unwrap_or(&[]);
+            for (o, v) in row.iter_mut().zip(line) {
+                *o += wt * v;
+            }
+        }
+    });
+    out
+}
+
+/// For each destination index, the first source index and the normalised weights.
+fn weights(src: usize, dst: usize) -> Vec<(usize, Vec<f32>)> {
+    let scale = src as f32 / dst as f32;
+    let support = scale.max(1.0);
+    (0..dst)
+        .map(|i| {
+            let centre = (i as f32 + 0.5) * scale;
+            let lo = ((centre - support).floor().max(0.0)) as usize;
+            let hi = ((centre + support).ceil() as usize).min(src);
+            let mut ws: Vec<f32> = (lo..hi).map(|j| (1.0 - ((j as f32 + 0.5 - centre) / support).abs()).max(0.0)).collect();
+            let sum: f32 = ws.iter().sum();
+            if sum > 0.0 {
+                ws.iter_mut().for_each(|v| *v /= sum);
+            } else {
+                // A degenerate span: take the nearest pixel.
+                ws = vec![1.0];
+                return ((centre as usize).min(src.saturating_sub(1)), ws);
+            }
+            (lo, ws)
+        })
+        .collect()
+}
+
+/// The hole at `dw`×`dh`: a destination pixel is a hole when any source pixel under it is, so a
+/// thin wire does not vanish when a large crop goes down to 512.
+fn shrink_hole(src: &[u8], sw: usize, sh: usize, dw: usize, dh: usize) -> Vec<u8> {
+    let span = |i: usize, s: usize, d: usize| {
+        let a = i * s / d;
+        let b = ((i + 1) * s).div_ceil(d).max(a + 1).min(s);
+        a..b
+    };
+    let mut out = vec![0u8; dw * dh];
+    out.par_chunks_mut(dw).enumerate().for_each(|(y, row)| {
+        let ys = span(y, sh, dh);
+        for (x, o) in row.iter_mut().enumerate() {
+            let xs = span(x, sw, dw);
+            *o = u8::from(ys.clone().any(|sy| src.get(sy * sw + xs.start..sy * sw + xs.end).is_some_and(|r| r.iter().any(|&v| v > 0))));
+        }
+    });
+    out
+}
+
+/// How much of the photo to keep (1 = all): the known area grown by one pixel (3×3 max), then a
+/// 5×5 Gaussian blur (reflected at the borders).
+fn blend_mask(holes: &[u8], w: usize, h: usize) -> Vec<f32> {
+    let known = |x: usize, y: usize| holes.get(y * w + x).is_some_and(|&v| v == 0);
+    let mut grown = vec![0f32; w * h];
+    grown.par_chunks_mut(w).enumerate().for_each(|(y, row)| {
+        for (x, o) in row.iter_mut().enumerate() {
+            let any = (y.saturating_sub(1)..(y + 2).min(h)).any(|yy| (x.saturating_sub(1)..(x + 2).min(w)).any(|xx| known(xx, yy)));
+            *o = if any { 1.0 } else { 0.0 };
+        }
+    });
+    let g: Vec<f32> = (0..5).map(|i| (-((i as f32 - 2.0) / 2.0).powi(2)).exp()).collect();
+    let sum: f32 = g.iter().sum();
+    let g: Vec<f32> = g.iter().map(|v| v / sum).collect();
+    let reflect = |i: isize, n: usize| -> usize {
+        let n = n as isize;
+        if n == 1 {
+            return 0;
+        }
+        let mut i = i;
+        if i < 0 {
+            i = -i;
+        }
+        if i >= n {
+            i = 2 * (n - 1) - i;
+        }
+        i.clamp(0, n - 1) as usize
+    };
+    let mut mid = vec![0f32; w * h];
+    mid.par_chunks_mut(w).enumerate().for_each(|(y, row)| {
+        for (x, o) in row.iter_mut().enumerate() {
+            *o = g.iter().enumerate().map(|(k, gv)| gv * grown.get(y * w + reflect(x as isize + k as isize - 2, w)).copied().unwrap_or(0.0)).sum();
+        }
+    });
+    let mut out = vec![0f32; w * h];
+    out.par_chunks_mut(w).enumerate().for_each(|(y, row)| {
+        for (x, o) in row.iter_mut().enumerate() {
+            *o = g.iter().enumerate().map(|(k, gv)| gv * mid.get(reflect(y as isize + k as isize - 2, h) * w + x).copied().unwrap_or(0.0)).sum();
+        }
+    });
+    out
+}
+
+// --- The network ---------------------------------------------------------------------------------
+
+/// A feature map, channels last (`(y * w + x) * c + channel`).
+#[derive(Clone)]
+struct Map {
+    w: usize,
+    h: usize,
+    c: usize,
+    d: Vec<f32>,
+}
+
+impl Map {
+    fn new(w: usize, h: usize, c: usize) -> Self {
+        Map { w, h, c, d: vec![0.0; w * h * c] }
+    }
+}
+
+/// A 1×1 convolution, weights stored input-major (`i * outputs + o`).
+struct Pointwise {
+    inputs: usize,
+    outputs: usize,
+    w: Vec<f32>,
+    bias: Option<Vec<f32>>,
+}
+
+/// MI-GAN's separable convolution: 3×3 per channel (with bias) and activation, optionally a 2×
+/// blur-downsample, a 1×1 mix, optionally a 2× upsample, optional fixed noise, activation.
+struct Separable {
+    channels: usize,
+    /// 3×3 taps, tap-major (`tap * channels + c`).
+    depthwise: Vec<f32>,
+    depthwise_bias: Vec<f32>,
+    mix: Pointwise,
+    down: bool,
+    up: bool,
+    noise: Option<Vec<f32>>,
+}
+
+struct Model {
+    from_rgb: Pointwise,
+    /// Encoder blocks from 512 to 4 px: (conv1, conv2).
+    encoder: Vec<(Separable, Separable)>,
+    /// Synthesis blocks from 4 to 512 px: (conv1, conv2, to-RGB).
+    synthesis: Vec<(Separable, Separable, Pointwise)>,
+}
+
+/// Encoder (and synthesis) block sizes.
+const SIZES: [usize; 8] = [512, 256, 128, 64, 32, 16, 8, 4];
+
+fn model() -> std::result::Result<&'static Arc<Model>, &'static String> {
+    static MODEL: OnceLock<std::result::Result<Arc<Model>, String>> = OnceLock::new();
+    MODEL.get_or_init(|| Model::load(WEIGHTS).map(Arc::new)).as_ref()
+}
+
+/// The activation: leaky ReLU (0.2), gain √2, clamped to ±256.
+#[inline]
+fn act(v: f32) -> f32 {
+    let v = if v < 0.0 { v * 0.2 } else { v };
+    (v * std::f32::consts::SQRT_2).clamp(-256.0, 256.0)
+}
+
+impl Model {
+    fn load(bytes: &[u8]) -> std::result::Result<Model, String> {
+        let mut t = read_tensors(bytes)?;
+        let mut take = |name: &str, shape: &[usize]| -> std::result::Result<Vec<f32>, String> {
+            let (s, v) = t.remove(name).ok_or_else(|| format!("the local model has no {name}"))?;
+            if s != shape {
+                return Err(format!("the local model's {name} has the wrong shape"));
+            }
+            Ok(v)
+        };
+        let pointwise = |take: &mut dyn FnMut(&str, &[usize]) -> std::result::Result<Vec<f32>, String>, name: &str, i: usize, o: usize, bias: bool| {
+            let w = take(&format!("{name}.weight"), &[o, i, 1, 1])?;
+            let mut t = vec![0f32; i * o];
+            for oo in 0..o {
+                for ii in 0..i {
+                    if let (Some(d), Some(s)) = (t.get_mut(ii * o + oo), w.get(oo * i + ii)) {
+                        *d = *s;
+                    }
+                }
+            }
+            let bias = if bias { Some(take(&format!("{name}.bias"), &[o])?) } else { None };
+            Ok::<_, String>(Pointwise { inputs: i, outputs: o, w: t, bias })
+        };
+        let separable = |take: &mut dyn FnMut(&str, &[usize]) -> std::result::Result<Vec<f32>, String>,
+                         name: &str,
+                         i: usize,
+                         o: usize,
+                         down: bool,
+                         up: bool,
+                         noise: Option<usize>| {
+            let dw = take(&format!("{name}.conv1.weight"), &[i, 1, 3, 3])?;
+            let mut depthwise = vec![0f32; 9 * i];
+            for c in 0..i {
+                for tap in 0..9 {
+                    if let (Some(d), Some(s)) = (depthwise.get_mut(tap * i + c), dw.get(c * 9 + tap)) {
+                        *d = *s;
+                    }
+                }
+            }
+            let depthwise_bias = take(&format!("{name}.conv1.bias"), &[i])?;
+            let mix = pointwise(take, &format!("{name}.conv2"), i, o, false)?;
+            let noise = match noise {
+                Some(r) => Some(take(&format!("{name}.noise"), &[r, r])?),
+                None => None,
+            };
+            Ok::<_, String>(Separable { channels: i, depthwise, depthwise_bias, mix, down, up, noise })
+        };
+        let ch = |r: usize| (32_768 / r).min(512);
+        let from_rgb = pointwise(&mut take, "encoder.b512.fromrgb", 4, ch(512), true)?;
+        let mut encoder = Vec::new();
+        for (k, &r) in SIZES.iter().enumerate() {
+            let next = SIZES.get(k + 1).copied();
+            let (i, o) = (ch(r), next.map(ch).unwrap_or(ch(r)));
+            let a = separable(&mut take, &format!("encoder.b{r}.conv1"), i, i, false, false, None)?;
+            let b = separable(&mut take, &format!("encoder.b{r}.conv2"), i, o, next.is_some(), false, None)?;
+            encoder.push((a, b));
+        }
+        let mut synthesis = Vec::new();
+        for &r in SIZES.iter().rev() {
+            // The 4 px block starts the image; each larger one doubles it, with noise.
+            let first = r == 4;
+            let (i, o) = if first { (ch(4), ch(4)) } else { (ch(r / 2), ch(r)) };
+            let noise = (!first).then_some(r);
+            let a = separable(&mut take, &format!("synthesis.b{r}.conv1"), i, o, false, !first, noise)?;
+            let b = separable(&mut take, &format!("synthesis.b{r}.conv2"), o, o, false, false, noise)?;
+            let rgb = pointwise(&mut take, &format!("synthesis.b{r}.torgb"), o, 3, true)?;
+            synthesis.push((a, b, rgb));
+        }
+        Ok(Model { from_rgb, encoder, synthesis })
+    }
+
+    /// The generator: `x` is 512×512×4 (known − 0.5, masked RGB); returns 512×512×3 in ~[−1, 1].
+    fn run(&self, x: &Map) -> Result<Map> {
+        if x.w != RES || x.h != RES || x.c != 4 {
+            return Err(EngineError::Other("the local model got the wrong input".into()));
+        }
+        let mut h = pointwise(x, &self.from_rgb, true);
+        let mut feats = Vec::with_capacity(SIZES.len());
+        for (a, b) in &self.encoder {
+            let f = separable(&h, a);
+            h = separable(&f, b);
+            feats.push(f);
+        }
+        let mut img: Option<Map> = None;
+        for (k, (a, b, rgb)) in self.synthesis.iter().enumerate() {
+            let feat = feats.get(SIZES.len() - 1 - k).ok_or_else(|| EngineError::Other("the local model is incomplete".into()))?;
+            let mut y = separable(&h, a);
+            if y.d.len() != feat.d.len() {
+                return Err(EngineError::Other("the local model's sizes do not match".into()));
+            }
+            y.d.iter_mut().zip(&feat.d).for_each(|(v, f)| *v += f);
+            h = separable(&y, b);
+            let mut out = pointwise(&h, rgb, false);
+            if let Some(prev) = img.take() {
+                let up = upsample(&prev);
+                if up.d.len() != out.d.len() {
+                    return Err(EngineError::Other("the local model's sizes do not match".into()));
+                }
+                out.d.iter_mut().zip(&up.d).for_each(|(v, u)| *v += u);
+            }
+            img = Some(out);
+        }
+        img.ok_or_else(|| EngineError::Other("the local model is incomplete".into()))
+    }
+}
+
+/// A 1×1 convolution (a matrix product over channels), activated when `activate`.
+fn pointwise(x: &Map, p: &Pointwise, activate: bool) -> Map {
+    let (k, m) = (p.inputs, p.outputs);
+    let mut out = Map::new(x.w, x.h, m);
+    if x.c != k {
+        return out;
+    }
+    const ROWS: usize = 32;
+    out.d.par_chunks_mut(ROWS * m).zip(x.d.par_chunks(ROWS * k)).for_each(|(o, a)| {
+        let rows = o.len() / m;
+        if let Some(b) = &p.bias {
+            for row in o.chunks_exact_mut(m) {
+                row.copy_from_slice(b);
+            }
+        }
+        if m % 16 == 0 {
+            for j0 in (0..m).step_by(16) {
+                let mut r = 0;
+                while r + 4 <= rows {
+                    kernel4x16(a, &p.w, o, r, j0, k, m);
+                    r += 4;
+                }
+                for rr in r..rows {
+                    for (kk, bv) in p.w.chunks_exact(m).enumerate() {
+                        let av = a.get(rr * k + kk).copied().unwrap_or(0.0);
+                        for j in j0..j0 + 16 {
+                            if let (Some(c), Some(b)) = (o.get_mut(rr * m + j), bv.get(j)) {
+                                *c += av * b;
+                            }
+                        }
+                    }
+                }
+            }
+        } else {
+            for rr in 0..rows {
+                for (kk, bv) in p.w.chunks_exact(m).enumerate() {
+                    let av = a.get(rr * k + kk).copied().unwrap_or(0.0);
+                    if let Some(c) = o.get_mut(rr * m..(rr + 1) * m) {
+                        c.iter_mut().zip(bv).for_each(|(c, b)| *c += av * b);
+                    }
+                }
+            }
+        }
+        if activate {
+            o.iter_mut().for_each(|v| *v = act(*v));
+        }
+    });
+    out
+}
+
+/// Four rows × sixteen outputs of `c += a · b`, held in registers across the whole sum.
+#[inline]
+fn kernel4x16(a: &[f32], b: &[f32], c: &mut [f32], r: usize, j0: usize, k: usize, m: usize) {
+    let (Some(a0), Some(a1), Some(a2), Some(a3)) =
+        (a.get(r * k..(r + 1) * k), a.get((r + 1) * k..(r + 2) * k), a.get((r + 2) * k..(r + 3) * k), a.get((r + 3) * k..(r + 4) * k))
+    else {
+        return;
+    };
+    let mut acc = [[0f32; 16]; 4];
+    for (kk, row) in b.chunks_exact(m).enumerate().take(k) {
+        let Some(bv) = row.get(j0..j0 + 16) else { return };
+        let (x0, x1, x2, x3) = (a0[kk], a1[kk], a2[kk], a3[kk]);
+        for j in 0..16 {
+            acc[0][j] += x0 * bv[j];
+            acc[1][j] += x1 * bv[j];
+            acc[2][j] += x2 * bv[j];
+            acc[3][j] += x3 * bv[j];
+        }
+    }
+    for (i, row) in acc.iter().enumerate() {
+        if let Some(dst) = c.get_mut((r + i) * m + j0..(r + i) * m + j0 + 16) {
+            dst.iter_mut().zip(row).for_each(|(d, v)| *d += v);
+        }
+    }
+}
+
+fn separable(x: &Map, s: &Separable) -> Map {
+    let mut y = depthwise3(x, &s.depthwise, &s.depthwise_bias, s.channels);
+    if s.down {
+        y = downsample(&y);
+    }
+    let mut y = pointwise(&y, &s.mix, false);
+    if s.up {
+        y = upsample(&y);
+    }
+    if let Some(n) = &s.noise {
+        if n.len() == y.w * y.h {
+            y.d.par_chunks_mut(y.c).zip(n.par_iter()).for_each(|(px, v)| px.iter_mut().for_each(|p| *p += v));
+        }
+    }
+    y.d.par_iter_mut().for_each(|v| *v = act(*v));
+    y
+}
+
+/// 3×3 per-channel convolution (zero padding) plus bias, then the activation.
+fn depthwise3(x: &Map, w: &[f32], bias: &[f32], c: usize) -> Map {
+    let mut out = Map::new(x.w, x.h, c);
+    if x.c != c {
+        return out;
+    }
+    let (xw, xh) = (x.w, x.h);
+    out.d.par_chunks_mut(xw * c).enumerate().for_each(|(y, row)| {
+        for (xx, px) in row.chunks_exact_mut(c).enumerate() {
+            px.copy_from_slice(bias.get(..c).unwrap_or(&[]).get(..px.len()).unwrap_or(&[]));
+            for ky in 0..3 {
+                let Some(sy) = (y + ky).checked_sub(1).filter(|&v| v < xh) else { continue };
+                for kx in 0..3 {
+                    let Some(sx) = (xx + kx).checked_sub(1).filter(|&v| v < xw) else { continue };
+                    let (Some(src), Some(wt)) = (x.d.get((sy * xw + sx) * c..(sy * xw + sx + 1) * c), w.get((ky * 3 + kx) * c..(ky * 3 + kx + 1) * c)) else {
+                        continue;
+                    };
+                    px.iter_mut().zip(src.iter().zip(wt)).for_each(|(p, (s, k))| *p += s * k);
+                }
+            }
+            px.iter_mut().for_each(|v| *v = act(*v));
+        }
+    });
+    out
+}
+
+/// The 4-tap blur filter [1, 3, 3, 1].
+const TAPS: [f32; 4] = [1.0, 3.0, 3.0, 1.0];
+
+/// 2× downsample: [1, 3, 3, 1]² / 64 blur, stride 2, one pixel of zero padding.
+fn downsample(x: &Map) -> Map {
+    let (w, h, c) = (x.w / 2, x.h / 2, x.c);
+    let mut out = Map::new(w, h, c);
+    out.d.par_chunks_mut(w * c).enumerate().for_each(|(y, row)| {
+        for (xx, px) in row.chunks_exact_mut(c).enumerate() {
+            for (ky, wy) in TAPS.iter().enumerate() {
+                let Some(sy) = (2 * y + ky).checked_sub(1).filter(|&v| v < x.h) else { continue };
+                for (kx, wx) in TAPS.iter().enumerate() {
+                    let Some(sx) = (2 * xx + kx).checked_sub(1).filter(|&v| v < x.w) else { continue };
+                    let k = wy * wx / 64.0;
+                    if let Some(src) = x.d.get((sy * x.w + sx) * c..(sy * x.w + sx + 1) * c) {
+                        px.iter_mut().zip(src).for_each(|(p, s)| *p += s * k);
+                    }
+                }
+            }
+        }
+    });
+    out
+}
+
+/// 2× upsample: zero insertion, then the [1, 3, 3, 1]² / 16 filter (padding 2 before, 1 after).
+fn upsample(x: &Map) -> Map {
+    let (w, h, c) = (x.w * 2, x.h * 2, x.c);
+    let mut out = Map::new(w, h, c);
+    out.d.par_chunks_mut(w * c).enumerate().for_each(|(y, row)| {
+        for (xx, px) in row.chunks_exact_mut(c).enumerate() {
+            for (ky, wy) in TAPS.iter().enumerate() {
+                // The zero-stuffed source row: only even rows hold pixels.
+                let Some(zy) = (y + ky).checked_sub(2).filter(|&v| v < h && v % 2 == 0) else { continue };
+                for (kx, wx) in TAPS.iter().enumerate() {
+                    let Some(zx) = (xx + kx).checked_sub(2).filter(|&v| v < w && v % 2 == 0) else { continue };
+                    let k = wy * wx / 16.0;
+                    let (sy, sx) = (zy / 2, zx / 2);
+                    if let Some(src) = x.d.get((sy * x.w + sx) * c..(sy * x.w + sx + 1) * c) {
+                        px.iter_mut().zip(src).for_each(|(p, s)| *p += s * k);
+                    }
+                }
+            }
+        }
+    });
+    out
+}
+
+// --- The weights file ------------------------------------------------------------------------------
+
+/// The largest tensor the file may declare (the biggest is 512×512).
+const MAX_TENSOR: usize = 1 << 22;
+
+/// Reads `JXMIGAN1`: a count, then per tensor a name (u16 length + UTF-8), its dimensions (u8
+/// count + u32 each) and its values as little-endian fp16. Hostile input gives an error.
+fn read_tensors(bytes: &[u8]) -> std::result::Result<HashMap<String, (Vec<usize>, Vec<f32>)>, String> {
+    const BAD: &str = "the local model is damaged";
+    let mut r = Reader { b: bytes, at: 0 };
+    if r.take(8).ok_or(BAD)? != b"JXMIGAN1" {
+        return Err(if bytes.is_empty() { "the local model is not in this build".into() } else { BAD.into() });
+    }
+    let count = r.u32().ok_or(BAD)? as usize;
+    if count > 1024 {
+        return Err(BAD.into());
+    }
+    let mut out = HashMap::with_capacity(count);
+    for _ in 0..count {
+        let len = r.u16().ok_or(BAD)? as usize;
+        let name = std::str::from_utf8(r.take(len).ok_or(BAD)?).map_err(|_| BAD)?.to_owned();
+        let dims = usize::from(r.take(1).and_then(|b| b.first().copied()).ok_or(BAD)?);
+        if dims > 4 {
+            return Err(BAD.into());
+        }
+        let mut shape = Vec::with_capacity(dims);
+        let mut n = 1usize;
+        for _ in 0..dims {
+            let d = r.u32().ok_or(BAD)? as usize;
+            n = n.checked_mul(d).filter(|&v| v <= MAX_TENSOR).ok_or(BAD)?;
+            shape.push(d);
+        }
+        let raw = r.take(n * 2).ok_or(BAD)?;
+        let values = raw.chunks_exact(2).map(|p| f16_to_f32(u16::from_le_bytes([p[0], p[1]]))).collect();
+        out.insert(name, (shape, values));
+    }
+    Ok(out)
+}
+
+struct Reader<'a> {
+    b: &'a [u8],
+    at: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Option<&'a [u8]> {
+        let end = self.at.checked_add(n)?;
+        let s = self.b.get(self.at..end)?;
+        self.at = end;
+        Some(s)
+    }
+    fn u16(&mut self) -> Option<u16> {
+        self.take(2).map(|b| u16::from_le_bytes([b[0], b[1]]))
+    }
+    fn u32(&mut self) -> Option<u32> {
+        self.take(4).map(|b| u32::from_le_bytes([b[0], b[1], b[2], b[3]]))
+    }
+}
+
+/// IEEE 754 half → single precision.
+fn f16_to_f32(h: u16) -> f32 {
+    let sign = u32::from(h >> 15) << 31;
+    let exp = u32::from((h >> 10) & 0x1f);
+    let man = u32::from(h & 0x3ff);
+    let bits = match (exp, man) {
+        (0, 0) => sign,
+        (0, m) => {
+            // Subnormal: normalise.
+            let shift = m.leading_zeros() - 21;
+            let m = (m << shift) & 0x3ff;
+            sign | ((113 - shift) << 23) | (m << 13)
+        }
+        (31, 0) => sign | 0x7f80_0000,
+        (31, m) => sign | 0x7f80_0000 | (m << 13),
+        (e, m) => sign | ((e + 112) << 23) | (m << 13),
+    };
+    f32::from_bits(bits)
+}
