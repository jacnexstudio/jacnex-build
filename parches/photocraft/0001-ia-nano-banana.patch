+#[test]
+fn three_variations_switch_without_paying_again_and_apply_merges_down() {
+    let (mut h, recibido) = conectado();
+    h.state_mut().run("select.rect", json!({"x": 100, "y": 100, "width": 120, "height": 80, "antiAlias": false})).unwrap();
+    h.run_steps(4);
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    let e = &mut h.state_mut().jacnex_ia;
+    e.prompt = "un gato".into();
+    e.variaciones = 3;
+    generar_y_esperar(&mut h);
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1, "{:?}", h.state().jacnex_ia_aviso());
+    assert_eq!(pixel(h.state(), 160, 140), ROJO, "la primera variación");
+    {
+        let r = recibido.lock().unwrap();
+        assert_eq!(r.generar.len(), 1, "un solo pedido");
+        assert_eq!(campo(&r.generar[0], "n").as_deref(), Some("3"));
+    }
+
+    ia::cambiar_variacion(h.state_mut(), 2);
+    h.run_steps(2);
+    assert_eq!(pixel(h.state(), 160, 140), AZUL, "la tercera");
+    ia::cambiar_variacion(h.state_mut(), 1);
+    assert_eq!(pixel(h.state(), 160, 140), VERDE, "la segunda");
+    assert_eq!(recibido.lock().unwrap().generar.len(), 1, "cambiar no vuelve a pedir");
+    assert_eq!(pixel(h.state(), 90, 90), BLANCO);
+
+    ia::aplicar(h.state_mut());
+    h.run_steps(2);
+    let d = h.state().session.active().unwrap();
+    assert_eq!(d.doc.layers.len(), capas, "combinada con la de abajo");
+    assert_eq!(pixel(h.state(), 160, 140), VERDE, "el resultado queda en la imagen");
+    assert_eq!(pixel(h.state(), 90, 90), BLANCO);
+}
