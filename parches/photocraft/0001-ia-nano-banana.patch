+/// El botón principal, de color: ícono y texto centrados.
+fn boton_acento(ui: &mut egui::Ui, icono: &str, texto: &str, tam: egui::Vec2, activo: bool) -> egui::Response {
+    let b = egui::Button::new((
+        egui::Atom::grow(),
+        crate::icons::image(icono, 15.0, Color32::WHITE),
+        RichText::new(texto).strong().color(Color32::WHITE),
+        egui::Atom::grow(),
+    ))
+    .fill(ACENTO)
+    .corner_radius(8.0)
+    .min_size(tam);
+    ui.add_enabled(activo, b)
+}
+
+/// «Aplicar»: blanco, el siguiente paso obvio tras generar.
+fn boton_aplicar(ui: &mut egui::Ui, texto: &str, tam: egui::Vec2) -> egui::Response {
+    let b = egui::Button::new((egui::Atom::grow(), crate::icons::image("check", 14.0, OSCURO), RichText::new(texto).strong().color(OSCURO), egui::Atom::grow()))
