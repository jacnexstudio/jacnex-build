+/// Cambia la capa del último resultado a la variación `i` (un paso de historial, sin volver a pagar).
+pub fn cambiar_variacion(app: &mut PhotocraftApp, i: usize) {
+    let Some(r) = app.jacnex_ia.resultado.as_ref() else { return };
+    if i == r.actual || app.session.active().is_none_or(|d| d.doc.id != r.doc) {
+        return;
+    }
+    let Some(px) = r.variaciones.get(i) else { return };
+    match motor::replace_pixels(&mut app.session, "Cambiar variación", r.capa, r.zona, px) {
+        Ok(()) => {
+            if let Some(r) = app.jacnex_ia.resultado.as_mut() {
+                r.actual = i;
+            }
+        }
+        Err(e) => app.jacnex_ia.aviso = Some((false, e.to_string())),
+    }
+}
+
+/// Combina la capa del último resultado con la de abajo (Combinar hacia abajo).
+pub fn aplicar(app: &mut PhotocraftApp) {
+    let Some(r) = app.jacnex_ia.resultado.take() else { return };
+    if app.session.active().is_none_or(|d| d.doc.id != r.doc) {
+        app.jacnex_ia.resultado = Some(r);
+        return;
+    }
+    app.session.set_active_layer(Some(r.capa));
+    app.jacnex_ia.aviso = Some(match app.run("layer.mergeDown", serde_json::json!({})) {
+        Ok(_) => (true, "Aplicado a la imagen.".into()),
+        Err(e) => (false, format!("No se pudo aplicar: {e}")),
+    });
+}
+
+/// Borra la capa del último resultado (Ctrl+Z la recupera).
+pub fn descartar(app: &mut PhotocraftApp) {
+    let Some(r) = app.jacnex_ia.resultado.take() else { return };
+    if app.session.active().is_none_or(|d| d.doc.id != r.doc) {
+        app.jacnex_ia.resultado = Some(r);
+        return;
+    }
+    app.session.set_active_layer(Some(r.capa));
+    app.jacnex_ia.aviso = match app.run("layer.delete", serde_json::json!({})) {
+        Ok(_) => None,
+        Err(e) => Some((false, format!("No se pudo descartar: {e}"))),
+    };
+}
+
+/// Los límites (en mosaicos) de la selección del documento activo.
+fn seleccion_actual(app: &PhotocraftApp) -> Option<Rect> {
+    app.session.active().and_then(|d| d.doc.selection.as_ref().map(|s| s.tile_bounds()))
+}
+
+/// El último resultado sigue en su capa sin aplicar, en el documento activo, con la misma
+/// herramienta y selección: lo que se genere ahora lo reemplaza.
+fn repetir(app: &PhotocraftApp) -> bool {
+    let doc = app.session.active().map(|d| d.doc.id);
+    let e = &app.jacnex_ia;
+    e.resultado.as_ref().is_some_and(|r| r.repetible && Some(r.doc) == doc && r.herramienta == e.herramienta && r.sel == seleccion_actual(app))
+}
+
+/// Genera; un resultado sin aplicar en el mismo lugar se cambia por el nuevo (se quita antes,
+/// para que la IA no lo vea; Ctrl+Z lo recupera).
+pub fn otra_vez(app: &mut PhotocraftApp) {
+    if app.jacnex_ia.trabajo.is_some() {
+        return;
+    }
+    if repetir(app) {
+        let Some(p) = plan(app) else { return };
+        if let Some(f) = p.falta {
+            app.jacnex_ia.aviso = Some((false, f));
+            return;
+        }
+        if let (Some(c), Some(i)) = (p.costo, app.jacnex_ia.info.as_ref())
+            && c > i.creditos
+        {
+            app.jacnex_ia.aviso = Some((false, format!("Te faltan {} para generar.", creditos(c - i.creditos))));
+            return;
+        }
+        descartar(app);
+    }
+    generar(app);
+}
