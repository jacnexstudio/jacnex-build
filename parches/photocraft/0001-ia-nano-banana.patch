+/// Una fila de Ajustes: etiqueta a la izquierda, control a la derecha.
+fn fila<R>(ui: &mut egui::Ui, etiqueta: &str, control: impl FnOnce(&mut egui::Ui) -> R) -> R {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    ui.horizontal(|ui| {
+        ui.allocate_ui_with_layout(egui::vec2(ETIQUETA, 24.0), egui::Layout::left_to_right(egui::Align::Center), |ui| {
+            ui.set_min_width(ETIQUETA);
+            ui.label(RichText::new(etiqueta).color(t.text_dim));
+        });
+        control(ui)
+    })
+    .inner
+}
