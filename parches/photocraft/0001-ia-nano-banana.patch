+            Herramienta::MejorarResolucion => "Agranda la foto 2 o 4 veces recuperando detalle. Se abre como documento nuevo.",
+            Herramienta::Texto => "Escribe un texto dentro de la imagen, bien escrito y con el estilo que pidas.",
+            Herramienta::Retoque => "Mejora la foto entera en un clic: luz y color, restaurar, colorear, producto, retrato…",
+        }
+    }
+
+    /// Usa un modelo de imagen elegible (las otras usan una herramienta fija).
+    /// Quitar objeto elige entre MI-GAN e Ideogram, no un modelo de imagen.
+    fn usa_modelo(self) -> bool {
+        !matches!(self, Herramienta::QuitarFondo | Herramienta::MejorarResolucion | Herramienta::QuitarObjeto)
+    }
+
+    fn admite_variaciones(self) -> bool {
+        self.usa_modelo()
+    }
+
+    /// Necesita una selección.
+    fn pide_seleccion(self) -> bool {
+        self == Herramienta::QuitarObjeto
+    }
+
+    /// Usa la selección si la hay (las demás trabajan con la imagen entera).
+    fn usa_seleccion(self) -> bool {
+        matches!(self, Herramienta::Relleno | Herramienta::QuitarObjeto | Herramienta::Texto)
+    }
+
+    fn admite_referencia(self) -> bool {
+        matches!(self, Herramienta::Relleno | Herramienta::GenerarFondo | Herramienta::Expandir)
+    }
+}
