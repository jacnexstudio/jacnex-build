+// --- Instrucciones para el modelo ---------------------------------------------------------------
+
+/// Las instrucciones (en inglés, que es como mejor las siguen los modelos). Lo que la persona
+/// escribe va tal cual.
+fn instrucciones(h: Herramienta, pedido: &str, texto: &str, con_seleccion: bool, modo: SinSeleccion, retoque: usize, con_referencia: bool) -> String {
+    let pedido = pedido.trim();
+    let referencia = if con_referencia {
+        " The last image is a reference: use it for the look of what you add (its subject, style and colors), not for the framing."
+    } else {
+        ""
+    };
+    let mascara = |que: &str| {
+        format!(
+            "Image 1 is a photo. Image 2 is a mask: its white area marks the region to change. Edit only that region of image 1: {que}. \
+             Match the lighting, perspective, colors, sharpness and grain of the rest of the photo. Keep everything outside the white area exactly as it is, \
+             with the same framing and size. Return only the edited photo.{referencia}"
+        )
+    };
+    match h {
+        Herramienta::QuitarObjeto => mascara(
+            "remove the objects or people inside it completely, including their shadows and reflections, and fill the area with what would naturally be behind them, \
+             continuing the surrounding background seamlessly. Do not add anything new",
+        ),
+        Herramienta::Relleno if con_seleccion => {
+            if pedido.is_empty() {
+                mascara("remove what is there and fill it naturally so it blends with its surroundings")
+            } else {
+                mascara(&format!("draw {pedido}"))
+            }
+        }
+        Herramienta::Relleno => match modo {
+            SinSeleccion::EditarTodo => format!("Edit this image: {pedido}. Keep the same framing and composition unless asked otherwise.{referencia}"),
+            SinSeleccion::CrearNueva if con_referencia => format!("{pedido}. Use the image as a reference for the subject and style."),
+            SinSeleccion::CrearNueva => pedido.to_string(),
+        },
+        Herramienta::Expandir => {
+            let extra = if pedido.is_empty() { String::new() } else { format!(" In the new area: {pedido}.") };
+            format!(
+                "Image 1 is a photo placed in the middle of a larger canvas; the gray border is empty. Image 2 is a mask: white marks the empty area. \
+                 Extend the photo into the white area so the result looks like one wider original photo: continue the scene, lighting, perspective, colors and grain seamlessly.{extra} \
+                 Keep the original photo exactly as it is. Return only the full image.{referencia}"
+            )
+        }
+        Herramienta::GenerarFondo => {
+            let fondo = if pedido.is_empty() { "a clean, professional studio background" } else { pedido };
+            format!(
+                "Image 1 is a photo. Image 2 is a mask: white marks the background. Replace the background with: {fondo}. \
+                 Keep the main subject (the black area of the mask) exactly as it is, with its shape, colors and details. \
+                 Make the new background's lighting, perspective and shadows match the subject naturally. Return only the edited photo.{referencia}"
+            )
+        }
+        Herramienta::Texto => {
+            let estilo = if pedido.is_empty() { "clean, bold and legible, matching the image's style and colors".to_string() } else { pedido.to_string() };
+            let donde = if con_seleccion { "inside the white area of the mask (image 2)" } else { "in the most suitable place of the image" };
+            let base = format!(
+                "Add the text \"{}\" {donde}. Write it exactly as given, letter by letter, with correct spelling and accents. Text style: {estilo}.",
+                texto.trim()
+            );
+            if con_seleccion {
+                format!(
+                    "Image 1 is a photo. Image 2 is a mask. {base} Keep everything outside the white area exactly as it is, with the same framing and size. Return only the edited photo."
+                )
+            } else {
+                format!("{base} Keep the rest of the image exactly as it is, with the same framing.")
+            }
+        }
+        Herramienta::Retoque => {
+            let base = RETOQUES.get(retoque).map_or(RETOQUES[0].1, |r| r.1);
+            if pedido.is_empty() { base.to_string() } else { format!("{base} Also: {pedido}.") }
+        }
+        Herramienta::QuitarFondo | Herramienta::MejorarResolucion => String::new(),
+    }
+}
+
+/// Lo que Ideogram debe dibujar en la zona negra de la máscara: lo pedido, o fondo vacío.
+fn instrucciones_ideogram(quitar: bool, pedido: &str) -> String {
+    let pedido = pedido.trim();
+    if quitar || pedido.is_empty() {
+        "Empty background only: continue the surrounding scene, surfaces, textures and lighting seamlessly. \
+         No objects, no people, no text, and no shadows or reflections of anything removed."
+            .into()
+    } else {
+        format!("{pedido}. Photorealistic, matching the photo's lighting, perspective, colors and grain.")
+    }
+}
+
+fn nombre_capa(prefijo: &str, pedido: &str) -> String {
+    let p = pedido.trim();
+    if p.is_empty() {
+        return format!("IA · {prefijo}");
+    }
+    let corto: String = p.chars().take(32).collect();
+    if corto.chars().count() < p.chars().count() { format!("IA · {corto}…") } else { format!("IA · {corto}") }
+}
+
+// --- Plan: qué haría Generar ahora --------------------------------------------------------------
+
+/// Qué haría Generar ahora, para explicarlo y cotizarlo antes de gastar créditos.
+struct Plan {
+    con_seleccion: bool,
+    /// La selección o el lienzo.
+    zona: Rect,
+    lienzo: Rect,
+    costo: Option<i64>,
+    /// Por qué no se puede generar ahora.
+    falta: Option<String>,
+}
+
+fn plan(app: &mut PhotocraftApp) -> Option<Plan> {
+    let limites = limites_seleccion(app);
+    let d = app.session.active()?;
+    let e = &app.jacnex_ia;
+    let lienzo = d.doc.bounds();
+    let h = e.herramienta;
+    let con_seleccion = limites.is_some() && h.usa_seleccion();
+    let zona = limites.filter(|_| con_seleccion).unwrap_or(lienzo);
+    let ideogram = e.usa_ideogram(con_seleccion);
+    let n = if h.admite_variaciones() || ideogram { i64::from(e.variaciones()) } else { 1 };
+    let m = e.modelo_actual();
+    let costo_imagen = |r: Rect| -> Option<i64> {
+        let (s, _) = ajustar_aspecto(r, lienzo, &m.aspectos);
+        let (ew, eh) = tamano_envio(s.width(), s.height());
+        m.costo(nivel(ew.max(eh)))
+    };
+    let (costo, falta) = match h {
+        Herramienta::QuitarFondo => (e.herramienta_servidor("quitar-fondo").and_then(|t| t.costo("unica")), None),
+        Herramienta::MejorarResolucion => {
+            let f = e.factor();
+            let largo = lienzo.width().max(lienzo.height());
+            let falta = (largo.saturating_mul(f) > MAX_LADO_AMPLIADO)
+                .then(|| format!("La imagen ya es grande: ×{f} pasaría de {MAX_LADO_AMPLIADO} px. Prueba ×2 o reduce la imagen primero."));
+            (e.herramienta_servidor("mejorar-resolucion").and_then(|t| t.costo(&format!("x{f}"))), falta)
+        }
+        Herramienta::GenerarFondo => {
+            let recorte = e.herramienta_servidor("quitar-fondo").and_then(|t| t.costo("unica"));
+            (recorte.zip(costo_imagen(lienzo)).map(|(a, b)| a + b * n), None)
+        }
+        Herramienta::Expandir => match lienzo_expandido(lienzo.width(), lienzo.height(), e.proporcion) {
+            Some((nw, nh)) => {
+                let nuevo = Rect::new(0, 0, nw as i32, nh as i32);
+                (costo_imagen(nuevo).map(|c| c * n), None)
+            }
+            None => (None, Some("La imagen ya tiene esa proporción: elige otra.".into())),
+        },
+        _ => {
+            let contexto = if con_seleccion { motor::context_rect(zona, lienzo, MARGEN) } else { lienzo };
+            let falta = if h.pide_seleccion() && !con_seleccion {
+                Some(SELECCIONA_QUITAR.into())
+            } else if e.quitar_local() && !migan::available() {
+                Some("Quitar objeto gratis no está disponible aquí: elige «Con IA · Ideogram».".into())
+            } else if h == Herramienta::Texto && e.texto.trim().is_empty() {
+                Some("Escribe el texto que quieres en la imagen.".into())
+            } else if h == Herramienta::Relleno && !con_seleccion && e.prompt.trim().is_empty() {
+                Some("Escribe una indicación para continuar.".into())
+            } else {
+                None
+            };
+            let costo = if e.quitar_local() {
+                Some(0)
+            } else if ideogram {
+                e.costo_ideogram().map(|c| c * n)
+            } else {
+                costo_imagen(contexto).map(|c| c * n)
+            };
+            (costo, falta)
+        }
+    };
+    let pixeles = u64::from(lienzo.width()) * u64::from(lienzo.height());
+    let falta = falta.or_else(|| (pixeles > MAX_PIXELES).then(|| "La imagen es demasiado grande para la IA (más de 80 MP). Redúcela primero.".into()));
+    Some(Plan { con_seleccion, zona, lienzo, costo, falta })
+}
+
+pub fn ocupado(app: &PhotocraftApp) -> bool {
+    app.jacnex_ia.trabajo.as_ref().is_some_and(|t| t.listo.is_none())
+}
+
+/// Hay una generación en marcha o un resultado esperando a que su documento vuelva a estar activo.
+pub fn hay_trabajo(app: &PhotocraftApp) -> bool {
+    app.jacnex_ia.trabajo.is_some()
+}
+
+/// El último aviso de la IA (resultado o error).
+pub fn aviso(app: &PhotocraftApp) -> Option<String> {
+    app.jacnex_ia.aviso.as_ref().map(|a| a.1.clone())
+}
+
+/// Empieza una generación con la herramienta y la indicación actuales.
+pub fn generar(app: &mut PhotocraftApp) {
+    if app.jacnex_ia.trabajo.is_some() {
+        return;
+    }
+    if let Some(Some(f)) = plan(app).map(|p| p.falta) {
+        app.jacnex_ia.aviso = Some((false, f));
+        return;
+    }
+    match preparar(app) {
+        Ok(t) => {
+            app.jacnex_ia.aviso = None;
+            app.jacnex_ia.trabajo = Some(t);
+        }
+        Err(e) => app.jacnex_ia.aviso = Some((false, e)),
+    }
+}
+
+/// La imagen de referencia (otro documento abierto), lista para enviar.
+fn referencia(app: &PhotocraftApp) -> Option<(Vec<u8>, u32, u32)> {
+    let id = app.jacnex_ia.referencia?;
+    let d = app.session.documents().iter().find(|d| d.doc.id == id)?;
+    let r = d.doc.bounds();
+    if r.is_empty() || u64::from(r.width()) * u64::from(r.height()) > MAX_PIXELES {
+        return None;
+    }
+    let px = vista(&d.doc, r, r);
+    let (w, h) = caber(r.width(), r.height(), MAX_LADO_REFERENCIA);
+    Some((cubrir(&px, r.width(), r.height(), w, h), w, h))
+}
+
+/// `mascara` (`w`×`h`, algo seleccionado = > 0) agrandada `r` píxeles en cada dirección (un
+/// cuadrado): dos pasadas por filas y columnas, cada una lineal.
+fn agrandar(mascara: &[u8], w: usize, h: usize, r: usize) -> Vec<u8> {
+    // Una línea de `n` valores separados por `paso`: marca lo que está a `r` o menos de algo marcado.
+    fn linea(src: &[u8], dst: &mut [u8], ini: usize, paso: usize, n: usize, r: usize) {
+        let mut ultimo: Option<usize> = None;
+        for i in 0..n {
+            let k = ini + i * paso;
+            if src.get(k).is_some_and(|&v| v > 0) {
+                ultimo = Some(i);
+            }
+            if ultimo.is_some_and(|u| i - u <= r)
+                && let Some(d) = dst.get_mut(k)
+            {
+                *d = 255;
+            }
+        }
+        ultimo = None;
+        for i in (0..n).rev() {
+            let k = ini + i * paso;
+            if src.get(k).is_some_and(|&v| v > 0) {
+                ultimo = Some(i);
+            }
+            if ultimo.is_some_and(|u| u - i <= r)
+                && let Some(d) = dst.get_mut(k)
+            {
+                *d = 255;
+            }
+        }
+    }
+    if mascara.len() != w * h {
+        return mascara.to_vec();
+    }
+    let mut filas = vec![0u8; w * h];
+    for y in 0..h {
+        linea(mascara, &mut filas, y * w, 1, w, r);
+    }
+    let mut out = vec![0u8; w * h];
+    for x in 0..w {
+        linea(&filas, &mut out, x, w, h, r);
+    }
+    out
+}
+
+/// Quitar objeto gratis: MI-GAN en este equipo, en un hilo aparte; sin cuenta ni créditos.
+fn preparar_local(app: &PhotocraftApp) -> Result<Trabajo, String> {
+    let d = app.session.active().ok_or("Abre o crea un documento primero.")?;
+    let lienzo = d.doc.bounds();
+    let z = motor::zone(&app.session, MARGEN).ok_or("La selección está fuera del lienzo.")?;
+    let (Some(b), Some(sel)) = (z.selected, z.selection) else { return Err(SELECCIONA_QUITAR.into()) };
+    // Lo que se borra es la selección algo agrandada: el borde del objeto (que una selección
+    // ajustada deja dentro) no tiñe el relleno. La capa sigue recortada por la selección.
+    let r = (b.width().max(b.height()) / 50).clamp(4, 16);
+    // Lo que MI-GAN mira alrededor del objeto; el resto del lienzo no hace falta.
+    let m = migan::context_margin(b.width().saturating_add(2 * r), b.height().saturating_add(2 * r)).saturating_add(r);
+    let m = i32::try_from(m).unwrap_or(i32::MAX / 4);
+    let zona = Rect::new(b.x0.saturating_sub(m), b.y0.saturating_sub(m), b.x1.saturating_add(m), b.y1.saturating_add(m)).intersect(&lienzo);
+    if zona.is_empty() || u64::from(zona.width()) * u64::from(zona.height()) > MAX_PIXELES {
+        return Err("La zona es demasiado grande para quitarla en tu PC: prueba «Con IA · Ideogram».".into());
+    }
+    let mut px = vista(&d.doc, zona, lienzo);
+    let hueco = motor::coverage(&sel, zona);
+    let (w, h) = (zona.width(), zona.height());
+    let rx = en_hilo(move |tx: Sender<Evento>| {
+        let _ = tx.send(Evento::Etapa("Quitando el objeto en tu PC…"));
+        let hueco = agrandar(&hueco, w as usize, h as usize, r as usize);
+        let r = migan::remove(&px, w, h, &hueco).map(|f| {
+            // Lo rellenado vuelve a su sitio dentro de la zona.
+            let (fw, zw) = (f.width as usize * 4, w as usize * 4);
+            for (fy, fila) in f.rgba.chunks_exact(fw.max(1)).enumerate() {
+                let ini = (f.y as usize + fy) * zw + f.x as usize * 4;
+                if let Some(dst) = px.get_mut(ini..ini + fila.len()) {
+                    dst.copy_from_slice(fila);
+                }
+            }
+            px
+        });
+        let _ = tx.send(match r {
+            Ok(rgba) => Evento::Listo(Resultados { imagenes: vec![Img { rgba, ancho: w, alto: h }], alfa: None, fallidas: 0 }),
+            Err(e) => Evento::Error(format!("No se pudo quitar el objeto: {e}")),
+        });
+    });
+    let accion = Accion::Capa { zona, mascara: Some(sel), nombre: nombre_capa("Objeto quitado", "") };
+    Ok(Trabajo { doc: d.doc.id, accion, inicio: Instant::now(), etapa: "Preparando…", rx, listo: None })
+}
+
+fn preparar(app: &PhotocraftApp) -> Result<Trabajo, String> {
+    if app.jacnex_ia.quitar_local() {
+        return preparar_local(app);
+    }
+    let conexion = conexion(&app.jacnex_ia).ok_or("Inicia sesión en Jacnex Studio para usar la IA.")?;
+    let e = &app.jacnex_ia;
+    let d = app.session.active().ok_or("Abre o crea un documento primero.")?;
+    let lienzo = d.doc.bounds();
+    if lienzo.is_empty() {
+        return Err("El documento está vacío.".into());
+    }
+    let h = e.herramienta;
+    let m = e.modelo_actual();
+    let n = if h.admite_variaciones() || e.usa_ideogram(true) { e.variaciones() } else { 1 };
+    let refe = if h.admite_referencia() { referencia(app) } else { None };
+    let con_ref = refe.is_some();
+    let nombre_doc = d.doc.name.clone();
+
+    // Lo que se manda a un modelo de imagen para `zona` (ajustada a su proporción), con máscara.
+    struct Imagen {
+        zona: Rect,
+        aspecto: Option<(u32, u32)>,
+        envio: (u32, u32),
+        px: Option<Vec<u8>>,
+        mascara: Option<Vec<u8>>,
+    }
+    let a_envio = |zona: Rect, px: Option<Vec<u8>>, mascara: Option<Vec<u8>>| -> Imagen {
+        let (s, aspecto) = ajustar_aspecto(zona, lienzo, &m.aspectos);
+        let envio = tamano_envio(s.width(), s.height());
+        Imagen { zona: s, aspecto, envio, px, mascara }
+    };
+    let envio_modelo = |im: &Imagen, prompt: String| -> Result<Envio, String> {
+        let (ew, eh) = im.envio;
+        let (w, hh) = (im.zona.width(), im.zona.height());
+        let mut imagenes = Vec::new();
+        if let Some(px) = &im.px {
+            imagenes.push(jpg(&cubrir(px, w, hh, ew, eh), ew, eh, "imagen.jpg")?);
+        }
+        if let Some(mk) = &im.mascara {
+            imagenes.push(png_gris(escalar_gris(mk, w, hh, ew, eh), ew, eh)?);
+        }
+        if let Some((px, rw, rh)) = &refe {
+            imagenes.push(jpg(px, *rw, *rh, "referencia.jpg")?);
+        }
+        Ok(Envio {
+            modelo: m.id.clone(),
+            prompt,
+            tamano: Some((ew, eh)),
+            aspecto: im.aspecto,
+            resolucion: m.tiene_resoluciones().then(|| nivel(ew.max(eh))),
+            factor: None,
+            n,
+            imagenes,
+        })
+    };
+    let prompt = |con_sel: bool| instrucciones(h, &e.prompt, &e.texto, con_sel, e.sin_seleccion, e.retoque, con_ref);
+
+    // Generar fondo manda además la foto reducida para el segundo paso: (píxeles, ancho, alto, zona).
+    type Segundo = Option<(Vec<u8>, u32, u32, Rect)>;
+    let (accion, envio, extra): (Accion, Option<Envio>, Segundo) = match h {
+        Herramienta::Relleno | Herramienta::QuitarObjeto | Herramienta::Texto | Herramienta::Retoque => {
+            let z = motor::zone(&app.session, MARGEN).ok_or("La selección está fuera del lienzo.")?;
+            let con_sel = z.selected.is_some() && h.usa_seleccion();
+            if e.usa_ideogram(con_sel) {
+                let sel = z.selection.as_ref().filter(|_| con_sel).ok_or(SELECCIONA_QUITAR)?;
+                let (s, _) = ajustar_aspecto(z.context, lienzo, ASPECTOS_IDEOGRAM);
+                let (w, hh) = (s.width(), s.height());
+                let (ew, eh) = tamano_ideogram(w, hh);
+                let foto = jpg(&cubrir(&vista(&d.doc, s, lienzo), w, hh, ew, eh), ew, eh, "imagen.jpg")?;
+                let mascara = png_gris(mascara_ideogram(&escalar_gris(&motor::coverage(sel, s), w, hh, ew, eh)), ew, eh)?;
+                let quitar = h == Herramienta::QuitarObjeto;
+                let nombre = if quitar { nombre_capa("Objeto quitado", "") } else { nombre_capa("Relleno", &e.prompt) };
+                let envio = Envio {
+                    modelo: IDEOGRAM.into(),
+                    prompt: instrucciones_ideogram(quitar, &e.prompt),
+                    tamano: None,
+                    aspecto: None,
+                    resolucion: None,
+                    factor: None,
+                    n,
+                    imagenes: vec![foto, mascara],
+                };
+                (Accion::Capa { zona: s, mascara: z.selection, nombre }, Some(envio), None)
+            } else {
+                let crear = h == Herramienta::Relleno && !con_sel && e.sin_seleccion == SinSeleccion::CrearNueva;
+                let contexto = if con_sel { z.context } else { lienzo };
+                let (s, _) = ajustar_aspecto(contexto, lienzo, &m.aspectos);
+                let px = (!crear).then(|| vista(&d.doc, s, lienzo));
+                let mascara = if con_sel { z.selection.as_ref().map(|sel| motor::coverage(sel, s)) } else { None };
+                let im = a_envio(contexto, px, mascara);
+                let prefijo = match h {
+                    Herramienta::QuitarObjeto => "Objeto quitado",
+                    Herramienta::Texto => "Texto",
+                    Herramienta::Retoque => RETOQUES.get(e.retoque).map_or("Retoque", |r| r.0),
+                    _ => "Relleno",
+                };
+                let nombre = match h {
+                    Herramienta::Texto => nombre_capa(prefijo, &e.texto),
+                    Herramienta::QuitarObjeto | Herramienta::Retoque => nombre_capa(prefijo, ""),
+                    _ => nombre_capa(prefijo, &e.prompt),
+                };
+                let envio = envio_modelo(&im, prompt(con_sel))?;
+                (Accion::Capa { zona: im.zona, mascara: if con_sel { z.selection } else { None }, nombre }, Some(envio), None)
+            }
+        }
+        Herramienta::Expandir => {
+            let (nw, nh) = lienzo_expandido(lienzo.width(), lienzo.height(), e.proporcion).ok_or("La imagen ya tiene esa proporción: elige otra.")?;
+            let (dx, dy) = (((nw - lienzo.width()) as f64 * 0.5).round() as i32, ((nh - lienzo.height()) as f64 * 0.5).round() as i32);
+            let nuevo = Rect::new(-dx, -dy, nw as i32 - dx, nh as i32 - dy);
+            let (s, aspecto) = ajustar_aspecto(nuevo, nuevo, &m.aspectos);
+            let suave = (lienzo.width().min(lienzo.height()) as i32 / 60).clamp(2, 48);
+            let px = vista(&d.doc, s, lienzo);
+            let mascara = mascara_expandir(s, lienzo, suave);
+            let envio = tamano_envio(s.width(), s.height());
+            let im = Imagen { zona: s, aspecto, envio, px: Some(px), mascara: Some(mascara) };
+            let envio = envio_modelo(&im, prompt(false))?;
+            (Accion::Expandir { ancho: nw, alto: nh, zona: s, nombre: nombre_capa("Expansión", &e.prompt) }, Some(envio), None)
+        }
+        Herramienta::QuitarFondo => {
+            let (rw, rh) = tamano_recorte(lienzo.width(), lienzo.height())?;
+            let px = vista(&d.doc, lienzo, lienzo);
+            let img = jpg(&cubrir(&px, lienzo.width(), lienzo.height(), rw, rh), rw, rh, "foto.jpg")?;
+            (Accion::SinFondo, Some(Envio::herramienta("quitar-fondo", img)), None)
+        }
+        Herramienta::GenerarFondo => {
+            let (rw, rh) = tamano_recorte(lienzo.width(), lienzo.height())?;
+            let px = vista(&d.doc, lienzo, lienzo);
+            let img = jpg(&cubrir(&px, lienzo.width(), lienzo.height(), rw, rh), rw, rh, "foto.jpg")?;
+            let (s, _) = ajustar_aspecto(lienzo, lienzo, &m.aspectos);
+            let (ew, eh) = tamano_envio(s.width(), s.height());
+            let px_s = if s == lienzo { px } else { vista(&d.doc, s, lienzo) };
+            let reducida = cubrir(&px_s, s.width(), s.height(), ew, eh);
+            (Accion::Fondo { zona: s, nombre: nombre_capa("Fondo", &e.prompt) }, Some(Envio::herramienta("quitar-fondo", img)), Some((reducida, ew, eh, s)))
+        }
+        Herramienta::MejorarResolucion => {
+            let f = e.factor();
+            if lienzo.width().max(lienzo.height()).saturating_mul(f) > MAX_LADO_AMPLIADO {
+                return Err(format!("La imagen ya es grande: ×{f} pasaría de {MAX_LADO_AMPLIADO} px."));
+            }
+            let px = vista(&d.doc, lienzo, lienzo);
+            // Topaz acepta hasta 10 MB: una foto muy detallada se reduce un poco antes de enviarla.
+            let (mut w, mut hh) = (lienzo.width(), lienzo.height());
+            let mut foto = jpg(&px, w, hh, "foto.jpg")?;
+            while foto.datos.len() as u64 > MAX_BYTES_AMPLIAR && w.max(hh) > 512 {
+                let (nw, nh) = caber(w, hh, w.max(hh) * 4 / 5);
+                foto = jpg(&cubrir(&px, lienzo.width(), lienzo.height(), nw, nh), nw, nh, "foto.jpg")?;
+                (w, hh) = (nw, nh);
+            }
+            let mut envio = Envio::herramienta("mejorar-resolucion", foto);
+            envio.factor = Some(f);
+            (Accion::Ampliar { nombre: format!("{nombre_doc} ×{f}") }, Some(envio), None)
+        }
+    };
+    let envio = envio.ok_or("Nada que enviar.")?;
+    let limite = if h == Herramienta::MejorarResolucion { 256 * MB } else { 64 * MB };
+    // Generar fondo, segundo paso: el fondo nuevo con la máscara del recorte.
+    let segundo = extra.map(|(px, ew, eh, s)| {
+        let prompt = prompt(false);
+        let modelo = m.id.clone();
+        let (aspecto, res) = (ajustar_aspecto(lienzo, lienzo, &m.aspectos).1, m.tiene_resoluciones().then(|| nivel(ew.max(eh))));
+        let refe = refe.clone();
+        move |alfa: &Img| -> Result<Envio, String> {
+            // El alfa del recorte cubre el lienzo; en la zona ajustada lo de fuera es fondo.
+            let (lw, lh) = (lienzo.width(), lienzo.height());
+            let sujeto = alfa_de(alfa, lw, lh);
+            let mut fondo = vec![255u8; s.width() as usize * s.height() as usize];
+            let sw = s.width() as usize;
+            for (i, v) in sujeto.iter().enumerate() {
+                let (x, y) = ((i % lw as usize) as i32 - s.x0, (i / lw as usize) as i32 - s.y0);
+                if let Some(o) = fondo.get_mut(y as usize * sw + x as usize) {
+                    *o = 255 - v;
+                }
+            }
+            let mut imagenes = vec![jpg(&px, ew, eh, "imagen.jpg")?, png_gris(escalar_gris(&fondo, s.width(), s.height(), ew, eh), ew, eh)?];
+            if let Some((p, rw, rh)) = &refe {
+                imagenes.push(jpg(p, *rw, *rh, "referencia.jpg")?);
+            }
+            Ok(Envio { modelo: modelo.clone(), prompt: prompt.clone(), tamano: Some((ew, eh)), aspecto, resolucion: res, factor: None, n, imagenes })
+        }
+    });
+    let rx = en_hilo(move |tx: Sender<Evento>| {
+        let r = (|| -> Result<Resultados, String> {
+            let (imagenes, fallidas) = red::generar(&conexion, envio, limite, &tx)?;
+            let Some(segundo) = segundo else { return Ok(Resultados { imagenes, alfa: None, fallidas }) };
+            let alfa = imagenes.into_iter().next().ok_or("La IA no separó al sujeto.")?;
+            let _ = tx.send(Evento::Etapa("Sujeto separado; creando el fondo…"));
+            let (imagenes, fallidas) = red::generar(&conexion, segundo(&alfa)?, limite, &tx)?;
+            Ok(Resultados { imagenes, alfa: Some(alfa), fallidas })
+        })();
+        let _ = tx.send(match r {
+            Ok(r) => Evento::Listo(r),
+            Err(m) => Evento::Error(m),
+        });
+    });
+    Ok(Trabajo { doc: d.doc.id, accion, inicio: Instant::now(), etapa: "Preparando…", rx, listo: None })
+}
+
+/// Cada cuadro: recoge lo que llegó de la red y coloca el resultado en su documento.
+pub fn actualizar(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    if let Some(rx) = app.jacnex_ia.info_rx.as_ref() {
+        match rx.try_recv() {
+            Ok(r) => {
+                app.jacnex_ia.info_rx = None;
+                match r {
+                    Ok(i) => {
+                        app.jacnex_ia.info = Some(i);
+                        app.jacnex_ia.info_error = None;
+                    }
+                    Err(e) => app.jacnex_ia.info_error = Some(e),
+                }
+            }
+            Err(TryRecvError::Empty) => ctx.request_repaint_after(Duration::from_millis(250)),
+            Err(TryRecvError::Disconnected) => app.jacnex_ia.info_rx = None,
+        }
+    }
+    // Un resultado cuyo documento o capa ya no existen no se ofrece más.
+    if let Some(r) = &app.jacnex_ia.resultado
+        && !app.session.documents().iter().any(|d| d.doc.id == r.doc && d.doc.layer(r.capa).is_some())
+    {
+        app.jacnex_ia.resultado = None;
+    }
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return };
+    let mut fin: Option<Result<String, String>> = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Evento::Etapa(s)) => t.etapa = s,
+            Ok(Evento::Cobrado { saldo }) => {
+                if let (Some(i), Some(s)) = (app.jacnex_ia.info.as_mut(), saldo) {
+                    i.creditos = s;
+                }
+            }
+            Ok(Evento::Listo(r)) => t.listo = Some(r),
+            Ok(Evento::Error(e)) => fin = Some(Err(e)),
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                if t.listo.is_none() && fin.is_none() {
+                    fin = Some(Err("La generación se interrumpió.".into()));
+                }
+                break;
+            }
+        }
+    }
+    let doc = t.doc;
+    let ampliar = matches!(t.accion, Accion::Ampliar { .. });
+    if fin.is_none() && t.listo.is_some() {
+        // El resultado va a su documento: si ahora hay otro activo, espera a que vuelva. Una
+        // ampliación abre su propio documento y no espera.
+        if ampliar || app.session.active().is_some_and(|d| d.doc.id == doc) {
+            fin = Some(colocar(app));
+        } else if !app.session.documents().iter().any(|d| d.doc.id == doc) {
+            fin = Some(Err("El documento se cerró antes de recibir el resultado.".into()));
+        }
+    }
+    match fin {
+        Some(r) => {
+            app.jacnex_ia.trabajo = None;
+            app.jacnex_ia.aviso = Some(match r {
+                Ok(m) => (true, m),
+                Err(m) => (false, m),
+            });
+            pedir_info(&mut app.jacnex_ia);
+            ctx.request_repaint();
+        }
+        None => ctx.request_repaint_after(Duration::from_millis(200)),
+    }
+}
+
+fn colocar(app: &mut PhotocraftApp) -> Result<String, String> {
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return Err("Sin trabajo.".into()) };
+    let Some(res) = t.listo.take() else { return Err("Sin resultado.".into()) };
+    let accion = std::mem::replace(&mut t.accion, Accion::SinFondo);
+    let doc = t.doc;
+    let herramienta = app.jacnex_ia.herramienta;
+    let fallidas = if res.fallidas > 0 { format!(" {} no llegó; sus créditos volvieron.", res.fallidas) } else { String::new() };
+    let lienzo = app.session.active().map(|d| d.doc.bounds()).ok_or("No hay documento.")?;
+    let sel = app.session.active().and_then(|d| d.doc.selection.as_ref().map(|s| s.tile_bounds()));
+    let err = |e: photocraft_engine::EngineError| e.to_string();
+    let nuevo = |capa, zona, variaciones, aplicable, repetible| Resultado { doc, capa, zona, variaciones, actual: 0, aplicable, repetible, herramienta, sel };
+    match accion {
+        Accion::Capa { zona, mascara, nombre } => {
+            let r = zona.intersect(&lienzo);
+            let vars: Vec<Vec<u8>> =
+                res.imagenes.iter().map(|i| recortar(&cubrir(&i.rgba, i.ancho, i.alto, zona.width(), zona.height()), zona, r, 4)).collect();
+            let primera = vars.first().ok_or("La IA no devolvió ninguna imagen.")?;
+            let capa = motor::place(&mut app.session, "Relleno generativo", &nombre, r, primera, mascara.as_ref()).map_err(err)?;
+            app.jacnex_ia.resultado = Some(nuevo(capa, r, vars, true, true));
+            Ok(format!("Listo: está en una capa nueva.{fallidas}"))
+        }
+        Accion::Expandir { ancho, alto, zona, nombre } => {
+            let v = app
+                .run("image.canvasSize", serde_json::json!({"width": ancho, "height": alto, "anchor": "center", "extensionColor": "transparent"}))
+                .map_err(|e| format!("No se pudo agrandar el lienzo: {e}"))?;
+            let off = |i: usize| v.pointer(&format!("/offset/{i}")).and_then(|x| x.as_i64()).unwrap_or(0) as i32;
+            let (dx, dy) = (off(0), off(1));
+            let lienzo_n = Rect::new(0, 0, ancho as i32, alto as i32);
+            let zona_n = Rect::new(zona.x0 + dx, zona.y0 + dy, zona.x1 + dx, zona.y1 + dy);
+            let original = Rect::new(lienzo.x0 + dx, lienzo.y0 + dy, lienzo.x1 + dx, lienzo.y1 + dy);
+            let r = zona_n.intersect(&lienzo_n);
+            let suave = (lienzo.width().min(lienzo.height()) as i32 / 60).clamp(2, 48);
+            let mascara = motor::mask_from_gray(r, &mascara_expandir(r, original, suave)).ok_or("Máscara no válida.")?;
+            let vars: Vec<Vec<u8>> =
+                res.imagenes.iter().map(|i| recortar(&cubrir(&i.rgba, i.ancho, i.alto, zona_n.width(), zona_n.height()), zona_n, r, 4)).collect();
+            let primera = vars.first().ok_or("La IA no devolvió ninguna imagen.")?;
+            let capa = motor::place(&mut app.session, "Expansión generativa", &nombre, r, primera, Some(&mascara)).map_err(err)?;
+            app.jacnex_ia.resultado = Some(nuevo(capa, r, vars, true, false));
+            Ok(format!("Listo: ahora mide {ancho} × {alto} px.{fallidas}"))
+        }
+        Accion::SinFondo => {
+            let img = res.imagenes.first().ok_or("La IA no devolvió el recorte.")?;
+            let (w, h) = (lienzo.width(), lienzo.height());
+            let mascara = motor::mask_from_gray(lienzo, &alfa_de(img, w, h)).ok_or("Máscara no válida.")?;
+            let d = app.session.active().ok_or("No hay documento.")?;
+            let px: Vec<u8> = motor::composite_rgba8(&d.doc, lienzo).into_iter().flatten().collect();
+            let capa = motor::place_alone(&mut app.session, "Quitar fondo", "IA · Sin fondo", lienzo, &px, &mascara).map_err(err)?;
+            app.jacnex_ia.resultado = Some(nuevo(capa, lienzo, Vec::new(), false, false));
+            Ok("Listo: el fondo quedó oculto con una máscara (no borrado).".into())
+        }
+        Accion::Fondo { zona, nombre } => {
+            let alfa = res.alfa.as_ref().ok_or("Falta el recorte del sujeto.")?;
+            let r = zona.intersect(&lienzo);
+            let fondo: Vec<u8> = alfa_de(alfa, lienzo.width(), lienzo.height()).into_iter().map(|v| 255 - v).collect();
+            let mascara = motor::mask_from_gray(lienzo, &fondo).ok_or("Máscara no válida.")?;
+            let vars: Vec<Vec<u8>> =
+                res.imagenes.iter().map(|i| recortar(&cubrir(&i.rgba, i.ancho, i.alto, zona.width(), zona.height()), zona, r, 4)).collect();
+            let primera = vars.first().ok_or("La IA no devolvió ninguna imagen.")?;
+            let capa = motor::place(&mut app.session, "Generar fondo", &nombre, r, primera, Some(&mascara)).map_err(err)?;
+            app.jacnex_ia.resultado = Some(nuevo(capa, r, vars, true, true));
+            Ok(format!("Listo: fondo nuevo detrás del sujeto.{fallidas}"))
+        }
+        Accion::Ampliar { nombre } => {
+            let img = res.imagenes.into_iter().next().ok_or("La IA no devolvió la imagen.")?;
+            motor::open_as_document(&mut app.session, &nombre, img.ancho, img.alto, &img.rgba).map_err(err)?;
+            app.jacnex_ia.resultado = None;
+            Ok(format!("Listo: «{nombre}» se abrió aparte ({} × {} px).", img.ancho, img.alto))
+        }
+    }
+}
