+            if !sesion {
+                ui.separator();
+                ui.label("Para usar la IA, abre Jacnex Studio e inicia sesión con tu cuenta. Tus créditos son los de app.jacnex.store.");
+                return;
+            }
+            if let Some(i) = &e.info
+                && !i.nombre.is_empty()
+            {
+                ui.small(format!("Cuenta: {}", i.nombre));
+            }
+            if let Some(err) = &e.info_error {
+                ui.colored_label(Color32::from_rgb(230, 120, 90), err);
+            }
+            ui.separator();
+            let Some(p) = plan.as_ref() else {
+                ui.label("Abre o crea un documento para empezar.");
+                return;
+            };
+            // Paso 1: qué va a cambiar.
+            ui.label(RichText::new("1 · Dónde").strong());
+            if p.con_seleccion {
+                ui.label(format!(
+                    "Relleno generativo en tu selección ({} × {} px). Solo cambia lo seleccionado; la IA mira también un poco alrededor para que encaje.",
+                    p.zona.width(),
+                    p.zona.height()
+                ));
+            } else {
+                ui.label("No hay selección. Elige qué hacer (o selecciona una zona con el Marco o el Lazo):");
+                ui.horizontal(|ui| {
+                    ui.selectable_value(&mut e.sin_seleccion, SinSeleccion::EditarTodo, "Editar toda la imagen");
+                    ui.selectable_value(&mut e.sin_seleccion, SinSeleccion::CrearNueva, "Crear imagen nueva");
+                });
+            }
+            ui.add_space(4.0);
+            // Paso 2: qué pedir.
+            ui.label(RichText::new("2 · Qué quieres").strong());
+            let pista = if p.con_seleccion { "Ej.: un perro durmiendo (vacío = quitar y rellenar)" } else { "Describe la imagen o el cambio" };
+            ui.add(egui::TextEdit::multiline(&mut e.prompt).hint_text(pista).desired_rows(3).desired_width(f32::INFINITY));
+            ui.horizontal_wrapped(|ui| {
+                ui.small("Ideas:");
+                let ideas = if p.con_seleccion { IDEAS_SELECCION } else { IDEAS_LIENZO };
+                for idea in ideas {
+                    if ui.small_button(*idea).clicked() {
+                        e.prompt = if *idea == "quitar el objeto" { String::new() } else { (*idea).to_string() };
+                    }
+                }
+            });
+            ui.add_space(4.0);
+            // Paso 3: generar.
+            ui.label(RichText::new("3 · Generar").strong());
+            match e.trabajo.as_ref() {
+                Some(t) => progreso(ui, t),
+                None => {
+                    let falta_texto = !p.con_seleccion && e.prompt.trim().is_empty();
+                    if boton_generar(ui, p.costo, !falta_texto).clicked() {
+                        accion_generar = true;
+                    }
+                    if falta_texto {
+                        ui.small("Escribe una indicación para continuar.");
+                    }
+                }
+            }
+            if let Some((ok, m)) = &e.aviso {
+                ui.add_space(4.0);
+                let color = if *ok { Color32::from_rgb(110, 200, 140) } else { Color32::from_rgb(230, 120, 90) };
+                ui.colored_label(color, m);
+            }
+            ui.add_space(4.0);
+            egui::CollapsingHeader::new("¿Cómo funciona?").id_salt("jacnex-ia-ayuda").show(ui, |ui| {
+                ui.small("• Selecciona una zona (Marco, Lazo, Varita…) y escribe qué quieres ahí. Vacío = quitar lo que hay.");
+                ui.small("• El resultado llega como capa nueva con máscara: puedes moverla, pintar la máscara o borrarla.");
+                ui.small("• Sé concreto: «un gato naranja sentado» funciona mejor que «un gato».");
+                ui.small("• Si algo falla, los créditos se devuelven automáticamente.");
+                ui.small("• Truco: con una selección activa aparece la barra «Relleno generativo» debajo de ella.");
+            });
+        });
+    if !abierta {
+        app.jacnex_ia.abierta = false;
+    }
+    if accion_generar {
+        generar(app);
+    }
+}
+
+// --- Barra contextual bajo la selección ---------------------------------------------------------
+
+/// La barra se ofrece con una selección, una herramienta de selección, la opción Ventana › Barra
+/// de tareas contextual activa y sin diálogos (como la de Recortar, que tiene prioridad).
+fn barra_visible(app: &PhotocraftApp) -> bool {
+    app.ui.panels.context_task_bar
+        && app.ui.dialogs.is_empty()
+        && !crate::crop_task_bar::eligible(app)
+        && crate::canvas::tool_feedback::is_selection_tool(app.ui.tool)
+        && app.drag.is_none()
+        && app.session.active().is_some_and(|d| d.doc.selection.is_some())
+}
+
+/// Dibuja la barra bajo la selección del documento activo (desde la pasada de superposición del
+/// lienzo, en la pestaña de ese documento).
+pub fn barra(app: &mut PhotocraftApp, ui: &mut egui::Ui, xf: &ViewXform) {
+    if !barra_visible(app) {
+        app.jacnex_ia.barra_expandida = false;
+        return;
+    }
+    let Some(sel) = limites_seleccion(app) else { return };
+    let a = xf.to_screen(sel.x0 as f32, sel.y0 as f32);
+    let b = xf.to_screen(sel.x1 as f32, sel.y1 as f32);
+    let anchor = egui::Rect::from_two_pos(a, b);
+    let ctx = ui.ctx().clone();
+    let mut place = app.ui.panels.task_bar;
+    let costo = app.jacnex_ia.info.as_ref().map(|i| i.costo_edicion);
+    let shown = task_bar::show(&ctx, &mut place, anchor, xf.rect, |ui, more| contenido(app, ui, more, costo));
+    app.ui.panels.task_bar = place;
+    let Some(shown) = shown else { return };
+    if shown.hide {
+        app.ui.panels.context_task_bar = false;
+        return;
+    }
+    if shown.inner {
+        generar(app);
+    }
+}
+
+/// Los límites de la selección activa dentro del lienzo, medidos solo cuando la selección cambia.
+fn limites_seleccion(app: &mut PhotocraftApp) -> Option<Rect> {
+    let d = app.session.active()?;
+    let sel = d.doc.selection.as_ref()?;
+    let clave = (d.doc.id, d.revision, sel.tile_bounds());
+    match &app.jacnex_ia.limites {
+        Some((c, r)) if *c == clave => *r,
+        _ => {
+            let r = Some(sel.content_bounds().intersect(&d.doc.bounds())).filter(|r| !r.is_empty());
+            app.jacnex_ia.limites = Some((clave, r));
+            r
+        }
+    }
+}
+
+/// Devuelve si se pidió Generar.
+fn contenido(app: &mut PhotocraftApp, ui: &mut egui::Ui, more: &mut task_bar::MoreMenu, costo: Option<i64>) -> bool {
+    let mut pedir = false;
+    if let Some(t) = app.jacnex_ia.trabajo.as_ref() {
+        ui.add(egui::Spinner::new());
+        ui.label(format!("{}  {} s", t.etapa, t.inicio.elapsed().as_secs()));
+    } else if !app.jacnex_ia.barra_expandida {
+        if crate::icons::button_with_icon_size_tip(ui, "sparkles", task_bar::BUTTON, 14.0, false, "Relleno generativo", false).clicked()
+            | ui.add(egui::Button::new("Relleno generativo").frame(false)).clicked()
+        {
+            app.jacnex_ia.barra_expandida = true;
+            pedir_info(&mut app.jacnex_ia);
+        }
+    } else {
+        let r = ui.add(
+            egui::TextEdit::singleline(&mut app.jacnex_ia.prompt)
+                .hint_text("Describe qué poner (vacío = quitar)")
+                .desired_width(230.0),
+        );
+        let enter = r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter));
+        if boton_generar(ui, costo, true).clicked() || enter {
+            pedir = true;
+        }
+        if ui.small_button("?").on_hover_text("Abrir la ventana de la IA con explicaciones").clicked() {
+            app.jacnex_ia.abierta = true;
+        }
+    }
+    more.show(ui);
+    if let Some((false, m)) = &app.jacnex_ia.aviso
+        && app.jacnex_ia.trabajo.is_none()
+    {
+        ui.colored_label(Color32::from_rgb(230, 120, 90), "(!)").on_hover_text(m.as_str());
+    }
+    pedir
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cubrir_keeps_the_size_and_fills_without_stretching() {
+        // 4×2 left half red, right half blue → 2×2: the centre crop is one red, one blue column.
+        let mut src = Vec::new();
+        for _ in 0..2 {
+            for x in 0..4 {
+                src.extend_from_slice(if x < 2 { &[255, 0, 0, 255] } else { &[0, 0, 255, 255] });
+            }
+        }
+        let out = cubrir(&src, 4, 2, 2, 2);
+        assert_eq!(out.len(), 16);
+        assert_eq!(&out[0..4], &[255, 0, 0, 255]);
+        assert_eq!(&out[4..8], &[0, 0, 255, 255]);
+    }
+
+    #[test]
+    fn big_areas_are_sent_smaller_keeping_their_shape() {
+        assert_eq!(tamano_envio(800, 600), (800, 600));
+        assert_eq!(tamano_envio(4000, 2000), (1536, 768));
+        assert_eq!(cubrir(&[0; 4 * 4000 * 10], 4000, 10, 400, 1).len(), 1600);
+    }
+
+    #[test]
+    fn layer_names_are_short() {
+        assert_eq!(nombre_capa("  "), "IA · Relleno");
+        assert!(nombre_capa(&"a".repeat(80)).ends_with('…'));
+    }
+
+    #[test]
+    fn the_server_override_is_only_for_this_machine() {
+        assert!(es_local("http://127.0.0.1:3000"));
+        assert!(!es_local("https://app.jacnex.store"));
+        assert!(!es_local("http://127.0.0.1.evil.com"));
+    }
+}
