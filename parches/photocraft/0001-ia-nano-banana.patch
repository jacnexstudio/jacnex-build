+/// La proporción de Expandir imagen.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Default)]
+pub enum Proporcion {
+    #[default]
+    Mas25,
+    Cuadrado,
+    Vertical,
+    Historia,
+    Horizontal,
+}
+
+impl Proporcion {
+    const TODAS: [Proporcion; 5] = [Proporcion::Mas25, Proporcion::Cuadrado, Proporcion::Vertical, Proporcion::Historia, Proporcion::Horizontal];
+
+    fn nombre(self) -> &'static str {
+        match self {
+            Proporcion::Mas25 => "+25 % alrededor",
+            Proporcion::Cuadrado => "Cuadrado 1:1",
+            Proporcion::Vertical => "Vertical 4:5",
+            Proporcion::Historia => "Historia 9:16",
+            Proporcion::Horizontal => "Horizontal 16:9",
+        }
+    }
+
+    fn razon(self) -> Option<f64> {
+        match self {
+            Proporcion::Mas25 => None,
+            Proporcion::Cuadrado => Some(1.0),
+            Proporcion::Vertical => Some(4.0 / 5.0),
+            Proporcion::Historia => Some(9.0 / 16.0),
+            Proporcion::Horizontal => Some(16.0 / 9.0),
+        }
+    }
+}
+
+/// El tamaño del lienzo expandido (que contiene al actual), o `None` si ya tiene esa proporción.
+fn lienzo_expandido(w: u32, h: u32, p: Proporcion) -> Option<(u32, u32)> {
+    let (wf, hf) = (f64::from(w.max(1)), f64::from(h.max(1)));
+    let (nw, nh) = match p.razon() {
+        None => ((wf * 1.25).round(), (hf * 1.25).round()),
+        Some(r) if wf / hf < r => ((hf * r).round(), hf),
+        Some(r) => (wf, (wf / r).round()),
+    };
+    let (nw, nh) = (nw.clamp(1.0, f64::from(motor::MAX_SIDE)) as u32, nh.clamp(1.0, f64::from(motor::MAX_SIDE)) as u32);
+    // Menos de un 2 % más: ya tiene esa proporción.
+    (u64::from(nw) * u64::from(nh) * 50 > u64::from(w) * u64::from(h) * 51).then_some((nw, nh))
+}
