+    #[test]
+    fn cubrir_keeps_the_size_and_fills_without_stretching() {
+        // 4×2 left half red, right half blue → 2×2: the centre crop is one red, one blue column.
+        let mut src = Vec::new();
+        for _ in 0..2 {
+            for x in 0..4 {
+                src.extend_from_slice(if x < 2 { &[255, 0, 0, 255] } else { &[0, 0, 255, 255] });
+            }
+        }
+        let out = cubrir(&src, 4, 2, 2, 2);
+        assert_eq!(out.len(), 16);
+        assert_eq!(&out[0..4], &[255, 0, 0, 255]);
+        assert_eq!(&out[4..8], &[0, 0, 255, 255]);
+    }
