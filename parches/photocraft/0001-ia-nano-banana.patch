+/// Abre o cierra la ventana (Edición › Relleno generativo (IA)…).
+pub fn alternar(app: &mut PhotocraftApp) {
+    app.jacnex_ia.abierta = !app.jacnex_ia.abierta;
+    if app.jacnex_ia.abierta {
+        pedir_info(&mut app.jacnex_ia);
+    }
+}
