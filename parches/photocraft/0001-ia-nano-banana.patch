+//! Jacnex: la IA integrada de Photonex.
+//!
+//! Ocho herramientas, explicadas paso a paso en la ventana «IA de Jacnex» (Edición › Relleno
+//! generativo (IA)…) y, las de selección, también en la barra contextual bajo la selección:
+//!
+//! - **Relleno generativo**: la zona seleccionada (más un margen alrededor, para que la IA respete
+//!   luz y perspectiva) y su máscara van al modelo elegido; el resultado vuelve como una **capa
+//!   nueva** recortada por la selección. Sin selección edita la imagen entera o crea una nueva.
+//! - **Quitar objeto**: lo mismo, con instrucciones para borrar lo seleccionado (y su sombra).
+//! - **Expandir imagen**: agranda el lienzo a una proporción y la IA dibuja lo que falta.
+//! - **Quitar fondo** (Recraft): capa nueva con máscara del sujeto; el resto se oculta.
+//! - **Generar fondo**: separa al sujeto y la IA crea un fondo nuevo detrás.
+//! - **Mejorar resolución** (Topaz): ×2 o ×4, en un documento nuevo.
+//! - **Texto con IA**: texto bien escrito dentro de la imagen (GPT Image 2 por defecto).
+//! - **Retoques en un clic**: luz y color, restaurar, colorear, producto, retrato, cielo…
+//!
+//! Con varias **variaciones** se cobra cada una; se cambia entre ellas sin volver a pagar. Una
+//! **imagen de referencia** (otro documento abierto) guía el aspecto de lo que se añade. Todo
+//! resultado es una capa nueva (Ctrl+Z lo quita) y «Aplicar a la imagen» la combina con la de abajo.
+//!
+//! La red va en un hilo aparte: la interfaz nunca se congela. El servidor es app.jacnex.store
+//! (`/v1/jacnex/*`), con la llave de la sesión iniciada en Jacnex Studio. Los créditos se
+//! descuentan en el servidor, que los devuelve si una generación falla.
+
+use std::sync::mpsc::{Receiver, Sender, TryRecvError};
+use std::time::{Duration, Instant};
+
+use egui::{Color32, RichText};
+use photocraft_doc::{DocId, LayerId};
+use photocraft_engine::jacnex_ia as motor;
+use photocraft_geom::Rect;
+use photocraft_raster::Surface;
+
+use crate::PhotocraftApp;
+use crate::canvas::ViewXform;
+use crate::widgets::task_bar;
+
+/// El modelo por defecto: el más económico.
+pub const MODELO: &str = "nano-banana";
+/// El de Texto con IA: el que mejor escribe dentro de la imagen.
+const MODELO_TEXTO: &str = "gpt-image-2";
+/// El lado largo de lo que se envía a los modelos de imagen: más no mejora el resultado y tarda
+/// más en subir.
+const MAX_LADO: u32 = 1536;
+/// El de la imagen de referencia.
+const MAX_LADO_REFERENCIA: u32 = 1024;
+/// Quitar fondo (Recraft): entre 256 y 4096 px, hasta 5 MB; 2048 basta para un recorte limpio.
+const MAX_LADO_RECORTE: u32 = 2048;
+const MIN_LADO_RECORTE: u32 = 256;
+/// Mejorar resolución: el resultado no pasa de este lado.
+const MAX_LADO_AMPLIADO: u32 = 8192;
+/// Mejorar resolución (Topaz): lo que se sube no pasa de 10 MB.
+const MAX_BYTES_AMPLIAR: u64 = 9 * 1024 * 1024;
+/// Más píxeles que esto no se procesan (memoria): unos 80 MP.
+const MAX_PIXELES: u64 = 80_000_000;
+/// El contexto alrededor de la selección, como fracción de su tamaño.
+const MARGEN: f32 = 0.15;
+/// El fondo con que se aplanan las zonas transparentes o fuera del lienzo al enviarlas.
+const GRIS: [u8; 3] = [128, 128, 128];
+
+/// Ideas de un clic para quien no sabe qué escribir.
+const IDEAS_SELECCION: &[&str] = &["un cielo al atardecer", "flores de colores", "un sombrero elegante", "agua cristalina", "una planta en maceta"];
+const IDEAS_LIENZO: &[&str] = &["estilo acuarela", "de noche con luces de neón", "estilo ilustración 3D", "en una playa al atardecer"];
+const IDEAS_FONDO: &[&str] = &["estudio blanco con sombra suave", "playa al atardecer", "oficina moderna", "mármol y plantas", "degradado pastel"];
+const IDEAS_EXPANDIR: &[&str] = &["más cielo", "continúa el paisaje", "una calle de ciudad"];
+
+/// Retoques en un clic: (nombre, instrucción para el modelo).
+const RETOQUES: &[(&str, &str)] = &[
+    (
+        "Mejorar luz y color",
+        "Improve the lighting, exposure, white balance, contrast and colors like a professional photo retoucher. Keep every person, object, text and the framing exactly the same.",
+    ),
+    (
+        "Restaurar foto antigua",
+        "Restore this old photo: remove scratches, dust, stains, tears and noise, fix faded colors and gently sharpen faces. Keep it faithful to the original people and scene.",
+    ),
+    (
+        "Colorear blanco y negro",
+        "Colorize this black and white photo with natural, realistic, period-appropriate colors. Keep every detail and the framing exactly the same.",
+    ),
+    (
+        "Foto de producto de estudio",
+        "Turn this into a professional e-commerce product photo: clean light studio background, soft natural shadow, crisp details. Keep the product exactly the same, including its shape, label and any text.",
+    ),
+    (
+        "Retrato profesional",
+        "Make this a professional portrait: flattering soft studio lighting, clean softly blurred background, natural skin texture. Keep the person's identity, face, expression and clothing exactly the same.",
+    ),
+    (
+        "Cielo espectacular",
+        "Replace only the sky with a dramatic, beautiful sky that matches the scene's lighting and time of day. Keep everything else exactly the same.",
+    ),
