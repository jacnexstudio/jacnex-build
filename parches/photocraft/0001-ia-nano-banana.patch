+            pt.text(insignia.center(), egui::Align2::CENTER_CENTER, (i + 1).to_string(), egui::FontId::proportional(10.5), Color32::WHITE);
+            let nombre = format!("Variación {}", i + 1);
+            resp.widget_info(|| egui::WidgetInfo::selected(egui::Role::Button, true, elegida, &nombre));
+            if resp.on_hover_text("Ver esta variación (sin volver a pagar)").clicked() {
