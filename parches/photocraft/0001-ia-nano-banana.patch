+#[test]
+fn remove_background_masks_the_subject_and_hides_the_rest() {
+    let (mut h, recibido) = conectado();
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    h.state_mut().jacnex_ia.herramienta = Herramienta::QuitarFondo;
+    generar_y_esperar(&mut h);
+    let d = h.state().session.active().unwrap();
+    assert_eq!(d.doc.layers.len(), capas + 1, "{:?}", h.state().jacnex_ia_aviso());
+    let capa = d.doc.layer(d.active_layer.unwrap()).unwrap();
+    assert_eq!(capa.name, "IA · Sin fondo");
+    assert!(capa.mask.is_some());
+    assert_eq!(pixel(h.state(), 50, 150), BLANCO, "el sujeto (mitad izquierda) se ve");
+    assert_eq!(pixel(h.state(), 350, 150)[3], 0, "el fondo quedó transparente");
+    let r = recibido.lock().unwrap();
+    assert_eq!(campo(&r.generar[0], "model").as_deref(), Some("quitar-fondo"));
+    // 400×300 cumple los límites de Recraft: va a su tamaño, en JPEG.
+    assert_eq!(r.generar[0].matches("name=\"image\"").count(), 1);
+    drop(r);
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    assert_eq!(pixel(h.state(), 350, 150), BLANCO, "Ctrl+Z recupera el fondo");
+}
