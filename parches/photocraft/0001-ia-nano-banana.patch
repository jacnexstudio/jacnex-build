+/// Lo que la ventana pidió hacer al terminar de dibujarse.
+#[derive(Default)]
+struct Pedidos {
+    generar: bool,
+    variacion: Option<usize>,
+    aplicar: bool,
+    descartar: bool,
+    cerrar: bool,
+}
+
+pub fn ventana(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    actualizar(app, ctx);
+    if !app.jacnex_ia.abierta {
+        return;
+    }
+    let mut pide = Pedidos::default();
+    let plan = plan(app);
+    let repetir = repetir(app);
+    let sesion = app.jacnex_ia.con_sesion;
+    let activo = app.session.active().map(|d| d.doc.id);
+    let otros: Vec<(DocId, String)> = app.session.documents().iter().filter(|d| Some(d.doc.id) != activo).map(|d| (d.doc.id, d.doc.name.clone())).collect();
+    preparar_miniaturas(app, ctx);
+    let alto = ctx.content_rect().height();
+    egui::Window::new("IA de Jacnex")
+        .id(egui::Id::unique("jacnex-ia-ventana"))
+        .title_bar(false)
+        .resizable(false)
+        .default_width(ANCHO)
+        .show(ctx, |ui| {
+            ui.set_width(ANCHO);
+            let t = crate::theme::Tokens::get(ui.ctx());
+            let e = &mut app.jacnex_ia;
+            // Cabecera: nombre, saldo, actualizar y cerrar.
+            ui.horizontal(|ui| {
+                ui.add(crate::icons::image("sparkles", 16.0, ACENTO_CLARO));
+                ui.label(RichText::new("IA de Jacnex").strong().size(14.0).color(t.text));
+                ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                    if crate::icons::button(ui, "x", 22.0, false, "Cerrar").clicked() {
+                        pide.cerrar = true;
+                    }
+                    if sesion && crate::icons::button(ui, "rotate-cw", 22.0, false, "Actualizar saldo").clicked() {
+                        pedir_info(e);
+                    }
+                    if let Some(i) = &e.info {
+                        let r = pastilla(ui, &creditos(i.creditos));
+                        if !i.nombre.is_empty() {
+                            r.on_hover_text(format!("Cuenta: {}", i.nombre));
+                        }
+                    }
+                });
+            });
+            if !sesion {
+                ui.label(RichText::new("Inicia sesión en Jacnex Studio para usar la IA.").small().color(t.text_dim));
+            }
+            if let Some(err) = &e.info_error {
+                ui.label(RichText::new(err.as_str()).small().color(ROJO));
+            }
+            ui.add_space(4.0);
+            crate::widgets::hairline(ui);
+            let Some(p) = plan.as_ref() else {
+                ui.add_space(10.0);
+                ui.label(RichText::new("Abre o crea un documento para empezar.").color(t.text_dim));
+                ui.add_space(6.0);
+                return;
+            };
+            egui::ScrollArea::vertical().max_height(alto * 0.6).auto_shrink([false, true]).show(ui, |ui| {
+                cuerpo(ui, e, p, activo, &otros, &mut pide);
+            });
+            crate::widgets::hairline(ui);
+            ui.add_space(6.0);
+            pie(ui, e, p, repetir, &mut pide);
+        });
+    if pide.cerrar {
+        app.jacnex_ia.abierta = false;
+    }
+    if let Some(i) = pide.variacion {
+        cambiar_variacion(app, i);
+    }
+    if pide.aplicar {
+        aplicar(app);
+    }
+    if pide.descartar {
+        descartar(app);
+    }
+    if pide.generar {
+        otra_vez(app);
+    }
+}
