+            ui.label("Nada que escribir: la IA detecta a la persona u objeto principal.");
+        }
+        Herramienta::GenerarFondo => {
+            ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Describe el fondo nuevo").desired_width(f32::INFINITY));
+            ideas(ui, &mut e.prompt, IDEAS_FONDO);
+        }
+        Herramienta::MejorarResolucion => {
+            ui.label("Nada que escribir. Ideal para fotos pequeñas, recortes o imágenes para imprimir.");
+        }
+        Herramienta::Texto => {
+            ui.add(egui::TextEdit::singleline(&mut e.texto).hint_text("El texto exacto, ej.: OFERTA 50%").desired_width(f32::INFINITY));
+            ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Estilo (opcional): letras doradas en 3D, neón…").desired_width(f32::INFINITY));
+        }
+        Herramienta::Retoque => {
+            ui.horizontal_wrapped(|ui| {
+                for (i, (nombre, _)) in RETOQUES.iter().enumerate() {
+                    if ui.selectable_label(e.retoque == i, *nombre).clicked() {
+                        e.retoque = i;
+                    }
+                }
+            });
+            ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Algo más (opcional)").desired_width(f32::INFINITY));
+        }
+    }
+    if h.admite_referencia() && !otros.is_empty() {
+        ui.horizontal(|ui| {
+            ui.label("Referencia:");
+            let nombre = e.referencia.and_then(|id| otros.iter().find(|o| o.0 == id)).map_or("Ninguna".to_string(), |o| o.1.clone());
+            craft_ui::ComboBox::from_id_salt("jacnex-ia-referencia").width(200.0).selected_text(nombre).show_ui(ui, |ui| {
+                ui.selectable_value(&mut e.referencia, None, "Ninguna");
+                for (id, n) in otros {
+                    ui.selectable_value(&mut e.referencia, Some(*id), n.as_str());
+                }
+            });
+        })
+        .response
+        .on_hover_text("Otro documento abierto (un producto, una persona, un estilo) que guía cómo se ve lo que la IA añade.");
+    }
+    ui.add_space(4.0);
+
+    // Paso 3: generar.
+    ui.label(RichText::new("3 · Generar").strong());
+    if h.admite_variaciones() {
+        ui.horizontal(|ui| {
+            ui.label("Variaciones:");
+            for n in 1..=3u32 {
+                if ui
+                    .selectable_label(e.variaciones() == n, n.to_string())
+                    .on_hover_text("Cada variación se cobra; luego eliges la que más te guste.")
+                    .clicked()
+                {
+                    e.variaciones = n;
+                }
+            }
+        });
+    }
+    match e.trabajo.as_ref() {
+        Some(t) => progreso(ui, t),
+        None => {
+            if boton_generar(ui, p.costo, p.falta.is_none()).clicked() {
+                pide.generar = true;
