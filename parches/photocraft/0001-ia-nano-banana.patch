+// --- Generar ----------------------------------------------------------------------------------
+
+/// Qué haría Generar ahora, para explicarlo antes de gastar créditos.
+struct Plan {
+    con_seleccion: bool,
+    zona: Rect,
+    costo: Option<i64>,
+}
+
+fn plan(app: &mut PhotocraftApp) -> Option<Plan> {
+    let limites = limites_seleccion(app);
+    let d = app.session.active()?;
+    let con_seleccion = limites.is_some();
+    let edita = con_seleccion || app.jacnex_ia.sin_seleccion == SinSeleccion::EditarTodo;
+    let costo = app.jacnex_ia.info.as_ref().map(|i| if edita { i.costo_edicion } else { i.costo });
+    Some(Plan { con_seleccion, zona: limites.unwrap_or_else(|| d.doc.bounds()), costo })
+}
+
+pub fn ocupado(app: &PhotocraftApp) -> bool {
+    app.jacnex_ia.trabajo.as_ref().is_some_and(|t| t.listo.is_none())
+}
+
+/// Empieza una generación con la indicación actual.
+pub fn generar(app: &mut PhotocraftApp) {
+    if app.jacnex_ia.trabajo.is_some() {
+        return;
+    }
+    match preparar(app) {
+        Ok(t) => {
+            app.jacnex_ia.aviso = None;
+            app.jacnex_ia.trabajo = Some(t);
+        }
+        Err(e) => app.jacnex_ia.aviso = Some((false, e)),
+    }
+}
+
+fn preparar(app: &PhotocraftApp) -> Result<Trabajo, String> {
+    let conexion = conexion(&app.jacnex_ia).ok_or("Inicia sesión en Jacnex Studio para usar la IA.")?;
+    let e = &app.jacnex_ia;
+    let d = app.session.active().ok_or("Abre o crea un documento primero.")?;
+    let z = motor::zone(&app.session, MARGEN).ok_or("La selección está fuera del lienzo.")?;
+    let con_seleccion = z.selected.is_some();
+    if !con_seleccion && e.prompt.trim().is_empty() {
+        return Err("Escribe qué quieres que haga la IA.".into());
+    }
+    let crear = !con_seleccion && e.sin_seleccion == SinSeleccion::CrearNueva;
+    let (w, h) = (z.context.width(), z.context.height());
+    let (ew, eh) = tamano_envio(w, h);
+    let mut imagenes = Vec::new();
+    if !crear {
+        let px: Vec<u8> = motor::composite_rgba8(&d.doc, z.context).into_iter().flatten().collect();
+        imagenes.push(png(cubrir(&px, w, h, ew, eh), ew, eh)?);
+        if let Some(sel) = z.selection.as_ref() {
+            let m: Vec<u8> = motor::coverage(sel, z.context).into_iter().flat_map(|v| [v, v, v, 255]).collect();
+            imagenes.push(png(cubrir(&m, w, h, ew, eh), ew, eh)?);
+        }
+    }
+    let pedido = red::Pedido {
+        conexion,
+        prompt: instrucciones(&e.prompt, con_seleccion, e.sin_seleccion),
+        tamano: format!("{ew}x{eh}"),
+        imagenes,
+    };
+    let rx = en_hilo(move |tx| {
+        if let Err(m) = red::generar(pedido, &tx) {
+            let _ = tx.send(Evento::Error(m));
+        }
+    });
+    Ok(Trabajo {
+        doc: d.doc.id,
+        zona: z.context,
+        mascara: z.selection,
+        nombre_capa: nombre_capa(&e.prompt),
+        inicio: Instant::now(),
+        etapa: "Preparando…",
+        rx,
+        listo: None,
+    })
+}
+
+/// Cada cuadro: recoge lo que llegó de la red y coloca el resultado en su documento.
+pub fn actualizar(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    if let Some(rx) = app.jacnex_ia.info_rx.as_ref() {
+        match rx.try_recv() {
+            Ok(r) => {
+                app.jacnex_ia.info_rx = None;
+                match r {
+                    Ok(i) => {
+                        app.jacnex_ia.info = Some(i);
+                        app.jacnex_ia.info_error = None;
+                    }
+                    Err(e) => app.jacnex_ia.info_error = Some(e),
+                }
+            }
+            Err(TryRecvError::Empty) => ctx.request_repaint_after(Duration::from_millis(250)),
+            Err(TryRecvError::Disconnected) => app.jacnex_ia.info_rx = None,
+        }
+    }
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return };
+    let mut fin: Option<Result<String, String>> = None;
+    loop {
+        match t.rx.try_recv() {
+            Ok(Evento::Etapa(s)) => t.etapa = s,
+            Ok(Evento::Cobrado { saldo }) => {
+                if let (Some(i), Some(s)) = (app.jacnex_ia.info.as_mut(), saldo) {
+                    i.creditos = s;
+                }
+            }
+            Ok(Evento::Listo { rgba, ancho, alto }) => t.listo = Some((rgba, ancho, alto)),
+            Ok(Evento::Error(e)) => fin = Some(Err(e)),
+            Err(TryRecvError::Empty) => break,
+            Err(TryRecvError::Disconnected) => {
+                if t.listo.is_none() && fin.is_none() {
+                    fin = Some(Err("La generación se interrumpió.".into()));
+                }
+                break;
+            }
+        }
+    }
+    let doc = t.doc;
+    if fin.is_none() && t.listo.is_some() {
+        // El resultado va a su documento: si ahora hay otro activo, espera a que vuelva.
+        if app.session.active().is_some_and(|d| d.doc.id == doc) {
+            fin = Some(colocar(app));
+        } else if !app.session.documents().iter().any(|d| d.doc.id == doc) {
+            fin = Some(Err("El documento se cerró antes de recibir el resultado.".into()));
+        }
+    }
+    match fin {
+        Some(r) => {
+            app.jacnex_ia.trabajo = None;
+            app.jacnex_ia.aviso = Some(match r {
+                Ok(m) => (true, m),
+                Err(m) => (false, m),
+            });
+            pedir_info(&mut app.jacnex_ia);
+            ctx.request_repaint();
+        }
+        None => ctx.request_repaint_after(Duration::from_millis(200)),
+    }
+}
+
+fn colocar(app: &mut PhotocraftApp) -> Result<String, String> {
+    let Some(t) = app.jacnex_ia.trabajo.as_mut() else { return Err("Sin trabajo.".into()) };
+    let Some((rgba, ancho, alto)) = t.listo.take() else { return Err("Sin resultado.".into()) };
+    let (zona, mascara, nombre) = (t.zona, t.mascara.take(), t.nombre_capa.clone());
+    let px = cubrir(&rgba, ancho, alto, zona.width(), zona.height());
+    motor::place(&mut app.session, "Relleno generativo", &nombre, zona, &px, mascara.as_ref()).map_err(|e| e.to_string())?;
+    Ok(if mascara.is_some() {
+        "Listo: el resultado está en una capa nueva, recortada por tu selección. Ctrl+Z lo deshace; ocultando la capa comparas el antes y el después.".into()
+    } else {
+        "Listo: el resultado está en una capa nueva encima de tu imagen. Ctrl+Z lo deshace.".into()
+    })
+}
