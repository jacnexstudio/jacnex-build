+#[test]
+fn remove_object_is_free_on_this_pc_and_asks_the_server_nothing() {
+    let (mut h, recibido) = conectado();
+    // Un cuadrado rojo sobre el fondo blanco, seleccionado.
+    h.state_mut().run("select.rect", json!({"x": 150, "y": 100, "width": 60, "height": 60, "antiAlias": false})).unwrap();
+    h.state_mut().run("edit.fill", json!({"color": "#dc1e28"})).unwrap();
+    h.run_steps(4);
+    assert_eq!(pixel(h.state(), 180, 130), ROJO);
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    h.get_by_label("Quitar objeto").click();
+    h.run_steps(2);
+    let inicio = Instant::now();
+    while ia::hay_trabajo(h.state()) {
+        assert!(inicio.elapsed() < Duration::from_secs(120), "no terminó");
+        h.run_steps(2);
+        std::thread::sleep(Duration::from_millis(100));
+    }
+    h.run_steps(4);
+    let d = h.state().session.active().unwrap();
+    assert_eq!(d.doc.layers.len(), capas + 1, "{:?}", h.state().jacnex_ia_aviso());
+    let capa = d.doc.layer(d.active_layer.unwrap()).unwrap();
+    assert_eq!(capa.name, "IA · Objeto quitado");
+    assert!(capa.mask.is_some(), "recortada por la selección");
+    // Lo rojo se rellena con el blanco de alrededor.
+    for (x, y) in [(180, 130), (152, 102), (208, 158)] {
+        let p = pixel(h.state(), x, y);
+        assert!(p.iter().take(3).all(|&c| c > 200), "({x}, {y}) = {p:?}");
+    }
+    assert_eq!(pixel(h.state(), 100, 100), BLANCO);
+    assert!(recibido.lock().unwrap().generar.is_empty(), "gratis: nada al servidor");
+    h.state_mut().run("edit.undo", json!({})).unwrap();
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas);
+}
