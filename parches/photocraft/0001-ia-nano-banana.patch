+const ACENTO: Color32 = Color32::from_rgb(124, 92, 255);
+const ACENTO_CLARO: Color32 = Color32::from_rgb(205, 191, 255);
+const ROJO: Color32 = Color32::from_rgb(230, 120, 90);
+const VERDE: Color32 = Color32::from_rgb(110, 200, 140);
+const OSCURO: Color32 = Color32::from_rgb(23, 24, 28);
+const ANCHO: f32 = 330.0;
+/// El ancho de las etiquetas de Ajustes.
+const ETIQUETA: f32 = 86.0;
+
+/// `1236` → `1 236`.
+fn miles(n: i64) -> String {
+    let s = n.unsigned_abs().to_string();
+    let mut out = String::new();
+    for (i, c) in s.chars().enumerate() {
+        if i > 0 && (s.len() - i).is_multiple_of(3) {
+            out.push(' ');
+        }
+        out.push(c);
+    }
+    if n < 0 { format!("-{out}") } else { out }
+}
+
+fn creditos(c: i64) -> String {
+    if c == 1 { "1 crédito".into() } else { format!("{} créditos", miles(c)) }
+}
+
+fn icono(h: Herramienta) -> &'static str {
+    match h {
+        Herramienta::Relleno => "sparkles",
+        Herramienta::QuitarObjeto => "eraser",
+        Herramienta::Expandir => "maximize-2",
+        Herramienta::QuitarFondo => "eraser-background",
+        Herramienta::GenerarFondo => "image",
+        Herramienta::MejorarResolucion => "zoom-in",
+        Herramienta::Texto => "text-cursor",
+        Herramienta::Retoque => "wand-sparkles",
+    }
+}
+
+fn texto_generar(costo: Option<i64>, otra: bool) -> String {
+    let base = if otra { "Generar otra vez" } else { "Generar" };
+    match costo {
+        Some(0) => format!("{base} · en tu PC"),
+        Some(c) => format!("{base} · {}", creditos(c)),
+        None => base.to_string(),
+    }
+}
