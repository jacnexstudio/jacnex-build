+#[test]
+fn generate_background_keeps_the_subject_and_paints_behind_it() {
+    let (mut h, recibido) = conectado();
+    let capas = h.state().session.active().unwrap().doc.layers.len();
+    let e = &mut h.state_mut().jacnex_ia;
+    e.herramienta = Herramienta::GenerarFondo;
+    e.prompt = "playa".into();
+    generar_y_esperar(&mut h);
+    assert_eq!(h.state().session.active().unwrap().doc.layers.len(), capas + 1, "{:?}", h.state().jacnex_ia_aviso());
+    assert_eq!(pixel(h.state(), 50, 150), BLANCO, "el sujeto intacto");
+    assert_eq!(pixel(h.state(), 350, 150), ROJO, "el fondo nuevo");
+    let r = recibido.lock().unwrap();
+    assert_eq!(r.generar.len(), 2, "recorte y luego fondo");
+    assert_eq!(campo(&r.generar[0], "model").as_deref(), Some("quitar-fondo"));
+    assert_eq!(campo(&r.generar[1], "model").as_deref(), Some("nano-banana"));
+    assert!(r.generar[1].contains("playa"));
+    assert_eq!(r.generar[1].matches("name=\"image\"").count(), 2, "la foto y la máscara del fondo");
+}
