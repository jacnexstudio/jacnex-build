+        }
+    }
+    if let Some((ok, m)) = &e.aviso {
+        ui.add_space(4.0);
+        ui.colored_label(if *ok { Color32::from_rgb(110, 200, 140) } else { ROJO }, m);
+    }
+
+    // El último resultado.
+    if let Some(r) = &e.resultado {
+        ui.add_space(4.0);
+        ui.horizontal(|ui| {
+            if r.variaciones.len() > 1 {
+                ui.label("Variación:");
+                for i in 0..r.variaciones.len() {
+                    if ui.selectable_label(r.actual == i, (i + 1).to_string()).clicked() {
+                        pide.variacion = Some(i);
+                    }
+                }
+            }
+            if r.aplicable && ui.button("Aplicar a la imagen").on_hover_text("Combina el resultado con la capa de abajo (Combinar hacia abajo).").clicked() {
+                pide.aplicar = true;
+            }
+        });
+    }
+    ui.add_space(4.0);
+    egui::CollapsingHeader::new("¿Cómo funciona?").id_salt("jacnex-ia-ayuda").show(ui, |ui| {
+        ui.small("• Cada resultado llega como capa nueva: puedes moverla, ocultarla, pintar su máscara o borrarla. Ctrl+Z la quita.");
+        ui.small("• «Aplicar a la imagen» la combina con la capa de abajo cuando ya te convence.");
+        ui.small("• Sé concreto: «un gato naranja sentado» funciona mejor que «un gato».");
+        ui.small("• Con 2 o 3 variaciones eliges la mejor sin volver a generar.");
+        ui.small("• Si algo falla, los créditos se devuelven automáticamente.");
+        ui.small("• Con una selección activa aparece la barra «Relleno generativo» debajo de ella.");
+    });
+}
+
+// --- Barra contextual bajo la selección ---------------------------------------------------------
+
+/// La barra se ofrece con una selección, una herramienta de selección, la opción Ventana › Barra
+/// de tareas contextual activa y sin diálogos (como la de Recortar, que tiene prioridad).
+fn barra_visible(app: &PhotocraftApp) -> bool {
+    app.ui.panels.context_task_bar
+        && app.ui.dialogs.is_empty()
+        && !crate::crop_task_bar::eligible(app)
+        && crate::canvas::tool_feedback::is_selection_tool(app.ui.tool)
+        && app.drag.is_none()
+        && app.session.active().is_some_and(|d| d.doc.selection.is_some())
+}
+
+/// Lo que se pidió desde la barra.
+enum Barra {
+    Nada,
+    Generar,
+    QuitarObjeto,
+    Variacion(usize),
+    Aplicar,
+}
+
+/// Dibuja la barra bajo la selección del documento activo (desde la pasada de superposición del
+/// lienzo, en la pestaña de ese documento).
+pub fn barra(app: &mut PhotocraftApp, ui: &mut egui::Ui, xf: &ViewXform) {
+    if !barra_visible(app) {
+        app.jacnex_ia.barra_expandida = false;
+        return;
+    }
+    let Some(sel) = limites_seleccion(app) else { return };
+    let a = xf.to_screen(sel.x0 as f32, sel.y0 as f32);
+    let b = xf.to_screen(sel.x1 as f32, sel.y1 as f32);
+    let anchor = egui::Rect::from_two_pos(a, b);
+    let ctx = ui.ctx().clone();
+    let mut place = app.ui.panels.task_bar;
+    let costo = if app.jacnex_ia.barra_expandida { plan(app).and_then(|p| p.costo) } else { None };
+    let doc = app.session.active().map(|d| d.doc.id);
+    let shown = task_bar::show(&ctx, &mut place, anchor, xf.rect, |ui, more| contenido_barra(app, ui, more, costo, doc));
+    app.ui.panels.task_bar = place;
+    let Some(shown) = shown else { return };
+    if shown.hide {
+        app.ui.panels.context_task_bar = false;
+        return;
+    }
+    match shown.inner {
+        Barra::Nada => {}
+        Barra::Generar => generar(app),
+        Barra::QuitarObjeto => {
+            app.jacnex_ia.elegir_herramienta(Herramienta::QuitarObjeto);
+            generar(app);
+        }
+        Barra::Variacion(i) => cambiar_variacion(app, i),
+        Barra::Aplicar => aplicar(app),
+    }
+}
+
+/// Los límites de la selección activa dentro del lienzo, medidos solo cuando la selección cambia.
+fn limites_seleccion(app: &mut PhotocraftApp) -> Option<Rect> {
+    let d = app.session.active()?;
+    let sel = d.doc.selection.as_ref()?;
+    let clave = (d.doc.id, d.revision, sel.tile_bounds());
+    match &app.jacnex_ia.limites {
+        Some((c, r)) if *c == clave => *r,
+        _ => {
+            let r = Some(sel.content_bounds().intersect(&d.doc.bounds())).filter(|r| !r.is_empty());
+            app.jacnex_ia.limites = Some((clave, r));
+            r
+        }
+    }
+}
+
+fn contenido_barra(app: &mut PhotocraftApp, ui: &mut egui::Ui, more: &mut task_bar::MoreMenu, costo: Option<i64>, doc: Option<DocId>) -> Barra {
+    let mut pedido = Barra::Nada;
+    let e = &mut app.jacnex_ia;
+    if let Some(t) = e.trabajo.as_ref() {
+        ui.add(egui::Spinner::new());
+        ui.label(format!("{}  {} s", t.etapa, t.inicio.elapsed().as_secs()));
+    } else if !e.barra_expandida {
+        if crate::icons::button_with_icon_size_tip(ui, "sparkles", task_bar::BUTTON, 14.0, false, "Relleno generativo", false).clicked()
+            | ui.add(egui::Button::new("Relleno generativo").frame(false)).clicked()
+        {
+            e.barra_expandida = true;
+            if !matches!(e.herramienta, Herramienta::Relleno | Herramienta::Texto) {
+                e.elegir_herramienta(Herramienta::Relleno);
+            }
+            pedir_info(e);
+        }
+        if ui.add(egui::Button::new("Quitar objeto").frame(false)).on_hover_text("Borra lo seleccionado y rellena con lo que habría detrás").clicked() {
+            pedir_info(e);
+            pedido = Barra::QuitarObjeto;
+        }
+        if let Some(r) = e.resultado.as_ref().filter(|r| Some(r.doc) == doc) {
+            if r.variaciones.len() > 1 {
+                ui.separator();
+                for i in 0..r.variaciones.len() {
+                    if ui.selectable_label(r.actual == i, (i + 1).to_string()).on_hover_text("Cambiar de variación").clicked() {
+                        pedido = Barra::Variacion(i);
+                    }
+                }
+            }
+            if r.aplicable && ui.small_button("Aplicar").on_hover_text("Combinar el resultado con la capa de abajo").clicked() {
+                pedido = Barra::Aplicar;
+            }
+        }
+    } else {
+        let r = ui.add(egui::TextEdit::singleline(&mut e.prompt).hint_text("Describe qué poner (vacío = quitar)").desired_width(230.0));
+        let enter = r.lost_focus() && ui.input(|i| i.key_pressed(egui::Key::Enter));
+        if boton_generar(ui, costo, true).clicked() || enter {
+            if e.herramienta != Herramienta::Relleno {
+                e.elegir_herramienta(Herramienta::Relleno);
+            }
+            pedido = Barra::Generar;
+        }
+        if ui.small_button("?").on_hover_text("Abrir la ventana de la IA: modelos, variaciones y más herramientas").clicked() {
+            e.abierta = true;
+        }
+        if ui.small_button("×").on_hover_text("Cerrar").clicked() {
+            e.barra_expandida = false;
+        }
+    }
+    more.show(ui);
+    if let Some((false, m)) = &e.aviso
+        && e.trabajo.is_none()
+    {
+        ui.colored_label(ROJO, "(!)").on_hover_text(m.as_str());
+    }
+    pedido
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cubrir_keeps_the_size_and_fills_without_stretching() {
+        // 4×2 left half red, right half blue → 2×2: the centre crop is one red, one blue column.
+        let mut src = Vec::new();
+        for _ in 0..2 {
+            for x in 0..4 {
+                src.extend_from_slice(if x < 2 { &[255, 0, 0, 255] } else { &[0, 0, 255, 255] });
+            }
+        }
+        let out = cubrir(&src, 4, 2, 2, 2);
+        assert_eq!(out.len(), 16);
+        assert_eq!(&out[0..4], &[255, 0, 0, 255]);
+        assert_eq!(&out[4..8], &[0, 0, 255, 255]);
+    }
+
+    #[test]
+    fn big_areas_are_sent_smaller_keeping_their_shape() {
+        assert_eq!(tamano_envio(800, 600), (800, 600));
+        assert_eq!(tamano_envio(4000, 2000), (1536, 768));
+        assert_eq!(cubrir(&[0; 4 * 4000 * 10], 4000, 10, 400, 1).len(), 1600);
+        assert_eq!(tamano_recorte(100, 50).unwrap(), (512, 256), "Recraft needs 256 px");
+        assert_eq!(tamano_recorte(6000, 4000).unwrap(), (2048, 1365));
+        assert!(tamano_recorte(4000, 10).is_err());
+    }
+
+    #[test]
+    fn the_sent_area_takes_the_models_exact_proportion() {
+        let lienzo = Rect::new(0, 0, 400, 300);
+        let gemini: Vec<_> = GEMINI.split_whitespace().filter_map(aspecto).collect();
+        // 156×104 is 3:2 already.
+        let (r, a) = ajustar_aspecto(Rect::new(82, 88, 238, 192), lienzo, &gemini);
+        assert_eq!((r, a), (Rect::new(82, 88, 238, 192), Some((3, 2))));
+        // 100×100 near the right edge, a 16:9-only model: wider, shifted to stay inside.
+        let (r, a) = ajustar_aspecto(Rect::new(290, 10, 390, 110), lienzo, &[(16, 9)]);
+        assert_eq!(a, Some((16, 9)));
+        assert_eq!((r.width(), r.height()), (178, 100));
+        assert!(r.x1 <= 400 && r.x0 <= 290);
+        // Wider than the canvas: centred over it, past both edges.
+        let (r, _) = ajustar_aspecto(Rect::new(0, 0, 100, 300), Rect::new(0, 0, 100, 300), &[(16, 9)]);
+        assert_eq!((r.x0, r.x1, r.width()), (-216, 317, 533));
+        assert_eq!(ajustar_aspecto(lienzo, lienzo, &[]).0, lienzo);
+    }
+
+    #[test]
+    fn expanding_keeps_the_photo_and_marks_only_the_new_area() {
+        assert_eq!(lienzo_expandido(400, 300, Proporcion::Mas25), Some((500, 375)));
+        assert_eq!(lienzo_expandido(400, 300, Proporcion::Horizontal), Some((533, 300)));
+        assert_eq!(lienzo_expandido(400, 300, Proporcion::Historia), Some((400, 711)));
+        assert_eq!(lienzo_expandido(300, 300, Proporcion::Cuadrado), None);
+        let m = mascara_expandir(Rect::new(-10, 0, 30, 10), Rect::new(0, 0, 20, 10), 4);
+        let at = |x: i32, y: i32| m[(y * 40 + x + 10) as usize];
+        assert_eq!(at(-5, 5), 255, "new area");
+        assert_eq!(at(10, 5), 0, "the photo");
+        assert!(at(0, 5) > 128 && at(2, 5) < at(0, 5), "a soft seam inside the photo");
+        assert_eq!(at(10, 0), 0, "no seam on an edge without new area");
+    }
+
+    #[test]
+    fn crops_and_views_stay_in_bounds() {
+        let zona = Rect::new(-2, -2, 2, 2);
+        let px: Vec<u8> = (0..16).collect();
+        assert_eq!(recortar(&px, zona, Rect::new(0, 0, 2, 2), 1), vec![10, 11, 14, 15]);
+        assert_eq!(recortar(&px, zona, Rect::new(0, 0, 9, 9), 1).len(), 4);
+    }
+
+    #[test]
+    fn the_catalog_reads_prices_and_proportions() {
+        let v = serde_json::json!({"nombre": "Ana", "creditos": 50, "modelos": [
+            {"id": "nano-banana-2", "nombre": "Nano Banana 2", "proveedor": "Google", "tipo": "imagen", "aspectos": ["1:1", "16:9", "x"], "creditos": {"1k": 20, "2k": 30}},
+            {"id": "quitar-fondo", "nombre": "Quitar fondo", "proveedor": "Recraft", "tipo": "herramienta", "aspectos": [], "creditos": {"unica": 5}},
+            {"nombre": "sin id"}
+        ]});
+        let i = leer_info(&v);
+        assert_eq!((i.nombre.as_str(), i.creditos, i.modelos.len()), ("Ana", 50, 2));
+        let m = &i.modelos[0];
+        assert_eq!(m.nombre, "Google Nano Banana 2");
+        assert_eq!(m.aspectos, vec![(1, 1), (16, 9)]);
+        assert_eq!((m.costo("1k"), m.costo("2k")), (Some(20), Some(30)));
+        assert!(m.tiene_resoluciones());
+        assert_eq!(i.modelos[1].costo("unica"), Some(5));
+        assert_eq!(nivel(1200), "1k");
+        assert_eq!(nivel(1536), "2k");
+        let mut e = Estado { info: Some(i), ..Default::default() };
+        assert_eq!(e.modelos().len(), 1, "tools are not image models");
+        e.elegir_herramienta(Herramienta::Texto);
+        assert_eq!(e.modelo, MODELO_TEXTO);
+        e.elegir_herramienta(Herramienta::Relleno);
+        assert!(e.modelo.is_empty());
+        assert_eq!(Estado::default().modelo_actual().nombre, "Google Nano Banana");
+    }
+
+    #[test]
+    fn prompts_follow_the_tool() {
+        assert!(instrucciones(Herramienta::QuitarObjeto, "", "", true, SinSeleccion::EditarTodo, 0, false).contains("shadows"));
+        assert!(instrucciones(Herramienta::Relleno, "flores", "", true, SinSeleccion::EditarTodo, 0, false).contains("draw flores"));
+        assert_eq!(instrucciones(Herramienta::Relleno, "un gato", "", false, SinSeleccion::CrearNueva, 0, false), "un gato");
+        assert!(instrucciones(Herramienta::Texto, "", "OFERTA 50%", false, SinSeleccion::EditarTodo, 0, false).contains("\"OFERTA 50%\""));
+        assert!(instrucciones(Herramienta::Retoque, "", "", false, SinSeleccion::EditarTodo, 99, false).contains("lighting"));
+        assert!(instrucciones(Herramienta::GenerarFondo, "playa", "", false, SinSeleccion::EditarTodo, 0, true).contains("reference"));
+    }
