+fn cuerpo(ui: &mut egui::Ui, e: &mut Estado, p: &Plan, activo: Option<DocId>, otros: &[(DocId, String)], pide: &mut Pedidos) {
+    let t = crate::theme::Tokens::get(ui.ctx());
+    let ancho = ui.available_width();
+    let h = e.herramienta;
+    let ideogram = e.usa_ideogram(p.con_seleccion);
+
+    // Herramienta: un desplegable con su ícono.
+    ui.add_space(8.0);
+    titulo(ui, "Herramienta");
+    let id_ico = egui::IdSalt::new("jacnex-ia-herramienta-icono");
+    let r = egui::Button::new((
+        egui::Atom::custom(id_ico, egui::vec2(24.0, 24.0)),
+        RichText::new(h.nombre()).strong().color(t.text),
+        egui::Atom::grow(),
+        crate::icons::image("chevron-down", 14.0, t.text_dim),
+    ))
+    .min_size(egui::vec2(ancho, 36.0))
+    .corner_radius(8.0)
+    .atom_ui(ui);
+    if let Some(rect) = r.rect(id_ico) {
+        ui.painter().rect_filled(rect, 6.0, ACENTO);
+        crate::icons::paint(ui, rect, icono(h), 14.0, Color32::WHITE);
+    }
+    let resp = r.response.on_hover_text(h.ayuda());
+    egui::Popup::menu(&resp).width(ancho).show(|ui| {
+        for x in Herramienta::TODAS {
+            let b = egui::Button::selectable(e.herramienta == x, (crate::icons::image(icono(x), 15.0, t.icon), x.nombre())).min_size(egui::vec2(ancho - 12.0, 28.0));
+            if ui.add(b).on_hover_text(x.ayuda()).clicked() {
+                e.elegir_herramienta(x);
+            }
+        }
+    });
+    // Dónde actúa, en una línea.
+    let (lienzo_w, lienzo_h) = (p.lienzo.width(), p.lienzo.height());
+    let donde = match h {
+        Herramienta::Relleno | Herramienta::QuitarObjeto | Herramienta::Texto if p.con_seleccion => {
+            Some((true, format!("En tu selección · {} × {} px", p.zona.width(), p.zona.height())))
+        }
+        Herramienta::Texto => Some((true, "Donde quede mejor (o selecciona una zona)".to_string())),
+        Herramienta::Relleno | Herramienta::QuitarObjeto => None,
+        _ => Some((true, format!("Toda la imagen · {lienzo_w} × {lienzo_h} px"))),
+    };
+    match donde {
+        Some((ok, texto)) => {
+            ui.label(RichText::new(texto).small().color(if ok { t.text_faint } else { ROJO }));
+        }
+        None if h == Herramienta::QuitarObjeto => {}
+        None => {
+            ui.add_space(2.0);
+            let elegida = usize::from(e.sin_seleccion == SinSeleccion::CrearNueva);
+            match segmentos(ui, &["Editar la imagen".into(), "Crear una nueva".into()], elegida) {
+                Some(0) => e.sin_seleccion = SinSeleccion::EditarTodo,
+                Some(_) => e.sin_seleccion = SinSeleccion::CrearNueva,
+                None => {}
+            }
+        }
+    }
+    ui.add_space(8.0);
+
+    // Descripción: lo que se escribe, según la herramienta.
+    let consejos = "Sé concreto: «un gato naranja sentado» funciona mejor que «un gato».\nCada resultado llega como capa nueva: Ctrl+Z la quita.\nSi algo falla, tus créditos vuelven solos.";
+    let encabezado = |ui: &mut egui::Ui, nombre: &str| {
+        crate::widgets::hairline(ui);
+        ui.add_space(8.0);
+        ui.horizontal(|ui| {
+            titulo(ui, nombre);
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                ayuda(ui, &format!("{}\n\n{consejos}", h.ayuda()));
+            });
+        });
+    };
+    let linea = |ui: &mut egui::Ui, texto: &mut String, pista: &str| {
+        ui.add(egui::TextEdit::singleline(texto).hint_text(pista).desired_width(f32::INFINITY).margin(egui::vec2(8.0, 6.0)));
+    };
+    match h {
+        Herramienta::Relleno => {
+            encabezado(ui, "Descripción");
+            let pista = if p.con_seleccion { "Ej.: un bote de madera (vacío = quitar)" } else { "Describe la imagen o el cambio" };
+            ui.add(egui::TextEdit::multiline(&mut e.prompt).hint_text(pista).desired_rows(3).desired_width(f32::INFINITY).margin(egui::vec2(8.0, 6.0)));
+            ideas(ui, &mut e.prompt, if p.con_seleccion { IDEAS_SELECCION } else { IDEAS_LIENZO });
+        }
+        Herramienta::Expandir => {
+            encabezado(ui, "Descripción");
+            linea(ui, &mut e.prompt, "Opcional: qué poner en lo nuevo");
+            ideas(ui, &mut e.prompt, IDEAS_EXPANDIR);
+        }
+        Herramienta::GenerarFondo => {
+            encabezado(ui, "Descripción");
+            linea(ui, &mut e.prompt, "Describe el fondo nuevo");
+            ideas(ui, &mut e.prompt, IDEAS_FONDO);
+        }
+        Herramienta::Texto => {
+            encabezado(ui, "Texto");
+            linea(ui, &mut e.texto, "El texto exacto, ej.: OFERTA 50%");
+            ui.add_space(2.0);
+            linea(ui, &mut e.prompt, "Estilo (opcional): dorado en 3D, neón…");
+        }
+        Herramienta::Retoque => {
+            encabezado(ui, "Retoque");
+            ui.horizontal_wrapped(|ui| {
+                ui.spacing_mut().item_spacing = egui::vec2(4.0, 4.0);
+                for (i, (nombre, _)) in RETOQUES.iter().enumerate() {
+                    if ui.selectable_label(e.retoque == i, *nombre).clicked() {
+                        e.retoque = i;
+                    }
+                }
+            });
+            ui.add_space(2.0);
+            linea(ui, &mut e.prompt, "Algo más (opcional)");
+        }
+        Herramienta::QuitarObjeto | Herramienta::QuitarFondo | Herramienta::MejorarResolucion => {}
+    }
+    if h.admite_referencia() && !ideogram {
+        ui.add_space(4.0);
+        let nombre = e.referencia.and_then(|id| otros.iter().find(|o| o.0 == id)).map(|o| o.1.clone());
+        let color = if nombre.is_some() { t.text } else { t.text_faint };
+        let texto = nombre.unwrap_or_else(|| "Imagen de referencia (opcional)".into());
+        let b = egui::Button::new((crate::icons::image("image", 14.0, color), RichText::new(texto).color(color), egui::Atom::grow()))
+            .min_size(egui::vec2(ancho, 30.0))
+            .corner_radius(8.0)
+            .fill(Color32::TRANSPARENT)
+            .stroke(egui::Stroke::new(1.0, t.field_border));
+        let resp = ui.add_enabled(!otros.is_empty(), b);
+        let resp = if otros.is_empty() {
+            resp.on_disabled_hover_text("Abre otra imagen en Photonex para usarla como referencia.")
+        } else {
+            resp.on_hover_text("Otra imagen abierta (un producto, una persona, un estilo) que guía cómo se ve lo nuevo.")
+        };
+        egui::Popup::menu(&resp).width(ancho).show(|ui| {
+            if ui.selectable_label(e.referencia.is_none(), "Ninguna").clicked() {
+                e.referencia = None;
+            }
+            for (id, n) in otros {
+                if ui.selectable_label(e.referencia == Some(*id), n.as_str()).clicked() {
+                    e.referencia = Some(*id);
+                }
+            }
+        });
+    }
+
+    // Ajustes.
+    let hay_ajustes = h.usa_modelo() || h == Herramienta::QuitarObjeto || h == Herramienta::MejorarResolucion || h == Herramienta::Expandir;
+    if hay_ajustes {
+        ui.add_space(8.0);
+        crate::widgets::hairline(ui);
+        ui.add_space(4.0);
+        let cabeza = RichText::new("AJUSTES").size(10.5).strong().color(t.text_faint);
+        egui::CollapsingHeader::new(cabeza).id_salt("jacnex-ia-ajustes").default_open(true).show_unindented(ui, |ui| {
+            ajustes(ui, e, p, ideogram);
+        });
+    }
+
+    // Resultados: las variaciones, para elegir y aplicar.
+    let Some(r) = e.resultado.as_ref().filter(|r| Some(r.doc) == activo && !r.variaciones.is_empty()) else { return };
+    let tex = e.miniaturas.as_ref().filter(|m| m.0 == (r.doc, r.capa)).map(|m| m.1.as_slice()).unwrap_or(&[]);
+    ui.add_space(8.0);
+    crate::widgets::hairline(ui);
+    ui.add_space(8.0);
+    ui.horizontal(|ui| {
+        let cabeza = titulo(ui, "Resultados");
+        // Al llegar un resultado nuevo, la lista se desplaza para mostrarlo.
+        let id = egui::Id::unique("jacnex-ia-resultados-vistos");
+        let clave = (r.doc, r.capa);
+        if ui.data(|d| d.get_temp::<(DocId, LayerId)>(id)) != Some(clave) {
+            cabeza.scroll_to_me(Some(egui::Align::Min));
+            ui.data_mut(|d| d.insert_temp(id, clave));
+        }
+        if r.variaciones.len() > 1 {
+            ui.with_layout(egui::Layout::right_to_left(egui::Align::Center), |ui| {
+                ui.label(RichText::new("Elige y aplica").small().color(t.text_faint));
+            });
+        }
+    });
+    let w = ((ancho - 8.0) / 2.0).floor();
+    let aspecto = r.zona.height() as f32 / r.zona.width().max(1) as f32;
+    let alto = (w * aspecto).clamp(48.0, 120.0);
+    egui::Grid::new("jacnex-ia-resultados").num_columns(2).spacing([8.0, 8.0]).show(ui, |ui| {
+        for (i, tx) in tex.iter().enumerate() {
