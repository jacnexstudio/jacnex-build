+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn half_floats_decode() {
+        assert_eq!(f16_to_f32(0x3c00), 1.0);
+        assert_eq!(f16_to_f32(0xc000), -2.0);
+        assert_eq!(f16_to_f32(0x0000), 0.0);
+        assert_eq!(f16_to_f32(0x7bff), 65504.0);
+        assert!((f16_to_f32(0x0001) - 5.960_464_5e-8).abs() < 1e-12);
+        assert!((f16_to_f32(0x3555) - 0.333_251_95).abs() < 1e-6);
+    }
+
+    #[test]
+    fn a_damaged_file_is_an_error_not_a_panic() {
+        assert!(read_tensors(b"").is_err());
+        assert!(read_tensors(b"JXMIGAN1").is_err());
+        let mut b = b"JXMIGAN1".to_vec();
+        b.extend(1u32.to_le_bytes());
+        b.extend(1u16.to_le_bytes());
+        b.push(b'a');
+        b.push(2);
+        b.extend(u32::MAX.to_le_bytes());
+        b.extend(u32::MAX.to_le_bytes());
+        assert!(read_tensors(&b).is_err());
+        assert!(Model::load(b"JXMIGAN1\0\0\0\0").is_err());
+    }
+
+    #[test]
+    fn the_crop_is_a_square_around_the_hole_that_fits() {
+        let (w, h) = (2000, 1000);
+        let mut hole = vec![0u8; w * h];
+        hole[500 * w + 1000] = 1;
+        let (x0, x1, y0, y1) = crop_box(&hole, w, h).unwrap();
+        assert_eq!((x1 - x0, y1 - y0), (512, 512));
+        assert!(x0 <= 1000 && x1 > 1000 && y0 <= 500 && y1 > 500);
+        // Near a corner it slides inside the photo.
+        let mut hole = vec![0u8; w * h];
+        hole[3 * w + 2] = 1;
+        assert_eq!(crop_box(&hole, w, h), Some((0, 512, 0, 512)));
+        // A small photo is used whole.
+        let hole = vec![1u8; 300 * 200];
+        assert_eq!(crop_box(&hole, 300, 200), Some((0, 300, 0, 200)));
+        assert_eq!(crop_box(&[0; 16], 4, 4), None);
+    }
+
+    #[test]
+    fn a_thin_wire_survives_shrinking() {
+        let (w, h) = (2048, 64);
+        let mut hole = vec![0u8; w * h];
+        for y in 0..h {
+            hole[y * w + 1001] = 1;
+        }
+        let small = shrink_hole(&hole, w, h, 512, 16);
+        assert!(small.iter().filter(|&&v| v > 0).count() >= 16);
+    }
+
+    #[test]
+    fn resizing_keeps_flat_colour() {
+        let src = vec![100.0f32; 37 * 23 * 3];
+        for (dw, dh) in [(512, 512), (5, 3), (37, 23)] {
+            assert!(resize(&src, 37, 23, dw, dh, 3).iter().all(|v| (v - 100.0).abs() < 1e-3));
+        }
+    }
+
+    #[test]
+    fn bad_input_is_an_error_not_a_panic() {
+        assert!(remove(&[0; 16], 2, 2, &[0; 3]).is_err());
+        assert!(remove(&[0; 16], 2, 2, &[0; 4]).is_err(), "nothing to remove");
+        assert!(remove(&[], 0, 0, &[]).is_err());
+    }
+
+    #[test]
+    fn the_hole_is_filled_and_the_rest_kept() {
+        // A flat grey photo with a red square: removing the square gives back grey. (A photo
+        // much smaller than 512 px is stretched to it and fills worse: the original does too.)
+        let (w, h) = (400usize, 300usize);
+        let mut px = [120u8, 120, 120, 255].repeat(w * h);
+        let mut hole = vec![0u8; w * h];
+        for y in 100..160 {
+            for x in 150..210 {
+                px[(y * w + x) * 4..(y * w + x) * 4 + 3].copy_from_slice(&[220, 30, 40]);
+                hole[y * w + x] = 255;
+            }
+        }
+        let f = remove(&px, w as u32, h as u32, &hole).unwrap();
+        assert_eq!((f.x, f.y, f.width, f.height), (0, 0, 400, 300), "the crop is cut to the photo");
+        let at = |x: usize, y: usize| &f.rgba[(y * w + x) * 4..(y * w + x) * 4 + 4];
+        assert_eq!(at(20, 20), &[120, 120, 120, 255], "far from the hole the photo is untouched");
+        for (x, y) in [(180, 130), (160, 110), (200, 150)] {
+            assert!(at(x, y).iter().take(3).all(|&c| c.abs_diff(120) < 12), "({x}, {y}) = {:?}", at(x, y));
+        }
+    }
+}
