+    fn big_areas_are_sent_smaller_keeping_their_shape() {
+        assert_eq!(tamano_envio(800, 600), (800, 600));
+        assert_eq!(tamano_envio(4000, 2000), (1536, 768));
+        assert_eq!(cubrir(&[0; 4 * 4000 * 10], 4000, 10, 400, 1).len(), 1600);
+        assert_eq!(tamano_recorte(100, 50).unwrap(), (512, 256), "Recraft needs 256 px");
